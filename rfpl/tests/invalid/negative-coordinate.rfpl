#lang rfpl
// Invalid fixture using a negative physical placement coordinate.

import:
  "../support/annotation-circuits.rhm" as circuits

def logical = circuits.pair_logical
def left = child_instance(logical.top, "left")
def leaf_view = hard_macro(left.attribute("module"), width: um(5), height: um(5))
def bad = place(left, leaf_view, at: (um(-1), um(0)))
