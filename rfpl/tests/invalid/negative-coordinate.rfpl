#lang rfpl
// Invalid fixture using a negative child-floorplan coordinate component.

floorplan Child():
  size(width: um(5), height: um(5))

floorplan NegativeCoordinate():
  size(width: um(10), height: um(10))
  def child = Child()
  inst placed(child, at: (um(-1), um(0)))

def elaboration = elaborate(NegativeCoordinate())
