#lang rfpl
// Invalid fixture using a unitless child-floorplan coordinate component.

floorplan Child():
  size(width: um(5), height: um(5))

floorplan UnitlessCoordinate():
  size(width: um(10), height: um(10))
  def child = Child()
  inst placed(child, at: (0, um(0)))

def elaboration = elaborate(UnitlessCoordinate())
