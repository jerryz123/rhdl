#lang rfpl
// Invalid fixture placing an RFPL floorplan below an RHDL circuit.

import:
  "../support/circuit-wrapper.rhm".CircuitWrapper

floorplan Leaf():
  size(width: um(10), height: um(10))
  input value_in: Bits(8)
  output value_out: Bits(8)
  value_out <== value_in

floorplan BadReverseHierarchy():
  size(width: um(20), height: um(20))
  input value_in: Bits(8)
  output value_out: Bits(8)

  def leaf = Leaf()
  def wrapper = CircuitWrapper(leaf)
  inst wrapped(wrapper)
  wrapped.value_in <== value_in
  value_out <== wrapped.value_out

def elaboration = elaborate(BadReverseHierarchy())
