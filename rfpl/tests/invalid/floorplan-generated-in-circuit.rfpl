#lang rfpl
// Invalid fixture generating an RFPL floorplan while an RHDL circuit body is active.

import:
  "../support/circuit-floorplan-factory.rhm".CircuitFloorplanFactory

floorplan Leaf():
  size(width: um(5), height: um(5))

floorplan BadParent():
  size(width: um(10), height: um(10))
  def wrapper = CircuitFloorplanFactory(fun (): Leaf())
  inst wrapped(wrapper)

def elaboration = elaborate(BadParent())
