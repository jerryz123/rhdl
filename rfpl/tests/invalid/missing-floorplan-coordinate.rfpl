#lang rfpl
// Invalid fixture instantiating a child floorplan without a physical coordinate.

floorplan Child():
  size(width: um(5), height: um(5))

floorplan MissingCoordinate():
  size(width: um(10), height: um(10))
  def child = Child()
  inst placed(child)

def elaboration = elaborate(MissingCoordinate())
