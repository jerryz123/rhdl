#lang rfpl
// Invalid fixture generating a second floorplan outside any floorplan body.

floorplan FirstRoot():
  size(width: um(10), height: um(10))

floorplan SecondRoot():
  size(width: um(10), height: um(10))

fun build_roots():
  def first = FirstRoot()
  SecondRoot()

def elaboration = elaborate(build_roots())
