#lang rfpl
// Invalid fixture placing a child rectangle beyond its parent's physical bounds.

floorplan Child():
  size(width: um(6), height: um(6))

floorplan OutOfBoundsCoordinate():
  size(width: um(10), height: um(10))
  def child = Child()
  inst placed(child, at: (um(5), um(5)))

def elaboration = elaborate(OutOfBoundsCoordinate())
