#lang rhombus/and_meta
// Defines an RHDL circuit helper that attempts to instantiate a supplied child definition.

import:
  "../../../rhdl/frontend/foundation.rhm" open
  "../../../rhdl/frontend/layers/hierarchy.rhm" open

export:
  CircuitWrapper

circuit CircuitWrapper(child):
  input value_in: Bits(8)
  output value_out: Bits(8)

  inst wrapped(child)
  wrapped.value_in <== value_in
  value_out <== wrapped.value_out
