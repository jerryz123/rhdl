#lang rhombus
// Checks the reusable dependency-neutral support refinement annotations.

import:
  "../annotations.rhm" open

fun require_nonempty(value :: NonemptyString): value
fun require_identifier(value :: AsciiIdentifier): value

check:
  require_nonempty("rhdl") ~is "rhdl"
  require_nonempty("") ~throws "NonemptyString"
  require_identifier("valid_name_2") ~is "valid_name_2"
  require_identifier("2invalid") ~throws "AsciiIdentifier"
  require_identifier("contains-hyphen") ~throws "AsciiIdentifier"
