#lang rhombus
// Checks the public iterative HardFloat division and square-root structure and format specialization.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

import:
  "../../rhdl/core/main.rhm" open
  "../main.rhdl" as hardfloat
  "divide-sqrt-fixture.rhdl" as fixture

def design = fixture.design
def top = design.modules.find(
  fun (module_def): module_def.name.starts_with("HardFloatDivideSqrt")
)
def operations = design.modules.filter(
  ~keep: fun (module_def): module_def.name.starts_with("DivSqrtRecFN")
)
def raw_operations = design.modules.filter(
  ~keep: fun (module_def): module_def.name.starts_with("DivSqrtRawFN")
)
def first_raw_registers = raw_operations[0].operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register"
)
def second_raw_registers = raw_operations[1].operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register"
)

check:
  hardfloat.DivSqrtOptions.Default.two_bits_per_cycle ~is #false
  hardfloat.DivSqrtOptions.TwoBitsPerCycle.two_bits_per_cycle ~is #true
  top.find_input("a").type.bit_width() ~is 16
  top.find_output("one_bit_out").type.bit_width() ~is 16
  top.find_output("two_bit_out").type.bit_width() ~is 16
  operations.length() >= 4 ~is #true
  raw_operations.length() ~is 2
  first_raw_registers.length() >= 10 ~is #true
  second_raw_registers.length() >= 10 ~is #true
  verify_design(fixture.minimum_design) ~is #void
  verify_design(design) ~is #void
