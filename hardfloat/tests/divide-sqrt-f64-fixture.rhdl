#lang rhdl
// Exercises the completed multiply-assisted binary64 HardFloat unit at IEEE boundaries.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

import:
  "../main.rhdl" open

sync_circuit HardFloatDivideSqrtF64():
  input input_valid: Bool
  input square_root: Bool
  input a: IEEEFloat(FloatFormat.F64)
  input b: IEEEFloat(FloatFormat.F64)
  input rounding_mode: RoundingMode
  input tininess_mode: TininessMode
  output division_ready: Bool
  output square_root_ready: Bool
  output division_valid: Bool
  output square_root_valid: Bool
  output out: IEEEFloat(FloatFormat.F64)
  output exception_flags: ExceptionFlags()

  inst operation(DivSqrtRecF64())
  operation.input_valid <== input_valid
  operation.square_root <== square_root
  operation.a <== recfn_from_fn(FloatFormat.F64, a)
  operation.b <== recfn_from_fn(FloatFormat.F64, b)
  operation.rounding_mode <== rounding_mode
  operation.tininess_mode <== tininess_mode
  division_ready <== operation.division_ready
  square_root_ready <== operation.square_root_ready
  division_valid <== operation.division_valid
  square_root_valid <== operation.square_root_valid
  out <== fn_from_recfn(FloatFormat.F64, operation.out)
  exception_flags <== operation.exception_flags

def design = elaborate(HardFloatDivideSqrtF64())
def external_multiplier_design = elaborate(DivSqrtRecF64MulAddZ31())

export:
  HardFloatDivideSqrtF64
  design
  external_multiplier_design
