#lang rhombus
// Checks the integrated and external-multiplier forms of the specialized binary64 HardFloat unit.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

import:
  "../../rhdl/core/main.rhm" open
  "divide-sqrt-f64-fixture.rhdl" as fixture

def design = fixture.design
def top = design.modules.find(
  fun (module_def): module_def.name.starts_with("HardFloatDivideSqrtF64")
)
def recurrence = design.modules.find(
  fun (module_def): module_def.name.starts_with("DivSqrtRecF64ToRawMulAddZ31")
)
def multiplier = design.modules.find(
  fun (module_def): module_def.name.starts_with("HardFloatMultiply54")
)

check:
  top.find_input("a").type.bit_width() ~is 64
  top.find_output("out").type.bit_width() ~is 64
  recurrence.find_output("using_multiply_add").type.bit_width() ~is 4
  recurrence.find_output("multiply_a").type.bit_width() ~is 54
  recurrence.find_output("multiply_c").type.bit_width() ~is 105
  multiplier.find_output("result_stage_three").type.bit_width() ~is 105
  verify_design(fixture.external_multiplier_design) ~is #void
  verify_design(design) ~is #void
