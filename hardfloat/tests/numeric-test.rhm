#lang rhombus
// Checks the public types and verified structure of the ISA-neutral HardFloat numeric extensions.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

import:
  "../../rhodium/core/main.rhm" open
  "../main.rhdl" as hardfloat
  "numeric-fixture.rhdl" as fixture

def design = fixture.design
def top = design.modules.find(fun (module_def): module_def.name.starts_with("HardFloatNumeric"))
def min_max = design.modules.find(fun (module_def): module_def.name.starts_with("MinMaxRecFN"))
def round_to_integral = design.modules.find(fun (module_def): module_def.name.starts_with("RoundToIntegralRecFN"))
def modulo = design.modules.find(fun (module_def): module_def.name.starts_with("RecFNToIntegerModulo") && module_def.find_output("out").type.bit_width() == 8)
def wide_modulo = design.modules.find(fun (module_def): module_def.name.starts_with("RecFNToIntegerModulo") && module_def.find_output("out").type.bit_width() == 32)

check:
  hardfloat.MinMaxOperation.packed_width() ~is 2
  type_equal(top.find_input("min_max_operation").type, hardfloat.MinMaxOperation) ~is #true
  type_equal(min_max.find_output("out").type, hardfloat.RecFloat(hardfloat.FloatFormat.F16)) ~is #true
  type_equal(round_to_integral.find_output("exception_flags").type, hardfloat.ExceptionFlags()) ~is #true
  modulo.find_output("out").type.bit_width() ~is 8
  wide_modulo.find_output("out").type.bit_width() ~is 32
  verify_design(fixture.minimum_integral_design) ~is #void
  verify_design(design) ~is #void
