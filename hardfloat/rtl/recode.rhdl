#lang rhdl
// Converts among IEEE, recoded, and raw Berkeley HardFloat representations.
// Derived from rawFloatFromFN.scala, recFNFromFN.scala, rawFloatFromRecFN.scala,
// and fNFromRecFN.scala at upstream commit c1105e6.
// Copyright 2010-2017 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

import:
  "types.rhdl" open
  "primitives.rhdl".count_leading_zeros

fun raw_float_from_fn(format :: FloatFormat,
                      value :: Bits(format.ieee_width)) :~ RawFloat(format.exponent_width, format.significand_width):
  def exponent_width = format.exponent_width
  def significand_width = format.significand_width
  def sign = cast(extract(value, format.ieee_width - 1, format.ieee_width - 1), Bool)
  def exponent = extract(value, format.ieee_width - 2, significand_width - 1)
  def fraction = extract(value, significand_width - 2, 0)
  def zero_exponent = exponent === bits(0, exponent_width)
  def zero_fraction = fraction === bits(0, significand_width - 1)
  def normalization_distance = count_leading_zeros(fraction)
  def shifted_fraction = fraction << normalization_distance
  def subnormal_fraction = concat(extract(shifted_fraction, significand_width - 3, 0), bits(0, 1))
  def exponent_width_plus_one = exponent_width + 1
  def subnormal_exponent = zext(normalization_distance, exponent_width_plus_one) ^ bits(
    (1 << exponent_width_plus_one) - 1,
    exponent_width_plus_one
  )
  def selected_exponent = mux(
    zero_exponent,
    subnormal_exponent,
    zext(exponent, exponent_width_plus_one)
  )
  def exponent_adjustment = bits(1 << (exponent_width - 1), exponent_width_plus_one) ||| mux(
    zero_exponent,
    bits(2, exponent_width_plus_one),
    bits(1, exponent_width_plus_one)
  )
  def adjusted_exponent = selected_exponent + exponent_adjustment
  def zero = zero_exponent & zero_fraction
  def special = extract(adjusted_exponent, exponent_width, exponent_width - 1) === bits(3, 2)

  RawFloat(exponent_width, significand_width):
    is_nan: special & !zero_fraction
    is_infinite: special & zero_fraction
    is_zero: zero
    sign: sign
    signed_exponent: cast(zext(adjusted_exponent, exponent_width + 2), SInt(exponent_width + 2))
    significand: concat(bits(0, 1), !zero, mux(zero_exponent, subnormal_fraction, fraction))

fun recfn_from_fn(format :: FloatFormat,
                  value :: Bits(format.ieee_width)) :~ Bits(format.recoded_width):
  def raw = raw_float_from_fn(format, value)
  def exponent = as_bits(raw.signed_exponent)
  def recoded_top = mux(
    raw.is_zero,
    bits(0, 3),
    extract(exponent, format.exponent_width, format.exponent_width - 2)
  ) ||| mux(raw.is_nan, bits(1, 3), bits(0, 3))
  concat(
    raw.sign,
    recoded_top,
    extract(exponent, format.exponent_width - 3, 0),
    extract(raw.significand, format.significand_width - 2, 0)
  )

fun raw_float_from_recfn(format :: FloatFormat,
                         value :: Bits(format.recoded_width)) :~ RawFloat(format.exponent_width, format.significand_width):
  def exponent_width = format.exponent_width
  def significand_width = format.significand_width
  def exponent = extract(value, format.recoded_width - 2, significand_width - 1)
  def zero = extract(exponent, exponent_width, exponent_width - 2) === bits(0, 3)
  def special = extract(exponent, exponent_width, exponent_width - 1) === bits(3, 2)
  def nan_code = cast(extract(exponent, exponent_width - 2, exponent_width - 2), Bool)

  RawFloat(exponent_width, significand_width):
    is_nan: special & nan_code
    is_infinite: special & !nan_code
    is_zero: zero
    sign: cast(extract(value, format.recoded_width - 1, format.recoded_width - 1), Bool)
    signed_exponent: cast(zext(exponent, exponent_width + 2), SInt(exponent_width + 2))
    significand: concat(bits(0, 1), !zero, extract(value, significand_width - 2, 0))

fun fn_from_recfn(format :: FloatFormat,
                  value :: Bits(format.recoded_width)) :~ Bits(format.ieee_width):
  def exponent_width = format.exponent_width
  def significand_width = format.significand_width
  def raw = raw_float_from_recfn(format, value)
  def raw_exponent = as_bits(raw.signed_exponent)
  def minimum_normal_exponent = (1 << (exponent_width - 1)) + 2
  def subnormal = raw.signed_exponent < sint(minimum_normal_exponent, exponent_width + 2)
  def distance_width = index_width(significand_width - 1)
  def denormal_shift_distance = bits(1, distance_width) - extract(raw_exponent, distance_width - 1, 0)
  def denormal_fraction = extract((raw.significand >> 1) >> denormal_shift_distance, significand_width - 2, 0)
  def finite_exponent = extract(raw_exponent, exponent_width - 1, 0) - bits(
    (1 << (exponent_width - 1)) + 1,
    exponent_width
  )
  def special = raw.is_nan ||| raw.is_infinite
  def exponent = mux(subnormal, bits(0, exponent_width), finite_exponent) ||| mux(
    special,
    bits((1 << exponent_width) - 1, exponent_width),
    bits(0, exponent_width)
  )
  def fraction = mux(
    subnormal,
    denormal_fraction,
    mux(raw.is_infinite, bits(0, significand_width - 1), extract(raw.significand, significand_width - 2, 0))
  )
  concat(raw.sign, exponent, fraction)

fun is_signaling_nan(format :: FloatFormat,
                     raw :: RawFloat(format.exponent_width, format.significand_width)) :~ Bool:
  raw.is_nan & !cast(extract(raw.significand,
                             format.significand_width - 2,
                             format.significand_width - 2), Bool)

export:
  raw_float_from_fn
  recfn_from_fn
  raw_float_from_recfn
  fn_from_recfn
  is_signaling_nan
