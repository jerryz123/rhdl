#lang rhdl
// Connects RV64I instruction decoding directly to the ALU for X-safety checks.

import:
  "../alu.rhdl" open
  "../decode/alu-ctrl.rhdl" open

circuit DecodedALU():
  input instruction: Bits(32)
  input(left, right): Bits(64)
  output valid: Bool
  output result: Bits(64)

  inst decoder(RV64IAluInstructionDecoder())
  inst alu(ALU())
  decoder.instruction <== instruction
  alu.left <== left
  alu.right <== right
  alu.control <== decoder.control
  valid <== decoder.valid
  result <== alu.result

export:
  DecodedALU
