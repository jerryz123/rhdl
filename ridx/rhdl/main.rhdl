#lang rhdl
// Traverses Ridx domains and connectivity while explicit callbacks construct public RHDL hardware.

import:
  "../model/main.rhm" open
  "../materialize/main.rhm" open

export:
  for_each_index_point
  for_each_relation_pair
  for_each_direct_mapping

fun for_each_index_point(domain, visit :: Function.of_arity(1)):
  for (point in index_domain_points(domain)):
    visit(point)
  #void

fun for_each_relation_pair(relation :: Relation,
                           visit :: Function.of_arity(2)):
  for (pair in materialize_relation(relation).pairs):
    visit(pair.source, pair.target)
  #void

// The mapping domain represents destinations and each mapped value is the
// destination's single source. Mapping validation supplies totality and exact
// nominal-domain checks before this callback can construct any connection.
fun for_each_direct_mapping(mapping :: Mapping,
                            connect :: Function.of_arity(2)):
  for (destination in index_domain_points(mapping.source_domain)):
    connect(destination, mapping.get(destination))
  #void
