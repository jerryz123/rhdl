#lang rhombus
// Defines the common host-side protocol for finite Ridx spaces and views.

export:
  IndexDomain

// Concrete spaces and subset views expose one uniform ordered-domain surface.
interface IndexDomain:
  method space()
  method points()
  // The concrete domain supplies the IndexPoint static information; this
  // protocol stays independent of the module that defines IndexPoint.
  method contains(point :~ matching(_))
  method describe()
