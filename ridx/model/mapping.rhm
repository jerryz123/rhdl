#lang rhombus
// Defines validated total mappings and canonical inverse views.

import:
  "../../host/annotations.rhm" open
  "domain.rhm" open
  "space.rhm" open
  "view.rhm" open
  "indexed.rhm" open

export:
  Mapping
  mapping_by

class Mapping(source_domain :: IndexDomain,
              target_domain :: IndexDomain,
              assignments :: Indexed):
  constructor (source_domain :: IndexDomain,
               target_domain :: IndexDomain,
               assignments :: Indexed):
    unless index_domain_equal(source_domain, assignments.domain)
    | error(~who: #'Mapping,
            String.append("assignment domain ",
                          assignments.domain.describe(),
                          " does not equal source domain ",
                          source_domain.describe()))
    for (entry in assignments.entries):
      unless entry.value is_a IndexPoint
      | error(~who: #'Mapping,
              String.append("mapping value for ", entry.point.describe(),
                            " must be an IndexPoint"))
      unless target_domain.contains(entry.value)
      | error(~who: #'Mapping,
              String.append("mapping value ", entry.value.describe(),
                            " for ", entry.point.describe(),
                            " does not belong to target domain ",
                            target_domain.describe()))
    super(source_domain, target_domain, assignments)

  method get(point :: IndexPoint):
    assignments.get(point)

  method inverse_view(target_point :: IndexPoint,
                      ~name: name :: False || NonemptyString = #false):
    unless target_domain.contains(target_point)
    | error(~who: #'inverse_view,
            String.append("point ", target_point.describe(),
                          " does not belong to target domain ",
                          target_domain.describe()))
    def selected = (
      for List (source_point in source_domain.points()):
        if point_equal(get(source_point), target_point)
        | source_point
        | #false
    ).filter(~keep: fun (point): point != #false)
    IndexView(source_domain.space(), selected, ~name: name)

  method describe():
    String.append("Mapping[", source_domain.describe(),
                  " -> ", target_domain.describe(), "]")

fun mapping_by(source_domain :: IndexDomain,
               target_domain :: IndexDomain,
               producer :: Function.of_arity(1)):
  Mapping(source_domain,
          target_domain,
          index_by(source_domain, producer))
