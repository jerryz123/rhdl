#lang rhombus
// Defines validated total mappings and canonical inverse views.

import:
  "space.rhm" open
  "view.rhm" open
  "indexed.rhm" open

export:
  Mapping
  mapping_by

class Mapping(source_domain,
              target_domain,
              assignments :: Indexed):
  constructor (source_domain,
               target_domain,
               assignments :: Indexed):
    unless index_domain_equal(source_domain, assignments.domain)
    | error(~who: #'Mapping,
            String.append("assignment domain ",
                          index_domain_describe(assignments.domain),
                          " does not equal source domain ",
                          index_domain_describe(source_domain)))
    for (entry in assignments.entries):
      unless entry.value is_a IndexPoint
      | error(~who: #'Mapping,
              String.append("mapping value for ", entry.point.describe(),
                            " must be an IndexPoint"))
      unless index_domain_contains(target_domain, entry.value)
      | error(~who: #'Mapping,
              String.append("mapping value ", entry.value.describe(),
                            " for ", entry.point.describe(),
                            " does not belong to target domain ",
                            index_domain_describe(target_domain)))
    super(source_domain, target_domain, assignments)

  method get(point :: IndexPoint):
    assignments.get(point)

  method inverse_view(target_point :: IndexPoint, ~name: name = #false):
    unless index_domain_contains(target_domain, target_point)
    | error(~who: #'inverse_view,
            String.append("point ", target_point.describe(),
                          " does not belong to target domain ",
                          index_domain_describe(target_domain)))
    def selected = (
      for List (source_point in index_domain_points(source_domain)):
        if point_equal(get(source_point), target_point)
        | source_point
        | #false
    ).filter(~keep: fun (point): point != #false)
    IndexView(index_domain_space(source_domain), selected, ~name: name)

  method describe():
    String.append("Mapping[", index_domain_describe(source_domain),
                  " -> ", index_domain_describe(target_domain), "]")

fun mapping_by(source_domain,
               target_domain,
               producer :: Function.of_arity(1)):
  Mapping(source_domain,
          target_domain,
          index_by(source_domain, producer))
