#lang rhombus
// Defines the inspectable relation interface and stabilized axis-shift relation.

import:
  "../../host/annotations.rhm" open
  "domain.rhm" open
  "space.rhm" open

export:
  Relation
  ShiftRelation
  shift_relation

interface Relation:
  method source_domain() :: IndexDomain
  method target_domain() :: IndexDomain
  method describe()

class ShiftRelation(space :: IndexSpace,
                    axis_name :: AsciiIdentifier,
                    delta :: Int,
                    boundary :: String):
  implements Relation

  constructor (space :: IndexSpace,
               axis_name :: AsciiIdentifier,
               delta :: Int,
               boundary :: String):
    space.axis(axis_name)
    unless boundary == "drop" || boundary == "wrap"
    | error(~who: #'ShiftRelation,
            "boundary must be \"drop\" or \"wrap\"")
    super(space, axis_name, delta, boundary)

  override method source_domain() :: IndexDomain: space
  override method target_domain() :: IndexDomain: space
  override method describe():
    String.append("shift(", space.describe(), ", ", axis_name, ", ",
                  to_string(delta), ", ", boundary, ")")

fun shift_relation(space :: IndexSpace,
                   axis_name :: AsciiIdentifier,
                   delta :: Int,
                   ~boundary: boundary :: String = "drop"):
  ShiftRelation(space, axis_name, delta, boundary)
