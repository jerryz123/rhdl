#lang rhombus
// Defines canonical ordered subset views over one nominal Ridx space.

import:
  "../../host/annotations.rhm" open
  "space.rhm" open

export:
  IndexView
  select_view
  index_domain_space
  index_domain_points
  index_domain_contains
  index_domain_equal
  index_domain_describe

fun require_view_name(name):
  unless name == #false || (name is_a String && name.length() > 0)
  | error(~who: #'IndexView,
          "name must be #false or a nonempty String")
  name

fun requested_point(points, candidate):
  points.find(fun (point): point_equal(point, candidate)) != #false

class IndexView(space :: IndexSpace,
                points :: List.of(IndexPoint),
                name):
  constructor (space :: IndexSpace,
               supplied_points :: List.of(IndexPoint),
               ~name: name = #false):
    require_view_name(name)
    for (point in supplied_points):
      unless space.contains(point)
      | error(~who: #'IndexView,
              "point " ++ point.describe() ++ " does not belong to " ++ space.describe())
    def canonical_points = space.points().filter(
      ~keep: fun (point): requested_point(supplied_points, point)
    )
    super(space, canonical_points, name)

  method contains(point):
    point is_a IndexPoint && points.find(
      fun (candidate): point_equal(candidate, point)
    ) != #false

  method length():
    points.length()

  method describe():
    if name
    | name
    | String.append(space.describe(), ".view[",
                    to_string(points.length()), "]")

fun select_view(space :: IndexSpace,
                predicate :: Function.of_arity(1),
                ~name: name = #false):
  def selected:
    for List (point in space.points()):
      def keep = predicate(point)
      unless keep is_a Boolean
      | error(~who: #'select_view,
              "view predicate must return a host Boolean for " ++ point.describe())
      if keep | point | #false
  IndexView(space,
            selected.filter(~keep: fun (point): point != #false),
            ~name: name)

fun index_domain_space(domain):
  cond
  | domain is_a IndexSpace: domain
  | domain is_a IndexView: domain.space
  | ~else:
      error(~who: #'Indexed,
            "index domain must be an IndexSpace or IndexView")

fun index_domain_points(domain):
  cond
  | domain is_a IndexSpace: domain.points()
  | domain is_a IndexView: domain.points
  | ~else:
      error(~who: #'Indexed,
            "index domain must be an IndexSpace or IndexView")

fun index_domain_contains(domain, point):
  cond
  | domain is_a IndexSpace: domain.contains(point)
  | domain is_a IndexView: domain.contains(point)
  | ~else: #false

fun index_domain_equal(left, right):
  def left_space = index_domain_space(left)
  def right_space = index_domain_space(right)
  if !(left_space === right_space)
  | #false
  | block:
      def left_points = index_domain_points(left)
      def right_points = index_domain_points(right)
      def points_differ = (
        for List (left_point in left_points, right_point in right_points):
          !point_equal(left_point, right_point)
      ).find(fun (different): different) != #false
      left_points.length() == right_points.length() && !points_differ

fun index_domain_describe(domain):
  cond
  | domain is_a IndexSpace: domain.describe()
  | domain is_a IndexView: domain.describe()
  | ~else: "invalid index domain"
