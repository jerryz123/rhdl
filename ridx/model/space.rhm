#lang rhombus
// Defines nominal finite product spaces, bounded points, and canonical enumeration.

import:
  "../../host/annotations.rhm" open
  "axis.rhm" open

export:
  IndexPoint
  IndexSpace
  point_equal

fun require_optional_name(who, name):
  unless name == #false || (name is_a String && name.length() > 0)
  | error(~who: who, "name must be #false or a nonempty String")
  name

fun duplicate_axis_name(axes, name):
  axes.filter(~keep: fun (axis): axis.name == name).length() > 1

fun coordinate_rows(axes, axis_index):
  if axis_index == axes.length()
  | [[]]
  | block:
      def mutable rows = []
      for (coordinate in 0..axes[axis_index].extent):
        for (suffix in coordinate_rows(axes, axis_index + 1)):
          rows := rows ++ [[coordinate] ++ suffix]
      rows

class IndexPoint(space, coordinates :: List.of(Nat)):
  opaque
  internal _IndexPoint
  constructor ~none

  method coordinate(axis_name :: AsciiIdentifier):
    coordinates[space.axis_index(axis_name)]

  method ordinal():
    space.ordinal(this)

  method describe():
    def fields:
      for List (axis in space.axes, coordinate in coordinates):
        axis.name ++ "=" ++ to_string(coordinate)
    space.describe() ++ "{" ++ String.join(fields, ",") ++ "}"

fun point_equal(left, right):
  left is_a IndexPoint && right is_a IndexPoint && left.space === right.space && left.coordinates == right.coordinates

class IndexSpace(axes :: NonemptyList.of(Axis), name, cardinality :: PosInt):
  constructor (axes :: NonemptyList.of(Axis), ~name: name = #false):
    require_optional_name(#'IndexSpace, name)
    for (axis in axes):
      when duplicate_axis_name(axes, axis.name)
      | error(~who: #'IndexSpace, "duplicate axis name " ++ axis.name)
    def mutable cardinality = 1
    for (axis in axes):
      cardinality := cardinality * axis.extent
    super(axes, name, cardinality)

  method rank():
    axes.length()

  method axis_index(axis_name :: AsciiIdentifier):
    def found = axes.find_index(fun (axis): axis.name == axis_name)
    unless found != #false
    | error(~who: #'axis_index,
            describe() ++ " has no axis " ++ axis_name)
    found

  method axis(axis_name :: AsciiIdentifier):
    axes[axis_index(axis_name)]

  method contains(point):
    point is_a IndexPoint && point.space === this

  method point(coordinates :: List.of(Nat)):
    unless coordinates.length() == axes.length()
    | error(~who: #'point,
            String.append(describe(), " expects ", to_string(axes.length()),
                          " coordinates, received ",
                          to_string(coordinates.length())))
    for (axis in axes, coordinate in coordinates):
      unless coordinate < axis.extent
      | error(~who: #'point,
              String.append("coordinate ", axis.name, "=",
                            to_string(coordinate), " is outside ",
                            axis.describe(), " in ", describe()))
    _IndexPoint(this, coordinates)

  method points():
    coordinate_rows(axes, 0).map(fun (coordinates): point(coordinates))

  method ordinal(point :: IndexPoint):
    unless contains(point)
    | error(~who: #'ordinal,
            "point does not belong to " ++ describe())
    def mutable result = 0
    for (axis in axes, coordinate in point.coordinates):
      result := result * axis.extent + coordinate
    result

  method describe():
    if name
    | name
    | "Space[" ++ String.join(axes.map(fun (axis): axis.describe()), ",") ++ "]"
