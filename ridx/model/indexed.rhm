#lang rhombus
// Defines total canonically ordered host-value associations over Ridx domains.

import:
  "domain.rhm" open
  "space.rhm" open
  "view.rhm" open

export:
  IndexEntry
  Indexed
  index_by

// Indexed values are intentionally opaque to Ridx; only their point keys are
// interpreted by this package.
class IndexEntry(point :: IndexPoint, value :~ matching(_))

fun entries_for_point(entries :: List.of(IndexEntry), point :: IndexPoint):
  entries.filter(~keep: fun (entry): point_equal(entry.point, point))

fun entry_for_point(entries :: List.of(IndexEntry), point :: IndexPoint):
  entries.find(fun (entry): point_equal(entry.point, point))

class Indexed(domain :: IndexDomain, entries :: List.of(IndexEntry)):
  constructor (domain :: IndexDomain,
               supplied_entries :: List.of(IndexEntry)):
    def expected_points = domain.points()
    for (entry in supplied_entries):
      unless domain.contains(entry.point)
      | error(~who: #'Indexed,
              String.append("point ", entry.point.describe(),
                            " does not belong to ",
                            domain.describe()))
      when entries_for_point(supplied_entries, entry.point).length() > 1
      | error(~who: #'Indexed,
              "duplicate indexed point " ++ entry.point.describe())
    def mutable ordered_entries = []
    for (point in expected_points):
      def found = entry_for_point(supplied_entries, point)
      unless found
      | error(~who: #'Indexed,
              "missing indexed point " ++ point.describe())
      ordered_entries := ordered_entries ++ [found]
    super(domain, ordered_entries)

  method contains(point :~ IndexPoint):
    domain.contains(point)

  method get(point :: IndexPoint):
    unless contains(point)
    | error(~who: #'get,
            String.append("point ", point.describe(),
                          " does not belong to ",
                          domain.describe()))
    entry_for_point(entries, point).value

  method values():
    entries.map(fun (entry): entry.value)

  method length():
    entries.length()

  method describe():
    String.append("Indexed[", domain.describe(), "]: ",
                  to_string(entries.length()), " values")

fun index_by(domain :: IndexDomain,
             producer :: Function.of_arity(1)):
  Indexed(
    domain,
    for List (point in domain.points()):
      IndexEntry(point, producer(point))
  )
