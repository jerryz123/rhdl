#lang rhombus
// Defines identity-bearing directed incidence and its set-valued relation projection.

import:
  "domain.rhm" open
  "space.rhm" open
  "view.rhm" open
  "mapping.rhm" open
  "relation.rhm" open

export:
  Incidence
  IncidenceRelation

fun require_incidence_name(name):
  unless name == #false || (name is_a String && name.length() > 0)
  | error(~who: #'Incidence,
          "name must be #false or a nonempty String")
  name

fun require_edge_domain(subject, edges, mapping :: Mapping):
  unless index_domain_equal(edges, mapping.source_domain)
  | error(~who: #'Incidence,
          String.append(subject, " mapping domain ",
                        mapping.source_domain.describe(),
                        " does not equal edge domain ", edges.describe()))

class Incidence(edges :: IndexSpace,
                sources :: Mapping,
                destinations :: Mapping,
                name):
  constructor (edges :: IndexSpace,
               sources :: Mapping,
               destinations :: Mapping,
               ~name: name = #false):
    require_incidence_name(name)
    require_edge_domain("source", edges, sources)
    require_edge_domain("destination", edges, destinations)
    super(edges, sources, destinations, name)

  method source(edge :: IndexPoint): sources.get(edge)
  method destination(edge :: IndexPoint): destinations.get(edge)

  method edges_from(source_point :: IndexPoint, ~name: name = #false):
    sources.inverse_view(source_point, ~name: name)

  method edges_to(destination_point :: IndexPoint, ~name: name = #false):
    destinations.inverse_view(destination_point, ~name: name)

  method as_relation(): IncidenceRelation(this)

  method describe():
    if name
    | name
    | String.append("Incidence[", edges.describe(), ": ",
                    sources.target_domain.describe(), " -> ",
                    destinations.target_domain.describe(), "]")

class IncidenceRelation(incidence :: Incidence):
  implements Relation

  override method source_domain() :: IndexDomain:
    incidence.sources.target_domain
  override method target_domain() :: IndexDomain:
    incidence.destinations.target_domain
  override method describe():
    "incidence-relation(" ++ incidence.describe() ++ ")"
