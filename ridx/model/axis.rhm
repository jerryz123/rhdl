#lang rhombus
// Defines named positive finite axes for Ridx product spaces.

import:
  "../../host/annotations.rhm" open

export:
  Axis
  axis_equal

class Axis(name :: AsciiIdentifier, extent :: PosInt):

  method describe():
    name ++ ":" ++ to_string(extent)

fun axis_equal(left, right):
  left is_a Axis && right is_a Axis && left.name == right.name && left.extent == right.extent
