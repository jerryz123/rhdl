#lang rhombus
// Materializes symbolic Ridx relations into immutable canonical pair snapshots.

import:
  "../model/space.rhm" open
  "../model/view.rhm" open
  "../model/relation.rhm" open
  "../model/incidence.rhm" open

export:
  RelationPair
  MaterializedRelation
  relation_pair_equal
  materialize_relation

class RelationPair(source :: IndexPoint, target :: IndexPoint)

fun relation_pair_equal(left, right):
  if left is_a RelationPair && right is_a RelationPair
  | point_equal(left.source, right.source) && point_equal(left.target, right.target)
  | #false

fun pair_present(pairs, source, target):
  pairs.find(
    fun (pair): point_equal(pair.source, source) && point_equal(pair.target, target)
  ) != #false

fun canonical_pairs(source_domain, target_domain, supplied_pairs):
  def mutable ordered = []
  for (source in index_domain_points(source_domain)):
    for (target in index_domain_points(target_domain)):
      when pair_present(supplied_pairs, source, target)
      | ordered := ordered ++ [RelationPair(source, target)]
  ordered

class MaterializedRelation(source_domain,
                           target_domain,
                           pairs :: List.of(RelationPair)):
  opaque
  internal _MaterializedRelation
  constructor ~none

  method contains(source :: IndexPoint, target :: IndexPoint):
    def endpoints_valid = index_domain_contains(source_domain, source) && index_domain_contains(target_domain, target)
    endpoints_valid && pair_present(pairs, source, target)

  method length(): pairs.length()

  method describe():
    String.append("MaterializedRelation[",
                  index_domain_describe(source_domain), " -> ",
                  index_domain_describe(target_domain), "]: ",
                  to_string(pairs.length()), " pairs")

fun snapshot(source_domain, target_domain, supplied_pairs):
  _MaterializedRelation(
    source_domain,
    target_domain,
    canonical_pairs(source_domain, target_domain, supplied_pairs)
  )

fun pairs_compose(first_pairs, second_pairs, source, middle, target):
  pair_present(first_pairs, source, middle) && pair_present(second_pairs, middle, target)

class MaterializationCacheEntry(node :: Relation,
                                result :: MaterializedRelation)

fun shifted_coordinate(coordinate, extent, delta, boundary):
  def mutable shifted = coordinate + delta
  if boundary == "drop"
  | block:
      if shifted < 0 || shifted >= extent
      | #false
      | shifted
  | block:
      while shifted < 0:
        shifted := shifted + extent
      while shifted >= extent:
        shifted := shifted - extent
      shifted

fun materialize_shift(relation :: ShiftRelation):
  def axis_index = relation.space.axis_index(relation.axis_name)
  def extent = relation.space.axes[axis_index].extent
  def mutable pairs = []
  for (source in relation.space.points()):
    def shifted = shifted_coordinate(
      source.coordinates[axis_index], extent,
      relation.delta, relation.boundary
    )
    when shifted != #false
    | block:
        def target_coordinates:
          for List (coordinate in source.coordinates,
                    index in 0..source.coordinates.length()):
            if index == axis_index | shifted | coordinate
        pairs := pairs ++ [
          RelationPair(source, relation.space.point(target_coordinates))
        ]
  snapshot(relation.space, relation.space, pairs)

fun materialize_permutation(relation :: PermutationRelation):
  def pairs:
    for List (source in relation.source.points()):
      RelationPair(
        source,
        relation.target.point(
          relation.target_axis_sources.map(
            fun (axis_name): source.coordinate(axis_name)
          )
        )
      )
  snapshot(relation.source, relation.target, pairs)

fun materialize_relation(relation :: Relation):
  def mutable cache = []

  fun materialize_node(node :: Relation):
    def found = cache.find(fun (entry): entry.node === node)
    if found
    | found.result
    | block:
        def result:
          cond
          | node is_a IdentityRelation:
              def points = index_domain_points(node.domain)
              snapshot(
                node.domain,
                node.domain,
                points.map(fun (point): RelationPair(point, point))
              )
          | node is_a UniversalRelation:
              def mutable pairs = []
              for (source in index_domain_points(node.source)):
                for (target in index_domain_points(node.target)):
                  pairs := pairs ++ [RelationPair(source, target)]
              snapshot(node.source, node.target, pairs)
          | node is_a ShiftRelation:
              materialize_shift(node)
          | node is_a PermutationRelation:
              materialize_permutation(node)
          | node is_a DomainRestrictionRelation:
              def child = materialize_node(node.relation)
              snapshot(
                node.view,
                child.target_domain,
                child.pairs.filter(
                  ~keep: fun (pair): node.view.contains(pair.source)
                )
              )
          | node is_a RangeRestrictionRelation:
              def child = materialize_node(node.relation)
              snapshot(
                child.source_domain,
                node.view,
                child.pairs.filter(
                  ~keep: fun (pair): node.view.contains(pair.target)
                )
              )
          | node is_a ConverseRelation:
              def child = materialize_node(node.relation)
              snapshot(
                child.target_domain,
                child.source_domain,
                child.pairs.map(
                  fun (pair): RelationPair(pair.target, pair.source)
                )
              )
          | node is_a UnionRelation:
              def left = materialize_node(node.operands[0])
              def right = materialize_node(node.operands[1])
              snapshot(left.source_domain, left.target_domain,
                       left.pairs ++ right.pairs)
          | node is_a IntersectionRelation:
              def left = materialize_node(node.operands[0])
              def right = materialize_node(node.operands[1])
              snapshot(
                left.source_domain,
                left.target_domain,
                left.pairs.filter(
                  ~keep: fun (pair): pair_present(right.pairs, pair.source, pair.target)
                )
              )
          | node is_a CompositionRelation:
              def first = materialize_node(node.first)
              def second = materialize_node(node.second)
              def mutable pairs = []
              for (source in index_domain_points(first.source_domain)):
                for (target in index_domain_points(second.target_domain)):
                  def connects = index_domain_points(first.target_domain).find(
                    fun (middle): pairs_compose(first.pairs, second.pairs, source, middle, target)
                  ) != #false
                  when connects
                  | pairs := pairs ++ [RelationPair(source, target)]
              snapshot(first.source_domain, second.target_domain, pairs)
          | node is_a IncidenceRelation:
              def incidence = node.incidence
              def pairs:
                for List (edge in incidence.edges.points()):
                  RelationPair(
                    incidence.source(edge),
                    incidence.destination(edge)
                  )
              snapshot(node.source_domain(), node.target_domain(), pairs)
          | node is_a OpaquePredicateRelation:
              def mutable pairs = []
              for (source in index_domain_points(node.source)):
                for (target in index_domain_points(node.target)):
                  def included = node.predicate(source, target)
                  unless included is_a Boolean
                  | error(~who: #'materialize_relation,
                          String.append("opaque relation ", node.label,
                                        " predicate must return a host Boolean for ",
                                        source.describe(), " -> ",
                                        target.describe()))
                  when included
                  | pairs := pairs ++ [RelationPair(source, target)]
              snapshot(node.source, node.target, pairs)
          | ~else:
              error(~who: #'materialize_relation,
                    "unknown symbolic relation node")
        cache := cache ++ [MaterializationCacheEntry(node, result)]
        result

  materialize_node(relation)
