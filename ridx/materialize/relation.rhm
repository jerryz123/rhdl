#lang rhombus
// Materializes symbolic Ridx relations into immutable canonical pair snapshots.

import:
  "../model/space.rhm" open
  "../model/view.rhm" open
  "../model/relation.rhm" open
  "../model/incidence.rhm" open

export:
  RelationPair
  MaterializedRelation
  relation_pair_equal
  materialize_relation

class RelationPair(source :: IndexPoint, target :: IndexPoint)

fun relation_pair_equal(left, right):
  if left is_a RelationPair && right is_a RelationPair
  | point_equal(left.source, right.source) && point_equal(left.target, right.target)
  | #false

fun pair_present(pairs, source, target):
  pairs.find(
    fun (pair): point_equal(pair.source, source) && point_equal(pair.target, target)
  ) != #false

fun relation_pair_less(left :: RelationPair, right :: RelationPair):
  def left_source = left.source.ordinal()
  def right_source = right.source.ordinal()
  if left_source == right_source
  | left.target.ordinal() < right.target.ordinal()
  | left_source < right_source

fun canonical_pairs(source_domain, target_domain, supplied_pairs):
  for (pair in supplied_pairs):
    unless index_domain_contains(source_domain, pair.source) && index_domain_contains(target_domain, pair.target)
    | error(~who: #'materialize_relation,
            "relation pair endpoints do not belong to the declared domains")
  def sorted = supplied_pairs.sort(relation_pair_less)
  def mutable ordered = []
  for (pair in sorted):
    def previous = if ordered == [] | #false | ordered[ordered.length() - 1]
    unless previous && relation_pair_equal(previous, pair)
    | ordered := ordered ++ [pair]
  ordered

class MaterializedRelation(source_domain,
                           target_domain,
                           pairs :: List.of(RelationPair)):
  opaque
  internal _MaterializedRelation
  constructor ~none

  method contains(source :: IndexPoint, target :: IndexPoint):
    def endpoints_valid = index_domain_contains(source_domain, source) && index_domain_contains(target_domain, target)
    endpoints_valid && pair_present(pairs, source, target)

  method length(): pairs.length()

  method describe():
    String.append("MaterializedRelation[",
                  index_domain_describe(source_domain), " -> ",
                  index_domain_describe(target_domain), "]: ",
                  to_string(pairs.length()), " pairs")

fun snapshot(source_domain, target_domain, supplied_pairs):
  _MaterializedRelation(
    source_domain,
    target_domain,
    canonical_pairs(source_domain, target_domain, supplied_pairs)
  )

fun shifted_coordinate(coordinate, extent, delta, boundary):
  def mutable shifted = coordinate + delta
  if boundary == "drop"
  | block:
      if shifted < 0 || shifted >= extent
      | #false
      | shifted
  | block:
      while shifted < 0:
        shifted := shifted + extent
      while shifted >= extent:
        shifted := shifted - extent
      shifted

fun materialize_shift(relation :: ShiftRelation):
  def axis_index = relation.space.axis_index(relation.axis_name)
  def extent = relation.space.axes[axis_index].extent
  def mutable pairs = []
  for (source in relation.space.points()):
    def shifted = shifted_coordinate(
      source.coordinates[axis_index], extent,
      relation.delta, relation.boundary
    )
    when shifted != #false
    | block:
        def target_coordinates:
          for List (coordinate in source.coordinates,
                    index in 0..source.coordinates.length()):
            if index == axis_index | shifted | coordinate
        pairs := pairs ++ [
          RelationPair(source, relation.space.point(target_coordinates))
        ]
  snapshot(relation.space, relation.space, pairs)

fun materialize_relation(relation :: Relation):
  cond
  | relation is_a ShiftRelation:
      materialize_shift(relation)
  | relation is_a IncidenceRelation:
      def incidence = relation.incidence
      def pairs:
        for List (edge in incidence.edges.points()):
          RelationPair(
            incidence.source(edge),
            incidence.destination(edge)
          )
      snapshot(relation.source_domain(), relation.target_domain(), pairs)
  | ~else:
      error(~who: #'materialize_relation,
            "unknown stabilized relation node")
