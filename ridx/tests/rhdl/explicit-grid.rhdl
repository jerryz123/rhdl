#lang rhdl
// Defines the explicit-loop structural reference for the Ridx RHDL grid experiment.

circuit GridCell():
  input seed: Bool
  input dropped_neighbor: Bool
  input wrapped_neighbor: Bool
  output source: Bool

  source <== seed

circuit Grid():
  def width = 2
  def height = 3
  def GridCellModule = GridCell()
  def cells = for InstanceArray (_index in 0..(width * height)):
    inst cell(GridCellModule)

  for (x in 0..width):
    for (y in 0..height):
      def index = (x * height) + y
      cells[index].seed <== Bool(x == 1)

  for (y in 0..height):
    cells[y].dropped_neighbor <== Bool(#false)

  for (y in 0..height):
    cells[height + y].dropped_neighbor <== cells[y].source

  for (x in 0..width):
    for (y in 0..height):
      def source_y = if y == 0 | height - 1 | y - 1
      def destination_index = (x * height) + y
      def source_index = (x * height) + source_y
      cells[destination_index].wrapped_neighbor <== cells[source_index].source

def design = elaborate(Grid())

export:
  GridCell
  Grid
  design
