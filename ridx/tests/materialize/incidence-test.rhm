#lang rhombus
// Checks identity-bearing incidence, edge fibers, metadata, and relation projection.

import:
  "../../model/main.rhm" open
  "../../materialize/main.rhm" open

fun point_coordinates(view):
  view.points().map(fun (point): point.coordinates)

fun pair_coordinates(snapshot):
  snapshot.pairs.map(
    fun (pair): [pair.source.coordinates, pair.target.coordinates]
  )

def nodes = IndexSpace([Axis("node", 3)], ~name: "nodes")
def edges = IndexSpace([Axis("edge", 5)], ~name: "edges")

def sources = mapping_by(
  edges,
  nodes,
  fun (edge):
    cond
    | edge.coordinate("edge") == 2: nodes.point([1])
    | edge.coordinate("edge") == 3: nodes.point([2])
    | ~else: nodes.point([0])
)

def destinations = mapping_by(
  edges,
  nodes,
  fun (edge):
    cond
    | edge.coordinate("edge") == 3: nodes.point([0])
    | edge.coordinate("edge") == 4: nodes.point([2])
    | ~else: nodes.point([1])
)

def graph = Incidence(edges, sources, destinations, ~name: "graph")
def adjacency = graph.as_relation()
def widths = index_by(
  edges,
  fun (edge): 8 + edge.coordinate("edge") * 8
)

check:
  graph.source(edges.point([0])).coordinates ~is [0]
  graph.destination(edges.point([0])).coordinates ~is [1]
  graph.source(edges.point([1])).coordinates ~is [0]
  graph.destination(edges.point([1])).coordinates ~is [1]
  graph.source(edges.point([2])).coordinates ~is [1]
  graph.destination(edges.point([2])).coordinates ~is [1]
  point_coordinates(graph.edges_from(nodes.point([0]))) ~is [[0], [1], [4]]
  point_coordinates(graph.edges_to(nodes.point([1]))) ~is [[0], [1], [2]]
  point_coordinates(graph.edges_from(nodes.point([1]))) ~is [[2]]
  point_coordinates(graph.edges_to(nodes.point([2]))) ~is [[4]]
  widths.values() ~is [8, 16, 24, 32, 40]
  widths.get(edges.point([0])) ~is 8
  widths.get(edges.point([1])) ~is 16
  adjacency is_a IncidenceRelation ~is #true
  adjacency.source_domain() === nodes ~is #true
  adjacency.target_domain() === nodes ~is #true
  adjacency.describe() ~is "incidence-relation(graph)"

def snapshot = materialize_relation(adjacency)

check:
  edges.cardinality ~is 5
  snapshot.length() ~is 4
  pair_coordinates(snapshot) ~is [
    [[0], [1]], [[0], [2]], [[1], [1]], [[2], [0]]
  ]
  snapshot.contains(nodes.point([0]), nodes.point([1])) ~is #true
  snapshot.contains(nodes.point([1]), nodes.point([1])) ~is #true
  snapshot.contains(nodes.point([1]), nodes.point([0])) ~is #false
  widths.length() ~is 5

def sinks = IndexSpace([Axis("sink", 2)], ~name: "sinks")
def sink_destinations = mapping_by(
  edges,
  sinks,
  fun (edge):
    def ordinal = edge.coordinate("edge")
    if ordinal == 1 || ordinal == 3
    | sinks.point([1])
    | sinks.point([0])
)
def bipartite = Incidence(edges, sources, sink_destinations, ~name: "bipartite")

check:
  bipartite.as_relation().source_domain() === nodes ~is #true
  bipartite.as_relation().target_domain() === sinks ~is #true
  materialize_relation(bipartite.as_relation()).length() ~is 4

def foreign_edges = IndexSpace([Axis("edge", 5)], ~name: "foreign_edges")
def foreign_sources = mapping_by(
  foreign_edges,
  nodes,
  fun (_edge): nodes.point([0])
)
def partial_edges = IndexView(
  edges,
  [edges.point([0]), edges.point([1])],
  ~name: "partial_edges"
)
def partial_destinations = mapping_by(
  partial_edges,
  nodes,
  fun (_edge): nodes.point([1])
)
def foreign_nodes = IndexSpace([Axis("node", 3)], ~name: "foreign_nodes")
def foreign_source_error = "source mapping domain foreign_edges does not equal edge domain edges"
def partial_destination_error = "destination mapping domain partial_edges does not equal edge domain edges"

check:
  Incidence(edges, foreign_sources, destinations) ~throws foreign_source_error
  Incidence(edges, sources, partial_destinations) ~throws partial_destination_error
  Incidence(edges, sources, destinations, ~name: "") ~throws "name must be #false or a nonempty String"
  graph.source(foreign_edges.point([0])) ~throws "does not belong to edges"
  graph.edges_from(foreign_nodes.point([0])) ~throws "does not belong to target domain nodes"
