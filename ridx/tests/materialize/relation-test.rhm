#lang rhombus
// Checks stabilized shift relations, boundary behavior, and canonical snapshots.

import:
  "../../model/main.rhm" open
  "../../materialize/main.rhm" open

fun pair_coordinates(snapshot):
  snapshot.pairs.map(
    fun (pair): [pair.source.coordinates, pair.target.coordinates]
  )

def line = IndexSpace([Axis("x", 4)], ~name: "line")
def forward = shift_relation(line, "x", 1, ~boundary: "drop")
def backward = shift_relation(line, "x", -1, ~boundary: "drop")
def wrapped_forward = shift_relation(line, "x", 1, ~boundary: "wrap")
def wrapped_backward = shift_relation(line, "x", -1, ~boundary: "wrap")
def stationary = shift_relation(line, "x", 0)

check:
  forward is_a ShiftRelation ~is #true
  forward.axis_name ~is "x"
  forward.boundary ~is "drop"
  forward.source_domain() === line ~is #true
  forward.target_domain() === line ~is #true
  forward.describe() ~is "shift(line, x, 1, drop)"
  pair_coordinates(materialize_relation(forward)) ~is [
    [[0], [1]], [[1], [2]], [[2], [3]]
  ]
  pair_coordinates(materialize_relation(backward)) ~is [
    [[1], [0]], [[2], [1]], [[3], [2]]
  ]
  pair_coordinates(materialize_relation(wrapped_forward)) ~is [
    [[0], [1]], [[1], [2]], [[2], [3]], [[3], [0]]
  ]
  pair_coordinates(materialize_relation(wrapped_backward)) ~is [
    [[0], [3]], [[1], [0]], [[2], [1]], [[3], [2]]
  ]
  pair_coordinates(materialize_relation(stationary)) ~is [
    [[0], [0]], [[1], [1]], [[2], [2]], [[3], [3]]
  ]
  materialize_relation(shift_relation(line, "x", 4)).pairs ~is []
  pair_coordinates(
    materialize_relation(shift_relation(line, "x", 5, ~boundary: "wrap"))
  ) ~is pair_coordinates(materialize_relation(wrapped_forward))
  pair_coordinates(
    materialize_relation(shift_relation(line, "x", -5, ~boundary: "wrap"))
  ) ~is pair_coordinates(materialize_relation(wrapped_backward))

def grid = IndexSpace(
  [Axis("x", 2), Axis("y", 3)],
  ~name: "grid"
)
def north = materialize_relation(
  shift_relation(grid, "y", 1, ~boundary: "drop")
)

check:
  pair_coordinates(north) ~is [
    [[0, 0], [0, 1]], [[0, 1], [0, 2]],
    [[1, 0], [1, 1]], [[1, 1], [1, 2]]
  ]
  north.length() ~is 4
  north.contains(grid.point([0, 0]), grid.point([0, 1])) ~is #true
  north.contains(grid.point([0, 2]), grid.point([0, 0])) ~is #false
  north.contains(line.point([0]), grid.point([0, 1])) ~is #false
  relation_pair_equal(north.pairs[0], north.pairs[0]) ~is #true
  relation_pair_equal(north.pairs[0], north.pairs[1]) ~is #false
  shift_relation(line, "x", 1, ~boundary: "reflect") ~throws "boundary must be"
  shift_relation(line, "missing", 1) ~throws "has no axis missing"
