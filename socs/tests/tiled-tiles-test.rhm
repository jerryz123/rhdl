#lang rhombus
// Elaborates representative Ricket, host, ACLINT, transit, and memory tile specializations.

import:
  "../../rhdl/core/main.rhm" open
  "tiled-tiles-fixture.rhdl" as fixture

def ricket_modules = fixture.ricket_tile_design.modules.map(fun (module_def): module_def.name)
def memory_modules = fixture.memory_tile_design.modules.map(fun (module_def): module_def.name)
def router_modules = fixture.chi_router_design.modules.map(fun (module_def): module_def.name)
def aclint_modules = fixture.aclint_tile_design.modules.map(fun (module_def): module_def.name)
def host_modules = fixture.host_tile_design.modules.map(fun (module_def): module_def.name)
def transit_modules = fixture.transit_tile_design.modules.map(fun (module_def): module_def.name)
def ricket_tile = fixture.ricket_tile_design.modules.find(fun (module_def): module_def.name == "RicketTile")
def memory_tile = fixture.memory_tile_design.modules.find(fun (module_def): module_def.name == "MemoryTile")

check:
  router_modules.contains("CHIRouter") ~is #true
  router_modules.contains("SimpleRouterFamily") ~is #true
  router_modules.contains("RoutedFlowInjector") ~is #true
  router_modules.contains("RoutedFlowEjector") ~is #true
  ricket_modules.contains("RicketTile") ~is #true
  ricket_modules.contains("Ricket") ~is #true
  ricket_modules.contains("CHIRouter") ~is #true
  ricket_modules.contains("SimpleRouterFamily") ~is #true
  memory_modules.contains("MemoryTile") ~is #true
  memory_modules.contains("CHIHNF") ~is #true
  memory_modules.contains("CHIAddressProjector") ~is #true
  memory_modules.contains("CHITransferFragmenter") ~is #true
  memory_modules.contains("CHIRam") ~is #true
  memory_modules.contains("CHIRouter") ~is #true
  memory_modules.contains("SimpleRouterFamily") ~is #true
  aclint_modules.contains("AclintTile") ~is #true
  aclint_modules.contains("CHIHNI") ~is #true
  aclint_modules.contains("Aclint") ~is #true
  aclint_modules.contains("CHIRouter") ~is #true
  host_modules.contains("HostTile") ~is #true
  host_modules.contains("CHIRouter") ~is #true
  transit_modules.contains("TransitTile") ~is #true
  transit_modules.contains("CHIRouter") ~is #true
  ricket_tile.inputs.map(fun (input): input.name).contains("identity") ~is #true
  ricket_tile.inputs.map(fun (input): input.name).contains("interrupts") ~is #true
  ricket_tile.inputs.map(fun (input): input.name).contains("time_counter") ~is #true
  memory_tile.inputs.map(fun (input): input.name).contains("identity") ~is #true
  ricket_tile.inputs.map(fun (input): input.name).contains("tile_key") ~is #false
  memory_tile.inputs.map(fun (input): input.name).contains("tile_key") ~is #false
  ricket_tile.operations.filter(~keep: fun (operation): operation.opcode == "rtl.mux_lookup").length() ~is 0
  memory_tile.operations.filter(~keep: fun (operation): operation.opcode == "rtl.mux_lookup").length() ~is 0
  verify_design(fixture.chi_router_design) ~is #void
  verify_design(fixture.ricket_tile_design) ~is #void
  verify_design(fixture.memory_tile_design) ~is #void
  verify_design(fixture.aclint_tile_design) ~is #void
  verify_design(fixture.host_tile_design) ~is #void
  verify_design(fixture.transit_tile_design) ~is #void
