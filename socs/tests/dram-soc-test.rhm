#lang rhombus
// Checks that DramSoC exposes CHI memory channels without an internal RAM.

import:
  "../../rhodium/core/main.rhm" open
  "../../socs/simple-soc.rhdl" as simple
  "../../socs/dram-soc.rhdl" as soc

def design = soc.design
def top = design.modules.find(fun (module_def): module_def.name == "DramSoC")
def module_names = design.modules.map(fun (module_def): module_def.name)

check:
  soc.dram_soc_fabric_params === simple.simple_soc_fabric_params ~is #false
  soc.dram_soc_fabric_params.memory_name ~is "dram-memory"
  soc.dram_soc_ram_config.size_bytes ~is soc.dram_soc_memory_bytes
  soc.dram_soc_ram_params.base_address ~is soc.dram_soc_memory_base
  soc.dram_soc_home_map.entry(soc.dram_soc_memory_base).home === simple.simple_soc_home ~is #true
  soc.dram_soc_home_map.entry(soc.dram_soc_memory_base + soc.dram_soc_memory_bytes) ~is #false
  design.dpi_imports ~is []
  top.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "host_in", "dram_in"
  ]
  top.outputs.map(fun (port): port.name) ~is ["host_out", "dram_out"]
  module_names.contains("SimpleSoCFabric") ~is #true
  module_names.contains("CHITransferFragmenter") ~is #true
  module_names.contains("CHIRam") ~is #false
  verify_design(design) ~is #void
