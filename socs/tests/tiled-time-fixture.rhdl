#lang rhodium
// Elaborates the rotating tiled-time sender, receiver, and standard-demux composition.

import:
  lib("rhodium/std/ready-valid.rhdl").Valid
  lib("rhodium/std/flow/demux.rhdl").Demux
  "../tiled-soc/time.rhdl" open

def TestHartCount = 3

sync_circuit TiledTimePath():
  interface update(Valid(Bits(64)), ~role: consumer)
  output time_values: Vec(TestHartCount, Bits(64))

  inst sweeper(TiledTimeSweeper(TestHartCount))
  inst demux(Demux(TiledTimeBeat(TestHartCount), TestHartCount))
  def receivers = for InstanceArray (_ in 0..TestHartCount):
    inst receiver(TiledTimeReceiver(TestHartCount))

  update <=> sweeper.update
  sweeper.egress <=> demux.ingress
  demux.select <== sweeper.egress.bits.hart
  for (index in 0..TestHartCount):
    demux.egress[index] <=> receivers[index].ingress
  time_values <== vec(for List (index in 0..TestHartCount): receivers[index].value)

def sweeper_design = elaborate(TiledTimeSweeper(TestHartCount))
def receiver_design = elaborate(TiledTimeReceiver(TestHartCount))
def path_design = elaborate(TiledTimePath())

export:
  TestHartCount
  TiledTimePath
  sweeper_design
  receiver_design
  path_design
