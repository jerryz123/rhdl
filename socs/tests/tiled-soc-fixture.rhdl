#lang rhodium
// Elaborates default and compact TiledSoC configurations for hierarchy tests.

import:
  "../tiled-soc.rhdl".TiledSoC
  "../tiled-soc-config.rhdl" as configuration
  "../tiled-soc-spec.rhm" open

def tiled_soc_design = elaborate(TiledSoC())

def compact_layout = tile_grid:
  row [llc(2)]
  row [host, aclint]
  row [rv5stage, transit]
def compact_spec = TiledSoCSpec(
  ~layout: compact_layout,
  ~node_ids: TiledNodeIdPlan(
    ~rv5stage_coherent_base: 0,
    ~rv5stage_device_base: 2,
    ~host: 3,
    ~llc_home_base: 4,
    ~aclint_home: 6,
    ~backing_memory_base: 7,
    ~aclint_subordinate: 9
  ),
  ~memory: StripedMemorySpec(
    ~base: 0x80000000,
    ~bank_bytes: 0x1000,
    ~stripe_bytes: 64
  ),
  ~llc: TiledLLCSpec(
    ~sets: 8,
    ~ways: 2
  )
)
def compact_config = configuration.compile_tiled_soc(compact_spec)
def compact_tiled_soc_design = elaborate(TiledSoC(compact_config))

export:
  tiled_soc_design
  compact_config
  compact_tiled_soc_design
