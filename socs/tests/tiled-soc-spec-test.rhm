#lang rhombus
// Checks declarative tile-grid expansion, coordinates, indexing, and layout validation.

import:
  "../tiled-soc-spec.rhm" open

def layout = tile_grid:
  row [llc(4)]
  row [host, aclint, transit(2)]
  row [rv5stage(4)]
  row [rv5stage(4)]

check:
  layout.width ~is 4
  layout.height ~is 4
  layout.rv5stages.length() ~is 8
  layout.llcs.length() ~is 4
  layout.hosts.length() ~is 1
  layout.aclints.length() ~is 1
  layout.transits.length() ~is 2
  layout.tile_at(0, 0) is_a RV5StageTileSpec ~is #true
  layout.tile_at(3, 1) is_a RV5StageTileSpec ~is #true
  layout.tile_at(0, 2) is_a HostTileSpec ~is #true
  layout.tile_at(1, 2) is_a AclintTileSpec ~is #true
  layout.tile_at(2, 2) is_a TransitTileSpec ~is #true
  layout.tile_at(0, 3) is_a LLCTileSpec ~is #true
  layout.rv5stages.map(
    fun (cell): [cell.coordinate.x, cell.coordinate.y]
  ) ~is [[0, 0], [1, 0], [2, 0], [3, 0],
         [0, 1], [1, 1], [2, 1], [3, 1]]
  layout.llcs.map(
    fun (cell): [cell.coordinate.x, cell.coordinate.y]
  ) ~is [[0, 3], [1, 3], [2, 3], [3, 3]]

check:
  TileGrid([
    [llc_tile, llc_tile],
    [host_tile, aclint_tile],
    [rv5stage_tile]
  ]) ~throws "equal width"
  TileGrid([
    [llc_tile, llc_tile],
    [host_tile, host_tile],
    [aclint_tile, rv5stage_tile]
  ]) ~throws "exactly one host"
