#lang rhombus
// Checks the rotating fixed-width time transport and its ordinary demux composition.

import:
  "../../rhodium/core/main.rhm" open
  "tiled-time-fixture.rhdl" as fixture

def sweeper = fixture.sweeper_design.modules.find(
  fun (module_def): module_def.name == "TiledTimeSweeper"
)
def receiver = fixture.receiver_design.modules.find(
  fun (module_def): module_def.name == "TiledTimeReceiver"
)
def path_modules = fixture.path_design.modules.map(fun (module_def): module_def.name)

check:
  sweeper.find_input("update_in").type.field("bits").type.width ~is 64
  sweeper.find_output("egress_out").type.field("bits").type.field("hart").type.width ~is 2
  sweeper.find_output("egress_out").type.field("bits").type.field("flit").type.field("payload").type.width ~is 16
  sweeper.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name")) ~is ["active", "packet_pending", "hart_index"]
  sweeper.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register"
  ).map(fun (operation): operation.attribute("name")) ~is ["snapshot"]

check:
  receiver.find_input("ingress_in").type.field("bits").type.field("flit").type.field("payload").type.width ~is 16
  receiver.find_output("value").type.width ~is 64
  receiver.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name")) ~is ["time_value"]
  path_modules.contains("TiledTimePath") ~is #true
  path_modules.contains("TiledTimeSweeper") ~is #true
  path_modules.contains("Packetizer") ~is #true
  path_modules.contains("OfferRegister") ~is #true
  path_modules.contains("Demux") ~is #true
  path_modules.contains("TiledTimeReceiver") ~is #true
  path_modules.contains("Reassembler") ~is #true
  fixture.path_design.modules.find(
    fun (module_def): module_def.name == "TiledTimePath"
  ).find_output("time_values").type.length ~is fixture.TestHartCount
  verify_design(fixture.sweeper_design) ~is #void
  verify_design(fixture.receiver_design) ~is #void
  verify_design(fixture.path_design) ~is #void
