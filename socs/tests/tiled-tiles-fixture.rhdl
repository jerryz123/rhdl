#lang rhodium
// Elaborates representative RV5Stage, LLC, host, device-home, ACLINT, and UART tiles.

import:
  "../tiled-soc/main.rhdl" as tiled
  "../tiled-soc/compile.rhdl" as compiler
  lib("chi/main.rhdl").CHIRouter
  "../tiled-soc/tiles/main.rhdl" open

def compiled = compiler.compile_tiled_soc(tiled.default_tiled_soc_config)
def chi_router_design = elaborate(CHIRouter(compiled.rv5stages[0].tile_params.router))
def rv5stage_tile_design = elaborate(RV5StageTile(compiled.rv5stages[0].tile_params))
def llc_tile_design = elaborate(LLCTile(compiled.llcs[0].tile_params))
def device_home_tile_design = elaborate(DeviceHomeTile(compiled.device_home.tile_params))
def aclint_tile_design = elaborate(AclintTile(compiled.aclint.tile_params))
def uart_tile_design = elaborate(UartTile(compiled.uart.tile_params))
def host_tile_design = elaborate(HostTile(compiled.host.tile_params))

export:
  chi_router_design
  rv5stage_tile_design
  llc_tile_design
  device_home_tile_design
  aclint_tile_design
  uart_tile_design
  host_tile_design
