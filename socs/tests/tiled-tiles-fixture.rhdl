#lang rhdl
// Elaborates representative RV5Stage, host, service-row, ACLINT, and memory tiles.

import:
  "../tiled-soc-config.rhdl" as config
  lib("chi/main.rhdl").CHIRouter
  "../rv5stage-tile.rhdl".RV5StageTile
  "../memory-tile.rhdl".MemoryTile
  "../aclint-tile.rhdl".AclintTile
  "../host-tile.rhdl".HostTile
  "../transit-tile.rhdl".TransitTile

def chi_router_design = elaborate(CHIRouter(config.tiled_soc_rv5stage_router_params))
def rv5stage_tile_design = elaborate(RV5StageTile(config.tiled_soc_rv5stage_tile_params))
def memory_tile_design = elaborate(MemoryTile(config.tiled_soc_memory_tile_params))
def aclint_tile_design = elaborate(AclintTile(config.tiled_soc_aclint_tile_params))
def host_tile_design = elaborate(HostTile(config.tiled_soc_host_tile_params))
def transit_tile_design = elaborate(TransitTile(config.tiled_soc_transit_tile_params))

export:
  chi_router_design
  rv5stage_tile_design
  memory_tile_design
  aclint_tile_design
  host_tile_design
  transit_tile_design
