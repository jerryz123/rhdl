#lang rhombus
// Verifies the complete tiled SoC hierarchy and parent-owned mesh composition.

import:
  "../../rhodium/core/main.rhm" open
  "tiled-soc-fixture.rhdl" as fixture

def module_names = fixture.tiled_soc_design.modules.map(fun (module_def): module_def.name)
def top = fixture.tiled_soc_design.modules.find(fun (module_def): module_def.name == "TiledSoC")
def compact_module_names = fixture.compact_tiled_soc_design.modules.map(fun (module_def): module_def.name)
def compact_top = fixture.compact_tiled_soc_design.modules.find(fun (module_def): module_def.name == "TiledSoC")

check:
  module_names.contains("TiledSoC") ~is #true
  module_names.contains("RV5StageTile") ~is #true
  module_names.contains("LLCTile") ~is #true
  module_names.contains("AclintTile") ~is #true
  module_names.contains("HostTile") ~is #true
  module_names.contains("TransitTile") ~is #true
  module_names.contains("CHIRouter") ~is #true
  module_names.contains("RV5Stage") ~is #true
  module_names.contains("CHIInclusiveHNF") ~is #true
  module_names.contains("CHIHNI") ~is #true
  module_names.contains("Aclint") ~is #true
  module_names.contains("CHIAddressProjector") ~is #true
  module_names.contains("CHITransferFragmenter") ~is #true
  module_names.contains("CHIRam") ~is #true
  module_names.contains("SimpleRouterFamily") ~is #true
  module_names.filter(~keep: fun (name): name == "RV5StageTile").length() ~is 1
  module_names.filter(~keep: fun (name): name == "LLCTile").length() ~is 1
  module_names.filter(~keep: fun (name): name == "AclintTile").length() ~is 1
  module_names.filter(~keep: fun (name): name == "HostTile").length() ~is 1
  module_names.filter(~keep: fun (name): name == "TransitTile").length() ~is 1
  module_names.filter(~keep: fun (name): name == "RV5Stage").length() ~is 1
  module_names.filter(~keep: fun (name): name == "CHIInclusiveHNF").length() ~is 1
  module_names.filter(~keep: fun (name): name == "CHIAddressProjector").length() ~is 1
  module_names.filter(~keep: fun (name): name == "CHIRam").length() ~is 1
  top.inputs.map(fun (input): input.name) ~is ["clock", "reset", "host_in"]
  top.find_input("host_in").type.field("start").type.field("bits").type.width ~is 64
  verify_design(fixture.tiled_soc_design) ~is #void

check:
  fixture.compact_config.plan.width ~is 2
  fixture.compact_config.plan.height ~is 3
  fixture.compact_config.rv5stages.length() ~is 1
  fixture.compact_config.llcs.length() ~is 2
  fixture.compact_config.transits.length() ~is 1
  compact_module_names.contains("RV5StageTile") ~is #true
  compact_module_names.contains("LLCTile") ~is #true
  compact_module_names.contains("CHIInclusiveHNF") ~is #true
  compact_module_names.contains("TransitTile") ~is #true
  compact_top.find_output("faults").type.length ~is 1
  verify_design(fixture.compact_tiled_soc_design) ~is #void
