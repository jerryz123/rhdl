#lang rhombus
// Compiles declarative TiledSoC intent into placements and validated four-plane CHI routing.

import:
  "../chi/noc-authoring.rhm" open
  "../noc/authoring/main.rhm" open
  "../noc/plan/main.rhm" open
  "../noc/std/topology/main.rhm" open
  "../noc/std/routing/main.rhm" open
  "tiled-soc-spec.rhm" open

export:
  TiledRV5StagePlacement
  TiledHostPlacement
  TiledLLCPlacement
  TiledAclintPlacement
  TiledTransitPlacement
  TiledChannelFamilyPlans
  TiledSoCPlan
  compile_tiled_soc_plan
  tiled_soc_layout
  tiled_soc_spec
  tiled_soc_plan

class TiledRV5StagePlacement(index :: Nat,
                             coordinate :: MeshCoordinate,
                             router :: NodeRef,
                             instruction_node_id :: Nat,
                             data_node_id :: Nat,
                             device_node_id :: Nat,
                             instruction_site :: CHIRNSite,
                             data_site :: CHIRNSite,
                             device_site :: CHIRNSite)

class TiledHostPlacement(coordinate :: MeshCoordinate,
                         router :: NodeRef,
                         node_id :: Nat,
                         site :: CHIRNSite)

class TiledLLCPlacement(index :: Nat,
                        coordinate :: MeshCoordinate,
                        router :: NodeRef,
                        home_node_id :: Nat,
                        subordinate_node_id :: Nat,
                        bank_index :: Nat,
                        bank_bytes :: PosInt,
                        home_site :: CHIRNICNSite)

class TiledAclintPlacement(coordinate :: MeshCoordinate,
                           router :: NodeRef,
                           home_node_id :: Nat,
                           subordinate_node_id :: Nat,
                           home_requester_site :: CHIRNICNSite,
                           home_subordinate_site :: CHISNICNSite,
                           device_site :: CHISNSite)

class TiledTransitPlacement(index :: Nat,
                            coordinate :: MeshCoordinate,
                            router :: NodeRef)

class TiledChannelFamilyPlans(req :: RouterFamilyPlan,
                              rsp :: RouterFamilyPlan,
                              snp :: RouterFamilyPlan,
                              dat :: RouterFamilyPlan)

class TiledSoCPlan(spec :: TiledSoCSpec,
                   mesh :: RectangularMesh,
                   rv5stages :: NonemptyList.of(TiledRV5StagePlacement),
                   llcs :: NonemptyList.of(TiledLLCPlacement),
                   transits :: List.of(TiledTransitPlacement),
                   host :: TiledHostPlacement,
                   aclint :: TiledAclintPlacement,
                   rnf_sites :: NonemptyList.of(CHIRNSite),
                   device_sites :: NonemptyList.of(CHIRNSite),
                   connections :: NonemptyList.of(CHIConnection),
                   compilations :: CHIChannelCompilations,
                   snp_compilation :: CHIChannelCompilation,
                   families :: TiledChannelFamilyPlans,
                   physical_plan :: RouterFamilyPhysicalPlan,
                   node_ids :: NonemptyList.of(Nat)):
  property width :: PosInt: spec.layout.width
  property height :: PosInt: spec.layout.height
  property rv5stage_count :: PosInt: rv5stages.length()
  property bank_count :: PosInt: llcs.length()
  property bank_base :: Nat: spec.memory.base
  property bank_bytes :: PosInt: spec.memory.bank_bytes
  property stripe_bytes :: PosInt: spec.memory.stripe_bytes

  method site_key(router :: NodeRef) :: Nat:
    physical_plan.site_key(compilations.req.network.router_id(router))

fun require_unique_tiled_node_ids(node_ids :: NonemptyList.of(Nat)):
  for (node_id in node_ids):
    when node_ids.filter(~keep: fun (candidate): candidate == node_id).length() > 1
    | error(~who: #'compile_tiled_soc_plan, "TiledSoC NodeIDs must be unique")

fun compile_tiled_soc_plan(spec :: TiledSoCSpec) :: TiledSoCPlan:
  def layout = spec.layout
  def ids = spec.node_ids
  def memory = spec.memory
  def mesh = rectangular_mesh(layout.width,
                              layout.height,
                              [VCGroup("transport", 1)])

  def rv5stages:
    for List (cell in layout.rv5stages,
              index in 0..layout.rv5stages.length()):
      def coordinate = cell.coordinate
      def router = mesh.node_at(coordinate.x, coordinate.y)
      def path = NamePath(["rv5stage", to_string(index)])
      def instruction_node_id = ids.rv5stage_coherent_base + (index * 2)
      def data_node_id = instruction_node_id + 1
      def device_node_id = ids.rv5stage_device_base + index
      TiledRV5StagePlacement(
        index,
        coordinate,
        router,
        instruction_node_id,
        data_node_id,
        device_node_id,
        CHIRNSite(path.child("l1i"), instruction_node_id, router),
        CHIRNSite(path.child("l1d"), data_node_id, router),
        CHIRNSite(path.child("device"), device_node_id, router)
      )

  def llcs:
    for List (cell in layout.llcs,
              index in 0..layout.llcs.length()):
      def coordinate = cell.coordinate
      def router = mesh.node_at(coordinate.x, coordinate.y)
      def home_node_id = ids.llc_home_base + index
      def subordinate_node_id = ids.backing_memory_base + index
      TiledLLCPlacement(
        index,
        coordinate,
        router,
        home_node_id,
        subordinate_node_id,
        index,
        memory.bank_bytes,
        CHIRNICNSite(NamePath(["llc", to_string(index), "home"]), home_node_id, router)
      )

  def host_cell = layout.hosts[0]
  def host_router = mesh.node_at(host_cell.coordinate.x, host_cell.coordinate.y)
  def host = TiledHostPlacement(
    host_cell.coordinate,
    host_router,
    ids.host,
    CHIRNSite(NamePath(["host"]), ids.host, host_router)
  )

  def aclint_cell = layout.aclints[0]
  def aclint_router = mesh.node_at(aclint_cell.coordinate.x, aclint_cell.coordinate.y)
  def aclint = TiledAclintPlacement(
    aclint_cell.coordinate,
    aclint_router,
    ids.aclint_home,
    ids.aclint_subordinate,
    CHIRNICNSite(NamePath(["aclint", "home", "requester"]),
                 ids.aclint_home,
                 aclint_router),
    CHISNICNSite(NamePath(["aclint", "home", "subordinate"]),
                 ids.aclint_home,
                 aclint_router),
    CHISNSite(NamePath(["aclint", "device"]),
              ids.aclint_subordinate,
              aclint_router)
  )

  def transits:
    for List (cell in layout.transits,
              index in 0..layout.transits.length()):
      TiledTransitPlacement(
        index,
        cell.coordinate,
        mesh.node_at(cell.coordinate.x, cell.coordinate.y)
      )

  def mutable rnf_sites = [host.site]
  for (placement in rv5stages):
    rnf_sites := rnf_sites ++ [placement.instruction_site, placement.data_site]
  def device_sites = rv5stages.map(fun (placement): placement.device_site)

  def mutable connections = []
  for (requester in rnf_sites):
    for (llc_placement in llcs):
      connections := connections ++ [CHIRNFConnection(requester, llc_placement.home_site)]
  for (requester in device_sites):
    connections := connections ++ [CHIRNIConnection(requester, aclint.home_requester_site)]
  connections := connections ++ [
    CHISNConnection(aclint.home_subordinate_site, aclint.device_site)
  ]

  def routing = uniform_chi_routing(
    xy_dimension_order(mesh, ~vc_groups: ["transport"])
  )
  def compilations = compile_chi_connections(mesh.spec, connections, routing)
  def snp_compilation :: CHIChannelCompilation = compilations.snp
  def families = TiledChannelFamilyPlans(
    RouterFamilyPlan(compilations.req.network.network_plan),
    RouterFamilyPlan(compilations.rsp.network.network_plan),
    RouterFamilyPlan(snp_compilation.network.network_plan),
    RouterFamilyPlan(compilations.dat.network.network_plan)
  )
  def physical_plan = RouterFamilyPhysicalPlan(families.req)
  physical_plan.require_match(families.rsp)
  physical_plan.require_match(families.snp)
  physical_plan.require_match(families.dat)

  def node_ids = rv5stages.map(
    fun (placement): placement.instruction_node_id
  ) ++ rv5stages.map(
    fun (placement): placement.data_node_id
  ) ++ rv5stages.map(
    fun (placement): placement.device_node_id
  ) ++ llcs.map(
    fun (placement): placement.home_node_id
  ) ++ llcs.map(
    fun (placement): placement.subordinate_node_id
  ) ++ [host.node_id, aclint.home_node_id, aclint.subordinate_node_id]
  require_unique_tiled_node_ids(node_ids)

  TiledSoCPlan(spec,
               mesh,
               rv5stages,
               llcs,
               transits,
               host,
               aclint,
               rnf_sites,
               device_sites,
               connections,
               compilations,
               snp_compilation,
               families,
               physical_plan,
               node_ids)

def tiled_soc_layout = tile_grid:
  row [llc(4)]
  row [host, aclint, transit(2)]
  row [rv5stage(4)]
  row [rv5stage(4)]

def tiled_soc_spec = TiledSoCSpec(
  ~layout: tiled_soc_layout,
  ~node_ids: TiledNodeIdPlan(
    ~rv5stage_coherent_base: 0,
    ~rv5stage_device_base: 16,
    ~host: 24,
    ~llc_home_base: 32,
    ~aclint_home: 36,
    ~backing_memory_base: 48,
    ~aclint_subordinate: 52
  ),
  ~memory: StripedMemorySpec(
    ~base: 0x80000000,
    ~bank_bytes: 0x2000,
    ~stripe_bytes: 64
  ),
  ~llc: TiledLLCSpec(
    ~sets: 16,
    ~ways: 4
  )
)

def tiled_soc_plan = compile_tiled_soc_plan(tiled_soc_spec)
