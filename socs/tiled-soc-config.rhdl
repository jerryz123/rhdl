#lang rhodium
// Compiles a TiledSoC plan into occurrence-local CHI, router, LLC, and device parameters.

import:
  lib("chi/main.rhdl") open
  lib("noc/rtl/router.rhdl") open
  lib("cores/rv5stage/chi.rhdl") open
  lib("riscv/rtl/pma.rhdl") open
  lib("devices/aclint.rhdl").AclintParams
  lib("devices/uart16550.rhdl").Uart16550Params
  "peripherals.rhdl" open
  "tiles/main.rhdl" open
  "tiled-soc-spec.rhm" open
  "tiled-soc-plan.rhm" as planning

class TiledRV5StageConfig(placement :: planning.TiledRV5StagePlacement,
                          chi :: RV5StageCHIParams,
                          tile_params :: RV5StageTileParams)

class TiledLLCConfig(placement :: planning.TiledLLCPlacement,
                     home_params :: CHIHNFParams,
                     llc_config :: CHIInclusiveHNFConfig,
                     projector_params :: CHIAddressProjectorParams,
                     fragmenter_params :: CHITransferFragmenterParams,
                     ram_params :: CHIRamParams,
                     tile_params :: LLCTileParams)

class TiledHostConfig(placement :: planning.TiledHostPlacement,
                      node :: CHINodeParams,
                      port :: CHIICNPortParams,
                      tile_params :: HostTileParams)

class TiledDeviceHomeConfig(placement :: planning.TiledDeviceHomePlacement,
                            home :: CHIHomeParams,
                            home_params :: CHIHNIParams,
                            tile_params :: DeviceHomeTileParams)

class TiledAclintConfig(placement :: planning.TiledAclintPlacement,
                        device :: AclintParams,
                        tile_params :: AclintTileParams)

class TiledUartConfig(placement :: planning.TiledUartPlacement,
                      device :: Uart16550Params,
                      tile_params :: UartTileParams)

class TiledTransitConfig(placement :: planning.TiledTransitPlacement,
                         tile_params :: TransitTileParams)

class TiledSoCConfig(plan :: planning.TiledSoCPlan,
                     flit :: CHIFlitParams,
                     home_map :: CHIHomeMap,
                     rv5stage_config :: RV5StageCHIConfig,
                     projector_config :: CHIAddressProjectorConfig,
                     hnf_config :: CHIHNFConfig,
                     llc_config :: CHIInclusiveHNFConfig,
                     ram_config :: CHIRamConfig,
                     fragmenter_config :: CHITransferFragmenterConfig,
                     peripherals :: SoCPeripheralParams,
                     adapter_plans :: CHIChannelAdapterPlans,
                     router_configs :: CHIRouterFamilyConfigs,
                     rv5stages :: NonemptyList.of(TiledRV5StageConfig),
                     llcs :: NonemptyList.of(TiledLLCConfig),
                     host :: TiledHostConfig,
                     device_home :: TiledDeviceHomeConfig,
                     aclint :: TiledAclintConfig,
                     uart :: TiledUartConfig,
                     transits :: List.of(TiledTransitConfig)):
  implements StableCircuitParam

fun tiled_requester_icn_endpoint(node :: CHINodeParams) :: CHIICNPortParams:
  CHIICNPortParams(
    node.name ++ "-icn",
    node.node_id,
    node.kind,
    ~emits: node.supports,
    ~supports: node.emits,
    ~max_outstanding: node.max_outstanding
  )

fun require_tiled_node_id_width(plan :: planning.TiledSoCPlan,
                                flit :: CHIFlitParams):
  for (node_id in plan.node_ids):
    unless bits.length(node_id) <= flit.node_id_width
    | error(~who: #'compile_tiled_soc, "TiledSoC NodeID does not fit the CHI flit")

fun compile_tiled_soc(spec :: TiledSoCSpec,
                      ~flit: flit :: CHIFlitParams = CHIFlitParams()) :: TiledSoCConfig:
  def plan = planning.compile_tiled_soc_plan(spec)
  require_tiled_node_id_width(plan, flit)

  def host_node = CHINodeParams(
    "host",
    plan.host.node_id,
    CHINodeKind.RNF,
    ~emits: CHIChannelCapabilities(
      ~req: [CHIReqOpcode.ReadClean, CHIReqOpcode.WriteUniquePtl],
      ~rsp: [CHIRspOpcode.SnpResp],
      ~dat: [CHIDatOpcode.NonCopyBackWriteData]
    ),
    ~supports: CHIChannelCapabilities(
      ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
      ~snp: chi_rnf_snoop_opcodes,
      ~dat: [CHIDatOpcode.CompData]
    ),
    ~max_outstanding: 1
  )
  def host_port = tiled_requester_icn_endpoint(host_node)

  def projector_config = CHIAddressProjectorConfig(
    flit,
    plan.bank_bytes,
    plan.stripe_bytes,
    plan.bank_count
  )

  def homes:
    for List (placement in plan.llcs):
      CHIHomeParams("tiled-home-" ++ to_string(placement.index),
                    placement.home_node_id,
                    CHINodeKind.HNF,
                    ~max_outstanding: 1)
  def device_home = CHIHomeParams("tiled-device-home",
                                  plan.device_home.node_id,
                                  CHINodeKind.HNI,
                                  ~max_outstanding: 1)

  def memory_attributes = RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true)
  def rv5stage_config = RV5StageCHIConfig(
    flit,
    (for List (placement in plan.llcs,
               home in homes):
       RV5StageCHIRegion(
         RiscvPhysicalMemoryRegion(
           projector_config.address_set(plan.bank_base, placement.bank_index),
           memory_attributes
         ),
         home
       )) ++ soc_peripheral_regions(device_home)
  )

  def rv5stage_chi_params:
    for List (placement in plan.rv5stages):
      RV5StageCHIParams(rv5stage_config,
                        placement.instruction_node_id,
                        placement.data_node_id,
                        ~device_node_id: placement.device_node_id)
  def mutable requester_ports = [host_port]
  for (params in rv5stage_chi_params):
    requester_ports := requester_ports ++ [
      tiled_requester_icn_endpoint(params.instruction_node),
      tiled_requester_icn_endpoint(params.data_node)
    ]
  def device_ports = rv5stage_chi_params.map(
    fun (params): tiled_requester_icn_endpoint(params.device_node)
  )

  def peripherals = SoCPeripheralParams(flit,
                                        plan.rv5stage_count,
                                        device_home,
                                        device_ports,
                                        plan.aclint.node_id,
                                        plan.uart.node_id)

  def ram_config = CHIRamConfig(flit,
                                plan.bank_bytes,
                                ~max_outstanding: 2)
  def ram_params:
    for List (placement in plan.llcs):
      CHIRamParams("tiled-ram-" ++ to_string(placement.index),
                   placement.subordinate_node_id,
                   ram_config,
                   ~base_address: 0,
                   ~kind: CHINodeKind.SNF)
  def fragmenter_config = CHITransferFragmenterConfig(flit, ~max_transfer_bytes: 64)
  def fragmenter_params:
    for List (ram in ram_params):
      CHITransferFragmenterParams(fragmenter_config, ram.service)
  def projector_params:
    for List (placement in plan.llcs,
              fragmenter in fragmenter_params):
      CHIAddressProjectorParams(projector_config,
                                fragmenter.upstream_service,
                                plan.bank_base,
                                placement.bank_index)

  def hnf_config = CHIHNFConfig(
    flit,
    requester_ports,
    projector_config.global_mask,
    fragmenter_config.upstream_requests(ram_config.requests)
  )
  def hnf_params:
    for List (home in homes,
              ram in ram_params,
              projector in projector_params):
      CHIHNFParams(home, hnf_config, ram.icn_port, projector.upstream_service)
  def llc_config = CHIInclusiveHNFConfig(
    hnf_config,
    projector_config,
    ~sets: spec.llc.sets,
    ~ways: spec.llc.ways
  )

  def adapter_plans = CHIChannelAdapterPlans(
    compile_chi_channel_family_adapter_plan(plan.compilations.req,
                                            plan.families.req,
                                            flit),
    compile_chi_channel_family_adapter_plan(plan.compilations.rsp,
                                            plan.families.rsp,
                                            flit),
    compile_chi_channel_family_adapter_plan(plan.snp_compilation,
                                            plan.families.snp,
                                            flit),
    compile_chi_channel_family_adapter_plan(plan.compilations.dat,
                                            plan.families.dat,
                                            flit)
  )
  def router_configs = CHIRouterFamilyConfigs(
    compile_simple_router_family(plan.families.req),
    compile_simple_router_family(plan.families.rsp),
    compile_simple_router_family(plan.families.snp),
    compile_simple_router_family(plan.families.dat),
    plan.physical_plan
  )

  def rv5stage_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(
        ~rnf_sites: (for List (placement in plan.rv5stages):
                      [placement.instruction_site, placement.data_site]),
        ~rni_sites: (for List (placement in plan.rv5stages):
                      [placement.device_site])
      )
    )
  )
  def llc_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(
        ~hnf_requester_sites: (for List (placement in plan.llcs):
                                [placement.home_site])
      )
    )
  )
  def device_home_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(
        ~hni_requester_sites: [[plan.device_home.requester_site]],
        ~hn_subordinate_sites: [[plan.device_home.subordinate_site]]
      )
    )
  )
  def aclint_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(~sn_sites: [[plan.aclint.site]])
    )
  )
  def uart_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(~sn_sites: [[plan.uart.site]])
    )
  )
  def host_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(~rnf_sites: [[plan.host.site]])
    )
  )
  def transit_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments()
    )
  )

  def rv5stage_tile_params = RV5StageTileParams(rv5stage_config,
                                                rv5stage_router_params)
  def llc_tile_params = LLCTileParams(llc_config,
                                      projector_config,
                                      fragmenter_config,
                                      ram_config,
                                      llc_router_params)
  def device_home_tile_params = DeviceHomeTileParams(peripherals.home_params, device_home_router_params)
  def aclint_tile_params = AclintTileParams(peripherals.aclint_config, aclint_router_params)
  def uart_tile_params = UartTileParams(peripherals.uart_config, uart_router_params)
  def host_tile_params = HostTileParams(host_router_params)
  def transit_tile_params = TransitTileParams(transit_router_params)

  def rv5stages:
    for List (placement in plan.rv5stages,
              params in rv5stage_chi_params):
      TiledRV5StageConfig(placement, params, rv5stage_tile_params)
  def llcs:
    for List (placement in plan.llcs,
              home in hnf_params,
              projector in projector_params,
              fragmenter in fragmenter_params,
              ram in ram_params):
      TiledLLCConfig(placement,
                     home,
                     llc_config,
                     projector,
                     fragmenter,
                     ram,
                     llc_tile_params)
  def host = TiledHostConfig(plan.host,
                             host_node,
                             host_port,
                             host_tile_params)
  def device_home_config = TiledDeviceHomeConfig(plan.device_home,
                                                 device_home,
                                                 peripherals.home_params,
                                                 device_home_tile_params)
  def aclint = TiledAclintConfig(plan.aclint,
                                 peripherals.aclint,
                                 aclint_tile_params)
  def uart = TiledUartConfig(plan.uart,
                             peripherals.uart,
                             uart_tile_params)
  def transits:
    for List (placement in plan.transits):
      TiledTransitConfig(placement, transit_tile_params)

  TiledSoCConfig(plan,
                 flit,
                 rv5stage_config.home_map,
                 rv5stage_config,
                 projector_config,
                 hnf_config,
                 llc_config,
                 ram_config,
                 fragmenter_config,
                 peripherals,
                 adapter_plans,
                 router_configs,
                 rv5stages,
                 llcs,
                 host,
                 device_home_config,
                 aclint,
                 uart,
                 transits)

def tiled_soc_config = compile_tiled_soc(planning.tiled_soc_spec)

export:
  TiledRV5StageConfig
  TiledLLCConfig
  TiledHostConfig
  TiledDeviceHomeConfig
  TiledAclintConfig
  TiledUartConfig
  TiledTransitConfig
  TiledSoCConfig
  tiled_requester_icn_endpoint
  compile_tiled_soc
  tiled_soc_config
