#lang rhdl
// Implements one Ricket tile around a bundled four-plane CHI router.

import:
  lib("rhdl/std/ready-valid.rhdl").Irrevocable
  lib("chi/main.rhdl") open
  lib("cores/ricket/chi.rhdl") open
  lib("cores/ricket/interrupt.rhdl").RicketInterrupts
  lib("cores/ricket/ricket.rhdl").Ricket
  lib("riscv/isa/xlen.rhm").XLen

class RicketTileParams(ricket :: RicketCHIConfig,
                       router :: CHIRouterParams):
  implements CircuitParam

bundle RicketTileIdentity(p :: CHIFlitParams, site_width :: PosInt):
  site_key: Bits(site_width)
  hart_id: Bits(64)
  chi: RicketCHIIdentity(p)

sync_circuit RicketTile(params :: RicketTileParams):
  def router_params = params.router
  def p = params.ricket.flit
  def site_width = router_params.routers.req.route_decoder.site_width
  def Link = chi_noc_link_type(router_params)

  input identity: RicketTileIdentity(p, site_width)
  interface start(Irrevocable(Bits(64)), ~role: consumer)
  input interrupts: RicketInterrupts()
  input time_counter: Bits(64)
  output fault: Bool
  interface incoming_links[router_params.routers.physical.ingress_count](Link, ~role: destination)
  interface outgoing_links[router_params.routers.physical.egress_count](Link, ~role: source)

  inst ricket(Ricket(XLen.X64, ~chi: params.ricket))
  inst router(CHIRouter(router_params))

  ricket.chi_identity <== identity.chi
  ricket.interrupts <== interrupts
  ricket.hart_id <== identity.hart_id
  ricket.time_counter <== time_counter
  router.site_key <== identity.site_key
  start |> ricket.start
  fault <== ricket.fault
  def instruction_channels :: Endpoint = router.rnf_local[0]
  def data_channels :: Endpoint = router.rnf_local[1]
  def device_channels :: Endpoint = router.rni_local[0]
  ricket.imem <=> instruction_channels
  ricket.dmem <=> data_channels
  ricket.umem <=> device_channels
  router.incoming_links <=> incoming_links
  router.outgoing_links <=> outgoing_links

export:
  RicketTileIdentity
  RicketTileParams
  RicketTile
