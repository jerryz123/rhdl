#lang rhdl
// Defines the common loader-memory and boot-entry boundary exposed by SoCs.

import:
  lib("rhdl/std/ready-valid.rhdl").Irrevocable
  lib("chi/main.rhdl").CHIFlitParams
  lib("chi/main.rhdl").CHIRNIChannels

interface SoCHostInterface(p :: CHIFlitParams):
  role host
  role soc
  provider host

  soc -> host:
    memory: CHIRNIChannels(p)

  host -> soc:
    start: Irrevocable(Bits(64))

export:
  SoCHostInterface
