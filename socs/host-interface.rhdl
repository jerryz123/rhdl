#lang rhodium
// Defines the common coherent loader-memory and boot-entry boundary exposed by SoCs.

import:
  lib("rhodium/std/ready-valid.rhdl").Irrevocable
  lib("chi/main.rhdl").CHIFlitParams
  lib("chi/main.rhdl").CHIRNChannels

interface SoCHostInterface(p :: CHIFlitParams):
  role host
  role soc
  provider host

  soc -> host:
    memory: CHIRNChannels(p)

  host -> soc:
    start: Irrevocable(Bits(64))

export:
  SoCHostInterface
