#lang rhodium
// Defines the SimpleSoC-derived variant with an external CHI DRAM channel boundary.

import:
  lib("chi/main.rhdl") open
  lib("socs/simple-soc.rhdl") as simple
  lib("socs/host-interface.rhdl").SoCHostInterface

def dram_soc_memory_base = 0x80000000
def dram_soc_memory_bytes = 0x40000000
def dram_soc_fabric_params:
  simple.SimpleSoCFabricParams("dram-memory",
                               dram_soc_memory_base,
                               dram_soc_memory_bytes)
def dram_soc_flit = dram_soc_fabric_params.flit
def dram_soc_home_map = dram_soc_fabric_params.home_map
def dram_soc_host_node = simple.simple_soc_host_node
def dram_soc_ram_config = dram_soc_fabric_params.ram_config
def dram_soc_ram_params = dram_soc_fabric_params.ram_params

// Requires a cache-line-capable external SN-F while leaving storage and
// response timing outside the SoC.
sync_circuit DramSoC(params :: simple.SimpleSoCFabricParams = dram_soc_fabric_params):
  interface host(SoCHostInterface(params.flit), ~role: soc)
  interface dram(CHISNChannels(params.flit), ~role: icn)

  inst fabric(simple.SimpleSoCFabric(params))

  host <=> fabric.host
  fabric.memory <=> dram

def design = elaborate(DramSoC())

export:
  dram_soc_memory_base
  dram_soc_memory_bytes
  dram_soc_fabric_params
  dram_soc_flit
  dram_soc_home_map
  dram_soc_host_node
  dram_soc_ram_config
  dram_soc_ram_params
  DramSoC
  design
