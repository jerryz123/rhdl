#lang rhdl
// Implements one HN-F memory tile around a bundled four-plane CHI router.

import:
  lib("chi/main.rhdl") open

class MemoryTileParams(home :: CHIHNFConfig,
                       projector :: CHIAddressProjectorConfig,
                       fragmenter :: CHITransferFragmenterConfig,
                       ram :: CHIRamConfig,
                       router :: CHIRouterParams):
  implements StableCircuitParam

bundle MemoryTileIdentity(p :: CHIFlitParams, site_width :: PosInt):
  site_key: Bits(site_width)
  home: CHIHNFIdentity(p)
  projector: CHIAddressProjectorIdentity(p)
  ram: CHIRamIdentity(p)

sync_circuit MemoryTile(params :: MemoryTileParams):
  def router_params = params.router
  def p = params.home.flit
  def site_width = router_params.routers.req.route_decoder.site_width
  def Link = chi_noc_link_type(router_params)

  input identity: MemoryTileIdentity(p, site_width)
  interface incoming_links[router_params.routers.physical.ingress_count](Link, ~role: destination)
  interface outgoing_links[router_params.routers.physical.egress_count](Link, ~role: source)

  inst home(CHIHNF(params.home))
  inst projector(CHIAddressProjector(params.projector))
  inst fragmenter(CHITransferFragmenter(params.fragmenter))
  inst ram(CHIRam(params.ram))
  inst router(CHIRouter(router_params))

  home.identity <== identity.home
  projector.identity <== identity.projector
  ram.identity <== identity.ram
  router.site_key <== identity.site_key
  def home_channels :: Endpoint = router.local[0]
  home.port.requester <=> home_channels
  home.port.subordinate <=> projector.upstream
  projector.downstream <=> fragmenter.upstream
  fragmenter.downstream <=> ram.port
  router.incoming_links <=> incoming_links
  router.outgoing_links <=> outgoing_links

export:
  MemoryTileIdentity
  MemoryTileParams
  MemoryTile
