#lang rhdl
// Adapts the direct-memory FESVR DPI tick to typed RHDL simulation protocols.

import:
  lib("rhdl/std/simple-memory.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open

dpi_import function rhdl_htif_tick(
  reset: Bool,
  request_ready: Bool,
  response_valid: Bool,
  response_data: Bits(32),
  start_ready: Bool
) -> (
  out request_valid: Bool,
  out request_write: Bool,
  out request_address: Bits(32),
  out request_data: Bits(32),
  out response_ready: Bool,
  out start_valid: Bool,
  out start_entry: Bits(32),
  return exit: Bits(32)
)

// Keeps the generated DPI signature flat and stable for the C++ boundary.
// RHDL designs should normally instantiate FesvrHost below instead.
sync_circuit DirectMemoryHTIF():
  input(request_ready, response_valid, start_ready): Bool
  input response_data: Bits(32)
  output(request_valid, request_write, response_ready, start_valid): Bool
  output(request_address, request_data, start_entry, exit): Bits(32)

  dpi_reg (htif_request_valid,
           htif_request_write,
           htif_request_address,
           htif_request_data,
           htif_response_ready,
           htif_start_valid,
           htif_start_entry,
           htif_exit) = rhdl_htif_tick(
    cast(reset_active(), Bool),
    request_ready,
    response_valid,
    response_data,
    start_ready
  )

  request_valid <== htif_request_valid
  request_write <== htif_request_write
  request_address <== htif_request_address
  request_data <== htif_request_data
  response_ready <== htif_response_ready
  start_valid <== htif_start_valid
  start_entry <== htif_start_entry
  exit <== htif_exit

// The initial FESVR transport is deliberately fixed to its C++ contract:
// RV32 addresses and one 32-bit little-endian word per transaction. FESVR
// performs read-modify-write when loading a partial word, so every transport
// write enables all four bytes on SimpleMemory.
sync_circuit FesvrHost():
  interface memory(SimpleMemory(32, 4), ~role: requester)
  interface start(Irrevocable(Bits(32)), ~role: producer)
  output exit: Bits(32)

  inst raw(DirectMemoryHTIF())

  raw.request_ready <== memory.request.ready
  raw.response_valid <== memory.response.valid
  raw.response_data <== memory.response.bits.data
  raw.start_ready <== start.ready

  memory.request.valid <== raw.request_valid
  memory.request.bits.address <== raw.request_address
  memory.request.bits.write <== raw.request_write
  memory.request.bits.data <== raw.request_data
  memory.request.bits.mask <== bits(0xf, 4)
  memory.response.ready <== raw.response_ready

  start.valid <== raw.start_valid
  start.bits <== raw.start_entry
  exit <== raw.exit

def design = elaborate(FesvrHost())

export:
  DirectMemoryHTIF
  FesvrHost
  design
