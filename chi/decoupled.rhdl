#lang rhdl
// Defines reusable ready-valid CHI Request, Home, and Subordinate Node contracts.

import:
  lib("rhdl/std/ready-valid.rhdl").Decoupled
  lib("chi/params.rhdl").CHIFlitParams
  lib("chi/flits.rhdl") open

interface CHIRNRspDecoupled(p :: CHIFlitParams):
  role node
  role icn
  provider node

  node -> icn:
    requester: Decoupled(CHIRspFlit(p))

  icn -> node:
    response: Decoupled(CHIRspFlit(p))

interface CHIDatDecoupled(p :: CHIFlitParams):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(CHIDatFlit(p))

  responder -> requester:
    response: Decoupled(CHIDatFlit(p))

// RN-I recursively groups its independent REQ, RSP, and DAT flows without
// forcing the coherent RN SNP channel onto a non-snooping requester.
interface CHIRNIDecoupled(p :: CHIFlitParams):
  role icn
  role node
  provider node

  node -> icn:
    req: Decoupled(CHIReqFlit(p))
    rsp: CHIRNRspDecoupled(p)
    dat: CHIDatDecoupled(p)

// RN-F and RN-D share the full requester shape. These physical RSP and DAT
// flows may carry both ordinary requester traffic and snoop responses, so they
// remain explicit alongside the ICN-to-node SNP flow.
interface CHIRNDecoupled(p :: CHIFlitParams):
  role icn
  role node
  provider node

  node -> icn:
    requests: Decoupled(CHIReqFlit(p))
    requester_responses: Decoupled(CHIRspFlit(p))
    request_data: Decoupled(CHIDatFlit(p))

  icn -> node:
    responses: Decoupled(CHIRspFlit(p))
    response_data: Decoupled(CHIDatFlit(p))
    snoops: Decoupled(CHISnpFlit(p))

// SN-F and SN-I share this channel shape; their kind and capabilities remain
// static endpoint metadata rather than changing the ready-valid wires.
interface CHISNDecoupled(p :: CHIFlitParams):
  role icn
  role node
  provider node

  node -> icn:
    rsp: Decoupled(CHIRspFlit(p))

  icn -> node:
    req: Decoupled(CHIReqFlit(p))
    dat: CHIDatDecoupled(p)

// HN-I connects one recursively grouped non-snooping requester side to one
// subordinate side.
interface CHIHNIDecoupled(p :: CHIFlitParams):
  role home
  role fabric
  provider home

  home -> fabric:
    requester: CHIRNIDecoupled(p)
    subordinate: CHISNDecoupled(p)

// A snoop-capable Home uses the full RN requester shape and the common
// subordinate shape.
interface CHIHNDecoupled(p :: CHIFlitParams):
  role home
  role fabric
  provider home

  home -> fabric:
    requester: CHIRNDecoupled(p)
    subordinate: CHISNDecoupled(p)

export:
  CHIRNRspDecoupled
  CHIDatDecoupled
  CHIRNIDecoupled
  CHIRNDecoupled
  CHISNDecoupled
  CHIHNIDecoupled
  CHIHNDecoupled
