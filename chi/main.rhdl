#lang rhdl
// Re-exports public AMBA CHI parameters, flits, node links, and endpoint monitors.

import:
  lib("chi/params.rhdl") open
  lib("chi/flits.rhdl") open
  lib("chi/protocol.rhdl") open
  lib("chi/transaction.rhdl") open
  lib("chi/link.rhdl") open
  lib("chi/monitor.rhdl") open

export:
  CHIFlitParams
  CHIReqOpcode
  CHIRspOpcode
  CHISnpOpcode
  CHIDatOpcode
  CHIReqFlit
  CHIRspFlit
  CHISnpFlit
  CHIDatFlit
  chi_req_is_atomic_store
  chi_req_is_atomic_load
  chi_req_is_atomic
  chi_req_is_read_no_snp
  chi_req_is_write_no_snp
  chi_rsp_allocates_dbid
  chi_dat_is_write_data
  chi_dat_is_response_data
  chi_size_valid
  chi_data_beats_minus_one
  chi_data_id_valid
  chi_initial_request_supported
  chi_initial_write_request
  chi_initial_single_flit_size
  CHINodeKind
  CHIChannelCapabilities
  CHINodeParams
  CHIICNPortParams
  CHIRNLinkParams
  CHIRNILinkParams
  CHISNLinkParams
  CHIRNLink
  CHIRNILink
  CHISNLink
  monitor_chi_rn
  monitor_chi_rni
  monitor_chi_sn
