#lang rhdl
// Defines CHI node roles, channel capabilities, credited links, legality, and monitor attachment.

import:
  lib("host/annotations.rhm") open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/credited.rhdl") open
  lib("chi/params.rhdl") open
  lib("chi/flits.rhdl") open
  lib("chi/monitor.rhdl") open

enum CHINodeKind
| RNF
| RND
| RNI
| SNF
| SNI

fun chi_subordinate_node_kind(kind):
  [CHINodeKind.SNF, CHINodeKind.SNI].contains(kind)

class CHIChannelCapabilities(req :: List.of(CHIReqOpcode),
                             rsp :: List.of(CHIRspOpcode),
                             snp :: List.of(CHISnpOpcode),
                             dat :: List.of(CHIDatOpcode)):
  constructor (~req: req = [], ~rsp: rsp = [], ~snp: snp = [], ~dat: dat = []):
    super(req, rsp, snp, dat)

fun opcode_lists_contain(supported, emitted):
  for all (opcode in emitted):
    supported.contains(opcode)

fun capabilities_contain(supported, emitted):
  for all (pair in [[supported.req, emitted.req],
                    [supported.rsp, emitted.rsp],
                    [supported.snp, emitted.snp],
                    [supported.dat, emitted.dat]]):
    opcode_lists_contain(pair[0], pair[1])

fun capabilities_use_only(capabilities, ~req, ~rsp, ~snp, ~dat):
  for all (condition in [(req || capabilities.req.length() == 0),
                         (rsp || capabilities.rsp.length() == 0),
                         (snp || capabilities.snp.length() == 0),
                         (dat || capabilities.dat.length() == 0)]):
    condition

fun dvm_snoop_capabilities(capabilities):
  for all (opcode in capabilities.snp):
    opcode.packed_value() == CHISnpOpcode.SnpDVMOp.packed_value()

fun validate_endpoint_capabilities(kind :: CHINodeKind,
                                   emits :: CHIChannelCapabilities,
                                   supports :: CHIChannelCapabilities,
                                   side,
                                   who):
  def legal:
    cond
    | side == "node" && [CHINodeKind.RNF, CHINodeKind.RND].contains(kind):
        for all (condition in [
          capabilities_use_only(emits, ~req: #true, ~rsp: #true, ~snp: #false, ~dat: #true),
          capabilities_use_only(supports, ~req: #false, ~rsp: #true, ~snp: #true, ~dat: #true),
          (kind != CHINodeKind.RND || dvm_snoop_capabilities(supports))
        ]):
          condition
    | side == "icn" && [CHINodeKind.RNF, CHINodeKind.RND].contains(kind):
        for all (condition in [
          capabilities_use_only(emits, ~req: #false, ~rsp: #true, ~snp: #true, ~dat: #true),
          capabilities_use_only(supports, ~req: #true, ~rsp: #true, ~snp: #false, ~dat: #true),
          (kind != CHINodeKind.RND || dvm_snoop_capabilities(emits))
        ]):
          condition
    | side == "node" && kind == CHINodeKind.RNI:
        for all (condition in [
          capabilities_use_only(emits, ~req: #true, ~rsp: #true, ~snp: #false, ~dat: #true),
          capabilities_use_only(supports, ~req: #false, ~rsp: #true, ~snp: #false, ~dat: #true)
        ]):
          condition
    | side == "icn" && kind == CHINodeKind.RNI:
        for all (condition in [
          capabilities_use_only(emits, ~req: #false, ~rsp: #true, ~snp: #false, ~dat: #true),
          capabilities_use_only(supports, ~req: #true, ~rsp: #true, ~snp: #false, ~dat: #true)
        ]):
          condition
    | side == "node" && chi_subordinate_node_kind(kind):
        for all (condition in [
          capabilities_use_only(emits, ~req: #false, ~rsp: #true, ~snp: #false, ~dat: #true),
          capabilities_use_only(supports, ~req: #true, ~rsp: #false, ~snp: #false, ~dat: #true)
        ]):
          condition
    | side == "icn" && chi_subordinate_node_kind(kind):
        for all (condition in [
          capabilities_use_only(emits, ~req: #true, ~rsp: #false, ~snp: #false, ~dat: #true),
          capabilities_use_only(supports, ~req: #false, ~rsp: #true, ~snp: #false, ~dat: #true)
        ]):
          condition
    | ~else: #false
  unless legal
  | error(~who: who,
          "channel capabilities are not valid for the " ++ to_string(kind) ++ " " ++ side ++ " role")

class CHINodeParams(name :: NonemptyString, node_id :: Nat, kind :: CHINodeKind,
                    emits :: CHIChannelCapabilities, supports :: CHIChannelCapabilities):
  constructor (name :: NonemptyString,
               node_id :: Nat,
               kind :: CHINodeKind,
               ~emits: emits :: CHIChannelCapabilities,
               ~supports: supports :: CHIChannelCapabilities):
    validate_endpoint_capabilities(kind, emits, supports, "node", #'CHINodeParams)
    super(name, node_id, kind, emits, supports)

class CHIICNPortParams(name :: NonemptyString, node_id :: Nat, kind :: CHINodeKind,
                       emits :: CHIChannelCapabilities, supports :: CHIChannelCapabilities):
  constructor (name :: NonemptyString,
               node_id :: Nat,
               kind :: CHINodeKind,
               ~emits: emits :: CHIChannelCapabilities,
               ~supports: supports :: CHIChannelCapabilities):
    validate_endpoint_capabilities(kind, emits, supports, "icn", #'CHIICNPortParams)
    super(name, node_id, kind, emits, supports)

class CHIRNLinkParams(flit :: CHIFlitParams,
                      tx_req_credits :: PosInt,
                      tx_rsp_credits :: PosInt,
                      tx_dat_credits :: PosInt,
                      rx_rsp_credits :: PosInt,
                      rx_dat_credits :: PosInt,
                      rx_snp_credits :: PosInt):
  constructor (flit,
               ~tx_req_credits: tx_req_credits :: PosInt = 2,
               ~tx_rsp_credits: tx_rsp_credits :: PosInt = 2,
               ~tx_dat_credits: tx_dat_credits :: PosInt = 2,
               ~rx_rsp_credits: rx_rsp_credits :: PosInt = 2,
               ~rx_dat_credits: rx_dat_credits :: PosInt = 2,
               ~rx_snp_credits: rx_snp_credits :: PosInt = 2):
    super(flit,
          tx_req_credits,
          tx_rsp_credits,
          tx_dat_credits,
          rx_rsp_credits,
          rx_dat_credits,
          rx_snp_credits)

class CHIRNILinkParams(flit :: CHIFlitParams,
                       tx_req_credits :: PosInt,
                       tx_rsp_credits :: PosInt,
                       tx_dat_credits :: PosInt,
                       rx_rsp_credits :: PosInt,
                       rx_dat_credits :: PosInt):
  constructor (flit,
               ~tx_req_credits: tx_req_credits :: PosInt = 2,
               ~tx_rsp_credits: tx_rsp_credits :: PosInt = 2,
               ~tx_dat_credits: tx_dat_credits :: PosInt = 2,
               ~rx_rsp_credits: rx_rsp_credits :: PosInt = 2,
               ~rx_dat_credits: rx_dat_credits :: PosInt = 2):
    super(flit,
          tx_req_credits,
          tx_rsp_credits,
          tx_dat_credits,
          rx_rsp_credits,
          rx_dat_credits)

class CHISNLinkParams(flit :: CHIFlitParams,
                      tx_rsp_credits :: PosInt,
                      tx_dat_credits :: PosInt,
                      rx_req_credits :: PosInt,
                      rx_dat_credits :: PosInt):
  constructor (flit,
               ~tx_rsp_credits: tx_rsp_credits :: PosInt = 2,
               ~tx_dat_credits: tx_dat_credits :: PosInt = 2,
               ~rx_req_credits: rx_req_credits :: PosInt = 2,
               ~rx_dat_credits: rx_dat_credits :: PosInt = 2):
    super(flit, tx_rsp_credits, tx_dat_credits, rx_req_credits, rx_dat_credits)

fun endpoint_pair_legal(node, icn, flit, kinds):
  node is_a CHINodeParams && icn is_a CHIICNPortParams && for all (condition in [
    kinds.contains(node.kind),
    node.kind == icn.kind,
    node.node_id == icn.node_id,
    node.node_id < (1 bits.(<<) flit.node_id_width),
    capabilities_contain(icn.supports, node.emits),
    capabilities_contain(node.supports, icn.emits)
  ]):
    condition

fun rn_connection_legal(provided, required):
  if provided.length() == 2 && required.length() == 2 && provided[0] is_a CHIRNLinkParams && required[0] is_a CHIRNLinkParams
  | block:
      def node_link = provided[0]
      def icn_link = required[0]
      for all (condition in [
        node_link.flit == icn_link.flit,
        endpoint_pair_legal(provided[1], required[1], node_link.flit, [CHINodeKind.RNF, CHINodeKind.RND]),
        for all (pair in [[node_link.tx_req_credits, icn_link.tx_req_credits],
                          [node_link.tx_rsp_credits, icn_link.tx_rsp_credits],
                          [node_link.tx_dat_credits, icn_link.tx_dat_credits],
                          [node_link.rx_rsp_credits, icn_link.rx_rsp_credits],
                          [node_link.rx_dat_credits, icn_link.rx_dat_credits],
                          [node_link.rx_snp_credits, icn_link.rx_snp_credits]]):
          pair[0] == pair[1]
      ]):
        condition
  | #false

fun rni_connection_legal(provided, required):
  if provided.length() == 2 && required.length() == 2 && provided[0] is_a CHIRNILinkParams && required[0] is_a CHIRNILinkParams
  | block:
      def node_link = provided[0]
      def icn_link = required[0]
      for all (condition in [
        node_link.flit == icn_link.flit,
        endpoint_pair_legal(provided[1], required[1], node_link.flit, [CHINodeKind.RNI]),
        for all (pair in [[node_link.tx_req_credits, icn_link.tx_req_credits],
                          [node_link.tx_rsp_credits, icn_link.tx_rsp_credits],
                          [node_link.tx_dat_credits, icn_link.tx_dat_credits],
                          [node_link.rx_rsp_credits, icn_link.rx_rsp_credits],
                          [node_link.rx_dat_credits, icn_link.rx_dat_credits]]):
          pair[0] == pair[1]
      ]):
        condition
  | #false

fun sn_connection_legal(provided, required):
  if provided.length() == 2 && required.length() == 2 && provided[0] is_a CHISNLinkParams && required[0] is_a CHISNLinkParams
  | block:
      def node_link = provided[0]
      def icn_link = required[0]
      for all (condition in [
        node_link.flit == icn_link.flit,
        endpoint_pair_legal(provided[1], required[1], node_link.flit, [CHINodeKind.SNF, CHINodeKind.SNI]),
        for all (pair in [[node_link.tx_rsp_credits, icn_link.tx_rsp_credits],
                          [node_link.tx_dat_credits, icn_link.tx_dat_credits],
                          [node_link.rx_req_credits, icn_link.rx_req_credits],
                          [node_link.rx_dat_credits, icn_link.rx_dat_credits]]):
          pair[0] == pair[1]
      ]):
        condition
  | #false

fun checked_rn_link(link :: CHIRNLinkParams, endpoint):
  unless endpoint is_a CHINodeParams || endpoint is_a CHIICNPortParams
  | error(~who: #'CHIRNLink,
          "requires CHIRNLinkParams and CHINodeParams or CHIICNPortParams")
  unless [CHINodeKind.RNF, CHINodeKind.RND].contains(endpoint.kind)
  | error(~who: #'CHIRNLink, "endpoint kind must be RN-F or RN-D")
  link

fun checked_rni_link(link :: CHIRNILinkParams, endpoint):
  unless endpoint is_a CHINodeParams || endpoint is_a CHIICNPortParams
  | error(~who: #'CHIRNILink,
          "requires CHIRNILinkParams and CHINodeParams or CHIICNPortParams")
  unless endpoint.kind == CHINodeKind.RNI
  | error(~who: #'CHIRNILink, "endpoint kind must be RN-I")
  link

fun checked_sn_link(link :: CHISNLinkParams, endpoint):
  unless endpoint is_a CHINodeParams || endpoint is_a CHIICNPortParams
  | error(~who: #'CHISNLink,
          "requires CHISNLinkParams and CHINodeParams or CHIICNPortParams")
  unless chi_subordinate_node_kind(endpoint.kind)
  | error(~who: #'CHISNLink, "endpoint kind must be SN-F or SN-I")
  link

fun node_emitted_capabilities(endpoint):
  if endpoint is_a CHINodeParams | endpoint.emits | endpoint.supports

fun node_received_capabilities(endpoint):
  if endpoint is_a CHINodeParams | endpoint.supports | endpoint.emits

interface CHIRNLink(link, endpoint):
  role node
  role icn
  provider node
  connection_compatible node (provided, required):
    rn_connection_legal(provided, required)
  monitor (observed, endpoint_role):
    def emitted = node_emitted_capabilities(endpoint)
    def received = node_received_capabilities(endpoint)
    reg tx_previous_request(~init: Bool(#false))
    reg tx_previous_ack(~init: Bool(#false))
    reg rx_previous_request(~init: Bool(#false))
    reg rx_previous_ack(~init: Bool(#false))
    reg tx_req_credit_balance(~init: bits(0, index_width(link.tx_req_credits + 1)))
    reg tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
    reg tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
    reg rx_rsp_credit_balance(~init: bits(0, index_width(link.rx_rsp_credits + 1)))
    reg rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
    reg rx_snp_credit_balance(~init: bits(0, index_width(link.rx_snp_credits + 1)))
    monitor_chi_activation(observed.tx_link_active_request,
                           observed.tx_link_active_ack,
                           tx_previous_request,
                           tx_previous_ack,
                           "chi_tx_link")
    monitor_chi_activation(observed.rx_link_active_request,
                           observed.rx_link_active_ack,
                           rx_previous_request,
                           rx_previous_ack,
                           "chi_rx_link")
    monitor_chi_req(observed.tx_req.valid, observed.tx_req.bits.opcode,
                    observed.tx_req.bits.txn_id, observed.tx_req.bits.src_id,
                    observed.tx_req.bits.size_or_num_req, observed.tx_req.bits.multi_req,
                    observed.tx_req.credit,
                    tx_req_credit_balance,
                    observed.tx_link_active_request, observed.tx_link_active_ack,
                    tx_previous_request, link.tx_req_credits, emitted.req, link.flit,
                    endpoint.node_id, "_source_id", "chi_tx_req")
    monitor_chi_rsp(observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                    observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                    observed.tx_rsp.credit,
                    tx_rsp_credit_balance,
                    observed.tx_link_active_request, observed.tx_link_active_ack,
                    tx_previous_request, link.tx_rsp_credits, emitted.rsp, link.flit,
                    endpoint.node_id, "_source_id", "chi_tx_rsp")
    monitor_chi_dat(observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                    observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                    observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                    tx_dat_credit_balance,
                    observed.tx_link_active_request, observed.tx_link_active_ack,
                    tx_previous_request, link.tx_dat_credits, emitted.dat, link.flit,
                    endpoint.node_id, "_source_id", "chi_tx_dat")
    monitor_chi_rsp(observed.rx_rsp.valid, observed.rx_rsp.bits.opcode,
                    observed.rx_rsp.bits.txn_id, observed.rx_rsp.bits.tgt_id,
                    observed.rx_rsp.credit,
                    rx_rsp_credit_balance,
                    observed.rx_link_active_request, observed.rx_link_active_ack,
                    rx_previous_request, link.rx_rsp_credits, received.rsp, link.flit,
                    endpoint.node_id, "_target_id", "chi_rx_rsp")
    monitor_chi_dat(observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                    observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                    observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                    rx_dat_credit_balance,
                    observed.rx_link_active_request, observed.rx_link_active_ack,
                    rx_previous_request, link.rx_dat_credits, received.dat, link.flit,
                    endpoint.node_id, "_target_id", "chi_rx_dat")
    monitor_chi_snp(observed.rx_snp.valid, observed.rx_snp.bits.opcode,
                    observed.rx_snp.bits.txn_id, observed.rx_snp.credit,
                    rx_snp_credit_balance,
                    observed.rx_link_active_request, observed.rx_link_active_ack,
                    rx_previous_request, link.rx_snp_credits, received.snp, "chi_rx_snp")
    tx_previous_request <== observed.tx_link_active_request
    tx_previous_ack <== observed.tx_link_active_ack
    rx_previous_request <== observed.rx_link_active_request
    rx_previous_ack <== observed.rx_link_active_ack

  node -> icn:
    tx_link_active_request: Bool
    rx_link_active_ack: Bool
    tx_req: Credited(CHIReqFlit(checked_rn_link(link, endpoint).flit), link.tx_req_credits)
    tx_rsp: Credited(CHIRspFlit(link.flit), link.tx_rsp_credits)
    tx_dat: Credited(CHIDatFlit(link.flit), link.tx_dat_credits)

  icn -> node:
    tx_link_active_ack: Bool
    rx_link_active_request: Bool
    rx_rsp: Credited(CHIRspFlit(link.flit), link.rx_rsp_credits)
    rx_dat: Credited(CHIDatFlit(link.flit), link.rx_dat_credits)
    rx_snp: Credited(CHISnpFlit(link.flit), link.rx_snp_credits)

interface CHIRNILink(link, endpoint):
  role node
  role icn
  provider node
  connection_compatible node (provided, required):
    rni_connection_legal(provided, required)
  monitor (observed, endpoint_role):
    def emitted = node_emitted_capabilities(endpoint)
    def received = node_received_capabilities(endpoint)
    reg tx_previous_request(~init: Bool(#false))
    reg tx_previous_ack(~init: Bool(#false))
    reg rx_previous_request(~init: Bool(#false))
    reg rx_previous_ack(~init: Bool(#false))
    reg tx_req_credit_balance(~init: bits(0, index_width(link.tx_req_credits + 1)))
    reg tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
    reg tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
    reg rx_rsp_credit_balance(~init: bits(0, index_width(link.rx_rsp_credits + 1)))
    reg rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
    monitor_chi_activation(observed.tx_link_active_request,
                           observed.tx_link_active_ack,
                           tx_previous_request,
                           tx_previous_ack,
                           "chi_tx_link")
    monitor_chi_activation(observed.rx_link_active_request,
                           observed.rx_link_active_ack,
                           rx_previous_request,
                           rx_previous_ack,
                           "chi_rx_link")
    monitor_chi_req(observed.tx_req.valid, observed.tx_req.bits.opcode,
                    observed.tx_req.bits.txn_id, observed.tx_req.bits.src_id,
                    observed.tx_req.bits.size_or_num_req, observed.tx_req.bits.multi_req,
                    observed.tx_req.credit,
                    tx_req_credit_balance,
                    observed.tx_link_active_request, observed.tx_link_active_ack,
                    tx_previous_request, link.tx_req_credits, emitted.req, link.flit,
                    endpoint.node_id, "_source_id", "chi_tx_req")
    monitor_chi_rsp(observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                    observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                    observed.tx_rsp.credit,
                    tx_rsp_credit_balance,
                    observed.tx_link_active_request, observed.tx_link_active_ack,
                    tx_previous_request, link.tx_rsp_credits, emitted.rsp, link.flit,
                    endpoint.node_id, "_source_id", "chi_tx_rsp")
    monitor_chi_dat(observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                    observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                    observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                    tx_dat_credit_balance,
                    observed.tx_link_active_request, observed.tx_link_active_ack,
                    tx_previous_request, link.tx_dat_credits, emitted.dat, link.flit,
                    endpoint.node_id, "_source_id", "chi_tx_dat")
    monitor_chi_rsp(observed.rx_rsp.valid, observed.rx_rsp.bits.opcode,
                    observed.rx_rsp.bits.txn_id, observed.rx_rsp.bits.tgt_id,
                    observed.rx_rsp.credit,
                    rx_rsp_credit_balance,
                    observed.rx_link_active_request, observed.rx_link_active_ack,
                    rx_previous_request, link.rx_rsp_credits, received.rsp, link.flit,
                    endpoint.node_id, "_target_id", "chi_rx_rsp")
    monitor_chi_dat(observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                    observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                    observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                    rx_dat_credit_balance,
                    observed.rx_link_active_request, observed.rx_link_active_ack,
                    rx_previous_request, link.rx_dat_credits, received.dat, link.flit,
                    endpoint.node_id, "_target_id", "chi_rx_dat")
    tx_previous_request <== observed.tx_link_active_request
    tx_previous_ack <== observed.tx_link_active_ack
    rx_previous_request <== observed.rx_link_active_request
    rx_previous_ack <== observed.rx_link_active_ack

  node -> icn:
    tx_link_active_request: Bool
    rx_link_active_ack: Bool
    tx_req: Credited(CHIReqFlit(checked_rni_link(link, endpoint).flit), link.tx_req_credits)
    tx_rsp: Credited(CHIRspFlit(link.flit), link.tx_rsp_credits)
    tx_dat: Credited(CHIDatFlit(link.flit), link.tx_dat_credits)

  icn -> node:
    tx_link_active_ack: Bool
    rx_link_active_request: Bool
    rx_rsp: Credited(CHIRspFlit(link.flit), link.rx_rsp_credits)
    rx_dat: Credited(CHIDatFlit(link.flit), link.rx_dat_credits)

interface CHISNLink(link, endpoint):
  role node
  role icn
  provider node
  connection_compatible node (provided, required):
    sn_connection_legal(provided, required)
  monitor (observed, endpoint_role):
    def emitted = node_emitted_capabilities(endpoint)
    def received = node_received_capabilities(endpoint)
    reg tx_previous_request(~init: Bool(#false))
    reg tx_previous_ack(~init: Bool(#false))
    reg rx_previous_request(~init: Bool(#false))
    reg rx_previous_ack(~init: Bool(#false))
    reg tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
    reg tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
    reg rx_req_credit_balance(~init: bits(0, index_width(link.rx_req_credits + 1)))
    reg rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
    monitor_chi_activation(observed.tx_link_active_request,
                           observed.tx_link_active_ack,
                           tx_previous_request,
                           tx_previous_ack,
                           "chi_tx_link")
    monitor_chi_activation(observed.rx_link_active_request,
                           observed.rx_link_active_ack,
                           rx_previous_request,
                           rx_previous_ack,
                           "chi_rx_link")
    monitor_chi_rsp(observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                    observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                    observed.tx_rsp.credit,
                    tx_rsp_credit_balance,
                    observed.tx_link_active_request, observed.tx_link_active_ack,
                    tx_previous_request, link.tx_rsp_credits, emitted.rsp, link.flit,
                    endpoint.node_id, "_source_id", "chi_tx_rsp")
    monitor_chi_dat(observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                    observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                    observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                    tx_dat_credit_balance,
                    observed.tx_link_active_request, observed.tx_link_active_ack,
                    tx_previous_request, link.tx_dat_credits, emitted.dat, link.flit,
                    endpoint.node_id, "_source_id", "chi_tx_dat")
    monitor_chi_req(observed.rx_req.valid, observed.rx_req.bits.opcode,
                    observed.rx_req.bits.txn_id, observed.rx_req.bits.tgt_id,
                    observed.rx_req.bits.size_or_num_req, observed.rx_req.bits.multi_req,
                    observed.rx_req.credit,
                    rx_req_credit_balance,
                    observed.rx_link_active_request, observed.rx_link_active_ack,
                    rx_previous_request, link.rx_req_credits, received.req, link.flit,
                    endpoint.node_id, "_target_id", "chi_rx_req")
    monitor_chi_dat(observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                    observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                    observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                    rx_dat_credit_balance,
                    observed.rx_link_active_request, observed.rx_link_active_ack,
                    rx_previous_request, link.rx_dat_credits, received.dat, link.flit,
                    endpoint.node_id, "_target_id", "chi_rx_dat")
    tx_previous_request <== observed.tx_link_active_request
    tx_previous_ack <== observed.tx_link_active_ack
    rx_previous_request <== observed.rx_link_active_request
    rx_previous_ack <== observed.rx_link_active_ack

  node -> icn:
    tx_link_active_request: Bool
    rx_link_active_ack: Bool
    tx_rsp: Credited(CHIRspFlit(checked_sn_link(link, endpoint).flit), link.tx_rsp_credits)
    tx_dat: Credited(CHIDatFlit(link.flit), link.tx_dat_credits)

  icn -> node:
    tx_link_active_ack: Bool
    rx_link_active_request: Bool
    rx_req: Credited(CHIReqFlit(link.flit), link.rx_req_credits)
    rx_dat: Credited(CHIDatFlit(link.flit), link.rx_dat_credits)

export:
  CHINodeKind
  CHIChannelCapabilities
  CHINodeParams
  CHIICNPortParams
  CHIRNLinkParams
  CHIRNILinkParams
  CHISNLinkParams
  CHIRNLink
  CHIRNILink
  CHISNLink
