#lang rhdl
// Defines low-level CHI checks and explicit whole-endpoint monitor functions.

import:
  lib("rhdl/std/credited.rhdl").check_credited
  lib("chi/params.rhdl").CHIFlitParams
  lib("chi/flits.rhdl") open
  lib("chi/protocol.rhdl") open
  lib("chi/link.rhdl") open
  lib("chi/transaction.rhdl") open

fun chi_opcode_supported(opcode, capabilities):
  is_one_of(opcode, capabilities)

// Checks one direction's four-state activation sequence against prior state.
fun monitor_chi_activation(request,
                           ack,
                           previous_request,
                           previous_ack,
                           label_prefix :: String):
  def request_rise = request & !previous_request
  def request_fall = !request & previous_request
  def ack_rise = ack & !previous_ack
  def ack_fall = !ack & previous_ack

  assert(!request_rise ||| !previous_ack,
         label_prefix ++ "_request_after_ack_low")
  assert(!ack_rise ||| request,
         label_prefix ++ "_ack_after_request")
  assert(!request_fall ||| previous_ack,
         label_prefix ++ "_request_drop_after_ack")
  assert(!ack_fall ||| !request,
         label_prefix ++ "_ack_drop_after_request")

fun monitor_chi_transport(valid,
                          credit,
                          credit_balance,
                          request,
                          ack,
                          previous_request,
                          credit_limit :: PosInt,
                          lcrd_return,
                          label_prefix :: String):
  check_credited(valid, credit, credit_limit, credit_balance)
  def stopped = !request & !ack
  def credit_active = ack & (request ||| previous_request)

  assert(!valid ||| ack, label_prefix ++ "_flit_active")
  assert(!credit ||| credit_active, label_prefix ++ "_credit_active")
  when stopped:
    assert(!or_reduce(credit_balance), label_prefix ++ "_credits_returned")
  when (valid & lcrd_return):
    assert(!request & ack, label_prefix ++ "_lcrd_during_deactivate")

fun monitor_chi_identity(valid,
                         identity_value,
                         lcrd_return,
                         node_id :: Nat,
                         node_id_width :: PosInt,
                         label_prefix :: String):
  when (valid & !lcrd_return):
    assert(identity_value === bits(node_id, node_id_width),
           label_prefix)

fun monitor_chi_req(valid,
                    opcode,
                    txn_id,
                    identity_value,
                    size_or_num_req :: Bits(6),
                    multi_req,
                    credit,
                    credit_balance,
                    request,
                    ack,
                    previous_request,
                    credit_limit :: PosInt,
                    capabilities,
                    p :: CHIFlitParams,
                    node_id :: Nat,
                    identity_label :: String,
                    label_prefix :: String):
  def lcrd_return = opcode === CHIReqOpcode.ReqLCrdReturn
  monitor_chi_transport(valid,
                        credit,
                        credit_balance,
                        request,
                        ack,
                        previous_request,
                        credit_limit,
                        lcrd_return,
                        label_prefix)
  monitor_chi_identity(valid,
                       identity_value,
                       lcrd_return,
                       node_id,
                       p.node_id_width,
                       label_prefix ++ identity_label)
  when valid:
    assert(enum_valid(opcode), label_prefix ++ "_opcode_valid")
    assert(lcrd_return ||| chi_opcode_supported(opcode,
                                                capabilities),
           label_prefix ++ "_opcode_supported")
    when lcrd_return:
      assert(txn_id === bits(0, 12),
             label_prefix ++ "_lcrd_txn_id_zero")
    when (!lcrd_return & !multi_req):
      assert(!or_reduce(size_or_num_req[3..6]),
             label_prefix ++ "_size_reserved_zero")
      assert(chi_size_valid(size_or_num_req[0..3]),
             label_prefix ++ "_size_valid")

fun monitor_chi_rsp(valid,
                    opcode,
                    txn_id,
                    identity_value,
                    credit,
                    credit_balance,
                    request,
                    ack,
                    previous_request,
                    credit_limit :: PosInt,
                    capabilities,
                    p :: CHIFlitParams,
                    node_id :: Nat,
                    identity_label :: String,
                    label_prefix :: String):
  def lcrd_return = opcode === CHIRspOpcode.RespLCrdReturn
  monitor_chi_transport(valid,
                        credit,
                        credit_balance,
                        request,
                        ack,
                        previous_request,
                        credit_limit,
                        lcrd_return,
                        label_prefix)
  monitor_chi_identity(valid,
                       identity_value,
                       lcrd_return,
                       node_id,
                       p.node_id_width,
                       label_prefix ++ identity_label)
  when valid:
    assert(enum_valid(opcode), label_prefix ++ "_opcode_valid")
    assert(lcrd_return ||| chi_opcode_supported(opcode,
                                                capabilities),
           label_prefix ++ "_opcode_supported")
    when lcrd_return:
      assert(txn_id === bits(0, 12),
             label_prefix ++ "_lcrd_txn_id_zero")

fun monitor_chi_snp(valid,
                    opcode,
                    txn_id,
                    credit,
                    credit_balance,
                    request,
                    ack,
                    previous_request,
                    credit_limit :: PosInt,
                    capabilities,
                    label_prefix :: String):
  def lcrd_return = opcode === CHISnpOpcode.SnpLCrdReturn
  monitor_chi_transport(valid,
                        credit,
                        credit_balance,
                        request,
                        ack,
                        previous_request,
                        credit_limit,
                        lcrd_return,
                        label_prefix)
  when valid:
    assert(enum_valid(opcode), label_prefix ++ "_opcode_valid")
    assert(lcrd_return ||| chi_opcode_supported(opcode,
                                                capabilities),
           label_prefix ++ "_opcode_supported")
    when lcrd_return:
      assert(txn_id === bits(0, 12),
             label_prefix ++ "_lcrd_txn_id_zero")

fun monitor_chi_dat(valid,
                    opcode,
                    txn_id,
                    identity_value,
                    data_id,
                    credit,
                    credit_balance,
                    request,
                    ack,
                    previous_request,
                    credit_limit :: PosInt,
                    capabilities,
                    p :: CHIFlitParams,
                    node_id :: Nat,
                    identity_label :: String,
                    label_prefix :: String):
  def lcrd_return = opcode === CHIDatOpcode.DataLCrdReturn
  monitor_chi_transport(valid,
                        credit,
                        credit_balance,
                        request,
                        ack,
                        previous_request,
                        credit_limit,
                        lcrd_return,
                        label_prefix)
  monitor_chi_identity(valid,
                       identity_value,
                       lcrd_return,
                       node_id,
                       p.node_id_width,
                       label_prefix ++ identity_label)
  when valid:
    assert(enum_valid(opcode), label_prefix ++ "_opcode_valid")
    assert(lcrd_return ||| chi_opcode_supported(opcode,
                                                capabilities),
           label_prefix ++ "_opcode_supported")
    when lcrd_return:
      assert(txn_id === bits(0, 12),
             label_prefix ++ "_lcrd_txn_id_zero")
    when (!lcrd_return):
      assert(chi_data_id_valid(data_id, p),
             label_prefix ++ "_data_id_valid")

fun node_emitted_capabilities(endpoint):
  if endpoint is_a CHINodeParams | endpoint.emits | endpoint.supports

fun node_received_capabilities(endpoint):
  if endpoint is_a CHINodeParams | endpoint.supports | endpoint.emits

// Applies the RN-F/RN-D checks to one explicitly selected endpoint.
fun monitor_chi_rn(link :: CHIRNLinkParams,
                   endpoint,
                   port :: Endpoint.of(CHIRNLink(link, endpoint))):
  def observed :: Observation = observe(port)
  def emitted = node_emitted_capabilities(endpoint)
  def received = node_received_capabilities(endpoint)
  reg tx_previous_request(~init: Bool(#false))
  reg tx_previous_ack(~init: Bool(#false))
  reg rx_previous_request(~init: Bool(#false))
  reg rx_previous_ack(~init: Bool(#false))
  reg tx_req_credit_balance(~init: bits(0, index_width(link.tx_req_credits + 1)))
  reg tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
  reg tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
  reg rx_rsp_credit_balance(~init: bits(0, index_width(link.rx_rsp_credits + 1)))
  reg rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
  reg rx_snp_credit_balance(~init: bits(0, index_width(link.rx_snp_credits + 1)))
  monitor_chi_activation(observed.tx_link_active_request,
                         observed.tx_link_active_ack,
                         tx_previous_request,
                         tx_previous_ack,
                         "chi_tx_link")
  monitor_chi_activation(observed.rx_link_active_request,
                         observed.rx_link_active_ack,
                         rx_previous_request,
                         rx_previous_ack,
                         "chi_rx_link")
  monitor_chi_req(observed.tx_req.valid, observed.tx_req.bits.opcode,
                  observed.tx_req.bits.txn_id, observed.tx_req.bits.src_id,
                  observed.tx_req.bits.size_or_num_req, observed.tx_req.bits.multi_req,
                  observed.tx_req.credit,
                  tx_req_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  tx_previous_request, link.tx_req_credits, emitted.req, link.flit,
                  endpoint.node_id, "_source_id", "chi_tx_req")
  monitor_chi_rsp(observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                  observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                  observed.tx_rsp.credit,
                  tx_rsp_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  tx_previous_request, link.tx_rsp_credits, emitted.rsp, link.flit,
                  endpoint.node_id, "_source_id", "chi_tx_rsp")
  monitor_chi_dat(observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                  observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                  observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                  tx_dat_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  tx_previous_request, link.tx_dat_credits, emitted.dat, link.flit,
                  endpoint.node_id, "_source_id", "chi_tx_dat")
  monitor_chi_rsp(observed.rx_rsp.valid, observed.rx_rsp.bits.opcode,
                  observed.rx_rsp.bits.txn_id, observed.rx_rsp.bits.tgt_id,
                  observed.rx_rsp.credit,
                  rx_rsp_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rx_previous_request, link.rx_rsp_credits, received.rsp, link.flit,
                  endpoint.node_id, "_target_id", "chi_rx_rsp")
  monitor_chi_dat(observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                  observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                  observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                  rx_dat_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rx_previous_request, link.rx_dat_credits, received.dat, link.flit,
                  endpoint.node_id, "_target_id", "chi_rx_dat")
  monitor_chi_snp(observed.rx_snp.valid, observed.rx_snp.bits.opcode,
                  observed.rx_snp.bits.txn_id, observed.rx_snp.credit,
                  rx_snp_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rx_previous_request, link.rx_snp_credits, received.snp, "chi_rx_snp")
  tx_previous_request <== observed.tx_link_active_request
  tx_previous_ack <== observed.tx_link_active_ack
  rx_previous_request <== observed.rx_link_active_request
  rx_previous_ack <== observed.rx_link_active_ack

// Applies the RN-I link and eligible transaction checks to one explicitly
// selected endpoint.
fun monitor_chi_rni(link :: CHIRNILinkParams,
                    endpoint,
                    port :: Endpoint.of(CHIRNILink(link, endpoint))):
  def observed :: Observation = observe(port)
  def emitted = node_emitted_capabilities(endpoint)
  def received = node_received_capabilities(endpoint)
  reg tx_previous_request(~init: Bool(#false))
  reg tx_previous_ack(~init: Bool(#false))
  reg rx_previous_request(~init: Bool(#false))
  reg rx_previous_ack(~init: Bool(#false))
  reg tx_req_credit_balance(~init: bits(0, index_width(link.tx_req_credits + 1)))
  reg tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
  reg tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
  reg rx_rsp_credit_balance(~init: bits(0, index_width(link.rx_rsp_credits + 1)))
  reg rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
  monitor_chi_activation(observed.tx_link_active_request,
                         observed.tx_link_active_ack,
                         tx_previous_request,
                         tx_previous_ack,
                         "chi_tx_link")
  monitor_chi_activation(observed.rx_link_active_request,
                         observed.rx_link_active_ack,
                         rx_previous_request,
                         rx_previous_ack,
                         "chi_rx_link")
  monitor_chi_req(observed.tx_req.valid, observed.tx_req.bits.opcode,
                  observed.tx_req.bits.txn_id, observed.tx_req.bits.src_id,
                  observed.tx_req.bits.size_or_num_req, observed.tx_req.bits.multi_req,
                  observed.tx_req.credit,
                  tx_req_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  tx_previous_request, link.tx_req_credits, emitted.req, link.flit,
                  endpoint.node_id, "_source_id", "chi_tx_req")
  monitor_chi_rsp(observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                  observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                  observed.tx_rsp.credit,
                  tx_rsp_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  tx_previous_request, link.tx_rsp_credits, emitted.rsp, link.flit,
                  endpoint.node_id, "_source_id", "chi_tx_rsp")
  monitor_chi_dat(observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                  observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                  observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                  tx_dat_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  tx_previous_request, link.tx_dat_credits, emitted.dat, link.flit,
                  endpoint.node_id, "_source_id", "chi_tx_dat")
  monitor_chi_rsp(observed.rx_rsp.valid, observed.rx_rsp.bits.opcode,
                  observed.rx_rsp.bits.txn_id, observed.rx_rsp.bits.tgt_id,
                  observed.rx_rsp.credit,
                  rx_rsp_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rx_previous_request, link.rx_rsp_credits, received.rsp, link.flit,
                  endpoint.node_id, "_target_id", "chi_rx_rsp")
  monitor_chi_dat(observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                  observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                  observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                  rx_dat_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rx_previous_request, link.rx_dat_credits, received.dat, link.flit,
                  endpoint.node_id, "_target_id", "chi_rx_dat")
  if chi_initial_requester_capabilities(emitted, received)
  | requester_transaction_monitor(observed.tx_req.valid,
                                  observed.tx_req.bits,
                                  observed.rx_rsp.valid,
                                  observed.rx_rsp.bits,
                                  observed.tx_dat.valid,
                                  observed.tx_dat.bits,
                                  observed.rx_dat.valid,
                                  observed.rx_dat.bits,
                                  link.flit,
                                  endpoint.max_outstanding,
                                  "chi_transaction")
  | #void
  tx_previous_request <== observed.tx_link_active_request
  tx_previous_ack <== observed.tx_link_active_ack
  rx_previous_request <== observed.rx_link_active_request
  rx_previous_ack <== observed.rx_link_active_ack

// Applies the SN-F/SN-I link and eligible transaction checks to one explicitly
// selected endpoint.
fun monitor_chi_sn(link :: CHISNLinkParams,
                   endpoint,
                   port :: Endpoint.of(CHISNLink(link, endpoint))):
  def observed :: Observation = observe(port)
  def emitted = node_emitted_capabilities(endpoint)
  def received = node_received_capabilities(endpoint)
  reg tx_previous_request(~init: Bool(#false))
  reg tx_previous_ack(~init: Bool(#false))
  reg rx_previous_request(~init: Bool(#false))
  reg rx_previous_ack(~init: Bool(#false))
  reg tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
  reg tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
  reg rx_req_credit_balance(~init: bits(0, index_width(link.rx_req_credits + 1)))
  reg rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
  monitor_chi_activation(observed.tx_link_active_request,
                         observed.tx_link_active_ack,
                         tx_previous_request,
                         tx_previous_ack,
                         "chi_tx_link")
  monitor_chi_activation(observed.rx_link_active_request,
                         observed.rx_link_active_ack,
                         rx_previous_request,
                         rx_previous_ack,
                         "chi_rx_link")
  monitor_chi_rsp(observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                  observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                  observed.tx_rsp.credit,
                  tx_rsp_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  tx_previous_request, link.tx_rsp_credits, emitted.rsp, link.flit,
                  endpoint.node_id, "_source_id", "chi_tx_rsp")
  monitor_chi_dat(observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                  observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                  observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                  tx_dat_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  tx_previous_request, link.tx_dat_credits, emitted.dat, link.flit,
                  endpoint.node_id, "_source_id", "chi_tx_dat")
  monitor_chi_req(observed.rx_req.valid, observed.rx_req.bits.opcode,
                  observed.rx_req.bits.txn_id, observed.rx_req.bits.tgt_id,
                  observed.rx_req.bits.size_or_num_req, observed.rx_req.bits.multi_req,
                  observed.rx_req.credit,
                  rx_req_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rx_previous_request, link.rx_req_credits, received.req, link.flit,
                  endpoint.node_id, "_target_id", "chi_rx_req")
  monitor_chi_dat(observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                  observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                  observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                  rx_dat_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rx_previous_request, link.rx_dat_credits, received.dat, link.flit,
                  endpoint.node_id, "_target_id", "chi_rx_dat")
  if chi_initial_subordinate_capabilities(emitted, received)
  | subordinate_transaction_monitor(observed.rx_req.valid,
                                    observed.rx_req.bits,
                                    observed.tx_rsp.valid,
                                    observed.tx_rsp.bits,
                                    observed.rx_dat.valid,
                                    observed.rx_dat.bits,
                                    observed.tx_dat.valid,
                                    observed.tx_dat.bits,
                                    link.flit,
                                    endpoint.max_outstanding,
                                    "chi_transaction")
  | #void
  tx_previous_request <== observed.tx_link_active_request
  tx_previous_ack <== observed.tx_link_active_ack
  rx_previous_request <== observed.rx_link_active_request
  rx_previous_ack <== observed.rx_link_active_ack

export:
  monitor_chi_activation
  monitor_chi_req
  monitor_chi_rsp
  monitor_chi_snp
  monitor_chi_dat
  monitor_chi_rn
  monitor_chi_rni
  monitor_chi_sn
