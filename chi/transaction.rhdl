#lang rhdl
// Defines bounded stateful monitoring for the initial non-coherent CHI transaction subset.

import:
  lib("rhdl/std/bits.rhdl") open
  lib("chi/params.rhdl").CHIFlitParams
  lib("chi/flits.rhdl") open
  lib("chi/protocol.rhdl") open

hardware_enum CHIInitialTransactionPhase(~width: 3):
  Free = 0
  ReadPending = 1
  WriteAwaitDBID = 2
  WriteAwaitData = 3
  WriteAwaitComp = 4

bundle CHIRequesterTransaction(p :: CHIFlitParams):
  phase: CHIInitialTransactionPhase
  txn_id: Bits(12)
  completer_id: Bits(p.node_id_width)
  dbid: Bits(12)

bundle CHISubordinateTransaction(p :: CHIFlitParams):
  phase: CHIInitialTransactionPhase
  txn_id: Bits(12)
  requester_id: Bits(p.node_id_width)
  return_txn_id: Bits(12)
  return_node_id: Bits(p.node_id_width)
  dbid: Bits(12)

fun empty_chi_requester_transaction(p :: CHIFlitParams):
  CHIRequesterTransaction(p):
    phase: CHIInitialTransactionPhase.Free
    txn_id: bits(0, 12)
    completer_id: bits(0, p.node_id_width)
    dbid: bits(0, 12)

fun empty_chi_subordinate_transaction(p :: CHIFlitParams):
  CHISubordinateTransaction(p):
    phase: CHIInitialTransactionPhase.Free
    txn_id: bits(0, 12)
    requester_id: bits(0, p.node_id_width)
    return_txn_id: bits(0, 12)
    return_node_id: bits(0, p.node_id_width)
    dbid: bits(0, 12)

fun chi_initial_request_supported(opcode):
  is_one_of(opcode,
            CHIReqOpcode.ReadNoSnp,
            CHIReqOpcode.WriteNoSnpFull,
            CHIReqOpcode.WriteNoSnpPtl)

fun chi_initial_write_request(opcode):
  is_one_of(opcode,
            CHIReqOpcode.WriteNoSnpFull,
            CHIReqOpcode.WriteNoSnpPtl)

fun chi_initial_single_flit_size(size, p :: CHIFlitParams):
  size <= bits(alignment_bits(p.data_bytes), 3)

fun opcodes_use_only(opcodes, allowed):
  for all (opcode in opcodes):
    allowed.contains(opcode)

fun chi_initial_requester_capabilities(emitted, received):
  emitted.req.length() > 0 && for all (condition in [
    opcodes_use_only(emitted.req,
                     [CHIReqOpcode.ReadNoSnp,
                      CHIReqOpcode.WriteNoSnpFull,
                      CHIReqOpcode.WriteNoSnpPtl]),
    emitted.rsp.length() == 0,
    emitted.snp.length() == 0,
    opcodes_use_only(emitted.dat, [CHIDatOpcode.NonCopyBackWriteData]),
    received.req.length() == 0,
    opcodes_use_only(received.rsp, [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp]),
    received.snp.length() == 0,
    opcodes_use_only(received.dat, [CHIDatOpcode.CompData])
  ]):
    condition

fun chi_initial_subordinate_capabilities(emitted, received):
  received.req.length() > 0 && for all (condition in [
    emitted.req.length() == 0,
    opcodes_use_only(emitted.rsp, [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp]),
    emitted.snp.length() == 0,
    opcodes_use_only(emitted.dat, [CHIDatOpcode.CompData]),
    opcodes_use_only(received.req,
                     [CHIReqOpcode.ReadNoSnp,
                      CHIReqOpcode.WriteNoSnpFull,
                      CHIReqOpcode.WriteNoSnpPtl]),
    received.rsp.length() == 0,
    received.snp.length() == 0,
    opcodes_use_only(received.dat, [CHIDatOpcode.NonCopyBackWriteData])
  ]):
    condition

fun chi_initial_request_fields(multi_req,
                               size,
                               order,
                               pcrd_type,
                               exp_comp_ack,
                               tag_op,
                               p :: CHIFlitParams,
                               label_prefix :: String):
  assert(!multi_req, label_prefix ++ "_single_request")
  assert(chi_initial_single_flit_size(size, p),
         label_prefix ++ "_single_flit_size")
  assert(order === bits(0, 2), label_prefix ++ "_order_none")
  assert(pcrd_type === bits(0, 4), label_prefix ++ "_pcrd_type_zero")
  assert(!exp_comp_ack, label_prefix ++ "_no_comp_ack")
  assert(tag_op === bits(0, 2), label_prefix ++ "_tag_op_invalid")

fun chi_initial_data_fields(data_id, num_dat, replicate, label_prefix :: String):
  assert(data_id === bits(0, 2), label_prefix ++ "_data_id_zero")
  assert(num_dat === bits(0, 2), label_prefix ++ "_num_dat_zero")
  assert(!replicate, label_prefix ++ "_not_replicated")

fun requester_transaction_monitor(tx_req_valid,
                                  raw_req,
                                  rx_rsp_valid,
                                  raw_rsp,
                                  tx_dat_valid,
                                  raw_tx_dat,
                                  rx_dat_valid,
                                  raw_rx_dat,
                                  p :: CHIFlitParams,
                                  limit :: PosInt,
                                  label_prefix :: String):
  def empty = empty_chi_requester_transaction(p)
  def initial = vec(for List (_index in 0..limit): empty)
  reg entries(~init: initial)
  def req = cast(raw_req, CHIReqFlit(p))
  def rsp = cast(raw_rsp, CHIRspFlit(p))
  def tx_dat = cast(raw_tx_dat, CHIDatFlit(p))
  def rx_dat = cast(raw_rx_dat, CHIDatFlit(p))

  def req_event = tx_req_valid & (req.opcode =/= CHIReqOpcode.ReqLCrdReturn)
  def rsp_event = rx_rsp_valid & (rsp.opcode =/= CHIRspOpcode.RespLCrdReturn)
  def tx_dat_event = tx_dat_valid & (tx_dat.opcode =/= CHIDatOpcode.DataLCrdReturn)
  def rx_dat_event = rx_dat_valid & (rx_dat.opcode =/= CHIDatOpcode.DataLCrdReturn)
  def free_entries = vec(
    for List (index in 0..limit):
      entries[index].phase === CHIInitialTransactionPhase.Free
  )
  def allocation_available = or_reduce(free_entries)
  def allocation_index = priority_encoder(free_entries)
  def duplicate_txn = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase =/= CHIInitialTransactionPhase.Free) & (
        entries[index].txn_id === req.txn_id
      )
  )
  def dbid_match = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitData) & (
        entries[index].dbid === tx_dat.txn_id
      ) & (entries[index].completer_id === tx_dat.tgt_id)
  )
  def dbid_response_match = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitDBID) & (
        entries[index].txn_id === rsp.txn_id
      )
  )
  def write_completion_match = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitComp) & (
        entries[index].txn_id === rsp.txn_id
      ) & (entries[index].completer_id === rsp.src_id) & (
        entries[index].dbid === rsp.dbid_or_group_id
      )
  )
  def read_completion_match = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.ReadPending) & (
        entries[index].txn_id === rx_dat.txn_id
      )
  )

  when req_event:
    assert(chi_initial_request_supported(req.opcode),
           label_prefix ++ "_request_opcode_supported")
    chi_initial_request_fields(req.multi_req,
                               req.size_or_num_req[0..3],
                               req.order,
                               req.pcrd_type,
                               req.exp_comp_ack,
                               req.tag_op,
                               p,
                               label_prefix ++ "_request")
    assert(!duplicate_txn, label_prefix ++ "_txn_id_unique")
    assert(allocation_available, label_prefix ++ "_within_outstanding_limit")
  when rsp_event:
    assert(is_one_of(rsp.opcode, CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp),
           label_prefix ++ "_response_opcode_supported")
    when (rsp.opcode === CHIRspOpcode.DBIDResp):
      assert(dbid_response_match, label_prefix ++ "_dbid_response_has_write")
      assert(rsp.resp === bits(0, 3), label_prefix ++ "_dbid_response_resp_zero")
      assert(rsp.resp_err === bits(0, 2), label_prefix ++ "_dbid_response_ok")
      def duplicate_dbid = or_reduce(
        for List (index in 0..limit):
          is_one_of(entries[index].phase,
                    CHIInitialTransactionPhase.WriteAwaitData,
                    CHIInitialTransactionPhase.WriteAwaitComp) & (
            entries[index].completer_id === rsp.src_id
          ) & (entries[index].dbid === rsp.dbid_or_group_id)
      )
      assert(!duplicate_dbid, label_prefix ++ "_dbid_unique")
    when (rsp.opcode === CHIRspOpcode.Comp):
      assert(write_completion_match, label_prefix ++ "_completion_has_write_data")
      assert(rsp.resp === bits(0, 3), label_prefix ++ "_completion_resp_zero")
      assert(rsp.resp_err === bits(0, 2), label_prefix ++ "_completion_ok")
  when tx_dat_event:
    assert(tx_dat.opcode === CHIDatOpcode.NonCopyBackWriteData,
           label_prefix ++ "_write_data_opcode_supported")
    assert(dbid_match, label_prefix ++ "_write_data_has_dbid")
    chi_initial_data_fields(tx_dat.data_id,
                            tx_dat.num_dat,
                            tx_dat.replicate,
                            label_prefix ++ "_write_data")
  when rx_dat_event:
    assert(rx_dat.opcode === CHIDatOpcode.CompData,
           label_prefix ++ "_read_data_opcode_supported")
    assert(read_completion_match, label_prefix ++ "_read_data_has_request")
    assert(rx_dat.resp === bits(0, 3), label_prefix ++ "_read_data_resp_zero")
    assert(rx_dat.resp_err === bits(0, 2), label_prefix ++ "_read_data_ok")
    chi_initial_data_fields(rx_dat.data_id,
                            rx_dat.num_dat,
                            rx_dat.replicate,
                            label_prefix ++ "_read_data")

  def allocated_phase = mux(chi_initial_write_request(req.opcode),
                            CHIInitialTransactionPhase.WriteAwaitDBID,
                            CHIInitialTransactionPhase.ReadPending)
  def allocated:
    CHIRequesterTransaction(p):
      phase: allocated_phase
      txn_id: req.txn_id
      completer_id: req.tgt_id
      dbid: bits(0, 12)
  def allocate = req_event & chi_initial_request_supported(req.opcode) & (
    !duplicate_txn & allocation_available
  )
  def next_entries = vec(
    for List (index in 0..limit):
      block:
        def entry = entries[index]
        def dbid_response_here = rsp_event & (rsp.opcode === CHIRspOpcode.DBIDResp) & (
          entry.phase === CHIInitialTransactionPhase.WriteAwaitDBID
        ) & (entry.txn_id === rsp.txn_id)
        def write_data_here = tx_dat_event & (
          tx_dat.opcode === CHIDatOpcode.NonCopyBackWriteData
        ) & (entry.phase === CHIInitialTransactionPhase.WriteAwaitData) & (
          entry.dbid === tx_dat.txn_id
        ) & (entry.completer_id === tx_dat.tgt_id)
        def write_completion_here = rsp_event & (rsp.opcode === CHIRspOpcode.Comp) & (
          entry.phase === CHIInitialTransactionPhase.WriteAwaitComp
        ) & (entry.txn_id === rsp.txn_id) & (entry.completer_id === rsp.src_id) & (
          entry.dbid === rsp.dbid_or_group_id
        )
        def read_completion_here = rx_dat_event & (rx_dat.opcode === CHIDatOpcode.CompData) & (
          entry.phase === CHIInitialTransactionPhase.ReadPending
        ) & (entry.txn_id === rx_dat.txn_id)
        def after_dbid:
          CHIRequesterTransaction(p):
            phase: CHIInitialTransactionPhase.WriteAwaitData
            txn_id: entry.txn_id
            completer_id: rsp.src_id
            dbid: rsp.dbid_or_group_id
        def after_write_data:
          CHIRequesterTransaction(p):
            phase: CHIInitialTransactionPhase.WriteAwaitComp
            txn_id: entry.txn_id
            completer_id: entry.completer_id
            dbid: entry.dbid
        def progressed = mux(dbid_response_here,
                             after_dbid,
                             mux(write_data_here,
                                 after_write_data,
                                 mux(write_completion_here ||| read_completion_here,
                                     empty,
                                     entry)))
        def allocate_here = allocate & (allocation_index === bits(index, index_width(limit)))
        mux(allocate_here, allocated, progressed)
  )
  entries <== next_entries

fun subordinate_transaction_monitor(rx_req_valid,
                                    raw_req,
                                    tx_rsp_valid,
                                    raw_rsp,
                                    rx_dat_valid,
                                    raw_rx_dat,
                                    tx_dat_valid,
                                    raw_tx_dat,
                                    p :: CHIFlitParams,
                                    limit :: PosInt,
                                    label_prefix :: String):
  def empty = empty_chi_subordinate_transaction(p)
  def initial = vec(for List (_index in 0..limit): empty)
  reg entries(~init: initial)
  def req = cast(raw_req, CHIReqFlit(p))
  def rsp = cast(raw_rsp, CHIRspFlit(p))
  def rx_dat = cast(raw_rx_dat, CHIDatFlit(p))
  def tx_dat = cast(raw_tx_dat, CHIDatFlit(p))

  def req_event = rx_req_valid & (req.opcode =/= CHIReqOpcode.ReqLCrdReturn)
  def rsp_event = tx_rsp_valid & (rsp.opcode =/= CHIRspOpcode.RespLCrdReturn)
  def rx_dat_event = rx_dat_valid & (rx_dat.opcode =/= CHIDatOpcode.DataLCrdReturn)
  def tx_dat_event = tx_dat_valid & (tx_dat.opcode =/= CHIDatOpcode.DataLCrdReturn)
  def free_entries = vec(
    for List (index in 0..limit):
      entries[index].phase === CHIInitialTransactionPhase.Free
  )
  def allocation_available = or_reduce(free_entries)
  def allocation_index = priority_encoder(free_entries)
  def duplicate_txn = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase =/= CHIInitialTransactionPhase.Free) & (
        entries[index].requester_id === req.src_id
      ) & (entries[index].txn_id === req.txn_id)
  )
  def dbid_response_match = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitDBID) & (
        entries[index].txn_id === rsp.txn_id
      ) & (entries[index].requester_id === rsp.tgt_id)
  )
  def write_data_match = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitData) & (
        entries[index].dbid === rx_dat.txn_id
      ) & (entries[index].requester_id === rx_dat.src_id)
  )
  def write_completion_match = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitComp) & (
        entries[index].txn_id === rsp.txn_id
      ) & (entries[index].requester_id === rsp.tgt_id) & (
        entries[index].dbid === rsp.dbid_or_group_id
      )
  )
  def read_completion_match = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.ReadPending) & (
        entries[index].return_txn_id === tx_dat.txn_id
      ) & (entries[index].return_node_id === tx_dat.tgt_id)
  )

  when req_event:
    assert(chi_initial_request_supported(req.opcode),
           label_prefix ++ "_request_opcode_supported")
    chi_initial_request_fields(req.multi_req,
                               req.size_or_num_req[0..3],
                               req.order,
                               req.pcrd_type,
                               req.exp_comp_ack,
                               req.tag_op,
                               p,
                               label_prefix ++ "_request")
    when (chi_initial_write_request(req.opcode)):
      assert(!req.snp_attr_or_do_dwt, label_prefix ++ "_no_direct_write_transfer")
    assert(!duplicate_txn, label_prefix ++ "_txn_id_unique")
    assert(allocation_available, label_prefix ++ "_within_outstanding_limit")
  when rsp_event:
    assert(is_one_of(rsp.opcode, CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp),
           label_prefix ++ "_response_opcode_supported")
    when (rsp.opcode === CHIRspOpcode.DBIDResp):
      assert(dbid_response_match, label_prefix ++ "_dbid_response_has_write")
      assert(rsp.resp === bits(0, 3), label_prefix ++ "_dbid_response_resp_zero")
      assert(rsp.resp_err === bits(0, 2), label_prefix ++ "_dbid_response_ok")
      def duplicate_dbid = or_reduce(
        for List (index in 0..limit):
          is_one_of(entries[index].phase,
                    CHIInitialTransactionPhase.WriteAwaitData,
                    CHIInitialTransactionPhase.WriteAwaitComp) & (
            entries[index].requester_id === rsp.tgt_id
          ) & (entries[index].dbid === rsp.dbid_or_group_id)
      )
      assert(!duplicate_dbid, label_prefix ++ "_dbid_unique")
    when (rsp.opcode === CHIRspOpcode.Comp):
      assert(write_completion_match, label_prefix ++ "_completion_has_write_data")
      assert(rsp.resp === bits(0, 3), label_prefix ++ "_completion_resp_zero")
      assert(rsp.resp_err === bits(0, 2), label_prefix ++ "_completion_ok")
  when rx_dat_event:
    assert(rx_dat.opcode === CHIDatOpcode.NonCopyBackWriteData,
           label_prefix ++ "_write_data_opcode_supported")
    assert(write_data_match, label_prefix ++ "_write_data_has_dbid")
    chi_initial_data_fields(rx_dat.data_id,
                            rx_dat.num_dat,
                            rx_dat.replicate,
                            label_prefix ++ "_write_data")
  when tx_dat_event:
    assert(tx_dat.opcode === CHIDatOpcode.CompData,
           label_prefix ++ "_read_data_opcode_supported")
    assert(read_completion_match, label_prefix ++ "_read_data_has_request")
    assert(tx_dat.resp === bits(0, 3), label_prefix ++ "_read_data_resp_zero")
    assert(tx_dat.resp_err === bits(0, 2), label_prefix ++ "_read_data_ok")
    chi_initial_data_fields(tx_dat.data_id,
                            tx_dat.num_dat,
                            tx_dat.replicate,
                            label_prefix ++ "_read_data")

  def allocated_phase = mux(chi_initial_write_request(req.opcode),
                            CHIInitialTransactionPhase.WriteAwaitDBID,
                            CHIInitialTransactionPhase.ReadPending)
  def allocated:
    CHISubordinateTransaction(p):
      phase: allocated_phase
      txn_id: req.txn_id
      requester_id: req.src_id
      return_txn_id: req.return_txn_id_or_stash_lpid
      return_node_id: req.return_nid_or_stash_nid_or_data_target
      dbid: bits(0, 12)
  def allocate = req_event & chi_initial_request_supported(req.opcode) & (
    !duplicate_txn & allocation_available
  )
  def next_entries = vec(
    for List (index in 0..limit):
      block:
        def entry = entries[index]
        def dbid_response_here = rsp_event & (rsp.opcode === CHIRspOpcode.DBIDResp) & (
          entry.phase === CHIInitialTransactionPhase.WriteAwaitDBID
        ) & (entry.txn_id === rsp.txn_id) & (entry.requester_id === rsp.tgt_id)
        def write_data_here = rx_dat_event & (
          rx_dat.opcode === CHIDatOpcode.NonCopyBackWriteData
        ) & (entry.phase === CHIInitialTransactionPhase.WriteAwaitData) & (
          entry.dbid === rx_dat.txn_id
        ) & (entry.requester_id === rx_dat.src_id)
        def write_completion_here = rsp_event & (rsp.opcode === CHIRspOpcode.Comp) & (
          entry.phase === CHIInitialTransactionPhase.WriteAwaitComp
        ) & (entry.txn_id === rsp.txn_id) & (entry.requester_id === rsp.tgt_id) & (
          entry.dbid === rsp.dbid_or_group_id
        )
        def read_completion_here = tx_dat_event & (tx_dat.opcode === CHIDatOpcode.CompData) & (
          entry.phase === CHIInitialTransactionPhase.ReadPending
        ) & (entry.return_txn_id === tx_dat.txn_id) & (
          entry.return_node_id === tx_dat.tgt_id
        )
        def after_dbid:
          CHISubordinateTransaction(p):
            phase: CHIInitialTransactionPhase.WriteAwaitData
            txn_id: entry.txn_id
            requester_id: entry.requester_id
            return_txn_id: entry.return_txn_id
            return_node_id: entry.return_node_id
            dbid: rsp.dbid_or_group_id
        def after_write_data:
          CHISubordinateTransaction(p):
            phase: CHIInitialTransactionPhase.WriteAwaitComp
            txn_id: entry.txn_id
            requester_id: entry.requester_id
            return_txn_id: entry.return_txn_id
            return_node_id: entry.return_node_id
            dbid: entry.dbid
        def progressed = mux(dbid_response_here,
                             after_dbid,
                             mux(write_data_here,
                                 after_write_data,
                                 mux(write_completion_here ||| read_completion_here,
                                     empty,
                                     entry)))
        def allocate_here = allocate & (allocation_index === bits(index, index_width(limit)))
        mux(allocate_here, allocated, progressed)
  )
  entries <== next_entries

export:
  chi_initial_request_supported
  chi_initial_write_request
  chi_initial_single_flit_size
  chi_initial_requester_capabilities
  chi_initial_subordinate_capabilities
  requester_transaction_monitor
  subordinate_transaction_monitor
