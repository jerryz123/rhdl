  assert(!ingress.valid ||| (ingress.bits.payload.tgt_id === bits(config.site.node_id, config.p.node_id_width)),
         "chi_dat_noc_ejection_target")

fun chi_req_noc_inject(config :: CHINoCInjectionConfig):
  fun (source) :~ InterfaceTransformResult(source, Endpoint):
    flow_protocol_type(source)
    inst stage(CHIReqNoCInjector(config))
    finish_interface_transform(source, describe_interface_transform(InterfaceHandle(stage.ingress, stage.egress), "chi-req-noc-inject", {"node-id": config.site.node_id}, stage))

fun chi_req_noc_eject(config :: CHINoCEjectionConfig):
  fun (source) :~ InterfaceTransformResult(source, Endpoint):
    flow_protocol_type(source)
    inst stage(CHIReqNoCEjector(config))
    finish_interface_transform(source, describe_interface_transform(InterfaceHandle(stage.ingress, stage.egress), "chi-req-noc-eject", {"node-id": config.site.node_id}, stage))

