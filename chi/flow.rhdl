#lang rhdl
// Adapts an SN node's credited CHI channels to internal ready-valid flows.

import:
  lib("rhdl/std/flow.rhdl") open
  lib("chi/flits.rhdl") open
  lib("chi/link.rhdl") open

class CHISNFlows(requests :: Endpoint,
                 request_data :: Endpoint,
                 responses :: Endpoint,
                 response_data :: Endpoint,
                 transmit_running :: Bool,
                 transmit_deactivating :: Bool,
                 transmit_credit_empty :: Bool,
                 receive_running :: Bool,
                 receive_deactivating :: Bool)

class CHIRNIICNFlows(requests :: Endpoint,
                     requester_responses :: Endpoint,
                     request_data :: Endpoint,
                     responses :: Endpoint,
                     response_data :: Endpoint,
                     transmit_running :: Bool,
                     transmit_deactivating :: Bool,
                     transmit_credit_empty :: Bool,
                     receive_running :: Bool,
                     receive_deactivating :: Bool)

class CHISNICNFlows(requests :: Endpoint,
                    request_data :: Endpoint,
                    responses :: Endpoint,
                    response_data :: Endpoint,
                    transmit_running :: Bool,
                    transmit_deactivating :: Bool,
                    transmit_credit_empty :: Bool,
                    receive_running :: Bool,
                    receive_deactivating :: Bool)

// Activation remains CHI-specific while each channel conversion uses the
// protocol-neutral credited-flow primitives. During transmit deactivation,
// the endpoint must inject required Link Credit Return flits through the
// returned response flows.
fun chi_sn_flow_adapter(port :: Endpoint,
                        link :: CHISNLinkParams,
                        transmit_enable :: Bool,
                        receive_enable :: Bool):
  def p = link.flit

  inst request_receiver(CreditBuffer(CHIReqFlit(p), link.rx_req_credits))
  inst request_data_receiver(CreditBuffer(CHIDatFlit(p), link.rx_dat_credits))
  inst response_transmitter(CreditSender(CHIRspFlit(p), link.tx_rsp_credits))
  inst response_data_transmitter(CreditSender(CHIDatFlit(p), link.tx_dat_credits))

  port.rx_req <=> request_receiver.link
  port.rx_dat <=> request_data_receiver.link
  response_transmitter.link <=> port.tx_rsp
  response_data_transmitter.link <=> port.tx_dat

  reg transmit_request(~init: Bool(#false))
  reg receive_ack(~init: Bool(#false))
  def transmit_acked = port.tx_link_active_ack
  def receive_requested = port.rx_link_active_request
  def tx_credit_empty = !or_reduce(response_transmitter.credit_count) & (
    !or_reduce(response_data_transmitter.credit_count)
  )
  def receive_drained = !or_reduce(request_receiver.reserved) & (
    !or_reduce(request_data_receiver.reserved)
  )

  when (!transmit_request & !transmit_acked & transmit_enable):
    transmit_request <== Bool(#true)
  elsewhen (transmit_request & transmit_acked & !transmit_enable):
    transmit_request <== Bool(#false)

  when (!receive_ack & receive_requested & receive_enable):
    receive_ack <== Bool(#true)
  elsewhen (receive_ack & !receive_requested & receive_drained):
    receive_ack <== Bool(#false)

  port.tx_link_active_request <== transmit_request
  port.rx_link_active_ack <== receive_ack
  request_receiver.grant_enable <== receive_ack & receive_requested & receive_enable
  request_data_receiver.grant_enable <== receive_ack & receive_requested & receive_enable

  CHISNFlows(
    request_receiver.egress,
    request_data_receiver.egress,
    response_transmitter.ingress,
    response_data_transmitter.ingress,
    transmit_request & transmit_acked,
    !transmit_request & transmit_acked,
    tx_credit_empty,
    receive_requested & receive_ack,
    !receive_requested & receive_ack
  )

// Terminates an RN-I link on its ICN side. The ICN receives the node's TX
// channels and originates the node's RX channels.
fun chi_rni_icn_flow_adapter(port :: Endpoint,
                             link :: CHIRNILinkParams,
                             transmit_enable :: Bool,
                             receive_enable :: Bool):
  def p = link.flit

  inst request_receiver(CreditBuffer(CHIReqFlit(p), link.tx_req_credits))
  inst request_response_receiver(CreditBuffer(CHIRspFlit(p), link.tx_rsp_credits))
  inst request_data_receiver(CreditBuffer(CHIDatFlit(p), link.tx_dat_credits))
  inst response_transmitter(CreditSender(CHIRspFlit(p), link.rx_rsp_credits))
  inst response_data_transmitter(CreditSender(CHIDatFlit(p), link.rx_dat_credits))

  port.tx_req <=> request_receiver.link
  port.tx_rsp <=> request_response_receiver.link
  port.tx_dat <=> request_data_receiver.link
  response_transmitter.link <=> port.rx_rsp
  response_data_transmitter.link <=> port.rx_dat

  reg transmit_request(~init: Bool(#false))
  reg receive_ack(~init: Bool(#false))
  def transmit_acked = port.rx_link_active_ack
  def receive_requested = port.tx_link_active_request
  def transmit_credit_empty = !or_reduce(response_transmitter.credit_count) & (
    !or_reduce(response_data_transmitter.credit_count)
  )
  def receive_drained = !or_reduce(request_receiver.reserved) & (
    !or_reduce(request_response_receiver.reserved)
  ) & !or_reduce(request_data_receiver.reserved)

  when (!transmit_request & !transmit_acked & transmit_enable):
    transmit_request <== Bool(#true)
  elsewhen (transmit_request & transmit_acked & !transmit_enable):
    transmit_request <== Bool(#false)

  when (!receive_ack & receive_requested & receive_enable):
    receive_ack <== Bool(#true)
  elsewhen (receive_ack & !receive_requested & receive_drained):
    receive_ack <== Bool(#false)

  port.rx_link_active_request <== transmit_request
  port.tx_link_active_ack <== receive_ack
  def grant_receive = receive_ack & receive_requested & receive_enable
  request_receiver.grant_enable <== grant_receive
  request_response_receiver.grant_enable <== grant_receive
  request_data_receiver.grant_enable <== grant_receive

  CHIRNIICNFlows(
    request_receiver.egress,
    request_response_receiver.egress,
    request_data_receiver.egress,
    response_transmitter.ingress,
    response_data_transmitter.ingress,
    transmit_request & transmit_acked,
    !transmit_request & transmit_acked,
    transmit_credit_empty,
    receive_requested & receive_ack,
    !receive_requested & receive_ack
  )

// Originates an SN link on its ICN side. Requests are transmitted toward the
// subordinate while responses are accepted into credited receive buffers.
fun chi_sn_icn_flow_adapter(port :: Endpoint,
                            link :: CHISNLinkParams,
                            transmit_enable :: Bool,
                            receive_enable :: Bool):
  def p = link.flit

  inst request_transmitter(CreditSender(CHIReqFlit(p), link.rx_req_credits))
  inst request_data_transmitter(CreditSender(CHIDatFlit(p), link.rx_dat_credits))
  inst response_receiver(CreditBuffer(CHIRspFlit(p), link.tx_rsp_credits))
  inst response_data_receiver(CreditBuffer(CHIDatFlit(p), link.tx_dat_credits))

  request_transmitter.link <=> port.rx_req
  request_data_transmitter.link <=> port.rx_dat
  port.tx_rsp <=> response_receiver.link
  port.tx_dat <=> response_data_receiver.link

  reg transmit_request(~init: Bool(#false))
  reg receive_ack(~init: Bool(#false))
  def transmit_acked = port.rx_link_active_ack
  def receive_requested = port.tx_link_active_request
  def transmit_credit_empty = !or_reduce(request_transmitter.credit_count) & (
    !or_reduce(request_data_transmitter.credit_count)
  )
  def receive_drained = !or_reduce(response_receiver.reserved) & (
    !or_reduce(response_data_receiver.reserved)
  )

  when (!transmit_request & !transmit_acked & transmit_enable):
    transmit_request <== Bool(#true)
  elsewhen (transmit_request & transmit_acked & !transmit_enable):
    transmit_request <== Bool(#false)

  when (!receive_ack & receive_requested & receive_enable):
    receive_ack <== Bool(#true)
  elsewhen (receive_ack & !receive_requested & receive_drained):
    receive_ack <== Bool(#false)

  port.rx_link_active_request <== transmit_request
  port.tx_link_active_ack <== receive_ack
  def grant_receive = receive_ack & receive_requested & receive_enable
  response_receiver.grant_enable <== grant_receive
  response_data_receiver.grant_enable <== grant_receive

  CHISNICNFlows(
    request_transmitter.ingress,
    request_data_transmitter.ingress,
    response_receiver.egress,
    response_data_receiver.egress,
    transmit_request & transmit_acked,
    !transmit_request & transmit_acked,
    transmit_credit_empty,
    receive_requested & receive_ack,
    !receive_requested & receive_ack
  )

// Forwards an ICN-role port through a hierarchy boundary. Both endpoints have
// the same non-provider role, so their directional members are wired rather
// than treated as peer interfaces.
fun forward_chi_rni_icn_port(outer :: Endpoint, inner :: Endpoint):
  inner.tx_link_active_request <== outer.tx_link_active_request
  inner.rx_link_active_ack <== outer.rx_link_active_ack
  outer.tx_link_active_ack <== inner.tx_link_active_ack
  outer.rx_link_active_request <== inner.rx_link_active_request
  inner.tx_req.valid <== outer.tx_req.valid
  inner.tx_req.bits <== outer.tx_req.bits
  outer.tx_req.credit <== inner.tx_req.credit
  inner.tx_rsp.valid <== outer.tx_rsp.valid
  inner.tx_rsp.bits <== outer.tx_rsp.bits
  outer.tx_rsp.credit <== inner.tx_rsp.credit
  inner.tx_dat.valid <== outer.tx_dat.valid
  inner.tx_dat.bits <== outer.tx_dat.bits
  outer.tx_dat.credit <== inner.tx_dat.credit
  outer.rx_rsp.valid <== inner.rx_rsp.valid
  outer.rx_rsp.bits <== inner.rx_rsp.bits
  inner.rx_rsp.credit <== outer.rx_rsp.credit
  outer.rx_dat.valid <== inner.rx_dat.valid
  outer.rx_dat.bits <== inner.rx_dat.bits
  inner.rx_dat.credit <== outer.rx_dat.credit

fun forward_chi_sn_icn_port(outer :: Endpoint, inner :: Endpoint):
  inner.tx_link_active_request <== outer.tx_link_active_request
  inner.rx_link_active_ack <== outer.rx_link_active_ack
  outer.tx_link_active_ack <== inner.tx_link_active_ack
  outer.rx_link_active_request <== inner.rx_link_active_request
  inner.tx_rsp.valid <== outer.tx_rsp.valid
  inner.tx_rsp.bits <== outer.tx_rsp.bits
  outer.tx_rsp.credit <== inner.tx_rsp.credit
  inner.tx_dat.valid <== outer.tx_dat.valid
  inner.tx_dat.bits <== outer.tx_dat.bits
  outer.tx_dat.credit <== inner.tx_dat.credit
  outer.rx_req.valid <== inner.rx_req.valid
  outer.rx_req.bits <== inner.rx_req.bits
  inner.rx_req.credit <== outer.rx_req.credit
  outer.rx_dat.valid <== inner.rx_dat.valid
  outer.rx_dat.bits <== inner.rx_dat.bits
  inner.rx_dat.credit <== outer.rx_dat.credit

// Provides a module boundary for standalone use and backend verification.
sync_circuit CHISNFlowAdapter(link :: CHISNLinkParams,
                              node :: CHINodeParams):
  def p = link.flit

  input transmit_enable: Bool
  input receive_enable: Bool
  interface port(CHISNLink(link, node), ~role: node)
  interface requests(Irrevocable(CHIReqFlit(p)), ~role: producer)
  interface request_data(Irrevocable(CHIDatFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)
  interface response_data(Decoupled(CHIDatFlit(p)), ~role: consumer)
  output transmit_running: Bool
  output transmit_deactivating: Bool
  output transmit_credit_empty: Bool
  output receive_running: Bool
  output receive_deactivating: Bool

  def flows = chi_sn_flow_adapter(port,
                                  link,
                                  transmit_enable,
                                  receive_enable)
  requests <=> flows.requests
  request_data <=> flows.request_data
  responses <=> flows.responses
  response_data <=> flows.response_data
  transmit_running <== flows.transmit_running
  transmit_deactivating <== flows.transmit_deactivating
  transmit_credit_empty <== flows.transmit_credit_empty
  receive_running <== flows.receive_running
  receive_deactivating <== flows.receive_deactivating

sync_circuit CHIRNIICNFlowAdapter(link :: CHIRNILinkParams,
                                  endpoint :: CHIICNPortParams):
  def p = link.flit

  input transmit_enable: Bool
  input receive_enable: Bool
  interface port(CHIRNILink(link, endpoint), ~role: icn)
  interface requests(Irrevocable(CHIReqFlit(p)), ~role: producer)
  interface requester_responses(Irrevocable(CHIRspFlit(p)), ~role: producer)
  interface request_data(Irrevocable(CHIDatFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)
  interface response_data(Decoupled(CHIDatFlit(p)), ~role: consumer)
  output transmit_running: Bool
  output transmit_deactivating: Bool
  output transmit_credit_empty: Bool
  output receive_running: Bool
  output receive_deactivating: Bool

  def flows = chi_rni_icn_flow_adapter(port,
                                       link,
                                       transmit_enable,
                                       receive_enable)
  requests <=> flows.requests
  requester_responses <=> flows.requester_responses
  request_data <=> flows.request_data
  responses <=> flows.responses
  response_data <=> flows.response_data
  transmit_running <== flows.transmit_running
  transmit_deactivating <== flows.transmit_deactivating
  transmit_credit_empty <== flows.transmit_credit_empty
  receive_running <== flows.receive_running
  receive_deactivating <== flows.receive_deactivating

sync_circuit CHISNICNFlowAdapter(link :: CHISNLinkParams,
                                 endpoint :: CHIICNPortParams):
  def p = link.flit

  input transmit_enable: Bool
  input receive_enable: Bool
  interface port(CHISNLink(link, endpoint), ~role: icn)
  interface requests(Decoupled(CHIReqFlit(p)), ~role: consumer)
  interface request_data(Decoupled(CHIDatFlit(p)), ~role: consumer)
  interface responses(Irrevocable(CHIRspFlit(p)), ~role: producer)
  interface response_data(Irrevocable(CHIDatFlit(p)), ~role: producer)
  output transmit_running: Bool
  output transmit_deactivating: Bool
  output transmit_credit_empty: Bool
  output receive_running: Bool
  output receive_deactivating: Bool

  def flows = chi_sn_icn_flow_adapter(port,
                                      link,
                                      transmit_enable,
                                      receive_enable)
  requests <=> flows.requests
  request_data <=> flows.request_data
  responses <=> flows.responses
  response_data <=> flows.response_data
  transmit_running <== flows.transmit_running
  transmit_deactivating <== flows.transmit_deactivating
  transmit_credit_empty <== flows.transmit_credit_empty
  receive_running <== flows.receive_running
  receive_deactivating <== flows.receive_deactivating

export:
  CHISNFlows
  CHIRNIICNFlows
  CHISNICNFlows
  chi_sn_flow_adapter
  chi_rni_icn_flow_adapter
  chi_sn_icn_flow_adapter
  forward_chi_rni_icn_port
  forward_chi_sn_icn_port
  CHISNFlowAdapter
  CHIRNIICNFlowAdapter
  CHISNICNFlowAdapter
