#lang rhodium
// Elaborates a small blocking inclusive HN-F over the shared CHI test endpoints.

import:
  lib("chi/main.rhdl") open
  "coherent-home-fixture.rhdl" as base

def inclusive_home_addressing = CHIAddressProjectorConfig(
  base.coherent_home_config.flit,
  0x04000000,
  64,
  4
)
def inclusive_home_base_config = CHIHNFConfig(
  base.coherent_home_config.flit,
  base.coherent_home_config.requester_endpoints,
  inclusive_home_addressing.global_mask,
  base.coherent_home_config.service_requests
)
def inclusive_home_config = CHIInclusiveHNFConfig(
  inclusive_home_base_config,
  inclusive_home_addressing,
  ~sets: 2,
  ~ways: 2
)
def inclusive_home_design = elaborate(CHIInclusiveHNF(inclusive_home_config))

export:
  inclusive_home_addressing
  inclusive_home_base_config
  inclusive_home_config
  inclusive_home_design
