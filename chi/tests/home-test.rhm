#lang rhombus
// Checks initial HN-I construction, storage, translation monitors, and parameters.

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../main.rhdl" as chi
  "../../examples/chi/home.rhdl" as fixture

def top = fixture.home_design.modules.find(
  fun (module_def): module_def.name == "CHIHNI"
)
def instance_names = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.instance"
).map(fun (operation): operation.attribute("name"))
def assertion_labels = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "verif.assert"
).map(fun (operation): operation.attribute("label"))
def register_names = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
).map(fun (operation): operation.attribute("name"))
def read_only_endpoint = chi.CHIICNPortParams(
  "read-only-subordinate",
  11,
  chi.CHINodeKind.SNI,
  ~emits: chi.CHIChannelCapabilities(~req: [chi.CHIReqOpcode.ReadNoSnp]),
  ~supports: chi.CHIChannelCapabilities(~dat: [chi.CHIDatOpcode.CompData]),
  ~max_outstanding: 1
)
def read_only_service = chi.CHISubordinateServiceParams(
  read_only_endpoint,
  [chi.AddressSet(0x70000000, 0x0fffffff)],
  [chi.CHIRequestSupport(chi.CHIReqOpcode.ReadNoSnp,
                         chi.TransferSizes(1, 64))]
)
def heterogeneous_map = chi.CHISubordinateMap(
  fixture.home_flit,
  [read_only_service, fixture.subordinate_service]
)
def heterogeneous_design = embedded.run_elaboration(
  fun ():
    chi.CHIHNI(
      chi.CHIHNIParams(fixture.home,
                       [fixture.requester_endpoint],
                       heterogeneous_map)
    )
)

check:
  fixture.home_params.flit === fixture.home_flit ~is #true
  fixture.home_params.home.kind ~is chi.CHINodeKind.HNI
  fixture.home_params.requester_endpoints[0].kind ~is chi.CHINodeKind.RNI
  fixture.home_params.subordinate_map.services ~is (
    [fixture.subordinate_service, fixture.second_subordinate_service]
  )
  heterogeneous_map.entry(0x70000000).service === read_only_service ~is #true
  verify_design(heterogeneous_design) ~is #void
  top.inputs.map(fun (input): input.name) ~is ["clock", "reset", "port_in"]
  top.outputs.map(fun (output): output.name) ~is ["port_out"]
  instance_names.contains("occupancy") ~is #true
  instance_names.contains("read_pending") ~is #true
  instance_names.contains("write_await_dbid") ~is #true
  instance_names.contains("write_await_data") ~is #true
  instance_names.contains("write_await_comp") ~is #true
  top.memories.map(fun (memory): memory.name) ~is (
    ["requests", "subordinate_ids", "subordinate_dbids"]
  )
  register_names.contains("requests") ~is #false
  register_names.contains("subordinate_ids") ~is #false
  register_names.contains("subordinate_dbids") ~is #false
  assertion_labels.contains("chi_hni_request_targets_home") ~is #true
  assertion_labels.contains("chi_hni_request_address_mapped") ~is #true
  assertion_labels.contains("chi_hni_request_service_supported") ~is #true
  assertion_labels.contains("chi_hni_response_source_subordinate") ~is #true
  assertion_labels.contains("chi_hni_read_data_source_subordinate") ~is #true
  assertion_labels.contains("chi_hni_transaction_response_txn_restored") ~is #true
  assertion_labels.contains("chi_hni_transaction_response_source_subordinate") ~is #true
  assertion_labels.contains("chi_hni_transaction_write_data_dbid_translated") ~is #true
  assertion_labels.contains("chi_hni_transaction_write_data_target_subordinate") ~is #true
  assertion_labels.contains("chi_hni_transaction_read_data_txn_restored") ~is #true
  assertion_labels.contains("chi_hni_transaction_read_data_source_subordinate") ~is #true
  top.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance" && (
      operation.attribute("module").name.starts_with("Credit")
    )
  ).length() ~is 0
  verify_design(fixture.home_design) ~is #void

  embedded.run_elaboration(
    fun ():
      chi.CHIHNI(
        chi.CHIHNIParams(
          chi.CHIHomeParams("bad-kind", 5, chi.CHINodeKind.HNF, ~max_outstanding: 2),
          [fixture.requester_endpoint],
          fixture.subordinate_map
        )
      )
  ) ~throws "home kind must be HN-I"
  embedded.run_elaboration(
    fun ():
      chi.CHIHNI(
        chi.CHIHNIParams(
          fixture.home,
          [fixture.requester_endpoint, fixture.requester_endpoint],
          fixture.subordinate_map
        )
      )
  ) ~throws "requester NodeIDs must be unique"
  embedded.run_elaboration(
    fun ():
      chi.CHIHNI(
        chi.CHIHNIParams(
          chi.CHIHomeParams(
            "colliding-home",
            fixture.subordinate_endpoint.node_id,
            chi.CHINodeKind.HNI,
            ~max_outstanding: 2
          ),
          [fixture.requester_endpoint],
          fixture.subordinate_map
        )
      )
  ) ~throws "subordinate and Home NodeIDs must be distinct"
  embedded.run_elaboration(
    fun ():
      def partial_service = chi.CHISubordinateServiceParams(
        fixture.subordinate_endpoint,
        fixture.subordinate_service.address_sets,
        [fixture.subordinate_service.requests[0]]
      )
      chi.CHIHNI(
        chi.CHIHNIParams(
          fixture.home,
          [fixture.requester_endpoint],
          chi.CHISubordinateMap(fixture.home_flit, [partial_service])
        )
      )
  ) ~throws "requester opcode must be supported by at least one subordinate service"
  embedded.run_elaboration(
    fun ():
      def snf_endpoint = chi.CHIICNPortParams(
        "full-subordinate",
        11,
        chi.CHINodeKind.SNF,
        ~emits: fixture.subordinate_endpoint.emits,
        ~supports: fixture.subordinate_endpoint.supports,
        ~max_outstanding: 2
      )
      def snf_service = chi.CHISubordinateServiceParams(
        snf_endpoint,
        [chi.AddressSet(0xa0000000, 0x0fffffff)],
        fixture.subordinate_service.requests
      )
      chi.CHIHNI(
        chi.CHIHNIParams(
          fixture.home,
          [fixture.requester_endpoint],
          chi.CHISubordinateMap(fixture.home_flit, [snf_service])
        )
      )
  ) ~throws "subordinate endpoints must describe SN-Is"
