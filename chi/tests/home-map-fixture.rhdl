#lang rhodium
// Elaborates two-region CHI Home address selection into combinational hardware.

import:
  lib("chi/main.rhdl") open

def flit = CHIFlitParams()
def home0 = CHIHomeParams("home-0", 5, CHINodeKind.HNF, ~max_outstanding: 2)
def home1 = CHIHomeParams("home-1", 6, CHINodeKind.HNF, ~max_outstanding: 2)
def home_map = CHIHomeMap(
  flit,
  [CHIHomeMapEntry(AddressSet(0x0000, 0x0fff), home0),
   CHIHomeMapEntry(AddressSet(0x1000, 0x0fff), home1)]
)

circuit CHIHomeMapFixture():
  input address: Bits(flit.request_address_width)
  output valid: Bool
  output node_id: Bits(flit.node_id_width)

  def lookup = home_map.lookup(address)
  valid <== lookup.valid
  node_id <== lookup.node_id

def design = elaborate(CHIHomeMapFixture())

export:
  flit
  home0
  home1
  home_map
  CHIHomeMapFixture
  design
