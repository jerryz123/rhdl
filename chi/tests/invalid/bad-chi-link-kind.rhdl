#lang rhdl
// Rejects specializing the RN-I physical interface with an RN-F endpoint.

import:
  lib("chi/main.rhdl") open

def node = CHINodeParams(
  "cache",
  5,
  CHINodeKind.RNF,
  ~emits: CHIChannelCapabilities(),
  ~supports: CHIChannelCapabilities()
)

circuit BadCHILinkKind():
  interface link(CHIRNILink(CHIRNILinkParams(CHIFlitParams()), node), ~role: node)

def design = elaborate(BadCHILinkKind())
