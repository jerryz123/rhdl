#lang rhdl
// Rejects advertising an SNP receive capability on an RN-I endpoint.

import:
  lib("chi/main.rhdl") open

def node = CHINodeParams(
  "requester",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(),
  ~supports: CHIChannelCapabilities(~snp: [CHISnpOpcode.SnpShared]),
  ~max_outstanding: 1
)
