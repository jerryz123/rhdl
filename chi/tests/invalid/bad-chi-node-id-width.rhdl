#lang rhdl
// Rejects a CHI NodeID that does not fit the physical NodeID field width.

import:
  lib("chi/main.rhdl") open
  "../link-fixture.rhdl" as fixture

def node = CHINodeParams(
  "requester",
  128,
  CHINodeKind.RNI,
  ~emits: fixture.rni_node.emits,
  ~supports: fixture.rni_node.supports
)
def icn = CHIICNPortParams(
  "requester-port",
  128,
  CHINodeKind.RNI,
  ~emits: fixture.rni_icn.emits,
  ~supports: fixture.rni_icn.supports
)
def link = CHIRNILinkParams(CHIFlitParams(~node_id_width: 7))
def design = elaborate(fixture.CHIRNILinkAdapter(link, node, link, icn))
