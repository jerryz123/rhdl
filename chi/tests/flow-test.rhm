#lang rhombus
// Checks requester and subordinate flow adapters and their activation surfaces.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/layers/bool.rhm" as bool
  "flow-fixture.rhdl" as fixture

def top = fixture.flow_design.modules.find(
  fun (module_def): module_def.name == "CHISNFlowAdapter"
)
def instances = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.instance"
)
def senders = fixture.flow_design.modules.filter(
  ~keep: fun (module_def): module_def.name.starts_with("CreditSender")
)
def buffers = fixture.flow_design.modules.filter(
  ~keep: fun (module_def): module_def.name.starts_with("CreditBuffer")
)
def rni_icn = fixture.rni_icn_design.modules.find(
  fun (module_def): module_def.name == "CHIRNIICNFlowAdapter"
)
def sni_icn = fixture.sni_icn_design.modules.find(
  fun (module_def): module_def.name == "CHISNICNFlowAdapter"
)
def rn = fixture.rn_design.modules.find(
  fun (module_def): module_def.name == "CHIRNFlowAdapter"
)
def rn_icn = fixture.rn_icn_design.modules.find(
  fun (module_def): module_def.name == "CHIRNICNFlowAdapter"
)
fun instances_named(module_def, prefix):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance" && (
      operation.attribute("module").name.starts_with(prefix)
    )
  ).length()

check:
  top != #false ~is #true
  instances.filter(
    ~keep: fun (operation): operation.attribute("module").name.starts_with("CreditSender")
  ).length() ~is 2
  instances.filter(
    ~keep: fun (operation): operation.attribute("module").name.starts_with("CreditBuffer")
  ).length() ~is 2
  senders.length() ~is 2
  buffers.length() ~is 2
  top.find_output("transmit_running").type === bool.Bool ~is #true
  top.find_output("transmit_deactivating").type === bool.Bool ~is #true
  top.find_output("transmit_credit_empty").type === bool.Bool ~is #true
  top.find_output("receive_running").type === bool.Bool ~is #true
  top.find_output("receive_deactivating").type === bool.Bool ~is #true
  verify_design(fixture.flow_design) ~is #void
  instances_named(rn, "CreditSender") ~is 3
  instances_named(rn, "CreditBuffer") ~is 3
  instances_named(rn_icn, "CreditSender") ~is 3
  instances_named(rn_icn, "CreditBuffer") ~is 3
  verify_design(fixture.rn_design) ~is #void
  verify_design(fixture.rn_icn_design) ~is #void
  instances_named(rni_icn, "CreditSender") ~is 2
  instances_named(rni_icn, "CreditBuffer") ~is 3
  instances_named(sni_icn, "CreditSender") ~is 2
  instances_named(sni_icn, "CreditBuffer") ~is 2
  verify_design(fixture.rni_icn_design) ~is #void
  verify_design(fixture.sni_icn_design) ~is #void
