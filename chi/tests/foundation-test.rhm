#lang rhombus
// Checks CHI flit ports, classifier hardware, and CIRCT emission.

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/backend/circt.rhm" open
  "foundation-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def circt = emit_circt(fixture.design)
def full_module = fixture.full_design.modules[0]
def full_circt = emit_circt(fixture.full_design)

check:
  module_def.find_input("req").type.packed_width() ~is 137
  module_def.find_input("rsp").type.packed_width() ~is 71
  module_def.find_input("snp").type.packed_width() ~is 94
  module_def.find_input("dat").type.packed_width() ~is 240
  module_def.find_output("req_out").type.packed_width() ~is 137
  module_def.find_output("rsp_out").type.packed_width() ~is 71
  module_def.find_output("snp_out").type.packed_width() ~is 94
  module_def.find_output("dat_out").type.packed_width() ~is 240
  module_def.find_input("req_opcode").type.width ~is 7
  module_def.find_input("rsp_opcode").type.width ~is 5
  module_def.find_input("snp_opcode").type.width ~is 5
  module_def.find_input("dat_opcode").type.width ~is 4
  module_def.find_input("size").type.type_equal(fixture.CHITransferSize) ~is #true
  module_def.find_output("req_size").type.type_equal(fixture.CHITransferSize) ~is #true
  module_def.find_output("req_num_req").type.width ~is 6
  module_def.find_output("data_beats_minus_one").type.width ~is 2
  full_module.find_input("req").type.packed_width() ~is 240
  full_module.find_input("rsp").type.packed_width() ~is 89
  full_module.find_input("snp").type.packed_width() ~is 151
  full_module.find_input("dat").type.packed_width() ~is 818
  circt.contains("hw.struct<") ~is #true
  circt.contains("comb.icmp") ~is #true
  circt.contains("comb.mux") ~is #true
  full_circt.contains("data_check: i64") ~is #true
  verify_design(fixture.design) ~is #void
  verify_design(fixture.full_design) ~is #void
