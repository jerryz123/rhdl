#lang rhodium
// Elaborates a four-bank CHI address projector and its dense local service metadata.

import:
  lib("chi/main.rhdl") open

def projector_flit = CHIFlitParams()
def projector_ram_config = CHIRamConfig(projector_flit, 0x2000, ~max_outstanding: 2)
def projector_ram_params = CHIRamParams("projector-ram", 9, projector_ram_config)
def projector_fragmenter_config = CHITransferFragmenterConfig(projector_flit, ~max_read_bytes: 64)
def projector_fragmenter_params = CHITransferFragmenterParams(
  projector_fragmenter_config,
  projector_ram_params.service
)
def projector_config = CHIAddressProjectorConfig(projector_flit, 0x2000, 64, 4)
def projector_params = CHIAddressProjectorParams(
  projector_config,
  projector_fragmenter_params.upstream_service,
  0x80000000,
  2
)
def projector_design = elaborate(CHIAddressProjector(projector_config))

export:
  projector_flit
  projector_ram_config
  projector_ram_params
  projector_fragmenter_config
  projector_fragmenter_params
  projector_config
  projector_params
  projector_design
