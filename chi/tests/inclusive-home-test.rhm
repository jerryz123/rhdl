#lang rhombus
// Checks the blocking inclusive HN-F configuration and cache structures.

import:
  "../../rhodium/core/main.rhm" open
  "../main.rhdl" as chi
  "inclusive-home-fixture.rhdl" as fixture

def modules = fixture.inclusive_home_design.modules
def top = modules.find(fun (module_def): module_def.name == "CHIInclusiveHNF")
def registers = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
).map(fun (operation): operation.attribute("name"))
def instances = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.instance"
).map(fun (operation): operation.attribute("name"))

check:
  fixture.inclusive_home_config.sets ~is 2
  fixture.inclusive_home_config.ways ~is 2
  fixture.inclusive_home_config.capacity_bytes ~is 256
  registers.contains("valid_lines") ~is #true
  registers.contains("dirty_lines") ~is #true
  registers.contains("line_buffer") ~is #true
  instances.contains("tags") ~is #true
  instances.contains("lines") ~is #true
  verify_design(fixture.inclusive_home_design) ~is #void
