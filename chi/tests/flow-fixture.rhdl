#lang rhdl
// Elaborates requester and subordinate credited-flow adapters for structural tests.

import:
  lib("chi/params.rhdl") open
  lib("chi/flits.rhdl") open
  lib("chi/coherence.rhdl") open
  lib("chi/link.rhdl") open
  lib("chi/flow.rhdl") open

def flow_flit = CHIFlitParams()
def flow_link = CHISNLinkParams(
  flow_flit,
  ~tx_rsp_credits: 2,
  ~tx_dat_credits: 2,
  ~rx_req_credits: 2,
  ~rx_dat_credits: 2
)
def flow_node = CHINodeParams(
  "flow-sn",
  9,
  CHINodeKind.SNF,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 2
)
def flow_design = elaborate(CHISNFlowAdapter(flow_link, flow_node))

def rn_link = CHIRNLinkParams(flow_flit)
def rn_node = CHINodeParams(
  "flow-rnf",
  5,
  CHINodeKind.RNF,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadShared],
    ~rsp: [CHIRspOpcode.CompAck, CHIRspOpcode.SnpResp]
  ),
  ~supports: CHIChannelCapabilities(
    ~snp: chi_rnf_snoop_opcodes,
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 2
)
def rn_icn = CHIICNPortParams(
  "flow-rnf-icn",
  rn_node.node_id,
  CHINodeKind.RNF,
  ~emits: rn_node.supports,
  ~supports: rn_node.emits,
  ~max_outstanding: 2
)
def rn_design = elaborate(CHIRNFlowAdapter(rn_link, rn_node))
def rn_icn_design = elaborate(CHIRNICNFlowAdapter(rn_link, rn_icn))

def rni_link = CHIRNILinkParams(flow_flit)
def rni_icn = CHIICNPortParams(
  "flow-rni-icn",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 2
)
def rni_icn_design = elaborate(CHIRNIICNFlowAdapter(rni_link, rni_icn))

def sni_link = CHISNLinkParams(flow_flit)
def sni_icn = CHIICNPortParams(
  "flow-sni-icn",
  9,
  CHINodeKind.SNI,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~supports: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 2
)
def sni_icn_design = elaborate(CHISNICNFlowAdapter(sni_link, sni_icn))

export:
  flow_flit
  flow_link
  flow_node
  flow_design
  rn_link
  rn_node
  rn_icn
  rn_design
  rn_icn_design
  rni_link
  rni_icn
  rni_icn_design
  sni_link
  sni_icn
  sni_icn_design
