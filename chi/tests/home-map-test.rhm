#lang rhombus
// Checks CHI Home map host lookup and combinational hardware elaboration.

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/backend/circt.rhm" open
  "home-map-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def circt = emit_circt(fixture.design)

check:
  fixture.home_map.entry(0x0004).home === fixture.home0 ~is #true
  fixture.home_map.entry(0x1ffc).home === fixture.home1 ~is #true
  fixture.home_map.entry(0x2000) ~is #false
  module_def.find_input("address").type.width ~is 44
  module_def.find_output("valid").type.packed_width() ~is 1
  module_def.find_output("node_id").type.width ~is 7
  circt.contains("comb.mux") ~is #true
  circt.contains("hw.constant 5") ~is #true
  circt.contains("hw.constant 6") ~is #true
  verify_design(fixture.design) ~is #void
