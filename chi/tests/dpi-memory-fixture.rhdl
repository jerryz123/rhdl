#lang rhodium
// Elaborates the standalone native-CHI DPI-backed simulation memory.

import:
  lib("chi/main.rhdl") open

def chi_dpi_memory_flit = CHIFlitParams()
def chi_dpi_memory_config = CHIRamConfig(
  chi_dpi_memory_flit,
  4096,
  ~max_outstanding: 4
)
def design = elaborate(CHIDPIMemory(chi_dpi_memory_config))
def wide_design = elaborate(CHIDPIMemory(CHIRamConfig(
  CHIFlitParams(~data_width: 512),
  4096,
  ~max_outstanding: 2
)))

export:
  chi_dpi_memory_flit
  chi_dpi_memory_config
  design
  wide_design
