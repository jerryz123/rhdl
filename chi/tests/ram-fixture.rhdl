#lang rhdl
// Elaborates a small initial-profile CHI RAM for host and backend verification.

import:
  lib("chi/main.rhdl") open

def ram_flit = CHIFlitParams()
def ram_link = CHISNLinkParams(
  ram_flit,
  ~tx_rsp_credits: 2,
  ~tx_dat_credits: 2,
  ~rx_req_credits: 2,
  ~rx_dat_credits: 2
)
def ram_params = CHIRamParams(
  "test-chi-ram",
  9,
  ram_link,
  64,
  ~base_address: 0x80000000,
  ~max_outstanding: 2
)
def ram_design = elaborate(CHIRam(ram_params))

export:
  ram_flit
  ram_link
  ram_params
  ram_design
