#lang rhdl
// Elaborates CHI coherence state and opcode classifiers for focused tests.

import:
  lib("chi/main.rhdl") open

circuit CHICoherenceClassifiers():
  input cache_state: CHICacheState
  input response: Bits(3)
  input snoop_opcode: CHISnpOpcode
  input response_opcode: CHIRspOpcode
  input data_opcode: CHIDatOpcode
  output cache_valid: Bool
  output cache_dirty: Bool
  output cache_shared: Bool
  output cache_unique: Bool
  output response_state: CHIResponseState
  output response_pass_dirty: Bool
  output snoop_forward: Bool
  output snoop_stash: Bool
  output snoop_dvm: Bool
  output response_is_snoop: Bool
  output data_is_snoop: Bool

  cache_valid <== chi_cache_state_valid(cache_state)
  cache_dirty <== chi_cache_state_dirty(cache_state)
  cache_shared <== chi_cache_state_shared(cache_state)
  cache_unique <== chi_cache_state_unique(cache_state)
  response_state <== chi_response_state(response)
  response_pass_dirty <== chi_response_pass_dirty(response)
  snoop_forward <== chi_snp_is_forward(snoop_opcode)
  snoop_stash <== chi_snp_is_stash(snoop_opcode)
  snoop_dvm <== chi_snp_is_dvm(snoop_opcode)
  response_is_snoop <== chi_rsp_is_snoop_response(response_opcode)
  data_is_snoop <== chi_dat_is_snoop_response(data_opcode)

def design = elaborate(CHICoherenceClassifiers())

export:
  CHICoherenceClassifiers
  design
