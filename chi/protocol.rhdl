#lang rhdl
// Defines AMBA CHI physical data-packet classifiers.

import:
  lib("chi/params.rhdl").CHIFlitParams
  lib("chi/flits.rhdl") open

fun chi_size_valid(size :: Bits(3)) :~ Bool:
  size =/= bits(7, 3)

// Returns one less than the physical DAT packet count. Sizes through 16 bytes
// always occupy one packet; larger transfers are split by Data_Width.
fun chi_data_beats_minus_one(size :: Bits(3),
                             p :: CHIFlitParams) :: Bits(2):
  def size_32_beats_minus_one = if p.data_width == 128 | 1 | 0
  def size_64_beats_minus_one:
    cond
    | p.data_width == 128: 3
    | p.data_width == 256: 1
    | ~else: 0
  mux_lookup(size, ~default: bits(0, 2)):
    5: bits(size_32_beats_minus_one, 2)
    6: bits(size_64_beats_minus_one, 2)

fun chi_data_id_valid(data_id :: Bits(2), p :: CHIFlitParams) :~ Bool:
  cond
  | p.data_width == 128: Bool(#true)
  | p.data_width == 256: is_one_of(data_id, bits(0, 2), bits(2, 2))
  | ~else: data_id === bits(0, 2)

export:
  chi_size_valid
  chi_data_beats_minus_one
  chi_data_id_valid
