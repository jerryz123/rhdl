#lang rhdl
// Defines CHI coherent cache states and protocol-family classifiers.

import:
  lib("rhdl/std/bits.rhdl") open
  lib("chi/flits.rhdl") open

hardware_enum CHICacheState(~width: 3):
  Invalid = 0
  SharedClean = 1
  UniqueClean = 2
  SharedDirty = 3
  UniqueDirty = 4
  UniqueCleanEmpty = 5
  UniqueDirtyPartial = 6

hardware_enum CHIResponseState(~width: 2):
  Invalid = 0
  SharedClean = 1
  Unique = 2
  SharedDirty = 3

// Every ordinary SNP opcode is mandatory at an RN-F endpoint. Link Credit
// Return remains an activation-control flit and is accepted independently.
def chi_rnf_snoop_opcodes = [
  CHISnpOpcode.SnpShared,
  CHISnpOpcode.SnpClean,
  CHISnpOpcode.SnpOnce,
  CHISnpOpcode.SnpNotSharedDirty,
  CHISnpOpcode.SnpUniqueStash,
  CHISnpOpcode.SnpMakeInvalidStash,
  CHISnpOpcode.SnpUnique,
  CHISnpOpcode.SnpCleanShared,
  CHISnpOpcode.SnpCleanInvalid,
  CHISnpOpcode.SnpMakeInvalid,
  CHISnpOpcode.SnpStashUnique,
  CHISnpOpcode.SnpStashShared,
  CHISnpOpcode.SnpDVMOp,
  CHISnpOpcode.SnpQuery,
  CHISnpOpcode.SnpSharedFwd,
  CHISnpOpcode.SnpCleanFwd,
  CHISnpOpcode.SnpOnceFwd,
  CHISnpOpcode.SnpNotSharedDirtyFwd,
  CHISnpOpcode.SnpPreferUnique,
  CHISnpOpcode.SnpPreferUniqueFwd,
  CHISnpOpcode.SnpUniqueFwd
]

fun chi_cache_state_valid(state :: CHICacheState) :~ Bool:
  state =/= CHICacheState.Invalid

fun chi_cache_state_dirty(state :: CHICacheState) :~ Bool:
  is_one_of(state,
            CHICacheState.SharedDirty,
            CHICacheState.UniqueDirty,
            CHICacheState.UniqueDirtyPartial)

fun chi_cache_state_shared(state :: CHICacheState) :~ Bool:
  is_one_of(state,
            CHICacheState.SharedClean,
            CHICacheState.SharedDirty)

fun chi_cache_state_unique(state :: CHICacheState) :~ Bool:
  is_one_of(state,
            CHICacheState.UniqueClean,
            CHICacheState.UniqueDirty,
            CHICacheState.UniqueCleanEmpty,
            CHICacheState.UniqueDirtyPartial)

fun chi_response_state(resp :: Bits(3)) :~ CHIResponseState:
  cast(resp[0..2], CHIResponseState)

fun chi_response_pass_dirty(resp :: Bits(3)) :~ Bool:
  cast(resp[2], Bool)

fun chi_snp_is_forward(opcode :: CHISnpOpcode) :~ Bool:
  is_one_of(opcode,
            CHISnpOpcode.SnpSharedFwd,
            CHISnpOpcode.SnpCleanFwd,
            CHISnpOpcode.SnpOnceFwd,
            CHISnpOpcode.SnpNotSharedDirtyFwd,
            CHISnpOpcode.SnpPreferUniqueFwd,
            CHISnpOpcode.SnpUniqueFwd)

fun chi_snp_is_stash(opcode :: CHISnpOpcode) :~ Bool:
  is_one_of(opcode,
            CHISnpOpcode.SnpUniqueStash,
            CHISnpOpcode.SnpMakeInvalidStash,
            CHISnpOpcode.SnpStashUnique,
            CHISnpOpcode.SnpStashShared)

fun chi_snp_is_dvm(opcode :: CHISnpOpcode) :~ Bool:
  opcode === CHISnpOpcode.SnpDVMOp

fun chi_rsp_is_snoop_response(opcode :: CHIRspOpcode) :~ Bool:
  is_one_of(opcode,
            CHIRspOpcode.SnpResp,
            CHIRspOpcode.SnpRespFwded)

fun chi_dat_is_snoop_response(opcode :: CHIDatOpcode) :~ Bool:
  is_one_of(opcode,
            CHIDatOpcode.SnpRespData,
            CHIDatOpcode.SnpRespDataPtl,
            CHIDatOpcode.SnpRespDataFwded)

export:
  CHICacheState
  CHIResponseState
  chi_rnf_snoop_opcodes
  chi_cache_state_valid
  chi_cache_state_dirty
  chi_cache_state_shared
  chi_cache_state_unique
  chi_response_state
  chi_response_pass_dirty
  chi_snp_is_forward
  chi_snp_is_stash
  chi_snp_is_dvm
  chi_rsp_is_snoop_response
  chi_dat_is_snoop_response
