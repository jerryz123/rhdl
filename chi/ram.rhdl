#lang rhodium
// Implements a single-flit non-coherent CHI SN-F/SN-I backing RAM.

import:
  lib("support/annotations.rhm") open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/read-write.rhdl") open
  lib("rhodium/std/sync-ram.rhdl").SyncRam1RW
  lib("rhodium/std/flow.rhdl") open
  lib("chi/params.rhdl") open
  lib("chi/flits.rhdl") open
  lib("chi/protocol.rhdl") open
  lib("chi/transaction.rhdl") open
  lib("chi/link.rhdl") open
  lib("chi/channels.rhdl").CHISNChannels
  lib("chi/fabric.rhdl") open
  lib("chi/subordinate-slots.rhdl") open

bundle CHIRamMemoryOperation(p :: CHIFlitParams, slot_width :: PosInt):
  write: Bool
  slot: Bits(slot_width)
  request: CHIReqFlit(p)
  data: Bits(p.data_width)
  mask: Mask(p.data_bytes)

bundle CHIRamMemoryCompletion(p :: CHIFlitParams, slot_width :: PosInt):
  memory_operation: CHIRamMemoryOperation(p, slot_width)
  data: Bits(p.data_width)

bundle CHIRamIdentity(p :: CHIFlitParams):
  node_id: Bits(p.node_id_width)
  base_address: Bits(p.request_address_width)

class CHIRamConfig(flit :: CHIFlitParams,
                   size_bytes :: Pow2Int,
                   max_outstanding :: Int.in(1 ..= 1024)):
  implements StableCircuitParam

  property transfers: TransferSizes(1, flit.data_bytes)
  property requests:
    [CHIRequestSupport(CHIReqOpcode.ReadNoSnp, transfers),
     CHIRequestSupport(CHIReqOpcode.WriteNoSnpFull, transfers),
     CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl, transfers)]

  constructor (flit :: CHIFlitParams,
               size_bytes :: Pow2Int,
               ~max_outstanding: max_outstanding :: Int.in(1 ..= 1024)):
    unless size_bytes >= (2 * flit.data_bytes)
    | error(~who: #'CHIRamConfig,
            "size must contain at least two physical data beats")
    super(flit, size_bytes, max_outstanding)

class CHIRamParams(name :: NonemptyString,
                   node_id :: Nat,
                   config :: CHIRamConfig,
                   ~base_address: base_address :: Nat = 0,
                   ~kind: kind :: CHINodeKind = CHINodeKind.SNF):

  property flit: config.flit
  property size_bytes: config.size_bytes
  property max_outstanding: config.max_outstanding

  property transfers: config.transfers
  property node:
    CHINodeParams(
      name,
      node_id,
      kind,
      ~emits: CHIChannelCapabilities(
        ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
        ~dat: [CHIDatOpcode.CompData]
      ),
      ~supports: CHIChannelCapabilities(
        ~req: [CHIReqOpcode.ReadNoSnp,
               CHIReqOpcode.WriteNoSnpFull,
               CHIReqOpcode.WriteNoSnpPtl],
        ~dat: [CHIDatOpcode.NonCopyBackWriteData]
      ),
      ~max_outstanding: max_outstanding
    )
  property icn_port:
    CHIICNPortParams(
      name ++ "-icn",
      node_id,
      kind,
      ~emits: node.supports,
      ~supports: node.emits,
      ~max_outstanding: max_outstanding
    )
  property service:
    CHISubordinateServiceParams(
      icn_port,
      [AddressSet(base_address, size_bytes - 1)],
      config.requests
    )

  constructor (name :: NonemptyString,
               node_id :: Nat,
               config :: CHIRamConfig,
               ~base_address: base_address :: Nat = 0,
               ~kind: kind :: CHINodeKind = CHINodeKind.SNF):
    unless [CHINodeKind.SNF, CHINodeKind.SNI].contains(kind)
    | error(~who: #'CHIRamParams,
            "kind must be SN-F or SN-I")
    unless base_address mod config.size_bytes == 0
    | error(~who: #'CHIRamParams,
            "base address must be aligned to the RAM size")
    unless bits.length((base_address + config.size_bytes) - 1) <= config.flit.request_address_width
    | error(~who: #'CHIRamParams,
            "memory region must fit in the request address width")
    unless bits.length(node_id) <= config.flit.node_id_width
    | error(~who: #'CHIRamParams,
            "NodeID must fit in the physical NodeID width")
    super(name,
          node_id,
          config,
          ~base_address: base_address,
          ~kind: kind)

fun checked_chi_ram_config(config :: CHIRamConfig):
  def p = config.flit
  unless config.size_bytes >= (2 * p.data_bytes)
  | error(~who: #'CHIRam,
          "size must contain at least two physical data beats")
  config

fun monitor_chi_ram_request(config :: CHIRamConfig,
                            base_address :: Bits(config.flit.request_address_width),
                            valid :: Bool,
                            request :: CHIReqFlit(config.flit)):
  def p = config.flit
  def request_opcode :: CHIReqOpcode = request.opcode
  def size = request.size_or_num_req[0..3]
  def max_size = alignment_bits(p.data_bytes)
  def alignment_cases = for List (encoded_size in 0..(max_size + 1)):
    [encoded_size, is_aligned(request.address, 1 << encoded_size)]
  def address_aligned = mux_lookup(
    size,
    ~default: Bool(#false),
    alignment_cases
  )
  def address_supported = (
    request.address >= base_address
  ) & (
    request.address < (base_address + bits(config.size_bytes, p.request_address_width))
  )
  when (valid & (request.opcode =/= CHIReqOpcode.ReqLCrdReturn)):
    assert(request_opcode.supports_initial_transaction(),
           "chi_ram_request_opcode_supported")
    assert(size <= bits(max_size, 3),
           "chi_ram_request_size_supported")
    assert(address_aligned, "chi_ram_request_address_aligned")
    assert(address_supported, "chi_ram_request_address_supported")

fun monitor_chi_ram_write_data(p :: CHIFlitParams,
                               valid :: Bool,
                               data :: CHIDatFlit(p),
                               request :: CHIReqFlit(p)):
  def expected_mask = transfer_byte_mask(
    request.address,
    request.size_or_num_req[0..3],
    p.data_bytes
  )
  def supplied_mask = data.byte_enable.into(Mask(p.data_bytes))
  def partial = request.opcode === CHIReqOpcode.WriteNoSnpPtl
  def mask_supported = mux(
    partial,
    (supplied_mask & expected_mask) === supplied_mask,
    supplied_mask === expected_mask
  )
  when valid:
    assert(mask_supported, "chi_ram_write_data_mask_supported")
    if p.poison_width > 0
    | assert(!or_reduce(data.poison), "chi_ram_write_data_not_poisoned")
    | #void

circuit CHIRamCompletionRouter(p :: CHIFlitParams,
                               slot_width :: PosInt):
  input node_id: Bits(p.node_id_width)
  interface ingress(Irrevocable(CHIRamMemoryCompletion(p, slot_width)),
                    ~role: consumer)
  interface read_response(Irrevocable(CHIDatFlit(p)), ~role: producer)
  interface write_response(Irrevocable(CHIRspFlit(p)), ~role: producer)
  interface completed(Valid(Bits(slot_width)), ~role: producer)

  def completion = ingress.bits
  def operation = completion.memory_operation
  def write = operation.write
  ingress.ready <== mux(write,
                        write_response.ready,
                        read_response.ready)
  read_response.valid <== ingress.valid & !write
  read_response.bits <== chi_sn_read_completion(p,
                                                node_id,
                                                operation.request,
                                                completion.data)
  write_response.valid <== ingress.valid & write
  write_response.bits <== chi_sn_write_completion(p,
                                                  node_id,
                                                  operation.request,
                                                  operation.slot)
  completed.valid <== fire(ingress)
  completed.bits <== operation.slot

sync_circuit CHIRam(config :: CHIRamConfig):
  def checked = checked_chi_ram_config(config)
  def p = checked.flit
  def limit = checked.max_outstanding
  def slot_width = index_width(limit)
  def depth = checked.size_bytes / p.data_bytes
  def word_address_width = index_width(depth)
  def low_width = alignment_bits(p.data_bytes)
  def Data = Vec(p.data_bytes, Bits(8))
  def MemoryOperation = CHIRamMemoryOperation(p, slot_width)
  def MemoryCompletion = CHIRamMemoryCompletion(p, slot_width)

  input identity: CHIRamIdentity(p)
  interface port(CHISNChannels(p), ~role: node)
  inst dbid_responses(Queue(CHIRspFlit(p), limit, ~pipe: #true))
  inst read_operations(Queue(MemoryOperation, limit, ~pipe: #true))
  inst write_operations(Queue(MemoryOperation, limit, ~pipe: #true))
  inst operation_arbiter(RRArbiter(MemoryOperation, 2))
  inst memory_operations(CompletionQueue(MemoryOperation,
                                         MemoryCompletion,
                                         limit))
  inst storage(SyncRam1RW(depth, Bits(8), p.data_bytes))
  inst completion_router(CHIRamCompletionRouter(p, slot_width))
  completion_router.node_id <== identity.node_id
  inst response_arbiter(RRArbiter(CHIRspFlit(p), 2))
  inst transaction_slots(CHISNTransactionSlots(p, limit))

  def supported_requests = port.req |> filter_flow(request):
    def request_opcode :: CHIReqOpcode = request.opcode
    request_opcode.supports_initial_transaction()
  transaction_slots.allocation <=> (
    supported_requests |> map_flow(request):
      def request_opcode :: CHIReqOpcode = request.opcode
      CHISNTransactionAllocation(p):
        write: request_opcode.is_initial_write()
        request: request
  )

  def allocated_request_paths = transaction_slots.allocated |> demux_flow(2, allocated):
    allocated.write.as_bits()
  def allocated_reads :: Endpoint = allocated_request_paths[0]
  def allocated_writes :: Endpoint = allocated_request_paths[1]
  read_operations.ingress <=> (
    allocated_reads |> map_flow(allocated):
      CHIRamMemoryOperation(p, slot_width):
        write: Bool(#false)
        slot: allocated.slot
        request: allocated.request
        data: bits(0, p.data_width)
        mask: Mask(p.data_bytes)(0)
  )
  dbid_responses.ingress <=> (
    allocated_writes |> map_flow(allocated):
      chi_sn_dbid_response(p,
                           identity.node_id,
                           allocated.request,
                           allocated.slot)
  )

  port.dat.request <=> transaction_slots.write_data
  write_operations.ingress <=> (
    transaction_slots.matched_write |> map_flow(matched):
      CHIRamMemoryOperation(p, slot_width):
        write: Bool(#true)
        slot: matched.slot
        request: matched.request
        data: matched.data.data
        mask: matched.data.byte_enable.into(Mask(p.data_bytes))
  )

  read_operations.egress <=> operation_arbiter.ingress[0]
  write_operations.egress <=> operation_arbiter.ingress[1]
  operation_arbiter.egress <=> memory_operations.request
  (
    memory_operations.issue |> map_valid(operation):
      def relative_address :: Bits(p.request_address_width) = (
        operation.request.address - identity.base_address
      )
      def word_address = relative_address[low_width..(low_width + word_address_width)]
      ReadWriteRequest(word_address_width, Bits(8), p.data_bytes):
        address: word_address
        write: operation.write
        data: operation.data.into(Data)
        mask: operation.mask
  ) <=> storage.port.request
  (
    memory_operations.issue |> valid_pipe(1) |> map_valid(operation):
      CHIRamMemoryCompletion(p, slot_width):
        memory_operation: operation
        data: mux(operation.write,
                  bits(0, p.data_width),
                  storage.port.response.bits.as_bits())
  ) <=> memory_operations.completion

  memory_operations.response <=> completion_router.ingress
  def dbid_response_paths = dbid_responses.egress |> atomic_fork(2)
  dbid_response_paths[0] <=> response_arbiter.ingress[0]
  transaction_slots.dbid_sent <=> (
    dbid_response_paths[1] |> to_valid() |> map_valid(response):
      response.dbid_or_group_id[0..slot_width]
  )
  completion_router.write_response <=> response_arbiter.ingress[1]
  response_arbiter.egress <=> port.rsp
  completion_router.read_response <=> port.dat.response
  completion_router.completed <=> transaction_slots.completed

  monitor_chi_ram_request(checked, identity.base_address, port.req.valid, port.req.bits)
  monitor_chi_ram_write_data(p,
                             transaction_slots.matched_write.valid,
                             transaction_slots.matched_write.bits.data,
                             transaction_slots.matched_write.bits.request)

export:
  CHIRamConfig
  CHIRamParams
  CHIRamIdentity
  CHIRam
