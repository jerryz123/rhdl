#lang rhdl
// Defines the validated AMBA CHI physical flit parameterization.

class CHIFlitParams(node_id_width,
                    request_address_width,
                    data_width,
                    mpam_width,
                    req_rsvdc_width,
                    dat_rsvdc_width,
                    data_check,
                    poison,
                    pbha_width,
                    mecid_width,
                    stream_id_width,
                    sec_sid_width):
  constructor (~node_id_width: node_id_width = 7,
               ~request_address_width: request_address_width = 44,
               ~data_width: data_width = 128,
               ~mpam_width: mpam_width = 0,
               ~req_rsvdc_width: req_rsvdc_width = 0,
               ~dat_rsvdc_width: dat_rsvdc_width = 0,
               ~data_check: data_check = #false,
               ~poison: poison = #false,
               ~pbha_width: pbha_width = 0,
               ~mecid_width: mecid_width = 0,
               ~stream_id_width: stream_id_width = 0,
               ~sec_sid_width: sec_sid_width = 0):
    unless node_id_width is_a Int && node_id_width >= 7 && node_id_width <= 16
    | error(~who: #'CHIFlitParams,
            "NodeID width must be a host Int from 7 through 16")
    unless request_address_width is_a Int && request_address_width >= 44 && request_address_width <= 52
    | error(~who: #'CHIFlitParams,
            "request address width must be a host Int from 44 through 52")
    unless data_width is_a Int && [128, 256, 512].contains(data_width)
    | error(~who: #'CHIFlitParams,
            "data width must be 128, 256, or 512")
    unless mpam_width is_a Int && [0, 12, 15].contains(mpam_width)
    | error(~who: #'CHIFlitParams,
            "MPAM width must be 0, 12, or 15")
    def legal_rsvdc_widths = [0, 4, 8, 12, 16, 24, 32]
    unless req_rsvdc_width is_a Int && legal_rsvdc_widths.contains(req_rsvdc_width)
    | error(~who: #'CHIFlitParams,
            "REQ RSVDC width must be 0, 4, 8, 12, 16, 24, or 32")
    unless dat_rsvdc_width is_a Int && legal_rsvdc_widths.contains(dat_rsvdc_width)
    | error(~who: #'CHIFlitParams,
            "DAT RSVDC width must be 0, 4, 8, 12, 16, 24, or 32")
    unless data_check is_a Boolean && poison is_a Boolean
    | error(~who: #'CHIFlitParams,
            "data-check and poison selections must be host Boolean values")
    unless pbha_width is_a Int && [0, 4].contains(pbha_width)
    | error(~who: #'CHIFlitParams,
            "PBHA width must be 0 or 4")
    unless mecid_width is_a Int && [0, 16].contains(mecid_width)
    | error(~who: #'CHIFlitParams,
            "MECID width must be 0 or 16")
    unless stream_id_width is_a Int && [0, 16].contains(stream_id_width)
    | error(~who: #'CHIFlitParams,
            "StreamID width must be 0 or 16")
    unless sec_sid_width is_a Int && [0, 1].contains(sec_sid_width)
    | error(~who: #'CHIFlitParams,
            "SecSID width must be 0 or 1")
    unless (stream_id_width == 16 && sec_sid_width == 1) || (stream_id_width == 0 && sec_sid_width == 0)
    | error(~who: #'CHIFlitParams,
            "StreamID and SecSID1 must be present together")
    super(node_id_width,
          request_address_width,
          data_width,
          mpam_width,
          req_rsvdc_width,
          dat_rsvdc_width,
          data_check,
          poison,
          pbha_width,
          mecid_width,
          stream_id_width,
          sec_sid_width)

  property data_bytes: data_width / 8
  property byte_enable_width: data_width / 8
  property tag_width: data_width / 32
  property tag_update_width: data_width / 128
  property data_check_width: if data_check | data_width / 8 | 0
  property poison_width: if poison | data_width / 64 | 0
  property snoop_address_width: request_address_width - 3
  property request_security_width:
    if mecid_width > stream_id_width | mecid_width | stream_id_width

export:
  CHIFlitParams
