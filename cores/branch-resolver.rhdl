#lang rhdl
// Resolves conditional and unconditional control transfers from orthogonal controls.

bundle BranchResolverControl():
  enable: Bool
  unconditional: Bool
  compare_equal: Bool
  signed_mode: Bool
  invert: Bool

circuit BranchResolver(width :: Int):
  unless width > 0
  | error(~who: #'BranchResolver, "branch operands must have positive width")

  input(left, right): Bits(width)
  input control: BranchResolverControl()
  output taken: Bool

  def equal = left === right
  def unsigned_less = left < right
  def left_sign = left[width - 1].into(Bool)
  def right_sign = right[width - 1].into(Bool)
  def signed_less = mux(
    left_sign ^ right_sign,
    left_sign,
    unsigned_less
  )
  def less = mux(control.signed_mode, signed_less, unsigned_less)
  def comparison = mux(control.compare_equal, equal, less)
  def condition = mux(
    control.unconditional,
    Bool(#true),
    comparison ^ control.invert
  )
  taken <== control.enable and condition

export:
  BranchResolverControl
  BranchResolver
