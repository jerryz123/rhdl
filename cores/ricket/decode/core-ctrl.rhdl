#lang rhdl
// Composes Ricket's integer, M, CSR, and privileged controls into one decoder.

import:
  "../../alu.rhdl" open
  "decode-support.rhdl" open
  "alu-ctrl.rhdl" open
  "operand-ctrl.rhdl" open
  "branch-ctrl.rhdl" open
  "mem-ctrl.rhdl" open
  "multiply-ctrl.rhdl" open
  "divide-ctrl.rhdl" open
  "writeback-ctrl.rhdl" open
  "system-ctrl.rhdl" open
  "fence-ctrl.rhdl" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  "../../../riscv/rhdl/instruction-pattern.rhdl" open
  lib("rhdl/std/decode.rhdl") open

bundle RicketControl():
  alu: AluControl()
  operand: OperandControl()
  branch: BranchControl()
  memory: MemoryControl()
  multiply: RicketMultiplyControl()
  divide: RicketDivideControl()
  writeback: WritebackControl()
  system: SystemControl()
  fence: FenceControl()

// Ordinary host code adds independently authored control columns to one row
// per instruction. The selected ISA still elaborates to one decode table.
fun compose_control_cases(instructions, alu_cases, operand_cases, branch_cases,
                          memory_cases, multiply_cases, divide_cases, writeback_cases, system_cases, fence_cases):
  for List (instruction in instructions):
    block:
      def input = instruction_pattern(instruction)
      DecodeCase(
        input,
        pattern(RicketControl()):
          alu: component_output(alu_cases, input)
          operand: component_output(operand_cases, input)
          branch: component_output(branch_cases, input)
          memory: component_output(memory_cases, input)
          multiply: component_output(multiply_cases, input)
          divide: component_output(divide_cases, input)
          writeback: component_output(writeback_cases, input)
          system: component_output(system_cases, input)
          fence: component_output(fence_cases, input)
      )

def RV32IControlCases = compose_control_cases(
  rv32.RV32IInstructions,
  RV32ICompleteAluCases,
  RV32IOperandCases,
  RV32IBranchCases,
  RV32IMemoryCases,
  RV32RicketMultiplyCases,
  RV32RicketDivideCases,
  RV32IWritebackCases,
  RV32ISystemCases,
  RV32IFenceCases
)
def RV64IControlCases = compose_control_cases(
  RV64IInstructions,
  RV64ICompleteAluCases,
  RV64IOperandCases,
  RV64IBranchCases,
  RV64IMemoryCases,
  RV64RicketMultiplyCases,
  RV64RicketDivideCases,
  RV64IWritebackCases,
  RV64ISystemCases,
  RV64IFenceCases
)
def RV32RicketInstructions = rv32.RV32IInstructions ++ RV32MInstructions ++ (
  ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions
)
def RV64RicketInstructions = RV64IInstructions ++ RV64MInstructions ++ (
  ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions
)
def RV32RicketControlCases = compose_control_cases(
  RV32RicketInstructions,
  RV32RicketAluCases,
  RV32RicketOperandCases,
  RV32RicketBranchCases,
  RV32RicketMemoryCases,
  RV32RicketMultiplyCases,
  RV32RicketDivideCases,
  RV32RicketWritebackCases,
  RV32RicketSystemCases,
  RV32RicketFenceCases
)
def RV64RicketControlCases = compose_control_cases(
  RV64RicketInstructions,
  RV64RicketAluCases,
  RV64RicketOperandCases,
  RV64RicketBranchCases,
  RV64RicketMemoryCases,
  RV64RicketMultiplyCases,
  RV64RicketDivideCases,
  RV64RicketWritebackCases,
  RV64RicketSystemCases,
  RV64RicketFenceCases
)
def RV32IControlDecode = ValidDecodeGen(RV32IControlCases)
def RV64IControlDecode = ValidDecodeGen(RV64IControlCases)
def RV32RicketControlDecode = ValidDecodeGen(RV32RicketControlCases)
def RV64RicketControlDecode = ValidDecodeGen(RV64RicketControlCases)

circuit RicketInstructionDecoder(xlen :: XLen):
  input instruction: Bits(32)
  output valid: Bool
  output control: RicketControl()

  def decoded :: DecodeResult(RicketControl()) = if xlen == XLen.X32 | RV32RicketControlDecode(instruction) | RV64RicketControlDecode(instruction)
  valid <== decoded.valid
  control <== decoded.value

export:
  RicketControl
  compose_control_cases
  RV32IControlCases
  RV64IControlCases
  RV32IControlDecode
  RV64IControlDecode
  RV32RicketInstructions
  RV64RicketInstructions
  RV32RicketControlCases
  RV64RicketControlCases
  RV32RicketControlDecode
  RV64RicketControlDecode
  RicketInstructionDecoder
