#lang rhdl
// Provides generic case-list helpers shared by Ricket's independent control decoders.

import:
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/rhdl/instruction-pattern.rhdl" open
  lib("rhdl/std/decode.rhdl") open

fun instruction_cases(instructions :: List, output):
  for List (instruction in instructions):
    DecodeCase(instruction_pattern(instruction), output)

fun combine_case_groups(groups :: List):
  def mutable cases = []
  for (group in groups):
    cases := cases ++ group
  cases

fun excluding_instructions(excluded :: List):
  RV64IInstructions.filter(
    ~keep: fun (instruction): !excluded.contains(instruction)
  )

export:
  instruction_cases
  combine_case_groups
  excluding_instructions
