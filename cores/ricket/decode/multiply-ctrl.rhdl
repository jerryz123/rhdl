#lang rhdl
// Defines Ricket's RV32 and RV64 Zmmul multiplier-control relation.

import:
  "../../multiplier.rhdl" open
  "decode-support.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/zmmul.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  "../../../riscv/rhdl/instruction-pattern.rhdl" open
  lib("rhdl/std/decode.rhdl") open

bundle RicketMultiplyControl():
  mode: MultiplierMode()
  high_result: Bool
  word_result: Bool

def signed_signed = pattern(MultiplierMode()):
  left_signed: Bool(#true)
  right_signed: Bool(#true)

def signed_unsigned = pattern(MultiplierMode()):
  left_signed: Bool(#true)
  right_signed: Bool(#false)

def unsigned_unsigned = pattern(MultiplierMode()):
  left_signed: Bool(#false)
  right_signed: Bool(#false)

def RV32ZmmulControlCases = decode_groups(
  RicketMultiplyControl(),
  ~input: instruction_pattern
):
  [MUL]:
    high_result: Bool(#false)
    word_result: Bool(#false)

  [MULH]:
    mode: signed_signed
    high_result: Bool(#true)
    word_result: Bool(#false)

  [MULHSU]:
    mode: signed_unsigned
    high_result: Bool(#true)
    word_result: Bool(#false)

  [MULHU]:
    mode: unsigned_unsigned
    high_result: Bool(#true)
    word_result: Bool(#false)

def RV64ZmmulControlCases = RV32ZmmulControlCases ++ decode_groups(
  RicketMultiplyControl(),
  ~input: instruction_pattern
):
  [MULW]:
    high_result: Bool(#false)
    word_result: Bool(#true)

def unused_multiply = pattern(RicketMultiplyControl(), _)
def RV32RicketMultiplyCases = instruction_cases(
  rv32.RV32IInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions,
  unused_multiply
) ++ RV32ZmmulControlCases
def RV64RicketMultiplyCases = instruction_cases(
  RV64IInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions,
  unused_multiply
) ++ RV64ZmmulControlCases

def RV32ZmmulControlDecode = ValidDecodeGen(RV32ZmmulControlCases)
def RV64ZmmulControlDecode = ValidDecodeGen(RV64ZmmulControlCases)

circuit RicketMultiplyInstructionDecoder(xlen :: XLen):
  input instruction: Bits(32)
  output valid: Bool
  output control: RicketMultiplyControl()

  def decoded :: DecodeResult(RicketMultiplyControl()) = if xlen == XLen.X32 | RV32ZmmulControlDecode(instruction) | RV64ZmmulControlDecode(instruction)
  valid <== decoded.valid
  control <== decoded.value

export:
  RicketMultiplyControl
  RV32ZmmulControlCases
  RV64ZmmulControlCases
  RV32RicketMultiplyCases
  RV64RicketMultiplyCases
  RV32ZmmulControlDecode
  RV64ZmmulControlDecode
  RicketMultiplyInstructionDecoder
