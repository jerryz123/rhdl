#lang rhdl
// Defines base and Zmmul architectural writeback and result-source controls.

import:
  "decode-support.rhdl" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/zmmul.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  lib("rhdl/std/decode.rhdl") open

hardware_enum WritebackSelect:
  Alu
  Memory
  PcPlus4
  Multiply
  Csr

bundle WritebackControl():
  enable: Bool
  source: WritebackSelect

def alu_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Alu
def memory_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Memory
def link_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.PcPlus4
def multiply_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Multiply
def csr_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Csr
def no_writeback = partial_pattern(WritebackControl()):
  enable: Bool(#false)

def shared_immediate_alu = [ADDI, SLTI, SLTIU, XORI, ORI, ANDI]
def shared_register_alu = [ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND]
def shared_loads = [LB, LH, LW, LBU, LHU]
def link_instructions = [JAL, JALR]
fun writeback_cases(instructions, alu_instructions, load_instructions):
  def writing_instructions = alu_instructions ++ load_instructions ++ link_instructions
  combine_case_groups([
    instruction_cases(alu_instructions, alu_writeback),
    instruction_cases(load_instructions, memory_writeback),
    instruction_cases(link_instructions, link_writeback),
    instruction_cases(excluding_instructions(instructions, writing_instructions), no_writeback)
  ])

def RV32IWritebackCases = writeback_cases(
  rv32.RV32IInstructions,
  [LUI, AUIPC] ++ shared_immediate_alu ++ [rv32.SLLI, rv32.SRLI, rv32.SRAI] ++ shared_register_alu,
  shared_loads
)
def RV64IWritebackCases = writeback_cases(
  RV64IInstructions,
  [LUI, AUIPC] ++ shared_immediate_alu ++ [SLLI, SRLI, SRAI, ADDIW, SLLIW, SRLIW, SRAIW] ++ shared_register_alu ++ [ADDW, SUBW, SLLW, SRLW, SRAW],
  shared_loads ++ [LWU, LD]
)
def RicketSystemWritebackCases = instruction_cases(
  ZicsrInstructions,
  csr_writeback
) ++ instruction_cases(PrivilegedInstructions, no_writeback)
def RV32RicketWritebackCases = RV32IWritebackCases ++ instruction_cases(
  RV32ZmmulInstructions,
  multiply_writeback
) ++ RicketSystemWritebackCases
def RV64RicketWritebackCases = RV64IWritebackCases ++ instruction_cases(
  RV64ZmmulInstructions,
  multiply_writeback
) ++ RicketSystemWritebackCases
def RV32IWritebackDecode = ValidDecodeGen(RV32IWritebackCases)
def RV64IWritebackDecode = ValidDecodeGen(RV64IWritebackCases)

export:
  WritebackSelect
  WritebackControl
  RV32IWritebackCases
  RV64IWritebackCases
  RV32RicketWritebackCases
  RV64RicketWritebackCases
  RV32IWritebackDecode
  RV64IWritebackDecode
