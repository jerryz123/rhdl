#lang rhdl
// Defines base synchronous traps and Ricket's no-trap Zmmul cases.

import:
  "decode-support.rhdl" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/zmmul.rhm" open
  lib("rhdl/std/decode.rhdl") open

bundle TrapControl():
  trap: Bool

def trap_instructions = [ECALL, EBREAK]
def trap = pattern(TrapControl()):
  trap: Bool(#true)
def no_trap = pattern(TrapControl()):
  trap: Bool(#false)
fun trap_cases(instructions):
  combine_case_groups([
    instruction_cases(trap_instructions, trap),
    instruction_cases(excluding_instructions(instructions, trap_instructions), no_trap)
  ])

def RV32ITrapCases = trap_cases(rv32.RV32IInstructions)
def RV64ITrapCases = trap_cases(RV64IInstructions)
def RV32RicketTrapCases = RV32ITrapCases ++ instruction_cases(RV32ZmmulInstructions, no_trap)
def RV64RicketTrapCases = RV64ITrapCases ++ instruction_cases(RV64ZmmulInstructions, no_trap)
def RV32ITrapDecode = ValidDecodeGen(RV32ITrapCases)
def RV64ITrapDecode = ValidDecodeGen(RV64ITrapCases)

export:
  TrapControl
  RV32ITrapCases
  RV64ITrapCases
  RV32RicketTrapCases
  RV64RicketTrapCases
  RV32ITrapDecode
  RV64ITrapDecode
