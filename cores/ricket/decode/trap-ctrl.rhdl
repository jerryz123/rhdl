#lang rhdl
// Defines RV64I synchronous trap controls for the initial fault-stop core.

import:
  "decode-support.rhdl" open
  "../../../riscv/isa/rv64i.rhm" open
  lib("rhdl/std/decode.rhdl") open

bundle TrapControl():
  trap: Bool

def trap_instructions = [ECALL, EBREAK]
def RV64ITrapCases = combine_case_groups([
  instruction_cases(
    trap_instructions,
    pattern(TrapControl()): trap: Bool(#true)
  ),
  instruction_cases(
    excluding_instructions(trap_instructions),
    pattern(TrapControl()): trap: Bool(#false)
  )
])

def RV64ITrapDecode = ValidDecodeGen(RV64ITrapCases)

export:
  TrapControl
  RV64ITrapCases
  RV64ITrapDecode
