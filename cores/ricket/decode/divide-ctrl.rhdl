#lang rhdl
// Defines Ricket's RV32 and RV64 integer divide/remainder control relation.

import:
  "decode-support.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../../../riscv/isa/a.rhm" open
  "../../../riscv/isa/zmmul.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  "../../../riscv/rhdl/instruction-pattern.rhdl" open
  lib("rhdl/std/decode.rhdl") open

bundle RicketDivideControl():
  signed_mode: Bool
  remainder: Bool
  word_result: Bool

def RV32MDivideControlCases = decode_groups(
  RicketDivideControl(),
  ~input: instruction_pattern
):
  [DIV]:
    signed_mode: Bool(#true)
    remainder: Bool(#false)
    word_result: Bool(#false)

  [DIVU]:
    signed_mode: Bool(#false)
    remainder: Bool(#false)
    word_result: Bool(#false)

  [REM]:
    signed_mode: Bool(#true)
    remainder: Bool(#true)
    word_result: Bool(#false)

  [REMU]:
    signed_mode: Bool(#false)
    remainder: Bool(#true)
    word_result: Bool(#false)

def RV64MDivideControlCases = RV32MDivideControlCases ++ decode_groups(
  RicketDivideControl(),
  ~input: instruction_pattern
):
  [DIVW]:
    signed_mode: Bool(#true)
    remainder: Bool(#false)
    word_result: Bool(#true)

  [DIVUW]:
    signed_mode: Bool(#false)
    remainder: Bool(#false)
    word_result: Bool(#true)

  [REMW]:
    signed_mode: Bool(#true)
    remainder: Bool(#true)
    word_result: Bool(#true)

  [REMUW]:
    signed_mode: Bool(#false)
    remainder: Bool(#true)
    word_result: Bool(#true)

def unused_divide = pattern(RicketDivideControl(), _)
def RV32RicketDivideCases = instruction_cases(
  rv32.RV32IInstructions ++ RV32ZmmulInstructions ++ RV32AInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions,
  unused_divide
) ++ RV32MDivideControlCases
def RV64RicketDivideCases = instruction_cases(
  RV64IInstructions ++ RV64ZmmulInstructions ++ RV64AInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions,
  unused_divide
) ++ RV64MDivideControlCases

def RV32MDivideControlDecode = ValidDecodeGen(RV32MDivideControlCases)
def RV64MDivideControlDecode = ValidDecodeGen(RV64MDivideControlCases)

circuit RicketDivideInstructionDecoder(xlen :: XLen):
  input instruction: Bits(32)
  output valid: Bool
  output control: RicketDivideControl()

  def decoded :: DecodeResult(RicketDivideControl()) = if xlen == XLen.X32 | RV32MDivideControlDecode(instruction) | RV64MDivideControlDecode(instruction)
  valid <== decoded.valid
  control <== decoded.value

export:
  RicketDivideControl
  RV32MDivideControlCases
  RV64MDivideControlCases
  RV32RicketDivideCases
  RV64RicketDivideCases
  RV32MDivideControlDecode
  RV64MDivideControlDecode
  RicketDivideInstructionDecoder
