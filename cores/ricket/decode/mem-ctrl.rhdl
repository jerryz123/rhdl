#lang rhdl
// Defines RV64I load/store operation, width, and extension controls.

import:
  "decode-support.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/rv64i.rhm" open
  lib("rhdl/std/decode.rhdl") open

hardware_enum MemoryOperation:
  None
  Read
  Write

bundle MemoryControl():
  access: MemoryOperation
  width: MemoryWidth
  unsigned: Bool

def load_instructions = [LB, LH, LW, LBU, LHU, LWU, LD]
def store_instructions = [SB, SH, SW, SD]
def memory_instructions = load_instructions ++ store_instructions
def RV64IMemoryCases = decode_groups(
  MemoryControl(),
  ~input: instruction_pattern
):
  [LB]:
    access: MemoryOperation.Read
    width: MemoryWidth.Byte
    unsigned: Bool(#false)

  [LBU]:
    access: MemoryOperation.Read
    width: MemoryWidth.Byte
    unsigned: Bool(#true)

  [LH]:
    access: MemoryOperation.Read
    width: MemoryWidth.Half
    unsigned: Bool(#false)

  [LHU]:
    access: MemoryOperation.Read
    width: MemoryWidth.Half
    unsigned: Bool(#true)

  [LW]:
    access: MemoryOperation.Read
    width: MemoryWidth.Word
    unsigned: Bool(#false)

  [LWU]:
    access: MemoryOperation.Read
    width: MemoryWidth.Word
    unsigned: Bool(#true)

  [LD]:
    access: MemoryOperation.Read
    width: MemoryWidth.Double
    unsigned: Bool(#false)

  [SB]:
    access: MemoryOperation.Write
    width: MemoryWidth.Byte

  [SH]:
    access: MemoryOperation.Write
    width: MemoryWidth.Half

  [SW]:
    access: MemoryOperation.Write
    width: MemoryWidth.Word

  [SD]:
    access: MemoryOperation.Write
    width: MemoryWidth.Double

  group excluding_instructions(memory_instructions):
    access: MemoryOperation.None

def RV64IMemoryDecode = ValidDecodeGen(RV64IMemoryCases)

export:
  MemoryOperation
  MemoryControl
  RV64IMemoryCases
  RV64IMemoryDecode
