#lang rhdl
// Defines RV64I register use, operand routing, and immediate-selection controls.

import:
  "decode-support.rhdl" open
  "../../../riscv/isa/rv64i.rhm" open
  lib("rhdl/std/decode.rhdl") open

hardware_enum OperandASelect:
  Register
  Pc
  Zero

hardware_enum OperandBSelect:
  Register
  Immediate

hardware_enum ImmediateSelect:
  None
  I
  S
  B
  U
  J

bundle OperandControl():
  uses_rs1: Bool
  uses_rs2: Bool
  left: OperandASelect
  right: OperandBSelect
  immediate: ImmediateSelect

def immediate_alu_instructions = [
  ADDI, SLTI, SLTIU, XORI, ORI, ANDI,
  SLLI, SRLI, SRAI, ADDIW, SLLIW, SRLIW, SRAIW
]
def register_alu_instructions = [
  ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND,
  ADDW, SUBW, SLLW, SRLW, SRAW
]
def load_instructions = [LB, LH, LW, LBU, LHU, LWU, LD]
def store_instructions = [SB, SH, SW, SD]
def branch_instructions = [BEQ, BNE, BLT, BGE, BLTU, BGEU]
def register_immediate_instructions = (
  load_instructions ++ immediate_alu_instructions
)

def RV64IOperandCases = decode_groups(
  OperandControl(),
  ~input: instruction_pattern
):
  [LUI]:
    uses_rs1: Bool(#false)
    uses_rs2: Bool(#false)
    left: OperandASelect.Zero
    right: OperandBSelect.Immediate
    immediate: ImmediateSelect.U

  [AUIPC]:
    uses_rs1: Bool(#false)
    uses_rs2: Bool(#false)
    left: OperandASelect.Pc
    right: OperandBSelect.Immediate
    immediate: ImmediateSelect.U

  [JAL]:
    uses_rs1: Bool(#false)
    uses_rs2: Bool(#false)
    immediate: ImmediateSelect.J

  [JALR]:
    uses_rs1: Bool(#true)
    uses_rs2: Bool(#false)
    immediate: ImmediateSelect.I

  group register_immediate_instructions:
    uses_rs1: Bool(#true)
    uses_rs2: Bool(#false)
    left: OperandASelect.Register
    right: OperandBSelect.Immediate
    immediate: ImmediateSelect.I

  group branch_instructions:
    uses_rs1: Bool(#true)
    uses_rs2: Bool(#true)
    immediate: ImmediateSelect.B

  group store_instructions:
    uses_rs1: Bool(#true)
    uses_rs2: Bool(#true)
    left: OperandASelect.Register
    right: OperandBSelect.Immediate
    immediate: ImmediateSelect.S

  group register_alu_instructions:
    uses_rs1: Bool(#true)
    uses_rs2: Bool(#true)
    left: OperandASelect.Register
    right: OperandBSelect.Register

  [FENCE, ECALL, EBREAK]:
    uses_rs1: Bool(#false)
    uses_rs2: Bool(#false)

def RV64IOperandDecode = ValidDecodeGen(RV64IOperandCases)

export:
  OperandASelect
  OperandBSelect
  ImmediateSelect
  OperandControl
  RV64IOperandCases
  RV64IOperandDecode
