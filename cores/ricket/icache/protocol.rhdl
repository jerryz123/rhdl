#lang rhdl
// Defines Ricket's ordered core-facing instruction-cache access protocol.

import:
  "../../../riscv/isa/xlen.rhm" open
  lib("rhdl/std/ready-valid.rhdl") open

bundle RicketInstructionReq(xlen :: XLen):
  address: Bits(xlen_width(xlen))

bundle RicketInstructionResp():
  instruction: Bits(32)

interface RicketInstructionAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    flush: Bool
    request: Decoupled(RicketInstructionReq(xlen))

  responder -> requester:
    response: Irrevocable(RicketInstructionResp())

export:
  RicketInstructionReq
  RicketInstructionResp
  RicketInstructionAccess
