#lang rhdl
// Defines Ricket's ordered core-facing instruction-cache access protocol.

import:
  lib("rhdl/std/ready-valid.rhdl") open

bundle RicketInstructionReq(address_width :: Int):
  address: Bits(address_width)

bundle RicketInstructionResp():
  instruction: Bits(32)

interface RicketInstructionAccess(address_width :: Int):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Irrevocable(RicketInstructionReq(address_width))

  responder -> requester:
    response: Irrevocable(RicketInstructionResp())

export:
  RicketInstructionReq
  RicketInstructionResp
  RicketInstructionAccess
