#lang rhdl
// Implements Ricket's blocking direct-mapped read-only instruction cache.

import:
  "protocol.rhdl" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/simple-memory.rhdl") open

hardware_enum RicketL1IState:
  Idle
  Lookup
  Refill
  Respond

fun check_l1i_geometry(address_width :: Int,
                       sets :: Int,
                       line_bytes :: Int):
  unless sets >= 2 && power_of_two(sets)
  | error(~who: #'RicketL1ICache,
          "set count must be a power of two of at least two")
  unless line_bytes >= 8 && power_of_two(line_bytes)
  | error(~who: #'RicketL1ICache,
          "line byte count must be a power of two of at least eight")
  unless address_width > (alignment_bits(line_bytes) + alignment_bits(sets))
  | error(~who: #'RicketL1ICache,
          "address width must include line offset, set, and tag bits")

sync_circuit RicketL1ICache(address_width :: Int,
                            sets :: Int,
                            line_bytes :: Int):
  check_l1i_geometry(address_width, sets, line_bytes)
  def beats = line_bytes / 8
  def line_bits = line_bytes * 8
  def offset_width = alignment_bits(line_bytes)
  def set_width = alignment_bits(sets)
  def tag_width = address_width - offset_width - set_width
  def beat_width = index_width(beats)
  def count_width = index_width(beats + 1)
  def Line = Vec(beats, Bits(64))

  interface core(RicketInstructionAccess(address_width), ~role: responder)
  interface memory(SimpleMemory(address_width, 8), ~role: requester)

  sync_mem tags(sets, Bits(tag_width)):
    read_write
  sync_mem lines(sets, Line):
    read_write

  reg state(~init: RicketL1IState.Idle)
  reg valid_bits(~init: bits(0, sets))
  reg request_address(~init: bits(0, address_width))
  reg request_set(~init: bits(0, set_width))
  reg request_tag(~init: bits(0, tag_width))
  reg request_beat(~init: bits(0, beat_width))
  reg refill_requested(~init: bits(0, count_width))
  reg refill_received(~init: bits(0, count_width))
  reg refill_line(~init: cast(bits(0, line_bits), Line))
  reg response_instruction(~init: bits(0, 32))

  core.request.ready <== state === RicketL1IState.Idle
  core.response.valid <== state === RicketL1IState.Respond
  core.response.bits.instruction <== response_instruction
  memory.response.ready <== state === RicketL1IState.Refill

  def request_fire = fire(core.request)
  def response_fire = fire(core.response)
  def refill_response_fire = fire(memory.response)
  def request_set_value = core.request.bits.address[
    offset_width..(offset_width + set_width)
  ]
  def request_tag_value = core.request.bits.address[
    (offset_width + set_width)..address_width
  ]
  def request_beat_value = core.request.bits.address[3..offset_width]
  def valid_vector = valid_bits.into(Vec(sets, Bool))
  def line_hit = valid_vector.lookup(
    request_set,
    ~default: Bool(#false)
  ) & (tags.read_write.read_data === request_tag)
  def cached_beat = lines.read_write.read_data.lookup(
    request_beat,
    ~default: bits(0, 64)
  )
  def hit_instruction = mux(
    cast(request_address[2], Bool),
    cached_beat[32..64],
    cached_beat[0..32]
  )
  def refill_index = refill_received[0..beat_width]
  def line_with_response = refill_line.updated(
    refill_index,
    memory.response.bits.data
  )
  def refilled_beat = line_with_response.lookup(
    request_beat,
    ~default: bits(0, 64)
  )
  def refill_instruction = mux(
    cast(request_address[2], Bool),
    refilled_beat[32..64],
    refilled_beat[0..32]
  )
  def last_refill_response = refill_received === bits(beats - 1, count_width)
  def install = (state === RicketL1IState.Refill) & (
    refill_response_fire
  ) & last_refill_response

  def line_base = align_down(request_address, line_bytes)
  def refill_byte_offset = zext(refill_requested, address_width) << (
    bits(3, address_width)
  )
  memory.request.valid <== (state === RicketL1IState.Refill) & (
    refill_requested < bits(beats, count_width)
  )
  memory.request.bits <== SimpleMemoryReq(address_width, 8):
    address: line_base + refill_byte_offset
    write: Bool(#false)
    data: bits(0, 64)
    mask: !bits(0, 8)
  tags.read_write.address <== mux(install, request_set, request_set_value)
  tags.read_write.enable <== (request_fire ||| install).into(Bits(1))
  tags.read_write.write <== install.into(Bits(1))
  tags.read_write.write_data <== request_tag
  lines.read_write.address <== mux(install, request_set, request_set_value)
  lines.read_write.enable <== (request_fire ||| install).into(Bits(1))
  lines.read_write.write <== install.into(Bits(1))
  lines.read_write.write_data <== line_with_response

  when request_fire:
    request_address <== core.request.bits.address
    request_set <== request_set_value
    request_tag <== request_tag_value
    request_beat <== request_beat_value
    state <== RicketL1IState.Lookup
  elsewhen (state === RicketL1IState.Lookup):
    when line_hit:
      response_instruction <== hit_instruction
      state <== RicketL1IState.Respond
    otherwise:
      refill_requested <== bits(0, count_width)
      refill_received <== bits(0, count_width)
      refill_line <== cast(bits(0, line_bits), Line)
      state <== RicketL1IState.Refill
  elsewhen (state === RicketL1IState.Refill):
    when (fire(memory.request)):
      refill_requested <== refill_requested + bits(1, count_width)
    when refill_response_fire:
      refill_line <== line_with_response
      refill_received <== refill_received + bits(1, count_width)
      when last_refill_response:
        valid_bits <== valid_vector.updated(
          request_set,
          Bool(#true)
        ).into(Bits(sets))
        response_instruction <== refill_instruction
        state <== RicketL1IState.Respond
  elsewhen response_fire:
    state <== RicketL1IState.Idle

export:
  RicketL1ICache
