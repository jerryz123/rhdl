#lang rhdl
// Defines Ricket's ordered core-facing data-cache access protocol.

import:
  "../../load-store.rhdl" open
  lib("rhdl/std/ready-valid.rhdl") open

bundle RicketDataReq(address_width :: Int):
  address: Bits(address_width)
  write: Bool
  width: MemoryWidth
  unsigned: Bool
  data: Bits(64)

bundle RicketDataResp():
  data: Bits(64)

interface RicketDataAccess(address_width :: Int):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Irrevocable(RicketDataReq(address_width))

  responder -> requester:
    response: Irrevocable(RicketDataResp())

export:
  RicketDataReq
  RicketDataResp
  RicketDataAccess
