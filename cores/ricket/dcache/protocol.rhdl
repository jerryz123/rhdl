#lang rhdl
// Defines Ricket's ordered core-facing data-cache access protocol.

import:
  "../../load-store.rhdl" open
  lib("rhdl/std/ready-valid.rhdl") open

bundle RicketDataReq(xlen :: Int, address_width :: Int):
  address: Bits(address_width)
  write: Bool
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen)
  tag: Bits(5)

bundle RicketDataResp(xlen :: Int):
  data: Bits(xlen)
  tag: Bits(5)

interface RicketDataAccess(xlen :: Int, address_width :: Int):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Irrevocable(RicketDataReq(xlen, address_width))

  responder -> requester:
    response: Irrevocable(RicketDataResp(xlen))

export:
  RicketDataReq
  RicketDataResp
  RicketDataAccess
