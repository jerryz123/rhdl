#lang rhdl
// Defines Ricket's ordered core-facing data-cache access protocol.

import:
  "../memory.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../load-store.rhdl" open
  lib("rhdl/std/ready-valid.rhdl") open

bundle RicketDataReq(xlen :: XLen):
  address: Bits(xlen_width(xlen))
  access: MemoryOperation
  atomic: RicketAtomicOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen_width(xlen))
  tag: Bits(5)

bundle RicketDataResp(xlen :: XLen):
  data: Bits(xlen_width(xlen))
  tag: Bits(5)

interface RicketDataAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(RicketDataReq(xlen))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Valid(RicketDataResp(xlen))
    drained: Bool

export:
  RicketDataReq
  RicketDataResp
  RicketDataAccess
