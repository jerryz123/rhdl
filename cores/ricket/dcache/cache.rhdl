#lang rhdl
// Implements Ricket's pipelined-hit write-through direct-mapped data cache.

import:
  "protocol.rhdl" open
  "../chi.rhdl" open
  "../refill.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/read-write.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/sync-ram.rhdl") open
  lib("rhdl/std/flow.rhdl") open
  lib("chi/main.rhdl") open

fun check_l1d_geometry(width :: PosInt, sets :: Pow2Int, line_bytes :: Pow2Int):
  unless sets >= 2
  | error(~who: #'RicketL1DCache,
          "set count must be a power of two of at least two")
  unless line_bytes >= 8
  | error(~who: #'RicketL1DCache,
          "line byte count must be a power of two of at least eight")
  unless width > (alignment_bits(line_bytes) + alignment_bits(sets))
  | error(~who: #'RicketL1DCache,
          "address width must include line offset, set, and tag bits")

sync_circuit RicketL1DCache(xlen :: XLen,
                            sets :: Pow2Int,
                            line_bytes :: Pow2Int,
                            ~chi: params :: RicketCHIParams = default_ricket_chi_params):
  def width = xlen_width(xlen)
  def checked = checked_ricket_chi_params(params)
  def p = checked.flit
  def node = checked.data_node
  check_l1d_geometry(width, sets, line_bytes)
  def beats = line_bytes / 8
  def offset_width = alignment_bits(line_bytes)
  def set_width = alignment_bits(sets)
  def tag_width = width - offset_width - set_width
  def beat_width = index_width(beats)

  interface core(RicketDataAccess(xlen), ~role: responder)
  interface chi(CHIRNDecoupled(p), ~role: node)

  inst tags(SyncRam1RW(sets, Bits(tag_width), 1))
  inst lines(SyncRam1RW(sets, Bits(8), line_bytes))
  inst load_gen(LoadGen(xlen))
  inst store_gen(StoreGen(xlen))
  inst refill(RicketLineRefill(RicketDataReq(xlen), width, line_bytes, checked, node.node_id))
  // Hits and stores leave the lookup stage directly; a miss transfers its
  // complete request context into the refill engine.
  inst lookup(Pipe(RicketDataReq(xlen), 1))
  // This mandatory register after the SRAM lookup aligns a hit issued from EX
  // with the instruction's WB stage. Responses cannot be backpressured.
  inst responses(ValidPipe(RicketDataResp(xlen), 1))
  inst protocol_requests(Arbiter(CHIReqFlit(p), 2))
  inst protocol_responses(Arbiter(CHIRspFlit(p), 2))

  reg valid_lines(~init: as_vec(bits(0, sets), Bool))
  reg store_active(~init: Bool(#false))
  reg store_request_sent(~init: Bool(#false))
  reg store_dbid_received(~init: Bool(#false))
  reg store_data_sent(~init: Bool(#false))
  reg store_address(~init: bits(0, width))
  reg store_width(~init: MemoryWidth.Byte)
  reg store_data(~init: bits(0, 64))
  reg store_mask(~init: bits(0, 8))
  reg store_home_id(~init: bits(0, p.node_id_width))
  reg store_dbid(~init: bits(0, 12))

  core.response.valid <== responses.egress.valid
  core.response.bits <== responses.egress.bits

  def outgoing_requests = chi.requests
  def outgoing_responses = chi.requester_responses
  def outgoing_data = chi.request_data
  def incoming_responses = chi.responses
  def incoming_data = chi.response_data
  def incoming_snoops = chi.snoops
  refill.requests |> protocol_requests.ingress[0]
  protocol_requests.egress |> outgoing_requests
  incoming_data |> refill.response_data
  refill.acknowledgements |> protocol_responses.ingress[0]
  protocol_responses.egress |> outgoing_responses
  def request_set_value = core.request.bits.address[offset_width..(offset_width + set_width)]
  def lookup_request = lookup.egress.bits
  def lookup_set = lookup_request.address[offset_width..(offset_width + set_width)]
  def lookup_tag = lookup_request.address[(offset_width + set_width)..width]
  def lookup_beat:
    if beats == 1
    | bits(0, beat_width)
    | lookup_request.address[3..offset_width]
  def line_hit = valid_lines[lookup_set] & (tags.port.response.bits[0] === lookup_tag)
  def lookup_store = lookup.egress.valid & tags.port.response.valid & lookup_request.write
  def lookup_load = lookup.egress.valid & tags.port.response.valid & !lookup_request.write
  def lookup_miss = lookup_load & !line_hit
  def cached_line = as_vec(lines.port.response.bits, Bits(64))
  def cached_beat:
    if beats == 1
    | cached_line[0]
    | cached_line[lookup_beat]

  def refill_commands = (
    lookup.egress |> filter_flow(request => lookup_miss)
      |> map_flow(request => RicketLineRefillCommand(RicketDataReq(xlen), width)):
      line_address: align_down(as_bits(request.address), line_bytes)
      context: request
  )
  refill_commands |> refill.command
  assert(!lookup_miss ||| refill.command.ready, "l1d_refill_command_accepted")

  refill.completion.ready <== Bool(#true)
  def install_refill = fire(refill.completion)
  when install_refill:
    assert(refill.completion.bits.state =/= CHIResponseState.Invalid,
           "l1d_refill_state_valid")
    assert(!refill.completion.bits.pass_dirty,
           "l1d_refill_not_dirty")
  def completion_request = cast(refill.completion.bits.context, RicketDataReq(xlen))
  def completion_set = completion_request.address[offset_width..(offset_width + set_width)]
  def completion_tag = completion_request.address[(offset_width + set_width)..width]
  def completion_beat:
    if beats == 1
    | bits(0, beat_width)
    | completion_request.address[3..offset_width]
  def load_address = mux(install_refill, completion_request.address, lookup_request.address)
  def load_width = mux(install_refill, completion_request.width, lookup_request.width)
  def load_unsigned = mux(install_refill, completion_request.unsigned, lookup_request.unsigned)
  def refilled_beat:
    if beats == 1
    | refill.completion.bits.line[0]
    | refill.completion.bits.line[completion_beat]
  load_gen.address <== load_address
  load_gen.data <== mux(install_refill, refilled_beat, cached_beat)
  load_gen.width <== load_width
  load_gen.unsigned_load <== load_unsigned
  store_gen.address <== lookup_request.address
  store_gen.value <== lookup_request.data
  store_gen.width <== lookup_request.width

  def cache_write = install_refill
  def cache_write_set = completion_set
  assert(refill.command.ready ||| !store_active, "l1d_backing_owner_exclusive")

  // Loads can follow hit lookups every cycle. A miss blocks until refill, and
  // a store blocks only the cache-request stream while its one-entry backing
  // write buffer drains; the store completion enters the response register at
  // lookup and reaches the pipeline in WB.
  def snoop = incoming_snoops.bits
  def ordinary_snoop = snoop.opcode =/= CHISnpOpcode.SnpLCrdReturn
  def snoop_pending = incoming_snoops.valid & ordinary_snoop
  def snoop_can_respond = refill.command.ready & !store_active & !lookup.egress.valid
  incoming_snoops.ready <== !ordinary_snoop ||| (
    snoop_can_respond & protocol_responses.ingress[1].ready
  )
  protocol_responses.ingress[1].valid <== snoop_pending & snoop_can_respond
  protocol_responses.ingress[1].bits <== ricket_chi_response(
    p,
    node.node_id,
    snoop.src_id,
    snoop.txn_id,
    CHIRspOpcode.SnpResp
  )
  def snoop_fire = fire(incoming_snoops) & ordinary_snoop

  def lookup_accepts_input = refill.command.ready & !store_active & !snoop_pending & !lookup_miss & !lookup_store
  core.request.ready <== lookup.ingress.ready & lookup_accepts_input
  lookup.ingress.valid <== core.request.valid & lookup_accepts_input
  lookup.ingress.bits <== core.request.bits
  def request_fire = fire(core.request)
  // A fence observes accepted lookup work, active refills, and the backing
  // store buffer. Same-cycle acceptance is included so no request can cross
  // the reported quiescent boundary.
  core.drained <== !request_fire & !lookup.egress.valid & refill.command.ready & !store_active

  protocol_requests.ingress[1].valid <== store_active & !store_request_sent
  protocol_requests.ingress[1].bits <== ricket_chi_request(
    p,
    node.node_id,
    checked.home_node_id,
    store_address,
    as_bits(store_width),
    CHIReqOpcode.WriteUniquePtl,
    bits(1, 12),
    Bool(#false)
  )
  def store_request_fire = fire(protocol_requests.ingress[1])

  def incoming_response = incoming_responses.bits
  def response_ordinary = incoming_response.opcode =/= CHIRspOpcode.RespLCrdReturn
  def response_dbid = incoming_response.opcode === CHIRspOpcode.DBIDResp
  def response_completion = incoming_response.opcode === CHIRspOpcode.Comp
  def response_expected = store_active & (
    (response_dbid & store_request_sent & !store_dbid_received) ||| (
      response_completion & store_data_sent
    )
  )
  incoming_responses.ready <== !response_ordinary ||| response_expected
  def response_fire = fire(incoming_responses) & response_ordinary
  def dbid_fire = response_fire & response_dbid
  def store_completion_fire = response_fire & response_completion
  when (incoming_responses.valid & response_ordinary):
    assert(response_expected, "l1d_chi_response_expected")
    assert(incoming_response.txn_id === bits(1, 12),
           "l1d_chi_response_txn_id")
    assert(incoming_response.src_id === bits(checked.home_node_id, p.node_id_width),
           "l1d_chi_response_home")
    assert(incoming_response.resp_err === CHIRespErr.OK,
           "l1d_chi_response_ok")

  def data_lane = store_address[3..alignment_bits(p.data_bytes)]
  def store_bus_data = zext(store_data, p.data_width) << concat(data_lane, bits(0, 6))
  def store_bus_mask = zext(store_mask, p.data_bytes) << concat(data_lane, bits(0, 3))
  outgoing_data.valid <== store_active & store_dbid_received & !store_data_sent
  outgoing_data.bits <== ricket_chi_write_data(
    p,
    node.node_id,
    store_home_id,
    store_dbid,
    store_bus_data,
    store_bus_mask
  )
  def store_data_fire = fire(outgoing_data)
  def produces_load_hit = lookup_load & line_hit
  def produces_response = produces_load_hit ||| lookup_store ||| install_refill
  responses.ingress.valid <== produces_response
  responses.ingress.bits <== RicketDataResp(xlen):
    data: mux(produces_load_hit ||| install_refill, load_gen.value, bits(0, width))
    tag: mux(install_refill, completion_request.tag, lookup_request.tag)

  tags.port.request.valid <== request_fire ||| install_refill
  tags.port.request.bits <== ReadWriteRequest(set_width, Bits(tag_width), 1):
    address: mux(cache_write, cache_write_set, request_set_value)
    write: install_refill
    data: vec(mux(install_refill, completion_tag, lookup_tag))
    mask: bits(1, 1)
  lines.port.request.valid <== request_fire ||| cache_write
  lines.port.request.bits <== ReadWriteRequest(set_width, Bits(8), line_bytes):
    address: mux(cache_write, cache_write_set, request_set_value)
    write: cache_write
    data: as_vec(refill.completion.bits.line, Bits(8))
    mask: !bits(0, line_bytes)

  when snoop_fire:
    valid_lines <== as_vec(bits(0, sets), Bool)
  elsewhen lookup_store:
    valid_lines <== valid_lines.updated(lookup_set, Bool(#false))
  elsewhen install_refill:
    valid_lines <== valid_lines.updated(completion_set, Bool(#true))

  when lookup_store:
    assert(ricket_chi_address_fits(lookup_request.address, p),
           "l1d_store_address_fits_chi")
    store_address <== lookup_request.address
    store_width <== lookup_request.width
    store_data <== store_gen.data
    store_mask <== store_gen.mask
    store_active <== Bool(#true)
    store_request_sent <== Bool(#false)
    store_dbid_received <== Bool(#false)
    store_data_sent <== Bool(#false)
  elsewhen store_request_fire:
    store_request_sent <== Bool(#true)
  elsewhen dbid_fire:
    store_dbid_received <== Bool(#true)
    store_home_id <== incoming_response.src_id
    store_dbid <== incoming_response.dbid_or_group_id
  elsewhen store_data_fire:
    store_data_sent <== Bool(#true)
  elsewhen store_completion_fire:
    store_active <== Bool(#false)
    store_request_sent <== Bool(#false)
    store_dbid_received <== Bool(#false)
    store_data_sent <== Bool(#false)

export:
  RicketL1DCache
