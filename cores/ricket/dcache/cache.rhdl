#lang rhdl
// Implements Ricket's pipelined-hit write-through direct-mapped data cache.

import:
  "protocol.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/read-write.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/simple-memory.rhdl") open
  lib("rhdl/std/sync-ram.rhdl") open
  lib("rhdl/std/flow/pipe.rhdl") open

fun check_l1d_geometry(address_width :: PosInt, sets :: Pow2Int, line_bytes :: Pow2Int):
  unless sets >= 2
  | error(~who: #'RicketL1DCache,
          "set count must be a power of two of at least two")
  unless line_bytes >= 8
  | error(~who: #'RicketL1DCache,
          "line byte count must be a power of two of at least eight")
  unless address_width > (alignment_bits(line_bytes) + alignment_bits(sets))
  | error(~who: #'RicketL1DCache,
          "address width must include line offset, set, and tag bits")

sync_circuit RicketL1DCache(xlen :: XLen, address_width :: PosInt, sets :: Pow2Int, line_bytes :: Pow2Int):
  def width = xlen_width(xlen)
  unless address_width <= width
  | error(~who: #'RicketL1DCache, "address width must not exceed integer width")
  check_l1d_geometry(address_width, sets, line_bytes)
  def beats = line_bytes / 8
  def line_bits = line_bytes * 8
  def offset_width = alignment_bits(line_bytes)
  def set_width = alignment_bits(sets)
  def tag_width = address_width - offset_width - set_width
  def beat_width = index_width(beats)
  def count_width = index_width(beats + 1)
  def Line = Vec(beats, Bits(64))
  def ByteLine = Vec(line_bytes, Bits(8))

  interface core(RicketDataAccess(xlen, address_width), ~role: responder)
  interface memory(SimpleMemory(address_width, 8), ~role: requester)

  inst tags(SyncRam1RW(sets, Bits(tag_width), 1))
  inst lines(SyncRam1RW(sets, Bits(8), line_bytes))
  inst load_gen(LoadGen(xlen))
  inst store_gen(StoreGen(xlen))
  // The lookup token advances with consecutive hits and remains stable while
  // a miss owns the refill path.
  inst lookup(Pipe(RicketDataReq(xlen, address_width), 1))
  // This mandatory register after the SRAM lookup aligns a hit issued from EX
  // with the instruction's WB stage. Responses cannot be backpressured.
  inst responses(ValidPipe(RicketDataResp(xlen), 1))

  reg valid_bits(~init: bits(0, sets))
  reg refilling(~init: Bool(#false))
  reg refill_requested(~init: bits(0, count_width))
  reg refill_received(~init: bits(0, count_width))
  reg refill_line(~init: cast(bits(0, line_bits), Line))
  reg store_active(~init: Bool(#false))
  reg store_sent(~init: Bool(#false))
  reg store_address(~init: bits(0, address_width))
  reg store_data(~init: bits(0, 64))
  reg store_mask(~init: bits(0, 8))

  core.response.valid <== responses.egress.valid
  core.response.bits <== responses.egress.bits
  memory.response.ready <== refilling ||| (store_active & store_sent)

  def request_set_value = core.request.bits.address[offset_width..(offset_width + set_width)]
  def lookup_request = lookup.egress.bits
  def lookup_set = lookup_request.address[offset_width..(offset_width + set_width)]
  def lookup_tag = lookup_request.address[(offset_width + set_width)..address_width]
  def lookup_beat:
    if beats == 1
    | bits(0, beat_width)
    | lookup_request.address[3..offset_width]
  def valid_vector = cast(valid_bits, Vec(sets, Bool))
  def line_hit = valid_vector.lookup(
    lookup_set,
    ~default: Bool(#false)
  ) & (tags.port.response.bits[0] === lookup_tag)
  def lookup_store = lookup.egress.valid & tags.port.response.valid & lookup_request.write
  def lookup_load = lookup.egress.valid & tags.port.response.valid & !lookup_request.write
  def lookup_miss = lookup_load & !line_hit
  def cached_line = cast(lines.port.response.bits, Line)
  def cached_beat = cached_line.lookup(lookup_beat, ~default: bits(0, 64))

  def lookup_address_xlen:
    if address_width == width
    | as_bits(lookup_request.address)
    | zext(lookup_request.address, width)
  load_gen.address <== lookup_address_xlen
  load_gen.data <== mux(
    refilling,
    refill_line.updated(
      refill_received[0..beat_width],
      memory.response.bits.data
    ).lookup(lookup_beat, ~default: bits(0, 64)),
    cached_beat
  )
  load_gen.width <== lookup_request.width
  load_gen.unsigned_load <== lookup_request.unsigned
  store_gen.address <== lookup_address_xlen
  store_gen.value <== lookup_request.data
  store_gen.width <== lookup_request.width

  def refill_index = refill_received[0..beat_width]
  def line_with_response = refill_line.updated(refill_index, memory.response.bits.data)
  def store_line = cached_line.updated(lookup_beat, store_gen.data)
  def last_refill_response = refill_received === bits(beats - 1, count_width)
  def refill_response_fire = refilling & fire(memory.response)
  def install_refill = refill_response_fire & last_refill_response
  def update_store_hit = lookup_store & line_hit
  def cache_write = install_refill ||| update_store_hit
  def store_line_mask:
    if line_bytes == 8
    | store_gen.mask
    | zext(store_gen.mask, line_bytes) << zext(
        concat(lookup_beat, bits(0, 3)),
        line_bytes
      )
  assert(!(refilling & store_active), "l1d_backing_owner_exclusive")

  // A miss holds its lookup context until the installed refill consumes it.
  // Hits and stores release immediately, allowing another request each cycle.
  lookup.egress.ready <== (!refilling & !lookup_miss) ||| install_refill

  // Loads can follow hit lookups every cycle. A miss blocks until refill, and
  // a store blocks only the cache-request stream while its one-entry backing
  // write buffer drains; the store completion enters the response register at
  // lookup and reaches the pipeline in WB.
  def lookup_accepts_input = !refilling & !store_active & !lookup_miss & !lookup_store
  core.request.ready <== lookup.ingress.ready & lookup_accepts_input
  lookup.ingress.valid <== core.request.valid & lookup_accepts_input
  lookup.ingress.bits <== core.request.bits
  def request_fire = fire(core.request)

  def refill_line_base = align_down(as_bits(lookup_request.address), line_bytes)
  def refill_byte_offset = zext(refill_requested, address_width) << 3
  def refill_request_valid = refilling & (refill_requested < bits(beats, count_width))
  def store_request_valid = store_active & !store_sent
  memory.request.valid <== refill_request_valid ||| store_request_valid
  memory.request.bits <== SimpleMemoryReq(address_width, 8):
    address: mux(
      store_request_valid,
      store_address,
      refill_line_base + refill_byte_offset
    )
    write: store_request_valid
    data: mux(store_request_valid, store_data, bits(0, 64))
    mask: mux(store_request_valid, store_mask, !bits(0, 8))
  def produces_load_hit = lookup_load & line_hit
  def produces_response = produces_load_hit ||| lookup_store ||| install_refill
  responses.ingress.valid <== produces_response
  responses.ingress.bits <== RicketDataResp(xlen):
    data: mux(produces_load_hit ||| install_refill, load_gen.value, bits(0, width))
    tag: lookup_request.tag

  tags.port.request.valid <== request_fire ||| install_refill
  tags.port.request.bits <== ReadWriteRequest(set_width, Bits(tag_width), 1):
    address: mux(cache_write, lookup_set, request_set_value)
    write: install_refill
    data: vec(lookup_tag)
    mask: bits(1, 1)
  lines.port.request.valid <== request_fire ||| cache_write
  lines.port.request.bits <== ReadWriteRequest(set_width, Bits(8), line_bytes):
    address: mux(cache_write, lookup_set, request_set_value)
    write: cache_write
    data: cast(mux(install_refill, line_with_response, store_line), ByteLine)
    mask: mux(install_refill, !bits(0, line_bytes), store_line_mask)

  when lookup_miss:
    refilling <== Bool(#true)
    refill_requested <== bits(0, count_width)
    refill_received <== bits(0, count_width)
    refill_line <== cast(bits(0, line_bits), Line)
  elsewhen refilling:
    when (fire(memory.request)):
      refill_requested <== refill_requested + bits(1, count_width)
    when refill_response_fire:
      refill_line <== line_with_response
      refill_received <== refill_received + bits(1, count_width)
      when last_refill_response:
        refilling <== Bool(#false)
        valid_bits <== as_bits(valid_vector.updated(lookup_set, Bool(#true)))

  when lookup_store:
    store_address.next <== align_down(as_bits(lookup_request.address), 8)
    store_data.next <== store_gen.data
    store_mask.next <== store_gen.mask

  when lookup_store:
    store_active.next <== Bool(#true)
    store_sent.next <== Bool(#false)
  elsewhen (store_active & !store_sent & fire(memory.request)):
    store_sent.next <== Bool(#true)
  elsewhen (store_active & store_sent & fire(memory.response)):
    store_active.next <== Bool(#false)
    store_sent.next <== Bool(#false)

export:
  RicketL1DCache
