#lang rhombus
// Checks Ricket's extracted write and clean-snoop transaction-engine contracts.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../rhdl/frontend/kernel.rhm" as embedded
  "params.rhdl" as test_params
  "../snoop.rhdl" as snoop
  "../write-unique.rhdl" as write

def config = test_params.test_ricket_chi_config
def write_design = embedded.run_elaboration(fun (): write.RicketWriteUnique(Bits(5), 32, config, 1))
def write_engine = write_design.modules.find(fun (module_def): module_def.name == "RicketWriteUnique")
def snoop_design = embedded.run_elaboration(fun (): snoop.RicketCleanSnoop(32, config))
def snoop_engine = snoop_design.modules.find(fun (module_def): module_def.name == "RicketCleanSnoop")

check:
  write_engine.find_input("command_in").type.field("bits").type.field("address").type.width ~is 32
  write_engine.find_input("command_in").type.field("bits").type.field("context").type.width ~is 5
  write_engine.find_input("command_in").type.field("bits").type.field("data").type.width ~is 64
  write_engine.find_input("command_in").type.field("bits").type.field("mask").type.width ~is 8
  write_engine.find_output("requests_out").type.field("bits").type.field("opcode").type.width ~is 7
  write_engine.find_output("data_out").type.field("bits").type.field("data").type.width ~is 128
  snoop_engine.find_input("snoops_in").type.field("bits").type.field("opcode").type.width ~is 5
  data_width(snoop_engine.find_output("address").type) ~is 32
  snoop_engine.find_output("lookup_out").type.field("bits").type.width ~is 32
  snoop_engine.find_output("update_out").type.field("bits").type.field("address").type.width ~is 32
  verify_design(write_design) ~is #void
  verify_design(snoop_design) ~is #void
  embedded.run_elaboration(
    fun (): write.RicketWriteUnique(Bits(5), 32, config, 4096)
  ) ~throws "twelve bits"
