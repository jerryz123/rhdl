#lang rhombus
// Checks Ricket's HN-I classification and uncached RN-I engine structure.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../chi/main.rhdl" as chi
  "params.rhdl" as params
  "uncached-fixture.rhdl" as fixture

def uncached = fixture.uncached_design.modules.find(
  fun (module_def): module_def.name == "RicketUncached"
)
def router = fixture.router_design.modules.find(
  fun (module_def): module_def.name == "RicketMemoryRouter"
)
fun assertion_labels(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "verif.assert"
  ).map(fun (operation): operation.attribute("label"))

check:
  params.test_ricket_device_config.has_devices ~is #true
  params.test_ricket_device_config.normal_address_sets ~is [chi.AddressSet(0, 0x7fff)]
  params.test_ricket_device_config.device_address_sets ~is [chi.AddressSet(0x8000, 0x7fff)]
  params.test_ricket_device_params.device_node.kind ~is chi.CHINodeKind.RNI
  params.test_ricket_device_params.device_node.emits.req ~is [
    chi.CHIReqOpcode.ReadNoSnp, chi.CHIReqOpcode.WriteNoSnpPtl
  ]
  uncached.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "node_id", "core_in", "chi_in"
  ]
  uncached.outputs.map(fun (port): port.name) ~is ["core_out", "chi_out"]
  uncached.find_output("core_out").type.field("request_access_fault").type.bit_width() ~is 1
  assertion_labels(uncached).contains("ricket_uncached_address_has_home") ~is #true
  assertion_labels(router) ~is ["ricket_memory_response_paths_exclusive"]
  verify_design(fixture.uncached_design) ~is #void
  verify_design(fixture.router_design) ~is #void
