#lang rhdl
// Exposes Ricket memory-operation classification and atomic-ALU behavior for tests.

import:
  "../memory.rhdl" open
  "../dcache/protocol.rhdl" open
  "../../../riscv/isa/xlen.rhm" open

circuit RicketAtomicFixture(xlen :: XLen):
  def width = xlen_width(xlen)

  input request: RicketDataReq(xlen)
  input old_value: Bits(width)
  output is_load: Bool
  output needs_unique: Bool
  output value: Bits(width)

  def access :: MemoryOperation = request.access
  inst atomic_alu(RicketAtomicALU(xlen))
  is_load <== access.is_load()
  needs_unique <== access.needs_unique()
  atomic_alu.old_value <== old_value
  atomic_alu.operand <== request.data
  atomic_alu.memory_width <== request.width
  atomic_alu.operation <== request.atomic
  value <== atomic_alu.value

export:
  RicketAtomicFixture
