#lang rhombus
// Checks Ricket's pipeline-cache hierarchy, external ports, and configuration bounds.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../rhdl/frontend/kernel.rhm" as embedded
  "../ricket.rhdl" as core

def design = embedded.run_elaboration(fun (): core.Ricket(64, 32))
def top = design.modules.find(fun (module_def): module_def.name == "Ricket")
def pipeline = design.modules.find(fun (module_def): module_def.name == "RicketPipeline")
def l1i = design.modules.find(fun (module_def): module_def.name == "RicketL1ICache")
def l1d = design.modules.find(fun (module_def): module_def.name == "RicketL1DCache")
def register_file = design.modules.find(fun (module_def): module_def.name == "RicketRegisterFile")
def scoreboard = design.modules.find(fun (module_def): module_def.name == "RicketScoreboard")
def architectural_registers = register_file.operations.find(fun (operation): operation.attribute("name") == "registers")
def rv32_design = embedded.run_elaboration(fun (): core.Ricket(32, 32))
def rv32_top = rv32_design.modules.find(fun (module_def): module_def.name == "Ricket")
def rv32_register_file = rv32_design.modules.find(fun (module_def): module_def.name == "RicketRegisterFile")
def wide_design = embedded.run_elaboration(fun (): core.Ricket(64, 64))
def wide_top = wide_design.modules.find(fun (module_def): module_def.name == "Ricket")
fun instance_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).map(fun (operation): operation.attribute("module").name)
fun state_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))
fun sync_memories(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.sync_memory"
  )

def top_instances = instance_names(top)
def pipeline_instances = instance_names(pipeline)
def l1i_instances = instance_names(l1i)
def l1d_instances = instance_names(l1d)
def sync_rams = design.modules.filter(
  ~keep: fun (module_def): module_def.name.starts_with("SyncRam1RW")
)

check:
  top.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "start_in", "imem_in", "dmem_in"
  ]
  top.outputs.map(fun (port): port.name) ~is [
    "start_out", "imem_out", "dmem_out", "fault"
  ]
  top_instances ~is ["RicketPipeline", "RicketL1ICache", "RicketL1DCache"]
  state_names(top) ~is []
  pipeline_instances.filter(
    ~keep: fun (name): name.starts_with("Pipe")
  ).length() ~is 2
  pipeline_instances.filter(
    ~keep: fun (name): name.starts_with("ValidPipe")
  ).length() ~is 2
  pipeline_instances.contains("RicketInstructionDecoder") ~is #true
  pipeline_instances.contains("RicketRegisterFile") ~is #true
  pipeline_instances.contains("RicketScoreboard") ~is #true
  pipeline_instances.contains("ALU") ~is #true
  pipeline_instances.contains("BranchResolver") ~is #true
  pipeline_instances.contains("LoadGen") ~is #false
  pipeline_instances.contains("StoreGen") ~is #false
  pipeline_instances.contains("Queue") ~is #true
  pipeline_instances.length() ~is 10
  l1i_instances.filter(~keep: fun (name): name.starts_with("SyncRam1RW")).length() ~is 2
  l1i_instances.filter(~keep: fun (name): name.starts_with("Queue")).length() ~is 1
  l1d_instances.filter(~keep: fun (name): name.starts_with("SyncRam1RW")).length() ~is 2
  l1d_instances.contains("LoadGen") ~is #true
  l1d_instances.contains("StoreGen") ~is #true
  sync_memories(l1i).length() ~is 0
  sync_memories(l1d).length() ~is 0
  sync_rams.length() ~is 4
  sync_rams.map(fun (module_def): sync_memories(module_def).length()) ~is [1, 1, 1, 1]
  type_equal(architectural_registers.results[0].type,
             VectorType(32, Bits(64))) ~is #true
  state_names(pipeline) ~is [
    "faulted", "started", "fetch_pc", "fetch_epoch"
  ]
  state_names(scoreboard) ~is ["busy_bits"]
  top.find_input("start_in").type.field("bits").type.width ~is 64
  top.find_output("imem_out").type.field("request").type.field("bits").type.field("data").type.width ~is 64
  rv32_top.find_input("start_in").type.field("bits").type.width ~is 32
  rv32_top.find_output("dmem_out").type.field("request").type.field("bits").type.field("data").type.width ~is 64
  rv32_register_file.operations.find(
    fun (operation): operation.attribute("name") == "registers"
  ).results[0].type.type_equal(VectorType(32, Bits(32))) ~is #true
  wide_top.find_output("imem_out").type.field("request").type.field("bits").type.field("address").type.width ~is 64
  verify_design(design) ~is #void
  verify_design(rv32_design) ~is #void
  verify_design(wide_design) ~is #void
  embedded.run_elaboration(fun (): core.Ricket(64, 11)) ~throws "tag bits"
  embedded.run_elaboration(fun (): core.Ricket(32, 33)) ~throws "must not exceed"
  embedded.run_elaboration(fun (): core.Ricket(16, 16)) ~throws "must be 32 or 64"
