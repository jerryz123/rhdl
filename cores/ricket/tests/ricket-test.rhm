#lang rhombus
// Checks Ricket's core-cache hierarchy, external ports, and configuration bounds.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../rhdl/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "../chi.rhdl" as chi
  "../ricket.rhdl" as ricket
  lib("chi/main.rhdl") as protocol

def design = embedded.run_elaboration(fun (): ricket.Ricket(XLen.X64))
def top = design.modules.find(fun (module_def): module_def.name == "Ricket")
def core = design.modules.find(fun (module_def): module_def.name == "RicketCore")
def l1i = design.modules.find(fun (module_def): module_def.name == "RicketL1ICache")
def l1d = design.modules.find(fun (module_def): module_def.name == "RicketL1DCache")
def register_file = design.modules.find(fun (module_def): module_def.name == "RicketRegisterFile")
def scoreboard = design.modules.find(fun (module_def): module_def.name == "Scoreboard")
def multiplier = design.modules.find(fun (module_def): module_def.name == "RicketMultiplier")
def csr_file = design.modules.find(fun (module_def): module_def.name == "RicketCsrFile")
def architectural_registers = register_file.operations.find(fun (operation): operation.attribute("name") == "registers")
def rv32_design = embedded.run_elaboration(fun (): ricket.Ricket(XLen.X32))
def rv32_top = rv32_design.modules.find(fun (module_def): module_def.name == "Ricket")
def rv32_register_file = rv32_design.modules.find(fun (module_def): module_def.name == "RicketRegisterFile")
fun instance_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).map(fun (operation): operation.attribute("module").name)
fun state_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))
fun sync_memories(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.sync_memory"
  )

def top_instances = instance_names(top)
def core_instances = instance_names(core)
def l1i_instances = instance_names(l1i)
def l1d_instances = instance_names(l1d)
def sync_rams = design.modules.filter(
  ~keep: fun (module_def): module_def.name.starts_with("SyncRam1RW")
)

check:
  top.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "start_in", "imem_in", "dmem_in"
  ]
  top.outputs.map(fun (port): port.name) ~is [
    "start_out", "imem_out", "dmem_out", "fault"
  ]
  top_instances ~is [
    "RicketCore", "RicketL1ICache", "RicketL1DCache",
    "CHIRNFlowAdapter", "CHIRNFlowAdapter_1"
  ]
  state_names(top) ~is []
  core_instances.filter(
    ~keep: fun (name): name.starts_with("Pipe")
  ).length() ~is 2
  core_instances.filter(
    ~keep: fun (name): name.starts_with("ValidPipe")
  ).length() ~is 2
  core_instances.contains("RicketInstructionDecoder") ~is #true
  core_instances.contains("RicketRegisterFile") ~is #true
  core_instances.contains("ALU") ~is #true
  core_instances.contains("BranchResolver") ~is #true
  core_instances.contains("RicketMultiplier") ~is #true
  core_instances.filter(~keep: fun (name): name.starts_with("Arbiter")).length() ~is 1
  core_instances.contains("Scoreboard") ~is #true
  core_instances.contains("RicketCsrFile") ~is #true
  core_instances.filter(
    ~keep: fun (name): name.starts_with("AtomicFork")
  ).length() ~is 1
  core_instances.contains("LoadGen") ~is #false
  core_instances.contains("StoreGen") ~is #false
  core_instances.contains("Queue") ~is #true
  core_instances.length() ~is 14
  l1i_instances.filter(~keep: fun (name): name.starts_with("SyncRam1RW")).length() ~is 2
  l1i_instances.filter(~keep: fun (name): name.starts_with("Queue")).length() ~is 1
  l1i_instances.contains("CHIRNFlowAdapter") ~is #false
  l1d_instances.filter(~keep: fun (name): name.starts_with("SyncRam1RW")).length() ~is 2
  l1d_instances.contains("LoadGen") ~is #true
  l1d_instances.contains("StoreGen") ~is #true
  l1d_instances.contains("CHIRNFlowAdapter") ~is #false
  sync_memories(l1i).length() ~is 0
  sync_memories(l1d).length() ~is 0
  sync_rams.length() ~is 3
  sync_rams.map(fun (module_def): sync_memories(module_def).length()) ~is [1, 1, 1]
  type_equal(architectural_registers.results[0].type,
             VectorType(32, Bits(64))) ~is #true
  state_names(core) ~is ["faulted", "started", "fetch_pc"]
  state_names(scoreboard) ~is ["state"]
  state_names(multiplier) ~is ["destination", "high_result", "word_result"]
  state_names(csr_file) ~is ["privilege_state", "state"]
  top.find_input("start_in").type.field("bits").type.width ~is 64
  top.find_output("imem_out").type.field("tx_req").type.field("bits").type.field("address").type.width ~is 44
  top.find_output("imem_out").type.field("tx_rsp").type.field("bits").type.field("opcode").type.width ~is 5
  rv32_top.find_input("start_in").type.field("bits").type.width ~is 32
  rv32_top.find_output("dmem_out").type.field("tx_dat").type.field("bits").type.field("data").type.width ~is 128
  rv32_top.find_output("dmem_out").type.field("tx_req").type.field("bits").type.field("address").type.width ~is 44
  rv32_register_file.operations.find(
    fun (operation): operation.attribute("name") == "registers"
  ).results[0].type.type_equal(VectorType(32, Bits(32))) ~is #true
  verify_design(design) ~is #void
  verify_design(rv32_design) ~is #void
  embedded.run_elaboration(
    fun (): ricket.Ricket(XLen.X32, ~cache_sets: 268435456)
  ) ~throws "tag bits"
  embedded.run_elaboration(fun (): ricket.Ricket(64)) ~throws "XLen"
  embedded.run_elaboration(
    fun (): ricket.Ricket(
      XLen.X64,
      ~chi: chi.RicketCHIParams(protocol.CHIFlitParams(), 1, 1, 3)
    )
  ) ~throws "distinct"
  embedded.run_elaboration(
    fun (): ricket.Ricket(
      XLen.X64,
      ~chi: chi.RicketCHIParams(protocol.CHIFlitParams(), 1, 128, 3)
    )
  ) ~throws "fit"
