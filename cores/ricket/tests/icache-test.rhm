#lang rhombus
// Checks Ricket instruction-cache protocol widths, geometry, and state shape.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../rhdl/frontend/kernel.rhm" as embedded
  "../icache/cache.rhdl" as l1i

def instruction_design = embedded.run_elaboration(fun (): l1i.RicketL1ICache(32, 8, 32))
def instruction_cache = instruction_design.modules.find(fun (module_def): module_def.name == "RicketL1ICache")
def one_beat_design = embedded.run_elaboration(fun (): l1i.RicketL1ICache(32, 8, 8))
fun register_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))

check:
  instruction_cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 32
  instruction_cache.find_output("core_out").type.field("response").type.field("bits").type.field("instruction").type.width ~is 32
  register_names(instruction_cache).contains("valid_bits") ~is #true
  register_names(instruction_cache).contains("lookup_valid") ~is #false
  register_names(instruction_cache).contains("refilling") ~is #true
  register_names(instruction_cache).contains("refill_requested") ~is #true
  register_names(instruction_cache).contains("outstanding") ~is #true
  register_names(instruction_cache).contains("state") ~is #false
  verify_design(instruction_design) ~is #void
  verify_design(one_beat_design) ~is #void
  embedded.run_elaboration(
    fun (): l1i.RicketL1ICache(32, 3, 32)
  ) ~throws "set count"
