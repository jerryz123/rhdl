#lang rhdl
// Elaborates Ricket's uncached engine and physical-memory router with an HN-I range.

import:
  "../uncached.rhdl" open
  "../memory-router.rhdl" open
  "params.rhdl" as params
  lib("riscv/isa/xlen.rhm").XLen

def uncached_design = elaborate(RicketUncached(XLen.X64,
                                               params.test_ricket_device_config))
def router_design = elaborate(RicketMemoryRouter(XLen.X64,
                                                 params.test_ricket_device_config))

export:
  uncached_design
  router_design
