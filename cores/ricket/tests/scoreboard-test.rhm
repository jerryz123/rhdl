#lang rhombus
// Checks Ricket scoreboard state shape, ports, and core verification.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../rhdl/frontend/kernel.rhm" as embedded
  "../scoreboard.rhdl" as scoreboard

def design = embedded.run_elaboration(fun (): scoreboard.RicketScoreboard())
def module_def = design.modules.find(fun (candidate): candidate.name == "RicketScoreboard")
def registers = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
)

check:
  module_def.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "set_valid", "set_address", "clear_valid",
    "clear_address", "query_rs1", "query_rs2", "query_rd"
  ]
  module_def.outputs.map(fun (port): port.name) ~is ["rs1_busy", "rs2_busy", "rd_busy"]
  registers.length() ~is 1
  registers[0].attribute("name") ~is "busy_bits"
  registers[0].results[0].type.type_equal(Bits(32)) ~is #true
  verify_design(design) ~is #void
