#lang rhombus
// Checks base, A, M, CSR, and system controls in the integrated decoder.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../rhdl/frontend/kernel.rhm" as embedded
  "../../../rhdl/frontend/layers/bool.rhm" as bool
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/zmmul.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../../../riscv/isa/a.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  "../../../riscv/rhdl/instruction-pattern.rhdl" open
  "../../alu.rhdl" as alu
  "../../branch-resolver.rhdl" as branches
  "../../load-store.rhdl" as load_store
  "../decode/alu-ctrl.rhdl" as alu_controls
  "../decode/operand-ctrl.rhdl" as operand_controls
  "../decode/branch-ctrl.rhdl" as branch_controls
  "../decode/mem-ctrl.rhdl" as memory_controls
  "../decode/writeback-ctrl.rhdl" as writeback_controls
  "../decode/divide-ctrl.rhdl" as divide_controls
  "../decode/system-ctrl.rhdl" as system_controls
  "../decode/fence-ctrl.rhdl" as fence_controls
  "../decode/core-ctrl.rhdl" as controls

def design = embedded.run_elaboration(fun (): controls.RicketInstructionDecoder(XLen.X64))
def module_def = design.modules[0]
def rv32_design = embedded.run_elaboration(fun (): controls.RicketInstructionDecoder(XLen.X32))
def rv32_module = rv32_design.modules[0]
fun control_for(cases, name):
  def instruction = RV64I.find(name)
  control_for_instruction(cases, instruction)
fun control_for_instruction(cases, instruction):
  cases.find(
    fun (candidate):
      candidate.input.value_bits == instruction.encoding.value && candidate.input.care_bits == instruction.encoding.care
  ).output

fun exact_pattern_equal(left, right):
  type_equal(left.type, right.type) && type_equal(right.type, left.type) && (
    left.width == right.width
  ) && (
    left.value_bits == right.value_bits
  ) && left.care_bits == right.care_bits

def canonical_domain = RV64IInstructions.map(instruction_pattern)
fun has_canonical_domain(cases):
  cases.length() == canonical_domain.length() && (
    for all (expected in canonical_domain):
      cases.filter(
        ~keep: fun (candidate): exact_pattern_equal(candidate.input, expected)
      ).length() == 1
  ) && (
    for all (case in cases):
      canonical_domain.filter(
        ~keep: fun (expected): exact_pattern_equal(case.input, expected)
      ).length() == 1
  )

def rv32_domain = rv32.RV32IInstructions.map(instruction_pattern)
fun has_rv32_domain(cases):
  cases.length() == rv32_domain.length() && (
    for all (expected in rv32_domain):
      cases.filter(
        ~keep: fun (candidate): exact_pattern_equal(candidate.input, expected)
      ).length() == 1
  )

def complete_relations = [
  alu_controls.RV64ICompleteAluCases,
  operand_controls.RV64IOperandCases,
  branch_controls.RV64IBranchCases,
  memory_controls.RV64IMemoryCases,
  writeback_controls.RV64IWritebackCases,
  system_controls.RV64ISystemCases,
  fence_controls.RV64IFenceCases,
  controls.RV64IControlCases
]
def rv32_complete_relations = [
  alu_controls.RV32ICompleteAluCases,
  operand_controls.RV32IOperandCases,
  branch_controls.RV32IBranchCases,
  memory_controls.RV32IMemoryCases,
  writeback_controls.RV32IWritebackCases,
  system_controls.RV32ISystemCases,
  fence_controls.RV32IFenceCases,
  controls.RV32IControlCases
]
def ricket_domain = controls.RV64RicketInstructions.map(instruction_pattern)
fun has_ricket_domain(cases):
  cases.length() == ricket_domain.length() && (
    for all (expected in ricket_domain):
      cases.filter(
        ~keep: fun (candidate): exact_pattern_equal(candidate.input, expected)
      ).length() == 1
  )
def rv32_ricket_domain = controls.RV32RicketInstructions.map(instruction_pattern)
fun has_rv32_ricket_domain(cases):
  cases.length() == rv32_ricket_domain.length() && (
    for all (expected in rv32_ricket_domain):
      cases.filter(
        ~keep: fun (candidate): exact_pattern_equal(candidate.input, expected)
      ).length() == 1
  )

fun record_field(record, name):
  record.fields.find(fun (field): field[0] == name)[1]

def addi_operand = operand_controls.OperandControl():
  uses_rs1: bool.Bool(#true)
  uses_rs2: bool.Bool(#false)
  left: operand_controls.OperandASelect.Register
  right: operand_controls.OperandBSelect.Immediate
  immediate: operand_controls.ImmediateSelect.I
def lbu_memory = memory_controls.MemoryControl():
  access: memory_controls.MemoryOperation.Load
  atomic: memory_controls.RicketAtomicOperation.Swap
  width: load_store.MemoryWidth.Byte
  unsigned: bool.Bool(#true)
fun resolver_value(enable, unconditional, compare_equal, signed_mode, invert):
  branches.BranchResolverControl():
    enable: bool.Bool(enable)
    unconditional: bool.Bool(unconditional)
    compare_equal: bool.Bool(compare_equal)
    signed_mode: bool.Bool(signed_mode)
    invert: bool.Bool(invert)
fun branch_value(enable, unconditional, compare_equal,
                 signed_mode, invert, target_from_rs1):
  branch_controls.BranchControl():
    resolver: resolver_value(
      enable, unconditional, compare_equal, signed_mode, invert
    )
    target_from_rs1: bool.Bool(target_from_rs1)
def jalr_branch_a = branch_value(#true, #true, #false, #false, #false, #true)
def jalr_branch_b = branch_value(#true, #true, #true, #true, #true, #true)
def beq_branch_a = branch_value(#true, #false, #true, #false, #false, #false)
def beq_branch_b = branch_value(#true, #false, #true, #true, #false, #false)
def bne_branch = branch_value(#true, #false, #true, #false, #true, #false)
def blt_branch = branch_value(#true, #false, #false, #true, #false, #false)
def bge_branch = branch_value(#true, #false, #false, #true, #true, #false)
def bltu_branch = branch_value(#true, #false, #false, #false, #false, #false)
def bgeu_branch = branch_value(#true, #false, #false, #false, #true, #false)
def load_writeback = writeback_controls.WritebackControl():
  enable: bool.Bool(#true)
  source: writeback_controls.WritebackSelect.Memory
def multiply_writeback = writeback_controls.WritebackControl():
  enable: bool.Bool(#true)
  source: writeback_controls.WritebackSelect.Multiply
def divide_writeback = writeback_controls.WritebackControl():
  enable: bool.Bool(#true)
  source: writeback_controls.WritebackSelect.Divide
def ecall_system = system_controls.SystemControl():
  csr: system_controls.CsrOperation.None
  immediate: bool.Bool(#false)
  action: system_controls.SystemOperation.Ecall
def csrrw_system = system_controls.SystemControl():
  csr: system_controls.CsrOperation.Write
  immediate: bool.Bool(#false)
  action: system_controls.SystemOperation.None
def csrrsi_system = system_controls.SystemControl():
  csr: system_controls.CsrOperation.Set
  immediate: bool.Bool(#true)
  action: system_controls.SystemOperation.None
def memory_fence = fence_controls.FenceControl():
  action: fence_controls.FenceOperation.Memory
def instruction_fence = fence_controls.FenceControl():
  action: fence_controls.FenceOperation.Instruction
def address_add = alu.AluControl():
  result_select: alu.AluResultSelect.Arithmetic
  subtract: bool.Bool(#false)
  signed_mode: bool.Bool(#false)
  shift_right: bool.Bool(#false)
  word: bool.Bool(#false)
def address_subtract = alu.AluControl():
  result_select: alu.AluResultSelect.Arithmetic
  subtract: bool.Bool(#true)
  signed_mode: bool.Bool(#false)
  shift_right: bool.Bool(#false)
  word: bool.Bool(#false)
def jal_operand_a = operand_controls.OperandControl():
  uses_rs1: bool.Bool(#false)
  uses_rs2: bool.Bool(#false)
  left: operand_controls.OperandASelect.Zero
  right: operand_controls.OperandBSelect.Register
  immediate: operand_controls.ImmediateSelect.J
def jal_operand_b = operand_controls.OperandControl():
  uses_rs1: bool.Bool(#false)
  uses_rs2: bool.Bool(#false)
  left: operand_controls.OperandASelect.Register
  right: operand_controls.OperandBSelect.Immediate
  immediate: operand_controls.ImmediateSelect.J
def add_operand_a = operand_controls.OperandControl():
  uses_rs1: bool.Bool(#true)
  uses_rs2: bool.Bool(#true)
  left: operand_controls.OperandASelect.Register
  right: operand_controls.OperandBSelect.Register
  immediate: operand_controls.ImmediateSelect.None
def add_operand_b = operand_controls.OperandControl():
  uses_rs1: bool.Bool(#true)
  uses_rs2: bool.Bool(#true)
  left: operand_controls.OperandASelect.Register
  right: operand_controls.OperandBSelect.Register
  immediate: operand_controls.ImmediateSelect.I
def no_branch_a = branch_value(#false, #false, #false, #false, #false, #false)
def no_branch_b = branch_value(#false, #true, #true, #true, #true, #true)
def store_memory_a = memory_controls.MemoryControl():
  access: memory_controls.MemoryOperation.Store
  atomic: memory_controls.RicketAtomicOperation.Swap
  width: load_store.MemoryWidth.Word
  unsigned: bool.Bool(#false)
def store_memory_b = memory_controls.MemoryControl():
  access: memory_controls.MemoryOperation.Store
  atomic: memory_controls.RicketAtomicOperation.Max
  width: load_store.MemoryWidth.Word
  unsigned: bool.Bool(#true)
def amoadd_memory = memory_controls.MemoryControl():
  access: memory_controls.MemoryOperation.Atomic
  atomic: memory_controls.RicketAtomicOperation.Add
  width: load_store.MemoryWidth.Word
  unsigned: bool.Bool(#false)
def lr_memory = memory_controls.MemoryControl():
  access: memory_controls.MemoryOperation.LoadReserved
  atomic: memory_controls.RicketAtomicOperation.Swap
  width: load_store.MemoryWidth.Double
  unsigned: bool.Bool(#false)
def no_writeback_a = writeback_controls.WritebackControl():
  enable: bool.Bool(#false)
  source: writeback_controls.WritebackSelect.Alu
def no_writeback_b = writeback_controls.WritebackControl():
  enable: bool.Bool(#false)
  source: writeback_controls.WritebackSelect.Memory

check:
  alu_controls.RV64IAluCases.length() ~is 28
  alu_controls.RV64INonArithmeticAluCases.length() ~is 24
  (for all (relation in complete_relations):
     has_canonical_domain(relation)) ~is #true
  (for all (relation in rv32_complete_relations):
     has_rv32_domain(relation)) ~is #true
  has_ricket_domain(controls.RV64RicketControlCases) ~is #true
  has_rv32_ricket_domain(controls.RV32RicketControlCases) ~is #true
  has_canonical_domain(
    operand_controls.RV64IOperandCases.drop(1)
  ) ~is #false
  has_canonical_domain(
    operand_controls.RV64IOperandCases.drop(1) ++ [
      operand_controls.RV64IOperandCases[1]
    ]
  ) ~is #false
  control_for(operand_controls.RV64IOperandCases, "ADDI").matches(addi_operand) ~is #true
  // JAL needs its immediate and register-use bits, but not ALU operand routing.
  control_for(operand_controls.RV64IOperandCases, "JAL").matches(jal_operand_a) ~is #true
  control_for(operand_controls.RV64IOperandCases, "JAL").matches(jal_operand_b) ~is #true
  control_for(operand_controls.RV64IOperandCases, "ADD").matches(add_operand_a) ~is #true
  control_for(operand_controls.RV64IOperandCases, "ADD").matches(add_operand_b) ~is #true
  control_for(memory_controls.RV64IMemoryCases, "LBU").matches(lbu_memory) ~is #true
  control_for(memory_controls.RV64IMemoryCases, "LB").matches(lbu_memory) ~is #false
  // Store signedness, inactive branch targets, and disabled writeback sources
  // are intentionally outside their respective care masks.
  control_for(memory_controls.RV64IMemoryCases, "SW").matches(store_memory_a) ~is #true
  control_for(memory_controls.RV64IMemoryCases, "SW").matches(store_memory_b) ~is #true
  control_for_instruction(memory_controls.RV64AMemoryCases, AMOADD_W).matches(amoadd_memory) ~is #true
  control_for_instruction(memory_controls.RV64AMemoryCases, LR_D).matches(lr_memory) ~is #true
  control_for_instruction(writeback_controls.RV64RicketWritebackCases, AMOMAXU_D).matches(load_writeback) ~is #true
  control_for(branch_controls.RV64IBranchCases, "ADDI").matches(no_branch_a) ~is #true
  control_for(branch_controls.RV64IBranchCases, "ADDI").matches(no_branch_b) ~is #true
  control_for(branch_controls.RV64IBranchCases, "JALR").matches(jalr_branch_a) ~is #true
  control_for(branch_controls.RV64IBranchCases, "JALR").matches(jalr_branch_b) ~is #true
  control_for(branch_controls.RV64IBranchCases, "BEQ").matches(beq_branch_a) ~is #true
  // Equality does not constrain signedness; signed less-than does.
  control_for(branch_controls.RV64IBranchCases, "BEQ").matches(beq_branch_b) ~is #true
  control_for(branch_controls.RV64IBranchCases, "BNE").matches(bne_branch) ~is #true
  control_for(branch_controls.RV64IBranchCases, "BLT").matches(blt_branch) ~is #true
  control_for(branch_controls.RV64IBranchCases, "BGE").matches(bge_branch) ~is #true
  control_for(branch_controls.RV64IBranchCases, "BLTU").matches(bltu_branch) ~is #true
  control_for(branch_controls.RV64IBranchCases, "BGEU").matches(bgeu_branch) ~is #true
  control_for(writeback_controls.RV64IWritebackCases, "LD").matches(load_writeback) ~is #true
  control_for_instruction(writeback_controls.RV64RicketWritebackCases, MUL).matches(multiply_writeback) ~is #true
  control_for_instruction(writeback_controls.RV64RicketWritebackCases, DIV).matches(divide_writeback) ~is #true
  control_for(writeback_controls.RV64IWritebackCases, "BEQ").matches(no_writeback_a) ~is #true
  control_for(writeback_controls.RV64IWritebackCases, "BEQ").matches(no_writeback_b) ~is #true
  // Address generation requires addition; instructions with no ALU consumer
  // leave the entire control bundle unconstrained.
  control_for(alu_controls.RV64ICompleteAluCases, "LD").matches(address_add) ~is #true
  control_for(alu_controls.RV64ICompleteAluCases, "LD").matches(address_subtract) ~is #false
  control_for(alu_controls.RV64ICompleteAluCases, "BEQ").care_bits ~is 0
  control_for(system_controls.RV64ISystemCases, "ECALL").matches(ecall_system) ~is #true
  control_for(system_controls.RV64ISystemCases, "FENCE").matches(ecall_system) ~is #false
  control_for_instruction(system_controls.RV64RicketSystemCases, CSRRW).matches(csrrw_system) ~is #true
  control_for_instruction(system_controls.RV64RicketSystemCases, CSRRSI).matches(csrrsi_system) ~is #true
  control_for(fence_controls.RV64IFenceCases, "FENCE").matches(memory_fence) ~is #true
  control_for_instruction(fence_controls.RV64RicketFenceCases, FENCE_I).matches(instruction_fence) ~is #true
  // Host-side column composition preserves nested freedom and emits one table.
  record_field(
    control_for(controls.RV64IControlCases, "BEQ").care,
    "alu"
  ).packed_value() ~is 0
  record_field(
    control_for(controls.RV64IControlCases, "BEQ").care,
    "branch"
  ).packed_value() != 0 ~is #true
  controls.RV64IControlDecode.table.packed_cases.length() ~is 52
  controls.RV32IControlDecode.table.packed_cases.length() ~is 40
  controls.RV64RicketControlDecode.table.packed_cases.length() ~is 96
  controls.RV32RicketControlDecode.table.packed_cases.length() ~is 68
  record_field(
    control_for_instruction(controls.RV64RicketControlCases, MUL).care,
    "multiply"
  ).packed_value() != 0 ~is #true
  record_field(
    control_for_instruction(controls.RV64RicketControlCases, DIV).care,
    "divide"
  ).packed_value() != 0 ~is #true
  alu_controls.RV32IAluCases.length() ~is 19
  module_def.outputs.map(fun (port): port.name) ~is [
    "valid", "control"
  ]
  type_equal(module_def.find_input("instruction").type, Bits(32)) ~is #true
  type_equal(module_def.find_output("valid").type, bool.Bool) ~is #true
  type_equal(module_def.find_output("control").type,
             controls.RicketControl()) ~is #true
  module_def.find_output("control").type.fields.map(
    fun (field): field.name
  ) ~is ["alu", "operand", "branch", "memory", "multiply", "divide", "writeback", "system", "fence"]
  verify_design(design) ~is #void
  type_equal(rv32_module.find_output("control").type,
             controls.RicketControl()) ~is #true
  verify_design(rv32_design) ~is #void
  embedded.run_elaboration(
    fun (): controls.RicketInstructionDecoder(64)
  ) ~throws "XLen"
