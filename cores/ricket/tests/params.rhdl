#lang rhdl
// Defines the standalone CHI environment shared by Ricket unit tests.

import:
  lib("cores/ricket/chi.rhdl") open
  lib("chi/main.rhdl") open

def test_ricket_flit = CHIFlitParams()
def test_ricket_home = CHIHomeParams("test-ricket-home", 1, CHINodeKind.HNF, ~max_outstanding: 2)
def test_ricket_home_map = CHIHomeMap(
  test_ricket_flit,
  [CHIHomeMapEntry(AddressSet(0, (1 << test_ricket_flit.request_address_width) - 1),
                   test_ricket_home)]
)
def test_ricket_chi_config = RicketCHIConfig(test_ricket_flit, test_ricket_home_map)
def test_ricket_chi_params = RicketCHIParams(test_ricket_chi_config, 2, 3)

def test_ricket_device_home = CHIHomeParams("test-ricket-device", 4, CHINodeKind.HNI, ~max_outstanding: 1)
def test_ricket_device_home_map = CHIHomeMap(
  test_ricket_flit,
  [CHIHomeMapEntry(AddressSet(0x0000, 0x7fff), test_ricket_home),
   CHIHomeMapEntry(AddressSet(0x8000, 0x7fff), test_ricket_device_home)]
)
def test_ricket_device_config = RicketCHIConfig(test_ricket_flit,
                                                test_ricket_device_home_map)
def test_ricket_device_params = RicketCHIParams(test_ricket_device_config,
                                                2,
                                                3,
                                                ~device_node_id: 5)

export:
  test_ricket_chi_config
  test_ricket_chi_params
  test_ricket_device_config
  test_ricket_device_params
