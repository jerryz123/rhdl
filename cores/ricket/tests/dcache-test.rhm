#lang rhombus
// Checks Ricket data-cache protocol widths, geometry, and state shape.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../rhdl/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "../dcache/cache.rhdl" as l1d
  "../dcache/protocol.rhdl" as protocol
  "params.rhdl" as test_params

def config = test_params.test_ricket_chi_config
def design = embedded.run_elaboration(fun (): l1d.RicketL1DCache(XLen.X64, 8, ~chi: config))
def cache = design.modules.find(fun (module_def): module_def.name == "RicketL1DCache")
def data_access_type = protocol.RicketDataAccess(XLen.X64)
def data_request_member = data_access_type.members.find(
  fun (member): member.name == "request"
)
def refill = design.modules.find(fun (module_def): module_def.name == "RicketLineRefill")
def snoop = design.modules.find(fun (module_def): module_def.name == "RicketDataSnoop")
def write_unique = design.modules.find(fun (module_def): module_def.name == "RicketWriteUnique")
def writeback = design.modules.find(fun (module_def): module_def.name == "RicketLineWriteback")
def rv32_design = embedded.run_elaboration(fun (): l1d.RicketL1DCache(XLen.X32, 8, ~chi: config))
def rv32_cache = rv32_design.modules.find(fun (module_def): module_def.name == "RicketL1DCache")
fun register_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))
fun instance_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).map(fun (operation): operation.attribute("module").name)

check:
  data_request_member.type.name ~is "Decoupled"
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("data").type.width ~is 64
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 64
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("access").type.width ~is 3
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("atomic").type.width ~is 4
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("tag").type.width ~is 5
  cache.find_output("core_out").type.field("response").type.field("bits").type.field("tag").type.width ~is 5
  data_width(cache.find_output("core_out").type.field("drained").type) ~is 1
  cache.find_output("chi_out").type.field("request_data").type.field("bits").type.field("byte_enable").type.width ~is 16
  rv32_cache.find_input("core_in").type.field("request").type.field("bits").type.field("data").type.width ~is 32
  rv32_cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 32
  rv32_cache.find_output("core_out").type.field("response").type.field("bits").type.field("data").type.width ~is 32
  rv32_cache.find_output("chi_out").type.field("requests").type.field("bits").type.field("address").type.width ~is 44
  register_names(cache).contains("valid_lines") ~is #true
  register_names(cache).contains("reservation_valid") ~is #true
  register_names(cache).contains("reservation_address") ~is #true
  register_names(cache).contains("reservation_width") ~is #true
  register_names(cache).contains("lookup_valid") ~is #false
  register_names(cache).contains("lookup_request") ~is #false
  register_names(cache).contains("refill_requested") ~is #false
  register_names(cache).contains("refill_received") ~is #false
  register_names(cache).contains("refill_line") ~is #false
  register_names(cache).contains("store_active") ~is #false
  register_names(cache).contains("store_request_sent") ~is #false
  register_names(cache).contains("store_dbid_received") ~is #false
  register_names(cache).contains("store_data_sent") ~is #false
  register_names(cache).contains("store_completion_received") ~is #false
  register_names(cache).contains("store_retry_received") ~is #false
  register_names(cache).contains("snoop_active") ~is #false
  register_names(cache).contains("dvm_first_pending") ~is #false
  register_names(cache).contains("outstanding") ~is #false
  register_names(cache).contains("state") ~is #false
  instance_names(cache).filter(
    ~keep: fun (name): name.starts_with("Pipe")
  ).length() ~is 1
  instance_names(cache).contains("RicketLineRefill") ~is #true
  instance_names(cache).contains("RicketDataSnoop") ~is #true
  instance_names(cache).contains("RicketLineWriteback") ~is #true
  instance_names(cache).contains("RicketAtomicALU") ~is #true
  register_names(refill) ~is [
    "active_state", "request_sent", "received_packets", "acknowledgement_sent",
    "line_address", "opcode", "context", "line", "home_id", "dbid", "response_state",
    "pass_dirty", "retry_received", "retry_credit_received",
    "retry_credit_type", "granted_credit_type"
  ]
  register_names(write_unique) ~is [
    "active_state", "request_sent", "dbid_received", "data_sent",
    "completion_received", "retry_received", "retry_credit_received",
    "retry_credit_type", "granted_credit_type", "address", "width",
    "write_data", "write_mask", "context", "home_id", "dbid"
  ]
  register_names(writeback) ~is [
    "active_state", "beat_started", "beat_index", "line_address", "line", "context"
  ]
  register_names(snoop) ~is [
    "active_state", "uses_lookup", "request", "lookup_complete", "line_hit",
    "line_state", "line", "packet_index", "dvm_first_pending", "dvm_source_id",
    "dvm_txn_id"
  ]
  verify_design(design) ~is #void
  verify_design(rv32_design) ~is #void
  embedded.run_elaboration(
    fun (): l1d.RicketL1DCache(64, 8, ~chi: config)
  ) ~throws "XLen"
