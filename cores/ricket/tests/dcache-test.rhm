#lang rhombus
// Checks Ricket data-cache protocol widths, geometry, and state shape.

import:
  "../../../rhdl/core/main.rhm" open
  "../../../rhdl/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "../dcache/cache.rhdl" as l1d
  "../dcache/protocol.rhdl" as protocol

def design = embedded.run_elaboration(fun (): l1d.RicketL1DCache(XLen.X64, 8, 32))
def cache = design.modules.find(fun (module_def): module_def.name == "RicketL1DCache")
def data_access_type = protocol.RicketDataAccess(XLen.X64)
def data_request_member = data_access_type.members.find(
  fun (member): member.name == "request"
)
def refill = design.modules.find(fun (module_def): module_def.name == "RicketLineRefill")
def rv32_design = embedded.run_elaboration(fun (): l1d.RicketL1DCache(XLen.X32, 8, 32))
def rv32_cache = rv32_design.modules.find(fun (module_def): module_def.name == "RicketL1DCache")
def one_beat_design = embedded.run_elaboration(fun (): l1d.RicketL1DCache(XLen.X64, 8, 8))
fun register_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))
fun instance_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).map(fun (operation): operation.attribute("module").name)

check:
  data_request_member.type.name ~is "Decoupled"
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("data").type.width ~is 64
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 64
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("tag").type.width ~is 5
  cache.find_output("core_out").type.field("response").type.field("bits").type.field("tag").type.width ~is 5
  cache.find_output("memory_out").type.field("request").type.field("bits").type.field("mask").type.width ~is 8
  rv32_cache.find_input("core_in").type.field("request").type.field("bits").type.field("data").type.width ~is 32
  rv32_cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 32
  rv32_cache.find_output("core_out").type.field("response").type.field("bits").type.field("data").type.width ~is 32
  rv32_cache.find_output("memory_out").type.field("request").type.field("bits").type.field("data").type.width ~is 64
  register_names(cache).contains("valid_bits") ~is #true
  register_names(cache).contains("lookup_valid") ~is #false
  register_names(cache).contains("lookup_request") ~is #false
  register_names(cache).contains("refill_requested") ~is #false
  register_names(cache).contains("refill_received") ~is #false
  register_names(cache).contains("refill_line") ~is #false
  register_names(cache).contains("store_active") ~is #true
  register_names(cache).contains("store_sent") ~is #true
  register_names(cache).contains("outstanding") ~is #false
  register_names(cache).contains("state") ~is #false
  instance_names(cache).filter(
    ~keep: fun (name): name.starts_with("Pipe")
  ).length() ~is 1
  instance_names(cache).contains("RicketLineRefill") ~is #true
  register_names(refill) ~is [
    "active_state", "line_address", "context", "requested", "received", "line"
  ]
  verify_design(design) ~is #void
  verify_design(rv32_design) ~is #void
  verify_design(one_beat_design) ~is #void
  embedded.run_elaboration(
    fun (): l1d.RicketL1DCache(XLen.X64, 8, 24)
  ) ~throws "Pow2Int"
  embedded.run_elaboration(
    fun (): l1d.RicketL1DCache(XLen.X64, 8, 4)
  ) ~throws "line byte count"
  embedded.run_elaboration(
    fun (): l1d.RicketL1DCache(64, 8, 32)
  ) ~throws "XLen"
