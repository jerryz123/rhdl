#lang rhdl
// Defines Ricket's pipeline payload and sideband bundle types.

import:
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../load-store.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open

bundle FetchDecode():
  pc: Bits(64)
  instruction: Bits(32)

bundle DecodeExecute():
  pc: Bits(64)
  instruction: Bits(32)
  alu_control: AluControl()
  operand_left: OperandASelect
  operand_right: OperandBSelect
  branch_control: BranchResolverControl()
  target_from_rs1: Bool
  memory_operation: MemoryOperation
  memory_width: MemoryWidth
  memory_unsigned: Bool
  writeback_enable: Bool
  writeback_source: WritebackSelect
  trap: Bool
  illegal: Bool
  immediate: Bits(64)
  rs1: Bits(5)
  rs2: Bits(5)
  rd: Bits(5)
  rs1_value: Bits(64)
  rs2_value: Bits(64)

bundle ExecuteMemory():
  pc: Bits(64)
  memory_operation: MemoryOperation
  memory_width: MemoryWidth
  memory_unsigned: Bool
  writeback_enable: Bool
  writeback_source: WritebackSelect
  rd: Bits(5)
  result: Bits(64)
  address: Bits(64)
  store_data: Bits(64)

bundle MemoryWriteback():
  write_enable: Bool
  rd: Bits(5)
  value: Bits(64)

// Sideband observations do not transfer ownership of the pipeline token.
bundle RicketBypass():
  rd: Bits(5)
  value: Bits(64)

export:
  FetchDecode
  DecodeExecute
  ExecuteMemory
  MemoryWriteback
  RicketBypass
