#lang rhdl
// Implements Ricket's fully associative Sv39 translation lookaside buffer.

import:
  "protocol.rhdl" open
  "../csr.rhdl" open
  "../../../riscv/rhdl/sv39.rhdl" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open

bundle RicketTlbEntry():
  valid: Bool
  vpn: Bits(27)
  ppn: Bits(44)
  level: Bits(2)
  user: Bool
  read: Bool
  write: Bool
  execute: Bool
  global: Bool
  accessed: Bool
  dirty: Bool

sync_circuit RicketTlb(entry_count :: Pow2Int = 8):
  input virtual_address: Bits(64)
  input access: Sv39Access
  input privilege: PrivilegeMode
  input sum: Bool
  input mxr: Bool
  input enabled: Bool
  input invalidate_all: Bool
  interface fill(Valid(RicketTranslationResult()), ~role: consumer)
  output hit: Bool
  output fault: Bool
  output physical_address: Bits(56)

  def index_bits = index_width(entry_count)
  reg entries(Vec(entry_count, RicketTlbEntry()), ~init: vec(
    for List (_index in 0..entry_count): literal(RicketTlbEntry(), 0)
  ))
  reg replacement(~init: bits(0, index_bits))

  def vpn = virtual_address[12..39]
  def matches = vec(
    for List (index in 0..entry_count):
      def entry = entries[index]
      def level_matches = mux_lookup(
        entry.level,
        ~default: entry.vpn === vpn,
        [
          [1, entry.vpn[9..27] === vpn[9..27]],
          [2, entry.vpn[18..27] === vpn[18..27]]
        ]
      )
      entry.valid & level_matches
  )
  def selected_index = priority_encoder(matches)
  def selected = entries[selected_index]
  def selected_pte = Sv39Pte():
    ppn: selected.ppn
    reserved: bits(0, 10)
    rsw: bits(0, 2)
    dirty: selected.dirty
    accessed: selected.accessed
    global: selected.global
    user: selected.user
    execute: selected.execute
    write: selected.write
    read: selected.read
    valid: Bool(#true)
  def selected_hit = enabled & sv39_canonical(virtual_address) & or_reduce(matches)
  hit <== !enabled ||| selected_hit
  fault <== enabled & selected_hit & !sv39_permission_valid(
    selected_pte,
    access,
    privilege === PrivilegeMode.User,
    privilege === PrivilegeMode.Supervisor,
    sum,
    mxr
  )
  physical_address <== mux(enabled, sv39_physical_address(virtual_address, selected_pte, selected.level), virtual_address[0..56])

  when invalidate_all:
    entries <== vec(for List (_index in 0..entry_count): literal(RicketTlbEntry(), 0))
    replacement <== bits(0, index_bits)
  elsewhen (fill.valid & !fill.bits.fault):
    entries <== entries.updated(
      replacement,
      RicketTlbEntry():
        valid: Bool(#true)
        vpn: fill.bits.virtual_address[12..39]
        ppn: fill.bits.ppn
        level: fill.bits.level
        user: fill.bits.user
        read: fill.bits.read
        write: fill.bits.write
        execute: fill.bits.execute
        global: fill.bits.global
        accessed: fill.bits.accessed
        dirty: fill.bits.dirty
    )
    replacement <== replacement + bits(1, index_bits)

export:
  RicketTlbEntry
  RicketTlb
