#lang rhdl
// Implements Ricket's serialized non-speculative Sv39 page-table walker.

import:
  "protocol.rhdl" open
  "../csr.rhdl" open
  "../../../riscv/rhdl/sv39.rhdl" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open

hardware_enum RicketPageWalkState:
  Idle
  Request
  Response
  Complete

sync_circuit RicketPageTableWalker():
  interface request(Decoupled(RicketTranslationRequest()), ~role: consumer)
  interface completion(Irrevocable(RicketTranslationResult()), ~role: producer)
  interface memory(RicketPageTableMemory(), ~role: requester)
  input cancel: Bool

  reg state(~init: RicketPageWalkState.Idle)
  reg operation(RicketTranslationRequest())
  reg level(~init: bits(2, 2))
  reg table_ppn(Bits(44))
  reg global_mapping(~init: Bool(#false))
  reg result(RicketTranslationResult())

  request.ready <== state === RicketPageWalkState.Idle
  def request_fire = fire(request)
  def vpn_index = sv39_vpn(operation.virtual_address, level)
  memory.request.valid <== state === RicketPageWalkState.Request
  memory.request.bits <== zext(concat(table_ppn, bits(0, 12)), 64) + zext(concat(vpn_index, bits(0, 3)), 64)
  def memory_request_fire = fire(memory.request)
  memory.response.ready <== state === RicketPageWalkState.Response
  def memory_response_fire = fire(memory.response)
  def pte = sv39_pte(memory.response.bits)
  def leaf = sv39_leaf(pte)
  def structural_fault = !sv39_pte_structurally_valid(pte) ||| (
    leaf & !sv39_superpage_aligned(pte, level)
  ) ||| (!leaf & ((level === bits(0, 2)) ||| pte.dirty ||| pte.accessed ||| pte.user))
  def permission_fault = leaf & !sv39_permission_valid(
    pte,
    operation.access,
    operation.privilege === PrivilegeMode.User,
    operation.privilege === PrivilegeMode.Supervisor,
    operation.sum,
    operation.mxr
  )
  def completes_walk = structural_fault ||| leaf
  def walk_fault = structural_fault ||| permission_fault

  completion.valid <== state === RicketPageWalkState.Complete
  completion.bits <== result
  def completion_fire = fire(completion)

  when cancel:
    state <== RicketPageWalkState.Idle
  elsewhen request_fire:
    operation <== request.bits
    level <== bits(2, 2)
    table_ppn <== request.bits.root_ppn
    global_mapping <== Bool(#false)
    when (sv39_canonical(request.bits.virtual_address)):
      state <== RicketPageWalkState.Request
    elsewhen (!sv39_canonical(request.bits.virtual_address)):
      state <== RicketPageWalkState.Complete
      result <== RicketTranslationResult():
        virtual_address: request.bits.virtual_address
        physical_address: bits(0, 56)
        ppn: bits(0, 44)
        level: bits(0, 2)
        user: Bool(#false)
        read: Bool(#false)
        write: Bool(#false)
        execute: Bool(#false)
        global: Bool(#false)
        accessed: Bool(#false)
        dirty: Bool(#false)
        fault: Bool(#true)
  elsewhen memory_request_fire:
    state <== RicketPageWalkState.Response
  elsewhen memory_response_fire:
    when completes_walk:
      state <== RicketPageWalkState.Complete
      result <== RicketTranslationResult():
        virtual_address: operation.virtual_address
        physical_address: sv39_physical_address(operation.virtual_address, pte, level)
        ppn: pte.ppn
        level: level
        user: pte.user
        read: pte.read
        write: pte.write
        execute: pte.execute
        global: global_mapping ||| pte.global
        accessed: pte.accessed
        dirty: pte.dirty
        fault: walk_fault
    elsewhen (!completes_walk):
      state <== RicketPageWalkState.Request
      level <== level - bits(1, 2)
      table_ppn <== pte.ppn
      global_mapping <== global_mapping ||| pte.global
  elsewhen completion_fire:
    state <== RicketPageWalkState.Idle

export:
  RicketPageWalkState
  RicketPageTableWalker
