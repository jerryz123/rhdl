#lang rhdl
// Defines Ricket's internal Sv39 lookup and page-table-memory protocols.

import:
  "../../../riscv/rhdl/sv39.rhdl" open
  "../csr.rhdl" open
  lib("rhdl/std/ready-valid.rhdl") open

bundle RicketTranslationRequest():
  virtual_address: Bits(64)
  root_ppn: Bits(44)
  access: Sv39Access
  privilege: PrivilegeMode
  sum: Bool
  mxr: Bool

bundle RicketTranslationResult():
  virtual_address: Bits(64)
  physical_address: Bits(56)
  ppn: Bits(44)
  level: Bits(2)
  user: Bool
  read: Bool
  write: Bool
  execute: Bool
  global: Bool
  accessed: Bool
  dirty: Bool
  fault: Bool

interface RicketPageTableMemory():
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(Bits(64))

  responder -> requester:
    response: Irrevocable(Bits(64))

export:
  RicketTranslationRequest
  RicketTranslationResult
  RicketPageTableMemory
