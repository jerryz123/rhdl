#lang rhdl
// Implements Ricket's five-stage pipeline against core-facing cache protocols.

import:
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../load-store.rhdl" open
  "decode/core-ctrl.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/branch-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open
  "bundles.rhdl" open
  "register-file.rhdl" open
  "scoreboard.rhdl" open
  "icache/protocol.rhdl" open
  "dcache/protocol.rhdl" open
  "../../riscv/model/formats.rhm" as riscv_fields
  "../../riscv/rhdl/instruction-fields.rhdl" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/flow.rhdl") open

sync_circuit RicketPipeline(address_width :: Int):
  unless address_width >= 3
  | error(~who: #'Ricket,
          "address width must cover an eight-byte data transfer")
  unless address_width <= 64
  | error(~who: #'Ricket,
          "address width must not exceed the RV64 architectural address width")

  interface start(Irrevocable(Bits(64)), ~role: consumer)
  interface instruction_access(RicketInstructionAccess(address_width), ~role: requester)
  interface data_access(RicketDataAccess(address_width), ~role: requester)
  output fault: Bool

  def zero64 = bits(0, 64)
  reg faulted(~init: Bool(#false))
  reg started(~init: Bool(#false))
  reg fetch_pc(~init: zero64)
  reg fetch_epoch(~init: Bool(#false))

  // IF/ID and ID/EX are elastic. Once Execute accepts any cache request, the
  // EX/MEM and MEM/WB boundaries advance feed-forward without backpressure.
  inst if_id_pipe(Pipe(FetchDecode(), 1))
  inst fetch_metadata(Queue(FetchMetadata(), 2, ~pipe: #true))
  inst id_ex_pipe(Pipe(DecodeExecute(), 1))
  inst ex_mem_pipe(ValidPipe(ExecuteMemory(), 1))
  inst mem_wb_pipe(ValidPipe(MemoryWriteback(), 1))

  inst decoder(RV64IInstructionDecoder())
  inst registers(RicketRegisterFile())
  inst scoreboard(RicketScoreboard())
  inst alu(ALU(64))
  inst branch_resolver(BranchResolver(64))

  fault <== faulted

  // Backward-traveling observations use local Valid interface links. Their
  // producers remain in their pipeline stages below, despite earlier stages
  // consuming their values. The payloadless fault event remains a Bool wire.
  wire execute_fault_event: Bool
  def redirect_link :: Handle = interface_link(Valid(Bits(64)))
  def memory_bypass_link :: Handle = interface_link(Valid(RicketBypass()))
  def writeback_bypass_link :: Handle = interface_link(Valid(RicketBypass()))

  // Fetch (IF) owns request correlation state, while IF/ID storage belongs to
  // its Pipe. Redirects and faults consume any younger registered token.
  def squash = faulted ||| execute_fault_event ||| redirect_link.right.valid
  def fetch_stale_response = fetch_metadata.egress.bits.epoch =/= fetch_epoch
  def start_aligned = is_aligned(start.bits, 4)

  start.ready <== !started & !(faulted ||| execute_fault_event)
  def start_fault = fire(start) & !start_aligned
  def fetch_wants_request = started & !(faulted ||| execute_fault_event) & !redirect_link.right.valid
  instruction_access.request.valid <== fetch_wants_request & fetch_metadata.ingress.ready
  instruction_access.request.bits.address <== fetch_pc[0..address_width]
  fetch_metadata.ingress.valid <== fetch_wants_request & instruction_access.request.ready
  fetch_metadata.ingress.bits <== FetchMetadata():
    pc: fetch_pc
    epoch: fetch_epoch

  def fetch_pair_valid = instruction_access.response.valid & fetch_metadata.egress.valid
  def fetch_pair_ready = squash ||| fetch_stale_response ||| if_id_pipe.ingress.ready
  if_id_pipe.ingress.valid <== fetch_pair_valid & !squash & !fetch_stale_response
  if_id_pipe.ingress.bits <== FetchDecode():
    pc: fetch_metadata.egress.bits.pc
    instruction: instruction_access.response.bits.instruction
  instruction_access.response.ready <== fetch_metadata.egress.valid & fetch_pair_ready
  fetch_metadata.egress.ready <== instruction_access.response.valid & fetch_pair_ready

  def start_fire = fire(start)
  def fetch_request_fire = fire(instruction_access.request)
  when start_fire:
    started.next <== Bool(#true)

  when (redirect_link.right.valid):
    fetch_pc.next <== redirect_link.right.bits
  elsewhen start_fire:
    fetch_pc.next <== start.bits
  elsewhen fetch_request_fire:
    fetch_pc.next <== fetch_pc + bits(4, 64)

  when (redirect_link.right.valid):
    fetch_epoch.next <== !fetch_epoch

  when (start_fault ||| execute_fault_event):
    faulted.next <== Bool(#true)

  // Decode (ID) is ordinary combinational logic between IF/ID and ID/EX.
  // Filtering consumes squashed tokens; gating holds a load-use dependent
  // token.
  def live_if_id :: Endpoint = filter_flow(if_id_pipe.egress, fetch_token => !squash)
  def id_ex = id_ex_pipe.egress
  def instruction = live_if_id.bits.instruction
  decoder.instruction <== instruction
  def control = decoder.control

  def rs1 = instruction_field(riscv_fields.rs1, instruction)
  def rs2 = instruction_field(riscv_fields.rs2, instruction)
  def rd = instruction_field(riscv_fields.rd, instruction)
  def decoded_immediate = mux_lookup(
    control.operand.immediate,
    ~default: bits(0, 64),
    [
      [ImmediateSelect.I,
       instruction_immediate(riscv_fields.IImmediate, instruction, 64)],
      [ImmediateSelect.S,
       instruction_immediate(riscv_fields.SImmediate, instruction, 64)],
      [ImmediateSelect.B,
       instruction_immediate(riscv_fields.BImmediate, instruction, 64)],
      [ImmediateSelect.U,
       instruction_immediate(riscv_fields.UImmediate, instruction, 64)],
      [ImmediateSelect.J,
       instruction_immediate(riscv_fields.JImmediate, instruction, 64)]
    ]
  )

  registers.read_address_1 <== rs1
  registers.read_address_2 <== rs2
  scoreboard.query_rs1 <== rs1
  scoreboard.query_rs2 <== rs2
  scoreboard.query_rd <== rd

  def id_ex_is_load = id_ex.valid & (id_ex.bits.memory_operation === MemoryOperation.Read)
  def load_destination = id_ex.bits.rd
  def load_use_rs1 = control.operand.uses_rs1 & or_reduce(load_destination) & (load_destination === rs1)
  def load_use_rs2 = control.operand.uses_rs2 & or_reduce(load_destination) & (load_destination === rs2)
  def load_use_rd = control.writeback.enable & or_reduce(load_destination) & (load_destination === rd)
  def load_dependency_hazard = live_if_id.valid & id_ex_is_load & (load_use_rs1 ||| load_use_rs2 ||| load_use_rd)
  def scoreboard_raw_hazard = (control.operand.uses_rs1 & scoreboard.rs1_busy) ||| (
    control.operand.uses_rs2 & scoreboard.rs2_busy
  )
  def scoreboard_waw_hazard = control.writeback.enable & scoreboard.rd_busy
  def register_hazard = load_dependency_hazard ||| scoreboard_raw_hazard ||| scoreboard_waw_hazard
  live_if_id.ready <== id_ex_pipe.ingress.ready & !register_hazard
  id_ex_pipe.ingress.valid <== live_if_id.valid & !register_hazard
  id_ex_pipe.ingress.bits <== DecodeExecute():
    pc: live_if_id.bits.pc
    instruction: instruction
    alu_control: control.alu
    operand_left: control.operand.left
    operand_right: control.operand.right
    branch_control: control.branch.resolver
    target_from_rs1: control.branch.target_from_rs1
    memory_operation: control.memory.access
    memory_width: control.memory.width
    memory_unsigned: control.memory.unsigned
    writeback_enable: control.writeback.enable
    writeback_source: control.writeback.source
    trap: control.trap.trap
    illegal: !decoder.valid
    immediate: decoded_immediate
    rs1: rs1
    rs2: rs2
    rd: rd
    rs1_value: registers.read_data_1
    rs2_value: registers.read_data_2

  // Execute (EX) consumes the registered ID/EX token. Forwarding is live, so
  // the next Pipe owns the resulting EX/MEM stability under backpressure.
  def memory_forwards_rs1 = memory_bypass_link.right.valid & (memory_bypass_link.right.bits.rd === id_ex.bits.rs1)
  def memory_forwards_rs2 = memory_bypass_link.right.valid & (memory_bypass_link.right.bits.rd === id_ex.bits.rs2)
  def writeback_forwards_rs1 = writeback_bypass_link.right.valid & (writeback_bypass_link.right.bits.rd === id_ex.bits.rs1)
  def writeback_forwards_rs2 = writeback_bypass_link.right.valid & (writeback_bypass_link.right.bits.rd === id_ex.bits.rs2)
  def forwarded_rs1 = mux(
    memory_forwards_rs1,
    memory_bypass_link.right.bits.value,
    mux(writeback_forwards_rs1,
        writeback_bypass_link.right.bits.value,
        id_ex.bits.rs1_value)
  )
  def forwarded_rs2 = mux(
    memory_forwards_rs2,
    memory_bypass_link.right.bits.value,
    mux(writeback_forwards_rs2,
        writeback_bypass_link.right.bits.value,
        id_ex.bits.rs2_value)
  )

  alu.left <== mux_lookup(
    id_ex.bits.operand_left,
    ~default: forwarded_rs1,
    [
      [OperandASelect.Pc, id_ex.bits.pc],
      [OperandASelect.Zero, bits(0, 64)]
    ]
  )
  alu.right <== mux(
    id_ex.bits.operand_right === OperandBSelect.Immediate,
    id_ex.bits.immediate,
    forwarded_rs2
  )
  alu.control <== id_ex.bits.alu_control

  branch_resolver.left <== forwarded_rs1
  branch_resolver.right <== forwarded_rs2
  branch_resolver.control <== id_ex.bits.branch_control
  def redirect_requested = branch_resolver.taken
  def pc_target = id_ex.bits.pc + id_ex.bits.immediate
  def register_target_sum = forwarded_rs1 + id_ex.bits.immediate
  def register_target = register_target_sum & bits(0xfffffffffffffffe, 64)
  def computed_redirect_target :: Bits(64) = mux(
    id_ex.bits.target_from_rs1,
    register_target,
    pc_target
  )
  def redirect_aligned = is_aligned(computed_redirect_target, 4)
  def memory_aligned = memory_access_aligned(alu.result, id_ex.bits.memory_width)
  def execute_fault = id_ex.bits.illegal ||| id_ex.bits.trap ||| (
    redirect_requested & !redirect_aligned
  ) ||| (
    (id_ex.bits.memory_operation =/= MemoryOperation.None) & !(
      memory_aligned
    )
  )
  def execute_is_memory = id_ex.bits.memory_operation =/= MemoryOperation.None
  def execute_cache_ready = !execute_is_memory ||| execute_fault ||| data_access.request.ready
  def execute_stage_ready = execute_cache_ready
  def execute_transfer = id_ex.valid & execute_stage_ready
  def pc_plus_four = id_ex.bits.pc + bits(4, 64)
  def execute_result = mux(
    id_ex.bits.writeback_source === WritebackSelect.PcPlus4,
    pc_plus_four,
    alu.result
  )

  execute_fault_event <== execute_transfer & execute_fault
  redirect_link.left.valid <== execute_transfer & !execute_fault & redirect_requested
  redirect_link.left.bits <== computed_redirect_target

  id_ex.ready <== execute_stage_ready
  ex_mem_pipe.ingress.valid <== id_ex.valid & !execute_fault & execute_cache_ready
  ex_mem_pipe.ingress.bits <== ExecuteMemory():
    memory_operation: id_ex.bits.memory_operation
    writeback_enable: id_ex.bits.writeback_enable
    rd: id_ex.bits.rd
    result: execute_result

  // A legal memory access starts its synchronous cache lookup at the same
  // edge that captures the instruction in EX/MEM. A hit therefore occupies
  // the ordinary MEM stage instead of adding a request cycle after it.
  data_access.request.valid <== id_ex.valid & !execute_fault & execute_is_memory
  data_access.request.bits <== RicketDataReq(address_width):
    address: alu.result[0..address_width]
    write: id_ex.bits.memory_operation === MemoryOperation.Write
    width: id_ex.bits.memory_width
    unsigned: id_ex.bits.memory_unsigned
    data: forwarded_rs2
    tag: mux(id_ex.bits.memory_operation === MemoryOperation.Read, id_ex.bits.rd, bits(0, 5))

  // Memory is Ricket's ordered commit point. A load marks its destination
  // busy here and releases EX/MEM without waiting for the tagged cache result.
  // Stores also commit at this point because alignment and other faults were
  // resolved before the cache accepted their requests.
  def commit = ex_mem_pipe.egress
  def commit_is_load = commit.bits.memory_operation === MemoryOperation.Read
  def commit_writes_immediately = commit.bits.writeback_enable & !commit_is_load

  mem_wb_pipe.ingress.valid <== commit.valid & commit_writes_immediately
  mem_wb_pipe.ingress.bits <== MemoryWriteback():
    write_enable: commit.bits.writeback_enable
    rd: commit.bits.rd
    value: commit.bits.result

  memory_bypass_link.left.valid <== commit.valid & commit_writes_immediately & or_reduce(commit.bits.rd)
  memory_bypass_link.left.bits <== RicketBypass():
    rd: commit.bits.rd
    value: commit.bits.result

  // The two register-file write ports accept an immediate WB result and a
  // delayed load completion independently, so neither path backpressures MEM.
  def mem_wb = mem_wb_pipe.egress
  def load_completion_valid = data_access.response.valid & or_reduce(data_access.response.bits.tag)
  def immediate_write_valid = mem_wb.valid & mem_wb.bits.write_enable

  data_access.response.ready <== Bool(#true)
  scoreboard.set_valid <== commit.valid & commit_is_load & commit.bits.writeback_enable
  scoreboard.set_address <== commit.bits.rd
  scoreboard.clear_valid <== load_completion_valid
  scoreboard.clear_address <== data_access.response.bits.tag

  writeback_bypass_link.left.valid <== immediate_write_valid & or_reduce(mem_wb.bits.rd)
  writeback_bypass_link.left.bits <== RicketBypass():
    rd: mem_wb.bits.rd
    value: mem_wb.bits.value

  registers.write_enable_1 <== immediate_write_valid
  registers.write_address_1 <== mem_wb.bits.rd
  registers.write_data_1 <== mem_wb.bits.value
  registers.write_enable_2 <== load_completion_valid
  registers.write_address_2 <== data_access.response.bits.tag
  registers.write_data_2 <== data_access.response.bits.data

export:
  RicketPipeline
