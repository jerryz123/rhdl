#lang rhdl
// Composes Ricket's core and ready-valid L1 caches with external credited CHI links.

import:
  "core-flow.rhdl" open
  "chi.rhdl" open
  "icache/cache.rhdl" open
  "dcache/cache.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  lib("rhdl/std/bits.rhdl").Pow2Int
  lib("rhdl/std/ready-valid.rhdl") open
  lib("chi/main.rhdl") open

sync_circuit Ricket(xlen :: XLen,
                    ~cache_sets: cache_sets :: Pow2Int = 64,
                    ~line_bytes: line_bytes :: Pow2Int = 32,
                    ~chi: params :: RicketCHIParams = default_ricket_chi_params):
  def width = xlen_width(xlen)
  def checked = checked_ricket_chi_params(params)

  interface start(Irrevocable(Bits(width)), ~role: consumer)
  interface imem(CHIRNLink(checked.instruction_link, checked.instruction_node), ~role: node)
  interface dmem(CHIRNLink(checked.data_link, checked.data_node), ~role: node)
  output fault: Bool

  inst core(RicketCore(xlen))
  inst l1i(RicketL1ICache(xlen, cache_sets, line_bytes, ~chi: checked))
  inst l1d(RicketL1DCache(xlen, cache_sets, line_bytes, ~chi: checked))
  inst instruction_link_adapter(CHIRNFlowAdapter(checked.instruction_link, checked.instruction_node))
  inst data_link_adapter(CHIRNFlowAdapter(checked.data_link, checked.data_node, ~transaction_checks: #false))

  start |> core.start
  core.instruction_access |> l1i.core
  core.data_access |> l1d.core
  l1i.chi <=> instruction_link_adapter.decoupled
  l1d.chi <=> data_link_adapter.decoupled
  imem <=> instruction_link_adapter.port
  dmem <=> data_link_adapter.port
  instruction_link_adapter.transmit_enable <== Bool(#true)
  instruction_link_adapter.receive_enable <== Bool(#true)
  data_link_adapter.transmit_enable <== Bool(#true)
  data_link_adapter.receive_enable <== Bool(#true)
  fault <== core.fault

export:
  Ricket
