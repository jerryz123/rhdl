#lang rhdl
// Composes the Ricket pipeline with private pipelined-hit L1 instruction and data caches.

import:
  "core-pipeline.rhdl" open
  "icache/cache.rhdl" open
  "dcache/cache.rhdl" open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/simple-memory.rhdl") open

sync_circuit Ricket(address_width :: Int,
                    ~cache_sets: cache_sets :: Int = 64,
                    ~line_bytes: line_bytes :: Int = 32):
  interface start(Irrevocable(Bits(64)), ~role: consumer)
  interface imem(SimpleMemory(address_width, 8), ~role: requester)
  interface dmem(SimpleMemory(address_width, 8), ~role: requester)
  output fault: Bool

  inst pipeline(RicketPipeline(address_width))
  inst l1i(RicketL1ICache(address_width, cache_sets, line_bytes))
  inst l1d(RicketL1DCache(address_width, cache_sets, line_bytes))

  start <=> pipeline.start
  pipeline.instruction_access <=> l1i.core
  pipeline.data_access <=> l1d.core
  l1i.memory <=> imem
  l1d.memory <=> dmem
  fault <== pipeline.fault

export:
  Ricket
