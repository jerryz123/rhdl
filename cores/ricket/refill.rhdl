#lang rhdl
// Implements Ricket's retry-aware packet-complete coherent cache-line acquisition.

import:
  "cache.rhdl" open
  "chi.rhdl" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("chi/main.rhdl") open

bundle RicketLineRefillCommand(Context :: DataType,
                               address_width :: PosInt):
  line_address: Bits(address_width)
  opcode: CHIReqOpcode
  context: Context

bundle RicketLineRefillResult(Context :: DataType,
                              address_width :: PosInt):
  line_address: Bits(address_width)
  context: Context
  line: Vec(RicketCacheLineBytes / 8, Bits(64))
  state: CHIResponseState
  pass_dirty: Bool

sync_circuit RicketLineRefill(Context :: DataType,
                              address_width :: PosInt,
                              params :: RicketCHIParams,
                              node :: CHINodeParams):
  def checked = checked_ricket_chi_params(params)
  def p = checked.flit
  def node_id = node.node_id
  unless RicketCacheLineBytes >= p.data_bytes
  | error(~who: #'RicketLineRefill,
          "cache line must span at least one complete CHI data packet")
  unless address_width >= alignment_bits(RicketCacheLineBytes)
  | error(~who: #'RicketLineRefill,
          "address width must cover the line offset")
  unless node_id == checked.instruction_node_id || node_id == checked.data_node_id
  | error(~who: #'RicketLineRefill,
          "refill node must identify a Ricket cache")
  def packet_count = RicketCacheLineBytes / p.data_bytes
  def packet_index_width = index_width(packet_count)
  def data_id_stride = p.data_bytes / 16
  def data_id_stride_width = alignment_bits(data_id_stride)

  interface command(Decoupled(RicketLineRefillCommand(Context, address_width)),
                    ~role: consumer)
  interface completion(Irrevocable(RicketLineRefillResult(Context, address_width)), ~role: producer)
  interface requests(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface acknowledgements(Decoupled(CHIRspFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)
  interface response_data(Decoupled(CHIDatFlit(p)), ~role: consumer)

  reg active_state(~init: Bool(#false))
  reg request_sent(~init: Bool(#false))
  reg received_packets(~init: vec(
    for List (_index in 0..packet_count): Bool(#false)
  ))
  reg acknowledgement_sent(~init: Bool(#false))
  reg line_address(~init: bits(0, address_width))
  reg opcode(~init: CHIReqOpcode.ReadClean)
  reg context(Context)
  reg line(~init: bits(0, RicketCacheLineBytes * 8))
  reg home_id(~init: bits(0, p.node_id_width))
  reg dbid(~init: bits(0, 12))
  reg response_state(~init: CHIResponseState.Invalid)
  reg pass_dirty(~init: Bool(#false))
  reg retry_received(~init: Bool(#false))
  reg retry_credit_received(~init: Bool(#false))
  reg retry_credit_type(~init: bits(0, 4))
  reg granted_credit_type(~init: bits(0, 4))

  command.ready <== !active_state
  def command_fire = fire(command)
  when command_fire:
    assert(is_aligned(command.bits.line_address, RicketCacheLineBytes),
           "line_refill_address_aligned")
    assert(ricket_chi_address_fits(command.bits.line_address, p),
           "line_refill_address_fits_chi")
    assert(is_one_of(command.bits.opcode,
                     CHIReqOpcode.ReadClean,
                     CHIReqOpcode.ReadUnique),
           "line_refill_opcode_supported")

  def retry_ready = retry_received & retry_credit_received
  requests.valid <== active_state & !request_sent & (!retry_received ||| retry_ready)
  requests.bits <== ricket_chi_request(
    p,
    node_id,
    checked.home_node_id,
    line_address,
    CHITransferSize.Bytes64,
    opcode,
    bits(0, 12),
    Bool(#true),
    Bool(#true),
    !retry_received,
    mux(retry_received, retry_credit_type, bits(0, 4))
  )
  def request_fire = fire(requests)

  def incoming_response = responses.bits
  def response_ordinary = incoming_response.opcode =/= CHIRspOpcode.RespLCrdReturn
  def retry_ack = incoming_response.opcode === CHIRspOpcode.RetryAck
  def protocol_credit = incoming_response.opcode === CHIRspOpcode.PCrdGrant
  def retry_response = retry_ack ||| protocol_credit
  responses.ready <== !response_ordinary ||| (
    active_state & retry_response & (request_sent ||| retry_received)
  )
  def retry_response_fire = fire(responses) & response_ordinary
  def retry_ack_fire = retry_response_fire & retry_ack
  def protocol_credit_fire = retry_response_fire & protocol_credit
  when retry_response_fire:
    assert(retry_response, "line_refill_retry_response_supported")
    assert(incoming_response.tgt_id === bits(node_id, p.node_id_width),
           "line_refill_retry_response_target")
    assert(incoming_response.src_id === bits(checked.home_node_id, p.node_id_width),
           "line_refill_retry_response_home")
  when retry_ack_fire:
    assert(request_sent, "line_refill_retry_has_request")
    assert(incoming_response.txn_id === bits(0, 12),
           "line_refill_retry_txn_id")
  when (retry_received & retry_credit_received):
    assert(retry_credit_type === granted_credit_type,
           "line_refill_retry_credit_type_matches")

  def incoming_data = response_data.bits
  def coherent_response = incoming_data.resp.into(CHICoherentResponse())
  def all_data_received = and_reduce(received_packets)
  def first_data_packet = !or_reduce(received_packets)
  def packet_index:
    if packet_count == 1
    | bits(0, packet_index_width)
    | incoming_data.data_id[
        data_id_stride_width..(data_id_stride_width + packet_index_width)
      ]
  def expected_data_id = mux_lookup(
    packet_index,
    ~default: bits(0, 2),
    for List (index in 0..packet_count):
      [index,
       ricket_chi_address(line_address, p)[4..6] + bits(index * data_id_stride, 2)]
  )
  def packet_was_received = received_packets[packet_index]
  def next_received_packets = received_packets.updated(packet_index, Bool(#true))
  def next_line = as_vec(line, Bits(p.data_width)).updated(
    packet_index,
    incoming_data.data
  )
  response_data.ready <== active_state & request_sent & !all_data_received
  def data_fire = fire(response_data)
  when data_fire:
    assert(incoming_data.opcode === CHIDatOpcode.CompData,
           "line_refill_response_is_comp_data")
    assert(incoming_data.txn_id === bits(0, 12),
           "line_refill_response_txn_id")
    assert(incoming_data.tgt_id === bits(node_id, p.node_id_width),
           "line_refill_response_target")
    assert(incoming_data.data_id === expected_data_id,
           "line_refill_response_data_id")
    assert(!packet_was_received,
           "line_refill_response_data_id_unique")
    assert(incoming_data.num_dat === bits(0, 2),
           "line_refill_response_num_dat_zero")
    assert(!incoming_data.replicate,
           "line_refill_response_not_replicated")
    assert(incoming_data.resp_err === CHIRespErr.OK,
           "line_refill_response_ok")
  when (data_fire & !first_data_packet):
    assert(incoming_data.home_nid_or_pbha_or_mismatched_mecid === home_id,
           "line_refill_response_home_consistent")
    assert(incoming_data.dbid_or_mecid[0..12] === dbid,
           "line_refill_response_dbid_consistent")
    assert(coherent_response.state === response_state,
           "line_refill_response_state_consistent")
    assert(coherent_response.pass_dirty === pass_dirty,
           "line_refill_response_pass_dirty_consistent")

  acknowledgements.valid <== active_state & all_data_received & !acknowledgement_sent
  acknowledgements.bits <== ricket_chi_response(
    p,
    node_id,
    home_id,
    dbid,
    CHIRspOpcode.CompAck
  )
  def acknowledgement_fire = fire(acknowledgements)

  completion.valid <== active_state & acknowledgement_sent
  completion.bits <== RicketLineRefillResult(Context, address_width):
    line_address: line_address
    context: context
    line: as_vec(line, Bits(64))
    state: response_state
    pass_dirty: pass_dirty
  def completion_fire = fire(completion)

  when command_fire:
    active_state <== Bool(#true)
    received_packets <== vec(
      for List (_index in 0..packet_count): Bool(#false)
    )
    acknowledgement_sent <== Bool(#false)
    line_address <== command.bits.line_address
    opcode <== command.bits.opcode
    context <== command.bits.context
    line <== bits(0, RicketCacheLineBytes * 8)
    home_id <== bits(0, p.node_id_width)
    dbid <== bits(0, 12)
    response_state <== CHIResponseState.Invalid
    pass_dirty <== Bool(#false)
  elsewhen data_fire:
    received_packets <== next_received_packets
    line <== as_bits(next_line)
    home_id <== mux(first_data_packet,
                    incoming_data.home_nid_or_pbha_or_mismatched_mecid,
                    home_id)
    dbid <== mux(first_data_packet, incoming_data.dbid_or_mecid[0..12], dbid)
    response_state <== mux(first_data_packet, coherent_response.state, response_state)
    pass_dirty <== mux(first_data_packet, coherent_response.pass_dirty, pass_dirty)
  elsewhen acknowledgement_fire:
    acknowledgement_sent <== Bool(#true)
  elsewhen completion_fire:
    active_state <== Bool(#false)

  when command_fire:
    request_sent <== Bool(#false)
  elsewhen retry_ack_fire:
    request_sent <== Bool(#false)
  elsewhen request_fire:
    request_sent <== Bool(#true)

  when (command_fire ||| (request_fire & retry_received) ||| completion_fire):
    retry_received <== Bool(#false)
    retry_credit_received <== Bool(#false)
    retry_credit_type <== bits(0, 4)
    granted_credit_type <== bits(0, 4)
  elsewhen retry_ack_fire:
    retry_received <== Bool(#true)
    retry_credit_type <== incoming_response.pcrd_type
  elsewhen protocol_credit_fire:
    retry_credit_received <== Bool(#true)
    granted_credit_type <== incoming_response.pcrd_type

export:
  RicketLineRefillCommand
  RicketLineRefillResult
  RicketLineRefill
