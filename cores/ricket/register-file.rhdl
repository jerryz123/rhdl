#lang rhdl
// Implements Ricket's two-read, one-write integer register file with x0 hardwired to zero.

sync_circuit RicketRegisterFile():
  input read_address_1: Bits(5)
  input read_address_2: Bits(5)
  input write_enable: Bool
  input write_address: Bits(5)
  input write_data: Bits(64)
  output read_data_1: Bits(64)
  output read_data_2: Bits(64)

  def zero = bits(0, 64)
  def initial = vec(for List (_index in 0..32): zero)
  reg registers(~init: initial)

  def writing_nonzero = write_enable and (write_address =/= bits(0, 5))
  when writing_nonzero:
    registers.next <== registers.updated(write_address, write_data)

  // Define write-first behavior: a read matching an enabled nonzero write
  // observes write_data during the cycle of that write.
  def read_1_zero = read_address_1 === bits(0, 5)
  def read_2_zero = read_address_2 === bits(0, 5)
  def bypass_1 = writing_nonzero and (write_address === read_address_1)
  def bypass_2 = writing_nonzero and (write_address === read_address_2)
  read_data_1 <== mux(
    read_1_zero,
    zero,
    mux(bypass_1,
        write_data,
        registers.lookup(read_address_1, ~default: zero))
  )
  read_data_2 <== mux(
    read_2_zero,
    zero,
    mux(bypass_2,
        write_data,
        registers.lookup(read_address_2, ~default: zero))
  )

export:
  RicketRegisterFile
