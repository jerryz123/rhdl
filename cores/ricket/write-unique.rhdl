#lang rhdl
// Implements Ricket's retry-aware RN-F WriteUniquePtl transaction engine.

import:
  "chi.rhdl" open
  "../load-store.rhdl" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("chi/main.rhdl") open

bundle RicketWriteUniqueCommand(Context :: DataType,
                                address_width :: PosInt):
  address: Bits(address_width)
  width: MemoryWidth
  data: Bits(64)
  mask: Bits(8)
  context: Context

bundle RicketWriteUniqueResult(Context :: DataType):
  context: Context

sync_circuit RicketWriteUnique(Context :: DataType,
                               address_width :: PosInt,
                               params :: RicketCHIParams,
                               txn_id :: Nat):
  def checked = checked_ricket_chi_params(params)
  def p = checked.flit
  def node_id = checked.data_node.node_id
  unless bits.length(txn_id) <= 12
  | error(~who: #'RicketWriteUnique,
          "transaction ID must fit in twelve bits")

  interface command(Decoupled(RicketWriteUniqueCommand(Context, address_width)), ~role: consumer)
  interface completion(Irrevocable(RicketWriteUniqueResult(Context)), ~role: producer)
  interface requests(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface data(Decoupled(CHIDatFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)

  reg active_state(~init: Bool(#false))
  reg request_sent(~init: Bool(#false))
  reg dbid_received(~init: Bool(#false))
  reg data_sent(~init: Bool(#false))
  reg completion_received(~init: Bool(#false))
  reg retry_received(~init: Bool(#false))
  reg retry_credit_received(~init: Bool(#false))
  reg retry_credit_type(~init: bits(0, 4))
  reg granted_credit_type(~init: bits(0, 4))
  reg address(~init: bits(0, address_width))
  reg width(~init: MemoryWidth.Byte)
  reg write_data(~init: bits(0, 64))
  reg write_mask(~init: bits(0, 8))
  reg context(Context)
  reg home_id(~init: bits(0, p.node_id_width))
  reg dbid(~init: bits(0, 12))

  command.ready <== !active_state
  def command_fire = fire(command)
  when command_fire:
    assert(ricket_chi_address_fits(command.bits.address, p),
           "write_unique_address_fits_chi")

  def retry_ready = retry_received & retry_credit_received
  requests.valid <== active_state & !request_sent & (!retry_received ||| retry_ready)
  requests.bits <== ricket_chi_request(
    p,
    node_id,
    checked.home_node_id,
    address,
    cast(zext(as_bits(width), 3), CHITransferSize),
    CHIReqOpcode.WriteUniquePtl,
    bits(txn_id, 12),
    Bool(#false),
    Bool(#false),
    !retry_received,
    mux(retry_received, retry_credit_type, bits(0, 4))
  )
  def request_fire = fire(requests)

  def incoming_response = responses.bits
  def response_ordinary = incoming_response.opcode =/= CHIRspOpcode.RespLCrdReturn
  def response_retry = incoming_response.opcode === CHIRspOpcode.RetryAck
  def response_protocol_credit = incoming_response.opcode === CHIRspOpcode.PCrdGrant
  def response_dbid = is_one_of(incoming_response.opcode, CHIRspOpcode.DBIDResp, CHIRspOpcode.DBIDRespOrd)
  def response_completion = incoming_response.opcode === CHIRspOpcode.Comp
  def response_combined = incoming_response.opcode === CHIRspOpcode.CompDBIDResp
  def response_supported = response_retry ||| response_protocol_credit ||| response_dbid ||| response_completion ||| response_combined
  def response_expected = active_state & response_supported & (
    (response_protocol_credit & (request_sent ||| retry_received)) ||| (
      response_retry & request_sent & !dbid_received & !completion_received
    ) ||| (
      response_dbid & request_sent & !dbid_received
    ) ||| (
      response_completion & request_sent & !completion_received
    ) ||| (
      response_combined & request_sent & !dbid_received & !completion_received
    )
  )
  responses.ready <== !response_ordinary ||| response_expected
  def response_fire = fire(responses) & response_ordinary
  def retry_fire = response_fire & response_retry
  def protocol_credit_fire = response_fire & response_protocol_credit
  def dbid_fire = response_fire & (response_dbid ||| response_combined)
  def response_completion_fire = response_fire & (response_completion ||| response_combined)
  def transaction_id_response_fire = dbid_fire ||| response_completion_fire
  def transaction_id_already_received = dbid_received ||| completion_received
  when (responses.valid & response_ordinary):
    assert(response_expected, "write_unique_response_expected")
    assert(incoming_response.src_id === bits(checked.home_node_id, p.node_id_width),
           "write_unique_response_home")
    assert(incoming_response.resp_err === CHIRespErr.OK,
           "write_unique_response_ok")
  when (response_fire & !response_protocol_credit):
    assert(incoming_response.txn_id === bits(txn_id, 12),
           "write_unique_response_txn_id")
  when (transaction_id_response_fire & transaction_id_already_received):
    assert(incoming_response.dbid_or_group_id === dbid,
           "write_unique_response_dbid_consistent")
  when (retry_received & retry_credit_received):
    assert(retry_credit_type === granted_credit_type,
           "write_unique_retry_credit_type_matches")

  def data_lane = address[3..alignment_bits(p.data_bytes)]
  def bus_data = zext(write_data, p.data_width) << concat(data_lane, bits(0, 6))
  def bus_mask = zext(write_mask, p.data_bytes) << concat(data_lane, bits(0, 3))
  data.valid <== active_state & dbid_received & !data_sent
  data.bits <== ricket_chi_write_data(
    p,
    node_id,
    home_id,
    dbid,
    address,
    bus_data,
    bus_mask
  )
  def data_fire = fire(data)

  completion.valid <== active_state & data_sent & completion_received
  completion.bits <== RicketWriteUniqueResult(Context):
    context: context
  def completion_fire = fire(completion)

  when command_fire:
    active_state <== Bool(#true)
    address <== command.bits.address
    width <== command.bits.width
    write_data <== command.bits.data
    write_mask <== command.bits.mask
    context <== command.bits.context
  elsewhen completion_fire:
    active_state <== Bool(#false)

  when (command_fire ||| retry_fire ||| completion_fire):
    request_sent <== Bool(#false)
  elsewhen request_fire:
    request_sent <== Bool(#true)

  when (command_fire ||| completion_fire):
    dbid_received <== Bool(#false)
  elsewhen dbid_fire:
    dbid_received <== Bool(#true)

  when (command_fire ||| completion_fire):
    data_sent <== Bool(#false)
  elsewhen data_fire:
    data_sent <== Bool(#true)

  when (command_fire ||| completion_fire):
    completion_received <== Bool(#false)
  elsewhen response_completion_fire:
    completion_received <== Bool(#true)

  when transaction_id_response_fire:
    home_id <== incoming_response.src_id
    dbid <== incoming_response.dbid_or_group_id

  when (command_fire ||| (request_fire & retry_received) ||| completion_fire):
    retry_received <== Bool(#false)
    retry_credit_received <== Bool(#false)
    retry_credit_type <== bits(0, 4)
    granted_credit_type <== bits(0, 4)
  elsewhen retry_fire:
    retry_received <== Bool(#true)
    retry_credit_type <== incoming_response.pcrd_type
  elsewhen protocol_credit_fire:
    retry_credit_received <== Bool(#true)
    granted_credit_type <== incoming_response.pcrd_type

export:
  RicketWriteUniqueCommand
  RicketWriteUniqueResult
  RicketWriteUnique
