#lang rhdl
// Implements Ricket's five-stage core against core-facing cache protocols.

import:
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../load-store.rhdl" open
  "decode/core-ctrl.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/branch-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open
  "bundles.rhdl" open
  "register-file.rhdl" open
  "icache/protocol.rhdl" open
  "dcache/protocol.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/model/formats.rhm" as riscv_fields
  "../../riscv/rhdl/instruction-fields.rhdl" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/flow.rhdl") open
  lib("rhdl/std/scoreboard.rhdl") open

sync_circuit RicketCore(xlen :: XLen):
  def width = xlen_width(xlen)
  def register_count = 32

  interface start(Irrevocable(Bits(width)), ~role: consumer)
  interface instruction_access(RicketInstructionAccess(xlen), ~role: requester)
  interface data_access(RicketDataAccess(xlen), ~role: requester)
  output fault: Bool

  def zero = bits(0, width)
  reg faulted(~init: Bool(#false))
  reg started(~init: Bool(#false))
  reg fetch_pc(~init: zero)

  // IF/ID and ID/EX are elastic. Once Execute accepts any cache request, the
  // EX/MEM and MEM/WB boundaries advance feed-forward without backpressure.
  inst id_ex_pipe(Pipe(DecodeExecute(xlen), 1))
  inst ex_mem_pipe(ValidPipe(ExecuteMemory(xlen), 1))
  inst mem_wb_pipe(ValidPipe(MemoryWriteback(xlen), 1))

  inst decoder(RicketInstructionDecoder(xlen))
  inst registers(RicketRegisterFile(xlen))
  inst alu(ALU(xlen))
  inst branch_resolver(BranchResolver(width))
  inst scoreboard(Scoreboard(register_count))

  fault <== faulted

  // Backward-traveling observations use local Valid interface links. Their
  // producers remain in their pipeline stages below, despite earlier stages
  // consuming their values. The payloadless fault event remains a Bool wire.
  wire execute_fault_event: Bool
  def redirect_link :: Handle = interface_link(Valid(Bits(width)))
  def memory_bypass_link :: Handle = interface_link(Valid(RicketBypass(xlen)))
  def writeback_bypass_link :: Handle = interface_link(Valid(RicketBypass(xlen)))

  // WB is the ordered commit point. Deferred loads mark their destinations
  // busy there and clear them when the tagged cache response returns. The L1D
  // registers SRAM results to align hits with WB; completion wins when both
  // updates target the same register in one cycle.
  def memory = ex_mem_pipe.egress
  def Array(commit, scoreboard_set_path) = mem_wb_pipe.egress |> fork_valid(2)
  def commit_is_load = commit.bits.memory_operation === MemoryOperation.Read
  def scoreboard_set_filter = filter_valid(operation):
    (operation.memory_operation === MemoryOperation.Read) & operation.write_enable & or_reduce(operation.rd)
  def scoreboard_set_address = map_valid(operation => operation.rd)
  (scoreboard_set_path |> scoreboard_set_filter |> scoreboard_set_address) <=> scoreboard.set

  def load_completion_filter = filter_valid(response => or_reduce(response.tag))
  def valid_load_completions = data_access.response |> load_completion_filter
  def Array(load_completion, scoreboard_clear_path) = valid_load_completions |> fork_valid(2)
  def load_completion_tag = map_valid(response => response.tag)
  (scoreboard_clear_path |> load_completion_tag) <=> scoreboard.clear

  // Fetch (IF) owns request correlation state, while IF/ID storage belongs to
  // its Pipe. Redirects and faults flush both pending PCs and the L1I's
  // lookup/response path, so no generation tag crosses this interface.
  def squash = faulted ||| execute_fault_event ||| redirect_link.right.valid
  def start_aligned = is_aligned(start.bits, 4)

  start.ready <== !started & !(faulted ||| execute_fault_event)
  def start_fire = fire(start)
  def start_fault = fire(start) & !start_aligned
  def fetch_flush = start_fault ||| execute_fault_event ||| redirect_link.right.valid
  def fetch_queue_reset = cast(cast(reset, Bool) ||| fetch_flush, Reset)
  inst fetch_pcs(Queue(Bits(width), 2, ~pipe: #true),
                 ~clock: clock,
                 ~reset: fetch_queue_reset)
  def fetch_valid = started & !(faulted ||| execute_fault_event) & !redirect_link.right.valid
  instruction_access.flush <== fetch_flush
  instruction_access.request.valid <== fetch_valid & fetch_pcs.ingress.ready
  instruction_access.request.bits.address <== fetch_pc
  fetch_pcs.ingress.valid <== fetch_valid & instruction_access.request.ready
  fetch_pcs.ingress.bits <== fetch_pc

  def live_if_id :: Endpoint = (
    (
      Array(instruction_access.response, fetch_pcs.egress)
        |> zip_flow(response, pc):
        FetchDecode(xlen):
          pc: pc
          instruction: response.instruction
    ) |> filter_flow(fetch_token => !squash)
      |> pipe(1)
      |> filter_flow(fetch_token => !squash)
  )

  def fetch_request_fire = fire(instruction_access.request)
  when start_fire:
    started.next <== Bool(#true)

  when (redirect_link.right.valid):
    fetch_pc.next <== redirect_link.right.bits
  elsewhen start_fire:
    fetch_pc.next <== start.bits
  elsewhen fetch_request_fire:
    fetch_pc.next <== fetch_pc + bits(4, width)

  when (start_fault ||| execute_fault_event):
    faulted.next <== Bool(#true)

  // Decode (ID) is ordinary combinational logic between IF/ID and ID/EX.
  // Filtering consumes squashed tokens; gating holds a token that depends on
  // a load which has not yet reached the WB commit point.
  def id_ex = id_ex_pipe.egress
  def instruction = live_if_id.bits.instruction
  decoder.instruction <== instruction
  def control = decoder.control

  def rs1 = instruction_field(riscv_fields.rs1, instruction)
  def rs2 = instruction_field(riscv_fields.rs2, instruction)
  def rd = instruction_field(riscv_fields.rd, instruction)
  def decoded_immediate = mux_lookup(
    control.operand.immediate,
    ~default: bits(0, width),
    [
      [ImmediateSelect.I,
       instruction_immediate(riscv_fields.IImmediate, instruction, width)],
      [ImmediateSelect.S,
       instruction_immediate(riscv_fields.SImmediate, instruction, width)],
      [ImmediateSelect.B,
       instruction_immediate(riscv_fields.BImmediate, instruction, width)],
      [ImmediateSelect.U,
       instruction_immediate(riscv_fields.UImmediate, instruction, width)],
      [ImmediateSelect.J,
       instruction_immediate(riscv_fields.JImmediate, instruction, width)]
    ]
  )

  registers.read_address_1 <== rs1
  registers.read_address_2 <== rs2
  def rs1_busy = or_reduce(rs1) & scoreboard_busy(register_count, scoreboard.busy, rs1)
  def rs2_busy = or_reduce(rs2) & scoreboard_busy(register_count, scoreboard.busy, rs2)
  def rd_busy = or_reduce(rd) & scoreboard_busy(register_count, scoreboard.busy, rd)

  def id_ex_is_load = id_ex.valid & (id_ex.bits.memory_operation === MemoryOperation.Read)
  def memory_is_load = memory.valid & (memory.bits.memory_operation === MemoryOperation.Read)
  fun conflicts_with_load(load_valid, load_destination):
    load_valid & or_reduce(load_destination) & (
      (control.operand.uses_rs1 & (load_destination === rs1)) ||| (
        control.operand.uses_rs2 & (load_destination === rs2)
      ) ||| (
        control.writeback.enable & (load_destination === rd)
      )
    )
  def load_dependency_hazard = live_if_id.valid & (
    conflicts_with_load(id_ex_is_load, id_ex.bits.rd) ||| (
      conflicts_with_load(memory_is_load, memory.bits.rd)
    )
  )
  def scoreboard_raw_hazard = (control.operand.uses_rs1 & rs1_busy) ||| (
    control.operand.uses_rs2 & rs2_busy
  )
  def scoreboard_waw_hazard = control.writeback.enable & rd_busy
  def register_hazard = load_dependency_hazard ||| scoreboard_raw_hazard ||| scoreboard_waw_hazard
  def hazard_free_if_id = live_if_id |> gate_flow(!register_hazard)
  def decoded = hazard_free_if_id |> map_flow(fetch_token):
    DecodeExecute(xlen):
      pc: fetch_token.pc
      instruction: fetch_token.instruction
      alu_control: control.alu
      operand_left: control.operand.left
      operand_right: control.operand.right
      branch_control: control.branch.resolver
      target_from_rs1: control.branch.target_from_rs1
      memory_operation: control.memory.access
      memory_width: control.memory.width
      memory_unsigned: control.memory.unsigned
      writeback_enable: control.writeback.enable
      writeback_source: control.writeback.source
      trap: control.trap.trap
      illegal: !decoder.valid
      immediate: decoded_immediate
      rs1: rs1
      rs2: rs2
      rd: rd
      rs1_value: registers.read_data_1
      rs2_value: registers.read_data_2
  id_ex_pipe.ingress <=> decoded

  // Execute (EX) consumes the registered ID/EX token. Forwarding is live, so
  // the next Pipe owns the resulting EX/MEM stability under backpressure.
  def memory_forwards_rs1 = memory_bypass_link.right.valid & (memory_bypass_link.right.bits.rd === id_ex.bits.rs1)
  def memory_forwards_rs2 = memory_bypass_link.right.valid & (memory_bypass_link.right.bits.rd === id_ex.bits.rs2)
  def writeback_forwards_rs1 = writeback_bypass_link.right.valid & (writeback_bypass_link.right.bits.rd === id_ex.bits.rs1)
  def writeback_forwards_rs2 = writeback_bypass_link.right.valid & (writeback_bypass_link.right.bits.rd === id_ex.bits.rs2)
  def forwarded_rs1 = mux(
    memory_forwards_rs1,
    memory_bypass_link.right.bits.value,
    mux(writeback_forwards_rs1,
        writeback_bypass_link.right.bits.value,
        id_ex.bits.rs1_value)
  )
  def forwarded_rs2 = mux(
    memory_forwards_rs2,
    memory_bypass_link.right.bits.value,
    mux(writeback_forwards_rs2,
        writeback_bypass_link.right.bits.value,
        id_ex.bits.rs2_value)
  )

  alu.left <== mux_lookup(
    id_ex.bits.operand_left,
    ~default: forwarded_rs1,
    [
      [OperandASelect.Pc, id_ex.bits.pc],
      [OperandASelect.Zero, bits(0, width)]
    ]
  )
  alu.right <== mux(
    id_ex.bits.operand_right === OperandBSelect.Immediate,
    id_ex.bits.immediate,
    forwarded_rs2
  )
  alu.control <== id_ex.bits.alu_control

  def redirect_requested = branch_resolver.result.bits.taken
  def pc_target = id_ex.bits.pc + id_ex.bits.immediate
  def register_target_sum = forwarded_rs1 + id_ex.bits.immediate
  def register_target = register_target_sum & !bits(1, width)
  def computed_redirect_target :: Bits(width) = mux(
    id_ex.bits.target_from_rs1,
    register_target,
    pc_target
  )
  def redirect_aligned = is_aligned(computed_redirect_target, 4)
  def memory_aligned = memory_access_aligned(alu.result, id_ex.bits.memory_width)
  def execute_is_memory = id_ex.bits.memory_operation =/= MemoryOperation.None
  def execute_nonredirect_fault = id_ex.bits.illegal ||| id_ex.bits.trap ||| (
    execute_is_memory & !memory_aligned
  )
  def redirect_fault = redirect_requested & !redirect_aligned
  def execute_fault = execute_nonredirect_fault ||| redirect_fault
  def pc_plus_four = id_ex.bits.pc + bits(4, width)
  def execute_result = mux(
    id_ex.bits.writeback_source === WritebackSelect.PcPlus4,
    pc_plus_four,
    alu.result
  )

  // Execute accepts one token atomically across branch resolution, an
  // optional cache request, and the feed-forward pipeline continuation. The
  // cache leg consumes tokens that cannot issue without producing a request,
  // so only a legal memory operation contributes backpressure.
  def Array(branch_path, cache_path, pipeline_path) = id_ex |> atomic_fork(3)

  def branch_request_mapping = map_flow(execute_token):
    BranchResolverRequest(width):
      left: forwarded_rs1
      right: forwarded_rs2
      control: execute_token.branch_control
  branch_path |> branch_request_mapping
    |> to_valid()
    |> eject_flow(
         ~valid: branch_resolver.request.valid,
         ~bits: branch_resolver.request.bits
       )

  // A legal memory access starts its synchronous cache lookup at the same
  // edge that captures the instruction in EX/MEM.
  def legal_memory_requests = filter_flow(execute_token):
    execute_is_memory & !execute_nonredirect_fault
  def cache_request_mapping = map_flow(execute_token):
    RicketDataReq(xlen):
      address: alu.result
      write: execute_token.memory_operation === MemoryOperation.Write
      width: execute_token.memory_width
      unsigned: execute_token.memory_unsigned
      data: forwarded_rs2
      tag: mux(
        execute_token.memory_operation === MemoryOperation.Read,
        execute_token.rd,
        bits(0, 5)
      )
  (cache_path |> legal_memory_requests |> cache_request_mapping) <=> data_access.request

  def successful_execute = filter_flow(execute_token => !execute_fault)
  def execute_result_mapping = map_flow(execute_token):
    ExecuteMemory(xlen):
      memory_operation: execute_token.memory_operation
      writeback_enable: execute_token.writeback_enable
      rd: execute_token.rd
      result: execute_result
  pipeline_path |> successful_execute
    |> execute_result_mapping
    |> to_valid()
    |> eject_flow(
         ~valid: ex_mem_pipe.ingress.valid,
         ~bits: ex_mem_pipe.ingress.bits
       )

  def execute_transfer = branch_resolver.result.valid
  execute_fault_event <== execute_transfer & execute_fault
  def taken_branches = filter_valid(branch_result => !execute_fault & branch_result.taken)
  def redirect_targets = map_valid(branch_result => computed_redirect_target)
  (branch_resolver.result |> taken_branches |> redirect_targets) <=> redirect_link.left

  // Memory advances every non-faulting instruction into WB. Non-load results
  // can already bypass here, but no instruction commits at this boundary.
  def memory_writes_immediately = memory.bits.writeback_enable & !memory_is_load

  mem_wb_pipe.ingress.valid <== memory.valid
  mem_wb_pipe.ingress.bits <== MemoryWriteback(xlen):
    memory_operation: memory.bits.memory_operation
    write_enable: memory.bits.writeback_enable
    rd: memory.bits.rd
    value: memory.bits.result

  memory_bypass_link.left.valid <== memory.valid & memory_writes_immediately & or_reduce(memory.bits.rd)
  memory_bypass_link.left.bits <== RicketBypass(xlen):
    rd: memory.bits.rd
    value: memory.bits.result

  // The two register-file write ports accept an ordinary committed WB result
  // and a committed load completion independently. The L1D's registered hit
  // response arrives here; a miss completion can arrive later.
  def immediate_write_valid = commit.valid & commit.bits.write_enable & !commit_is_load

  writeback_bypass_link.left.valid <== immediate_write_valid & or_reduce(commit.bits.rd)
  writeback_bypass_link.left.bits <== RicketBypass(xlen):
    rd: commit.bits.rd
    value: commit.bits.value

  registers.write_enable_1 <== immediate_write_valid
  registers.write_address_1 <== commit.bits.rd
  registers.write_data_1 <== commit.bits.value
  registers.write_enable_2 <== load_completion.valid
  registers.write_address_2 <== load_completion.bits.tag
  registers.write_data_2 <== load_completion.bits.data

export:
  RicketCore
