#lang rhdl
// Implements a width-parameterized combinational integer ALU from decoded controls.

import:
  "../riscv/isa/xlen.rhm" open

// The nominal one-hot enum names each mutually exclusive result family while
// preserving a direct selector bit for the decoder and datapath.
hardware_enum AluResultSelect(~encoding: one_hot):
  Arithmetic
  Shift
  Compare
  Xor
  Or
  And

bundle AluControl():
  result_select: AluResultSelect
  subtract: Bool
  signed_mode: Bool
  shift_right: Bool
  word: Bool

// RV64 word operations compute modulo 32 bits, then use the standard signed
// layer to extend their two's-complement result back to the 64-bit interface.
fun sign_extend_word(value :: Bits(32)) :: Bits(64):
  as_bits(sext(value.into(SInt(32)), 64))

circuit ALU(xlen :: XLen):
  def width = xlen_width(xlen)

  input(left, right): Bits(width)
  input control: AluControl()
  output result: Bits(width)

  def result_select = control.result_select
  def subtract = control.subtract
  def signed_mode = control.signed_mode
  def shift_right = control.shift_right
  def word = control.word
  // Word mode exists only in the RV64 specialization. In an RV32 ALU the
  // control bit is deliberately inert, so the same control bundle remains
  // reusable without elaborating a redundant narrow datapath.
  def use_word = if xlen == XLen.X64 | word & ((result_select === AluResultSelect.Arithmetic) ||| (result_select === AluResultSelect.Shift)) | Bool(#false)

  def word_shift_amount = right[0..5]
  def shift_amount = if xlen == XLen.X64 | right[0..6] | word_shift_amount
  def effective_shift_amount = if xlen == XLen.X64 | mux(word, zext(word_shift_amount, 6), shift_amount) | shift_amount
  def add_result :: Bits(width) = left + right
  def sub_result :: Bits(width) = left - right
  def unsigned_less = left < right
  def left_sign = left[width - 1].into(Bool)
  def right_sign = right[width - 1].into(Bool)
  def signed_less = mux(left_sign ^ right_sign, left_sign, unsigned_less)

  // RV64 word shifts steer five shift bits and an extended low word into the
  // shared shifters. RV32 specializes these host branches to its native data
  // and five-bit shift paths, avoiding illegal equal-width extensions.
  def sll_result :: Bits(width) = left << effective_shift_amount
  def srl_input = if xlen == XLen.X64 | mux(word, zext(left[0..32], 64), left) | left
  def srl_result :: Bits(width) = srl_input >> effective_shift_amount
  def sra_input = if xlen == XLen.X64 | mux(word, sext(left[0..32].into(SInt(32)), 64), left.into(SInt(64))) | left.into(SInt(32))
  def sra_result :: SInt(width) = sra_input >> effective_shift_amount
  def sra_bits :: Bits(width) = as_bits(sra_result)

  def arithmetic_result = mux(subtract, sub_result, add_result)
  def comparison :: Bool = mux(signed_mode, signed_less, unsigned_less)
  def shift_result = mux(
    shift_right,
    mux(signed_mode, sra_bits, srl_result),
    sll_result
  )

  def selected_result :: Bits(width) = result_select.mux({
    AluResultSelect.Arithmetic: arithmetic_result,
    AluResultSelect.Shift: shift_result,
    AluResultSelect.Compare: zext(as_bits(comparison), width),
    AluResultSelect.Xor: left ^ right,
    AluResultSelect.Or: left ||| right,
    AluResultSelect.And: left & right
  })

  // Every RV64 word operation shares this final low-word sign extension; the
  // RV32 specialization returns its full-width result directly.
  def final_result = if xlen == XLen.X64 | mux(use_word, sign_extend_word(selected_result[0..32]), selected_result) | selected_result
  result <== final_result

export:
  AluResultSelect
  AluControl
  ALU
