#lang rhdl
// Exposes the shared load/store generators and alignment helper through one test circuit.

import:
  "../load-store.rhdl" open
  "../../riscv/isa/xlen.rhm" open

circuit LoadStoreFixture(xlen :: XLen):
  input address: Bits(xlen_width(xlen))
  input load_data: Bits(64)
  input store_value: Bits(xlen_width(xlen))
  input width: MemoryWidth
  input unsigned_load: Bool
  output aligned: Bool
  output load_value: Bits(xlen_width(xlen))
  output store_data: Bits(64)
  output store_mask: Bits(8)

  inst load_gen(LoadGen(xlen))
  inst store_gen(StoreGen(xlen))

  load_gen.address <== address
  load_gen.data <== load_data
  load_gen.width <== width
  load_gen.unsigned_load <== unsigned_load
  store_gen.address <== address
  store_gen.value <== store_value
  store_gen.width <== width

  aligned <== memory_access_aligned(address, width)
  load_value <== load_gen.value
  store_data <== store_gen.data
  store_mask <== store_gen.mask

export:
  LoadStoreFixture
