#lang rhombus
// Checks the iterative multiplier's generic transaction types and hardware shape.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../multiplier.rhdl" as multiplier

def design = embedded.run_elaboration(fun (): multiplier.IterativeMultiplier(8))
def module_def = design.modules[0]
def request_type = multiplier.MultiplierRequest(8)
def mode_type = multiplier.MultiplierMode()
def registers = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
)

check:
  request_type.fields.map(fun (field): field.name) ~is ["left", "right", "mode"]
  request_type.field("left").type.width ~is 8
  request_type.field("right").type.width ~is 8
  type_equal(request_type.field("mode").type, mode_type) ~is #true
  mode_type.fields.map(fun (field): field.name) ~is ["left_signed", "right_signed"]
  module_def.find_input("request_in").type.field("bits").type.field("left").type.width ~is 8
  module_def.find_output("response_out").type.field("bits").type.width ~is 16
  registers.map(fun (operation): operation.attribute("name")) ~is [
    "active", "count", "multiplicand", "multiplier", "accumulator",
    "negate_result", "response_valid", "response_bits"
  ]
  module_def.operations.filter(~keep: fun (operation): operation.opcode == "rtl.mul").length() ~is 0
  verify_design(design) ~is #void
