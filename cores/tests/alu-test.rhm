#lang rhombus
// Checks the shared RV32/RV64 integer, B, and Zicond ALU contract and shape.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/frontend/layers/bool.rhm" as bool
  "../../rhdl/frontend/layers/enum.rhm" as enum
  "../../riscv/isa/xlen.rhm" open
  "../alu.rhdl" as alu

def design64 = embedded.run_elaboration(fun (): alu.ALU(XLen.X64))
def design32 = embedded.run_elaboration(fun (): alu.ALU(XLen.X32))
def module64 = design64.modules[0]
def module32 = design32.modules[0]
def control_type = alu.AluControl()
def control_fields = [
  "result_select", "logic_select", "count_select", "unary_select", "subtract", "signed_compare",
  "maximum", "shift_right", "arithmetic_shift", "extract_bit",
  "invert_right", "logic_right_select", "unsigned_word", "shift_add_amount",
  "word"
]
fun operations(module_def, opcode):
  module_def.operations.filter(~keep: fun (operation): operation.opcode == opcode)
fun state_operations(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  )

check:
  enum.enum_members(alu.AluResultSelect) ~is [
    "Adder", "Shift", "Logic", "Compare", "MinMax", "Count", "Rotate", "Unary"
  ]
  enum.enum_members(alu.AluLogicSelect) ~is ["And", "Or", "Xor"]
  enum.enum_members(alu.AluLogicRightSelect) ~is ["Operand", "OneHot", "ConditionalMask"]
  enum.enum_members(alu.AluCountSelect) ~is ["Leading", "Trailing", "Population"]
  enum.enum_members(alu.AluUnarySelect) ~is [
    "OrCombineBytes", "ReverseBytes", "SignExtendByte", "SignExtendHalf", "ZeroExtendHalf"
  ]
  control_type.fields.map(fun (field): field.name) ~is control_fields
  type_equal(control_type.field("result_select").type, alu.AluResultSelect) ~is #true
  type_equal(control_type.field("logic_select").type, alu.AluLogicSelect) ~is #true
  type_equal(control_type.field("logic_right_select").type, alu.AluLogicRightSelect) ~is #true
  type_equal(control_type.field("count_select").type, alu.AluCountSelect) ~is #true
  type_equal(control_type.field("unary_select").type, alu.AluUnarySelect) ~is #true
  type_equal(control_type.field("word").type, bool.Bool) ~is #true
  control_type.packed_width() ~is 23
  type_equal(module64.find_input("left").type, Bits(64)) ~is #true
  type_equal(module64.find_input("right").type, Bits(64)) ~is #true
  type_equal(module64.find_input("control").type, control_type) ~is #true
  type_equal(module64.find_output("result").type, Bits(64)) ~is #true
  type_equal(module32.find_input("left").type, Bits(32)) ~is #true
  type_equal(module32.find_input("right").type, Bits(32)) ~is #true
  type_equal(module32.find_input("control").type, control_type) ~is #true
  type_equal(module32.find_output("result").type, Bits(32)) ~is #true
  (for all (field in control_fields):
     operations(module64, "rtl.record_get").map(fun (operation): operation.attribute("field")).contains(field)) ~is #true
  operations(module64, "rtl.lt").length() ~is 0
  operations(module64, "rtl.mux_lookup").length() >= 2 ~is #true
  operations(module32, "rtl.shl").map(fun (operation): operation.operands[1].type.width).contains(6) ~is #false
  state_operations(module64).length() ~is 0
  state_operations(module32).length() ~is 0
  verify_design(design64) ~is #void
  verify_design(design32) ~is #void
  embedded.run_elaboration(fun (): alu.ALU(64)) ~throws "XLen"
