#lang rhombus
// Checks the RV64I ALU control contract, shared datapath shape, and result type.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/frontend/layers/bool.rhm" as bool
  "../../rhdl/frontend/layers/enum.rhm" as enum
  "../alu.rhdl" as alu

def design = embedded.run_elaboration(fun (): alu.ALU())
def module_def = design.modules[0]
def control_type = alu.AluControl()
def control_fields = [
  "result_select",
  "subtract",
  "signed_mode",
  "shift_right",
  "word"
]
def control_extracts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.record_get"
)
def comparison_extensions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.zext" && operation.operands[0].type.width == 1
)
def word_extensions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.sext"
)
def result_mux = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.onehot_mux"
)
def result_driver = module_def.find_output("result").place.driver
def final_mux = module_def.find_operation(result_driver.defining_op_id)
def word_qualifier = module_def.operations.find(
  fun (operation):
    operation.opcode == "rtl.and" && type_equal(operation.results[0].type, bool.Bool)
)
def word_capability = module_def.find_operation(word_qualifier.operands[1].defining_op_id)

check:
  record_type(control_type) ~is #true
  enum.enum_type(alu.AluResultSelect) ~is #true
  enum.enum_members(alu.AluResultSelect) ~is [
    "Arithmetic",
    "Shift",
    "Compare",
    "Xor",
    "Or",
    "And"
  ]
  control_type.fields.map(fun (field): field.name) ~is control_fields
  type_equal(control_type.fields[0].type, alu.AluResultSelect) ~is #true
  (for all (field in control_type.fields.drop(1)):
     type_equal(field.type, bool.Bool)) ~is #true
  packed_width(control_type) ~is 10
  type_equal(module_def.find_input("left").type, Bits(64)) ~is #true
  type_equal(module_def.find_input("right").type, Bits(64)) ~is #true
  type_equal(module_def.find_input("control").type, control_type) ~is #true
  type_equal(module_def.find_output("result").type, Bits(64)) ~is #true
  control_extracts.length() ~is 5
  control_extracts.map(fun (operation): operation.attribute("field")) ~is control_fields
  result_mux.operands.length() ~is 7
  type_equal(result_mux.operands[0].type, Bits(6)) ~is #true
  type_equal(result_mux.results[0].type, Bits(64)) ~is #true
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.onehot_mux"
  ).length() ~is 1
  final_mux.opcode ~is "rtl.mux_lookup"
  final_mux.attribute("keys") ~is [1]
  word_qualifier.opcode ~is "rtl.and"
  word_capability.opcode ~is "rtl.or"
  comparison_extensions.length() ~is 1
  comparison_extensions.map(fun (operation): operation.operands[0].type.width) ~is [1]
  word_extensions.length() ~is 2
  word_extensions.map(fun (operation): operation.results[0].type.width) ~is [64, 64]
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.add"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.sub"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.ult"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.slt"
  ).length() ~is 0
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.shrs"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.shl"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.shru"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.zext" && operation.operands[0].type.width == 5 && operation.results[0].type.width == 6
  ).length() ~is 3
  module_def.operations.find(
    fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ) ~is #false
  verify_design(design) ~is #void
