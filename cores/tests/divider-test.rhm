#lang rhombus
// Checks the iterative divider's generic transaction types and hardware shape.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../divider.rhdl" as divider

def design = embedded.run_elaboration(fun (): divider.IterativeDivider(8))
def module_def = design.modules[0]
def request_type = divider.DividerRequest(8)
def response_type = divider.DividerResponse(8)
def registers = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
)

check:
  request_type.fields.map(fun (field): field.name) ~is ["dividend", "divisor", "signed_mode"]
  request_type.field("dividend").type.width ~is 8
  request_type.field("divisor").type.width ~is 8
  response_type.fields.map(fun (field): field.name) ~is ["quotient", "remainder"]
  response_type.field("quotient").type.width ~is 8
  response_type.field("remainder").type.width ~is 8
  type_equal(module_def.find_input("request_in").type.field("bits").type, request_type) ~is #true
  type_equal(module_def.find_output("response_out").type.field("bits").type, response_type) ~is #true
  registers.map(fun (operation): operation.attribute("name")) ~is [
    "active", "count", "dividend", "divisor", "partial_remainder",
    "negate_quotient", "negate_remainder", "divide_by_zero",
    "original_dividend", "response_valid", "response_bits"
  ]
  module_def.operations.filter(~keep: fun (operation): operation.opcode == "rtl.divu").length() ~is 0
  verify_design(design) ~is #void
