#lang rhombus
// Checks the reusable load/store generators' types, ports, and combinational structure.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/frontend/layers/bool.rhm" as bool
  "../../rhdl/frontend/layers/enum.rhm" as enum
  "../../riscv/isa/xlen.rhm" open
  "../load-store.rhdl" as load_store
  "load-store-fixture.rhdl" as fixture

def load_design = embedded.run_elaboration(fun (): load_store.LoadGen(XLen.X64))
def load_module = load_design.modules[0]
def store_design = embedded.run_elaboration(fun (): load_store.StoreGen(XLen.X64))
def store_module = store_design.modules[0]
def rv32_load_design = embedded.run_elaboration(fun (): load_store.LoadGen(XLen.X32))
def rv32_load_module = rv32_load_design.modules[0]
def rv32_store_design = embedded.run_elaboration(fun (): load_store.StoreGen(XLen.X32))
def rv32_store_module = rv32_store_design.modules[0]
def rv32_word_load_design = embedded.run_elaboration(fun (): load_store.LoadGen(XLen.X32, 4))
def rv32_word_load_module = rv32_word_load_design.modules[0]
def rv32_word_store_design = embedded.run_elaboration(fun (): load_store.StoreGen(XLen.X32, 4))
def rv32_word_store_module = rv32_word_store_design.modules[0]
def fixture_design = embedded.run_elaboration(fun (): fixture.LoadStoreFixture(XLen.X64))
def fixture_top = fixture_design.modules[0]
fun state_operations(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || (
      operation.opcode == "rtl.register_reset"
    )
  )

check:
  enum.enum_members(load_store.MemoryWidth) ~is [
    "Byte", "Half", "Word", "Double"
  ]
  load_store.MemoryWidth.packed_width() ~is 2
  load_module.inputs.map(fun (port): port.name) ~is [
    "address", "data", "width", "unsigned_load"
  ]
  load_module.outputs.map(fun (port): port.name) ~is ["value"]
  type_equal(load_module.find_input("address").type, Bits(64)) ~is #true
  type_equal(load_module.find_input("data").type, Bits(64)) ~is #true
  type_equal(load_module.find_input("width").type,
             load_store.MemoryWidth) ~is #true
  type_equal(load_module.find_input("unsigned_load").type,
             bool.Bool) ~is #true
  type_equal(load_module.find_output("value").type, Bits(64)) ~is #true
  state_operations(load_module).length() ~is 0
  verify_design(load_design) ~is #void

  store_module.inputs.map(fun (port): port.name) ~is [
    "address", "value", "width"
  ]
  store_module.outputs.map(fun (port): port.name) ~is ["data", "mask"]
  type_equal(store_module.find_output("data").type, Bits(64)) ~is #true
  type_equal(store_module.find_output("mask").type, bool.Mask(8)) ~is #true
  state_operations(store_module).length() ~is 0
  verify_design(store_design) ~is #void

  type_equal(rv32_load_module.find_input("address").type, Bits(32)) ~is #true
  type_equal(rv32_load_module.find_input("data").type, Bits(64)) ~is #true
  type_equal(rv32_load_module.find_output("value").type, Bits(32)) ~is #true
  type_equal(rv32_store_module.find_input("value").type, Bits(32)) ~is #true
  type_equal(rv32_store_module.find_output("data").type, Bits(64)) ~is #true
  verify_design(rv32_load_design) ~is #void
  verify_design(rv32_store_design) ~is #void

  type_equal(rv32_word_load_module.find_input("data").type, Bits(32)) ~is #true
  type_equal(rv32_word_load_module.find_output("value").type, Bits(32)) ~is #true
  type_equal(rv32_word_store_module.find_output("data").type, Bits(32)) ~is #true
  type_equal(rv32_word_store_module.find_output("mask").type, bool.Mask(4)) ~is #true
  verify_design(rv32_word_load_design) ~is #void
  verify_design(rv32_word_store_design) ~is #void

  fixture_design.modules.map(fun (module_def): module_def.name) ~is [
    "LoadStoreFixture", "LoadGen", "StoreGen"
  ]
  fixture_top.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).length() ~is 2
  verify_design(fixture_design) ~is #void
  embedded.run_elaboration(fun (): load_store.LoadGen(64)) ~throws "XLen"
  embedded.run_elaboration(
    fun (): load_store.LoadGen(XLen.X64, 4)
  ) ~throws "complete XLEN word"
  embedded.run_elaboration(
    fun (): load_store.StoreGen(XLen.X64, 4)
  ) ~throws "complete XLEN word"
