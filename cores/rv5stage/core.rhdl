#lang rhodium
// Implements RV5Stage's five-stage core with explicit ready-valid wiring.

import:
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../load-store.rhdl" open
  "memory.rhdl" open
  "decode/core-ctrl.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/branch-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/fence-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open
  "bundles.rhdl" open
  "csr.rhdl" open
  "interrupt.rhdl" open
  "multiply.rhdl" open
  "divide.rhdl" open
  "fp-pipeline.rhdl" open
  "fp-bundles.rhdl" open
  "decode/fp-ctrl.rhdl" open
  "register-file.rhdl" open
  "icache/protocol.rhdl" open
  "dcache/protocol.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/trap.rhm" open
  "../../riscv/rtl/trap.rhdl" open
  "../../riscv/model/formats.rhm" as riscv_fields
  "../../riscv/rtl/instruction-fields.rhdl" open
  "../../riscv/rtl/floating-point.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("rhodium/std/flow/arbiter.rhdl") open
  lib("rhodium/std/flow/pipe.rhdl") open
  lib("rhodium/std/flow/queue.rhdl") open
  lib("rhodium/std/scoreboard.rhdl") open

sync_circuit RV5StageCore(xlen :: XLen,
                          profile :: FloatingPointProfile = DefaultFloatingPointProfile):
  check_rv5stage_floating_point_profile(xlen, profile)
  def width = xlen.width
  def register_count = 32
  def effective_fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D

  interface start(Irrevocable(Bits(width)), ~role: consumer)
  input interrupts: RV5StageInterrupts()
  input hart_id: Bits(width)
  input time_counter: Bits(64)
  interface instruction_access(RV5StageInstructionAccess(xlen), ~role: requester)
  interface data_access(RV5StageDataAccess(xlen), ~role: requester)
  output fault: Bool
  output privilege: PrivilegeMode
  output mstatus: Bits(width)
  output satp: Bits(width)
  output translation_flush: Bool

  def zero = bits(0, width)
  fun instruction_value(instruction :: Bits(32)):
    if width == 32 | instruction | instruction.zext(width)
  fun deferred_writeback(source :: WritebackSelect):
    source.is_one_of(WritebackSelect.Memory, WritebackSelect.Multiply, WritebackSelect.Divide)
  fun serializing_operation(system :: SystemControl(), fence :: FenceControl()) :~ Bool:
    system.is_system_operation() ||| fence.is_fence_operation()
  reg faulted(~init: Bool(#false))
  reg fp_store_requested(~init: Bool(#false))
  reg pending_exception_valid(~init: Bool(#false))
  reg pending_exception(MemoryWriteback(xlen))

  // IF/ID and ID/EX are elastic. Once Execute accepts any cache request, the
  // EX/MEM and MEM/WB boundaries advance feed-forward without backpressure.
  inst if_id_pipe(Pipe(FetchDecode(xlen), 1))
  inst id_ex_pipe(Pipe(DecodeExecute(xlen), 1))
  inst ex_mem_pipe(ValidPipe(ExecuteMemory(xlen), 1))
  inst mem_wb_pipe(ValidPipe(MemoryWriteback(xlen), 1))

  inst decoder(RV5StageInstructionDecoder(xlen, profile))
  inst registers(RV5StageRegisterFile(xlen))
  inst alu(ALU(xlen))
  inst branch_resolver(BranchResolver(width))
  inst multiplier(RV5StageMultiplier(xlen))
  inst divider(RV5StageDivider(xlen))
  inst scoreboard(Scoreboard(register_count))
  inst fp_integer_scoreboard(Scoreboard(register_count))
  def FpModule = if floating_point_supports_f(profile) | RV5StageFpPipeline(xlen, effective_fp_profile, Bits(width)) | RV5StageDisabledFpPipeline(xlen, effective_fp_profile, Bits(width))
  inst fp(FpModule)
  inst csrs(RV5StageCsrFile(xlen, profile))
  csrs.interrupts <== interrupts
  csrs.hart_id <== hart_id
  csrs.time_counter <== time_counter
  fp.state_update <=> csrs.fp_update

  // Name the pipeline boundaries once so later sections can be presented in
  // stage order while still observing downstream occupancy and results.
  def id_ex = id_ex_pipe.egress
  def memory = ex_mem_pipe.egress
  def commit = mem_wb_pipe.egress
  def Array(commit_write :: Endpoint, deferred_completion_write :: Endpoint) = registers.writes

  fault <== faulted
  privilege <== csrs.privilege
  mstatus <== csrs.mstatus
  satp <== csrs.satp

  // Backward-traveling observations use local Valid interface links. Their
  // producers remain in their pipeline stages below, despite earlier stages
  // consuming their values. The payloadless fault event remains a Bool wire.
  wire execute_exception_event: Bool
  def redirect_link :: Handle = interface_link(Valid(Bits(width)))
  def execute_redirect_link :: Handle = interface_link(Valid(Bits(width)))
  def memory_bypass_link :: Handle = interface_link(Valid(RV5StageBypass(xlen)))
  def writeback_bypass_link :: Handle = interface_link(Valid(RV5StageBypass(xlen)))
  def scoreboard_set_link :: Handle = interface_link(Valid(Bits(5)))
  def scoreboard_clear_link :: Handle = interface_link(Valid(Bits(5)))
  scoreboard.set.valid <== scoreboard_set_link.right.valid
  scoreboard.set.bits <== scoreboard_set_link.right.bits
  scoreboard.clear.valid <== scoreboard_clear_link.right.valid
  scoreboard.clear.bits <== scoreboard_clear_link.right.bits
  def fence_i_commit = commit.valid & commit.bits.fence.is_instruction_fence()
  translation_flush <== csrs.translation_flush
  def fence_resume_pc = commit.bits.pc + bits(4, width)
  def fence_commit = fence_i_commit ||| csrs.translation_flush
  def commit_redirect = csrs.redirect.valid ||| fence_commit
  redirect_link.left.valid <== csrs.redirect.valid ||| fence_commit ||| execute_redirect_link.right.valid
  redirect_link.left.bits <== mux(
    csrs.redirect.valid,
    csrs.redirect.bits,
    mux(fence_commit, fence_resume_pc, execute_redirect_link.right.bits)
  )

  // Fetch (IF) owns request correlation state, while IF/ID storage belongs to
  // its Pipe. Redirects and faults flush both pending PCs and the L1I's
  // lookup/response path, so no generation tag crosses this interface.
  def exception_in_flight = pending_exception_valid ||| (memory.valid & memory.bits.exception_valid) ||| (
    commit.valid & commit.bits.exception_valid
  )
  def squash = faulted ||| execute_exception_event ||| exception_in_flight ||| (
    redirect_link.right.valid
  )
  reg started(~init: Bool(#false))
  reg fetch_pc(~init: zero)
  reg architectural_pc(~init: zero)
  start.ready <== !started & !(faulted ||| execute_exception_event)
  def start_fire = start.fire()
  def start_fault = start_fire & !is_aligned(start.bits, 4)
  def fetch_flush = start_fault ||| execute_exception_event ||| redirect_link.right.valid
  inst fetch_pcs(Queue(Bits(width), 2, ~pipe: #true), ~reset_when: fetch_flush)
  instruction_access.flush <== fetch_flush
  instruction_access.invalidate_all <== fence_i_commit
  def fetch_valid = started & !squash & !csrs.interrupt_request
  instruction_access.request.valid <== fetch_valid & fetch_pcs.ingress.ready
  instruction_access.request.bits <== RV5StageInstructionReq(xlen):
    address: fetch_pc
  fetch_pcs.ingress.valid <== fetch_valid & instruction_access.request.ready
  fetch_pcs.ingress.bits <== fetch_pc
  when start_fire:
    started <== Bool(#true)
  when (redirect_link.right.valid):
    fetch_pc <== redirect_link.right.bits
  elsewhen start_fire:
    fetch_pc <== start.bits
  elsewhen (instruction_access.request.fire()):
    fetch_pc <== fetch_pc + bits(4, width)
  when (csrs.redirect.valid):
    architectural_pc <== csrs.redirect.bits
  elsewhen start_fire:
    architectural_pc <== start.bits
  elsewhen (commit.valid & !commit.bits.exception_valid):
    architectural_pc <== commit.bits.resume_pc

  def fetch_pair_ready = squash ||| if_id_pipe.ingress.ready
  instruction_access.response.ready <== fetch_pair_ready & fetch_pcs.egress.valid
  fetch_pcs.egress.ready <== fetch_pair_ready & instruction_access.response.valid
  if_id_pipe.ingress.valid <== instruction_access.response.valid & fetch_pcs.egress.valid & !squash
  if_id_pipe.ingress.bits <== FetchDecode(xlen):
    pc: fetch_pcs.egress.bits
    instruction: instruction_access.response.bits.instruction
    instruction_page_fault: instruction_access.response.bits.page_fault
    instruction_access_fault: instruction_access.response.bits.access_fault
  def decode_valid = if_id_pipe.egress.valid & !squash
  def decode_bits = if_id_pipe.egress.bits

  when start_fault:
    faulted <== Bool(#true)

  // Decode (ID) is ordinary combinational logic between IF/ID and ID/EX.
  // Filtering consumes squashed tokens; gating holds a token that depends on
  // deferred work which has not yet reached the WB commit point.
  def instruction = decode_bits.instruction
  decoder.instruction <== instruction
  def control :: RV5StageControl() = decoder.control

  def rs1 = instruction_field(riscv_fields.rs1, instruction)
  def rs2 = instruction_field(riscv_fields.rs2, instruction)
  def rd = instruction_field(riscv_fields.rd, instruction)
  def frs3 = instruction_field(riscv_fields.rs3, instruction)
  def fp_rounding = riscv_rounding_mode(instruction_field(riscv_fields.rm, instruction), csrs.frm)
  def decoded_immediate = mux_lookup(
    control.operand.immediate,
    ~default: bits(0, width),
    [
      [ImmediateSelect.I,
       instruction_immediate(riscv_fields.IImmediate, instruction, width)],
      [ImmediateSelect.S,
       instruction_immediate(riscv_fields.SImmediate, instruction, width)],
      [ImmediateSelect.B,
       instruction_immediate(riscv_fields.BImmediate, instruction, width)],
      [ImmediateSelect.U,
       instruction_immediate(riscv_fields.UImmediate, instruction, width)],
      [ImmediateSelect.J,
       instruction_immediate(riscv_fields.JImmediate, instruction, width)]
    ]
  )

  registers.read_address_1 <== id_ex.bits.rs1
  registers.read_address_2 <== id_ex.bits.rs2
  fun rv5stage_register_busy(index :: Bits(5)):
    (
      scoreboard_busy(register_count, scoreboard.busy, index) ||| scoreboard_busy(
        register_count,
        fp_integer_scoreboard.busy,
        index
      ) ||| (
        scoreboard_set_link.right.valid & (scoreboard_set_link.right.bits === index)
      ) ||| (
        id_ex.valid & id_ex.bits.floating_point_valid & (
          id_ex.bits.floating_point_control.registers.destination === RV5StageFloatDestination.Integer
        ) & (id_ex.bits.rd === index)
      )
    ) & !(
      scoreboard_clear_link.right.valid & (scoreboard_clear_link.right.bits === index)
    )

  def id_ex_is_deferred = id_ex.valid & deferred_writeback(id_ex.bits.writeback_source)
  def memory_is_deferred = memory.valid & deferred_writeback(memory.bits.writeback_source)
  fun conflicts_with_deferred(deferred_valid :: Bool,
                              deferred_destination :: Bits(5)):
    deferred_valid & or_reduce(deferred_destination) & (
      (control.operand.uses_rs1 & (deferred_destination === rs1)) ||| (
        control.operand.uses_rs2 & (deferred_destination === rs2)
      ) ||| (
        (control.writeback.enable ||| (
          control.floating_point_valid & (
            control.floating_point.registers.destination === RV5StageFloatDestination.Integer
          )
        )) & (deferred_destination === rd)
      )
    )
  def deferred_dependency_hazard = decode_valid & (
    conflicts_with_deferred(id_ex_is_deferred, id_ex.bits.rd) ||| (
      conflicts_with_deferred(memory_is_deferred, memory.bits.rd)
    )
  )
  def scoreboard_raw_hazard = (
    control.operand.uses_rs1 & or_reduce(rs1) & rv5stage_register_busy(rs1)
  ) ||| (
    control.operand.uses_rs2 & or_reduce(rs2) & rv5stage_register_busy(rs2)
  )
  def decoded_integer_write = control.writeback.enable ||| (
    control.floating_point_valid & (
      control.floating_point.registers.destination === RV5StageFloatDestination.Integer
    )
  )
  def scoreboard_waw_hazard = decoded_integer_write & or_reduce(rd) & rv5stage_register_busy(rd)
  fun rv5stage_fp_register_busy(index :: Bits(5)):
    scoreboard_busy(register_count, fp.busy, index) ||| (
      id_ex.valid & id_ex.bits.floating_point_valid & (
        id_ex.bits.floating_point_control.registers.destination === RV5StageFloatDestination.FloatingPoint
      ) & (id_ex.bits.rd === index)
    )
  def fp_source_hazard = control.floating_point_valid & (
    (control.floating_point.registers.uses_frs1 & rv5stage_fp_register_busy(rs1)) ||| (
      control.floating_point.registers.uses_frs2 & rv5stage_fp_register_busy(rs2)
    ) ||| (
      control.floating_point.registers.uses_frs3 & rv5stage_fp_register_busy(frs3)
    )
  )
  def fp_destination_hazard = control.floating_point_valid & (
    control.floating_point.registers.destination === RV5StageFloatDestination.FloatingPoint
  ) & rv5stage_fp_register_busy(rd)
  def serializing_in_id_ex = id_ex.valid & serializing_operation(id_ex.bits.system, id_ex.bits.fence)
  def serializing_in_memory = memory.valid & serializing_operation(memory.bits.system, memory.bits.fence)
  def serializing_in_commit = commit.valid & serializing_operation(commit.bits.system, commit.bits.fence)
  def serializing_in_flight = serializing_in_id_ex ||| serializing_in_memory ||| serializing_in_commit
  def commit_is_deferred = commit.valid & deferred_writeback(
    commit.bits.writeback_source
  ) & commit.bits.write_enable
  def deferred_state_pending = id_ex_is_deferred ||| memory_is_deferred ||| (
    commit_is_deferred
  ) ||| or_reduce(scoreboard.busy) ||| scoreboard_set_link.right.valid ||| (
    or_reduce(fp_integer_scoreboard.busy) ||| !fp.drained
  )
  def serializing_waits_for_deferred = serializing_operation(control.system, control.fence) & deferred_state_pending
  def fence_waits_for_data = control.fence.is_fence_operation() & !data_access.drained
  def pipeline_hazard = deferred_dependency_hazard ||| scoreboard_raw_hazard ||| (
    scoreboard_waw_hazard ||| fp_source_hazard ||| fp_destination_hazard
  ) ||| serializing_in_flight ||| serializing_waits_for_deferred ||| fence_waits_for_data ||| csrs.interrupt_request ||| exception_in_flight ||| (
    execute_exception_event
  )
  if_id_pipe.egress.ready <== squash ||| (id_ex_pipe.ingress.ready & !pipeline_hazard)
  id_ex_pipe.ingress.valid <== decode_valid & !pipeline_hazard
  id_ex_pipe.ingress.bits <== DecodeExecute(xlen):
    pc: decode_bits.pc
    instruction: decode_bits.instruction
    alu_control: control.alu
    operand_left: control.operand.left
    operand_right: control.operand.right
    branch_control: control.branch.resolver
    target_from_rs1: control.branch.target_from_rs1
    memory_operation: control.memory.access
    memory_atomic: control.memory.atomic
    memory_width: control.memory.width
    memory_unsigned: control.memory.unsigned
    multiply_control: control.multiply
    divide_control: control.divide
    floating_point_valid: control.floating_point_valid
    floating_point_control: control.floating_point
    floating_point_rounding_mode_valid: fp_rounding.valid
    floating_point_rounding_mode: fp_rounding.mode
    writeback_enable: control.writeback.enable
    writeback_source: control.writeback.source
    system: control.system
    fence: control.fence
    illegal: !decoder.valid ||| (
      control.floating_point_valid & (
        !csrs.fp_enabled ||| (
          control.floating_point.execution.uses_rounding_mode & !fp_rounding.valid
        )
      )
    )
    instruction_page_fault: if_id_pipe.egress.bits.instruction_page_fault
    instruction_access_fault: if_id_pipe.egress.bits.instruction_access_fault
    immediate: decoded_immediate
    rs1: rs1
    rs2: rs2
    rd: rd
    frs3: frs3

  // Execute (EX) consumes the registered ID/EX token. Forwarding is live and
  // sampled together with the other effects when Execute transfers.
  fun forwarded_register_value(index :: Bits(5),
                               register_value :: Bits(width)):
    mux(
      memory_bypass_link.right.valid & (memory_bypass_link.right.bits.rd === index),
      memory_bypass_link.right.bits.value,
      mux(
        writeback_bypass_link.right.valid & (writeback_bypass_link.right.bits.rd === index),
        writeback_bypass_link.right.bits.value,
        register_value
      )
    )
  def forwarded_rs1 = forwarded_register_value(id_ex.bits.rs1, registers.read_data_1)
  def forwarded_rs2 = forwarded_register_value(id_ex.bits.rs2, registers.read_data_2)

  alu.left <== mux_lookup(
    id_ex.bits.operand_left,
    ~default: forwarded_rs1,
    [
      [OperandASelect.Pc, id_ex.bits.pc],
      [OperandASelect.Zero, bits(0, width)]
    ]
  )
  alu.right <== mux(
    id_ex.bits.operand_right === OperandBSelect.Immediate,
    id_ex.bits.immediate,
    forwarded_rs2
  )
  alu.control <== id_ex.bits.alu_control

  def redirect_requested = branch_resolver.result.bits.taken
  def computed_redirect_target :: Bits(width) = mux(
    id_ex.bits.target_from_rs1,
    (forwarded_rs1 + id_ex.bits.immediate) & !bits(1, width),
    id_ex.bits.pc + id_ex.bits.immediate
  )
  def redirect_aligned = is_aligned(computed_redirect_target, 4)
  def memory_aligned = id_ex.bits.memory_width.is_aligned(alu.result)
  def execute_memory_operation :: MemoryOperation = id_ex.bits.memory_operation
  def execute_is_memory = execute_memory_operation.is_memory()
  def fp_execution_control :: RV5StageFloatExecutionControl() = id_ex.bits.floating_point_control.execution
  def execute_is_fp = id_ex.bits.floating_point_valid
  def execute_fp_memory = execute_is_fp & (fp_execution_control.unit === RV5StageFloatUnit.Memory)
  def execute_fp_store = execute_fp_memory & fp_execution_control.memory_write
  def execute_fp_load = execute_fp_memory & !fp_execution_control.memory_write
  def execute_fp_compute = execute_is_fp & !execute_fp_memory
  def execute_request_fault = id_ex.bits.instruction_page_fault ||| id_ex.bits.instruction_access_fault ||| id_ex.bits.illegal ||| (
    execute_is_memory & !memory_aligned
  )
  def data_page_fault = execute_is_memory & data_access.request_fault
  def data_access_fault = execute_is_memory & data_access.request_access_fault
  def redirect_fault = redirect_requested & !redirect_aligned
  fun exception(cause :: ExceptionCause, value :: Bits(width)):
    RV5StageException(xlen):
      valid: Bool(#true)
      cause: exception_cause_bits(cause, width)
      value: value
  fun memory_exception(store_cause :: ExceptionCause, load_cause :: ExceptionCause):
    RV5StageException(xlen):
      valid: Bool(#true)
      cause: mux(execute_memory_operation.needs_unique(),
                 exception_cause_bits(store_cause, width),
                 exception_cause_bits(load_cause, width))
      value: alu.result
  wire execute_exception: RV5StageException(xlen)
  when (id_ex.bits.instruction_access_fault):
    execute_exception <== exception(ExceptionCause.InstructionAccessFault, id_ex.bits.pc)
  elsewhen (id_ex.bits.instruction_page_fault):
    execute_exception <== exception(ExceptionCause.InstructionPageFault, id_ex.bits.pc)
  elsewhen (id_ex.bits.illegal):
    execute_exception <== exception(ExceptionCause.IllegalInstruction,
                                    instruction_value(id_ex.bits.instruction))
  elsewhen redirect_fault:
    execute_exception <== exception(ExceptionCause.InstructionAddressMisaligned,
                                    computed_redirect_target)
  elsewhen data_page_fault:
    execute_exception <== memory_exception(ExceptionCause.StorePageFault,
                                           ExceptionCause.LoadPageFault)
  elsewhen data_access_fault:
    execute_exception <== memory_exception(ExceptionCause.StoreAccessFault,
                                           ExceptionCause.LoadAccessFault)
  elsewhen (execute_is_memory & !memory_aligned):
    execute_exception <== memory_exception(ExceptionCause.StoreAddressMisaligned,
                                           ExceptionCause.LoadAddressMisaligned)
  otherwise:
    execute_exception <== RV5StageException(xlen):
      valid: Bool(#false)
      cause: dont_care(Bits(width))
      value: dont_care(Bits(width))
  def csr_source = mux(
    id_ex.bits.system.immediate,
    id_ex.bits.instruction[15..20].zext(width),
    forwarded_rs1
  )
  def execute_result = mux(
    id_ex.bits.writeback_source === WritebackSelect.PcPlus4,
    id_ex.bits.pc + bits(4, width),
    alu.result
  )
  def execute_is_multiply = id_ex.bits.writeback_source === WritebackSelect.Multiply
  def execute_needs_multiplier = execute_is_multiply & id_ex.bits.writeback_enable & or_reduce(id_ex.bits.rd)
  def memory_has_multiply = memory.valid & (memory.bits.writeback_source === WritebackSelect.Multiply) & memory.bits.writeback_enable & or_reduce(memory.bits.rd)
  def commit_has_multiply = commit.valid & (commit.bits.writeback_source === WritebackSelect.Multiply) & commit.bits.write_enable & or_reduce(commit.bits.rd)
  def multiplier_available = multiplier.available & !memory_has_multiply & !commit_has_multiply
  def execute_multiply_issue = RV5StageMultiplyIssue(xlen):
    left: forwarded_rs1
    right: forwarded_rs2
    control: id_ex.bits.multiply_control
    rd: id_ex.bits.rd
  def execute_is_divide = id_ex.bits.writeback_source === WritebackSelect.Divide
  def execute_needs_divider = execute_is_divide & id_ex.bits.writeback_enable & or_reduce(id_ex.bits.rd)
  def memory_has_divide = memory.valid & (memory.bits.writeback_source === WritebackSelect.Divide) & memory.bits.writeback_enable & or_reduce(memory.bits.rd)
  def commit_has_divide = commit.valid & (commit.bits.writeback_source === WritebackSelect.Divide) & commit.bits.write_enable & or_reduce(commit.bits.rd)
  def divider_available = divider.available & !memory_has_divide & !commit_has_divide
  def execute_divide_issue = RV5StageDivideIssue(xlen):
    dividend: forwarded_rs1
    divisor: forwarded_rs2
    control: id_ex.bits.divide_control
    rd: id_ex.bits.rd
  def older_pipeline_squash = faulted ||| (memory.valid & memory.bits.exception_valid) ||| commit_redirect

  fp.issue.bits <== RV5StageFpIssue(xlen, effective_fp_profile, Bits(width)):
    context: id_ex.bits.pc
    control: id_ex.bits.floating_point_control
    frs1: id_ex.bits.rs1
    frs2: id_ex.bits.rs2
    frs3: id_ex.bits.frs3
    frd: id_ex.bits.rd
    integer_operand: forwarded_rs1
    rounding_mode: id_ex.bits.floating_point_rounding_mode
  fp.store_request.valid <== id_ex.valid & execute_fp_store & !fp_store_requested & !older_pipeline_squash & !execute_request_fault
  fp.store_request.bits <== RV5StageFpStoreRequest(Bits(width)):
    context: id_ex.bits.pc
    precision: fp_execution_control.source_precision
    rs: id_ex.bits.rs2

  // Cache capacity and long-latency reservations are Execute's only sources of
  // backpressure. Branch resolution and EX/MEM observe an instruction only
  // when both optional effects can advance.
  def issue_memory_request = execute_is_memory & !execute_request_fault
  def execute_cache_ready = !issue_memory_request ||| data_access.request.ready
  def execute_multiplier_ready = !execute_needs_multiplier ||| multiplier_available
  def execute_divider_ready = !execute_needs_divider ||| divider_available
  def execute_fp_store_data_ready = execute_request_fault ||| !execute_fp_store ||| (
    fp_store_requested & fp.store_response.valid
  )
  def execute_fp_load_ready = execute_request_fault ||| !execute_fp_load ||| fp.load_reserve.ready
  def execute_fp_compute_ready = execute_request_fault ||| !execute_fp_compute ||| fp.issue.ready
  def execute_ready = execute_cache_ready & execute_multiplier_ready & execute_divider_ready & (
    execute_fp_store_data_ready & execute_fp_load_ready & execute_fp_compute_ready
  )
  def execute_transfer = id_ex.valid & execute_ready & !older_pipeline_squash
  fp.issue.valid <== execute_transfer & execute_fp_compute & !execute_exception.valid
  fp.store_response.ready <== execute_transfer & execute_fp_store
  id_ex.ready <== older_pipeline_squash ||| execute_ready
  branch_resolver.request.valid <== execute_transfer
  branch_resolver.request.bits <== BranchResolverRequest(width):
    left: forwarded_rs1
    right: forwarded_rs2
    control: id_ex.bits.branch_control

  // A legal memory access starts its synchronous cache lookup at the same
  // edge that captures the instruction in EX/MEM.
  data_access.request.valid <== id_ex.valid & !older_pipeline_squash & execute_multiplier_ready & execute_divider_ready & (
    execute_fp_compute_ready & execute_fp_store_data_ready & execute_fp_load_ready & issue_memory_request
  )
  data_access.request.bits <== RV5StageDataReq(xlen):
    address: alu.result
    access: execute_memory_operation
    atomic: id_ex.bits.memory_atomic
    width: id_ex.bits.memory_width
    unsigned: id_ex.bits.memory_unsigned
    data: mux(execute_fp_store,
              if xlen == XLen.X32 | fp.store_response.bits.data[0..32] | fp.store_response.bits.data,
              forwarded_rs2)
    destination: mux(
      execute_fp_load,
      RV5StageDataDestination.FloatingPoint,
      mux(execute_memory_operation.returns_result(),
          RV5StageDataDestination.Integer,
          RV5StageDataDestination.None)
    )
    rd: id_ex.bits.rd
    floating_point_double: execute_fp_load & (
      fp_execution_control.destination_precision === RV5StageFloatPrecision.Double
    )

  fp.load_reserve.valid <== data_access.request.fire() & execute_fp_load & !data_page_fault & !data_access_fault
  fp.load_reserve.bits <== RV5StageFpLoadReservation(Bits(width)):
    context: id_ex.bits.pc
    precision: fp_execution_control.destination_precision
    rd: id_ex.bits.rd

  when (fp.store_request.fire()):
    fp_store_requested <== Bool(#true)
  elsewhen (execute_transfer ||| older_pipeline_squash):
    fp_store_requested <== Bool(#false)

  ex_mem_pipe.ingress.valid <== execute_transfer
  ex_mem_pipe.ingress.bits <== ExecuteMemory(xlen):
    pc: id_ex.bits.pc
    resume_pc: mux(redirect_requested, computed_redirect_target, id_ex.bits.pc + bits(4, width))
    instruction: id_ex.bits.instruction
    writeback_source: id_ex.bits.writeback_source
    writeback_enable: id_ex.bits.writeback_enable & !execute_exception.valid
    rd: id_ex.bits.rd
    result: execute_result
    multiply_issue: execute_multiply_issue
    divide_issue: execute_divide_issue
    system: id_ex.bits.system
    fence: id_ex.bits.fence
    csr_address: id_ex.bits.instruction[20..32]
    csr_source: csr_source
    exception_valid: execute_exception.valid
    exception_cause: execute_exception.cause
    exception_value: execute_exception.value

  execute_exception_event <== execute_transfer & execute_exception.valid
  execute_redirect_link.left.valid <== execute_transfer & !execute_exception.valid & redirect_requested
  execute_redirect_link.left.bits <== computed_redirect_target

  // Memory advances every instruction into WB; exception payloads have their
  // ordinary side effects disabled. No instruction commits at this boundary.
  mem_wb_pipe.ingress.valid <== memory.valid & !commit_redirect
  mem_wb_pipe.ingress.bits <== MemoryWriteback(xlen):
    pc: memory.bits.pc
    resume_pc: memory.bits.resume_pc
    instruction: memory.bits.instruction
    writeback_source: memory.bits.writeback_source
    write_enable: memory.bits.writeback_enable
    rd: memory.bits.rd
    value: memory.bits.result
    multiply_issue: memory.bits.multiply_issue
    divide_issue: memory.bits.divide_issue
    system: memory.bits.system
    fence: memory.bits.fence
    csr_address: memory.bits.csr_address
    csr_source: memory.bits.csr_source
    exception_valid: memory.bits.exception_valid
    exception_cause: memory.bits.exception_cause
    exception_value: memory.bits.exception_value

  memory_bypass_link.left.valid <== memory.valid & memory.bits.writeback_enable & !deferred_writeback(
    memory.bits.writeback_source
  ) & (memory.bits.writeback_source =/= WritebackSelect.Csr) & or_reduce(memory.bits.rd)
  memory_bypass_link.left.bits <== RV5StageBypass(xlen):
    rd: memory.bits.rd
    value: memory.bits.result

  // Writeback (WB) is the ordered commit point. Deferred loads and arithmetic
  // mark their destinations busy here; immediate and CSR results update the
  // register file and remain available to Execute through the bypass link.
  def current_exception_wait = commit.valid & commit.bits.exception_valid & deferred_state_pending
  def architectural_commit = mux(pending_exception_valid, pending_exception, commit.bits)
  def pending_exception_ready = pending_exception_valid & !deferred_state_pending
  def interrupt_commit_safe = !commit.valid ||| (!commit.bits.exception_valid & !serializing_operation(commit.bits.system, commit.bits.fence) & !deferred_writeback(commit.bits.writeback_source))
  csrs.interrupt_boundary <== !pending_exception_valid & !id_ex.valid & !memory.valid & !deferred_state_pending & interrupt_commit_safe
  csrs.interrupt_pc <== mux(commit.valid, commit.bits.resume_pc, architectural_pc)
  csrs.commit.valid <== pending_exception_ready ||| (commit.valid & !current_exception_wait)
  csrs.commit.bits <== RV5StageCsrCommit(xlen):
    pc: architectural_commit.pc
    instruction: architectural_commit.instruction
    rd: architectural_commit.rd
    system: architectural_commit.system
    fence: architectural_commit.fence
    csr_address: architectural_commit.csr_address
    csr_source: architectural_commit.csr_source
    exception_valid: architectural_commit.exception_valid
    exception_cause: architectural_commit.exception_cause
    exception_value: architectural_commit.exception_value

  when current_exception_wait:
    pending_exception_valid <== Bool(#true)
    pending_exception <== commit.bits
  elsewhen (pending_exception_valid & csrs.redirect.valid):
    pending_exception_valid <== Bool(#false)

  scoreboard_set_link.left.valid <== commit.valid & deferred_writeback(
    commit.bits.writeback_source
  ) & commit.bits.write_enable & or_reduce(commit.bits.rd)
  scoreboard_set_link.left.bits <== commit.bits.rd

  writeback_bypass_link.left.valid <== commit.valid & !deferred_writeback(
    commit.bits.writeback_source
  ) & (commit.bits.writeback_source =/= WritebackSelect.Csr) & commit.bits.write_enable & or_reduce(commit.bits.rd)
  writeback_bypass_link.left.bits <== RV5StageBypass(xlen):
    rd: commit.bits.rd
    value: commit.bits.value

  commit_write.valid <== commit.valid & !deferred_writeback(
    commit.bits.writeback_source
  ) & commit.bits.write_enable & (
    (commit.bits.writeback_source =/= WritebackSelect.Csr) ||| csrs.writeback_valid
  )
  commit_write.bits <== RegisterFileWrite(xlen):
    address: commit.bits.rd
    data: mux(
      commit.bits.writeback_source === WritebackSelect.Csr,
      csrs.writeback_value,
      commit.bits.value
    )

  multiplier.issue.valid <== commit.valid & (
    commit.bits.writeback_source === WritebackSelect.Multiply
  ) & commit.bits.write_enable & or_reduce(commit.bits.rd)
  multiplier.issue.bits <== commit.bits.multiply_issue
  divider.issue.valid <== commit.valid & (
    commit.bits.writeback_source === WritebackSelect.Divide
  ) & commit.bits.write_enable & or_reduce(commit.bits.rd)
  divider.issue.bits <== commit.bits.divide_issue

  fp_integer_scoreboard.set.valid <== fp.issue.fire() & (
    fp.issue.bits.control.registers.destination === RV5StageFloatDestination.Integer
  ) & or_reduce(fp.issue.bits.frd)
  fp_integer_scoreboard.set.bits <== fp.issue.bits.frd

  // Deferred loads and arithmetic complete outside the ordered pipeline. The
  // fixed-priority arbiter lets nonbackpressured L1D responses win while the
  // arithmetic units hold their irrevocable results.
  inst deferred_completion_arbiter(Arbiter(RegisterFileWrite(xlen), 4))
  deferred_completion_arbiter.ingress[0].valid <== data_access.response.valid & (
    data_access.response.bits.destination === RV5StageDataDestination.Integer
  ) & or_reduce(data_access.response.bits.rd)
  deferred_completion_arbiter.ingress[0].bits <== RegisterFileWrite(xlen):
    address: data_access.response.bits.rd
    data: data_access.response.bits.data
  deferred_completion_arbiter.ingress[1].valid <== multiplier.completion.valid
  deferred_completion_arbiter.ingress[1].bits <== RegisterFileWrite(xlen):
    address: multiplier.completion.bits.rd
    data: multiplier.completion.bits.value
  multiplier.completion.ready <== deferred_completion_arbiter.ingress[1].ready
  deferred_completion_arbiter.ingress[2].valid <== divider.completion.valid
  deferred_completion_arbiter.ingress[2].bits <== RegisterFileWrite(xlen):
    address: divider.completion.bits.rd
    data: divider.completion.bits.value
  divider.completion.ready <== deferred_completion_arbiter.ingress[2].ready
  def fp_integer_completion = fp.completion.bits.destination === RV5StageFloatDestination.Integer
  def fp_integer_write = fp_integer_completion & or_reduce(fp.completion.bits.rd)
  deferred_completion_arbiter.ingress[3].valid <== fp.completion.valid & fp_integer_write
  deferred_completion_arbiter.ingress[3].bits <== RegisterFileWrite(xlen):
    address: fp.completion.bits.rd
    data: fp.completion.bits.integer_value
  fp.completion.ready <== !fp_integer_write ||| deferred_completion_arbiter.ingress[3].ready
  deferred_completion_arbiter.egress.ready <== Bool(#true)

  fp_integer_scoreboard.clear.valid <== fp.completion.fire() & fp_integer_write
  fp_integer_scoreboard.clear.bits <== fp.completion.bits.rd
  fp.load_completion.valid <== data_access.response.valid & (
    data_access.response.bits.destination === RV5StageDataDestination.FloatingPoint
  )
  fp.load_completion.bits <== RV5StageFpLoadCompletion(Bits(width)):
    context: bits(0, width)
    precision: mux(data_access.response.bits.floating_point_double,
                   RV5StageFloatPrecision.Double,
                   RV5StageFloatPrecision.Single)
    rd: data_access.response.bits.rd
    data: if xlen == XLen.X32 | data_access.response.bits.data.zext(64) | data_access.response.bits.data

  scoreboard_clear_link.left.valid <== deferred_completion_arbiter.egress.valid & !(fp.completion.fire() & fp_integer_write)
  scoreboard_clear_link.left.bits <== deferred_completion_arbiter.egress.bits.address
  deferred_completion_write.valid <== deferred_completion_arbiter.egress.valid
  deferred_completion_write.bits <== deferred_completion_arbiter.egress.bits

export:
  RV5StageCore
