#lang rhdl
// Defines RV5Stage's pipeline payload and sideband bundle types.

import:
  "../../riscv/isa/xlen.rhm" open
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../load-store.rhdl" open
  "memory.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/multiply-ctrl.rhdl" open
  "decode/divide-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/fence-ctrl.rhdl" open
  "multiply.rhdl" open
  "divide.rhdl" open

bundle FetchDecode(xlen :: XLen):
  pc: Bits(xlen_width(xlen))
  instruction: Bits(32)
  instruction_page_fault: Bool

bundle DecodeExecute(xlen :: XLen):
  pc: Bits(xlen_width(xlen))
  instruction: Bits(32)
  alu_control: AluControl()
  operand_left: OperandASelect
  operand_right: OperandBSelect
  branch_control: BranchResolverControl()
  target_from_rs1: Bool
  memory_operation: MemoryOperation
  memory_atomic: RV5StageAtomicOperation
  memory_width: MemoryWidth
  memory_unsigned: Bool
  multiply_control: RV5StageMultiplyControl()
  divide_control: RV5StageDivideControl()
  writeback_enable: Bool
  writeback_source: WritebackSelect
  system: SystemControl()
  fence: FenceControl()
  illegal: Bool
  instruction_page_fault: Bool
  immediate: Bits(xlen_width(xlen))
  rs1: Bits(5)
  rs2: Bits(5)
  rd: Bits(5)

bundle RV5StageException(xlen :: XLen):
  valid: Bool
  cause: Bits(xlen_width(xlen))
  value: Bits(xlen_width(xlen))

bundle ExecuteMemory(xlen :: XLen):
  pc: Bits(xlen_width(xlen))
  resume_pc: Bits(xlen_width(xlen))
  instruction: Bits(32)
  writeback_source: WritebackSelect
  writeback_enable: Bool
  rd: Bits(5)
  result: Bits(xlen_width(xlen))
  multiply_issue: RV5StageMultiplyIssue(xlen)
  divide_issue: RV5StageDivideIssue(xlen)
  system: SystemControl()
  fence: FenceControl()
  csr_address: Bits(12)
  csr_source: Bits(xlen_width(xlen))
  exception_valid: Bool
  exception_cause: Bits(xlen_width(xlen))
  exception_value: Bits(xlen_width(xlen))

bundle MemoryWriteback(xlen :: XLen):
  pc: Bits(xlen_width(xlen))
  resume_pc: Bits(xlen_width(xlen))
  instruction: Bits(32)
  writeback_source: WritebackSelect
  write_enable: Bool
  rd: Bits(5)
  value: Bits(xlen_width(xlen))
  multiply_issue: RV5StageMultiplyIssue(xlen)
  divide_issue: RV5StageDivideIssue(xlen)
  system: SystemControl()
  fence: FenceControl()
  csr_address: Bits(12)
  csr_source: Bits(xlen_width(xlen))
  exception_valid: Bool
  exception_cause: Bits(xlen_width(xlen))
  exception_value: Bits(xlen_width(xlen))

// Sideband observations do not transfer ownership of the pipeline token.
bundle RV5StageBypass(xlen :: XLen):
  rd: Bits(5)
  value: Bits(xlen_width(xlen))

export:
  FetchDecode
  DecodeExecute
  RV5StageException
  ExecuteMemory
  MemoryWriteback
  RV5StageBypass
