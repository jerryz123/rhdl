#lang rhdl
// Defines RV5Stage's controller-independent standard interrupt input contract.

import:
  "../../riscv/isa/xlen.rhm" open

bundle RV5StageInterrupts():
  supervisor_software: Bool
  machine_software: Bool
  supervisor_timer: Bool
  machine_timer: Bool
  supervisor_external: Bool
  machine_external: Bool

fun rv5stage_interrupt_pending(xlen :: XLen,
                               interrupts :: RV5StageInterrupts()) :~ Bits(xlen_width(xlen)):
  def width = xlen_width(xlen)
  def zero = bits(0, width)
  mux(interrupts.supervisor_software, bits(1 bits.(<<) 1, width), zero) ||| (
    mux(interrupts.machine_software, bits(1 bits.(<<) 3, width), zero)
  ) ||| mux(interrupts.supervisor_timer, bits(1 bits.(<<) 5, width), zero) ||| (
    mux(interrupts.machine_timer, bits(1 bits.(<<) 7, width), zero)
  ) ||| mux(interrupts.supervisor_external, bits(1 bits.(<<) 9, width), zero) ||| (
    mux(interrupts.machine_external, bits(1 bits.(<<) 11, width), zero)
  )

export:
  RV5StageInterrupts
  rv5stage_interrupt_pending
