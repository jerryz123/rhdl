#lang rhombus
// Checks RV5Stage's XLEN-specific multiplier adapter and deferred completion shape.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "../multiply.rhdl" as multiply

def rv64_design = embedded.run_elaboration(fun (): multiply.RV5StageMultiplier(XLen.X64))
def rv64 = rv64_design.modules.find(fun (module_def): module_def.name == "RV5StageMultiplier")
def rv32_design = embedded.run_elaboration(fun (): multiply.RV5StageMultiplier(XLen.X32))
def rv32 = rv32_design.modules.find(fun (module_def): module_def.name == "RV5StageMultiplier")
fun instance_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).map(fun (operation): operation.attribute("module").name)
fun state_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))

check:
  multiply.RV5StageMultiplyIssue(XLen.X64).field("left").type.width ~is 64
  multiply.RV5StageMultiplyIssue(XLen.X32).field("right").type.width ~is 32
  multiply.RV5StageMultiplyCompletion(XLen.X64).field("value").type.width ~is 64
  multiply.RV5StageMultiplyCompletion(XLen.X32).field("value").type.width ~is 32
  instance_names(rv64).length() ~is 1
  instance_names(rv64)[0].starts_with("IterativeMultiplier") ~is #true
  state_names(rv64) ~is ["destination", "high_result", "word_result"]
  rv64.find_input("issue_in").type.field("bits").type.field("left").type.width ~is 64
  rv64.find_output("available").type.bit_width() ~is 1
  rv64.find_output("completion_out").type.field("bits").type.field("value").type.width ~is 64
  rv32.find_input("issue_in").type.field("bits").type.field("left").type.width ~is 32
  rv32.find_output("completion_out").type.field("bits").type.field("value").type.width ~is 32
  verify_design(rv64_design) ~is #void
  verify_design(rv32_design) ~is #void
