#lang rhombus
// Checks RV5Stage's two-write register-file ports, state type, and verification.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "../register-file.rhdl" as register_file

def design = embedded.run_elaboration(fun (): register_file.RV5StageRegisterFile(XLen.X64))
def module_def = design.modules.find(fun (candidate): candidate.name == "RV5StageRegisterFile")
def rv32_design = embedded.run_elaboration(fun (): register_file.RV5StageRegisterFile(XLen.X32))
def rv32_module = rv32_design.modules.find(fun (candidate): candidate.name == "RV5StageRegisterFile")
def registers = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
)
def write_set = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.vector_write_set"
)

check:
  module_def.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "read_address_1", "read_address_2",
    "writes_0_in", "writes_1_in"
  ]
  module_def.outputs.map(fun (port): port.name) ~is ["read_data_1", "read_data_2"]
  registers.length() ~is 1
  registers[0].attribute("name") ~is "registers"
  registers[0].results[0].type.type_equal(VectorType(32, Bits(64))) ~is #true
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.vector_index"
  ).length() ~is 2
  write_set.operands[1].type.length ~is 2
  verify_design(design) ~is #void
  rv32_module.find_input("writes_0_in").type.field("bits").type.field("data").type.type_equal(Bits(32)) ~is #true
  rv32_module.find_output("read_data_1").type.type_equal(Bits(32)) ~is #true
  rv32_module.operations.find(
    fun (operation): operation.attribute("name") == "registers"
  ).results[0].type.type_equal(VectorType(32, Bits(32))) ~is #true
  verify_design(rv32_design) ~is #void
