#lang rhdl
// Elaborates RV5Stage's uncached engine and physical-memory router with an HN-I range.

import:
  "../uncached.rhdl" open
  "../memory-router.rhdl" open
  "params.rhdl" as params
  lib("riscv/isa/xlen.rhm").XLen

def uncached_design = elaborate(RV5StageUncached(XLen.X64,
                                                 params.test_rv5stage_device_config))
def router_design = elaborate(RV5StageMemoryRouter(XLen.X64,
                                                   params.test_rv5stage_device_config))

export:
  uncached_design
  router_design
