#lang rhombus
// Checks standalone RV32 and RV64 M divide decoding into divider controls.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../rhodium/frontend/layers/bool.rhm" as bool
  "../../../rhodium/std/decode/pattern.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../decode/divide-ctrl.rhdl" as controls

fun control_for(cases, instruction):
  cases.find(
    fun (candidate):
      candidate.input.value_bits == instruction.encoding.value && candidate.input.care_bits == instruction.encoding.care
  ).output

def rv32_design = embedded.run_elaboration(fun (): controls.RV5StageDivideInstructionDecoder(XLen.X32))
def rv64_design = embedded.run_elaboration(fun (): controls.RV5StageDivideInstructionDecoder(XLen.X64))
def div = control_for(controls.RV64MDivideControlCases, DIV)
def divu = control_for(controls.RV64MDivideControlCases, DIVU)
def rem = control_for(controls.RV64MDivideControlCases, REM)
def remu = control_for(controls.RV64MDivideControlCases, REMU)
def divw = control_for(controls.RV64MDivideControlCases, DIVW)
def divuw = control_for(controls.RV64MDivideControlCases, DIVUW)
def expected_div = pattern(controls.RV5StageDivideControl()):
  signed_mode: bool.Bool(#true)
  remainder: bool.Bool(#false)
  word_result: bool.Bool(#false)
def expected_remu = pattern(controls.RV5StageDivideControl()):
  signed_mode: bool.Bool(#false)
  remainder: bool.Bool(#true)
  word_result: bool.Bool(#false)

check:
  controls.RV32MDivideControlCases.length() ~is 4
  controls.RV64MDivideControlCases.length() ~is 8
  controls.RV5StageDivideControl().fields.map(fun (field): field.name) ~is [
    "signed_mode", "remainder", "word_result"
  ]
  div.value_bits ~is expected_div.value_bits
  remu.value_bits ~is expected_remu.value_bits
  divu.value_bits != div.value_bits ~is #true
  rem.value_bits != div.value_bits ~is #true
  divw.value_bits != div.value_bits ~is #true
  divuw.value_bits != divw.value_bits ~is #true
  rv32_design.modules[0].find_output("control").type.field("word_result").type.bit_width() ~is 1
  verify_design(rv32_design) ~is #void
  verify_design(rv64_design) ~is #void
