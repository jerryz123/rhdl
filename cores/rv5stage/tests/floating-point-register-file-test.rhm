#lang rhombus
// Checks RV5Stage's profile-sized floating-point register-file structure.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/fp-profile.rhm" open
  "../floating-point-register-file.rhdl" as register_file

def single_design = embedded.run_elaboration(fun (): register_file.RV5StageFloatingPointRegisterFile(FloatingPointProfile.F))
def double_design = embedded.run_elaboration(fun (): register_file.RV5StageFloatingPointRegisterFile(FloatingPointProfile.D))
def single_module = single_design.modules[0]
def double_module = double_design.modules[0]
def single_register = single_module.operations.find(fun (operation): operation.attribute("name") == "registers")
def double_register = double_module.operations.find(fun (operation): operation.attribute("name") == "registers")
def double_write_set = double_module.operations.find(fun (operation): operation.opcode == "rtl.vector_write_set")

check:
  double_module.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "read_address_1", "read_address_2", "read_address_3",
    "writes_0_in", "writes_1_in"
  ]
  double_module.outputs.map(fun (port): port.name) ~is ["read_data_1", "read_data_2", "read_data_3"]
  single_register.results[0].type.type_equal(VectorType(32, Bits(32))) ~is #true
  double_register.results[0].type.type_equal(VectorType(32, Bits(64))) ~is #true
  double_module.operations.filter(~keep: fun (operation): operation.opcode == "rtl.vector_index").length() ~is 3
  double_write_set.operands[1].type.length ~is 2
  single_module.find_input("writes_0_in").type.field("bits").type.field("data").type.type_equal(Bits(32)) ~is #true
  double_module.find_output("read_data_3").type.type_equal(Bits(64)) ~is #true
  verify_design(single_design) ~is #void
  verify_design(double_design) ~is #void
