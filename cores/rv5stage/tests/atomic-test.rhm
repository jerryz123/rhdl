#lang rhombus
// Checks the typed RV5Stage atomic-operation fixture in RV32 and RV64 forms.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "atomic-fixture.rhdl" as fixture

def rv64_design = embedded.run_elaboration(fun (): fixture.RV5StageAtomicFixture(XLen.X64))
def rv32_design = embedded.run_elaboration(fun (): fixture.RV5StageAtomicFixture(XLen.X32))
def rv64 = rv64_design.modules.find(fun (module_def): module_def.name == "RV5StageAtomicFixture")
def rv32 = rv32_design.modules.find(fun (module_def): module_def.name == "RV5StageAtomicFixture")

check:
  rv64.find_input("old_value").type.width ~is 64
  rv64.find_output("value").type.width ~is 64
  rv32.find_input("old_value").type.width ~is 32
  rv32.find_output("value").type.width ~is 32
  verify_design(rv64_design) ~is #void
  verify_design(rv32_design) ~is #void
