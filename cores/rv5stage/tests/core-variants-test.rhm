#lang rhombus
// Checks RV5Stage's core variants share a contract but retain distinct structures.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "../core.rhdl" as explicit_core
  "../core-flow.rhdl" as flow_core

def explicit_design = embedded.run_elaboration(
  fun (): explicit_core.RV5StageCore(XLen.X64)
)
def flow_design = embedded.run_elaboration(
  fun (): flow_core.RV5StageCore(XLen.X64)
)
def explicit = explicit_design.modules.find(
  fun (module_def): module_def.name == "RV5StageCore"
)
def flow = flow_design.modules.find(
  fun (module_def): module_def.name == "RV5StageCore"
)
def input_types_equal = for List (index in 0..explicit.inputs.length()):
  type_equal(explicit.inputs[index].type, flow.inputs[index].type)
def output_types_equal = for List (index in 0..explicit.outputs.length()):
  type_equal(explicit.outputs[index].type, flow.outputs[index].type)

fun instance_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).map(fun (operation): operation.attribute("module").name)
fun state_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))

def explicit_instances = instance_names(explicit)
def flow_instances = instance_names(flow)

check:
  explicit.inputs.map(fun (port): port.name) ~is flow.inputs.map(
    fun (port): port.name
  )
  explicit.outputs.map(fun (port): port.name) ~is flow.outputs.map(
    fun (port): port.name
  )
  input_types_equal.contains(#false) ~is #false
  output_types_equal.contains(#false) ~is #false
  explicit_instances.filter(
    ~keep: fun (name): name.starts_with("Pipe")
  ).length() ~is 2
  explicit_instances.filter(
    ~keep: fun (name): name.starts_with("ValidPipe")
  ).length() ~is 2
  explicit_instances.contains("Queue") ~is #true
  explicit_instances.contains("OfferRegister") ~is #false
  explicit_instances.filter(
    ~keep: fun (name): name.starts_with("ValidArbiter")
  ).length() ~is 0
  explicit_instances.filter(
    ~keep: fun (name): name.starts_with("AtomicFork")
  ).length() ~is 0
  state_names(explicit) ~is ["faulted", "started", "fetch_pc", "architectural_pc"]
  flow_instances.contains("OfferRegister") ~is #false
  flow_instances.filter(
    ~keep: fun (name): name.starts_with("ValidArbiter")
  ).length() ~is 0
  flow_instances.filter(
    ~keep: fun (name): name.starts_with("AtomicFork")
  ).length() ~is 1
  state_names(flow) ~is ["faulted", "started", "fetch_pc", "architectural_pc"]
  verify_design(explicit_design) ~is #void
  verify_design(flow_design) ~is #void
