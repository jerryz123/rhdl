#lang rhombus
// Checks RV5Stage's integrated parallel FP backend and typed memory destinations.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../core.rhdl" as core

def rv32f_design = embedded.run_elaboration(
  fun (): core.RV5StageCore(XLen.X32, FloatingPointProfile.F)
)
def rv64d_design = embedded.run_elaboration(
  fun (): core.RV5StageCore(XLen.X64, FloatingPointProfile.D)
)
def rv64zfh_design = embedded.run_elaboration(
  fun (): core.RV5StageCore(XLen.X64, FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfh)
)
def rv32f = rv32f_design.modules.find(fun (module_def): module_def.name == "RV5StageCore")
def rv64d = rv64d_design.modules.find(fun (module_def): module_def.name == "RV5StageCore")
def rv64zfh = rv64zfh_design.modules.find(fun (module_def): module_def.name == "RV5StageCore")

fun instance_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).map(fun (operation): operation.attribute("module").name)

check:
  instance_names(rv32f).contains("RV5StageFpPipeline") ~is #true
  instance_names(rv64d).contains("RV5StageFpPipeline") ~is #true
  instance_names(rv32f).contains("RV5StageDisabledFpPipeline") ~is #false
  instance_names(rv64d).contains("RV5StageDisabledFpPipeline") ~is #false
  instance_names(rv64zfh).contains("RV5StageFpPipeline") ~is #true
  rv32f.find_output("data_access_out").type.field("request").type.field("bits").type.field("data").type.width ~is 32
  rv64d.find_output("data_access_out").type.field("request").type.field("bits").type.field("data").type.width ~is 64
  rv32f.find_input("data_access_in").type.field("response").type.field("bits").type.field("destination").type.width ~is 2
  verify_design(rv32f_design) ~is #void
  verify_design(rv64d_design) ~is #void
  verify_design(rv64zfh_design) ~is #void
