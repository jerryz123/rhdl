#lang rhdl
// Implements RV5Stage's blocking write-back, write-allocate direct-mapped data cache.

import:
  "protocol.rhdl" open
  "../memory.rhdl" open
  "../cache.rhdl" open
  "../chi.rhdl" open
  "../refill.rhdl" open
  "../snoop.rhdl" open
  "../writeback.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/read-write.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/sync-ram.rhdl") open
  lib("rhdl/std/flow.rhdl") open
  lib("chi/main.rhdl") open

fun check_l1d_geometry(width :: PosInt, sets :: Pow2Int):
  unless sets >= 2
  | error(~who: #'RV5StageL1DCache,
          "set count must be a power of two of at least two")
  unless width > (alignment_bits(RV5StageCacheLineBytes) + alignment_bits(sets))
  | error(~who: #'RV5StageL1DCache,
          "address width must include line offset, set, and tag bits")

sync_circuit RV5StageL1DCache(xlen :: XLen,
                              sets :: Pow2Int,
                              ~chi: config :: RV5StageCHIConfig):
  def width = xlen.width
  def p = config.flit
  check_l1d_geometry(width, sets)
  def beats = RV5StageCacheLineBytes / 8
  def offset_width = alignment_bits(RV5StageCacheLineBytes)
  def set_width = alignment_bits(sets)
  def tag_width = width - offset_width - set_width
  def beat_width = index_width(beats)

  input node_id: Bits(p.node_id_width)
  interface core(RV5StageDataAccess(xlen), ~role: responder)
  interface chi(CHIRNChannels(p), ~role: node)

  inst tags(SyncRam1RW(sets, Bits(tag_width), 1))
  inst states(SyncRam1RW(sets, CHICacheState, 1))
  inst lines(SyncRam1RW(sets, Bits(8), RV5StageCacheLineBytes))
  inst load_gen(LoadGen(xlen))
  inst store_gen(StoreGen(xlen))
  inst atomic_alu(RV5StageAtomicALU(xlen))
  inst refill(RV5StageLineRefill(RV5StageDataReq(xlen), width, config))
  inst snoop(RV5StageDataSnoop(width, config))
  inst writeback(RV5StageLineWriteback(RV5StageDataReq(xlen), width, config, 1))
  refill.node_id <== node_id
  snoop.node_id <== node_id
  writeback.node_id <== node_id
  // Hits leave the lookup stage directly. Ownership acquisitions and misses
  // transfer their complete request context into the refill engine, after a
  // dirty victim has drained when replacement is necessary.
  inst lookup(Pipe(RV5StageDataReq(xlen), 1))
  // This mandatory register after the SRAM lookup aligns a hit issued from EX
  // with the instruction's WB stage. Responses cannot be backpressured.
  inst responses(ValidPipe(RV5StageDataResp(xlen), 1))
  inst protocol_requests(Arbiter(CHIReqFlit(p), 2))
  inst protocol_responses(Arbiter(CHIRspFlit(p), 2))
  inst protocol_data(Arbiter(CHIDatFlit(p), 2))
  inst refill_commands(Arbiter(RV5StageLineRefillCommand(RV5StageDataReq(xlen), width), 2))

  reg valid_lines(~init: bits(0, sets).as_vec(Bool))
  reg reservation_valid(~init: Bool(#false))
  reg reservation_address(~init: bits(0, width))
  reg reservation_width(~init: MemoryWidth.Word)

  core.response.valid <== responses.egress.valid
  core.response.bits <== responses.egress.bits
  core.request_fault <== Bool(#false)
  core.request_access_fault <== Bool(#false)

  def outgoing_requests = chi.requests
  def outgoing_responses = chi.requester_responses
  def outgoing_data = chi.request_data
  def incoming_responses = chi.responses
  def incoming_data = chi.response_data
  def incoming_snoops = chi.snoops
  refill.requests |> protocol_requests.ingress[0]
  writeback.requests |> protocol_requests.ingress[1]
  protocol_requests.egress |> outgoing_requests
  incoming_data |> refill.response_data
  refill.acknowledgements |> protocol_responses.ingress[0]
  snoop.responses |> protocol_responses.ingress[1]
  protocol_responses.egress |> outgoing_responses
  writeback.data |> protocol_data.ingress[0]
  snoop.data |> protocol_data.ingress[1]
  protocol_data.egress |> outgoing_data
  def writeback_active = !writeback.command.ready
  refill.responses.valid <== incoming_responses.valid & !writeback_active
  refill.responses.bits <== incoming_responses.bits
  writeback.responses.valid <== incoming_responses.valid & writeback_active
  writeback.responses.bits <== incoming_responses.bits
  incoming_responses.ready <== mux(writeback_active, writeback.responses.ready, refill.responses.ready)
  def request_set_value = core.request.bits.address[offset_width..(offset_width + set_width)]
  def lookup_request :: RV5StageDataReq(xlen) = lookup.egress.bits
  def lookup_set = lookup_request.address[offset_width..(offset_width + set_width)]
  def lookup_tag = lookup_request.address[(offset_width + set_width)..width]
  def lookup_beat:
    if beats == 1
    | bits(0, beat_width)
    | lookup_request.address[3..offset_width]
  def line_valid = valid_lines[lookup_set]
  def line_hit = line_valid & (tags.port.response.bits[0] === lookup_tag)
  def lookup_state = states.port.response.bits[0].into(CHICacheState)
  def lookup_access :: MemoryOperation = lookup_request.access
  def lookup_ready = lookup.egress.valid & tags.port.response.valid & states.port.response.valid
  def lookup_load = lookup_ready & lookup_access.is_load()
  def lookup_store = lookup_ready & lookup_access.is_store()
  def lookup_atomic = lookup_ready & lookup_access.is_atomic()
  def lookup_sc = lookup_ready & lookup_access.is_store_conditional()
  def reservation_matches = reservation_valid & (reservation_address === lookup_request.address) & (reservation_width === lookup_request.width)
  def lookup_mutation = lookup_store ||| lookup_atomic ||| (lookup_sc & reservation_matches)
  def mutation_has_ownership = lookup_mutation & line_hit & lookup_state.is_unique()
  def lookup_needs_refill = lookup_load & !line_hit ||| lookup_mutation & !mutation_has_ownership
  def dirty_victim = lookup_needs_refill & !line_hit & line_valid & lookup_state.is_dirty()
  def cached_line = lines.port.response.bits.as_vec(Bits(64))
  def cached_beat:
    if beats == 1
    | cached_line[0]
    | cached_line[lookup_beat]

  def Array(hit_path, transaction_path) = (
    lookup.egress |> demux_flow(2, _request => lookup_needs_refill.as_bits())
  )
  def Array(direct_refill_path, eviction_path) = (
    transaction_path |> demux_flow(2, _request => dirty_victim.as_bits())
  )
  hit_path.ready <== Bool(#true)
  def direct_refill_commands = (
    direct_refill_path
      |> map_flow(request => RV5StageLineRefillCommand(RV5StageDataReq(xlen), width)):
      line_address: align_down(request.address.as_bits(), RV5StageCacheLineBytes)
      opcode: mux(request.access.into(MemoryOperation).needs_unique(), CHIReqOpcode.ReadUnique, CHIReqOpcode.ReadClean)
      context: request
  )
  direct_refill_commands |> refill_commands.ingress[0]
  def victim_address = concat(tags.port.response.bits[0], lookup_set, bits(0, offset_width))
  def eviction_commands = (
    eviction_path
      |> map_flow(request => RV5StageLineWritebackCommand(RV5StageDataReq(xlen), width)):
        line_address: victim_address
        line: lines.port.response.bits.as_vec(Bits(64))
        context: request
  )
  eviction_commands |> writeback.command
  def post_eviction_refills = (
    writeback.completion
      |> map_flow(result => RV5StageLineRefillCommand(RV5StageDataReq(xlen), width)):
        line_address: align_down(result.context.into(RV5StageDataReq(xlen)).address.as_bits(), RV5StageCacheLineBytes)
        opcode: mux(result.context.into(RV5StageDataReq(xlen)).access.into(MemoryOperation).needs_unique(),
                    CHIReqOpcode.ReadUnique,
                    CHIReqOpcode.ReadClean)
        context: result.context.into(RV5StageDataReq(xlen))
  )
  post_eviction_refills |> refill_commands.ingress[1]
  refill_commands.egress |> refill.command

  // A pending snoop owns the cache SRAM ports. The refill engine retains its
  // irrevocable completion until that lookup and any state update finish.
  refill.completion.ready <== !snoop.pending
  def install_refill = fire(refill.completion)
  when install_refill:
    assert(!refill.completion.bits.pass_dirty, "l1d_refill_not_dirty")
  def completion_request = refill.completion.bits.context.into(RV5StageDataReq(xlen))
  def completion_access :: MemoryOperation = completion_request.access
  def completion_set = completion_request.address[offset_width..(offset_width + set_width)]
  def completion_tag = completion_request.address[(offset_width + set_width)..width]
  def completion_beat:
    if beats == 1
    | bits(0, beat_width)
    | completion_request.address[3..offset_width]
  def load_address = mux(install_refill, completion_request.address, lookup_request.address)
  def load_width = mux(install_refill, completion_request.width, lookup_request.width)
  def response_access :: MemoryOperation = mux(install_refill, completion_access, lookup_access)
  def response_address = mux(install_refill, completion_request.address, lookup_request.address)
  def response_width = mux(install_refill, completion_request.width, lookup_request.width)
  def load_unsigned = mux(response_access === MemoryOperation.Load,
                          mux(install_refill, completion_request.unsigned, lookup_request.unsigned),
                          Bool(#false))
  def refilled_beat:
    if beats == 1
    | refill.completion.bits.line[0]
    | refill.completion.bits.line[completion_beat]
  load_gen.address <== load_address
  load_gen.data <== mux(install_refill, refilled_beat, cached_beat)
  load_gen.width <== load_width
  load_gen.unsigned_load <== load_unsigned
  def completing_mutation = install_refill & completion_access.needs_unique()
  def local_mutation = lookup_mutation & mutation_has_ownership
  def mutation_address = mux(completing_mutation, completion_request.address, lookup_request.address)
  def mutation_data = mux(completing_mutation, completion_request.data, lookup_request.data)
  def mutation_width = mux(completing_mutation, completion_request.width, lookup_request.width)
  def mutation_atomic = mux(completing_mutation, completion_request.atomic, lookup_request.atomic)
  def mutation_access :: MemoryOperation = mux(completing_mutation, completion_access, lookup_access)
  atomic_alu.old_value <== load_gen.value
  atomic_alu.operand <== mutation_data
  atomic_alu.memory_width <== mutation_width
  atomic_alu.operation <== mutation_atomic
  store_gen.address <== mutation_address
  store_gen.value <== mux(mutation_access.is_atomic(), atomic_alu.value, mutation_data)
  store_gen.width <== mutation_width
  def store_beat = mutation_address[3..offset_width]
  def store_line_data = (zext(store_gen.data, RV5StageCacheLineBytes * 8) << concat(store_beat, bits(0, 6))).as_vec(Bits(8))
  def store_line_mask = zext(store_gen.mask.into(Bits(8)), RV5StageCacheLineBytes) << concat(store_beat, bits(0, 3))
  def store_byte_mask = store_line_mask.as_vec(Bool)
  def refill_line_bytes = refill.completion.bits.line.as_vec(Bits(8))
  def merged_refill_line = vec(
    for List (byte_index in 0..RV5StageCacheLineBytes):
      mux(store_byte_mask[byte_index],
          store_line_data[byte_index],
          refill_line_bytes[byte_index])
  )
  def cache_write = install_refill ||| local_mutation
  def cache_write_set = mux(local_mutation, lookup_set, completion_set)
  assert(refill.command.ready ||| writeback.command.ready,
         "l1d_backing_owner_exclusive")

  // Loads can follow hit lookups every cycle. A miss blocks until refill, and
  // a store blocks only the cache-request stream while its one-entry backing
  // write buffer drains; the store completion enters the response register at
  // lookup and reaches the pipeline in WB.
  incoming_snoops |> snoop.snoops
  // Active backing transactions have already captured their cache context and
  // do not occupy the SRAM ports. Serving snoops here prevents a Home waiting
  // on this RN-F from deadlocking behind this RN-F's queued request.
  snoop.cache_ready <== !lookup.egress.valid
  def snoop_lookup_start = snoop.lookup.valid
  def snoop_address = snoop.address
  def snoop_set = snoop_address[offset_width..(offset_width + set_width)]
  def snoop_tag = snoop_address[(offset_width + set_width)..width]
  def snoop_line_hit = valid_lines[snoop_set] & (tags.port.response.bits[0] === snoop_tag)
  snoop.lookup_result.valid <== tags.port.response.valid & states.port.response.valid
  snoop.lookup_result.bits <== RV5StageDataSnoopLookupResult():
    hit: snoop_line_hit
    state: states.port.response.bits[0]
    line: lines.port.response.bits.as_vec(Bits(64))
  def snoop_pending = snoop.pending

  def lookup_accepts_input = refill.command.ready & writeback.command.ready & !snoop_pending & !lookup_needs_refill & !local_mutation
  core.request.ready <== lookup.ingress.ready & lookup_accepts_input
  lookup.ingress.valid <== core.request.valid & lookup_accepts_input
  lookup.ingress.bits <== core.request.bits
  def request_fire = fire(core.request)
  // A fence observes accepted lookup work, active refills, and the backing
  // store buffer. Same-cycle acceptance is included so no request can cross
  // the reported quiescent boundary.
  core.drained <== !request_fire & !lookup.egress.valid & refill.command.ready & writeback.command.ready
  def produces_load_hit = lookup_load & line_hit
  def produces_failed_sc = lookup_sc & !reservation_matches
  def produces_response = produces_load_hit ||| local_mutation ||| produces_failed_sc ||| install_refill
  responses.ingress.valid <== produces_response
  responses.ingress.bits <== RV5StageDataResp(xlen):
    data: mux(response_access.returns_old_value(),
              load_gen.value,
              mux(response_access.is_store_conditional() & produces_failed_sc,
                  bits(1, width),
                  bits(0, width)))
    tag: mux(install_refill, completion_request.tag, lookup_request.tag)

  tags.port.request.valid <== request_fire ||| install_refill ||| snoop_lookup_start
  tags.port.request.bits <== ReadWriteRequest(set_width, Bits(tag_width), 1):
    address: mux(install_refill,
                 completion_set,
                 mux(snoop_lookup_start,
                     snoop_set,
                     request_set_value))
    write: install_refill
    data: vec(mux(install_refill, completion_tag, lookup_tag))
    mask: Mask(1)(1)
  def update_snoop_state = snoop.update.valid & !snoop.update.bits.invalidate
  states.port.request.valid <== request_fire ||| install_refill ||| local_mutation ||| snoop_lookup_start ||| update_snoop_state
  def refill_cache_state = mux(refill.completion.bits.state === CHIResponseState.Unique,
                               CHICacheState.UniqueClean,
                               CHICacheState.SharedClean)
  states.port.request.bits <== ReadWriteRequest(set_width, CHICacheState, 1):
    address: mux(install_refill,
                 completion_set,
                 mux(local_mutation,
                     lookup_set,
                     mux(snoop_lookup_start,
                         snoop_set,
                         mux(update_snoop_state,
                             snoop.update.bits.address[offset_width..(offset_width + set_width)],
                             request_set_value))))
    write: install_refill ||| local_mutation ||| update_snoop_state
    data: vec(mux(install_refill & completion_access.needs_unique(),
                  CHICacheState.UniqueDirty,
                  mux(local_mutation,
                      CHICacheState.UniqueDirty,
                      mux(update_snoop_state, snoop.update.bits.state, refill_cache_state))))
    mask: Mask(1)(1)
  lines.port.request.valid <== request_fire ||| cache_write ||| snoop_lookup_start
  lines.port.request.bits <== ReadWriteRequest(set_width, Bits(8), RV5StageCacheLineBytes):
    address: mux(cache_write,
                 cache_write_set,
                 mux(snoop_lookup_start, snoop_set, request_set_value))
    write: cache_write
    data: mux(local_mutation,
              store_line_data,
              mux(completing_mutation, merged_refill_line, refill_line_bytes))
    mask: mux(local_mutation,
              store_line_mask,
              !bits(0, RV5StageCacheLineBytes)).into(Mask(RV5StageCacheLineBytes))

  def reservation_line_address = align_down(reservation_address, RV5StageCacheLineBytes)
  def lookup_line_address = align_down(lookup_request.address, RV5StageCacheLineBytes)
  def completing_lr = produces_load_hit & (lookup_access === MemoryOperation.LoadReserved) ||| (
    install_refill & (completion_access === MemoryOperation.LoadReserved)
  )
  def local_reservation_clear = fire(lookup.egress) & (
    lookup_sc ||| ((lookup_store ||| lookup_atomic) & (lookup_line_address === reservation_line_address))
  )
  def snoop_reservation_clear = snoop.update.valid & snoop.update.bits.invalidate & (
    align_down(snoop.update.bits.address, RV5StageCacheLineBytes) === reservation_line_address
  )
  def replacement_reservation_clear = fire(lookup.egress) & lookup_needs_refill & !line_hit & line_valid & (
    victim_address === reservation_line_address
  )
  when completing_lr:
    reservation_valid <== Bool(#true)
    reservation_address <== response_address
    reservation_width <== response_width
  elsewhen (reservation_valid & (local_reservation_clear ||| snoop_reservation_clear ||| replacement_reservation_clear)):
    reservation_valid <== Bool(#false)

  when (snoop.update.valid & snoop.update.bits.invalidate):
    valid_lines <== valid_lines.updated(
      snoop.update.bits.address[offset_width..(offset_width + set_width)],
      Bool(#false)
    )
  elsewhen (fire(writeback.command)):
    valid_lines <== valid_lines.updated(lookup_set, Bool(#false))
  elsewhen install_refill:
    valid_lines <== valid_lines.updated(completion_set, Bool(#true))

export:
  RV5StageL1DCache
