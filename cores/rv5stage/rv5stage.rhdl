#lang rhdl
// Composes RV5Stage's core and L1 caches behind ready-valid CHI channel bundles.

import:
  "core-flow.rhdl" open
  "interrupt.rhdl" open
  "chi.rhdl" open
  "icache/cache.rhdl" open
  "dcache/cache.rhdl" open
  "memory-router.rhdl" open
  "uncached.rhdl" open
  "mmu/mmu.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  lib("rhdl/std/bits.rhdl").Pow2Int
  lib("rhdl/std/ready-valid.rhdl") open
  lib("chi/main.rhdl") open

sync_circuit RV5Stage(xlen :: XLen,
                      ~cache_sets: cache_sets :: Pow2Int = 64,
                      ~chi: config :: RV5StageCHIConfig):
  def width = xlen_width(xlen)
  def p = config.flit

  input chi_identity: RV5StageCHIIdentity(p)
  interface start(Irrevocable(Bits(width)), ~role: consumer)
  input interrupts: RV5StageInterrupts()
  input hart_id: Bits(width)
  input time_counter: Bits(64)
  interface imem(CHIRNChannels(p), ~role: node)
  interface dmem(CHIRNChannels(p), ~role: node)
  interface umem(CHIRNIChannels(p), ~role: node)
  output fault: Bool

  inst core(RV5StageCore(xlen))
  inst mmu(RV5StageMmu(xlen))
  inst l1i(RV5StageL1ICache(xlen, cache_sets, ~chi: config))
  inst l1d(RV5StageL1DCache(xlen, cache_sets, ~chi: config))
  inst memory_router(RV5StageMemoryRouter(xlen, config))
  inst uncached(RV5StageUncached(xlen, config))
  l1i.node_id <== chi_identity.instruction_node_id
  l1d.node_id <== chi_identity.data_node_id
  uncached.node_id <== chi_identity.device_node_id
  start |> core.start
  core.interrupts <== interrupts
  core.hart_id <== hart_id
  core.time_counter <== time_counter
  core.instruction_access |> mmu.instruction
  core.data_access |> mmu.data
  mmu.instruction_memory |> l1i.core
  mmu.data_memory |> memory_router.core
  memory_router.cache |> l1d.core
  memory_router.device |> uncached.core
  mmu.privilege <== core.privilege
  mmu.mstatus <== core.mstatus
  mmu.satp <== core.satp
  mmu.invalidate_all <== core.translation_flush
  l1i.chi <=> imem
  l1d.chi <=> dmem
  uncached.chi <=> umem
  fault <== core.fault

export:
  RV5Stage
