#lang rhdl
// Defines RV5Stage's ordered core-facing instruction-cache access protocol.

import:
  "../../../riscv/isa/xlen.rhm" open
  lib("rhdl/std/ready-valid.rhdl") open

bundle RV5StageInstructionReq(xlen :: XLen):
  address: Bits(xlen.width)

bundle RV5StageInstructionResp():
  instruction: Bits(32)
  page_fault: Bool

interface RV5StageInstructionAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    flush: Bool
    invalidate_all: Bool
    request: Decoupled(RV5StageInstructionReq(xlen))

  responder -> requester:
    response: Irrevocable(RV5StageInstructionResp())

export:
  RV5StageInstructionReq
  RV5StageInstructionResp
  RV5StageInstructionAccess
