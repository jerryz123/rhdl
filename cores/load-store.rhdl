#lang rhdl
// Generates XLEN load values and byte-lane stores within a 64-bit memory beat.

import:
  "../riscv/isa/xlen.rhm" open
  lib("rhdl/std/bits.rhdl") open

// The shared control describes the scalar access size independently of any
// instruction decoder or memory protocol.
hardware_enum MemoryWidth:
  Byte
  Half
  Word
  Double

  method is_aligned(width, address :: Hardware.bits) :: Bool:
    mux_lookup(
      width,
      ~default: is_aligned(address, 8),
      [
        [MemoryWidth.Byte, is_aligned(address, 1)],
        [MemoryWidth.Half, is_aligned(address, 2)],
        [MemoryWidth.Word, is_aligned(address, 4)]
      ]
    )

// Selects one scalar from a returned eight-byte beat and extends it to XLEN.
circuit LoadGen(xlen :: XLen):
  def xlen_bits = xlen.width

  input address: Bits(xlen_bits)
  input data: Bits(64)
  input width: MemoryWidth
  input unsigned_load: Bool
  output value: Bits(xlen_bits)

  def shifted :: Bits(64) = data >> concat(address[0..3], bits(0, 3))
  def byte = shifted[0..8]
  def half = shifted[0..16]
  def word = shifted[0..32]
  def double_value = if xlen == XLen.X64 | data | data[0..32]
  def signed_word = if xlen == XLen.X64 | as_bits(sext(cast(word, SInt(32)), 64)) | word
  def unsigned_word = if xlen == XLen.X64 | zext(word, 64) | word
  def signed_value :: Bits(xlen_bits) = mux_lookup(
    width,
    ~default: double_value,
    [
      [MemoryWidth.Byte, as_bits(sext(cast(byte, SInt(8)), xlen_bits))],
      [MemoryWidth.Half, as_bits(sext(cast(half, SInt(16)), xlen_bits))],
      [MemoryWidth.Word, signed_word]
    ]
  )
  def unsigned_value :: Bits(xlen_bits) = mux_lookup(
    width,
    ~default: double_value,
    [
      [MemoryWidth.Byte, zext(byte, xlen_bits)],
      [MemoryWidth.Half, zext(half, xlen_bits)],
      [MemoryWidth.Word, unsigned_word]
    ]
  )
  value <== mux(unsigned_load, unsigned_value, signed_value)

// Places one scalar into an eight-byte beat and marks exactly its byte lanes.
circuit StoreGen(xlen :: XLen):
  def xlen_bits = xlen.width

  input address: Bits(xlen_bits)
  input value: Bits(xlen_bits)
  input width: MemoryWidth
  output data: Bits(64)
  output mask: Mask(8)

  def offset = address[0..3]
  def shift = concat(offset, bits(0, 3))
  def base_mask = mux_lookup(
    width,
    ~default: !bits(0, 8),
    [
      [MemoryWidth.Byte, bits(0x01, 8)],
      [MemoryWidth.Half, bits(0x03, 8)],
      [MemoryWidth.Word, bits(0x0f, 8)]
    ]
  )
  def beat_value = if xlen == XLen.X64 | value | zext(value, 64)
  data <== beat_value << shift
  mask <== (base_mask << offset).into(Mask(8))

export:
  MemoryWidth
  LoadGen
  StoreGen
