#lang rhdl
// Generates aligned RV64-style load values and byte-lane store data and masks.

import:
  lib("rhdl/std/bits.rhdl") open

// The shared control describes the scalar access size independently of any
// instruction decoder or memory protocol.
hardware_enum MemoryWidth:
  Byte
  Half
  Word
  Double

fun memory_access_aligned(address :: Bits(64), width :: MemoryWidth) :~ Bool:
  mux_lookup(
    width,
    ~default: is_aligned(address, 8),
    [
      [MemoryWidth.Byte, is_aligned(address, 1)],
      [MemoryWidth.Half, is_aligned(address, 2)],
      [MemoryWidth.Word, is_aligned(address, 4)]
    ]
  )

// Selects one scalar from a returned eight-byte beat and extends it to RV64.
circuit LoadGen():
  input address: Bits(64)
  input data: Bits(64)
  input width: MemoryWidth
  input unsigned_load: Bool
  output value: Bits(64)

  def shifted :: Bits(64) = data >> concat(address[0..3], bits(0, 3))
  def byte = shifted[0..8]
  def half = shifted[0..16]
  def word = shifted[0..32]
  def signed_value = mux_lookup(
    width,
    ~default: data,
    [
      [MemoryWidth.Byte,
       cast(sext(cast(byte, SInt(8)), 64), Bits(64))],
      [MemoryWidth.Half,
       cast(sext(cast(half, SInt(16)), 64), Bits(64))],
      [MemoryWidth.Word,
       cast(sext(cast(word, SInt(32)), 64), Bits(64))]
    ]
  )
  def unsigned_value = mux_lookup(
    width,
    ~default: data,
    [
      [MemoryWidth.Byte, zext(byte, 64)],
      [MemoryWidth.Half, zext(half, 64)],
      [MemoryWidth.Word, zext(word, 64)]
    ]
  )
  value <== mux(unsigned_load, unsigned_value, signed_value)

// Places one scalar into an eight-byte beat and marks exactly its byte lanes.
circuit StoreGen():
  input address: Bits(64)
  input value: Bits(64)
  input width: MemoryWidth
  output data: Bits(64)
  output mask: Bits(8)

  def offset = address[0..3]
  def shift = concat(offset, bits(0, 3))
  def base_mask = mux_lookup(
    width,
    ~default: !bits(0, 8),
    [
      [MemoryWidth.Byte, bits(0x01, 8)],
      [MemoryWidth.Half, bits(0x03, 8)],
      [MemoryWidth.Word, bits(0x0f, 8)]
    ]
  )
  data <== value << shift
  mask <== base_mask << offset

export:
  MemoryWidth
  memory_access_aligned
  LoadGen
  StoreGen
