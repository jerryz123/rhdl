#lang rhombus
// Checks concrete mesh traffic instantiation without adding traffic choices to reusable modules.

import:
  "../../examples/mesh-traffic.rhm" open

check:
  example_traffic.length() ~is 12
  example_lowered_traffic.route_classes.length() ~is 12
  example_lowered_traffic.specs[0].ref.describe() ~is "all-pairs/from/terminal=router[0,0]/to/terminal=router[0,1]"
