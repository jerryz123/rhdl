#lang rhombus
// Defines symbolic hierarchical NoC authoring handles and named virtual-channel groups.

import:
  "../../host/annotations.rhm" open

export:
  NamePath
  NodeRef
  LinkRef
  RouteClassRef
  VCGroup
  VCRef
  name_path_equal
  node_ref_equal
  link_ref_equal
  route_class_ref_equal
  vc_ref_equal
  name_path_less
  node_ref_less
  link_ref_less
  route_class_ref_less
  vc_group_less

fun normalize_name_path(who, value):
  def segments :: NonemptyList.of(NonemptyString) = if value is_a String | [value] | value
  for (segment in segments):
    when segment.contains("/")
    | error(~who: who, "name path segments must not contain '/'")
  segments

fun as_name_path(who, value):
  if value is_a NamePath
  | value
  | NamePath(value)

class NamePath(segments :: NonemptyList.of(NonemptyString)):
  constructor (segments):
    super(normalize_name_path(#'NamePath, segments))

  method child(segment :: NonemptyString):
    when segment.contains("/")
    | error(~who: #'child, "child name must not contain '/'")
    NamePath(segments ++ [segment])

  method describe():
    String.join(segments, "/")

class NodeRef(path :: NamePath):
  constructor (path):
    super(as_name_path(#'NodeRef, path))

  method describe():
    path.describe()

class LinkRef(path :: NamePath):
  constructor (path):
    super(as_name_path(#'LinkRef, path))

  method describe():
    path.describe()

class RouteClassRef(path :: NamePath):
  constructor (path):
    super(as_name_path(#'RouteClassRef, path))

  method describe():
    path.describe()

class VCGroup(name :: NonemptyString, count :: PosInt):
  constructor (name :: NonemptyString, count :: PosInt):
    when name.contains("/")
    | error(~who: #'VCGroup, "VC-group name must not contain '/'")
    super(name, count)

  method describe():
    name ++ "[" ++ to_string(count) ++ "]"

class VCRef(link :: LinkRef, group :: NonemptyString, index :: Nat):
  constructor (link :: LinkRef, group :: NonemptyString, index :: Nat):
    when group.contains("/")
    | error(~who: #'VCRef, "VC reference group must not contain '/'")
    super(link, group, index)

  method describe():
    String.append(link.describe(), "/", group, "[", to_string(index), "]")

fun name_path_equal(left, right):
  left is_a NamePath && right is_a NamePath && left.segments == right.segments

fun node_ref_equal(left, right):
  left is_a NodeRef && right is_a NodeRef && name_path_equal(left.path, right.path)

fun link_ref_equal(left, right):
  left is_a LinkRef && right is_a LinkRef && name_path_equal(left.path, right.path)

fun route_class_ref_equal(left, right):
  left is_a RouteClassRef && right is_a RouteClassRef && name_path_equal(left.path, right.path)

fun vc_ref_equal(left, right):
  left is_a VCRef && right is_a VCRef && link_ref_equal(left.link, right.link) && left.group == right.group && left.index == right.index

fun name_path_less(left, right):
  left.describe() < right.describe()

fun node_ref_less(left, right):
  name_path_less(left.path, right.path)

fun link_ref_less(left, right):
  name_path_less(left.path, right.path)

fun route_class_ref_less(left, right):
  name_path_less(left.path, right.path)

fun vc_group_less(left, right):
  left.name < right.name
