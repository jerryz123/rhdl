#lang rhombus
// Defines symbolic route classes independently of normalized model identities.

import:
  "names.rhm" open

export:
  RouteClassSpec

class RouteClassSpec(ref, source, destination, metadata = #false):
  constructor (ref, source, destination, metadata = #false):
    unless ref is_a RouteClassRef
    | error(~who: #'RouteClassSpec,
            "route-class reference must be a RouteClassRef")
    unless source is_a NodeRef && destination is_a NodeRef
    | error(~who: #'RouteClassSpec,
            "route-class endpoints must be NodeRef values")
    super(ref, source, destination, metadata)

  method describe():
    String.append(ref.describe(), ": ", source.describe(), " -> ",
                  destination.describe())
