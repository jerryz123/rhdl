#lang rhombus
// Defines a reusable rectangular-mesh topology view and generator.

import:
  "../../authoring/main.rhm" open
  "../../../ridx/model/main.rhm" open
  "../../../ridx/materialize/main.rhm" open

export:
  MeshCoordinate
  MeshDirection
  MeshNodeBinding
  MeshLinkBinding
  RectangularMesh
  mesh_east
  mesh_west
  mesh_north
  mesh_south
  mesh_coordinate_equal
  mesh_direction_equal
  mesh_node_ref
  mesh_link_ref
  rectangular_mesh

class MeshCoordinate(x :: Nat, y :: Nat):

  method describe():
    "[" ++ to_string(x) ++ "," ++ to_string(y) ++ "]"

class MeshDirection(axis :: String, step :: Int):
  constructor (axis :: String, step :: Int):
    unless axis == "x" || axis == "y"
    | error(~who: #'MeshDirection, "mesh direction axis must be 'x' or 'y'")
    unless step == -1 || step == 1
    | error(~who: #'MeshDirection, "mesh direction step must be -1 or 1")
    super(axis, step)

  method describe():
    cond
    | axis == "x" && step == 1: "east"
    | axis == "x": "west"
    | step == 1: "north"
    | ~else: "south"

  method opposite():
    MeshDirection(axis, -step)

def mesh_east = MeshDirection("x", 1)
def mesh_west = MeshDirection("x", -1)
def mesh_north = MeshDirection("y", 1)
def mesh_south = MeshDirection("y", -1)

fun mesh_coordinate_equal(left, right):
  left is_a MeshCoordinate && right is_a MeshCoordinate && left.x == right.x && left.y == right.y

fun mesh_direction_equal(left, right):
  left is_a MeshDirection && right is_a MeshDirection && left.axis == right.axis && left.step == right.step

fun mesh_coordinate_less(left, right):
  if left.x == right.x
  | left.y < right.y
  | left.x < right.x

fun mesh_node_ref(x :: Nat, y :: Nat):
  def coordinate = MeshCoordinate(x, y)
  NodeRef("router" ++ coordinate.describe())

fun mesh_link_ref(source :: MeshCoordinate, direction :: MeshDirection):
  LinkRef(["router" ++ source.describe(), direction.describe()])

class MeshNodeBinding(coordinate :: MeshCoordinate, ref :: NodeRef)
class MeshLinkBinding(source :: MeshCoordinate,
                      destination :: MeshCoordinate,
                      direction :: MeshDirection,
                      ref :: LinkRef)

fun find_mesh_node_by_coordinate(bindings, coordinate):
  bindings.find(
    fun (binding): mesh_coordinate_equal(binding.coordinate, coordinate)
  )

fun find_mesh_node_by_ref(bindings, ref):
  bindings.find(fun (binding): node_ref_equal(binding.ref, ref))

fun find_mesh_link_by_ref(bindings, ref):
  bindings.find(fun (binding): link_ref_equal(binding.ref, ref))

fun find_outgoing_mesh_link(bindings, source, direction):
  bindings.find(
    fun (binding):
      mesh_coordinate_equal(binding.source, source) && mesh_direction_equal(binding.direction, direction)
  )

class RectangularMesh(width :: PosInt,
                      height :: PosInt,
                      spec :: TopologySpec,
                      node_bindings :: NonemptyList.of(MeshNodeBinding),
                      link_bindings :: List.of(MeshLinkBinding),
                      vc_groups :: NonemptyList.of(VCGroup)):
  method node_at(x :: Nat, y :: Nat):
    def coordinate = MeshCoordinate(x, y)
    def found = find_mesh_node_by_coordinate(node_bindings, coordinate)
    unless found
    | error(~who: #'node_at,
            "coordinate outside mesh " ++ coordinate.describe())
    found.ref

  method coordinate_of(ref :: NodeRef):
    def found = find_mesh_node_by_ref(node_bindings, ref)
    unless found
    | error(~who: #'coordinate_of, "node is not in mesh " ++ ref.describe())
    found.coordinate

  method direction_of(ref :: LinkRef):
    def found = find_mesh_link_by_ref(link_bindings, ref)
    unless found
    | error(~who: #'direction_of, "link is not in mesh " ++ ref.describe())
    found.direction

  method outgoing_link(node :: NodeRef, direction :: MeshDirection):
    def coordinate = coordinate_of(node)
    def found = find_outgoing_mesh_link(link_bindings, coordinate, direction)
    if found | found.ref | #false

  method inverse_link(ref :: LinkRef):
    def found = find_mesh_link_by_ref(link_bindings, ref)
    unless found
    | error(~who: #'inverse_link, "link is not in mesh " ++ ref.describe())
    def inverse = find_outgoing_mesh_link(
      link_bindings,
      found.destination,
      found.direction.opposite()
    )
    unless inverse
    | error(~who: #'inverse_link,
            "mesh link has no inverse " ++ ref.describe())
    inverse.ref

  method prefix(prefix):
    def prefixed_spec = prefix_topology(prefix, spec)
    def prefixed_nodes = node_bindings.map(
      fun (binding):
        MeshNodeBinding(binding.coordinate,
                        prefix_node_ref(prefix, binding.ref))
    )
    def prefixed_links = link_bindings.map(
      fun (binding):
        MeshLinkBinding(binding.source,
                        binding.destination,
                        binding.direction,
                        prefix_link_ref(prefix, binding.ref))
    )
    RectangularMesh(width,
                    height,
                    prefixed_spec,
                    prefixed_nodes,
                    prefixed_links,
                    vc_groups)

fun require_mesh_vc_groups(vc_groups :: NonemptyList.of(VCGroup)):
  for (group in vc_groups):
    when vc_groups.filter(
      ~keep: fun (candidate): candidate.name == group.name
    ).length() > 1
    | error(~who: #'rectangular_mesh,
            "duplicate VC group " ++ group.name)

fun mesh_coordinate_from_point(point :: IndexPoint):
  MeshCoordinate(point.coordinate("x"), point.coordinate("y"))

fun directional_mesh_links(space :: IndexSpace,
                           direction :: MeshDirection):
  materialize_relation(
    shift_relation(
      space,
      direction.axis,
      direction.step,
      ~boundary: "drop"
    )
  ).pairs.map(
    fun (pair):
      def source = mesh_coordinate_from_point(pair.source)
      def destination = mesh_coordinate_from_point(pair.target)
      MeshLinkBinding(source,
                      destination,
                      direction,
                      mesh_link_ref(source, direction))
  )

fun rectangular_mesh(width :: PosInt,
                     height :: PosInt,
                     vc_groups :: NonemptyList.of(VCGroup)):
  require_mesh_vc_groups(vc_groups)

  def coordinate_space = IndexSpace(
    [Axis("x", width), Axis("y", height)],
    ~name: "rectangular-mesh"
  )
  def node_bindings = index_by(
    coordinate_space,
    fun (point):
      def coordinate = mesh_coordinate_from_point(point)
      MeshNodeBinding(coordinate,
                      mesh_node_ref(coordinate.x, coordinate.y))
  ).values()

  def mutable link_bindings = []
  for (direction in [mesh_east, mesh_west, mesh_north, mesh_south]):
    link_bindings := link_bindings ++ directional_mesh_links(
      coordinate_space,
      direction
    )

  def links = link_bindings.map(
    fun (binding):
      directed_link(
        binding.ref,
        find_mesh_node_by_coordinate(node_bindings, binding.source).ref,
        find_mesh_node_by_coordinate(node_bindings, binding.destination).ref,
        vc_groups
      )
  )
  RectangularMesh(
    width,
    height,
    TopologySpec(node_bindings.map(fun (binding): binding.ref), links),
    node_bindings.sort(
      fun (left, right):
        mesh_coordinate_less(left.coordinate, right.coordinate)
    ),
    link_bindings.sort(
      fun (left, right): link_ref_less(left.ref, right.ref)
    ),
    vc_groups.sort(vc_group_less)
  )
