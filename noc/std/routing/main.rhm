#lang rhombus
// Aggregates reusable routing policies outside the core NoC abstractions.

import:
  "dimension-order.rhm" open
  "minimal-adaptive.rhm" open
  "adaptive-minimal-escape.rhm" open
  "up-down.rhm" open

export:
  all_from("dimension-order.rhm")
  all_from("minimal-adaptive.rhm")
  all_from("adaptive-minimal-escape.rhm")
  all_from("up-down.rhm")
