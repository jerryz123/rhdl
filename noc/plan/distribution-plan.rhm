#lang rhombus
// Compiles one-source multicast traffic into a deterministic static distribution tree.

import:
  "../model/main.rhm" open

export:
  DistributionTiming
  natural_distribution_timing
  equalized_distribution_timing
  DistributionSitePlan
  DistributionSinkPlan
  DistributionPlan
  compile_distribution

class DistributionTiming(equalized :: Boolean):
  opaque
  internal _DistributionTiming
  constructor ~none

def natural_distribution_timing = _DistributionTiming(#false)
def equalized_distribution_timing = _DistributionTiming(#true)

class DistributionDiscovery(node :: NodeId,
                            parent_edge :: False || ConnectivityEdge,
                            depth :: Nat)

class DistributionSitePlan(index :: Nat,
                           node :: NodeId,
                           parent_index :: False || Nat,
                           parent_edge :: False || ConnectivityEdge,
                           child_indices :: List.of(Nat),
                           sink_indices :: List.of(Nat),
                           depth :: Nat):
  opaque
  internal _DistributionSitePlan
  constructor ~none

class DistributionSinkPlan(index :: Nat,
                           terminal :: EjectionTerminal,
                           site_index :: Nat,
                           natural_latency :: Nat,
                           padding :: Nat):
  opaque
  internal _DistributionSinkPlan
  constructor ~none

class DistributionPlan(connectivity :: ConnectivityGraph,
                       source :: InjectionTerminal,
                       sinks :: NonemptyList.of(EjectionTerminal),
                       sites :: NonemptyList.of(DistributionSitePlan),
                       selected_edges :: List.of(ConnectivityEdge),
                       sink_plans :: NonemptyList.of(DistributionSinkPlan),
                       timing :: DistributionTiming,
                       maximum_latency :: Nat):
  opaque
  internal _DistributionPlan
  constructor ~none

  method site(node :: NodeId) :: DistributionSitePlan:
    def found = sites.find(fun (candidate): node_id_equal(candidate.node, node))
    unless found
    | error(~who: #'site, "node does not participate in this distribution")
    found

  method sink(id :: EjectionId) :: DistributionSinkPlan:
    def found = sink_plans.find(fun (candidate): ejection_id_equal(candidate.terminal.id, id))
    unless found
    | error(~who: #'sink, "unknown distribution sink " ++ id.describe())
    found

fun distribution_find_discovery(discoveries :: List.of(DistributionDiscovery),
                                node :: NodeId):
  discoveries.find(fun (candidate): node_id_equal(candidate.node, node))

fun distribution_contains_node(nodes :: List.of(NodeId), node :: NodeId) :: Boolean:
  nodes.find(fun (candidate): node_id_equal(candidate, node)) != #false

fun distribution_site_index(nodes :: NonemptyList.of(NodeId), node :: NodeId) :: Nat:
  def found = nodes.find_index(fun (candidate): node_id_equal(candidate, node))
  unless found != #false
  | error(~who: #'compile_distribution, "internal error: missing distribution site")
  found

fun distribution_duplicate_sink(sinks :: NonemptyList.of(EjectionTerminal),
                                sink :: EjectionTerminal) :: Boolean:
  sinks.filter(~keep: fun (candidate): ejection_id_equal(candidate.id, sink.id)).length() > 1

fun distribution_discover(connectivity :: ConnectivityGraph,
                          root :: NodeId) :: NonemptyList.of(DistributionDiscovery):
  def mutable pending = [root]
  def mutable discoveries = [DistributionDiscovery(root, #false, 0)]
  while pending.length() > 0:
    def node = pending[0]
    pending := pending.drop(1)
    def discovery = distribution_find_discovery(discoveries, node)
    for (edge in connectivity.outgoing_edges(node)):
      unless distribution_find_discovery(discoveries, edge.destination)
      | discoveries := discoveries ++ [
          DistributionDiscovery(edge.destination, edge, discovery.depth + 1)
        ]
        pending := pending ++ [edge.destination]
  discoveries

fun distribution_required_nodes(discoveries :: NonemptyList.of(DistributionDiscovery),
                                sinks :: NonemptyList.of(EjectionTerminal)) :: NonemptyList.of(NodeId):
  def mutable required = []
  fun require_path(node :: NodeId):
    unless distribution_contains_node(required, node)
    | required := required ++ [node]
      def discovery = distribution_find_discovery(discoveries, node)
      when discovery.parent_edge
      | require_path(discovery.parent_edge.source)
  for (sink in sinks):
    require_path(sink.router)
  discoveries.filter(~keep: fun (discovery): distribution_contains_node(required, discovery.node)).map(
    fun (discovery): discovery.node
  )

fun compile_distribution(connectivity :: ConnectivityGraph,
                         source :: InjectionTerminal,
                         sinks :: NonemptyList.of(EjectionTerminal),
                         ~timing: timing :: DistributionTiming = natural_distribution_timing)
  :: DistributionPlan:
  unless connectivity.contains_node(source.router)
  | error(~who: #'compile_distribution, "distribution source is attached to an unknown node")
  for (sink in sinks):
    when distribution_duplicate_sink(sinks, sink)
    | error(~who: #'compile_distribution, "duplicate distribution sink " ++ sink.id.describe())
    unless connectivity.contains_node(sink.router)
    | error(~who: #'compile_distribution, "distribution sink is attached to an unknown node")

  def ordered_sinks = sinks.sort(fun (left, right): ejection_id_less(left.id, right.id))
  def discoveries = distribution_discover(connectivity, source.router)
  for (sink in ordered_sinks):
    unless distribution_find_discovery(discoveries, sink.router)
    | error(~who: #'compile_distribution, "unreachable distribution sink " ++ sink.describe())

  def site_nodes = distribution_required_nodes(discoveries, ordered_sinks)
  def mutable maximum_latency = 0
  for (sink in ordered_sinks):
    def latency = distribution_find_discovery(discoveries, sink.router).depth + 1
    when latency > maximum_latency
    | maximum_latency := latency

  def sink_plans:
    for List (sink in ordered_sinks, index in 0..ordered_sinks.length()):
      def site_index = distribution_site_index(site_nodes, sink.router)
      def natural_latency = distribution_find_discovery(discoveries, sink.router).depth + 1
      _DistributionSinkPlan(
        index,
        sink,
        site_index,
        natural_latency,
        if timing.equalized | maximum_latency - natural_latency | 0
      )

  def sites:
    for List (node in site_nodes, index in 0..site_nodes.length()):
      def discovery = distribution_find_discovery(discoveries, node)
      def parent_index:
        if discovery.parent_edge
        | distribution_site_index(site_nodes, discovery.parent_edge.source)
        | #false
      def mutable child_indices = []
      for (candidate in discoveries):
        when candidate.parent_edge && node_id_equal(candidate.parent_edge.source, node) && (
          distribution_contains_node(site_nodes, candidate.node)
        )
        | child_indices := child_indices ++ [distribution_site_index(site_nodes, candidate.node)]
      def mutable local_sink_indices = []
      for (sink_plan in sink_plans):
        when sink_plan.site_index == index
        | local_sink_indices := local_sink_indices ++ [sink_plan.index]
      _DistributionSitePlan(
        index,
        node,
        parent_index,
        discovery.parent_edge,
        child_indices,
        local_sink_indices,
        discovery.depth
      )

  def mutable selected_edges = []
  for (site in sites):
    when site.parent_edge
    | selected_edges := selected_edges ++ [site.parent_edge]

  _DistributionPlan(
    connectivity,
    source,
    ordered_sinks,
    sites,
    selected_edges,
    sink_plans,
    timing,
    maximum_latency
  )
