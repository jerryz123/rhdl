#lang rhombus
// Merges one network's router plans into a uniform, site-selected router family.

import:
  "../model/main.rhm" open
  "router-plan.rhm" open
  "network-plan.rhm" open

export:
  RouterFamilyMember
  RouterFamilyPlanRow
  RouterFamilyInjectionPort
  RouterFamilyEjectionPort
  RouterFamilyVCConnection
  RouterFamilyLinkConnection
  RouterFamilyPlan

fun max_length(items, project):
  def mutable maximum = 0
  for (item in items):
    def count = project(item).length()
    when count > maximum
    | maximum := count
  maximum

fun remap_mask(local_mask, target_slots):
  def mutable family_mask = 0
  for (local_bit in 0..target_slots.length()):
    when (local_mask bits.and (1 bits.(<<) local_bit)) != 0
    | family_mask := family_mask bits.or (1 bits.(<<) target_slots[local_bit])
  family_mask

class RouterFamilyMember(site_key :: Nat,
                         router_plan :: RouterPlan,
                         origin_slots :: List.of(Nat),
                         target_slots :: List.of(Nat)):
  opaque
  internal _RouterFamilyMember
  constructor ~none

  method origin_slot(origin):
    origin_slots[router_plan.origin_key(origin)]

  method target_slot(target):
    target_slots[router_plan.target_bit(target)]

  method describe():
    String.append("site-key=", to_string(site_key), ": ",
                  router_plan.node.describe(), "; inputs=",
                  to_string(origin_slots), "; targets=",
                  to_string(target_slots))

class RouterFamilyPlanRow(route_row,
                          site_key :: Nat,
                          route_key :: Nat,
                          origin_key :: Nat,
                          target_mask :: Nat):
  opaque
  internal _RouterFamilyPlanRow
  constructor ~none

class RouterFamilyInjectionPort(terminal :: InjectionTerminal,
                                site_key :: Nat,
                                input_index :: Nat):
  opaque
  internal _RouterFamilyInjectionPort
  constructor ~none

class RouterFamilyEjectionPort(terminal :: EjectionTerminal,
                               site_key :: Nat,
                               target_index :: Nat):
  opaque
  internal _RouterFamilyEjectionPort
  constructor ~none

class RouterFamilyVCConnection(vc :: VCId,
                               source_site_key :: Nat,
                               source_target_index :: Nat,
                               destination_site_key :: Nat,
                               destination_input_index :: Nat):
  opaque
  internal _RouterFamilyVCConnection
  constructor ~none

class RouterFamilyLinkConnection(link :: PhysicalLink,
                                 source_site_key :: Nat,
                                 source_target_indices :: List.of(Nat),
                                 destination_site_key :: Nat,
                                 destination_input_indices :: List.of(Nat)):
  opaque
  internal _RouterFamilyLinkConnection
  constructor ~none

class RouterFamilyPlan(network_plan :: NetworkPlan,
                       members :: NonemptyList.of(RouterFamilyMember),
                       injection_count :: Nat,
                       ingress_count :: Nat,
                       egress_count :: Nat,
                       ejection_count :: Nat,
                       input_count :: Nat,
                       target_count :: Nat,
                       rows :: List.of(RouterFamilyPlanRow),
                       injection_ports :: List.of(RouterFamilyInjectionPort),
                       ejection_ports :: List.of(RouterFamilyEjectionPort),
                       vc_connections :: List.of(RouterFamilyVCConnection),
                       link_connections :: List.of(RouterFamilyLinkConnection)):
  constructor (network_plan :: NetworkPlan):
    def router_plans = network_plan.router_plans
    def injection_count = max_length(router_plans, fun (plan): plan.injection_terminals)
    def ingress_count = max_length(
      router_plans,
      fun (plan): plan.origins.drop(plan.injection_terminals.length())
    )
    def egress_count = max_length(router_plans, fun (plan): plan.output_vcs)
    def ejection_count = max_length(router_plans, fun (plan): plan.ejection_terminals)
    def input_count = injection_count + ingress_count
    def target_count = egress_count + ejection_count

    def members:
      for List (router_plan in router_plans,
                site_key in 0..router_plans.length()):
        def local_injection_count = router_plan.injection_terminals.length()
        def local_ingress_count = router_plan.origins.length() - local_injection_count
        def local_egress_count = router_plan.output_vcs.length()
        def local_ejection_count = router_plan.ejection_terminals.length()
        def origin_slots = (
          for List (index in 0..local_injection_count): index
        ) ++ (
          for List (index in 0..local_ingress_count): injection_count + index
        )
        def target_slots = (
          for List (index in 0..local_egress_count): index
        ) ++ (
          for List (index in 0..local_ejection_count): egress_count + index
        )
        _RouterFamilyMember(site_key, router_plan, origin_slots, target_slots)

    def mutable rows = []
    for (member in members):
      for (row in member.router_plan.rows):
        rows := rows ++ [
          _RouterFamilyPlanRow(
            row.route_row,
            member.site_key,
            row.route_key,
            member.origin_slots[row.origin_key],
            remap_mask(row.target_mask, member.target_slots)
          )
        ]

    def injection_ports:
      for List (port in network_plan.injection_ports):
        def member = members[port.router_index]
        _RouterFamilyInjectionPort(
          port.terminal,
          member.site_key,
          member.origin_slot(Injection(port.terminal))
        )

    def ejection_ports:
      for List (port in network_plan.ejection_ports):
        def member = members[port.router_index]
        _RouterFamilyEjectionPort(
          port.terminal,
          member.site_key,
          member.target_slot(port.terminal)
        )

    def vc_connections:
      for List (connection in network_plan.vc_connections):
        def source = members[connection.source_router_index]
        def destination = members[connection.destination_router_index]
        _RouterFamilyVCConnection(
          connection.vc,
          source.site_key,
          source.target_slot(connection.vc),
          destination.site_key,
          destination.origin_slot(HeldVC(connection.vc))
        )

    def link_connections:
      for List (connection in network_plan.link_connections):
        def source = members[connection.source_router_index]
        def destination = members[connection.destination_router_index]
        _RouterFamilyLinkConnection(
          connection.link,
          source.site_key,
          connection.link.virtual_channels().map(fun (vc): source.target_slot(vc)),
          destination.site_key,
          connection.link.virtual_channels().map(
            fun (vc): destination.origin_slot(HeldVC(vc))
          )
        )

    super(network_plan,
          members,
          injection_count,
          ingress_count,
          egress_count,
          ejection_count,
          input_count,
          target_count,
          rows,
          injection_ports,
          ejection_ports,
          vc_connections,
          link_connections)

  method member(node :: NodeId):
    def found = members.find(
      fun (candidate): node_id_equal(candidate.router_plan.node, node)
    )
    unless found
    | error(~who: #'RouterFamilyPlan, "unknown router-family node")
    found

  method site_key(node :: NodeId):
    member(node).site_key

  method origin_slot(node :: NodeId, origin):
    member(node).origin_slot(origin)

  method target_slot(node :: NodeId, target):
    member(node).target_slot(target)

  method describe():
    String.append("router family: members=", to_string(members.length()),
                  ", injection=", to_string(injection_count),
                  ", ingress=", to_string(ingress_count),
                  ", egress=", to_string(egress_count),
                  ", ejection=", to_string(ejection_count),
                  ", rows=", to_string(rows.length()))
