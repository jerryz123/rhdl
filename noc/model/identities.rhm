#lang rhombus
// Defines nominal and deterministically ordered identities for pure NoC graph objects.

export:
  NodeId
  LinkId
  VCId
  RouteClassId
  node_id_equal
  link_id_equal
  vc_id_equal
  route_class_id_equal
  node_id_less
  link_id_less
  vc_id_less
  route_class_id_less

class NodeId(value :: Nat):

  method describe():
    "n" ++ to_string(value)

class LinkId(value :: Nat):

  method describe():
    "l" ++ to_string(value)

class VCId(link_id :: LinkId, index :: Nat):

  method describe():
    link_id.describe() ++ ".vc" ++ to_string(index)

class RouteClassId(value :: Nat):

  method describe():
    "r" ++ to_string(value)

fun node_id_equal(left, right):
  left is_a NodeId && right is_a NodeId && left.value == right.value

fun link_id_equal(left, right):
  left is_a LinkId && right is_a LinkId && left.value == right.value

fun vc_id_equal(left, right):
  left is_a VCId && right is_a VCId && link_id_equal(left.link_id, right.link_id) && left.index == right.index

fun route_class_id_equal(left, right):
  left is_a RouteClassId && right is_a RouteClassId && left.value == right.value

fun node_id_less(left, right):
  left.value < right.value

fun link_id_less(left, right):
  left.value < right.value

fun vc_id_less(left, right):
  if link_id_equal(left.link_id, right.link_id)
  | left.index < right.index
  | link_id_less(left.link_id, right.link_id)

fun route_class_id_less(left, right):
  left.value < right.value
