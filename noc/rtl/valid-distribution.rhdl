#lang rhodium
// Implements a registered one-source multicast network for nonbackpressured Valid events.

import:
  lib("rhodium/std/ready-valid.rhdl").Valid
  lib("rhodium/std/flow/pipe.rhdl").ValidPipe
  "../plan/distribution-plan.rhm".DistributionPlan

export:
  ValidDistributionConfig
  compile_valid_distribution
  ValidDistribution

class ValidDistributionConfig(plan :: DistributionPlan,
                              site_count :: PosInt,
                              sink_count :: PosInt):
  implements StableCircuitParam
  opaque
  internal _ValidDistributionConfig
  constructor ~none

fun compile_valid_distribution(plan :: DistributionPlan) :: ValidDistributionConfig:
  _ValidDistributionConfig(plan, plan.sites.length(), plan.sink_plans.length())

sync_circuit ValidDistribution(T :: DataType,
                               config :: ValidDistributionConfig):
  interface source(Valid(T), ~role: consumer)
  interface sinks[config.sink_count](Valid(T), ~role: producer)

  def initial_valid = vec(for List (_ in 0..config.site_count): Bool(#false))
  reg site_valid(Vec(config.site_count, Bool), ~init: initial_valid)
  reg site_bits(Vec(config.site_count, T))

  def arriving_valid = vec(
    for List (site in config.plan.sites):
      if site.parent_index is_a Nat
      | site_valid[site.parent_index]
      | source.valid
  )
  def arriving_bits = vec(
    for List (site in config.plan.sites):
      if site.parent_index is_a Nat
      | site_bits[site.parent_index]
      | source.bits
  )

  site_valid <== arriving_valid
  site_bits <== arriving_bits

  for (sink_plan in config.plan.sink_plans):
    def natural_valid = site_valid[sink_plan.site_index]
    def natural_bits = site_bits[sink_plan.site_index]
    if sink_plan.padding == 0
    | block:
        sinks[sink_plan.index].valid <== natural_valid
        sinks[sink_plan.index].bits <== natural_bits
    | block:
        inst sink_padding(ValidPipe(T, sink_plan.padding))
        sink_padding.ingress.valid <== natural_valid
        sink_padding.ingress.bits <== natural_bits
        sinks[sink_plan.index] <=> sink_padding.egress
