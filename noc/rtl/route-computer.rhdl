#lang rhdl
// Lowers one validated router plan into a local combinational route lookup.

import:
  lib("rhdl/std/decode.rhdl") open
  "../plan/router-plan.rhm" open

export:
  RouteLookupKey
  RouteDecision
  RouteDecoder
  compile_route_decoder
  RouteComputer

// Names the semantic selector fields consumed by the generic typed decoder.
bundle RouteLookupKey(route_width, origin_width):
  route_key: Bits(route_width)
  origin_key: Bits(origin_width)

// Gives hardware consumers named access to the typed routing decision.
bundle RouteDecision(mask_width):
  allowed_mask: Bits(mask_width)
  eject: Bool
  valid: Bool

class RouteDecoder(router_plan,
                   route_width,
                   origin_width,
                   mask_width,
                   decoder):
  opaque
  internal _RouteDecoder
  constructor ~none

  method lookup(route_key :: Hardware,
                origin_key :: Hardware) :: Hardware:
    decoder(
      RouteLookupKey(route_width, origin_width):
        route_key: route_key
        origin_key: origin_key
    )

// Compiles one validated router plan into an opaque, reusable typed decoder.
fun compile_route_decoder(router_plan :: RouterPlan,
                          ~espresso: espresso = #'auto) :: RouteDecoder:
  unless router_plan.rows.length() > 0
  | error(~who: #'compile_route_decoder,
          "route decoding requires at least one local route row")
  def route_width = index_width(router_plan.route_classes.length())
  def origin_width = index_width(router_plan.origins.length())
  def output_count = router_plan.output_vcs.length()
  // RHDL has no zero-width Bits value. An ejection-only router therefore
  // carries one constant-zero padding bit without inventing an output VC.
  def mask_width = if output_count > 0 | output_count | 1
  def cases = router_plan.rows.map(
    fun (entry):
      DecodeCase(
        (pattern(RouteLookupKey(route_width, origin_width)):
           route_key: bits(entry.route_key, route_width)
           origin_key: bits(entry.origin_key, origin_width)),
        (pattern(RouteDecision(mask_width)):
           allowed_mask: bits(entry.allowed_mask, mask_width)
           eject: Bool(entry.route_row.eject)
           valid: Bool(#true))
      )
  )
  // Compile the generic decoder once. Hardware lookups reuse this host-side
  // plan and never know whether DecodeGen selected Espresso or its fallback.
  def decoder = DecodeGen(
    cases,
    ~default: (pattern(RouteDecision(mask_width)):
                 allowed_mask: bits(0, mask_width)
                 eject: Bool(#false)
                 valid: Bool(#false)),
    ~espresso: espresso
  )
  _RouteDecoder(router_plan,
                route_width,
                origin_width,
                mask_width,
                decoder)

circuit RouteComputer(route_decoder :: RouteDecoder):
  input route_key: Bits(route_decoder.route_width)
  input origin_key: Bits(route_decoder.origin_width)
  output allowed_mask: Bits(route_decoder.mask_width)
  output eject: Bool
  output valid: Bool

  def decision :: Hardware = route_decoder.lookup(route_key, origin_key)
  allowed_mask <== decision.allowed_mask
  eject <== decision.eject
  valid <== decision.valid
