#lang rhodium
// Re-exports NoC packet transport and static distribution hardware.

import:
  "valid-distribution.rhdl" open
  "route-computer.rhdl" open
  "route-adapter.rhdl" open
  "allocator.rhdl" open
  "router.rhdl" open
  "wormhole-router.rhdl" open

export:
  all_from("valid-distribution.rhdl")
  all_from("route-computer.rhdl")
  all_from("route-adapter.rhdl")
  all_from("allocator.rhdl")
  all_from("router.rhdl")
  all_from("wormhole-router.rhdl")
