#lang rhombus
// Emits CIRCT input for the requested FESVR-backed SoC harness.

import:
  rhombus/cmdline open
  "../rhdl/backend/circt.rhm" open
  "soc-harness.rhdl" as harness

def arguments = current_command_line()
unless arguments.length() == 1
| error(~who: #'emit_soc_harness,
        "expected one SoC variant argument")

def soc = harness.simulation_soc(arguments[0])
print(emit_circt(harness.simulation_design(soc)))
