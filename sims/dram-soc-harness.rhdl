#lang rhodium
// Wraps DramSoC with FESVR and a simulation-owned CHI memory model.

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("chi/main.rhdl") as chi
  lib("socs/simple-soc.rhdl") as simple
  lib("socs/dram-soc.rhdl") as dram
  "fesvr/direct-memory-htif.rhdl".FesvrRequester

sync_circuit SoCHarness():
  output exit: Bits(32)

  inst requester(FesvrRequester(XLen.X64, simple.simple_soc_flit, simple.simple_soc_host_node, simple.simple_soc_home_map))
  inst soc(dram.DramSoC())
  inst memory(chi.CHIRam(simple.simple_soc_ram_config))

  requester.port <=> soc.host.memory
  requester.start |> soc.host.start
  soc.dram <=> memory.port
  memory.identity <== chi.CHIRamIdentity(simple.simple_soc_flit):
    node_id: bits(simple.simple_soc_ram_params.node_id, simple.simple_soc_flit.node_id_width)
    base_address: bits(simple.simple_soc_ram_params.base_address, simple.simple_soc_flit.request_address_width)
  exit <== requester.exit

def design = elaborate(SoCHarness())

export:
  SoCHarness
  design
