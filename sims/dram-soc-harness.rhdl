#lang rhodium
// Wraps DramSoC with FESVR and a simulation-owned CHI memory model.

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("chi/main.rhdl") as chi
  lib("socs/dram-soc.rhdl") as dram
  "fesvr/direct-memory-htif.rhdl".FesvrRequester

sync_circuit SoCHarness():
  output exit: Bits(32)

  inst requester(FesvrRequester(XLen.X64, dram.dram_soc_flit, dram.dram_soc_host_node, dram.dram_soc_home_map))
  inst soc(dram.DramSoC())
  inst memory(chi.CHIDPIMemory(dram.dram_soc_ram_config))

  requester.port <=> soc.host.memory
  requester.start |> soc.host.start
  soc.dram <=> memory.port
  memory.identity <== chi.CHIRamIdentity(dram.dram_soc_flit):
    node_id: bits(dram.dram_soc_ram_params.node_id, dram.dram_soc_flit.node_id_width)
    base_address: bits(dram.dram_soc_ram_params.base_address, dram.dram_soc_flit.request_address_width)
  exit <== requester.exit

def design = elaborate(SoCHarness())

export:
  SoCHarness
  design
