#lang rhdl
// Wraps a selected SoC with the FESVR host model used by executable simulations.

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("socs/simple-soc.rhdl") as simple
  lib("socs/tiled-soc.rhdl") as tiled
  lib("socs/tiled-soc-config.rhdl") as tiled_config
  "fesvr/direct-memory-htif.rhdl".FesvrRequester

enum SimulationSoC
| Simple
| Tiled

fun simulation_soc(name :: String) :: SimulationSoC:
  match name
  | "simple": SimulationSoC.Simple
  | "tiled": SimulationSoC.Tiled
  | ~else:
      error(~who: #'simulation_soc,
            "unsupported SoC '" ++ name ++ "'; expected simple or tiled")

sync_circuit SoCHarness(soc :: SimulationSoC):
  output exit: Bits(32)

  if soc == SimulationSoC.Tiled
  | block:
      inst requester(FesvrRequester(XLen.X64, tiled_config.tiled_soc_flit, tiled_config.tiled_soc_host_node, tiled_config.tiled_soc_home_map))
      inst soc(tiled.TiledSoC())
      requester.port <=> soc.host.memory
      requester.start |> soc.host.start
      exit <== requester.exit
      #void
  | block:
      inst requester(FesvrRequester(XLen.X64, simple.simple_soc_flit, simple.simple_soc_host_node, simple.simple_soc_home_map))
      inst soc(simple.SimpleSoC())
      requester.port <=> soc.host.memory
      requester.start |> soc.host.start
      exit <== requester.exit
      #void

fun simulation_design(soc :: SimulationSoC):
  elaborate(SoCHarness(soc))

export:
  SimulationSoC
  simulation_soc
  SoCHarness
  simulation_design
