#lang rhodium
// Wraps the self-contained MiniSoC with the FESVR requester used by simulations.

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("socs/mini-soc.rhdl") as mini
  "fesvr/direct-memory-htif.rhdl".FesvrRequester

sync_circuit SoCHarness():
  output exit: Bits(32)

  inst requester(FesvrRequester(XLen.X64, mini.mini_soc_flit, mini.mini_soc_host_node, mini.mini_soc_home_map))
  inst soc(mini.MiniSoC())

  requester.port <=> soc.host.memory
  requester.start |> soc.host.start
  exit <== requester.exit

def design = elaborate(SoCHarness())

export:
  SoCHarness
  design
