#lang rhombus
// Checks the FESVR-backed external-memory SimpleSoC simulation harness.

import:
  "../../rhodium/core/main.rhm" open
  "../simple-soc-harness.rhdl" as harness

def design = harness.design
def top = design.modules.find(fun (module_def): module_def.name == "SoCHarness")
def module_names = design.modules.map(fun (module_def): module_def.name)

check:
  top.inputs.map(fun (port): port.name) ~is ["clock", "reset"]
  top.outputs.map(fun (port): port.name) ~is ["exit"]
  module_names.contains("SimpleSoC") ~is #true
  module_names.contains("MiniSoC") ~is #false
  module_names.contains("RV5StageFpPipeline") ~is #true
  module_names.contains("RV5StageDisabledFpPipeline") ~is #false
  module_names.contains("TiledSoC") ~is #false
  module_names.contains("CHIDPIMemory") ~is #true
  module_names.contains("CHIRam") ~is #false
  module_names.contains("FesvrRequester") ~is #true
  module_names.contains("FesvrSnoopResponder") ~is #true
  verify_design(design) ~is #void
