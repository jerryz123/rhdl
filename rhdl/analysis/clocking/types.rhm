#lang rhombus
// Defines backend-independent clock-analysis summaries, environments, and report objects.

import:
  "../../core/ir.rhm" open

export:
  ClockUse
  ClockGroup
  NoReset
  AmbientReset
  LocalReset
  Combinational
  SingleClock
  MultiClock
  StaticProvenance
  ExternalProvenance
  ControlReference
  StateProvenance
  CrossingReference
  CrossedProvenance
  StaticInput
  SameClock
  ForeignClock
  UnknownInput
  MultiClockFanIn
  MixedTimingFanIn
  UnknownClock
  UnknownInputTiming
  SynchronousInputTiming
  AsynchronousInputTiming
  TopInputContract
  IdenticalClockRelationship
  DerivedClockRelationship
  AsynchronousClockRelationship
  ExclusiveClockRelationship
  TemporalEnvironment
  IdenticalClock
  DerivedClock
  AsynchronousClock
  ExclusiveClock
  UnknownClockRelationship
  AsynchronousEnvironmentInput
  OutputLeafProvenance
  TemporalSinkInput
  TemporalSink
  CdcViolation
  CrossingArrival
  CrossingReconvergence
  ModuleTemporalSummary
  DesignTemporalSummary

// Records one module-local clocked effect after transparent wire aliases have
// been resolved. A false reset means the operation is resetless.
class ClockUse(operation :: Operation,
               clock :: Value,
               reset = #false)

class ClockGroup(clock :: Value,
                 uses :: List)

class NoReset(operations :: List)
class AmbientReset(reset :: Value,
                   operations :: List)
class LocalReset(reset :: Value,
                 operations :: List)

// These three result shapes keep the important clocking distinction explicit
// without adding domain metadata to the hardware IR itself.
class Combinational(module_def :: Module,
                    reset_uses :: List)
class SingleClock(module_def :: Module,
                  clock :: Value,
                  reset_uses :: List,
                  clocked_operations :: List)
class MultiClock(module_def :: Module,
                 clock_groups :: List,
                 reset_uses :: List)

// Temporal provenance remains an analysis result. External leaves are
// symbolic until a containing instance binds them, while state keeps its
// defining operation and instance path so reused definitions stay distinct.
class StaticProvenance()
class ExternalProvenance(input_index :: Nat,
                         path :: List)
class ControlReference(instance_path :: List,
                       value :: Value)
class StateProvenance(instance_path :: List,
                      operation :: Operation,
                      path :: List,
                      clock,
                      reset = #false)
class CrossingReference(instance_path :: List,
                        operation :: Operation)
class CrossedProvenance(crossing :: CrossingReference,
                        path :: List,
                        source_origins :: List,
                        destination_clock)

// A sink-input classification records what is known independently of whether
// a caller chooses report-only analysis or the strict CDC policy.
class StaticInput()
class SameClock(clock :: ControlReference)
class ForeignClock(source_clock :: ControlReference,
                   destination_clock :: ControlReference)
class UnknownInput(inputs :: List)
class MultiClockFanIn(clocks :: List)
class MixedTimingFanIn(clocks :: List,
                       inputs :: List)
class UnknownClock(states :: List)

// Closed-design input contracts bind symbolic top input leaves to timing
// intent without mutating the module or its reusable symbolic summary. A
// contract path may name one aggregate subtree; overlapping contracts are
// rejected by closed-design analysis.
class UnknownInputTiming()
class SynchronousInputTiming(clock :: Value)
class AsynchronousInputTiming()
class TopInputContract(input :: Value,
                       path :: List,
                       timing)

// Clock relationships are environment facts between concrete top-level Clock
// inputs. Identical is an equivalence relation; the other relationships remain
// report-only until their compatibility policies are specified.
class IdenticalClockRelationship(left :: Value,
                                 right :: Value)
class DerivedClockRelationship(source :: Value,
                               destination :: Value,
                               description :: String)
class AsynchronousClockRelationship(left :: Value,
                                    right :: Value)
class ExclusiveClockRelationship(left :: Value,
                                 right :: Value,
                                 description :: String)
class TemporalEnvironment(input_contracts :: List = [],
                          clock_relationships :: List = [])

// Closed-design classifications distinguish exact identity from declared
// relationships and from an asynchronous external input contract.
class IdenticalClock(source_clock :: ControlReference,
                     destination_clock :: ControlReference)
class DerivedClock(source_clock :: ControlReference,
                   destination_clock :: ControlReference,
                   relationship :: DerivedClockRelationship)
class AsynchronousClock(source_clock :: ControlReference,
                        destination_clock :: ControlReference,
                        relationship :: AsynchronousClockRelationship)
class ExclusiveClock(source_clock :: ControlReference,
                     destination_clock :: ControlReference,
                     relationship :: ExclusiveClockRelationship)
class UnknownClockRelationship(source_clock :: ControlReference,
                               destination_clock :: ControlReference)
class AsynchronousEnvironmentInput(inputs :: List)

class OutputLeafProvenance(output_index :: Nat,
                           path :: List,
                           origins :: List)
class TemporalSinkInput(name :: String,
                        path :: List,
                        origins :: List,
                        classification,
                        crossing = #false)
class TemporalSink(instance_path :: List,
                   operation :: Operation,
                   kind :: String,
                   clock :: ControlReference,
                   inputs :: List)
// Closed-design CDC policy findings retain enough structure for tools to
// navigate the sink and explain every unsafe origin without parsing text.
class CdcViolation(instance_path :: List,
                   operation :: Operation,
                   sink_kind :: String,
                   input_name :: String,
                   input_path :: List,
                   classification,
                   origins :: List,
                   reason :: String)
class CrossingArrival(input_name :: String,
                      input_path :: List,
                      provenance :: CrossedProvenance)
class CrossingReconvergence(instance_path :: List,
                            operation :: Operation,
                            kind :: String,
                            arrivals :: List)
class ModuleTemporalSummary(module_def :: Module,
                            output_leaves :: List,
                            sinks :: List,
                            reconvergences :: List = [])
class DesignTemporalSummary(elaboration :: DesignElaboration,
                            environment :: TemporalEnvironment,
                            output_leaves :: List,
                            sinks :: List,
                            reconvergences :: List = [],
                            cdc_violations :: List = [])
