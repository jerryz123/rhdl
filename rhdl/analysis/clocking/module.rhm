#lang rhombus
// Summarizes clock use and hierarchy-aware temporal provenance for completed core modules.

import:
  "../../core/types.rhm" open
  "../../core/ir.rhm" open
  "../../core/ops.rhm" open
  "../../core/dependencies.rhm" open
  "types.rhm" open

export:
  all_from("types.rhm")
  summarize_module_clocking
  verify_single_clock
  same_clock_value
  summarize_module_temporal
  dump_temporal_report

class ClockedOperationSpec(clock_operand :: Nat,
                           reset_operand = #false)
class UnclockedSequentialOperationSpec()
class PendingResetUse(kind :: String,
                      reset,
                      mutable operations = [])
class ValueProvenanceSummary(value :: Value,
                             path :: List,
                             origins :: List)

def unclocked_sequential_operation = UnclockedSequentialOperationSpec()

// This dispatcher is deliberately exhaustive over every sequential or
// verification schema. Adding such an operation requires an explicit clock
// operand mapping or an explicit declaration that it owns no clocked effect.
fun clock_operation_spec(opcode):
  match opcode
  | "rtl.memory": unclocked_sequential_operation
  | "rtl.memory_write": ClockedOperationSpec(2)
  | "rtl.sync_memory": ClockedOperationSpec(0)
  | "verif.assert": ClockedOperationSpec(1, 2)
  | "sim.dpi_call": ClockedOperationSpec(0)
  | "sim.dpi_register": ClockedOperationSpec(0)
  | "rtl.register": ClockedOperationSpec(0)
  | "rtl.register_reset": ClockedOperationSpec(0, 1)
  | ~else: #false

fun check_clock_operation_coverage():
  for (schema in schemas):
    when schema.kind == "sequential" || schema.kind == "verification"
    | unless clock_operation_spec(schema.opcode)
      | error(~who: #'summarize_module_clocking,
              "clock classification is missing for " ++ schema.opcode)
  #void

// Only a structural rtl.wire is transparent for clock identity. In
// particular, an equal-width rtl.cast to Clock starts a distinct identity.
fun canonical_wire_value(value :: Value):
  fun loop(current, visited):
    if visited.find(fun (candidate): candidate === current)
    | current
    | block:
        def operation = current.module_def.find_operation(current.defining_op_id)
        if operation && operation.opcode == "rtl.wire" && operation.places[0].driver
        | loop(operation.places[0].driver, visited ++ [current])
        | current
  loop(value, [])

fun same_clock_value(left :: Value, right :: Value):
  canonical_wire_value(left) === canonical_wire_value(right)

fun add_clock_use(groups, use):
  def existing = groups.find(
    fun (group): group.clock === use.clock
  )
  if existing
  | for List (group in groups):
      if group === existing
      | ClockGroup(group.clock, group.uses ++ [use])
      | group
  | groups ++ [ClockGroup(use.clock, [use])]

fun reset_use_kind(reset, ambient_reset):
  cond
  | !reset: "none"
  | ambient_reset && reset === ambient_reset: "ambient"
  | ~else: "local"

fun same_pending_reset_use(pending, kind, reset):
  pending.kind == kind && (kind == "none" || pending.reset === reset)

fun summarize_reset_uses(clock_uses, ambient_reset):
  def canonical_ambient_reset:
    if ambient_reset is_a Value
    | canonical_wire_value(ambient_reset)
    | #false
  def mutable pending_uses = []
  for (use in clock_uses):
    def reset:
      if use.reset is_a Value
      | canonical_wire_value(use.reset)
      | #false
    def kind = reset_use_kind(reset, canonical_ambient_reset)
    def pending = pending_uses.find(
      fun (candidate): same_pending_reset_use(candidate, kind, reset)
    )
    if pending
    | pending.operations := pending.operations ++ [use.operation]
    | pending_uses := pending_uses ++ [PendingResetUse(kind, reset, [use.operation])]
  for List (pending in pending_uses):
    match pending.kind
    | "none": NoReset(pending.operations)
    | "ambient": AmbientReset(pending.reset, pending.operations)
    | "local": LocalReset(pending.reset, pending.operations)

fun summarize_module_clocking(module_def :: Module,
                              ambient_reset = #false):
  unless module_def.finished
  | error(~who: #'summarize_module_clocking,
          "module must be finished before clock use is summarized")
  check_clock_operation_coverage()
  def mutable clock_groups = []
  def mutable clock_uses = []
  for (operation in module_def.operations):
    def spec = clock_operation_spec(operation.opcode)
    when spec is_a ClockedOperationSpec
    | def clock = canonical_wire_value(operation.operands[spec.clock_operand])
      def reset:
        if spec.reset_operand is_a Nat
        | operation.operands[spec.reset_operand]
        | #false
      def use = ClockUse(operation, clock, reset)
      clock_uses := clock_uses ++ [use]
      clock_groups := add_clock_use(clock_groups, use)
  def reset_uses = summarize_reset_uses(clock_uses, ambient_reset)
  match clock_groups.length()
  | 0: Combinational(module_def, reset_uses)
  | 1: SingleClock(module_def,
                   clock_groups[0].clock,
                   reset_uses,
                   clock_uses.map(fun (use): use.operation))
  | ~else: MultiClock(module_def, clock_groups, reset_uses)

fun summary_clock_groups(summary):
  cond
  | summary is_a Combinational: []
  | summary is_a SingleClock:
      [ClockGroup(summary.clock,
                  summary.clocked_operations.map(
                    fun (operation):
                      def spec = clock_operation_spec(operation.opcode)
                      ClockUse(operation,
                               canonical_wire_value(operation.operands[spec.clock_operand]),
                               if spec.reset_operand is_a Nat
                               | operation.operands[spec.reset_operand]
                               | #false)
                  ))]
  | summary is_a MultiClock: summary.clock_groups

fun verify_single_clock(module_def :: Module,
                        expected_clock :: Value,
                        ambient_reset = #false):
  unless expected_clock.module_def === module_def && clock_type(expected_clock.type)
  | error(~who: #'verify_single_clock,
          "expected clock must be a Clock value owned by the module")
  def summary = summarize_module_clocking(module_def, ambient_reset)
  def canonical_expected_clock = canonical_wire_value(expected_clock)
  def mismatched_group = summary_clock_groups(summary).find(
    fun (group): !(group.clock === canonical_expected_clock)
  )
  when mismatched_group
  | def operation = mismatched_group.uses[0].operation
    error(~who: #'verify_single_clock,
          String.append(operation.location.describe(),
                        ": clocked operation ", operation.opcode,
                        " in module ", module_def.name,
                        " uses clock ", mismatched_group.clock.ref(),
                        " instead of expected clock ",
                        canonical_expected_clock.ref()))
  summary

fun same_instance_path(left, right):
  def mutable same = left.length() == right.length()
  when same
  | for (left_step in left,
         right_step in right):
      unless left_step === right_step
      | same := #false
  same

fun same_control_reference(left, right):
  left is_a ControlReference && right is_a ControlReference && left.value === right.value && same_instance_path(left.instance_path, right.instance_path)

fun same_optional_control_reference(left, right):
  (!left && !right) || same_control_reference(left, right)

fun same_crossing_reference(left, right):
  left.operation === right.operation && same_instance_path(left.instance_path, right.instance_path)

fun same_origin(left, right):
  cond
  | left is_a StaticProvenance && right is_a StaticProvenance:
      #true
  | left is_a ExternalProvenance && right is_a ExternalProvenance:
      left.input_index == right.input_index && left.path == right.path
  | left is_a StateProvenance && right is_a StateProvenance:
      left.operation === right.operation && left.path == right.path && same_instance_path(left.instance_path, right.instance_path) && same_optional_control_reference(left.clock, right.clock) && same_optional_control_reference(left.reset, right.reset)
  | left is_a CrossedProvenance && right is_a CrossedProvenance:
      left.crossing.operation === right.crossing.operation && left.path == right.path && same_instance_path(left.crossing.instance_path, right.crossing.instance_path) && same_optional_control_reference(left.destination_clock, right.destination_clock)
  | ~else:
      #false

fun normalize_origins(origins):
  def non_static = origins.filter(
    ~keep: fun (origin): !(origin is_a StaticProvenance)
  )
  cond
  | non_static.length() > 0: non_static
  | origins.length() > 0: [origins[0]]
  | ~else: [StaticProvenance()]

fun merge_origins(left, right):
  def mutable result = left
  for (origin in right):
    unless result.find(fun (candidate): same_origin(candidate, origin))
    | result := result ++ [origin]
  normalize_origins(result)

// A reconvergence is structural and policy-neutral: two distinct crossing
// identities reach one clocked sink, even when both are individually legal.
fun summarize_sink_reconvergence(sink):
  def mutable arrivals = []
  for (input in sink.inputs):
    for (origin in input.origins):
      when origin is_a CrossedProvenance
      | unless arrivals.find(
          fun (arrival):
            same_crossing_reference(arrival.provenance.crossing,
                                    origin.crossing)
        )
        | arrivals := arrivals ++ [
            CrossingArrival(input.name, input.path, origin)
          ]
  if arrivals.length() > 1
  | CrossingReconvergence(sink.instance_path,
                          sink.operation,
                          sink.kind,
                          arrivals)
  | #false

fun summarize_reconvergences(sinks):
  def mutable findings = []
  for (sink in sinks):
    def finding = summarize_sink_reconvergence(sink)
    when finding
    | findings := findings ++ [finding]
  findings

fun local_control_reference(value):
  ControlReference([], canonical_wire_value(value))

fun state_value_operation(operation):
  operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset" || operation.opcode == "rtl.sync_memory" || operation.opcode == "sim.dpi_register"

fun state_operation_reset(operation):
  if operation.opcode == "rtl.register_reset"
  | local_control_reference(operation.operands[1])
  | #false

fun sync_level_crossing_for_stage(operation, stage_index):
  operation.module_def.operations.find(
    fun (candidate): candidate.opcode == "cdc.sync_level" && candidate.operands.drop(2).length() > stage_index && candidate.operands.drop(2)[stage_index].defining_op_id == operation.id
  )

fun sync_level_crossing_for_final_stage(operation):
  operation.module_def.operations.find(
    fun (candidate): candidate.opcode == "cdc.sync_level" && candidate.operands[candidate.operands.length() - 1].defining_op_id == operation.id
  )

fun source_clock_references(states):
  def mutable result = []
  for (state in states):
    def clock:
      if state is_a StateProvenance
      | state.clock
      | if state is_a CrossedProvenance
        | state.destination_clock
        | #false
    when clock is_a ControlReference
    | unless result.find(
        fun (candidate): same_control_reference(candidate, clock)
      )
      | result := result ++ [clock]
  result

fun classify_sink_input(destination_clock, origins):
  def states = origins.filter(
    ~keep: fun (origin): origin is_a StateProvenance || origin is_a CrossedProvenance
  )
  def externals = origins.filter(
    ~keep: fun (origin): origin is_a ExternalProvenance
  )
  def source_clocks = source_clock_references(states)
  cond
  | source_clocks.length() > 1:
      MultiClockFanIn(source_clocks)
  | externals.length() > 0:
      UnknownInput(externals)
  | states.length() == 0:
      StaticInput()
  | states.find(
      fun (state): (state is_a StateProvenance && !(state.clock is_a ControlReference)) || (state is_a CrossedProvenance && !(state.destination_clock is_a ControlReference))
    ):
      UnknownClock(states)
  | same_control_reference(source_clocks[0], destination_clock):
      SameClock(source_clocks[0])
  | ~else:
      ForeignClock(source_clocks[0], destination_clock)

fun append_path(name, path):
  def mutable result = name
  for (step in path):
    result := if step is_a String | result ++ "." ++ step | result ++ "[" ++ to_string(step) ++ "]"
  result

fun instance_path_name(instance_path):
  String.join(
    instance_path.map(
      fun (operation): operation.attribute("name", "instance")
    ),
    "."
  )

fun operation_name(operation):
  operation.attribute("name", operation.opcode)

fun hierarchical_name(instance_path, name):
  def prefix = instance_path_name(instance_path)
  if prefix == "" | name | prefix ++ "." ++ name

fun describe_control(reference):
  hierarchical_name(reference.instance_path, reference.value.ref())

fun describe_classification(classification):
  cond
  | classification is_a StaticInput: "static"
  | classification is_a SameClock: "same_clock"
  | classification is_a ForeignClock: "foreign_clock"
  | classification is_a UnknownInput: "unknown_input"
  | classification is_a MultiClockFanIn: "multi_clock_fan_in"
  | classification is_a MixedTimingFanIn: "mixed_timing_fan_in"
  | classification is_a UnknownClock: "unknown_clock"

// Builds symbolic output provenance and a preorder inventory of every clocked
// sink reachable through the module's instance hierarchy. The summary itself
// is policy-neutral; closed-design callers may report it or enforce CDC rules.
fun summarize_module_temporal(module_def :: Module):
  unless module_def.finished
  | error(~who: #'summarize_module_temporal,
          "module must be finished before temporal provenance is summarized")
  check_clock_operation_coverage()
  def mutable module_summaries = []
  def mutable active_modules = []

  fun summarize_module(current_module):
    def cached = module_summaries.find(
      fun (summary): summary.module_def === current_module
    )
    if cached
    | cached
    | block:
        when active_modules.find(fun (candidate): candidate === current_module)
        | error(~who: #'summarize_module_temporal,
                "recursive module instantiation involving " ++ current_module.name)
        active_modules := active_modules ++ [current_module]
        def mutable value_summaries = []
        def mutable active_values = []

        fun bind_child_control(reference, instance_operation):
          if !(reference is_a ControlReference)
          | #false
          | if reference.instance_path.length() > 0
            | ControlReference([instance_operation] ++ reference.instance_path,
                               reference.value)
            | block:
                def child = instance_operation.attribute("module")
                def control_value = canonical_wire_value(reference.value)
                def input_index = identity_index(
                  child.inputs.map(fun (port): port.value),
                  control_value
                )
                if input_index is_a Nat
                | block:
                    def driver = place_leaf_driver(
                      instance_operation.places[input_index],
                      []
                    )
                    ControlReference([], canonical_wire_value(driver.value))
                | ControlReference([instance_operation], control_value)

        fun transform_child_origins(origins, instance_operation):
          def mutable result = []
          for (origin in origins):
            def transformed:
              cond
              | origin is_a StaticProvenance:
                  [origin]
              | origin is_a ExternalProvenance:
                  def input_place = instance_operation.places[origin.input_index]
                  def driver = place_leaf_driver(input_place, origin.path)
                  summarize_value(driver.value, driver.path)
              | origin is_a StateProvenance:
                  [StateProvenance([instance_operation] ++ origin.instance_path,
                                   origin.operation,
                                   origin.path,
                                   bind_child_control(origin.clock,
                                                      instance_operation),
                                   bind_child_control(origin.reset,
                                                      instance_operation))]
              | origin is_a CrossedProvenance:
                  [CrossedProvenance(
                     CrossingReference([instance_operation] ++ origin.crossing.instance_path,
                                       origin.crossing.operation),
                     origin.path,
                     transform_child_origins(origin.source_origins,
                                             instance_operation),
                     bind_child_control(origin.destination_clock,
                                        instance_operation)
                   )]
            result := merge_origins(result, transformed)
          normalize_origins(result)

        fun summarize_memory_read(operation, path):
          def memory = operation.attribute("memory")
          def writes = current_module.operations.filter(
            ~keep: fun (candidate): candidate.opcode == "rtl.memory_write" && candidate.attribute("memory", #false) === memory
          )
          def mutable origins = summarize_value(operation.operands[0], [])
          if writes.length() == 0
          | merge_origins(origins,
                          [StateProvenance([], operation, path, #false)])
          | block:
              for (write in writes):
                origins := merge_origins(
                  origins,
                  [StateProvenance([],
                                   operation,
                                   path,
                                   local_control_reference(write.operands[2]))]
                )
              origins

        fun summarize_value(value, path):
          def cached_value = value_summaries.find(
            fun (summary): summary.value === value && summary.path == path
          )
          if cached_value
          | cached_value.origins
          | block:
              when active_values.find(
                fun (summary): summary.value === value && summary.path == path
              )
              | error(~who: #'summarize_module_temporal,
                      "combinational cycle reaches value " ++ describe_value_path(value, path))
              active_values := active_values ++ [
                ValueProvenanceSummary(value, path, [])
              ]
              def operation = current_module.find_operation(value.defining_op_id)
              def input_index = identity_index(
                current_module.inputs.map(fun (port): port.value),
                value
              )
              def direct_dependencies = direct_value_dependencies(value, path)
              def origins:
                cond
                | input_index is_a Nat:
                    [ExternalProvenance(input_index, path)]
                | operation && operation.opcode == "rtl.memory_read_async":
                    summarize_memory_read(operation, path)
                | direct_dependencies is_a List:
                    if direct_dependencies.length() == 0
                    | [StaticProvenance()]
                    | block:
                        def mutable result = []
                        for (dependency in direct_dependencies):
                          result := merge_origins(
                            result,
                            summarize_value(dependency.value, dependency.path)
                          )
                        result
                | operation && operation.opcode == "rtl.instance":
                    def child_summary = summarize_module(
                      operation.attribute("module")
                    )
                    def output_index = identity_index(operation.results, value)
                    def output_leaf = child_summary.output_leaves.find(
                      fun (candidate): candidate.output_index == output_index && candidate.path == path
                    )
                    transform_child_origins(output_leaf.origins, operation)
                | operation && state_value_operation(operation):
                    def spec = clock_operation_spec(operation.opcode)
                    def crossing = sync_level_crossing_for_final_stage(operation)
                    if crossing
                    | [CrossedProvenance(
                         CrossingReference([], crossing),
                         path,
                         summarize_value(crossing.operands[0], []),
                         local_control_reference(crossing.operands[1])
                       )]
                    | [StateProvenance([],
                                       operation,
                                       path,
                                       local_control_reference(
                                         operation.operands[spec.clock_operand]
                                       ),
                                       state_operation_reset(operation))]
                | ~else:
                    error(~who: #'summarize_module_temporal,
                          "provenance classification is missing for value-producing operation " ++ operation.opcode)
              active_values := active_values.filter(
                ~keep: fun (summary): !(summary.value === value && summary.path == path)
              )
              def summary = ValueProvenanceSummary(value, path, origins)
              value_summaries := value_summaries ++ [summary]
              origins

        fun make_value_sink_inputs(name,
                                   value,
                                   destination_clock,
                                   crossing = #false):
          for List (path in leaf_paths(value.type)):
            def origins = summarize_value(value, path)
            TemporalSinkInput(name,
                              path,
                              origins,
                              classify_sink_input(destination_clock, origins),
                              crossing)

        fun make_place_sink_inputs(name,
                                   place,
                                   destination_clock,
                                   crossing = #false):
          for List (path in leaf_paths(place.type)):
            def driver = place_leaf_driver(place, path)
            def origins = summarize_value(driver.value, driver.path)
            TemporalSinkInput(name,
                              path,
                              origins,
                              classify_sink_input(destination_clock, origins),
                              crossing)

        fun local_sink_inputs(operation, destination_clock):
          match operation.opcode
          | "rtl.register":
              def crossing = sync_level_crossing_for_stage(operation, 0)
              make_place_sink_inputs("next",
                                     operation.places[0],
                                     destination_clock,
                                     if crossing
                                     | CrossingReference([], crossing)
                                     | #false)
          | "rtl.register_reset":
              def next_inputs = make_place_sink_inputs("next",
                                                       operation.places[0],
                                                       destination_clock)
              def reset_inputs = make_value_sink_inputs("reset",
                                                        operation.operands[1],
                                                        destination_clock)
              def reset_value_inputs = make_value_sink_inputs("reset_value",
                                                              operation.operands[2],
                                                              destination_clock)
              next_inputs ++ reset_inputs ++ reset_value_inputs
          | "rtl.memory_write":
              def address_inputs = make_value_sink_inputs("address",
                                                          operation.operands[0],
                                                          destination_clock)
              def data_inputs = make_value_sink_inputs("data",
                                                       operation.operands[1],
                                                       destination_clock)
              def enable_inputs = make_value_sink_inputs("enable",
                                                         operation.operands[3],
                                                         destination_clock)
              address_inputs ++ data_inputs ++ enable_inputs
          | "rtl.sync_memory":
              def mutable inputs = []
              for (place in operation.places):
                inputs := inputs ++ make_place_sink_inputs(place.name,
                                                           place,
                                                           destination_clock)
              inputs
          | "verif.assert":
              def condition_inputs = make_value_sink_inputs("condition",
                                                            operation.operands[0],
                                                            destination_clock)
              def reset_inputs = make_value_sink_inputs("reset",
                                                        operation.operands[2],
                                                        destination_clock)
              def guard_inputs = make_value_sink_inputs("guard",
                                                        operation.operands[3],
                                                        destination_clock)
              condition_inputs ++ reset_inputs ++ guard_inputs
          | "sim.dpi_call" || "sim.dpi_register":
              def mutable inputs = make_value_sink_inputs(
                "enable",
                operation.operands[1],
                destination_clock
              )
              for (operand in operation.operands.drop(2),
                   index in 0..operation.operands.drop(2).length()):
                inputs := inputs ++ make_value_sink_inputs(
                  "input" ++ to_string(index),
                  operand,
                  destination_clock
                )
              inputs
          | ~else:
              error(~who: #'summarize_module_temporal,
                    "sink classification is missing for " ++ operation.opcode)

        fun transform_child_sink(child_sink, instance_operation):
          def destination_clock = bind_child_control(child_sink.clock,
                                                     instance_operation)
          def inputs:
            for List (input in child_sink.inputs):
              def origins = transform_child_origins(input.origins,
                                                    instance_operation)
              TemporalSinkInput(input.name,
                                input.path,
                                origins,
                                classify_sink_input(destination_clock, origins),
                                if input.crossing is_a CrossingReference
                                | CrossingReference([instance_operation] ++ input.crossing.instance_path,
                                                    input.crossing.operation)
                                | #false)
          TemporalSink([instance_operation] ++ child_sink.instance_path,
                       child_sink.operation,
                       child_sink.kind,
                       destination_clock,
                       inputs)

        def mutable sinks = []
        for (operation in current_module.operations):
          def spec = clock_operation_spec(operation.opcode)
          cond
          | spec is_a ClockedOperationSpec:
              def destination_clock = local_control_reference(
                operation.operands[spec.clock_operand]
              )
              sinks := sinks ++ [
                TemporalSink([],
                             operation,
                             operation.opcode,
                             destination_clock,
                             local_sink_inputs(operation, destination_clock))
              ]
          | operation.opcode == "rtl.instance":
              def child_summary = summarize_module(
                operation.attribute("module")
              )
              for (child_sink in child_summary.sinks):
                sinks := sinks ++ [transform_child_sink(child_sink, operation)]
          | ~else:
              #void
        def mutable output_leaves = []
        for (port in current_module.outputs,
             output_index in 0..current_module.outputs.length()):
          for (path in leaf_paths(port.type)):
            def driver = place_leaf_driver(port.place, path)
            output_leaves := output_leaves ++ [
              OutputLeafProvenance(output_index,
                                   path,
                                   summarize_value(driver.value,
                                                   driver.path))
            ]
        def summary = ModuleTemporalSummary(current_module,
                                            output_leaves,
                                            sinks,
                                            summarize_reconvergences(sinks))
        module_summaries := module_summaries ++ [summary]
        active_modules := active_modules.filter(
          ~keep: fun (candidate): !(candidate === current_module)
        )
        summary

  summarize_module(module_def)

fun describe_origin(summary, origin):
  cond
  | origin is_a StaticProvenance:
      "static"
  | origin is_a ExternalProvenance:
      def input_name = summary.module_def.inputs[origin.input_index].name
      "input " ++ append_path(input_name, origin.path)
  | origin is_a StateProvenance:
      def name = hierarchical_name(origin.instance_path, operation_name(origin.operation))
      def clock = if origin.clock is_a ControlReference | "@" ++ describe_control(origin.clock) | "@unknown"
      "state " ++ append_path(name, origin.path) ++ clock
  | origin is_a CrossedProvenance:
      def name = hierarchical_name(origin.crossing.instance_path,
                                   origin.crossing.operation.opcode)
      def clock:
        if origin.destination_clock is_a ControlReference
        | "@" ++ describe_control(origin.destination_clock)
        | "@unknown"
      "crossed " ++ append_path(name, origin.path) ++ clock

fun append_reconvergences(lines, summary):
  def mutable result = lines
  for (finding in summary.reconvergences):
    def sink_name = hierarchical_name(finding.instance_path,
                                      operation_name(finding.operation))
    result := result ++ ["  reconvergence " ++ sink_name ++ " " ++ finding.kind]
    for (arrival in finding.arrivals):
      def crossing = arrival.provenance.crossing
      def crossing_name = hierarchical_name(crossing.instance_path,
                                            crossing.operation.opcode)
      def sources = String.join(
        arrival.provenance.source_origins.map(
          fun (origin): describe_origin(summary, origin)
        ),
        ", "
      )
      result := result ++ [
        String.append("    ",
                      append_path(arrival.input_name, arrival.input_path),
                      ": ", crossing_name, " <- ", sources)
      ]
  result

fun dump_temporal_report(summary :: ModuleTemporalSummary):
  def mutable lines = ["temporal.module @" ++ summary.module_def.name]
  for (output in summary.output_leaves):
    def port = summary.module_def.outputs[output.output_index]
    def origins = String.join(
      output.origins.map(fun (origin): describe_origin(summary, origin)),
      ", "
    )
    lines := lines ++ ["  output " ++ append_path(port.name, output.path) ++ " <- " ++ origins]
  for (sink in summary.sinks):
    def sink_name = hierarchical_name(sink.instance_path, operation_name(sink.operation))
    lines := lines ++ ["  sink " ++ sink_name ++ " " ++ sink.kind ++ " clock " ++ describe_control(sink.clock)]
    for (input in sink.inputs):
      def origins = String.join(
        input.origins.map(fun (origin): describe_origin(summary, origin)),
        ", "
      )
      def classification = describe_classification(input.classification)
      lines := lines ++ ["    " ++ append_path(input.name, input.path) ++ ": " ++ classification ++ " <- " ++ origins]
  lines := append_reconvergences(lines, summary)
  String.join(lines, "\n")
