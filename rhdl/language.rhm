#lang rhombus/and_meta
// Assembles #lang rhdl from Rhombus, the core API, and the standard frontend.

import:
  rhombus
  rhombus/meta open
  "core/main.rhm" open
  "frontend/standard.rhm" open
  "frontend/standard.rhm".bits as rhdl_bits

export:
  all_from(rhombus)
  all_from("core/main.rhm")
  all_from("frontend/standard.rhm"):
    except bits
  rename:
    rhdl_bits as bits
  if

expr.macro 'if $condition | $true_result | $false_result':
  'rhombus.if host_condition($condition) | $true_result | $false_result'
