#lang rhombus/and_meta
// Assembles #lang rhdl as the curated standard frontend profile over ordinary Rhombus.

import:
  rhombus
  rhombus/meta open
  "frontend/standard.rhm" open
  "frontend/standard.rhm".bits as rhdl_bits
  "frontend/kernel.rhm".host_condition

export:
  all_from(rhombus)
  all_from("frontend/standard.rhm"):
    except bits
  rename:
    rhdl_bits as bits
  if

expr.macro 'if $condition | $true_result | $false_result':
  'rhombus.if host_condition($condition) | $true_result | $false_result'
