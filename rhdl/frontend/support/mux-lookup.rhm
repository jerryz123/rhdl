#lang rhombus
// Defines shared typed-key protocols for frontend mux lookup extensions.

import:
  "hardware-literal.rhm".HardwareLiteral

export:
  MuxLookupKey
  MuxLookupSelectorType
  OneHotSelectorType

// A typed lookup key can also materialize as ordinary hardware data. Selector
// types decide whether a particular key belongs to their own key space.
interface MuxLookupKey:
  extends HardwareLiteral
  method mux_lookup_key_type()
  method mux_lookup_key_encoding()

interface MuxLookupSelectorType:
  method normalize_mux_lookup_key(key)

// Types implement this protocol when their packed representation directly
// selects one result lane per bit.
interface OneHotSelectorType:
  extends MuxLookupSelectorType
  method one_hot_selector_width()
