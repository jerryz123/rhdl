#lang rhombus/and_meta
// Provides shared static dispatch for methods owned by hardware value types.

import:
  rhombus/meta open
  "fields.rhm".HardwareFields

export:
  HardwareMethods

// Stores all methods for one exact hardware value surface under a single key,
// avoiding a new static-information key for every declared method.
statinfo.key hardware_method_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

dot.macro 'hardware_value_method_dot $left $dot $right':
  def packed_methods = statinfo_meta.find(
    statinfo_meta.gather(left),
    'hardware_method_static_info_key'
  )
  if packed_methods
  | block:
      let '($method_entry, ...)' = packed_methods
      def mutable expansion = #false
      for (entry in [method_entry, ...]):
        match entry
        | '($(method_name :: Identifier), $method_function, ($argument, ...), untyped)':
            when right.to_source_string() == method_name.to_source_string()
            | expansion := 'fun ($argument, ...) :~ HardwareFields:
                              $method_function($left, $argument, ...)'
        | '($(method_name :: Identifier), $method_function, ($argument, ...), (typed ($result_type)))':
            when right.to_source_string() == method_name.to_source_string()
            | expansion := 'fun ($argument, ...) :: $result_type:
                              $method_function($left, $argument, ...)'
        | ~else:
            syntax_meta.error("invalid hardware method static information", entry)
      expansion
  | #false

// Decorates a complete value annotation instead of competing with its dot
// provider, so declared methods precede and then fall through to base methods.
annot.macro 'HardwareMethods($(base :: annot_meta.Parsed), $method_entry, ...)':
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), hardware_value_method_dot),
      (hardware_method_static_info_key, ($method_entry, ...)))',
    base_infos
  )
  annot_meta.pack_predicate(
    predicate,
    result_infos
  )
