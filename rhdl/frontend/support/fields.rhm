#lang rhombus/and_meta
// Provides shared field, cast, lookup, and indexing syntax for hardware entities.

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../../core/types.rhm" open
  "../kernel.rhm" as kernel
  "hardware-literal.rhm".HardwareLiteral

export:
  HardwareFields
  HardwareVariantFields
  HardwareIntoFunction
  ValueSurfaceFields
  CircuitPortFields
  CircuitMemberFields
  hardware_port_static_info_key
  value_surface_static_info_key
  HardwareVariantType
  HardwareVariantView
  hardware_value_type
  hardware_as_bits
  hardware_index
  hardware_into
  hardware_lookup

// Associates a circuit definition with the exact static surface of each
// declared data port. Hierarchy transfers this map to the resulting instance.
statinfo.key hardware_port_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

// Carries the runtime-value surface advertised by any type descriptor. Data
// types and interface types share this key so circuit declarations can retain
// member precision without importing individual frontend layers.
statinfo.key value_surface_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

annot.macro 'ValueSurfaceFields($(type :: expr_meta.Parsed))':
  def value_infos = statinfo_meta.find(
    statinfo_meta.gather(type),
    'value_surface_static_info_key'
  )
  if value_infos
  | annot_meta.pack_predicate('fun (_value): #true', statinfo_meta.unpack(value_infos))
  | 'HardwareFields.from_type($type)'

annot.macro 'CircuitPortFields($(port_name :: Identifier): $(port_type :: expr_meta.Parsed), ...)':
  let [port_infos, ...]:
    for List (type in [port_type, ...]):
      annot_meta.parse_to_packed_statinfo('ValueSurfaceFields($type)')
  annot_meta.pack_predicate(
    'fun (_value): #true',
    '((hardware_port_static_info_key, (($port_name, $port_infos), ...)))'
  )

// Records already-selected member annotations, including scalar and array
// interface endpoints, on a circuit generator result.
annot.macro 'CircuitMemberFields($(member_name :: Identifier): $(member_annotation :: annot_meta.Parsed), ...)':
  let [member_infos, ...]:
    for List (annotation in [member_annotation, ...]):
      // Array annotations are converters, while scalar hardware and interface
      // annotations are predicates; only their result static information matters.
      annot_meta.parse_to_packed_statinfo(annotation)
  annot_meta.pack_predicate(
    'fun (_value): #true',
    '((hardware_port_static_info_key, (($member_name, $member_infos), ...)))'
  )

fun hardware_fields(value):
  kernel.hardware_entity(value)

// Retains the internal compatibility selector for a register's driveable
// next-state place; author-level RTL drives registers directly.
fun hardware_next(value :: Register):
  value.next

// Extracts the RHDL type from readable or driveable data objects without
// changing their identity. Deferred extension values materialize on demand.
fun hardware_entity_type(value):
  cond
  | value is_a Value: value.type
  | value is_a Place: value.type
  | value is_a Register: value.current.type
  | value is_a HardwareLiteral: value.literal_type()
  | value is_a kernel.DeferredHardwareValue: kernel.read(value).type
  | ~else: #false

// Exposes type discovery to frontend libraries that derive a result protocol
// from caller-elaborated hardware without depending on core IR classes.
fun hardware_value_type(value):
  def type = hardware_entity_type(value)
  unless type is_a HardwareType
  | error(~who: #'hardware_value_type, "expected hardware data")
  type

fun hardware_has_type(value, expected_type):
  def actual_type = hardware_entity_type(value)
  expected_type is_a HardwareType && actual_type is_a HardwareType && type_equal(actual_type, expected_type)

fun hardware_has_bits_type(value):
  def type = hardware_entity_type(value)
  type is_a HardwareType && bits_type(type)

fun hardware_has_packable_data_type(value):
  def type = hardware_entity_type(value)
  type is_a DataType && packable_type(type)

// Lets independently selectable frontend layers attach variant inspection to
// hardware values without teaching the shared field syntax their encoding.
interface HardwareVariantType:
  method hardware_variant_tag(entity, location)
  method hardware_variant_is(entity, variant, location)
  method hardware_variant_view(entity, variant, location)

class HardwareVariantView(valid, payload)

annot.macro 'HardwareFields':
  annot_meta.pack_predicate(
    'hardware_fields',
    '(($(statinfo_meta.dot_provider_key), hardware_field_dot), ($(statinfo_meta.index_get_key), hardware_index))'
  )

// Extends the broad HardwareFields annotation with an exact-type form. The
// foundation renames this root to the public Hardware annotation namespace.
namespace HardwareFields:
  // Carries an exact value surface on a hardware type descriptor so frontend
  // declarations can recover it without evaluating the descriptor at expansion time.
  export annot.macro 'describes($(descriptor :: annot_meta.Parsed),
                                $(value :: annot_meta.Parsed))':
    def (descriptor_predicate, descriptor_infos) = annot_meta.unpack_predicate(descriptor)
    def value_infos = statinfo_meta.unpack(
      annot_meta.parse_to_packed_statinfo(value)
    )
    def result_infos = statinfo_meta.and(
      descriptor_infos,
      '((hardware_value_static_info_key, $(statinfo_meta.pack(value_infos))),
        (value_surface_static_info_key, $(statinfo_meta.pack(value_infos))))'
    )
    annot_meta.pack_predicate(descriptor_predicate, result_infos)

  // Recovers the value surface advertised by a parsed hardware type expression,
  // conservatively retaining generic field and index behavior when none is known.
  export annot.macro 'from_type($(type :: expr_meta.Parsed))':
    def value_infos = statinfo_meta.find(
      statinfo_meta.gather(type),
      'hardware_value_static_info_key'
    )
    if value_infos
    | annot_meta.pack_predicate(
        'fun (value): hardware_has_type(value, $type)',
        statinfo_meta.unpack(value_infos)
      )
    | 'HardwareFields'

  export annot.macro 'of($expected_type)':
    annot_meta.pack_predicate(
      'fun (value): hardware_has_type(value, $expected_type)',
      '(($(statinfo_meta.dot_provider_key), hardware_field_dot), ($(statinfo_meta.index_get_key), hardware_index))'
    )

  // Describes a Bits entity whose width is intentionally existential.
  export annot.macro 'bits':
    annot_meta.pack_predicate(
      'hardware_has_bits_type',
      '(($(statinfo_meta.dot_provider_key), hardware_field_dot), ($(statinfo_meta.index_get_key), hardware_index))'
    )

  // Describes an arbitrary packable DataType entity without erasing that
  // requirement to the broader Hardware category.
  export annot.macro 'packable':
    annot_meta.pack_predicate(
      'hardware_has_packable_data_type',
      '(($(statinfo_meta.dot_provider_key), hardware_field_dot), ($(statinfo_meta.index_get_key), hardware_index))'
    )

fun require_hardware_variant_type(value, who):
  def type = hardware_entity_type(value)
  unless type is_a HardwareVariantType
  | error(~who: who, "expected hardware data with variants")
  type

fun hardware_variant_tag(value, location = Location()) :~ HardwareFields:
  require_hardware_variant_type(value, #'tag).hardware_variant_tag(value, location)

// Preserves variant tag inspection after an intermediate operation has erased
// exact static type information, while treating tag as an ordinary projection
// on non-variant records.
fun hardware_variant_tag_or_project(value,
                                    location = Location()) :~ HardwareFields:
  def type = hardware_entity_type(value)
  if type is_a HardwareVariantType
  | type.hardware_variant_tag(value, location)
  | kernel.project(value, "tag", #false, location)

fun hardware_variant_is(value, variant, location = Location()) :~ HardwareFields:
  require_hardware_variant_type(value, #'is).hardware_variant_is(value, variant, location)

fun hardware_variant_view_valid(view :: HardwareVariantView) :~ HardwareFields:
  view.valid

fun hardware_variant_view_payload(view :: HardwareVariantView) :~ HardwareFields:
  unless view.payload != #false
  | error(~who: #'view, "nullary hardware variants do not have payloads")
  view.payload

annot.macro 'HardwareVariantViewFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareVariantView',
    '(($(statinfo_meta.dot_provider_key), hardware_variant_view_dot))'
  )

fun hardware_variant_view(value,
                          variant,
                          location = Location()) :~ HardwareVariantViewFields:
  require_hardware_variant_type(value, #'view).hardware_variant_view(value,
                                                                     variant,
                                                                     location)

// Adds variant inspection only to types that explicitly advertise the
// HardwareVariantType protocol, leaving ordinary fields named tag, is, or view
// available to records and bundles.
annot.macro 'HardwareVariantFields($expected_type)':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields.of($expected_type)'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), hardware_variant_field_dot))',
    base_infos
  )
  annot_meta.pack_predicate(predicate, result_infos)

dot.macro 'hardware_variant_field_dot $left $dot $right':
  match right
  | 'tag': 'hardware_variant_tag($left) :: HardwareFields'
  | 'is': 'fun (variant) :~ HardwareFields: hardware_variant_is($left, variant)'
  | 'view': 'fun (variant) :~ HardwareVariantViewFields: hardware_variant_view($left, variant)'
  | ~else: #false

dot.macro 'hardware_variant_view_dot $left $dot $right':
  match right
  | 'valid': 'hardware_variant_view_valid($left) :: HardwareFields'
  | 'payload': 'hardware_variant_view_payload($left) :: HardwareFields'
  | ~else: #false

fun hardware_index(value, index) :: HardwareFields:
  def value_type = hardware_entity_type(value)
  def index_type = hardware_entity_type(index)
  cond
  | index is_a Nat:
      kernel.index(value, index)
  | index is_a Range:
      def start = index.start()
      def end = index.end()
      unless start is_a Nat && end is_a Nat
      | error(~who: #'extract,
              "hardware slice indices must form a bounded host natural-number range")
      def low = start + (if index.includes_start() | 0 | 1)
      def high = end - (if index.includes_end() | 0 | 1)
      unless low <= high
      | error(~who: #'extract,
              "hardware slice range must select at least one bit")
      kernel.extract(value, high, low)
  | index_type is_a HardwareType && vector_type(value_type):
      kernel.vector_index(value, index)
  | ~else:
      error(~who: #'extract,
            "hardware index must be a host natural number or bounded host natural-number range")

// Supplies the concise frontend spelling for an explicit, equal-width
// representation cast while leaving the operation itself in the kernel.
fun hardware_into(value, target_type) :~ HardwareFields:
  kernel.cast(value, target_type)

// Selects the result surface from the target type supplied to an `.into`
// function, so representation casts preserve enum and bundle methods.
meta.bridge hardware_into_result_static_infos:
  fun (_data, dependencies :: annot_meta.Dependencies):
    def target_infos = dependencies.arguments[0]
    def surface_infos = statinfo_meta.find(
      statinfo_meta.unpack(target_infos),
      'value_surface_static_info_key'
    )
    if surface_infos
    | surface_infos
    | annot_meta.parse_to_packed_statinfo('HardwareFields')

annot.macro 'HardwareIntoFunction':
  def dependent_result = statinfo_meta.pack_dependent_result(
    'hardware_into_result_static_infos',
    '(unused)',
    {}
  )
  def call_result = statinfo_meta.pack(
    '(($(statinfo_meta.dependent_result_key), $dependent_result))'
  )
  annot_meta.pack_predicate(
    'fun (_value): #true',
    '(($(statinfo_meta.call_result_key), $call_result))'
  )

// Produces the canonical packed Bits image of frontend data while preserving
// an existing Bits value without introducing a redundant cast operation.
fun hardware_as_bits(value,
                     who,
                     role,
                     name = #false,
                     location = Location()) :~ HardwareFields:
  def source = kernel.read(value, location)
  def width = source.type.packed_width()
  unless data_type(source.type) && width != #false
  | error(~who: who, role ++ " must have a packable DataType")
  if bits_type(source.type)
  | source
  | kernel.cast(source, Bits(width), name, location)

// Implements deterministic hardware-selected vector reads through the
// existing mux-lookup semantics and an explicit out-of-range default.
fun hardware_lookup(value, selector, ~default: default_value) :~ HardwareFields:
  kernel.vector_lookup(value, selector, default_value)

// Returns a vector value with one hardware-selected element replaced and all
// other elements, including every out-of-range case, preserved.
fun hardware_updated(value, selector, replacement) :~ HardwareFields:
  kernel.vector_updated(value, selector, replacement)

dot.macro 'hardware_field_dot $left $dot $right':
  ~tail: '$tail ...'
  match '$right $tail ...'
  | 'is($(variant :: expr_meta.Parsed)) $rest ...':
      values(
        'hardware_variant_is($left, $variant) :: HardwareFields',
        '$rest ...'
      )
  | 'view($(variant :: expr_meta.Parsed)) $rest ...':
      values(
        'hardware_variant_view($left, $variant) :: HardwareVariantViewFields',
        '$rest ...'
      )
  | ~else:
      def expansion:
        match right
        | 'id': #false
        | 'name': #false
        | 'type': #false
        | 'module_def': #false
        | 'module_id': #false
        | 'design': #false
        | 'defining_op_id': #false
        | 'users': #false
        | 'ref': #false
        | 'owner_op_id': #false
        | 'driver': #false
        | 'operation': #false
        | 'literal_type': #false
        | 'packed_value': #false
        | 'literal_name': #false
        | 'literal_width': #false
        | 'current': #false
        | 'next': 'hardware_next($left) :: HardwareFields'
        | 'tag': 'hardware_variant_tag_or_project($left) :: HardwareFields'
        | 'into': '(fun (target_type): hardware_into($left, target_type)) :: HardwareIntoFunction'
        | 'lookup': 'fun (selector, ~default: default_value) :~ HardwareFields: hardware_lookup($left, selector, ~default: default_value)'
        | 'updated': 'fun (selector, replacement) :~ HardwareFields: hardware_updated($left, selector, replacement)'
        | ~else:
            'kernel.project($left, $(right.to_source_string())) :: HardwareFields'
      if expansion
      | values(expansion, '$tail ...')
      | #false
