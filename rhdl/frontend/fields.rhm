#lang rhombus/and_meta
// Provides generic static dot information for record-valued hardware entities.

import:
  rhombus/meta open
  "kernel.rhm" as kernel

export:
  HardwareFields

fun hardware_fields(value):
  kernel.hardware_entity(value)

annot.macro 'HardwareFields':
  annot_meta.pack_predicate(
    'hardware_fields',
    '(($(statinfo_meta.dot_provider_key), hardware_field_dot))'
  )

dot.macro 'hardware_field_dot $left $dot $right':
  match right
  | 'id': #false
  | 'name': #false
  | 'type': #false
  | 'module_def': #false
  | 'module_id': #false
  | 'design': #false
  | 'defining_op_id': #false
  | 'users': #false
  | 'ref': #false
  | 'owner_op_id': #false
  | 'driver': #false
  | 'operation': #false
  | 'current': #false
  | 'next': #false
  | ~else:
      'kernel.project($left, $(right.to_source_string())) :: HardwareFields'
