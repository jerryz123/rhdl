#lang rhombus/and_meta
// Layers Chisel-like hardware operators over the embedded elaboration kernel.

import:
  rhombus
  rhombus/meta open
  "../core/ir.rhm" open
  "kernel.rhm" open
  "bool.rhm" open

export:
  all_from("kernel.rhm")
  all_from("bool.rhm")
  input
  output
  reg
  inst
  bits
  +
  -
  &
  ^
  and
  or
  xor
  not
  ===
  <==
  circuit
  elaborate
  mux_lookup

fun bits(value,
         ~width,
         name = #false):
  literal(Bits(width), value, name)

fun instance_port(instance, name):
  unless instance is_a Instance
  | error(~who: #'inst, "port access requires an instance")
  def input_binding = instance.input_bindings.find(
    fun (candidate): candidate.name == name
  )
  if input_binding
  | input_binding.place
  | block:
      def output_binding = instance.output_bindings.find(
        fun (candidate): candidate.name == name
      )
      unless output_binding
      | error(~who: #'inst,
              String.append("instance ",
                            instance.operation.attribute("name"),
                            " has no port named ",
                            name))
      output_binding.value

annot.macro 'InstancePorts':
  annot_meta.pack_predicate(
    'fun (value): value is_a Instance',
    '(($(statinfo_meta.dot_provider_key), instance_port_dot))'
  )

dot.macro 'instance_port_dot $left $dot $right':
  match right
  | 'input': #false
  | 'output': #false
  | ~else: 'instance_port($left, $(right.to_source_string()))'

defn.macro 'input $bindings: $type':
  match bindings
  | '$(name :: Identifier)':
      def port_name = name.to_source_string()
      'def $name = input($port_name, $type)'
  | '($(name :: Identifier), ...)':
      let [port_name, ...] = [name.to_source_string(), ...]
      '«
         def $name = input($port_name, $type)
         ...
       »'
  | ~else:
      syntax_meta.error("expected a port binding or parenthesized port bindings",
                        bindings)

defn.macro 'output $bindings: $type':
  match bindings
  | '$(name :: Identifier)':
      def port_name = name.to_source_string()
      'def $name = output($port_name, $type)'
  | '($(name :: Identifier), ...)':
      let [port_name, ...] = [name.to_source_string(), ...]
      '«
         def $name = output($port_name, $type)
         ...
       »'
  | ~else:
      syntax_meta.error("expected a port binding or parenthesized port bindings",
                        bindings)

defn.macro 'reg $(name :: Identifier)($argument, ...)':
  def register_name = name.to_source_string()
  match '($argument, ...)'
  | '($type, ~clock: $clock, ~reset: $reset, ~init: $init)':
      'def $name = reg($register_name, $type, $clock, $reset, $init)'
  | '($type, ~clock: $clock)':
      'def $name = reg($register_name, $type, $clock)'
  | ~else:
      syntax_meta.error(
        "expected (type, ~clock: clock) or (type, ~clock: clock, ~reset: reset, ~init: value)",
        '($argument, ...)'
      )

defn.macro 'inst $(name :: Identifier)($child)':
  def instance_name = name.to_source_string()
  'def $name :: InstancePorts = inst($instance_name, $child)'

defn.macro 'circuit $(name :: Identifier)($argument, ...): $body; ...':
  def circuit_name = name.to_source_string()
  'fun $name($argument, ...):
     fun implementation():
       $body
       ...
     build_circuit($circuit_name, [$argument, ...], implementation)'

expr.macro 'elaborate($body)':
  'run_elaboration(fun (): $body)'

fun build_mux_lookup(selector, default_value, cases):
  hw_mux_lookup(selector, default_value, cases)

expr.macro 'mux_lookup($selector, ~default: $default_value):
              $key: $case_value
              ...':
  'build_mux_lookup($selector,
                    $default_value,
                    [[$key, $case_value], ...])'

operator (left + right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_add(left, right)
  | left rhombus.(+) right

operator (left - right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_sub(left, right)
  | left rhombus.(-) right

operator (left & right):
  bit_and(left, right)

operator (left ^ right):
  bit_xor(left, right)

operator (left and right):
  ~order: bitwise_conjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_and(left, right)
  | left rhombus.bits.and right

operator (left or right):
  ~order: bitwise_disjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_or(left, right)
  | left rhombus.bits.or right

operator (left xor right):
  ~order: bitwise_disjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_xor(left, right)
  | left rhombus.bits.xor right

operator (not entity):
  ~order: bitwise_negation
  if hardware_entity(entity)
  | bit_not(entity)
  | rhombus.bits.not entity

operator (left === right):
  bool_eq(left, right)

operator (place <== entity):
  ~weaker_than: ~other
  connect(place, entity)
