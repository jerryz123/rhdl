#lang rhombus
// Aggregates the curated base, combinational, Boolean, aggregate, sequential, and hierarchy modules.

import:
  "base.rhm" open
  "extensions/comb.rhm" open
  "extensions/bool.rhm" open
  "extensions/bundle.rhm" open
  "extensions/interface.rhm" open
  "extensions/sequential.rhm" open
  "extensions/hierarchy.rhm" open

export:
  all_from("base.rhm")
  all_from("extensions/comb.rhm")
  all_from("extensions/bool.rhm")
  all_from("extensions/bundle.rhm")
  all_from("extensions/interface.rhm"):
    except InterfaceFields InstanceMembers instance_member
  all_from("extensions/sequential.rhm")
  all_from("extensions/hierarchy.rhm")
