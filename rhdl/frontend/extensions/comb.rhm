#lang rhombus/and_meta
// Defines combinational values, functions, and hardware operators over the elaboration kernel.

import:
  rhombus
  rhombus/meta open
  "../../core/types.rhm" open
  "../kernel.rhm" open

export:
  bits
  literal
  bit_not
  bit_and
  bit_or
  bit_xor
  hw_add
  hw_sub
  hw_eq
  mux_lookup
  concat
  extract
  zext
  trunc
  +
  -
  &
  ^
  and
  or
  xor
  not

fun bits(value,
         ~width,
         name = #false):
  literal(Bits(width), value, name)

fun build_mux_lookup(selector, default_value, cases):
  hw_mux_lookup(selector, default_value, cases)

expr.macro 'mux_lookup($selector, ~default: $default_value):
              $key: $case_value
              ...':
  'build_mux_lookup($selector,
                    $default_value,
                    [[$key, $case_value], ...])'

operator (left + right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_add(left, right)
  | left rhombus.(+) right

operator (left - right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_sub(left, right)
  | left rhombus.(-) right

operator (left & right):
  bit_and(left, right)

operator (left ^ right):
  bit_xor(left, right)

operator (left and right):
  ~order: bitwise_conjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_and(left, right)
  | left rhombus.bits.and right

operator (left or right):
  ~order: bitwise_disjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_or(left, right)
  | left rhombus.bits.or right

operator (left xor right):
  ~order: bitwise_disjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_xor(left, right)
  | left rhombus.bits.xor right

operator (not entity):
  ~order: bitwise_negation
  if hardware_entity(entity)
  | bit_not(entity)
  | rhombus.bits.not entity
