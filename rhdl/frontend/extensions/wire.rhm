#lang rhombus/and_meta
// Defines binding-derived single-driver wire syntax over the elaboration kernel.

import:
  rhombus/meta open
  "../kernel.rhm".wire as kernel_wire
  "../fields.rhm".HardwareFields

export:
  wire

defn.macro 'wire $(name :: Identifier): $type':
  def wire_name = name.to_source_string()
  'def $name :: HardwareFields = kernel_wire($wire_name, $type)'
