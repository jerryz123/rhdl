#lang rhombus/and_meta
// Defines register syntax and one-bit clock and reset conversions over the elaboration kernel.

import:
  rhombus/meta open
  "../kernel.rhm".reg as kernel_reg
  "../kernel.rhm".as_clock
  "../kernel.rhm".as_reset
  "../fields.rhm".HardwareFields

export:
  reg
  as_clock
  as_reset

defn.macro 'reg $(name :: Identifier)($argument, ...)':
  def register_name = name.to_source_string()
  match '($argument, ...)'
  | '($type, ~clock: $clock, ~reset: $reset, ~init: $init)':
      'def $name :: HardwareFields = kernel_reg($register_name, $type, $clock, $reset, $init)'
  | '($type, ~clock: $clock)':
      'def $name :: HardwareFields = kernel_reg($register_name, $type, $clock)'
  | ~else:
      syntax_meta.error(
        "expected (type, ~clock: clock) or (type, ~clock: clock, ~reset: reset, ~init: value)",
        '($argument, ...)'
      )
