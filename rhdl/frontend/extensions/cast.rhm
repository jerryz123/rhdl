#lang rhombus
// Defines the generic typed casting surface over the elaboration kernel.

import:
  "../../core/ir.rhm" open
  "../kernel.rhm".cast as kernel_cast
  "../fields.rhm".HardwareFields

export:
  cast

fun cast(entity,
         target_type,
         name = #false,
         location = Location()) :: HardwareFields:
  kernel_cast(entity, target_type, name, location)
