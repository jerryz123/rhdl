#lang rhombus
// Defines concise fixed-length hardware vector types and value construction.

import:
  "../../core/types.rhm" open
  "../kernel.rhm" as kernel
  "../fields.rhm".HardwareFields

export:
  Vec
  vec

fun Vec(length, element_type):
  VectorType(length, element_type)

// Accepts direct elements or one host List, infers the uniform element type,
// and delegates construction to the typed elaboration kernel.
fun vec(entity, ...) :~ HardwareFields:
  def supplied = [entity, ...]
  def entities:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  unless entities.length() >= 1
  | error(~who: #'vec, "vec requires at least one element")
  def element_values = entities.map(kernel.read)
  kernel.vector_create(VectorType(element_values.length(), element_values[0].type),
                       element_values)
