#lang rhombus/and_meta
// Defines binding-derived instances and typed child-port dot access over the elaboration kernel.

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm".inst as kernel_inst
  "interface.rhm".InstanceMembers
  "interface.rhm".instance_member

export:
  inst
  instance
  InstancePorts

annot.macro 'InstancePorts':
  annot_meta.pack_predicate(
    'fun (value): value is_a Instance',
    '(($(statinfo_meta.dot_provider_key), instance_port_dot))'
  )

dot.macro 'instance_port_dot $left $dot $right':
  match right
  | 'input': #false
  | 'output': #false
  | ~else: 'instance_member($left, $(right.to_source_string())) :: InstanceMembers'

// Provides expression-level construction for instances stored in ordinary
// host collections; it adds no hardware collection abstraction.
fun instance(name, child) :~ InstancePorts:
  kernel_inst(name, child)

defn.macro 'inst $(name :: Identifier)($child)':
  def instance_name = name.to_source_string()
  'def $name :: InstancePorts = instance($instance_name, $child)'
