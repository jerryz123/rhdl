#lang rhombus
// Implements context-based elaboration and deferred frontend hardware values.

import:
  "../core/ir.rhm" open
  "../core/builder.rhm" open
  "../core/verify.rhm" open

export:
  HardwareEntity
  DeferredHardwareValue
  CircuitDefinition
  FrontendContext
  new_circuit_identity
  frontend_run
  run_elaboration
  build_circuit
  active_module
  input
  output
  wire
  literal
  bit_not
  bit_and
  bit_or
  bit_xor
  hw_add
  hw_mul
  hw_sub
  hw_shl
  hw_shru
  hw_eq
  hw_mux_lookup
  cast
  concat
  extract
  zext
  trunc
  record_create
  project
  vector_create
  vector_get
  vector_project
  vector_lookup
  index
  reg
  inst
  connect
  conditional_chain
  read
  hardware_entity
  host_condition

// Lets frontend-only wrappers carry authoring metadata while still selecting
// an ordinary core module for instances and top-level elaboration.
interface CircuitDefinition:
  method core_module()

fun circuit_module(definition):
  cond
  | definition is_a Module: definition
  | definition is_a CircuitDefinition: definition.core_module()
  | ~else: #false

fun frontend_fail(message, location = Location()):
  error(~who: #'rhdl, location.describe() ++ ": " ++ message)

interface HardwareEntity

// Lets frontend layers retain authoring metadata until a value is actually
// consumed by hardware construction.
interface DeferredHardwareValue:
  extends HardwareEntity
  method materialize_hardware(location)

fun hardware_entity(value):
  cond
  | value is_a Value: #true
  | value is_a Place: #true
  | value is_a Register: #true
  | value is_a Operation: #true
  | value is_a Port: #true
  | value is_a Instance: #true
  | ~else: value is_a HardwareEntity

class CircuitIdentity(name)
class ActiveCircuit(identity, name)

fun new_circuit_identity(name):
  unless name is_a String
  | frontend_fail("circuit name must be a String")
  CircuitIdentity(name)

class FrontendContext(design,
                      builder,
                      mutable active = #true,
                      mutable active_circuits = [],
                      mutable allocated_symbols = []):
  method allocate_symbol(circuit_name):
    def base = circuit_name
    def count = allocated_symbols.filter(~keep: fun (symbol): symbol == base).length()
    allocated_symbols := allocated_symbols ++ [base]
    if count == 0
    | base
    | base ++ "_" ++ to_string(count)

Parameter.def current_context = #false
Parameter.def current_module = #false
Parameter.def current_conditional_branch = #false

class ConditionalAssignment(place, value)

// Collects the assignments made along one mutually exclusive hardware branch.
// Resolution later emits one muxed driver for every destination.
class ConditionalBranch(mutable assignments = []):
  method assignment_for(place):
    assignments.find(fun (assignment): assignment.place === place)

  method add(place, value, location):
    when this.assignment_for(place)
    | frontend_fail("conditional branch assigns " ++ place.name ++ " more than once",
                    location)
    assignments := assignments ++ [ConditionalAssignment(place, value)]

fun require_context(location = Location()):
  def context = current_context()
  unless context is_a FrontendContext && context.active
  | frontend_fail("circuit generators may only be called during elaborate", location)
  context

fun require_module(location = Location()):
  def module_def = current_module()
  unless module_def is_a Module
  | frontend_fail("hardware construction requires an active circuit", location)
  module_def

fun active_module(location = Location()):
  require_context(location)
  require_module(location)

fun read(entity, location = Location()):
  def context = require_context(location)
  cond
  | entity is_a DeferredHardwareValue:
      entity.materialize_hardware(location)
  | entity is_a Value: entity
  | entity is_a Register: entity.current
  | entity is_a Place:
      context.builder.read(entity)
  | ~else:
      frontend_fail("expected readable hardware data", location)

fun build_circuit(identity, name, arguments, implementation, location = Location()):
  def context = require_context(location)
  unless identity is_a CircuitIdentity
  | frontend_fail("circuit generator must supply its declaration identity", location)
  unless name is_a String
  | frontend_fail("circuit name must be a String", location)
  unless arguments is_a List
  | frontend_fail("circuit arguments must be supplied as a List", location)
  for (argument in arguments):
    when hardware_entity(argument)
    | frontend_fail("circuit parameters must be host values, not hardware values", location)
  when context.active_circuits.find(fun (active): active.identity === identity)
  | frontend_fail("recursive elaboration of circuit " ++ name, location)
  context.active_circuits := context.active_circuits ++ [ActiveCircuit(identity, name)]
  def module_def = context.builder.module(context.allocate_symbol(name))
  parameterize { current_module: module_def }:
    implementation()
  context.builder.finish(module_def)
  context.active_circuits := context.active_circuits.filter(
    ~keep: fun (active): !(active.identity === identity)
  )
  module_def

fun input(name, type, location = Location()):
  def context = require_context(location)
  context.builder.input(require_module(location),
                        name,
                        type,
                        location,
                        Origin("embedded input", name))

fun output(name, type, location = Location()):
  def context = require_context(location)
  context.builder.output(require_module(location),
                         name,
                         type,
                         location,
                         Origin("embedded output", name))

fun wire(name, type, location = Location()):
  def context = require_context(location)
  context.builder.wire(require_module(location),
                       name,
                       type,
                       location,
                       Origin("embedded wire", name))

fun literal(type, integer, name = #false, location = Location()):
  def context = require_context(location)
  context.builder.constant(require_module(location),
                           type,
                           integer,
                           name,
                           location,
                           Origin("embedded literal", name || ""))

fun unary(opcode, entity, name = #false, location = Location()):
  def context = require_context(location)
  def module_def = require_module(location)
  def value = read(entity, location)
  match opcode
  | "not":
      context.builder.bit_not(module_def,
                              value,
                              name,
                              location,
                              Origin("embedded not", name || ""))
  | ~else: frontend_fail("unknown unary operation " ++ opcode, location)

fun binary(opcode, left_entity, right_entity, name = #false, location = Location()):
  def context = require_context(location)
  def module_def = require_module(location)
  def left = read(left_entity, location)
  def right = read(right_entity, location)
  match opcode
  | "and":
      context.builder.bit_and(module_def, left, right, name, location,
                              Origin("embedded and", name || ""))
  | "or":
      context.builder.bit_or(module_def, left, right, name, location,
                             Origin("embedded or", name || ""))
  | "xor":
      context.builder.bit_xor(module_def, left, right, name, location,
                              Origin("embedded xor", name || ""))
  | "add":
      context.builder.add(module_def, left, right, name, location,
                          Origin("embedded add", name || ""))
  | "mul":
      context.builder.mul(module_def, left, right, name, location,
                          Origin("embedded mul", name || ""))
  | "sub":
      context.builder.sub(module_def, left, right, name, location,
                          Origin("embedded sub", name || ""))
  | "shl":
      context.builder.shl(module_def, left, right, name, location,
                          Origin("embedded shl", name || ""))
  | "shru":
      context.builder.shru(module_def, left, right, name, location,
                           Origin("embedded shru", name || ""))
  | "eq":
      context.builder.eq(module_def, left, right, name, location,
                         Origin("embedded eq", name || ""))
  | ~else: frontend_fail("unknown binary operation " ++ opcode, location)

fun bit_not(entity, name = #false, location = Location()):
  unary("not", entity, name, location)

fun bit_and(left, right, name = #false, location = Location()):
  binary("and", left, right, name, location)

fun bit_or(left, right, name = #false, location = Location()):
  binary("or", left, right, name, location)

fun bit_xor(left, right, name = #false, location = Location()):
  binary("xor", left, right, name, location)

fun hw_add(left, right, name = #false, location = Location()):
  binary("add", left, right, name, location)

fun hw_mul(left, right, name = #false, location = Location()):
  binary("mul", left, right, name, location)

fun hw_sub(left, right, name = #false, location = Location()):
  binary("sub", left, right, name, location)

fun hw_shl(value, amount, name = #false, location = Location()):
  binary("shl", value, amount, name, location)

fun hw_shru(value, amount, name = #false, location = Location()):
  binary("shru", value, amount, name, location)

fun hw_eq(left, right, name = #false, location = Location()):
  binary("eq", left, right, name, location)

fun hw_mux_lookup(selector,
                  default_value,
                  cases,
                  name = #false,
                  location = Location(),
                  origin = #false):
  def context = require_context(location)
  context.builder.mux_lookup(
    require_module(location),
    read(selector, location),
    read(default_value, location),
    cases.map(fun (case): [case[0], read(case[1], location)]),
    name,
    location,
    origin || Origin("embedded mux lookup", name || "")
  )

fun cast(entity, target_type, name = #false, location = Location()):
  def context = require_context(location)
  def module_def = require_module(location)
  def value = read(entity, location)
  if type_equal(value.type, target_type)
  | value
  | context.builder.cast(module_def, value, target_type, name, location,
                         Origin("embedded cast", name || ""))

fun concat(entities, name = #false, location = Location()):
  def context = require_context(location)
  context.builder.concat(require_module(location),
                         entities.map(fun (entity): read(entity, location)),
                         name,
                         location,
                         Origin("embedded concat", name || ""))

fun extract(entity, high, low, name = #false, location = Location()):
  def context = require_context(location)
  context.builder.extract(require_module(location),
                          read(entity, location),
                          high,
                          low,
                          name,
                          location,
                          Origin("embedded extract", name || ""))

fun zext(entity, target_width, name = #false, location = Location()):
  def context = require_context(location)
  context.builder.zext(require_module(location),
                       read(entity, location),
                       target_width,
                       name,
                       location,
                       Origin("embedded zext", name || ""))

fun trunc(entity, target_width, name = #false, location = Location()):
  def context = require_context(location)
  context.builder.trunc(require_module(location),
                        read(entity, location),
                        target_width,
                        name,
                        location,
                        Origin("embedded trunc", name || ""))

fun record_create(type, fields, name = #false, location = Location()):
  def context = require_context(location)
  unless fields is_a List
  | frontend_fail("record fields must be supplied as a List", location)
  context.builder.record_create(
    require_module(location),
    type,
    fields.map(fun (field): [field[0], read(field[1], location)]),
    name,
    location,
    Origin("embedded record create", name || "")
  )

fun project(entity, field_name, name = #false, location = Location()):
  def context = require_context(location)
  if entity is_a Place
  | context.builder.project(entity, field_name)
  | context.builder.record_get(require_module(location),
                               read(entity, location),
                               field_name,
                               name,
                               location,
                               Origin("embedded record get", field_name))

fun vector_create(type, elements, name = #false, location = Location()):
  def context = require_context(location)
  unless elements is_a List
  | frontend_fail("vector elements must be supplied as a List", location)
  context.builder.vector_create(
    require_module(location),
    type,
    elements.map(fun (element): read(element, location)),
    name,
    location,
    Origin("embedded vector create", name || "")
  )

fun vector_get(entity, element_index, name = #false, location = Location()):
  def context = require_context(location)
  context.builder.vector_get(require_module(location),
                             read(entity, location),
                             element_index,
                             name,
                             location,
                             Origin("embedded vector get", to_string(element_index)))

fun vector_project(entity, element_index, location = Location()):
  def context = require_context(location)
  if entity is_a Place
  | context.builder.project_vector(entity, element_index)
  | vector_get(entity, element_index, #false, location)

fun index(entity, element_index, location = Location()):
  def type:
    cond
    | entity is_a Value: entity.type
    | entity is_a Place: entity.type
    | entity is_a Register: entity.current.type
    | ~else: read(entity, location).type
  cond
  | bits_type(type): extract(entity, element_index, element_index, #false, location)
  | vector_type(type): vector_project(entity, element_index, location)
  // Preserve the established Bits diagnostic for unsupported data types.
  | ~else: extract(entity, element_index, element_index, #false, location)

fun vector_lookup(entity,
                  selector,
                  default_value,
                  name = #false,
                  location = Location()):
  def vector_value = read(entity, location)
  unless vector_type(vector_value.type)
  | frontend_fail("vector lookup requires a VectorType value", location)
  def cases:
    for List (element_index in 0..vector_value.type.length):
      [element_index, vector_get(vector_value, element_index, #false, location)]
  hw_mux_lookup(selector,
                default_value,
                cases,
                name,
                location,
                Origin("embedded vector lookup", name || ""))

fun reg(name, type, clock, reset = #false, reset_value = #false,
        location = Location()):
  def context = require_context(location)
  context.builder.register(require_module(location),
                           name,
                           type,
                           read(clock, location),
                           if reset | read(reset, location) | #false,
                           if reset_value | read(reset_value, location) | #false,
                           location,
                           Origin("embedded register", name))

fun inst(name, child, location = Location()):
  def context = require_context(location)
  context.builder.suggested_instance(require_module(location),
                                     circuit_module(child) || child,
                                     name,
                                     location,
                                     Origin("embedded instance", name))

fun connect(place, entity, location = Location()):
  def context = require_context(location)
  unless place is_a Place
  | frontend_fail("connection target must be a driveable hardware place",
                  location)
  def value = read(entity, location)
  unless type_equal(place.type, value.type)
  | frontend_fail("connection source and target must have exactly the same hardware type",
                  location)
  def conditional_branch = current_conditional_branch()
  if conditional_branch is_a ConditionalBranch
  | conditional_branch.add(place, value, location)
  | context.builder.drive(place,
                          value,
                          location,
                          Origin("embedded connect", place.name))

fun register_hold_value(place, location = Location()):
  if place.parent
  | block:
      def parent_hold = register_hold_value(place.parent, location)
      if parent_hold
      | project(parent_hold, place.projection_key, location)
      | #false
  | block:
      def operation = place.module_def.find_operation(place.owner_op_id)
      if operation && (operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset")
      | operation.results[0]
      | #false

fun emit_conditional_assignment(place, value, location = Location()):
  def branch = current_conditional_branch()
  if branch is_a ConditionalBranch
  | branch.add(place, value, location)
  | require_context(location).builder.drive(
      place,
      value,
      location,
      Origin("embedded conditional connect", place.name)
    )

fun validate_conditional_value(condition, location = Location()):
  unless hardware_entity(condition)
  | frontend_fail("when condition must be a hardware value", location)
  def value = read(condition, location)
  unless flat_data_type(value.type) && data_width(value.type) == 1
  | frontend_fail("hardware condition must have a one-bit FlatDataType", location)
  value

fun collect_conditional_branch(body, location = Location()):
  def branch = ConditionalBranch()
  parameterize { current_conditional_branch: branch }:
    body()
  branch

// Elaborates an ordered hardware-conditional chain into mux trees and final
// single drivers, with implicit hold available only for register-next places.
fun conditional_chain(branches, otherwise_body = #false, location = Location()):
  unless branches is_a List && branches.length() >= 1
  | frontend_fail("conditional chain requires at least one branch", location)
  def conditions:
    for List (branch in branches):
      validate_conditional_value(branch[0](), location)
  def branch_results:
    for List (branch in branches):
      collect_conditional_branch(branch[1], location)
  def otherwise_result:
    if otherwise_body
    | collect_conditional_branch(otherwise_body, location)
    | #false
  def mutable places = []
  for (branch_result in branch_results):
    for (assignment in branch_result.assignments):
      unless places.find(fun (place): place === assignment.place)
      | places := places ++ [assignment.place]
  when otherwise_result
  | for (assignment in otherwise_result.assignments):
      unless places.find(fun (place): place === assignment.place)
      | places := places ++ [assignment.place]
  for (place in places):
    def hold = register_hold_value(place, location)
    def mutable selected:
      if otherwise_result
      | block:
          def assignment = otherwise_result.assignment_for(place)
          unless assignment
          | frontend_fail(String.append("conditional assignment to ",
                                        place.name,
                                        " is missing from otherwise"),
                          location)
          assignment.value
      | if hold
        | hold
        | frontend_fail(String.append("conditional assignment to ",
                                      place.name,
                                      " requires otherwise"),
                        location)
    for (index in (branches.length() - 1) >=..= 0):
      def assignment = branch_results[index].assignment_for(place)
      def branch_value:
        if assignment
        | assignment.value
        | if hold
          | hold
          | frontend_fail("conditional branch does not assign " ++ place.name,
                          location)
      selected := hw_mux_lookup(
        cast(conditions[index], Bits(1), #false, location),
        selected,
        [[1, branch_value]],
        #false,
        location,
        Origin("embedded conditional mux", place.name)
      )
    emit_conditional_assignment(place, selected, location)
  #void

fun host_condition(value, location = Location()):
  when hardware_entity(value)
  | frontend_fail("hardware values cannot control host conditions", location)
  value

fun frontend_run(program):
  def design = Design()
  def context = FrontendContext(design, Builder(design))
  def top = parameterize { current_context: context }:
              program()
  context.active := #false
  def top_module = circuit_module(top)
  unless top_module is_a Module
  | error(~who: #'rhdl, "elaboration did not select a top circuit")
  verify_design(design)
  design

fun run_elaboration(program):
  frontend_run(program)
