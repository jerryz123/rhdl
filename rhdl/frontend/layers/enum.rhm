#lang rhombus/and_meta
// Defines introspectable nominal enum types and hardware member literals over flat core data.

import:
  rhombus.bits.(<<) as <<
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/finite-enum.rhm".FiniteEnumType
  "../support/hardware-methods.rhm".HardwareMethods
  "../support/mux-lookup.rhm" as mux_support

export:
  hardware_enum
  enum_type
  enum_width
  enum_members
  enum_encoding

class EnumIdentity()
class EnumMember(name, encoding)

class EnumType(name, identity, members, width):
  implements FlatDataType
  implements FiniteEnumType
  implements mux_support.MuxLookupSelectorType

  override method describe():
    "enum<" ++ name ++ ">"

  override method type_equal(other):
    enum_type(other) && identity === other.identity

  override method bit_width():
    width

  override method packed_width():
    width

  override method enum_encodings():
    members.map(fun (member): member.encoding)

  override method normalize_mux_lookup_key(key):
    unless key is_a mux_support.MuxLookupKey && this.type_equal(key.mux_lookup_key_type())
    | error(~who: #'mux_lookup,
            "enum mux lookup keys must be members of the selector's enum type")
    key.mux_lookup_key_encoding()

// One-hot enums remain nominal enums while advertising that each packed bit
// selects the correspondingly declared member.
class OneHotEnumType(name, identity, members, width):
  implements FlatDataType
  implements FiniteEnumType
  implements mux_support.OneHotSelectorType

  override method describe():
    "one-hot enum<" ++ name ++ ">"

  override method type_equal(other):
    enum_type(other) && identity === other.identity

  override method bit_width():
    width

  override method packed_width():
    width

  override method enum_encodings():
    members.map(fun (member): member.encoding)

  override method normalize_mux_lookup_key(key):
    unless key is_a mux_support.MuxLookupKey && this.type_equal(key.mux_lookup_key_type())
    | error(~who: #'mux_lookup,
            "enum mux lookup keys must be members of the selector's enum type")
    key.mux_lookup_key_encoding()

  override method one_hot_selector_width():
    width

fun enum_type(type):
  type is_a EnumType || type is_a OneHotEnumType

fun enum_width(type):
  unless enum_type(type)
  | error(~who: #'enum_width, "expected a hardware enum type")
  type.width

fun enum_members(type):
  unless enum_type(type)
  | error(~who: #'enum_members, "expected a hardware enum type")
  type.members.map(fun (member): member.name)

fun enum_encoding(type, member_name :: String):
  unless enum_type(type)
  | error(~who: #'enum_encoding, "expected a hardware enum type")
  def member = type.members.find(fun (candidate): candidate.name == member_name)
  unless member
  | error(~who: #'enum_encoding,
          "enum " ++ type.name ++ " has no member named " ++ member_name)
  member.encoding

fun required_enum_width(maximum_encoding):
  fun loop(width, capacity):
    if maximum_encoding < capacity
    | width
    | loop(width + 1, capacity * 2)
  loop(1, 2)

fun validate_enum_declaration(name :: String,
                              member_names :: NonemptyList.of(String),
                              encodings :: List.of(Nat),
                              requested_width,
                              ~one_hot: one_hot :: Boolean = #false):
  unless encodings.length() == member_names.length()
  | error(~who: #'hardware_enum, "enum members and encodings must have the same length")
  for (member_name in member_names):
    when member_names.filter(
      ~keep: fun (candidate): candidate == member_name
    ).length() != 1
    | error(~who: #'hardware_enum, "enum member names must be unique")
  for (encoding in encodings):
    when encodings.filter(
      ~keep: fun (candidate): candidate == encoding
    ).length() != 1
    | error(~who: #'hardware_enum, "enum encodings must be unique")
  def mutable maximum_encoding = 0
  for (encoding in encodings):
    when encoding > maximum_encoding
    | maximum_encoding := encoding
  def minimum_width = required_enum_width(maximum_encoding)
  def width:
    if requested_width == #false
    | minimum_width
    | block:
        unless requested_width is_a PosInt
        | error(~who: #'hardware_enum, "enum width must be a positive host integer")
        when requested_width < minimum_width
        | error(~who: #'hardware_enum, "enum encoding does not fit the declared width")
        requested_width
  def members = for List (member_name in member_names, encoding in encodings):
    EnumMember(member_name, encoding)
  if one_hot
  | OneHotEnumType(name, EnumIdentity(), members, width)
  | EnumType(name, EnumIdentity(), members, width)

fun make_automatic_enum(name, member_names, requested_width = #false):
  validate_enum_declaration(name,
                            member_names,
                            for List (encoding in 0..member_names.length()): encoding,
                            requested_width)

fun make_explicit_enum(name, members, requested_width = #false):
  validate_enum_declaration(name,
                            members.map(fun (member): member[0]),
                            members.map(fun (member): member[1]),
                            requested_width)

fun make_one_hot_enum(name, member_names):
  validate_enum_declaration(
    name,
    member_names,
    for List (index in 0..member_names.length()): 1 << index,
    member_names.length(),
    ~one_hot: #true
  )

fun enum_value(type, member_name) :~ HardwareFields:
  unless enum_type(type)
  | error(~who: #'hardware_enum, "member access requires an enum type")
  def encoding = enum_encoding(type, member_name)
  mux_support.mux_lookup_literal(type, encoding)

annot.macro 'EnumMembers':
  annot_meta.pack_predicate(
    'enum_type',
    '(($(statinfo_meta.dot_provider_key), enum_member_dot))'
  )

dot.macro 'enum_member_dot $left $dot $right':
  'enum_value($left, $(right.to_source_string())) :: HardwareFields'

meta:
  // Builds all enum encodings through one declaration path so methods have
  // identical behavior on automatic, explicit, fixed-width, and one-hot forms.
  fun expand_hardware_enum(name, options, clauses):
    def enum_name = name.to_source_string()
    def mutable requested_width = #false
    def mutable one_hot = #false
    for (option in options):
      match option
      | '~width: $width':
          when requested_width
          | syntax_meta.error("duplicate ~width option", option)
          requested_width := width
      | '~encoding: one_hot':
          when one_hot
          | syntax_meta.error("duplicate ~encoding option", option)
          one_hot := #true
      | ~else:
          syntax_meta.error("expected ~width or ~encoding: one_hot", option)

    def mutable members = []
    def mutable encodings = []
    def mutable explicit = #false
    def mutable automatic = #false
    def mutable method_names = []
    def mutable method_entries = []
    def mutable method_definitions = []
    for (clause in clauses):
      match clause
      | '$(member :: Identifier)':
          when explicit
          | syntax_meta.error("cannot mix automatic and explicit enum members", clause)
          automatic := #true
          members := members ++ [member]
      | '$(member :: Identifier) = $encoding':
          when automatic
          | syntax_meta.error("cannot mix automatic and explicit enum members", clause)
          explicit := #true
          members := members ++ [member]
          encodings := encodings ++ [encoding]
      | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: Identifier), ...) :: $(result_constructor :: Identifier)($result_argument, ...):
           $method_body; ...':
          when method_names.find(fun (declared): declared == method_name.to_source_string())
          | syntax_meta.error("enum method names must be unique", method_name)
          method_names := method_names ++ [method_name.to_source_string()]
          def method_function = Syntax.make_id(
            enum_name ++ "_" ++ method_name.to_source_string(),
            method_name
          )
          method_entries := method_entries ++ [
            '($method_name, $method_function, ($argument, ...),
              (typed ($result_constructor($result_argument, ...))))'
          ]
          method_definitions := method_definitions ++ [
            'fun $method_function($receiver :: $name, $argument, ...) :: $result_constructor($result_argument, ...):
               $method_body
               ...'
          ]
      | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: Identifier), ...) :: $(result_type :: Identifier):
           $method_body; ...':
          when method_names.find(fun (declared): declared == method_name.to_source_string())
          | syntax_meta.error("enum method names must be unique", method_name)
          method_names := method_names ++ [method_name.to_source_string()]
          def method_function = Syntax.make_id(
            enum_name ++ "_" ++ method_name.to_source_string(),
            method_name
          )
          method_entries := method_entries ++ [
            '($method_name, $method_function, ($argument, ...), (typed ($result_type)))'
          ]
          method_definitions := method_definitions ++ [
            'fun $method_function($receiver :: $name, $argument, ...) :: $result_type:
               $method_body
               ...'
          ]
      | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: Identifier), ...):
           $method_body; ...':
          when method_names.find(fun (declared): declared == method_name.to_source_string())
          | syntax_meta.error("enum method names must be unique", method_name)
          method_names := method_names ++ [method_name.to_source_string()]
          def method_function = Syntax.make_id(
            enum_name ++ "_" ++ method_name.to_source_string(),
            method_name
          )
          method_entries := method_entries ++ [
            '($method_name, $method_function, ($argument, ...), untyped)'
          ]
          method_definitions := method_definitions ++ [
            'fun $method_function($receiver :: $name, $argument, ...) :~ HardwareFields:
               $method_body
               ...'
          ]
      | ~else:
          syntax_meta.error("expected an enum member or method declaration", clause)

    when members.length() == 0
    | syntax_meta.error("hardware enum requires at least one member", name)
    when one_hot && explicit
    | syntax_meta.error("one-hot enums use declaration-order encodings", name)
    when one_hot && requested_width
    | syntax_meta.error("one-hot enum width is determined by its members", name)

    let [member_name, ...] = members.map(fun (member): member.to_source_string())
    let [encoding, ...] = encodings
    let [method_entry, ...] = method_entries
    let [method_definition, ...] = method_definitions
    def member_dot = Syntax.make_id(enum_name ++ "_member_dot", name)
    def member_annotation = Syntax.make_id(enum_name ++ "_members", name)
    def method_annotation = Syntax.make_id(enum_name ++ "_value_methods", name)
    def constructor:
      cond
      | one_hot:
          'make_one_hot_enum($enum_name, [$member_name, ...])'
      | explicit && requested_width:
          'make_explicit_enum($enum_name,
                              [[$member_name, $encoding], ...],
                              $requested_width)'
      | explicit:
          'make_explicit_enum($enum_name,
                              [[$member_name, $encoding], ...])'
      | requested_width:
          'make_automatic_enum($enum_name,
                               [$member_name, ...],
                               $requested_width)'
      | ~else:
          'make_automatic_enum($enum_name, [$member_name, ...])'
    if method_entries.length() > 0
    | '«
         annot.macro '$method_annotation':
           'HardwareMethods($method_entry, ...)'
         annot.macro '$name':
           'HardwareFields.of($name) && $method_annotation'
         dot.macro '$member_dot $('$')left $('$')dot $('$')right':
           if [$member_name, ...].contains(right.to_source_string())
           | 'enum_value($('$')left, $('$')(right.to_source_string())) :: $name'
           | if ["name", "identity", "members", "width", "bit_width",
                 "packed_width", "enum_encodings", "member", "describe"].contains(
                  right.to_source_string()
                )
             | #false
             | 'enum_value($('$')left, $('$')(right.to_source_string())) :: $name'
         annot.macro '$member_annotation':
           annot_meta.pack_predicate(
             'enum_type',
             '(($(statinfo_meta.dot_provider_key), $member_dot))'
           )
         def $name :: HardwareFields.describes($member_annotation, $name) = $constructor
         $method_definition
         ...
       »'
    | '«
         annot.macro '$name':
           'HardwareFields.of($name)'
         dot.macro '$member_dot $('$')left $('$')dot $('$')right':
           if [$member_name, ...].contains(right.to_source_string())
           | 'enum_value($('$')left, $('$')(right.to_source_string())) :: $name'
           | if ["name", "identity", "members", "width", "bit_width",
                 "packed_width", "enum_encodings", "member", "describe"].contains(
                  right.to_source_string()
                )
             | #false
             | 'enum_value($('$')left, $('$')(right.to_source_string())) :: $name'
         annot.macro '$member_annotation':
           annot_meta.pack_predicate(
             'enum_type',
             '(($(statinfo_meta.dot_provider_key), $member_dot))'
           )
         def $name :: HardwareFields.describes($member_annotation, $name) = $constructor
       »'

defn.macro
| 'hardware_enum $(name :: Identifier): $clause; ...':
    expand_hardware_enum(name, [], [clause, ...])
| 'hardware_enum $(name :: Identifier)($option, ...): $clause; ...':
    expand_hardware_enum(name, [option, ...], [clause, ...])
