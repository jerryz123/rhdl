#lang rhombus/and_meta
// Defines structurally sized one-hot values, literals, and exact-match muxing.

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/mux-lookup.rhm" as mux_support

export:
  OneHot
  one_hot_type
  one_hot_width
  mux_onehot

fun one_hot_encoding(index):
  1 bits.(<<) index

class _OneHotType(width):
  implements FlatDataType
  implements Callable
  implements mux_support.MuxLookupSelectorType

  constructor (width):
    unless width is_a Int && width > 0
    | error(~who: #'OneHot, "width must be a positive host Int")
    super(width)

  override method describe():
    "onehot<" ++ to_string(width) ++ ">"

  override method type_equal(other):
    one_hot_type(other) && width == other.width

  override method bit_width():
    width

  override method call(index):
    unless index is_a Int && 0 <= index && index < width
    | error(~who: #'OneHot,
            "literal index must satisfy 0 <= index < width")
    OneHotValue(this, index)

  override method normalize_mux_lookup_key(key):
    unless key is_a mux_support.MuxLookupKey && this.type_equal(key.mux_lookup_key_type())
    | error(~who: #'mux_lookup,
            "one-hot mux lookup keys must belong to the selector's OneHot type")
    key.mux_lookup_key_encoding()

class OneHotValue(type, index):
  implements mux_support.MuxLookupKey

  override method literal_type(): type

  override method packed_value(): one_hot_encoding(index)

  override method mux_lookup_key_type():
    type

  override method mux_lookup_key_encoding():
    one_hot_encoding(index)

fun OneHot(width):
  _OneHotType(width)

annot.macro 'OneHot($width)':
  'HardwareFields.of(OneHot($width))'

fun one_hot_type(type):
  type is_a _OneHotType

fun one_hot_width(type):
  unless one_hot_type(type)
  | error(~who: #'one_hot_width, "expected a OneHot type")
  type.width

// Expands an indexed choice list into the existing exact-match lookup. The
// explicit default defines behavior for zero and multi-hot representations.
fun build_one_hot_mux(selector, default_value, choices) :~ HardwareFields:
  def selector_value = kernel.read(selector)
  unless one_hot_type(selector_value.type)
  | error(~who: #'mux_onehot, "selector must have a OneHot type")
  unless choices is_a List
  | error(~who: #'mux_onehot, "choices must be supplied as a host List")
  unless choices.length() == selector_value.type.width
  | error(~who: #'mux_onehot,
          "choice count must equal the OneHot selector width")
  def selector_bits = kernel.cast(selector_value,
                                  Bits(selector_value.type.width))
  def cases:
    for List (index in 0..selector_value.type.width,
              choice in choices):
      [one_hot_encoding(index), choice]
  kernel.hw_mux_lookup(selector_bits,
                       default_value,
                       cases,
                       #false,
                       Location(),
                       Origin("embedded one-hot mux", ""))

expr.macro
| 'mux_onehot($selector, ~default: $default_value, $choices)':
    'build_one_hot_mux($selector, $default_value, $choices)'
| 'mux_onehot($selector, ~default: $default_value):
     $(choice :: expr_meta.Parsed)
     ...':
    'build_one_hot_mux($selector,
                       $default_value,
                       [$choice, ...])'
