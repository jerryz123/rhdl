#lang rhombus/and_meta
// Defines structurally sized one-hot values, index conversion, and partial selection.

import:
  rhombus.bits.(<<) as <<
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/mux-lookup.rhm" as mux_support

export:
  OneHot
  one_hot
  one_hot_type
  one_hot_width
  mux_onehot

fun one_hot_encoding(index):
  1 << index

class _OneHotType(width :: PosInt):
  implements FlatDataType
  implements Callable
  implements mux_support.OneHotSelectorType

  override method describe():
    "onehot<" ++ to_string(width) ++ ">"

  override method type_equal(other):
    one_hot_type(other) && width == other.width

  override method bit_width():
    width

  override method packed_width():
    width

  override method call(index :: Nat):
    unless index < width
    | error(~who: #'OneHot,
            "literal index must satisfy 0 <= index < width")
    OneHotValue(this, index)

  override method normalize_mux_lookup_key(key):
    unless key is_a mux_support.MuxLookupKey && this.type_equal(key.mux_lookup_key_type())
    | error(~who: #'mux_lookup,
            "one-hot mux lookup keys must belong to the selector's OneHot type")
    key.mux_lookup_key_encoding()

  override method one_hot_selector_width():
    width

class OneHotValue(type, index):
  implements mux_support.MuxLookupKey

  override method literal_type(): type

  override method packed_value(): one_hot_encoding(index)

  override method mux_lookup_key_type():
    type

  override method mux_lookup_key_encoding():
    one_hot_encoding(index)

fun OneHot(width :: PosInt):
  _OneHotType(width)

annot.macro 'OneHot($width)':
  'HardwareFields.of(OneHot($width))'

fun one_hot_type(type):
  type is_a _OneHotType

fun one_hot_width(type):
  unless one_hot_type(type)
  | error(~who: #'one_hot_width, "expected a OneHot type")
  type.width

// Converts every encoding of Bits(n) into one of the 2^n lanes, so the result
// preserves the exactly-one invariant without an out-of-range case.
fun one_hot(index, name = #false, location = Location()) :~ HardwareFields:
  def index_value = kernel.read(index, location)
  unless bits_type(index_value.type)
  | error(~who: #'one_hot,
          location.describe() ++ ": index must be Bits")
  def result_width = 1 << index_value.type.width
  def encoded_bits = kernel.hw_shl(
    kernel.literal(Bits(result_width), 1, #false, location),
    index_value,
    #false,
    location
  )
  kernel.cast(encoded_bits, OneHot(result_width), name, location)

// Preserves one-hot selection as a partial core operation. Exactly one bit set
// is a caller precondition; invalid selector encodings have no result contract.
fun build_one_hot_mux(selector, choices :: List) :~ HardwareFields:
  def selector_value = kernel.read(selector)
  unless selector_value.type is_a mux_support.OneHotSelectorType
  | error(~who: #'mux_onehot, "selector must have a one-hot selector type")
  def selector_width = selector_value.type.one_hot_selector_width()
  unless choices.length() == selector_width
  | error(~who: #'mux_onehot,
          "choice count must equal the one-hot selector width")
  def selector_bits = kernel.cast(selector_value,
                                  Bits(selector_width))
  kernel.hw_onehot_mux(selector_bits,
                       choices,
                       #false,
                       Location(),
                       Origin("embedded one-hot mux", ""))

// Keyed arms make the logical member-to-lane mapping explicit, then lower in
// physical selector-bit order to the same core operation as positional arms.
fun build_keyed_one_hot_mux(selector, cases :: List) :~ HardwareFields:
  def selector_value = kernel.read(selector)
  unless selector_value.type is_a mux_support.OneHotSelectorType
  | error(~who: #'mux_onehot, "selector must have a one-hot selector type")
  def selector_width = selector_value.type.one_hot_selector_width()
  unless cases.length() == selector_width
  | error(~who: #'mux_onehot,
          "keyed arms must cover every one-hot selector lane exactly once")
  def normalized_cases = cases.map(
    fun (case):
      unless case is_a List && case.length() == 2
      | error(~who: #'mux_onehot, "cases must be [key, value] pairs")
      [selector_value.type.normalize_mux_lookup_key(case[0]), case[1]]
  ).sort(fun (left, right): left[0] < right[0])
  for (index in 0..selector_width):
    unless normalized_cases[index][0] == one_hot_encoding(index)
    | error(~who: #'mux_onehot,
            "keyed arms must cover every one-hot selector lane exactly once")
  build_one_hot_mux(selector_value,
                    normalized_cases.map(fun (case): case[1]))

expr.macro
| 'mux_onehot($selector, $choices)':
    'build_one_hot_mux($selector, $choices)'
| 'mux_onehot($selector):
     $(key :: expr_meta.Parsed): $case_value
     ...':
    'build_keyed_one_hot_mux($selector,
                             [[$key, $case_value], ...])'
| 'mux_onehot($selector):
     $(choice :: expr_meta.Parsed)
     ...':
    'build_one_hot_mux($selector,
                       [$choice, ...])'
