#lang rhombus/and_meta
// Defines structurally sized one-hot values, index conversion, and typed selection.

import:
  rhombus.bits.(<<) as <<
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".HardwareIntoFunction
  "../support/fields.rhm".hardware_into
  "../support/fields.rhm".hardware_value_type
  "../support/mux-lookup.rhm" as mux_support
  "../support/one-hot-selection.rhm" as one_hot_selection

export:
  OneHot
  one_hot
  one_hot_type
  one_hot_width

fun one_hot_encoding(index):
  1 << index

class _OneHotType(width :: PosInt):
  implements FlatDataType
  implements Callable
  implements mux_support.OneHotSelectorType

  override method describe():
    "onehot<" ++ to_string(width) ++ ">"

  override method type_equal(other):
    one_hot_type(other) && width == other.width

  override method bit_width():
    width

  override method packed_width():
    width

  override method call(index :: Nat):
    unless index < width
    | error(~who: #'OneHot,
            "literal index must satisfy 0 <= index < width")
    mux_support.mux_lookup_literal(this, one_hot_encoding(index))

  override method normalize_mux_lookup_key(key):
    unless key is_a mux_support.MuxLookupKey && this.type_equal(key.mux_lookup_key_type())
    | error(~who: #'mux_lookup,
            "one-hot mux lookup keys must belong to the selector's OneHot type")
    key.mux_lookup_key_encoding()

  override method one_hot_selector_width():
    width

fun build_one_hot_type(width :: PosInt):
  _OneHotType(width)

fun one_hot_type(type):
  type is_a _OneHotType

fun one_hot_width(type):
  unless one_hot_type(type)
  | error(~who: #'one_hot_width, "expected a OneHot type")
  type.width

fun hardware_has_one_hot_type(value):
  kernel.hardware_entity(value) && one_hot_type(hardware_value_type(value))

meta:
  fun one_hot_mux_result(result, choices):
    match choices.group
    | '[$(first :: expr_meta.Parsed), $rest, ...]':
        statinfo_meta.wrap(result, statinfo_meta.gather(first))
    | ~else: result

dot.macro 'one_hot_value_dot $left $dot $right':
  ~tail: '$tail ...'
  match '$right $tail ...'
  | 'mux($(choices :: expr_meta.Parsed)) $rest ...':
      values(
        one_hot_mux_result(
          'one_hot_selection.build_one_hot_mux($left, $choices)',
          choices
        ),
        '$rest ...'
      )
  | 'mux($(choices :: expr_meta.Parsed),
         ~default: $(default_value :: expr_meta.Parsed)) $rest ...':
      values(
        one_hot_mux_result(
          'one_hot_selection.build_maybe_one_hot_mux($left, $choices, $default_value)',
          choices
        ),
        '$rest ...'
      )
  | 'mux $rest ...':
      syntax_meta.error("OneHot.mux expects exactly one list of choices", right)
  | ~else:
      values(
        match right
        | 'into': '(fun (target_type): hardware_into($left, target_type)) :: HardwareIntoFunction'
        | ~else: #false,
        '$tail ...'
      )

annot.macro 'OneHotValue':
  annot_meta.pack_predicate(
    'hardware_has_one_hot_type',
    '(($(statinfo_meta.dot_provider_key), one_hot_value_dot))'
  )

annot.macro 'OneHotTypeDescriptor':
  annot_meta.pack_predicate('one_hot_type')

annot.macro 'OneHot($width)':
  annot_meta.pack_predicate(
    'fun (value): kernel.hardware_entity(value) && type_equal(hardware_value_type(value), build_one_hot_type($width))',
    '(($(statinfo_meta.dot_provider_key), one_hot_value_dot))'
  )

expr.macro 'OneHot($(width :: expr_meta.Parsed))':
  'build_one_hot_type($width) :: HardwareFields.describes(
     OneHotTypeDescriptor,
     OneHotValue
   )'

// Converts every encoding of Bits(n) into one of the 2^n lanes, so the result
// preserves the exactly-one invariant without an out-of-range case.
fun build_one_hot(index, name = #false, location = Location()) :~ HardwareFields:
  def index_value = kernel.read(index, location)
  unless bits_type(index_value.type)
  | error(~who: #'one_hot,
          location.describe() ++ ": index must be Bits")
  def result_width = 1 << index_value.type.width
  def encoded_bits = kernel.hw_shl(
    kernel.literal(Bits(result_width), 1, #false, location),
    index_value,
    #false,
    location
  )
  kernel.cast(encoded_bits, build_one_hot_type(result_width), name, location)

expr.macro
| 'one_hot($(index :: expr_meta.Parsed))':
    'build_one_hot($index) :: OneHotValue'
| 'one_hot($(index :: expr_meta.Parsed), $(name :: expr_meta.Parsed))':
    'build_one_hot($index, $name) :: OneHotValue'
| 'one_hot($(index :: expr_meta.Parsed),
           $(name :: expr_meta.Parsed),
           $(location :: expr_meta.Parsed))':
    'build_one_hot($index, $name, $location) :: OneHotValue'
