#lang rhombus/and_meta
// Defines the binding-derived single-driver wire frontend layer.

import:
  rhombus/meta open
  "../kernel.rhm".wire as kernel_wire
  "../support/fields.rhm".HardwareFields

export:
  wire

defn.macro 'wire $(name :: Identifier): $(type :: expr_meta.Parsed)':
  def wire_name = name.to_source_string()
  'def $name :: HardwareFields.from_type($type) = kernel_wire($wire_name, $type)'
