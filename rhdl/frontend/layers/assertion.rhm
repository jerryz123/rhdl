#lang rhombus
// Defines reset-suppressed clocked hardware assertions with ambient or explicit domains.

import:
  "../kernel.rhm" as kernel
  "../support/clocking.rhm".ambient_assert
  "../support/clocking.rhm".reject_explicit_sync_control

export:
  assert

fun assert(condition,
           label = #false,
           ~clock: clock = #false,
           ~reset: reset = #false):
  when clock || reset
  | reject_explicit_sync_control()
  if clock || reset
  | block:
      unless clock && reset
      | error(~who: #'assert,
              "explicit assertions require both ~clock and ~reset")
      kernel.assert(condition, clock, reset, label)
  | ambient_assert(condition, label)
