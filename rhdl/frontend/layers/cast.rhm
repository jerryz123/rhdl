#lang rhombus/and_meta
// Defines generic explicit and shape-inferred representation casts over the kernel.

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm".cast as kernel_cast
  "../kernel.rhm".read as kernel_read
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".hardware_as_bits

export:
  cast
  as_bits
  as_vec

fun build_cast(entity,
               target_type,
               name = #false,
               location = Location()) :: HardwareFields:
  kernel_cast(entity, target_type, name, location)

expr.macro
| 'cast($entity, $(target_type :: expr_meta.Parsed))':
    'build_cast($entity, $target_type) :: HardwareFields.from_type($target_type)'
| 'cast($entity, $(target_type :: expr_meta.Parsed), $name)':
    'build_cast($entity, $target_type, $name) :: HardwareFields.from_type($target_type)'
| 'cast($entity, $(target_type :: expr_meta.Parsed), $name, $location)':
    'build_cast($entity, $target_type, $name, $location) :: HardwareFields.from_type($target_type)'

// Infers canonical Bits width from any packable frontend data value.
fun as_bits(entity,
            name = #false,
            location = Location()) :: HardwareFields:
  hardware_as_bits(entity, #'as_bits, "value", name, location)

// Infers a vector length by dividing the source's canonical packed width by
// one requested element. Element zero receives the least-significant chunk.
fun as_vec(entity,
           element_type,
           name = #false,
           location = Location()) :: HardwareFields:
  def source = kernel_read(entity, location)
  def source_width = source.type.packed_width()
  unless data_type(source.type) && source_width != #false
  | error(~who: #'as_vec, "value must have a packable DataType")
  def element_width:
    if element_type is_a DataType | element_type.packed_width() | #false
  unless element_width != #false
  | error(~who: #'as_vec, "element type must be a packable DataType")
  unless source_width mod element_width == 0
  | error(~who: #'as_vec,
          "value width must be evenly divisible by the element width")
  def target_type = VectorType(source_width div element_width, element_type)
  if type_equal(source.type, target_type)
  | source
  | kernel_cast(source, target_type, name, location)
