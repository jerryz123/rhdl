#lang rhombus
// Defines the composable generic typed casting layer over the elaboration kernel.

import:
  "../../core/ir.rhm" open
  "../kernel.rhm".cast as kernel_cast
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".hardware_as_bits

export:
  cast
  as_bits

fun cast(entity,
         target_type,
         name = #false,
         location = Location()) :: HardwareFields:
  kernel_cast(entity, target_type, name, location)

// Infers canonical Bits width from any packable frontend data value.
fun as_bits(entity,
            name = #false,
            location = Location()) :: HardwareFields:
  hardware_as_bits(entity, #'as_bits, "value", name, location)
