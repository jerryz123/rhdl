#lang rhombus/and_meta
// Defines Bool literals, Boolean-valued comparisons, and binary-selection syntax.

import:
  "../../core/ir.rhm" open
  "../../core/types.rhm".signed_arithmetic_type
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/hardware-literal.rhm".HardwareLiteral

export:
  Bool
  bool_type
  bool_eq
  bool_ne
  is_one_of
  unsigned_lt
  signed_lt
  unsigned_gt
  unsigned_le
  unsigned_ge
  mux
  ===
  =/=
  <
  >
  <=
  >=

class _BoolType():
  implements BitwiseType
  implements Callable
  override method describe(): "bool"
  override method type_equal(other): bool_type(other)
  override method bit_width(): 1
  override method call(value) :~ HardwareFields:
    unless value is_a Boolean
    | error(~who: #'Bool, "Bool literal requires a host Boolean")
    BoolLiteral(this, value)

// Keeps a host Boolean distinct from its eventual one-bit hardware value
// until an elaborated operation consumes it.
class BoolLiteral(type, value):
  implements HardwareLiteral
  override method literal_type(): type
  override method packed_value(): if value | 1 | 0

def Bool = _BoolType()

annot.macro 'Bool':
  'HardwareFields.of(Bool)'

fun bool_type(type):
  type is_a _BoolType

// Equality remains a Bits core operation. Frontend nominal flat types compare
// by explicitly exposing equal-width representations first.
fun equality_bits(left, right, who, spelling :: String, location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless flat_data_type(left_value.type) && flat_data_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": " ++ spelling ++ " operands must have exactly the same FlatDataType")
  def width = data_width(left_value.type)
  def left_bits = kernel.cast(left_value, Bits(width), #false, location)
  def right_bits = kernel.cast(right_value, Bits(width), #false, location)
  kernel.hw_eq(left_bits, right_bits, #false, location)

fun bool_eq(left, right, name = #false, location = Location()):
  kernel.cast(equality_bits(left, right, #'bool_eq, "===", location),
              Bool,
              name,
              location)

operator (left === right):
  bool_eq(left, right)

// Inequality is the Boolean complement of typed equality. Keeping one core
// equality operation preserves exactly the same nominal type contract.
fun bool_ne(left, right, name = #false, location = Location()):
  def equal = kernel.cast(
    equality_bits(left, right, #'bool_ne, "=/=", location),
    Bool,
    #false,
    location
  )
  kernel.bit_not(equal, name, location)

operator (left =/= right):
  ~same_as: ===
  bool_ne(left, right)

// Compares one hardware value against a host-authored set of typed choices.
// The fold happens during elaboration and therefore needs no dedicated IR op.
fun is_one_of(value, candidate, ...) :~ HardwareFields:
  def location = Location()
  def value_read = kernel.read(value, location)
  def candidates = [candidate, ...]
  def comparisons = candidates.map(
    fun (alternative):
      equality_bits(value_read,
                    alternative,
                    #'is_one_of,
                    "is_one_of",
                    location)
  )
  def mutable combined = comparisons[0]
  for (comparison in comparisons.drop(1)):
    combined := kernel.bit_or(combined, comparison, #false, location)
  kernel.cast(combined, Bool, #false, location)

fun require_unsigned_bits(left, right, who, location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless bits_type(left_value.type) && bits_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": unsigned comparison operands must have exactly the same Bits width")
  values(left_value, right_value)

fun comparison_bool(value, name, location):
  kernel.cast(value, Bool, name, location)

fun unsigned_lt_bits(left, right, who, location):
  def (left_value, right_value) = require_unsigned_bits(left, right, who, location)
  kernel.hw_ult(left_value, right_value, #false, location)

fun unsigned_lt(left, right, name = #false, location = Location()):
  comparison_bool(unsigned_lt_bits(left, right, #'unsigned_lt, location),
                  name, location)

fun require_signed_arithmetic(left, right, who, location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless signed_arithmetic_type(left_value.type) && signed_arithmetic_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": signed comparison operands must have exactly the same signed arithmetic type and width")
  values(left_value, right_value)

fun signed_lt_bits(left, right, who, location):
  def (left_value, right_value) = require_signed_arithmetic(left,
                                                            right,
                                                            who,
                                                            location)
  kernel.hw_slt(left_value, right_value, #false, location)

fun signed_lt(left, right, name = #false, location = Location()):
  comparison_bool(signed_lt_bits(left, right, #'signed_lt, location),
                  name, location)

fun ordered_lt_bits(left, right, who, location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  if signed_arithmetic_type(left_value.type) || signed_arithmetic_type(right_value.type)
  | signed_lt_bits(left_value, right_value, who, location)
  | unsigned_lt_bits(left_value, right_value, who, location)

fun ordered_lt(left, right, name = #false, location = Location()):
  comparison_bool(ordered_lt_bits(left, right, #'ordered_lt, location),
                  name, location)

fun unsigned_gt(left, right, name = #false, location = Location()):
  unsigned_lt(right, left, name, location)

fun unsigned_le(left, right, name = #false, location = Location()):
  def (left_value, right_value) = require_unsigned_bits(left, right, #'unsigned_le, location)
  comparison_bool(
    kernel.bit_not(kernel.hw_ult(right_value, left_value, #false, location),
                   #false,
                   location),
    name,
    location
  )

fun unsigned_ge(left, right, name = #false, location = Location()):
  def (left_value, right_value) = require_unsigned_bits(left, right, #'unsigned_ge, location)
  comparison_bool(
    kernel.bit_not(kernel.hw_ult(left_value, right_value, #false, location),
                   #false,
                   location),
    name,
    location
  )

operator (left < right):
  ~order: order_comparison
  if kernel.hardware_entity(left) || kernel.hardware_entity(right)
  | ordered_lt(left, right)
  | (left compare_to right) .< 0

operator (left > right):
  ~order: order_comparison
  if kernel.hardware_entity(left) || kernel.hardware_entity(right)
  | ordered_lt(right, left)
  | (left compare_to right) .> 0

operator (left <= right):
  ~order: order_comparison
  if kernel.hardware_entity(left) || kernel.hardware_entity(right)
  | block:
      def result = ordered_lt_bits(right, left, #'ordered_lt, Location())
      comparison_bool(kernel.bit_not(result,
                                     #false,
                                     Location()),
                      #false,
                      Location())
  | (left compare_to right) .<= 0

operator (left >= right):
  ~order: order_comparison
  if kernel.hardware_entity(left) || kernel.hardware_entity(right)
  | block:
      def result = ordered_lt_bits(left, right, #'ordered_lt, Location())
      comparison_bool(kernel.bit_not(result,
                                     #false,
                                     Location()),
                      #false,
                      Location())
  | (left compare_to right) .>= 0

fun mux(condition,
        true_value,
        false_value,
        name = #false,
        location = Location()):
  def condition_value = kernel.read(condition, location)
  unless bool_type(condition_value.type)
  | error(~who: #'mux, location.describe() ++ ": mux condition must be Bool")
  kernel.hw_mux_lookup(kernel.cast(condition, Bits(1), #false, location),
                       false_value,
                       [[1, true_value]],
                       name,
                       location,
                       Origin("embedded mux", name || ""))
