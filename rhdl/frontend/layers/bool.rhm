#lang rhombus/and_meta
// Defines Bool literals, reductions, population counts, encoders, comparisons, and selection.

import:
  rhombus.bits.(<<) as <<
  rhombus.bits.(?) as ?
  "../../core/ir.rhm" open
  "../../core/types.rhm".count_index_width
  "../../core/types.rhm".signed_arithmetic_type
  "../kernel.rhm" as kernel
  "../support/finite-enum.rhm" as finite_enum_support
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".hardware_as_bits
  "../support/hardware-literal.rhm".HardwareLiteral

export:
  Bool
  bool_type
  bool_eq
  bool_ne
  or_reduce
  and_reduce
  popcount
  priority_encoder
  priority_encoder_oh
  is_one_of
  enum_valid
  unsigned_lt
  signed_lt
  unsigned_gt
  unsigned_le
  unsigned_ge
  mux
  ===
  =/=
  <
  >
  <=
  >=

class _BoolType():
  implements BitwiseType
  implements Callable
  override method describe(): "bool"
  override method type_equal(other): bool_type(other)
  override method bit_width(): 1
  override method call(value :: Boolean) :~ HardwareFields:
    BoolLiteral(this, value)

// Keeps a host Boolean distinct from its eventual one-bit hardware value
// until an elaborated operation consumes it.
class BoolLiteral(type :: _BoolType, value :: Boolean):
  implements HardwareLiteral
  override method literal_type(): type
  override method packed_value(): if value | 1 | 0

def Bool = _BoolType()

annot.macro 'Bool':
  'HardwareFields.of(Bool)'

fun bool_type(type):
  type is_a _BoolType

// Equality remains a Bits core operation. Frontend nominal flat types compare
// by explicitly exposing equal-width representations first.
fun equality_bits(left, right, who, spelling :: String, location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless flat_data_type(left_value.type) && flat_data_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": " ++ spelling ++ " operands must have exactly the same FlatDataType")
  def left_bits = hardware_as_bits(left_value, who, spelling ++ " operand", #false, location)
  def right_bits = hardware_as_bits(right_value, who, spelling ++ " operand", #false, location)
  kernel.hw_eq(left_bits, right_bits, #false, location)

fun bool_eq(left, right, name = #false, location = Location()):
  kernel.cast(equality_bits(left, right, #'bool_eq, "===", location),
              Bool,
              name,
              location)

operator (left === right):
  bool_eq(left, right)

// Inequality is the Boolean complement of typed equality. Keeping one core
// equality operation preserves exactly the same nominal type contract.
fun bool_ne(left, right, name = #false, location = Location()):
  def equal = kernel.cast(
    equality_bits(left, right, #'bool_ne, "=/=", location),
    Bool,
    #false,
    location
  )
  kernel.bit_not(equal, name, location)

// Packs a nonempty host list without introducing a zero-length hardware type.
fun packed_reduction_list(entities, who, spelling :: String, location):
  def packed_elements = for List (entity in entities):
    def value = kernel.read(entity, location)
    def width = packed_width(value.type)
    unless data_type(value.type) && width != #false
    | error(~who: who,
            location.describe() ++ ": " ++ spelling ++ " list elements must have packable DataTypes")
    hardware_as_bits(value, who, spelling ++ " list element", #false, location)
  def packed:
    if packed_elements.length() == 1
    | packed_elements[0]
    | kernel.concat(packed_elements, #false, location)
  def mutable total_width = 0
  for (element in packed_elements):
    total_width := total_width + element.type.width
  values(packed, total_width)

// Validates and packs the common operand accepted by Boolean bit reductions.
fun packed_reduction_operand(entity, who, spelling :: String, location):
  if entity is_a List
  | packed_reduction_list(entity, who, spelling, location)
  | block:
      def value = kernel.read(entity, location)
      def width = packed_width(value.type)
      unless data_type(value.type) && width != #false
      | error(~who: who,
              location.describe() ++ ": " ++ spelling ++ " operand must have a packable DataType")
      values(hardware_as_bits(value, who, spelling ++ " operand", #false, location), width)

fun reduction_identity(value :: Nat, name, location):
  kernel.cast(kernel.literal(Bits(1), value, #false, location),
              Bool,
              name,
              location)

// Reduces the canonical packed representation of hardware data to whether any
// bit is asserted. Existing equality and inversion IR fully express the
// operation, so the frontend does not introduce a reduction-specific opcode.
fun or_reduce(entity, name = #false, location = Location()) :~ HardwareFields:
  if entity is_a List && entity.length() == 0
  | reduction_identity(0, name, location)
  | block:
      def (packed, width) = packed_reduction_operand(entity, #'or_reduce, "or_reduce", location)
      def equal_zero = kernel.cast(
        kernel.hw_eq(packed,
                     kernel.literal(Bits(width), 0, #false, location),
                     #false,
                     location),
        Bool,
        #false,
        location
      )
      kernel.bit_not(equal_zero, name, location)

// Reduces the canonical packed representation of hardware data to whether
// every bit is asserted. Equality with the packed all-ones value avoids a new
// core reduction operation.
fun and_reduce(entity, name = #false, location = Location()) :~ HardwareFields:
  if entity is_a List && entity.length() == 0
  | reduction_identity(1, name, location)
  | block:
      def (packed, width) = packed_reduction_operand(entity, #'and_reduce, "and_reduce", location)
      def all_ones = (1 << width) - 1
      kernel.cast(
        kernel.hw_eq(packed,
                     kernel.literal(Bits(width), all_ones, #false, location),
                     #false,
                     location),
        Bool,
        name,
        location
      )

class PopcountNode(value, capacity :: PosInt)

fun widen_popcount_node(node :: PopcountNode,
                        target_width :: PosInt,
                        location):
  if node.value.type.width == target_width
  | node.value
  | kernel.zext(node.value, target_width, #false, location)

// Each node carries the number of source bits beneath it, allowing every
// internal adder to use the minimum width that can represent its subtree sum.
fun merge_popcount_nodes(left :: PopcountNode,
                         right :: PopcountNode,
                         name,
                         location) :: PopcountNode:
  def capacity = left.capacity + right.capacity
  def result_width = count_index_width(capacity + 1)
  PopcountNode(
    kernel.hw_add(widen_popcount_node(left, result_width, location),
                  widen_popcount_node(right, result_width, location),
                  name,
                  location),
    capacity
  )

fun reduce_popcount_nodes(nodes :: List,
                          name,
                          location):
  if nodes.length() == 1
  | nodes[0].value
  | block:
      def mutable next_nodes = []
      def mutable remaining = nodes
      while remaining.length() >= 2:
        next_nodes := [
          merge_popcount_nodes(remaining[0],
                               remaining[1],
                               if nodes.length() == 2 | name | #false,
                               location)
        ] ++ next_nodes
        remaining := remaining.drop(2)
      when remaining.length() == 1
      | next_nodes := [remaining[0]] ++ next_nodes
      reduce_popcount_nodes(next_nodes.reverse(), name, location)

// Counts asserted bits in the canonical packed representation. Pairwise
// reduction gives logarithmic depth while capacity-aware widths avoid carrying
// impossible high bits through smaller subtrees.
fun popcount(entity,
             name = #false,
             location = Location()) :~ HardwareFields:
  if entity is_a List && entity.length() == 0
  | kernel.literal(Bits(1), 0, name, location)
  | block:
      def (packed, width) = packed_reduction_operand(entity, #'popcount, "popcount", location)
      def nodes = for List (index in 0..width):
        PopcountNode(
          kernel.extract(packed,
                         index,
                         index,
                         if width == 1 | name | #false,
                         location),
          1
        )
      reduce_popcount_nodes(nodes, name, location)

// Statically shifts a packed value toward higher-numbered bits without
// introducing a dynamic shifter into the core IR.
fun static_shift_left(value, width :: PosInt, amount :: PosInt, location):
  if amount >= width
  | kernel.literal(Bits(width), 0, #false, location)
  | kernel.concat(
      [kernel.extract(value, width - amount - 1, 0, #false, location),
       kernel.literal(Bits(amount), 0, #false, location)],
      #false,
      location
    )

// Isolates the least-significant asserted bit using a logarithmic-depth
// parallel prefix OR network. An all-zero operand produces all zeroes.
fun packed_priority_encoder_oh(packed, width :: PosInt, name, location):
  def mutable prefix = packed
  def mutable distance = 1
  while distance < width:
    prefix := kernel.bit_or(
      prefix,
      static_shift_left(prefix, width, distance, location),
      #false,
      location
    )
    distance := distance * 2
  kernel.bit_and(
    packed,
    kernel.bit_not(
      static_shift_left(prefix, width, 1, location),
      #false,
      location
    ),
    name,
    location
  )

// Returns an optional-one-hot Bits mask selecting the lowest asserted packed
// bit. Bits zero is also the lowest logical lane of Vec values.
fun priority_encoder_oh(entity,
                        name = #false,
                        location = Location()) :~ HardwareFields:
  when entity is_a List
  | error(~who: #'priority_encoder_oh,
          location.describe() ++ ": priority_encoder_oh operand must be one packable DataType")
  def value = kernel.read(entity, location)
  def width = packed_width(value.type)
  unless data_type(value.type) && width != #false
  | error(~who: #'priority_encoder_oh,
          location.describe() ++ ": priority_encoder_oh operand must have a packable DataType")
  def packed = hardware_as_bits(
    value,
    #'priority_encoder_oh,
    "priority_encoder_oh operand",
    #false,
    location
  )
  packed_priority_encoder_oh(packed, width, name, location)

fun priority_index_mask(width :: PosInt, result_bit :: Nat):
  def mutable mask = 0
  for (index in 0..width):
    when index ? result_bit
    | mask := mask + (1 << index)
  mask

// Encodes the lowest asserted packed bit. Zero input returns index zero; use
// or_reduce when the caller must distinguish that case from bit zero winning.
fun priority_encoder(entity,
                     name = #false,
                     location = Location()) :~ HardwareFields:
  when entity is_a List
  | error(~who: #'priority_encoder,
          location.describe() ++ ": priority_encoder operand must be one packable DataType")
  def value = kernel.read(entity, location)
  def width = packed_width(value.type)
  unless data_type(value.type) && width != #false
  | error(~who: #'priority_encoder,
          location.describe() ++ ": priority_encoder operand must have a packable DataType")
  def packed = hardware_as_bits(
    value,
    #'priority_encoder,
    "priority_encoder operand",
    #false,
    location
  )
  def selected = packed_priority_encoder_oh(packed, width, #false, location)
  def result_width = count_index_width(width)
  def result_bits = for List (result_bit in 0..result_width):
    def selected_for_bit = kernel.bit_and(
      selected,
      kernel.literal(
        Bits(width),
        priority_index_mask(width, result_bit),
        #false,
        location
      ),
      #false,
      location
    )
    kernel.bit_not(
      kernel.hw_eq(
        selected_for_bit,
        kernel.literal(Bits(width), 0, #false, location),
        #false,
        location
      ),
      if result_width == 1 | name | #false,
      location
    )
  if result_width == 1
  | result_bits[0]
  | kernel.concat(result_bits.reverse(), name, location)

operator (left =/= right):
  ~same_as: ===
  bool_ne(left, right)

// Compares one hardware value against a host-authored set of typed choices.
// The fold happens during elaboration and therefore needs no dedicated IR op.
fun is_one_of(value, candidate, ...) :~ HardwareFields:
  def location = Location()
  def value_read = kernel.read(value, location)
  unless flat_data_type(value_read.type)
  | error(~who: #'is_one_of,
          location.describe() ++ ": is_one_of subject must have a FlatDataType")
  def supplied = [candidate, ...]
  def candidates:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  if candidates.length() == 0
  | reduction_identity(0, #false, location)
  | block:
      def comparisons = candidates.map(
        fun (alternative):
          equality_bits(value_read,
                        alternative,
                        #'is_one_of,
                        "is_one_of",
                        location)
      )
      def mutable combined = comparisons[0]
      for (comparison in comparisons.drop(1)):
        combined := kernel.bit_or(combined, comparison, #false, location)
      kernel.cast(combined, Bool, #false, location)

// Generates a runtime membership predicate from the enum type's declared
// encodings, keeping sparse wire encodings distinct from host type safety.
fun enum_valid(value, name = #false, location = Location()) :~ HardwareFields:
  def value_read = kernel.read(value, location)
  def type = value_read.type
  unless type is_a finite_enum_support.FiniteEnumType
  | error(~who: #'enum_valid,
          location.describe() ++ ": enum_valid operand must have a hardware enum type")
  def width = packed_width(type)
  def packed = hardware_as_bits(value_read,
                                #'enum_valid,
                                "enum_valid operand",
                                #false,
                                location)
  def comparisons = type.enum_encodings().map(
    fun (encoding):
      kernel.hw_eq(packed,
                   kernel.literal(Bits(width), encoding, #false, location),
                   #false,
                   location)
  )
  def mutable combined = comparisons[0]
  for (comparison in comparisons.drop(1)):
    combined := kernel.bit_or(combined, comparison, #false, location)
  kernel.cast(combined, Bool, name, location)

fun require_unsigned_bits(left, right, who, location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless bits_type(left_value.type) && bits_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": unsigned comparison operands must have exactly the same Bits width")
  values(left_value, right_value)

fun comparison_bool(value, name, location):
  kernel.cast(value, Bool, name, location)

fun unsigned_lt_bits(left, right, who, location):
  def (left_value, right_value) = require_unsigned_bits(left, right, who, location)
  kernel.hw_ult(left_value, right_value, #false, location)

fun unsigned_lt(left, right, name = #false, location = Location()):
  comparison_bool(unsigned_lt_bits(left, right, #'unsigned_lt, location),
                  name, location)

fun require_signed_arithmetic(left, right, who, location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless signed_arithmetic_type(left_value.type) && signed_arithmetic_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": signed comparison operands must have exactly the same signed arithmetic type and width")
  values(left_value, right_value)

fun signed_lt_bits(left, right, who, location):
  def (left_value, right_value) = require_signed_arithmetic(left,
                                                            right,
                                                            who,
                                                            location)
  kernel.hw_slt(left_value, right_value, #false, location)

fun signed_lt(left, right, name = #false, location = Location()):
  comparison_bool(signed_lt_bits(left, right, #'signed_lt, location),
                  name, location)

fun ordered_lt_bits(left, right, who, location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  if signed_arithmetic_type(left_value.type) || signed_arithmetic_type(right_value.type)
  | signed_lt_bits(left_value, right_value, who, location)
  | unsigned_lt_bits(left_value, right_value, who, location)

fun ordered_lt(left, right, name = #false, location = Location()):
  comparison_bool(ordered_lt_bits(left, right, #'ordered_lt, location),
                  name, location)

fun unsigned_gt(left, right, name = #false, location = Location()):
  unsigned_lt(right, left, name, location)

fun unsigned_le(left, right, name = #false, location = Location()):
  def (left_value, right_value) = require_unsigned_bits(left, right, #'unsigned_le, location)
  comparison_bool(
    kernel.bit_not(kernel.hw_ult(right_value, left_value, #false, location),
                   #false,
                   location),
    name,
    location
  )

fun unsigned_ge(left, right, name = #false, location = Location()):
  def (left_value, right_value) = require_unsigned_bits(left, right, #'unsigned_ge, location)
  comparison_bool(
    kernel.bit_not(kernel.hw_ult(left_value, right_value, #false, location),
                   #false,
                   location),
    name,
    location
  )

operator (left < right):
  ~order: order_comparison
  if kernel.hardware_entity(left) || kernel.hardware_entity(right)
  | ordered_lt(left, right)
  | (left compare_to right) .< 0

operator (left > right):
  ~order: order_comparison
  if kernel.hardware_entity(left) || kernel.hardware_entity(right)
  | ordered_lt(right, left)
  | (left compare_to right) .> 0

operator (left <= right):
  ~order: order_comparison
  if kernel.hardware_entity(left) || kernel.hardware_entity(right)
  | block:
      def result = ordered_lt_bits(right, left, #'ordered_lt, Location())
      comparison_bool(kernel.bit_not(result,
                                     #false,
                                     Location()),
                      #false,
                      Location())
  | (left compare_to right) .<= 0

operator (left >= right):
  ~order: order_comparison
  if kernel.hardware_entity(left) || kernel.hardware_entity(right)
  | block:
      def result = ordered_lt_bits(left, right, #'ordered_lt, Location())
      comparison_bool(kernel.bit_not(result,
                                     #false,
                                     Location()),
                      #false,
                      Location())
  | (left compare_to right) .>= 0

fun mux(condition,
        true_value,
        false_value,
        name = #false,
        location = Location()):
  def condition_value = kernel.read(condition, location)
  unless bool_type(condition_value.type)
  | error(~who: #'mux, location.describe() ++ ": mux condition must be Bool")
  kernel.hw_mux_lookup(hardware_as_bits(condition, #'mux, "mux condition", #false, location),
                       false_value,
                       [[1, true_value]],
                       name,
                       location,
                       Origin("embedded mux", name || ""))
