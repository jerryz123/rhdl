#lang rhombus/and_meta
// Defines sync circuits with implicit clock and synchronous-reset ports.

import:
  rhombus/meta open
  "../kernel.rhm".new_circuit_identity as kernel_new_circuit_identity
  "../support/clocking.rhm".build_sync_circuit

export:
  sync_circuit

defn.macro 'sync_circuit $(name :: Identifier)($argument, ...): $body; ...':
  fun parameter_value(argument):
    match argument
    | '$(keyword :: Keyword): $(binding :: Identifier) :: $_ = $_': binding
    | '$(keyword :: Keyword): $(binding :: Identifier) = $_': binding
    | '$(keyword :: Keyword): $(binding :: Identifier) :: $_': binding
    | '$(keyword :: Keyword): $(binding :: Identifier)': binding
    | ~else: argument
  def circuit_name = name.to_source_string()
  def clock = Syntax.make_id("clock", name)
  def reset = Syntax.make_id("reset", name)
  let [argument_value, ...] = [parameter_value(argument), ...]
  '«
     def circuit_identity = kernel_new_circuit_identity($circuit_name)
     fun $name($argument, ...):
       fun implementation($clock, $reset):
         $body
         ...
       build_sync_circuit(circuit_identity,
                          $circuit_name,
                          [$argument_value, ...],
                          implementation)
   »'
