#lang rhombus/and_meta
// Defines the combinational value, function, and operator layer over the elaboration kernel.

import:
  rhombus
  rhombus.(!) as host_invert
  rhombus/meta open
  "../../core/ir.rhm".Location
  "../../core/types.rhm" open
  "../kernel.rhm" open:
    except:
      concat
      literal
      dont_care
      zext
      trunc
      bit_not
      bit_and
      bit_or
      bit_xor
      hw_shl
      hw_shru
      hw_shrs
  "../kernel.rhm".concat as kernel_concat
  "../kernel.rhm".dont_care as kernel_dont_care
  "../kernel.rhm".zext as kernel_zext
  "../kernel.rhm".trunc as kernel_trunc
  "../kernel.rhm".bit_not as kernel_bit_not
  "../kernel.rhm".bit_and as kernel_bit_and
  "../kernel.rhm".bit_or as kernel_bit_or
  "../kernel.rhm".bit_xor as kernel_bit_xor
  "../kernel.rhm".hw_shl as kernel_hw_shl
  "../kernel.rhm".hw_shru as kernel_hw_shru
  "../kernel.rhm".hw_shrs as kernel_hw_shrs
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".hardware_as_bits
  "../support/hardware-literal.rhm" open
  "../support/mux-lookup.rhm" open

export:
  bits
  literal
  dont_care
  bit_not
  bit_and
  bit_or
  bit_xor
  hw_add
  hw_mul
  hw_sub
  hw_shl
  hw_shru
  hw_eq
  hw_decode
  mux_lookup
  concat
  extract
  zext
  trunc
  +
  *
  -
  <<
  >>
  &
  |||
  ^
  !

meta:
  fun preserve_operand_surface(result, operand):
    statinfo_meta.wrap(result, statinfo_meta.gather(operand))

// Frontend literals are static host shadows. They allocate core operations
// only when a hardware consumer reads them during elaboration.
fun literal(type, value, name = #false):
  packed_literal(type, value, name)

fun bits(value, width, name = #false) :~ HardwareFields:
  literal(Bits(width), value, name)

// Host shift amounts are elaboration-time constants. Convert them to the
// narrowest positive-width Bits literal while leaving dynamic hardware
// amounts untouched for the kernel's ordinary type checking.
fun required_shift_amount_width(amount):
  fun loop(width, capacity):
    if amount < capacity
    | width
    | loop(width + 1, capacity * 2)
  loop(1, 2)

fun normalize_shift_amount(amount, who):
  cond
  | amount is_a Nat:
      bits(amount, required_shift_amount_width(amount))
  | amount is_a Int:
      error(~who: who, "shift amount must be a host natural number or hardware Bits")
  | ~else: amount

fun hw_shl(value,
           amount,
           name = #false,
           location = Location()) :~ HardwareFields:
  kernel_hw_shl(value,
                normalize_shift_amount(amount, #'hw_shl),
                name,
                location)

fun hw_shru(value,
            amount,
            name = #false,
            location = Location()) :~ HardwareFields:
  kernel_hw_shru(value,
                 normalize_shift_amount(amount, #'hw_shru),
                 name,
                 location)

fun hw_shrs(value,
            amount,
            name = #false,
            location = Location()) :~ HardwareFields:
  kernel_hw_shrs(value,
                 normalize_shift_amount(amount, #'hw_shrs),
                 name,
                 location)

fun bit_not(entity,
            name = #false,
            location = Location()) :~ HardwareFields:
  kernel_bit_not(entity, name, location)

fun bit_and(left,
            right,
            name = #false,
            location = Location()) :~ HardwareFields:
  kernel_bit_and(left, right, name, location)

fun bit_or(left,
           right,
           name = #false,
           location = Location()) :~ HardwareFields:
  kernel_bit_or(left, right, name, location)

fun bit_xor(left,
            right,
            name = #false,
            location = Location()) :~ HardwareFields:
  kernel_bit_xor(left, right, name, location)

// Like a literal shadow, a typed don't-care is materialized only when a
// hardware consumer reads it. Core IR carries only its packed Bits image.
class DontCareValue(type :: DataType, name = #false):
  implements StaticHardwareValue
  constructor (type :: DataType, name = #false):
    unless type_well_formed(type)
    | error(~who: #'dont_care,
            "don't-care type must be a well-formed DataType")
    def width = type.packed_width()
    unless width is_a PosInt
    | error(~who: #'dont_care,
            "don't-care type must have a packed representation")
    unless name == #false || name is_a String
    | error(~who: #'dont_care,
            "don't-care name must be a String or #false")
    super(type, name)

  override method materialize_hardware(location):
    def width = type.packed_width()
    if bits_type(type)
    | kernel_dont_care(type, name, location)
    | cast(kernel_dont_care(Bits(width), #false, location),
           type,
           name,
           location)

fun dont_care(type, name = #false):
  DontCareValue(type, name)

fun concat_operand(entity):
  hardware_as_bits(entity, #'concat, "concat operand")

fun concat(entity, ...) :~ HardwareFields:
  def supplied = [entity, ...]
  def entities:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  unless entities.length() >= 2
  | error(~who: #'concat, "concat requires at least two operands")
  kernel_concat(entities.map(concat_operand))

// Zero extension retains the kernel's narrow unsigned bit-vector contract.
// Other hardware types must cross into Bits explicitly before changing width.
fun zext(entity, target_width, name = #false) :~ HardwareFields:
  kernel_zext(entity, target_width, name)

fun trunc(entity, target_width, name = #false) :~ HardwareFields:
  kernel_trunc(entity, target_width, name)

fun build_mux_lookup(selector, default_value, cases):
  def selector_value = read(selector)
  cond
  | bits_type(selector_value.type):
      hw_mux_lookup(selector_value, default_value, cases)
  | selector_value.type is_a MuxLookupSelectorType:
      def selector_bits = hardware_as_bits(selector_value, #'mux_lookup, "mux lookup selector")
      def normalized_cases = cases.map(
        fun (case):
          unless case is_a List && case.length() == 2
          | error(~who: #'mux_lookup, "mux lookup cases must be [key, value] pairs")
          [selector_value.type.normalize_mux_lookup_key(case[0]), case[1]]
      )
      hw_mux_lookup(selector_bits, default_value, normalized_cases)
  | ~else:
      hw_mux_lookup(selector_value, default_value, cases)

expr.macro
| 'mux_lookup($(selector :: expr_meta.Parsed),
              ~default: $(default_value :: expr_meta.Parsed),
              $cases)':
    preserve_operand_surface(
      'build_mux_lookup($selector, $default_value, $cases)',
      default_value
    )
| 'mux_lookup($(selector :: expr_meta.Parsed),
              ~default: $(default_value :: expr_meta.Parsed)):
     $(key :: expr_meta.Parsed): $case_value
     ...':
    preserve_operand_surface(
      'build_mux_lookup($selector,
                        $default_value,
                        [[$key, $case_value], ...])',
      default_value
    )

operator (left + right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_add(left, right)
  | left rhombus.(+) right

operator (left * right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_mul(left, right)
  | left rhombus.(*) right

operator
| (left - right):
    if hardware_entity(left) || hardware_entity(right)
    | hw_sub(left, right)
    | left rhombus.(-) right
| (- entity):
    ~order: multiplication
    if hardware_entity(entity)
    | block:
        def value = read(entity)
        hw_sub(literal(value.type, 0), value)
    | rhombus.(-) entity

fun shift_left_operator(left, right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_shl(left, right)
  | left rhombus.bits.(<<) right

fun shift_right_operator(left, right):
  if hardware_entity(left) || hardware_entity(right)
  | block:
      def value = read(left)
      if signed_arithmetic_type(value.type)
      | hw_shrs(value, right)
      | hw_shru(value, right)
  | left rhombus.bits.(>>) right

fun bit_and_operator(left, right):
  bit_and(left, right)

fun bit_or_operator(left, right):
  bit_or(left, right)

fun bit_xor_operator(left, right):
  bit_xor(left, right)

fun bit_not_operator(entity):
  if hardware_entity(entity)
  | bit_not(entity)
  | host_invert(entity)

expr.macro '$left << $right':
  ~order: bitwise_shift
  preserve_operand_surface('shift_left_operator($left, $right)', left)

expr.macro '$left >> $right':
  ~order: bitwise_shift
  preserve_operand_surface('shift_right_operator($left, $right)', left)

expr.macro '$left & $right':
  ~order: bitwise_conjunction
  preserve_operand_surface('bit_and_operator($left, $right)', left)

expr.macro '$left ||| $right':
  ~order: bitwise_disjunction
  preserve_operand_surface('bit_or_operator($left, $right)', left)

expr.macro '$left ^ $right':
  ~order: bitwise_disjunction
  preserve_operand_surface('bit_xor_operator($left, $right)', left)

expr.macro '! $entity':
  ~order: bitwise_negation
  preserve_operand_surface('bit_not_operator($entity)', entity)
