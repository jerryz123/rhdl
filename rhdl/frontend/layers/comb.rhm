#lang rhombus/and_meta
// Defines the combinational value, function, and operator layer over the elaboration kernel.

import:
  rhombus
  rhombus/meta open
  "../../core/types.rhm" open
  "../kernel.rhm" open:
    except concat
  "../kernel.rhm".concat as kernel_concat
  "../support/fields.rhm".HardwareFields

export:
  bits
  literal
  bit_not
  bit_and
  bit_or
  bit_xor
  hw_add
  hw_mul
  hw_sub
  hw_shl
  hw_shru
  hw_eq
  mux_lookup
  concat
  extract
  zext
  trunc
  +
  *
  -
  <<
  >>
  &
  ^
  and
  or
  xor
  not

fun bits(value,
         ~width,
         name = #false):
  literal(Bits(width), value, name)

// Packs frontend data operands into their canonical Bits representations and
// constructs one kernel concat, preserving left-to-right MSB ordering.
fun concat_operand(entity):
  def value = read(entity)
  def width = packed_width(value.type)
  unless data_type(value.type) && width != #false
  | error(~who: #'concat,
          "concat operands must have packable DataType types")
  if bits_type(value.type)
  | value
  | cast(value, Bits(width))

fun concat(entity, ...) :~ HardwareFields:
  def supplied = [entity, ...]
  def entities:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  unless entities.length() >= 2
  | error(~who: #'concat, "concat requires at least two operands")
  kernel_concat(entities.map(concat_operand))

fun build_mux_lookup(selector, default_value, cases):
  hw_mux_lookup(selector, default_value, cases)

expr.macro 'mux_lookup($selector, ~default: $default_value):
              $key: $case_value
              ...':
  'build_mux_lookup($selector,
                    $default_value,
                    [[$key, $case_value], ...])'

operator (left + right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_add(left, right)
  | left rhombus.(+) right

operator (left * right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_mul(left, right)
  | left rhombus.(*) right

operator (left - right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_sub(left, right)
  | left rhombus.(-) right

operator (left << right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_shl(left, right)
  | left rhombus.bits.(<<) right

operator (left >> right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_shru(left, right)
  | left rhombus.bits.(>>) right

operator (left & right):
  bit_and(left, right)

operator (left ^ right):
  bit_xor(left, right)

operator (left and right):
  ~order: bitwise_conjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_and(left, right)
  | left rhombus.bits.and right

operator (left or right):
  ~order: bitwise_disjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_or(left, right)
  | left rhombus.bits.or right

operator (left xor right):
  ~order: bitwise_disjunction
  if hardware_entity(left) || hardware_entity(right)
  | bit_xor(left, right)
  | left rhombus.bits.xor right

operator (not entity):
  ~order: bitwise_negation
  if hardware_entity(entity)
  | bit_not(entity)
  | rhombus.bits.not entity
