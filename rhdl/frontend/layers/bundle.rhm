#lang rhombus/and_meta
// Defines the bundle declaration, record construction, and field-access frontend layer.

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields

export:
  RecordField
  RecordType
  bundle
  record

defn.macro 'bundle $(name :: Identifier)($parameter, ...):
              $field_name: $field_type
              ...':
  let [field_string, ...] = [field_name.to_source_string(), ...]
  '«
     fun $name($parameter, ...):
       RecordType([RecordField($field_string, $field_type), ...])
     annot.macro '$name($('$')type_argument, $'...')':
       'HardwareFields.of($name($('$')type_argument, $'...'))'
   »'

expr.macro 'record($type):
              $field_name: $field_value
              ...':
  let [field_string, ...] = [field_name.to_source_string(), ...]
  'kernel.record_create($type,
                        [[$field_string, $field_value], ...]) :: HardwareFields'
