#lang rhombus/and_meta
// Defines the recursively composable explicit-role interface frontend layer.

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".hardware_index
  "../support/fields.rhm".hardware_into
  "../support/fields.rhm".hardware_lookup
  "../support/instance-members.rhm".InstanceMembers
  "../support/instance-members.rhm".register_member_resolver

export:
  InterfaceFlow
  InterfaceMember
  InterfaceType
  InterfaceEndpoint
  interface
  <=>
  Endpoint
  InterfaceFields

class InterfaceFlow(from_role, to_role, type):
  constructor (from_role, to_role, type):
    unless from_role is_a String && to_role is_a String && from_role != to_role
    | error(~who: #'InterfaceFlow, "interface flow requires two distinct role names")
    unless record_type(type) && type_well_formed(type)
    | error(~who: #'InterfaceFlow, "interface flow type must be a well-formed RecordType")
    super(from_role, to_role, type)

class InterfaceMember(name, type, from_role, to_role)

class InterfaceType(name, roles, members, parent = #false):
  constructor (name, roles, declarations, parent = #false):
    unless name is_a String
    | error(~who: #'InterfaceType, "interface name must be a String")
    unless roles is_a List && roles.length() == 2 && roles[0] != roles[1]
    | error(~who: #'InterfaceType, "interfaces require exactly two distinct roles")
    unless declarations is_a List
    | error(~who: #'InterfaceType, "interface declarations must be a List")
    when parent
    | unless parent is_a InterfaceType
      | error(~who: #'InterfaceType,
              "interface refinement parent must be an InterfaceType")
      unless roles == parent.roles
      | error(~who: #'InterfaceType,
              "refined interface roles must match the parent roles")
    def mutable members = if parent | parent.members | []
    for (declaration in declarations):
      cond
      | declaration is_a InterfaceMember:
          members := members ++ [declaration]
      | declaration is_a InterfaceFlow:
          members := members ++ declaration.type.fields.map(
            fun (field):
              InterfaceMember(field.name,
                              field.type,
                              declaration.from_role,
                              declaration.to_role)
          )
      | ~else:
          members := members ++ [declaration]
    unless members.length() >= 1
    | error(~who: #'InterfaceType, "interfaces require at least one member")
    for (member in members):
      unless member is_a InterfaceMember
      | error(~who: #'InterfaceType, "interface members must be InterfaceMember values")
      unless member.name is_a String
      | error(~who: #'InterfaceType, "interface member name must be a String")
      unless member.from_role in roles && member.to_role in roles && member.from_role != member.to_role
      | error(~who: #'InterfaceType, "interface member uses an unknown or identical role")
      unless member.type is_a DataType || member.type is_a InterfaceType
      | error(~who: #'InterfaceType,
              "interface member type must be a DataType or InterfaceType")
      when members.filter(
        ~keep: fun (candidate): candidate.name == member.name
      ).length() != 1
      | error(~who: #'InterfaceType, "interface member names must be unique")
    super(name, roles, members, parent)

  property flows: interface_flows(this)

  method flow_for_field(field_name):
    def member = members.find(fun (candidate): candidate.name == field_name)
    if member
    | flows.find(
        fun (flow):
          flow.from_role == member.from_role && flow.to_role == member.to_role
      )
    | #false

  method complementary_role(role):
    unless role in roles
    | error(~who: #'interface, "unknown interface role " ++ role)
    if roles[0] == role | roles[1] | roles[0]

fun nested_role_to_parent(member, nested_type, nested_role):
  if nested_role == nested_type.roles[0]
  | member.from_role
  | member.to_role

fun nested_flow_for_parent_direction(member, parent_from, parent_to):
  def nested_type = member.type
  nested_type.flows.find(
    fun (flow):
      (nested_role_to_parent(member, nested_type, flow.from_role) == parent_from) && (nested_role_to_parent(member, nested_type, flow.to_role) == parent_to)
  )

fun interface_flow(type, from_role, to_role):
  def mutable fields = []
  for (member in type.members):
    if member.type is_a DataType
    | when member.from_role == from_role && member.to_role == to_role
      | fields := fields ++ [RecordField(member.name, member.type)]
    | block:
        def nested_flow = nested_flow_for_parent_direction(member,
                                                           from_role,
                                                           to_role)
        when nested_flow
        | fields := fields ++ [RecordField(member.name, nested_flow.type)]
  if fields.length() == 0
  | #false
  | InterfaceFlow(from_role, to_role, RecordType(fields))

fun interface_flows(type):
  def forward = interface_flow(type, type.roles[0], type.roles[1])
  def backward = interface_flow(type, type.roles[1], type.roles[0])
  [forward, backward].filter(~keep: fun (flow): flow)

class InterfaceBinding(flow, port_name, entity)

class InterfaceEndpoint(type, role, bindings, view, mutable nested_endpoints = []):
  implements kernel.HardwareEntity
  method field(field_name):
    def member = type.members.find(fun (candidate): candidate.name == field_name)
    unless member
    | error(~who: #'interface,
            "interface " ++ type.name ++ " has no field named " ++ field_name)
    if member.type is_a InterfaceType
    | block:
        def cached = nested_endpoints.find(
          fun (candidate): candidate[0] == field_name
        )
        if cached
        | cached[1]
        | block:
            def endpoint = nested_endpoint(this, member)
            nested_endpoints := nested_endpoints ++ [[field_name, endpoint]]
            endpoint
    | block:
        def binding = bindings.find(
          fun (candidate):
            candidate.flow.from_role == member.from_role && candidate.flow.to_role == member.to_role
        )
        kernel.project(binding.entity, field_name)

class InterfaceGroup(module_def, name, type, role, bindings)
class InterfaceArrayGroup(module_def, name, groups)

def mutable interface_groups = []
def mutable interface_array_groups = []

fun interface_member_type_equal(left, right):
  if left is_a InterfaceType || right is_a InterfaceType
  | interface_type_equal(left, right)
  | type_equal(left, right)

fun interface_type_equal(left, right):
  if !(left is_a InterfaceType && right is_a InterfaceType) || left.name != right.name || left.roles != right.roles || !interface_parent_equal(left.parent, right.parent) || left.members.length() != right.members.length()
  | #false
  | for all (left_member in left.members, right_member in right.members):
      left_member.name == right_member.name && left_member.from_role == right_member.from_role && left_member.to_role == right_member.to_role && interface_member_type_equal(left_member.type, right_member.type)

fun interface_parent_equal(left, right):
  if left || right
  | left is_a InterfaceType && right is_a InterfaceType && interface_type_equal(left, right)
  | #true

fun interface_type_supports(type, expected_type):
  type is_a InterfaceType && expected_type is_a InterfaceType && (
    interface_type_equal(type, expected_type) || (
      type.parent is_a InterfaceType && interface_type_supports(type.parent,
                                                                expected_type)
    )
  )

fun flow_port_name(endpoint_name, flow, role):
  def direction = if flow.from_role == role | "out" | "in"
  endpoint_name ++ "_" ++ direction

fun nested_endpoint(endpoint, member):
  def nested_type = member.type
  def nested_role:
    if endpoint.role == member.from_role
    | nested_type.roles[0]
    | nested_type.roles[1]
  def nested_bindings:
    nested_type.flows.map(
      fun (nested_flow):
        def parent_from = nested_role_to_parent(member,
                                                nested_type,
                                                nested_flow.from_role)
        def parent_to = nested_role_to_parent(member,
                                              nested_type,
                                              nested_flow.to_role)
        def parent_binding = endpoint.bindings.find(
          fun (binding):
            binding.flow.from_role == parent_from && binding.flow.to_role == parent_to
        )
        InterfaceBinding(nested_flow,
                         parent_binding.port_name ++ "__" ++ member.name,
                         kernel.project(parent_binding.entity, member.name))
    )
  InterfaceEndpoint(nested_type,
                    nested_role,
                    nested_bindings,
                    endpoint.view ++ "." ++ member.name)

fun validate_interface_declaration(type, role):
  unless type is_a InterfaceType
  | error(~who: #'interface, "endpoint type must be an InterfaceType")
  unless role is_a String && role in type.roles
  | error(~who: #'interface, "unknown interface role " ++ to_string(role))

fun interface_name_taken(module_def, name):
  interface_groups.find(
    fun (group): group.module_def === module_def && group.name == name
  ) || interface_array_groups.find(
    fun (group): group.module_def === module_def && group.name == name
  )

fun declare_interface_unchecked(module_def, name, type, role):
  def bindings:
    type.flows.map(
      fun (flow):
        def port_name = flow_port_name(name, flow, role)
        def entity:
          if flow.from_role == role
          | kernel.output(port_name, flow.type)
          | kernel.input(port_name, flow.type)
        InterfaceBinding(flow, port_name, entity)
    )
  def group = InterfaceGroup(module_def, name, type, role, bindings)
  interface_groups := interface_groups ++ [group]
  [group, InterfaceEndpoint(type, role, bindings, "boundary")]

fun declare_interface(name, type, role):
  validate_interface_declaration(type, role)
  def module_def = kernel.active_module()
  when interface_name_taken(module_def, name)
  | error(~who: #'interface, "duplicate interface endpoint " ++ name)
  declare_interface_unchecked(module_def, name, type, role)[1]

fun declare_interface_array(name, count, type, role):
  unless count is_a Int && count > 0
  | error(~who: #'interface, "interface endpoint array length must be a positive host Int")
  validate_interface_declaration(type, role)
  def module_def = kernel.active_module()
  def element_names:
    for List (index in 0..count): name ++ "_" ++ to_string(index)
  when interface_name_taken(module_def, name) || element_names.find(
    fun (element_name): interface_name_taken(module_def, element_name)
  )
  | error(~who: #'interface, "duplicate interface endpoint " ++ name)
  def declarations:
    for List (element_name in element_names):
      declare_interface_unchecked(module_def, element_name, type, role)
  interface_array_groups := interface_array_groups ++ [
    InterfaceArrayGroup(module_def,
                        name,
                        declarations.map(fun (declaration): declaration[0]))
  ]
  Array(& declarations.map(fun (declaration): declaration[1]))

fun endpoint_for_group(instance, group):
  def bindings:
    group.bindings.map(
      fun (binding):
        def entity:
          if binding.flow.from_role == group.role
          | instance.output(binding.port_name)
          | instance.input(binding.port_name)
        InterfaceBinding(binding.flow, binding.port_name, entity)
    )
  InterfaceEndpoint(group.type, group.role, bindings, "instance")

fun endpoint_for_instance(instance, name):
  def group = interface_groups.find(
    fun (candidate): candidate.module_def === instance.module_def && candidate.name == name
  )
  if group | endpoint_for_group(instance, group) | #false

fun endpoint_array_for_instance(instance, name):
  def group = interface_array_groups.find(
    fun (candidate): candidate.module_def === instance.module_def && candidate.name == name
  )
  if group
  | Array(& group.groups.map(fun (element_group): endpoint_for_group(instance, element_group)))
  | #false

fun interface_member(value, name):
  if value is_a InterfaceEndpoint
  | value.field(name)
  | kernel.project(value, name)

fun resolve_interface_member(value, name):
  cond
  | value is_a InterfaceEndpoint: value.field(name)
  | value is_a Instance:
      endpoint_for_instance(value, name) || endpoint_array_for_instance(value, name)
  | ~else: #false

def registered_interface_member_resolver = register_member_resolver(resolve_interface_member)

fun interface_endpoint_has_type(value, expected_type):
  value is_a InterfaceEndpoint && expected_type is_a InterfaceType && interface_type_equal(value.type, expected_type)

fun interface_endpoint_supports_type(value, expected_type):
  value is_a InterfaceEndpoint && interface_type_supports(value.type,
                                                          expected_type)

annot.macro 'Endpoint':
  annot_meta.pack_predicate(
    'fun (value): value is_a InterfaceEndpoint',
    '(($(statinfo_meta.dot_provider_key), interface_field_dot))'
  )

namespace Endpoint:
  export annot.macro 'of($expected_type)':
    annot_meta.pack_predicate(
      'fun (value): interface_endpoint_has_type(value, $expected_type)',
      '(($(statinfo_meta.dot_provider_key), interface_field_dot))'
    )

  export annot.macro 'supports($expected_type)':
    annot_meta.pack_predicate(
      'fun (value): interface_endpoint_supports_type(value, $expected_type)',
      '(($(statinfo_meta.dot_provider_key), interface_field_dot))'
    )

// Retains the implementation-facing name while the standard profile exports
// Endpoint as the public annotation for interface-producing functions.
annot.macro 'InterfaceFields': 'Endpoint'

annot.macro 'InterfaceArrayFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a Array',
    '(($(statinfo_meta.index_get_key), interface_array_index))'
  )

fun interface_array_index(value, index) :~ Endpoint:
  unless index is_a Int
  | error(~who: #'interface, "interface array index must be a host Int")
  value[index]

dot.macro 'interface_field_dot $left $dot $right':
  match right
  | 'type': #false
  | 'role': #false
  | 'bindings': #false
  | 'view': #false
  | 'into': 'fun (target_type) :~ InstanceMembers: hardware_into($left, target_type)'
  | 'lookup': 'fun (selector, ~default: default_value) :~ InstanceMembers: hardware_lookup($left, selector, ~default: default_value)'
  | ~else:
      'interface_member($left, $(right.to_source_string())) :: InstanceMembers'

fun interface_connection_pairs(left, right):
  unless left is_a InterfaceEndpoint && right is_a InterfaceEndpoint
  | error(~who: #'connect_interfaces, "bulk interface connection requires two interface endpoints")
  unless interface_type_equal(left.type, right.type)
  | error(~who: #'connect_interfaces, "bulk-connected endpoints must have the same interface type")
  def pairs:
    for List (left_binding in left.bindings):
      def right_binding = right.bindings.find(
        fun (candidate):
          candidate.flow.from_role == left_binding.flow.from_role && candidate.flow.to_role == left_binding.flow.to_role
      )
      [left_binding.entity, right_binding.entity]
  for (pair in pairs):
    def left_entity = pair[0]
    def right_entity = pair[1]
    unless ((left_entity is_a Place && right_entity is_a Value) || (left_entity is_a Value && right_entity is_a Place))
    | error(~who: #'connect_interfaces,
            "interface endpoints have incompatible roles and boundary directions")
    def place = if left_entity is_a Place | left_entity | right_entity
    def value = if left_entity is_a Value | left_entity | right_entity
    unless type_equal(place.type, value.type)
    | error(~who: #'connect_interfaces, "interface flow types do not match")
    when place.driver
    | error(~who: #'connect_interfaces, "interface destination already has a driver")
  pairs

fun connect_interfaces(left, right):
  def pairs:
    cond
    | left is_a InterfaceEndpoint && right is_a InterfaceEndpoint:
        interface_connection_pairs(left, right)
    | left is_a Array && right is_a Array:
        unless left.length() == right.length()
        | error(~who: #'connect_interfaces,
                "bulk-connected interface endpoint arrays must have the same length")
        def mutable all_pairs = []
        for (index in 0..left.length()):
          all_pairs := all_pairs ++ interface_connection_pairs(left[index], right[index])
        all_pairs
    | ~else:
        error(~who: #'connect_interfaces,
              "bulk interface connection requires two interface endpoints or two interface endpoint arrays")
  for (pair in pairs):
    if pair[0] is_a Place
    | kernel.connect(pair[0], pair[1])
    | kernel.connect(pair[1], pair[0])
  #void

fun make_refined_interface(name, parent, declarations):
  unless parent is_a InterfaceType
  | error(~who: #'interface,
          "interface refinement parent must be an InterfaceType")
  InterfaceType(name, parent.roles, declarations, parent)

defn.macro
| 'interface $(name :: Identifier)($parameter, ...) refines $(parent :: expr_meta.Parsed):
       $(first_from :: Identifier) -> $(first_to :: Identifier):
         $first_field: $first_type
         ...
       $(second_from :: Identifier) -> $(second_to :: Identifier):
         $second_field: $second_type
         ...':
    def interface_name = name.to_source_string()
    def first_from_name = first_from.to_source_string()
    def first_to_name = first_to.to_source_string()
    def second_from_name = second_from.to_source_string()
    def second_to_name = second_to.to_source_string()
    let [first_field_name, ...] = [first_field.to_source_string(), ...]
    let [second_field_name, ...] = [second_field.to_source_string(), ...]
    'fun $name($parameter, ...):
       make_refined_interface(
         $interface_name,
         $parent,
         [InterfaceMember($first_field_name,
                          $first_type,
                          $first_from_name,
                          $first_to_name),
          ...,
          InterfaceMember($second_field_name,
                          $second_type,
                          $second_from_name,
                          $second_to_name),
          ...]
       )'
| 'interface $(name :: Identifier)($parameter, ...) refines $(parent :: expr_meta.Parsed):
       $(from_role :: Identifier) -> $(to_role :: Identifier):
         $field: $field_type
         ...':
    def interface_name = name.to_source_string()
    def from_role_name = from_role.to_source_string()
    def to_role_name = to_role.to_source_string()
    let [field_name, ...] = [field.to_source_string(), ...]
    'fun $name($parameter, ...):
       make_refined_interface(
         $interface_name,
         $parent,
         [InterfaceMember($field_name,
                          $field_type,
                          $from_role_name,
                          $to_role_name),
          ...]
       )'
| 'interface $(name :: Identifier)($parameter, ...) refines $(parent :: expr_meta.Parsed)':
    def interface_name = name.to_source_string()
    'fun $name($parameter, ...):
       make_refined_interface($interface_name, $parent, [])'
| 'interface $(name :: Identifier)($parameter, ...):
              role $(first_role :: Identifier)
              role $(second_role :: Identifier)
              $(first_from :: Identifier) -> $(first_to :: Identifier):
                $first_field: $first_type
                ...
              $(second_from :: Identifier) -> $(second_to :: Identifier):
                $second_field: $second_type
                ...':
    def interface_name = name.to_source_string()
    def first_role_name = first_role.to_source_string()
    def second_role_name = second_role.to_source_string()
    def first_from_name = first_from.to_source_string()
    def first_to_name = first_to.to_source_string()
    def second_from_name = second_from.to_source_string()
    def second_to_name = second_to.to_source_string()
    let [first_field_name, ...] = [first_field.to_source_string(), ...]
    let [second_field_name, ...] = [second_field.to_source_string(), ...]
    'fun $name($parameter, ...):
       InterfaceType(
         $interface_name,
         [$first_role_name, $second_role_name],
         [InterfaceMember($first_field_name,
                          $first_type,
                          $first_from_name,
                          $first_to_name),
          ...,
          InterfaceMember($second_field_name,
                          $second_type,
                          $second_from_name,
                          $second_to_name),
          ...]
       )'
| 'interface $(name :: Identifier)($type, ~role: $(role :: Identifier))':
    def endpoint_name = name.to_source_string()
    def role_name = role.to_source_string()
    'def $name :: Endpoint = declare_interface($endpoint_name, $type, $role_name)'
| 'interface $(name :: Identifier)[$count]($type, ~role: $(role :: Identifier))':
    def endpoint_name = name.to_source_string()
    def role_name = role.to_source_string()
    'def $name :: InterfaceArrayFields = declare_interface_array($endpoint_name, $count, $type, $role_name)'
| 'interface $(name :: Identifier)($parameter, ...):
     role $(first_role :: Identifier)
     role $(second_role :: Identifier)
     $(from_role :: Identifier) -> $(to_role :: Identifier):
       $field: $field_type
       ...':
    def interface_name = name.to_source_string()
    def first_role_name = first_role.to_source_string()
    def second_role_name = second_role.to_source_string()
    def from_role_name = from_role.to_source_string()
    def to_role_name = to_role.to_source_string()
    let [field_name, ...] = [field.to_source_string(), ...]
    'fun $name($parameter, ...):
       InterfaceType(
         $interface_name,
         [$first_role_name, $second_role_name],
         [InterfaceMember($field_name,
                          $field_type,
                          $from_role_name,
                          $to_role_name),
          ...]
       )'

operator (left <=> right):
  ~weaker_than: ~other
  connect_interfaces(left, right)
