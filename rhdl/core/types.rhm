#lang rhombus
// Defines RHDL's canonical hardware-type abstraction and structural predicates.

export:
  HardwareType
  DataType
  Bits
  Bool
  Clock
  Reset
  hardware_type
  data_type
  type_well_formed
  type_equal
  bits_type
  bits1_type
  bool_type
  clock_type
  reset_type
  one_bit_type
  logic_type
  mux_selector_type
  selector_width
  bits_text
  type_text

interface HardwareType:
  method describe()
  method type_equal(other)

interface DataType:
  extends HardwareType

class Bits(width):
  implements DataType
  constructor (width):
    unless width is_a Int && width > 0
    | error(~who: #'Bits, "width must be a positive host Int")
    super(width)

  override method describe():
    bits_text(this)

  override method type_equal(other):
    bits_type(other) && width == other.width

class _BoolType():
  implements DataType
  override method describe(): "bool"
  override method type_equal(other): bool_type(other)

class _ClockType():
  implements HardwareType
  override method describe(): "clock"
  override method type_equal(other): clock_type(other)

class _ResetType():
  implements HardwareType
  override method describe(): "reset"
  override method type_equal(other): reset_type(other)

def Bool = _BoolType()
def Clock = _ClockType()
def Reset = _ResetType()

fun hardware_type(type):
  type is_a HardwareType

fun data_type(type):
  type is_a DataType

fun bits_type(type):
  type is_a Bits && type.width is_a Int && type.width > 0

fun bits1_type(type):
  bits_type(type) && type.width == 1

fun bool_type(type):
  type is_a _BoolType

fun clock_type(type):
  type is_a _ClockType

fun reset_type(type):
  type is_a _ResetType

fun one_bit_type(type):
  bits1_type(type) || bool_type(type) || clock_type(type) || reset_type(type)

fun logic_type(type):
  bits_type(type) || bool_type(type)

fun mux_selector_type(type):
  bits_type(type) || bool_type(type)

fun selector_width(type):
  if bits_type(type)
  | type.width
  | if bool_type(type)
    | 1
    | #false

fun type_well_formed(type):
  hardware_type(type)

fun type_equal(left, right):
  hardware_type(left) && hardware_type(right) && left.type_equal(right) && right.type_equal(left)

fun bits_text(type):
  "bits<" ++ to_string(type.width) ++ ">"

fun type_text(type):
  type.describe()
