#lang rhombus
// Defines RHDL's canonical hardware-type abstraction and structural predicates.

import:
  rhombus/rx open

export:
  HardwareType
  DataType
  FlatDataType
  BitwiseType
  ArithmeticType
  SignedArithmeticType
  Bits
  Clock
  Reset
  RecordField
  RecordType
  VectorType
  hardware_type
  data_type
  flat_data_type
  bitwise_type
  arithmetic_type
  signed_arithmetic_type
  data_width
  packed_width
  packable_type
  cast_compatible
  type_well_formed
  type_equal
  bits_type
  clock_type
  reset_type
  record_type
  vector_type
  mux_selector_type
  selector_width
  bits_text
  type_text

interface HardwareType:
  method describe()
  method type_equal(other)

interface DataType:
  extends HardwareType

interface FlatDataType:
  extends DataType
  method bit_width()

interface BitwiseType:
  extends FlatDataType

// Marks fixed-width integer-like values whose modular arithmetic preserves
// their nominal type. Width-changing operations use with_bit_width so core
// can retain an extension-defined type without importing its frontend layer.
interface ArithmeticType:
  extends BitwiseType
  method with_bit_width(width)

interface SignedArithmeticType:
  extends ArithmeticType

class Bits(width :: PosInt):
  implements ArithmeticType

  override method describe():
    bits_text(this)

  override method type_equal(other):
    bits_type(other) && width == other.width

  override method bit_width():
    width

  override method with_bit_width(new_width):
    Bits(new_width)

class _ClockType():
  implements HardwareType
  override method describe(): "clock"
  override method type_equal(other): clock_type(other)

class _ResetType():
  implements HardwareType
  override method describe(): "reset"
  override method type_equal(other): reset_type(other)

def Clock = _ClockType()
def Reset = _ResetType()

def record_field_identifier = rx'bof ["A"-"Z" "a"-"z" "_"] ["A"-"Z" "a"-"z" "0"-"9" "_"]* eof'

class RecordField(name, type):
  constructor (name, type):
    unless name is_a String && record_field_identifier.is_match(name)
    | error(~who: #'RecordField,
            "field name must be an ASCII identifier")
    unless type is_a DataType
    | error(~who: #'RecordField, "field type must be a DataType")
    super(name, type)

class RecordType(fields, preferred_name = #false):
  implements DataType
  constructor (fields, preferred_name = #false):
    unless fields is_a List && fields.length() >= 1
    | error(~who: #'RecordType,
            "fields must be a nonempty List of RecordField values")
    unless preferred_name == #false || (preferred_name is_a String && record_field_identifier.is_match(preferred_name))
    | error(~who: #'RecordType,
            "preferred name must be an ASCII identifier or #false")
    for (field in fields):
      unless field is_a RecordField
      | error(~who: #'RecordType,
              "fields must be a nonempty List of RecordField values")
      when fields.filter(~keep: fun (candidate): candidate.name == field.name).length() != 1
      | error(~who: #'RecordType,
              "record field names must be unique")
    super(fields, preferred_name)

  method field(name):
    fields.find(fun (candidate): candidate.name == name)

  override method describe():
    "record<" ++ String.join(
      fields.map(fun (field): field.name ++ ": " ++ field.type.describe()),
      ", "
    ) ++ ">"

  override method type_equal(other):
    if !record_type(other) || fields.length() != other.fields.length()
    | #false
    | for all (left_field in fields,
               right_field in other.fields):
        left_field.name == right_field.name && left_field.type.type_equal(right_field.type) && right_field.type.type_equal(left_field.type)

// Models a fixed-length packed hardware vector. Logical element zero occupies
// the least-significant element-width bits of the canonical representation.
class VectorType(length :: PosInt, element_type):
  implements DataType
  constructor (length :: PosInt, element_type):
    unless element_type is_a DataType
    | error(~who: #'VectorType, "element type must be a DataType")
    super(length, element_type)

  override method describe():
    "vector<" ++ to_string(length) ++ " x " ++ element_type.describe() ++ ">"

  override method type_equal(other):
    vector_type(other) && length == other.length && element_type.type_equal(other.element_type) && other.element_type.type_equal(element_type)

fun hardware_type(type):
  type is_a HardwareType

fun data_type(type):
  type is_a DataType

fun flat_data_type(type):
  type is_a FlatDataType

fun bitwise_type(type):
  type is_a BitwiseType

fun arithmetic_type(type):
  type is_a ArithmeticType

fun signed_arithmetic_type(type):
  type is_a SignedArithmeticType

fun data_width(type):
  if flat_data_type(type)
  | block:
      def width = type.bit_width()
      if width is_a PosInt | width | #false
  | #false

// Computes the canonical packed representation width used only by explicit
// casts. Record fields put the first field in the most-significant bits;
// vectors put logical element zero in the least-significant bits.
fun packed_width(type):
  cond
  | flat_data_type(type):
      def width = data_width(type)
      if width is_a PosInt | width | #false
  | record_type(type):
      def mutable width = 0
      def mutable packable = #true
      for (field in type.fields):
        def field_width = packed_width(field.type)
        if field_width == #false
        | packable := #false
        | width := width + field_width
      if packable | width | #false
  | vector_type(type):
      def element_width = packed_width(type.element_type)
      if element_width == #false | #false | type.length * element_width
  | clock_type(type) || reset_type(type):
      1
  | ~else:
      #false

fun packable_type(type):
  packed_width(type) != #false

fun cast_compatible(source_type, target_type):
  def source_width = packed_width(source_type)
  def target_width = packed_width(target_type)
  source_width != #false && target_width != #false && source_width == target_width

fun bits_type(type):
  type is_a Bits

fun clock_type(type):
  type is_a _ClockType

fun reset_type(type):
  type is_a _ResetType

fun record_type(type):
  type is_a RecordType

fun vector_type(type):
  type is_a VectorType

fun mux_selector_type(type):
  bits_type(type)

fun selector_width(type):
  if bits_type(type) | type.width | #false

fun record_fields_well_formed(fields):
  fields.length() >= 1 && (for all (field in fields): field is_a RecordField && data_type(field.type) && type_well_formed(field.type))

fun type_well_formed(type):
  cond
  | !hardware_type(type): #false
  | flat_data_type(type): data_width(type) != #false
  | record_type(type): record_fields_well_formed(type.fields)
  | vector_type(type):
      data_type(type.element_type) && type_well_formed(type.element_type)
  | ~else: #true

fun type_equal(left, right):
  hardware_type(left) && hardware_type(right) && left.type_equal(right) && right.type_equal(left)

fun bits_text(type):
  "bits<" ++ to_string(type.width) ++ ">"

fun type_text(type):
  type.describe()
