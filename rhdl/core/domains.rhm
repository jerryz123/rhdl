#lang rhombus
// Defines backend-independent clock-use summaries and reset-use inventory objects.

import:
  "ir.rhm" open

export:
  ClockUse
  ClockGroup
  NoReset
  AmbientReset
  LocalReset
  Combinational
  SingleClock
  MultiClock

// Records one module-local clocked effect after transparent wire aliases have
// been resolved. A false reset means the operation is resetless.
class ClockUse(operation :: Operation,
               clock :: Value,
               reset = #false)

class ClockGroup(clock :: Value,
                 uses :: List)

class NoReset(operations :: List)
class AmbientReset(reset :: Value,
                   operations :: List)
class LocalReset(reset :: Value,
                 operations :: List)

// These three result shapes keep the important clocking distinction explicit
// without adding domain metadata to the hardware IR itself.
class Combinational(module_def :: Module,
                    reset_uses :: List)
class SingleClock(module_def :: Module,
                  clock :: Value,
                  reset_uses :: List,
                  clocked_operations :: List)
class MultiClock(module_def :: Module,
                 clock_groups :: List,
                 reset_uses :: List)
