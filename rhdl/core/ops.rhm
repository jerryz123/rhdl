#lang rhombus
// Registers namespaced RHDL operations and their structural and behavioral schemas.

export:
  OperationSchema
  schemas
  schema_for
  combinational_opcode

class OperationSchema(opcode,
                      kind,
                      operand_count,
                      result_count,
                      place_count,
                      required_attributes,
                      type_rule,
                      print_form,
                      circt_lowering)

def schemas:
  [OperationSchema("rtl.input_port", "structural", 0, 1, 0,
                   ["name"], "hardware_input_port", "input_port", "boundary"),
   OperationSchema("rtl.output_port", "structural", 0, 0, 1,
                   ["name"], "hardware_output_port", "output_port", "boundary"),
   OperationSchema("rtl.constant", "combinational", 0, 1, 0,
                   ["value", "name"], "bits_constant", "constant", "hw.constant"),
   OperationSchema("rtl.not", "combinational", 1, 1, 0,
                   ["name"], "bitwise_same_type_unary", "value", "not"),
   OperationSchema("rtl.and", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value", "comb.and"),
   OperationSchema("rtl.or", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value", "comb.or"),
   OperationSchema("rtl.xor", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value", "comb.xor"),
   OperationSchema("rtl.add", "combinational", 2, 1, 0,
                   ["name"], "bits_same_width_binary", "value", "comb.add"),
   OperationSchema("rtl.sub", "combinational", 2, 1, 0,
                   ["name"], "bits_same_width_binary", "value", "comb.sub"),
   OperationSchema("rtl.eq", "combinational", 2, 1, 0,
                   ["name"], "bits_same_width_compare", "value", "eq"),
   OperationSchema("rtl.mux_lookup", "combinational", #false, 1, 0,
                   ["keys", "name"], "data_mux_lookup", "mux_lookup", "mux_lookup"),
   OperationSchema("rtl.reinterpret", "combinational", 1, 1, 0,
                   ["name"], "flat_reinterpret", "value", "alias"),
   OperationSchema("rtl.as_bits", "combinational", 1, 1, 0,
                   ["name"], "control_to_bits", "value", "alias"),
   OperationSchema("rtl.as_clock", "combinational", 1, 1, 0,
                   ["name"], "to_clock", "value", "alias"),
   OperationSchema("rtl.as_reset", "combinational", 1, 1, 0,
                   ["name"], "to_reset", "value", "alias"),
   OperationSchema("rtl.concat", "combinational", #false, 1, 0,
                   ["name"], "bits_concat", "value", "concat"),
   OperationSchema("rtl.extract", "combinational", 1, 1, 0,
                   ["high", "low", "name"], "bits_extract", "extract", "extract"),
   OperationSchema("rtl.zext", "combinational", 1, 1, 0,
                   ["target_width", "name"], "bits_zext", "resize", "zext"),
   OperationSchema("rtl.trunc", "combinational", 1, 1, 0,
                   ["target_width", "name"], "bits_trunc", "resize", "trunc"),
   OperationSchema("rtl.record_create", "combinational", #false, 1, 0,
                   ["fields", "name"], "record_create", "record_create", "hw.struct_create"),
   OperationSchema("rtl.record_get", "combinational", 1, 1, 0,
                   ["field", "name"], "record_get", "record_get", "hw.struct_extract"),
   OperationSchema("rtl.register", "sequential", 1, 1, 1,
                   ["name"], "data_register", "register", "seq.firreg"),
   OperationSchema("rtl.register_reset", "sequential", 3, 1, 1,
                   ["name"], "data_register_reset", "register_reset", "seq.firreg"),
   OperationSchema("rtl.instance", "structural", #false, #false, #false,
                   ["name", "module"], "instance", "instance", "hw.instance"),
   OperationSchema("rtl.drive", "structural", 1, 0, 1,
                   [], "type_equal_drive", "drive", "boundary")]

fun schema_for(opcode):
  schemas.find(fun (schema): schema.opcode == opcode)

fun combinational_opcode(opcode):
  def schema = schema_for(opcode)
  schema && schema.kind == "combinational"
