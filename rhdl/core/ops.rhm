#lang rhombus
// Registers namespaced RHDL operations and their structural and behavioral schemas.

export:
  OperationSchema
  schemas
  schema_for
  combinational_opcode

class OperationSchema(opcode,
                      kind,
                      operand_count,
                      result_count,
                      place_count,
                      required_attributes,
                      type_rule,
                      print_form)

def schemas:
  [OperationSchema("rtl.input_port", "structural", 0, 1, 0,
                   ["name"], "hardware_input_port", "input_port"),
   OperationSchema("rtl.output_port", "structural", 0, 0, 1,
                   ["name"], "hardware_output_port", "output_port"),
   OperationSchema("rtl.constant", "combinational", 0, 1, 0,
                   ["value", "name"], "bits_constant", "constant"),
   OperationSchema("rtl.not", "combinational", 1, 1, 0,
                   ["name"], "bitwise_same_type_unary", "value"),
   OperationSchema("rtl.and", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value"),
   OperationSchema("rtl.or", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value"),
   OperationSchema("rtl.xor", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value"),
   OperationSchema("rtl.add", "combinational", 2, 1, 0,
                   ["name"], "bits_same_width_binary", "value"),
   OperationSchema("rtl.sub", "combinational", 2, 1, 0,
                   ["name"], "bits_same_width_binary", "value"),
   OperationSchema("rtl.eq", "combinational", 2, 1, 0,
                   ["name"], "bits_same_width_compare", "value"),
   OperationSchema("rtl.mux_lookup", "combinational", #false, 1, 0,
                   ["keys", "name"], "data_mux_lookup", "mux_lookup"),
   OperationSchema("rtl.cast", "combinational", 1, 1, 0,
                   ["name"], "packed_cast", "cast"),
   OperationSchema("rtl.concat", "combinational", #false, 1, 0,
                   ["name"], "bits_concat", "value"),
   OperationSchema("rtl.extract", "combinational", 1, 1, 0,
                   ["high", "low", "name"], "bits_extract", "extract"),
   OperationSchema("rtl.zext", "combinational", 1, 1, 0,
                   ["target_width", "name"], "bits_zext", "resize"),
   OperationSchema("rtl.trunc", "combinational", 1, 1, 0,
                   ["target_width", "name"], "bits_trunc", "resize"),
   OperationSchema("rtl.record_create", "combinational", #false, 1, 0,
                   ["fields", "name"], "record_create", "record_create"),
   OperationSchema("rtl.record_get", "combinational", 1, 1, 0,
                   ["field", "name"], "record_get", "record_get"),
   OperationSchema("rtl.vector_create", "combinational", #false, 1, 0,
                   ["name"], "vector_create", "vector_create"),
   OperationSchema("rtl.vector_get", "combinational", 1, 1, 0,
                   ["index", "name"], "vector_get", "vector_get"),
   OperationSchema("rtl.register", "sequential", 1, 1, 1,
                   ["name"], "data_register", "register"),
   OperationSchema("rtl.register_reset", "sequential", 3, 1, 1,
                   ["name"], "data_register_reset", "register_reset"),
   OperationSchema("rtl.instance", "structural", #false, #false, #false,
                   ["name", "module"], "instance", "instance"),
   OperationSchema("rtl.drive", "structural", 1, 0, 1,
                   [], "type_equal_drive", "drive")]

fun schema_for(opcode):
  schemas.find(fun (schema): schema.opcode == opcode)

fun combinational_opcode(opcode):
  def schema = schema_for(opcode)
  schema && schema.kind == "combinational"
