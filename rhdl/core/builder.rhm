#lang rhombus
// Builds well-owned RHDL IR while enforcing local type, naming, and driver rules.

import:
  rhombus/rx open
  "types.rhm" open
  "ir.rhm" open

export:
  Builder

fun fail(who, message):
  error(~who: who, message)

fun ensure_hardware_type(type, who):
  unless type_well_formed(type)
  | fail(who, "expected a well-formed HardwareType")

fun ensure_bits(type, who):
  ensure_hardware_type(type, who)
  unless bits_type(type)
  | fail(who, "expected a Bits type")

fun ensure_data_type(type, who):
  ensure_hardware_type(type, who)
  unless data_type(type)
  | fail(who, "expected a DataType")

def hardware_identifier = rx'bof ["A"-"Z" "a"-"z" "_"] ["A"-"Z" "a"-"z" "0"-"9" "_"]* eof'

fun ensure_hardware_name(name, who):
  unless name is_a String && hardware_identifier.is_match(name)
  | fail(who, "hardware name must be an ASCII identifier")
  when name.starts_with("__rhdl_")
  | fail(who, "hardware names beginning with __rhdl_ are reserved")

fun ensure_module_in_design(design, module_def, who):
  def owned = module_def is_a Module && module_def.design === design && design.modules.find(fun (candidate): candidate === module_def)
  unless owned
  | fail(who, "module belongs to a different design")

fun ensure_open(module_def, who):
  when module_def.finished
  | fail(who, "module " ++ module_def.name ++ " is already finished")

fun ensure_value_in(module_def, value, who):
  unless value is_a Value
  | fail(who, "expected a readable hardware Value")
  def owned = value.module_def === module_def && module_def.values.find(fun (candidate): candidate === value)
  unless owned
  | fail(who, "hardware value belongs to a different module")

fun ensure_place_in(module_def, place, who):
  def owned = place is_a Place && place.module_def === module_def && module_def.places.find(fun (candidate): candidate === place)
  unless owned
  | fail(who, "hardware place belongs to a different module")

fun ensure_unique_hardware_name(module_def, name, who):
  when module_def.values.find(fun (value): value.name == name) || module_def.places.find(fun (place): place.name == name)
  | fail(who, "duplicate hardware name " ++ name)

fun ensure_unique_instance_name(module_def, name, who):
  when module_def.operations.find(
    fun (operation): operation.opcode == "rtl.instance" && operation.attribute("name", #false) == name
  )
  | fail(who, "duplicate instance name " ++ name)

fun build_value_operation(design,
                          module_def,
                          opcode,
                          operands,
                          result_type,
                          name,
                          location,
                          origin,
                          who,
                          attributes = {}):
  def operation_id = design.fresh_id()
  def value_name = name || "v" ++ to_string(operation_id)
  ensure_hardware_name(value_name, who)
  ensure_unique_hardware_name(module_def, value_name, who)
  def value = Value(design.fresh_id(), value_name, result_type, module_def, operation_id)
  def operation = Operation(operation_id,
                            opcode,
                            module_def,
                            operands,
                            [value],
                            [],
                            attributes ++ {"name": value_name},
                            location,
                            origin)
  for (operand in operands):
    operand.add_user(operation_id)
  module_def.add_value(value)
  module_def.add_operation(operation)
  value

fun build_bits_same_width_binary(design,
                                 module_def,
                                 opcode,
                                 left,
                                 right,
                                 name,
                                 location,
                                 origin,
                                 who):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, left, who)
  ensure_value_in(module_def, right, who)
  unless bits_type(left.type) && bits_type(right.type) && type_equal(left.type, right.type)
  | fail(who,
         opcode ++ " operands must have exactly the same Bits width")
  build_value_operation(design,
                        module_def,
                        opcode,
                        [left, right],
                        left.type,
                        name,
                        location,
                        origin,
                        who)

fun build_bitwise_same_type_binary(design,
                                   module_def,
                                   opcode,
                                   left,
                                   right,
                                   name,
                                   location,
                                   origin,
                                   who):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, left, who)
  ensure_value_in(module_def, right, who)
  unless bitwise_type(left.type) && bitwise_type(right.type) && type_equal(left.type, right.type)
  | fail(who,
         opcode ++ " operands must have exactly the same bitwise type")
  build_value_operation(design,
                        module_def,
                        opcode,
                        [left, right],
                        left.type,
                        name,
                        location,
                        origin,
                        who)

fun build_mux_lookup(design,
                     module_def,
                     selector,
                     default_value,
                     cases,
                     name,
                     location,
                     origin,
                     who):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, selector, who)
  ensure_value_in(module_def, default_value, who)
  unless mux_selector_type(selector.type)
  | fail(who, "mux lookup selector must be Bits")
  unless data_type(default_value.type)
  | fail(who, "mux lookup values must have a DataType")
  unless cases is_a List && cases.length() >= 1
  | fail(who, "mux lookup requires at least one case")
  def width = selector_width(selector.type)
  for (case in cases):
    unless case is_a List && case.length() == 2
    | fail(who, "mux lookup cases must be [key, value] pairs")
    def key = case[0]
    def value = case[1]
    unless key is_a Int
    | fail(who, "mux lookup keys must be host Int values")
    unless key >= 0 && key < (1 bits.(<<) width)
    | fail(who, "mux lookup key does not fit its selector type")
    ensure_value_in(module_def, value, who)
    unless data_type(value.type) && type_equal(default_value.type, value.type)
    | fail(who, "mux lookup cases and default must have exactly the same DataType")
  def normalized_cases = cases.sort(fun (left, right): left[0] < right[0])
  def mutable previous_key = #false
  for (case in normalized_cases):
    when previous_key != #false && previous_key == case[0]
    | fail(who, "mux lookup keys must be unique")
    previous_key := case[0]
  build_value_operation(design,
                        module_def,
                        "rtl.mux_lookup",
                        [selector, default_value] ++ normalized_cases.map(fun (case): case[1]),
                        default_value.type,
                        name,
                        location,
                        origin,
                        who,
                        {"keys": normalized_cases.map(fun (case): case[0])})

fun build_conversion(design,
                     module_def,
                     opcode,
                     value,
                     target_type,
                     source_ok,
                     source_description,
                     name,
                     location,
                     origin,
                     who):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, value, who)
  unless source_ok(value.type)
  | fail(who, opcode ++ " source must be " ++ source_description)
  build_value_operation(design,
                        module_def,
                        opcode,
                        [value],
                        target_type,
                        name,
                        location,
                        origin,
                        who)

class Builder(design):
  method module(name):
    ensure_hardware_name(name, #'module)
    when design.modules.find(fun (candidate): candidate.name == name)
    | fail(#'module, "duplicate module name " ++ name)
    def module_def = Module(design, design.fresh_id(), name)
    design.add_module(module_def)
    module_def

  method input(module_def, name, type, location = Location(), origin = Origin("input", name)):
    ensure_module_in_design(design, module_def, #'input)
    ensure_open(module_def, #'input)
    ensure_hardware_name(name, #'input)
    ensure_hardware_type(type, #'input)
    ensure_unique_hardware_name(module_def, name, #'input)
    def operation_id = design.fresh_id()
    def value = Value(design.fresh_id(), name, type, module_def, operation_id)
    def operation = Operation(operation_id,
                              "rtl.input_port",
                              module_def,
                              [],
                              [value],
                              [],
                              {"name": name},
                              location,
                              origin)
    module_def.add_value(value)
    module_def.add_operation(operation)
    module_def.add_input(Port(name, "input", type, value, #false))
    value

  method output(module_def, name, type, location = Location(), origin = Origin("output", name)):
    ensure_module_in_design(design, module_def, #'output)
    ensure_open(module_def, #'output)
    ensure_hardware_name(name, #'output)
    ensure_hardware_type(type, #'output)
    ensure_unique_hardware_name(module_def, name, #'output)
    def operation_id = design.fresh_id()
    def place = Place(design.fresh_id(), name, type, module_def, operation_id)
    def operation = Operation(operation_id,
                              "rtl.output_port",
                              module_def,
                              [],
                              [],
                              [place],
                              {"name": name},
                              location,
                              origin)
    module_def.add_place(place)
    module_def.add_operation(operation)
    module_def.add_output(Port(name, "output", type, #false, place))
    place

  method constant(module_def,
                  type,
                  integer,
                  name = #false,
                  location = Location(),
                  origin = Origin("constant")):
    ensure_module_in_design(design, module_def, #'constant)
    ensure_open(module_def, #'constant)
    ensure_bits(type, #'constant)
    unless integer is_a Int
    | fail(#'constant, "constant value must be a host Int")
    unless integer >= 0 && integer < (1 bits.(<<) type.width)
    | fail(#'constant,
           "constant " ++ to_string(integer) ++ " does not fit " ++ type.describe())
    def operation_id = design.fresh_id()
    def value_name = name || "v" ++ to_string(operation_id)
    ensure_hardware_name(value_name, #'constant)
    ensure_unique_hardware_name(module_def, value_name, #'constant)
    def value = Value(design.fresh_id(), value_name, type, module_def, operation_id)
    def operation = Operation(operation_id,
                              "rtl.constant",
                              module_def,
                              [],
                              [value],
                              [],
                              {"value": integer, "name": value_name},
                              location,
                              origin)
    module_def.add_value(value)
    module_def.add_operation(operation)
    value

  method add(module_def,
             left,
             right,
             name = #false,
             location = Location(),
             origin = Origin("add")):
    build_bits_same_width_binary(design,
                                 module_def,
                                 "rtl.add",
                                 left,
                                 right,
                                 name,
                                 location,
                                 origin,
                                 #'add)

  method bit_not(module_def,
                 operand,
                 name = #false,
                 location = Location(),
                 origin = Origin("not")):
    ensure_module_in_design(design, module_def, #'bit_not)
    ensure_open(module_def, #'bit_not)
    ensure_value_in(module_def, operand, #'bit_not)
    unless bitwise_type(operand.type)
    | fail(#'bit_not, "bit_not operand must have a bitwise type")
    build_value_operation(design,
                          module_def,
                          "rtl.not",
                          [operand],
                          operand.type,
                          name,
                          location,
                          origin,
                          #'bit_not)

  method bit_and(module_def,
                 left,
                 right,
                 name = #false,
                 location = Location(),
                 origin = Origin("and")):
    build_bitwise_same_type_binary(design, module_def, "rtl.and", left, right,
                                   name, location, origin, #'bit_and)

  method bit_or(module_def,
                left,
                right,
                name = #false,
                location = Location(),
                origin = Origin("or")):
    build_bitwise_same_type_binary(design, module_def, "rtl.or", left, right,
                                   name, location, origin, #'bit_or)

  method bit_xor(module_def,
                 left,
                 right,
                 name = #false,
                 location = Location(),
                 origin = Origin("xor")):
    build_bitwise_same_type_binary(design, module_def, "rtl.xor", left, right,
                                   name, location, origin, #'bit_xor)

  method sub(module_def,
             left,
             right,
             name = #false,
             location = Location(),
             origin = Origin("sub")):
    build_bits_same_width_binary(design, module_def, "rtl.sub", left, right,
                                 name, location, origin, #'sub)

  method eq(module_def,
            left,
            right,
            name = #false,
            location = Location(),
            origin = Origin("eq")):
    ensure_module_in_design(design, module_def, #'eq)
    ensure_open(module_def, #'eq)
    ensure_value_in(module_def, left, #'eq)
    ensure_value_in(module_def, right, #'eq)
    unless bits_type(left.type) && bits_type(right.type) && type_equal(left.type, right.type)
    | fail(#'eq, "eq operands must have exactly the same Bits width")
    build_value_operation(design,
                          module_def,
                          "rtl.eq",
                          [left, right],
                          Bits(1),
                          name,
                          location,
                          origin,
                          #'eq)

  method mux_lookup(module_def,
                    selector,
                    default_value,
                    cases,
                    name = #false,
                    location = Location(),
                    origin = Origin("mux_lookup")):
    build_mux_lookup(design,
                     module_def,
                     selector,
                     default_value,
                     cases,
                     name,
                     location,
                     origin,
                     #'mux_lookup)

  method reinterpret(module_def,
                     value,
                     target_type,
                     name = #false,
                     location = Location(),
                     origin = Origin("reinterpret")):
    ensure_data_type(target_type, #'reinterpret)
    unless flat_data_type(target_type)
    | fail(#'reinterpret, "reinterpret target must have a FlatDataType")
    build_conversion(design, module_def, "rtl.reinterpret", value, target_type,
                     fun (type): flat_data_type(type) && data_width(type) == data_width(target_type),
                     "a FlatDataType with the target width", name, location, origin,
                     #'reinterpret)

  method as_bits(module_def,
                 value,
                 name = #false,
                 location = Location(),
                 origin = Origin("as_bits")):
    build_conversion(design, module_def, "rtl.as_bits", value, Bits(1),
                     fun (type): clock_type(type) || reset_type(type),
                     "Clock or Reset", name, location, origin, #'as_bits)

  method as_clock(module_def,
                  value,
                  name = #false,
                  location = Location(),
                  origin = Origin("as_clock")):
    build_conversion(design, module_def, "rtl.as_clock", value, Clock,
                     fun (type): bits1_type(type),
                     "Bits(1)", name, location, origin, #'as_clock)

  method as_reset(module_def,
                  value,
                  name = #false,
                  location = Location(),
                  origin = Origin("as_reset")):
    build_conversion(design, module_def, "rtl.as_reset", value, Reset,
                     fun (type): bits1_type(type),
                     "Bits(1)", name, location, origin, #'as_reset)

  method concat(module_def,
                operands,
                name = #false,
                location = Location(),
                origin = Origin("concat")):
    ensure_module_in_design(design, module_def, #'concat)
    ensure_open(module_def, #'concat)
    unless operands is_a List
    | fail(#'concat, "concat operands must be supplied as a List")
    unless operands.length() >= 2
    | fail(#'concat, "concat requires at least two operands")
    def mutable result_width = 0
    for (value in operands):
      ensure_value_in(module_def, value, #'concat)
      unless bits_type(value.type)
      | fail(#'concat, "concat operands must have Bits types")
      result_width := result_width + value.type.width
    build_value_operation(design,
                          module_def,
                          "rtl.concat",
                          operands,
                          Bits(result_width),
                          name,
                          location,
                          origin,
                          #'concat)

  method extract(module_def,
                 value,
                 high,
                 low,
                 name = #false,
                 location = Location(),
                 origin = Origin("extract")):
    ensure_module_in_design(design, module_def, #'extract)
    ensure_open(module_def, #'extract)
    ensure_value_in(module_def, value, #'extract)
    unless bits_type(value.type)
    | fail(#'extract, "extract operand must have a Bits type")
    unless high is_a Int && low is_a Int
    | fail(#'extract, "extract indices must be host Int values")
    unless 0 <= low && low <= high && high < value.type.width
    | fail(#'extract,
           "extract indices must satisfy 0 <= low <= high < source width")
    build_value_operation(design,
                          module_def,
                          "rtl.extract",
                          [value],
                          Bits(high - low + 1),
                          name,
                          location,
                          origin,
                          #'extract,
                          {"high": high, "low": low})

  method zext(module_def,
              value,
              target_width,
              name = #false,
              location = Location(),
              origin = Origin("zext")):
    ensure_module_in_design(design, module_def, #'zext)
    ensure_open(module_def, #'zext)
    ensure_value_in(module_def, value, #'zext)
    unless bits_type(value.type)
    | fail(#'zext, "zext operand must have a Bits type")
    unless target_width is_a Int && target_width > 0
    | fail(#'zext, "zext target width must be a positive host Int")
    unless target_width > value.type.width
    | fail(#'zext, "zext target width must be larger than the source width")
    build_value_operation(design,
                          module_def,
                          "rtl.zext",
                          [value],
                          Bits(target_width),
                          name,
                          location,
                          origin,
                          #'zext,
                          {"target_width": target_width})

  method trunc(module_def,
               value,
               target_width,
               name = #false,
               location = Location(),
               origin = Origin("trunc")):
    ensure_module_in_design(design, module_def, #'trunc)
    ensure_open(module_def, #'trunc)
    ensure_value_in(module_def, value, #'trunc)
    unless bits_type(value.type)
    | fail(#'trunc, "trunc operand must have a Bits type")
    unless target_width is_a Int && target_width > 0
    | fail(#'trunc, "trunc target width must be a positive host Int")
    unless target_width < value.type.width
    | fail(#'trunc, "trunc target width must be smaller than the source width")
    build_value_operation(design,
                          module_def,
                          "rtl.trunc",
                          [value],
                          Bits(target_width),
                          name,
                          location,
                          origin,
                          #'trunc,
                          {"target_width": target_width})

  method register(module_def,
                  name,
                  type,
                  clock,
                  reset = #false,
                  reset_value = #false,
                  location = Location(),
                  origin = Origin("register", name)):
    ensure_module_in_design(design, module_def, #'register)
    ensure_open(module_def, #'register)
    ensure_hardware_name(name, #'register)
    ensure_data_type(type, #'register)
    ensure_value_in(module_def, clock, #'register)
    unless clock_type(clock.type)
    | fail(#'register, "register clock must be Clock")
    unless (reset && reset_value) || (!reset && !reset_value)
    | fail(#'register,
           "synchronous reset and reset value must be supplied together")
    when reset
    | ensure_value_in(module_def, reset, #'register)
      ensure_value_in(module_def, reset_value, #'register)
      unless reset_type(reset.type)
      | fail(#'register, "register reset must be Reset")
      unless data_type(reset_value.type) && type_equal(type, reset_value.type)
      | fail(#'register, "register reset value has the wrong hardware type")
    ensure_unique_hardware_name(module_def, name, #'register)
    ensure_unique_hardware_name(module_def, name ++ ".next", #'register)
    def operation_id = design.fresh_id()
    def current = Value(design.fresh_id(), name, type, module_def, operation_id)
    def next = Place(design.fresh_id(), name ++ ".next", type, module_def, operation_id)
    def operands = if reset | [clock, reset, reset_value] | [clock]
    def operation = Operation(operation_id,
                              if reset | "rtl.register_reset" | "rtl.register",
                              module_def,
                              operands,
                              [current],
                              [next],
                              {"name": name},
                              location,
                              origin)
    for (operand in operands):
      operand.add_user(operation_id)
    module_def.add_value(current)
    module_def.add_place(next)
    module_def.add_operation(operation)
    Register(operation, current, next)

  method instance(module_def,
                  child,
                  name,
                  location = Location(),
                  origin = Origin("instance", name)):
    ensure_module_in_design(design, module_def, #'instance)
    ensure_open(module_def, #'instance)
    ensure_hardware_name(name, #'instance)
    unless child is_a Module && child.finished
    | fail(#'instance, "instance target must be a finished module definition")
    def child_owned = child.design === design && design.modules.find(fun (candidate): candidate === child)
    unless child_owned
    | fail(#'instance, "instance target belongs to a different design")
    ensure_unique_instance_name(module_def, name, #'instance)
    for (port in child.inputs):
      ensure_unique_hardware_name(module_def, name ++ "." ++ port.name, #'instance)
    for (port in child.outputs):
      ensure_unique_hardware_name(module_def, name ++ "." ++ port.name, #'instance)
    def operation_id = design.fresh_id()
    def mutable input_bindings = []
    def mutable output_bindings = []
    def mutable places = []
    def mutable results = []
    for (port in child.inputs):
      def place = Place(design.fresh_id(),
                        name ++ "." ++ port.name,
                        port.type,
                        module_def,
                        operation_id)
      module_def.add_place(place)
      places := places ++ [place]
      input_bindings := input_bindings ++ [Port(port.name, "input", port.type, #false, place)]
    for (port in child.outputs):
      def value = Value(design.fresh_id(),
                        name ++ "." ++ port.name,
                        port.type,
                        module_def,
                        operation_id)
      module_def.add_value(value)
      results := results ++ [value]
      output_bindings := output_bindings ++ [Port(port.name, "output", port.type, value, #false)]
    def operation = Operation(operation_id,
                              "rtl.instance",
                              module_def,
                              [],
                              results,
                              places,
                              {"name": name, "module": child},
                              location,
                              origin)
    module_def.add_operation(operation)
    Instance(operation, child, input_bindings, output_bindings)

  method drive(place,
               value,
               location = Location(),
               origin = Origin("drive")):
    unless place is_a Place
    | fail(#'drive, "drive target must be a hardware Place")
    unless value is_a Value
    | fail(#'drive, "drive source must be a hardware Value")
    def module_def = design.find_module(place.module_id)
    def target_owned = module_def && place.design === design && place.module_def === module_def && module_def.places.find(fun (candidate): candidate === place)
    unless target_owned
    | fail(#'drive, "drive target belongs to a different design")
    ensure_open(module_def, #'drive)
    ensure_place_in(module_def, place, #'drive)
    ensure_value_in(module_def, value, #'drive)
    unless type_equal(place.type, value.type)
    | fail(#'drive, "place and driver must have exactly the same hardware type")
    when place.driver
    | fail(#'drive, "place " ++ place.name ++ " already has a driver")
    place.driver := value
    def operation_id = design.fresh_id()
    def operation = Operation(operation_id,
                              "rtl.drive",
                              module_def,
                              [value],
                              [],
                              [place],
                              {},
                              location,
                              origin)
    value.add_user(operation_id)
    module_def.add_operation(operation)
    #void

  method read(place):
    unless place is_a Place
    | fail(#'read, "read target must be a hardware Place")
    def module_def = design.find_module(place.module_id)
    def target_owned = module_def && place.design === design && place.module_def === module_def && module_def.places.find(fun (candidate): candidate === place)
    unless target_owned
    | fail(#'read, "read target belongs to a different design")
    unless place.driver
    | fail(#'read, "place " ++ place.name ++ " must be driven before it is read")
    place.driver

  method finish(module_def):
    ensure_module_in_design(design, module_def, #'finish)
    ensure_open(module_def, #'finish)
    module_def.finished := #true
    module_def
