#lang rhombus
// Lowers the public RHDL hardware IR to textual CIRCT HW, Comb, and Seq MLIR.

import:
  "ir.rhm" open
  "ops.rhm" open
  "verify.rhm" open

export:
  emit_circt
  emit_module_circt

fun circt_type(type):
  "i" ++ to_string(type.width)

fun value_ref(value):
  def defining_operation = value.module_def.find_operation(value.defining_op_id)
  def schema = defining_operation && schema_for(defining_operation.opcode)
  if schema && (schema.print_form == "input_port" || schema.circt_lowering == "seq.firreg")
  | "%" ++ value.name
  | "%__rhdl_value_" ++ to_string(value.id)

fun emit_constant(operation):
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = hw.constant ",
                to_string(operation.attribute("value")), " : ",
                circt_type(result.type))

fun emit_binary(operation, circt_opcode):
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = ", circt_opcode, " ",
                value_ref(operation.operands[0]), ", ",
                value_ref(operation.operands[1]), " : ",
                circt_type(result.type))

fun emit_register(operation):
  def current = operation.results[0]
  def next = operation.places[0]
  def clock = operation.operands[0]
  def clock_ref = "%__rhdl_clock_" ++ to_string(operation.id)
  def schema = schema_for(operation.opcode)
  def reset_text:
    if schema.type_rule == "register_reset"
    | String.append(" reset sync ",
                    value_ref(operation.operands[1]), ", ",
                    value_ref(operation.operands[2]))
    | ""
  String.append("    ", clock_ref, " = seq.to_clock ", value_ref(clock), "\n",
                "    ", value_ref(current), " = seq.firreg ",
                value_ref(next.driver), " clock ", clock_ref,
                reset_text, " : ", circt_type(current.type))

fun emit_instance(operation):
  def child = operation.attribute("module")
  def instance_name = operation.attribute("name")
  def mutable inputs = []
  def mutable outputs = []
  for (port in child.inputs,
       place in operation.places):
    def input_text:
      String.append(port.name, ": ",
                    value_ref(place.driver), ": ",
                    circt_type(port.type))
    inputs := inputs ++ [input_text]
  for (port in child.outputs):
    outputs := outputs ++ [port.name ++ ": " ++ circt_type(port.type)]
  def result_prefix:
    if operation.results.length() == 0
    | ""
    | String.join(operation.results.map(value_ref), ", ") ++ " = "
  String.append("    ", result_prefix,
                "hw.instance \"", instance_name, "\" @", child.name,
                "(", String.join(inputs, ", "), ") -> (",
                String.join(outputs, ", "), ")")

fun emit_operation(operation):
  def schema = schema_for(operation.opcode)
  match schema && schema.circt_lowering
  | "boundary":
      ""
  | "hw.constant":
      emit_constant(operation)
  | "comb.add":
      emit_binary(operation, schema.circt_lowering)
  | "seq.firreg":
      emit_register(operation)
  | "hw.instance":
      emit_instance(operation)
  | ~else:
      error(~who: #'emit_circt,
            "no CIRCT lowering for operation " ++ operation.opcode)

fun emit_module_circt(module_def):
  def ports:
    module_def.inputs.map(
      fun (port):
        "in %" ++ port.name ++ " : " ++ circt_type(port.type)
    ) ++ module_def.outputs.map(
      fun (port):
        "out " ++ port.name ++ " : " ++ circt_type(port.type)
    )
  def operations:
    module_def.operations.map(emit_operation).filter(~keep: fun (text): text != "")
  def output_values = module_def.outputs.map(fun (port): value_ref(port.place.driver))
  def output_types = module_def.outputs.map(fun (port): circt_type(port.type))
  def output:
    if output_values.length() == 0
    | "    hw.output"
    | String.append("    hw.output ", String.join(output_values, ", "),
                    " : ", String.join(output_types, ", "))
  String.append("  hw.module @", module_def.name,
                "(", String.join(ports, ", "), ") {\n",
                String.join(operations ++ [output], "\n"),
                "\n  }")

fun emit_circt(design):
  verify_design(design)
  String.append("module {\n",
                String.join(design.modules.map(emit_module_circt), "\n\n"),
                "\n}\n")
