#lang rhombus
// Defines the tool-neutral logical block and compound-channel diagram model.

export:
  DiagramPort
  DiagramBlock
  DiagramChannel
  DiagramModule
  DiagramDesign

class DiagramPort(id,
                  name,
                  direction,
                  protocol,
                  backpressured = #false,
                  compound = #false)

class DiagramBlock(id,
                   label,
                   kind,
                   ports,
                   properties = {},
                   child_module = #false,
                   behavior = "combinational")

class DiagramChannel(id,
                     source_block,
                     source_port,
                     destination_block,
                     destination_port,
                     protocol,
                     backpressured = #false,
                     kind = "data",
                     protocol_family = "data")

class DiagramModule(id, name, blocks, channels)

class DiagramDesign(logical, modules):
  method module(name :: String):
    modules.find(fun (module_diagram): module_diagram.name == name)
