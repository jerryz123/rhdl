#lang rhdl
// Implements shared 1RW synchronous RAMs over one lane-masked request flow.

import:
  lib("rhdl/std/read-write.rhdl") open

// Every asserted request is accepted. Each read produces a response exactly
// one cycle later; writes produce none.
sync_circuit SyncRam1RW(depth :: Int, T, n :: Int):
  unless n > 0
  | error(~who: #'SyncRam1RW, "lane count must be a positive host Int")
  def address_width = index_width(depth)
  def Data = Vec(n, T)
  interface port(ReadWritePort(address_width, T, n), ~role: responder)
  sync_mem storage(depth, Data, ~mask_granularity: T.bit_width()):
    read_write
  reg response_valid(~init: Bool(#false))

  storage.read_write.address <== port.request.bits.address
  storage.read_write.enable <== as_bits(port.request.valid)
  storage.read_write.write <== as_bits(port.request.bits.write)
  storage.read_write.write_data <== port.request.bits.data
  storage.read_write.write_mask <== port.request.bits.mask
  response_valid <== port.request.valid & !port.request.bits.write
  port.response.valid <== response_valid
  port.response.bits <== storage.read_write.read_data

export:
  SyncRam1RW
