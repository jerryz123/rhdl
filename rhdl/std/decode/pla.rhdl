#lang rhdl
// Elaborates minimized decode covers as shared two-level combinational logic.

import:
  lib("rhdl/std/decode/espresso.rhdl") open
  lib("rhdl/std/decode/table.rhdl") open

export:
  elaborate_decode_pla

fun balanced_and(nodes):
  cond
  | nodes.length() == 0: bits(1, 1)
  | nodes.length() == 1: nodes[0]
  | ~else:
      def half = (nodes.length() + 1) div 2
      balanced_and(nodes.take(half)) & balanced_and(nodes.drop(half))

fun balanced_or(nodes):
  cond
  | nodes.length() == 0: bits(0, 1)
  | nodes.length() == 1: nodes[0]
  | ~else:
      def half = (nodes.length() + 1) div 2
      balanced_or(nodes.take(half)) ||| balanced_or(nodes.drop(half))

fun elaborate_decode_pla(table :: DecodeTable,
                         pla :: DecodePla,
                         selector :: Hardware.of(table.input_type))
  :: Hardware.of(table.output_type):
  def packed_selector = as_bits(selector)
  def positive = for List (index in 0..pla.input_width):
    packed_selector[index]
  def negative = positive.map(fun (bit): !bit)
  def products = for List (term in pla.terms):
    def cared_indices = (for List (index in 0..pla.input_width): index).filter(
      ~keep: fun (index): (term.input_care bits.and (1 bits.(<<) index)) != 0
    )
    def literals = for List (index in cared_indices):
      if (term.input_value bits.and (1 bits.(<<) index)) != 0
      | positive[index]
      | negative[index]
    balanced_and(literals)
  def output_bits = for List (index in 0..pla.output_width):
    def mutable selected_products = []
    for (term in pla.terms, product in products):
      if (term.output_ones bits.and (1 bits.(<<) index)) != 0
      | selected_products := selected_products ++ [product]
      | #void
    balanced_or(selected_products)
  def packed_output:
    if pla.output_width == 1
    | output_bits[0]
    | concat(output_bits.reverse())
  def concrete_output:
    if pla.invert_mask == 0
    | packed_output
    | packed_output ^ bits(pla.invert_mask, pla.output_width)
  cast(concrete_output, table.output_type)
