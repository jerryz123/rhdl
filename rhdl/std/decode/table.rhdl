#lang rhdl
// Defines validated, unordered host-side decode relations over typed Patterns.

import:
  rhombus/meta open
  lib("rhdl/std/decode/pattern.rhdl") open

export:
  DecodeCase
  DecodeTable
  decode_groups
  lift_decode_inputs
  zip_decode_cases

fun exact_type_equal(left, right):
  left.type_equal(right) && right.type_equal(left)

fun require_pattern(value, role, who):
  unless value is_a Pattern
  | error(~who: who, role ++ " must be a Pattern")
  value

class DecodeCase(input, output):
  constructor (input, output):
    require_pattern(input, "decode input", #'DecodeCase)
    require_pattern(output, "decode output", #'DecodeCase)
    super(input, output)

fun require_decode_cases(cases, role, who):
  unless cases is_a List && cases.length() > 0
  | error(~who: who, role ++ " must be a nonempty List")
  for (case in cases, index in 0..cases.length()):
    unless case is_a DecodeCase
    | error(~who: who,
            role ++ " element " ++ to_string(index) ++ " must be a DecodeCase")
  cases

fun exact_pattern_equal(left, right):
  exact_type_equal(left.type, right.type) && left.width == right.width && left.value_bits == right.value_bits && left.care_bits == right.care_bits

// Explicitly embeds every input cube into a new domain while preserving each
// output cube. DecodeTable remains responsible for type and overlap checks.
fun lift_decode_inputs(cases, lift):
  def checked_cases = require_decode_cases(
    cases,
    "lifted decode cases",
    #'lift_decode_inputs
  )
  unless lift is_a Function
  | error(~who: #'lift_decode_inputs,
          "decode input lift must be a Function")
  for List (case in checked_cases):
    DecodeCase(as_pattern(lift(case.input)), case.output)

// Forms an output product from two relations with exactly the same input
// cubes. Row order is irrelevant; missing or duplicate counterparts are errors.
fun zip_decode_cases(left_cases, right_cases, combine):
  def left = require_decode_cases(
    left_cases,
    "left decode cases",
    #'zip_decode_cases
  )
  def right = require_decode_cases(
    right_cases,
    "right decode cases",
    #'zip_decode_cases
  )
  unless left.length() == right.length()
  | error(~who: #'zip_decode_cases,
          "zipped decode relations must have the same number of input cubes")
  unless combine is_a Function
  | error(~who: #'zip_decode_cases,
          "decode output combiner must be a Function")
  for (case in left):
    unless right.filter(
      ~keep: fun (candidate): exact_pattern_equal(case.input, candidate.input)
    ).length() == 1
    | error(~who: #'zip_decode_cases,
            "each left input cube must have exactly one right counterpart")
  for (case in right):
    unless left.filter(
      ~keep: fun (candidate): exact_pattern_equal(case.input, candidate.input)
    ).length() == 1
    | error(~who: #'zip_decode_cases,
            "each right input cube must have exactly one left counterpart")
  for List (left_case in left):
    def right_case = right.find(
      fun (candidate): exact_pattern_equal(left_case.input, candidate.input)
    )
    DecodeCase(
      left_case.input,
      as_pattern(combine(left_case.output, right_case.output))
    )

fun build_decode_group(inputs, output, input_pattern):
  unless inputs is_a List && inputs.length() > 0
  | error(~who: #'decode_groups,
          "decode group inputs must be a nonempty List")
  unless input_pattern is_a Function
  | error(~who: #'decode_groups,
          "decode group input adapter must be a Function")
  for List (input in inputs):
    DecodeCase(as_pattern(input_pattern(input)), output)

fun flatten_decode_groups(groups):
  def mutable cases = []
  for (group in groups):
    cases := cases ++ group
  cases

// Constructs ordinary DecodeCase values from grouped input descriptions and
// sparse record output patterns. The optional adapter remains ordinary host
// code and lets domain libraries translate their descriptors into Patterns.
meta:
  syntax_class SparseDecodeGroup:
    kind: ~group
  | '[$input, ...]:
       $(field_name :: Identifier): $field_value
       ...':
      field expand:
        fun (output_type, input_pattern):
          'build_decode_group(
             [$input, ...],
             (partial_pattern($output_type):
                $field_name: $field_value
                ...),
             $input_pattern
           )'

expr.macro
| 'decode_groups($output_type):
     $(row :: SparseDecodeGroup)
     ...':
    let [group, ...] = [row.expand(output_type, #'as_pattern), ...]
    'flatten_decode_groups([$group, ...])'
| 'decode_groups($output_type, ~input: $input_pattern):
     $(row :: SparseDecodeGroup)
     ...':
    let [group, ...] = [row.expand(output_type, input_pattern), ...]
    'flatten_decode_groups([$group, ...])'

class DecodeTable(cases,
                  default,
                  input_type,
                  output_type,
                  input_width,
                  output_width,
                  packed_cases):
  constructor (supplied_cases, ~default: supplied_default):
    unless supplied_cases is_a List && supplied_cases.length() > 0
    | error(~who: #'DecodeTable,
            "decode cases must be a nonempty List of DecodeCase values")
    def default = require_pattern(supplied_default,
                                  "decode default",
                                  #'DecodeTable)
    for (case in supplied_cases, index in 0..supplied_cases.length()):
      unless case is_a DecodeCase
      | error(~who: #'DecodeTable,
              "decode case " ++ to_string(index) ++ " must be a DecodeCase")
    def first = supplied_cases[0]
    def input_type = first.input.type
    def output_type = default.type
    for (case in supplied_cases, index in 0..supplied_cases.length()):
      def input_matches = exact_type_equal(case.input.type, input_type) && case.input.width == first.input.width
      unless input_matches
      | error(~who: #'DecodeTable,
              String.append("decode case ", to_string(index),
                            " input must have exactly the table input type"))
      def output_matches = exact_type_equal(case.output.type, output_type) && case.output.width == default.width
      unless output_matches
      | error(~who: #'DecodeTable,
              String.append("decode case ", to_string(index),
                            " output must have exactly the default output type"))
    for (left_index in 0..supplied_cases.length()):
      for (right_index in (left_index + 1)..supplied_cases.length()):
        def overlap = supplied_cases[left_index].input.overlaps(supplied_cases[right_index].input)
        if overlap
        | error(~who: #'DecodeTable,
                String.append("decode cases ", to_string(left_index), " and ",
                              to_string(right_index), " overlap"))
        | #void
    def packed_cases:
      supplied_cases.map(
        fun (case):
          [case.input.value_bits,
           case.input.care_bits,
           case.output.value_bits,
           case.output.care_bits]
      )
    super(supplied_cases,
          default,
          input_type,
          output_type,
          first.input.width,
          default.width,
          packed_cases)
