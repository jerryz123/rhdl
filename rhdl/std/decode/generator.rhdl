#lang rhdl
// Defines callable DecodeGen values with optional Espresso PLA minimization.

import:
  lib("rhdl/std/decode/pattern.rhdl") open
  lib("rhdl/std/decode/table.rhdl") open
  lib("rhdl/std/decode/espresso.rhdl") open
  lib("rhdl/std/decode/pla.rhdl") open

export:
  DecodeResult
  DecodeGen
  ValidDecodeGen

bundle DecodeResult(T):
  valid: Bool
  value: T

fun elaborate_decode(table :: DecodeTable,
                     plan,
                     selector :: Hardware.of(table.input_type))
  :: Hardware.of(table.output_type):
  if plan is_a DecodePla
  | elaborate_decode_pla(table, plan, selector)
  | hw_decode(selector,
              table.input_type,
              table.output_type,
              table.packed_cases,
              table.default.value_bits,
              table.default.care_bits)

class DecodeGen(table, plan):
  implements Callable
  constructor (cases, ~default, ~espresso: espresso = #'auto):
    def table = DecodeTable(cases, ~default)
    super(table, make_decode_plan(table, ~espresso: espresso))

  // Method annotations cannot depend on receiver fields, so the callable
  // surface states the packable category and delegates its exact relation.
  override method call(selector :: Hardware.packable) :: Hardware.packable:
    elaborate_decode(table, plan, selector)

// Turns a nonempty decode relation into a partial hardware function. Matched
// cases assert valid; the unmatched value is unconstrained synthesis freedom.
fun ValidDecodeGen(cases :: NonemptyList.of(DecodeCase)):
  def output_type = cases[0].output.type
  def result_type = DecodeResult(output_type)
  def wrapped_cases = for List (case in cases):
    DecodeCase(
      case.input,
      pattern(result_type):
        valid: Bool(#true)
        value: case.output
    )
  DecodeGen(
    wrapped_cases,
    ~default: (pattern(result_type):
                 valid: Bool(#false)
                 value: _)
  )
