#lang rhdl
// Defines callable DecodeGen host values that elaborate one typed core decode.

import:
  lib("rhdl/std/decode/table.rhdl") open

export:
  DecodeGen

class DecodeGen(table):
  implements Callable
  constructor (cases, ~default):
    super(DecodeTable(cases, ~default))

  override method call(selector) :: Hardware:
    hw_decode(selector,
              table.input_type,
              table.output_type,
              table.packed_cases,
              table.default.value_bits,
              table.default.care_bits)
