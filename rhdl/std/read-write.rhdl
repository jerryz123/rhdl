#lang rhdl
// Defines one addressed read-or-write Valid flow over replicated data lanes.

import:
  lib("rhdl/std/ready-valid.rhdl") open

fun checked_lane_count(n :: Int):
  unless n > 0
  | error(~who: #'ReadWritePort, "lane count must be a positive host Int")
  n

bundle ReadWriteRequest(address_width :: Int, T, n :: Int):
  address: Bits(address_width)
  write: Bool
  data: Vec(checked_lane_count(n), T)
  mask: Bits(checked_lane_count(n))

// One request denotes either a read or a write. Response data is meaningful
// only for reads; the implementing component defines response timing.
interface ReadWritePort(address_width :: Int, T, n :: Int):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Valid(ReadWriteRequest(address_width, T, n))

  responder -> requester:
    response: Valid(Vec(checked_lane_count(n), T))

export:
  ReadWriteRequest
  ReadWritePort
