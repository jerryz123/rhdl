#lang rhdl
// Defines power-of-two, alignment, byte-mask, and masked-merge utilities for Bits.

import:
  rhombus/meta open

fun power_of_two(value :: Any):
  value is_a PosInt && (value bits.and (value - 1)) == 0

annot.macro 'Pow2Int':
  'PosInt && satisfying(power_of_two)'

fun unsigned_value_count(width :: Nat):
  1 << width

fun unchecked_alignment_bits(alignment :: PosInt):
  fun loop(value :: PosInt, bits :: Nat):
    if value == 1
    | bits
    | loop(value / 2, bits + 1)
  loop(alignment, 0)

fun alignment_bits(alignment :: Pow2Int):
  unchecked_alignment_bits(alignment)

fun checked_alignment_width(value :: Hardware.bits,
                            alignment :: Pow2Int,
                            who :: Any):
  def width = hardware_value_type(value).bit_width()
  def low_width = unchecked_alignment_bits(alignment)
  unless low_width <= width
  | error(~who: who, "alignment must fit the Bits width")
  values(width, low_width)

fun is_aligned(value :: Hardware.bits, alignment :: Pow2Int) :~ Bool:
  def (_width, low_width) = checked_alignment_width(
    value,
    alignment,
    #'is_aligned
  )
  if low_width == 0
  | Bool(#true)
  | !or_reduce(value[0..low_width])

fun align_down(value :: Hardware.bits,
               alignment :: Pow2Int) :~ Bits(value.type.bit_width()):
  def (width, _low_width) = checked_alignment_width(
    value,
    alignment,
    #'align_down
  )
  if alignment == 1
  | value
  | value & bits((1 << width) - alignment, width)

fun masked_merge(original :: Hardware.bits,
                 replacement :: Hardware.bits,
                 mask :: Hardware.bits) :~ Bits(hardware_value_type(original).bit_width()):
  (original & !mask) ||| (replacement & mask)

// Produces one enable bit per byte of a power-of-two beat. Size is the
// log2(bytes) transfer encoding used by byte-addressed bus protocols.
// Transfers wider than the beat produce the all-zero mask.
fun transfer_byte_mask(address :: Hardware.bits,
                       size :: Hardware.bits,
                       beat_bytes :: Pow2Int) :~ Bits(beat_bytes):
  def (_width, lane_width) = checked_alignment_width(
    address,
    beat_bytes,
    #'transfer_byte_mask
  )
  def max_size = alignment_bits(beat_bytes)
  def base_mask = mux_lookup(
    size,
    ~default: bits(0, beat_bytes),
    for List (encoded_size in 0..(max_size + 1)):
      [encoded_size,
       bits((1 << (1 << encoded_size)) - 1, beat_bytes)]
  )
  def lane_offset:
    if lane_width == 0 | bits(0, 1) | address[0..lane_width]
  base_mask << lane_offset

export:
  Pow2Int
  power_of_two
  unsigned_value_count
  alignment_bits
  is_aligned
  align_down
  masked_merge
  transfer_byte_mask
