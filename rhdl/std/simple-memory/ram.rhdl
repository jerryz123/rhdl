#lang rhdl
// Implements a finite SimpleMemory region with one masked synchronous RAM port.

import:
  lib("rhdl/std/simple-memory.rhdl") open
  lib("rhdl/std/ready-valid.rhdl").fire
  lib("rhdl/std/flow/queue.rhdl").Queue
  lib("rhdl/std/flow/pipe.rhdl").pipe

fun checked_region(address_width :: Int,
                   data_bytes :: Int,
                   size_bytes :: Int,
                   base_address :: Int):
  // Constructing the protocol type first centralizes its width validation.
  def _protocol = SimpleMemory(address_width, data_bytes)
  unless size_bytes > 0
  | error(~who: #'SimpleMemoryRam,
          "size must be a positive host byte count")
  unless size_bytes mod data_bytes == 0
  | error(~who: #'SimpleMemoryRam,
          "size must be a multiple of the data byte count")
  unless base_address >= 0 && base_address mod data_bytes == 0
  | error(~who: #'SimpleMemoryRam,
          "base address must be a nonnegative aligned host Int")
  def address_limit = 1 bits.(<<) address_width
  unless (base_address + size_bytes) <= address_limit
  | error(~who: #'SimpleMemoryRam,
          "memory region must fit in the address width")
  #void

// Out-of-region or misaligned requests remain unaccepted because SimpleMemory
// deliberately has no error response. A compliant requester presents only
// addresses inside this module's region.
sync_circuit SimpleMemoryRam(address_width :: Int,
                             data_bytes :: Int,
                             size_bytes :: Int,
                             ~base_address: base_address :: Int = 0):
  checked_region(address_width,
                 data_bytes,
                 size_bytes,
                 base_address)
  def outstanding_limit = 2
  def depth = size_bytes / data_bytes
  def data_width = data_bytes * 8
  def word_address_width = index_width(depth)
  def low_width = simple_memory_alignment_bits(data_bytes)
  def address_limit = 1 bits.(<<) address_width
  def upper_address = base_address + size_bytes

  interface port(SimpleMemory(address_width, data_bytes), ~role: responder)

  sync_mem storage(depth,
                   Bits(data_width),
                   ~mask_granularity: 8):
    read_write

  def count_width = index_width(outstanding_limit + 1)
  reg outstanding(~init: bits(0, count_width))
  reg operation_valid(~init: Bool(#false))
  reg operation_write(~init: Bool(#false))

  def request_address = port.request.bits.address
  def relative_address = request_address - bits(base_address, address_width)
  def word_address:
    if (depth == 1)
    | bits(0, word_address_width)
    | extract(relative_address,
              (low_width + word_address_width) - 1,
              low_width)
  def below_upper:
    if (upper_address == address_limit)
    | Bool(#true)
    | request_address < bits(upper_address, address_width)
  def in_region = (request_address >= bits(base_address, address_width)) and below_upper
  def address_allowed:
    in_region and memory_address_aligned(request_address, data_bytes)
  // A response slot is reserved when its request transfers. The response FIFO
  // can therefore always accept the non-stallable result one cycle later.
  def full = outstanding === bits(outstanding_limit, count_width)

  def ResponseQueue = Queue(SimpleMemoryResp(data_bytes),
                            outstanding_limit,
                            ~pipe: #true)
  inst responses(ResponseQueue)
  def buffered_response = responses.egress |> pipe(_, 1)
  port.response <=> buffered_response

  def response_fire = fire(port.response)
  port.request.ready <== address_allowed and ((not full) or response_fire)
  def request_fire = fire(port.request)

  storage.read_write.address <== word_address
  storage.read_write.enable <== request_fire.into(Bits(1))
  storage.read_write.write <== port.request.bits.write.into(Bits(1))
  storage.read_write.write_data <== port.request.bits.data
  storage.read_write.write_mask <== port.request.bits.mask

  // Reads and writes both enter the response queue one cycle after request
  // transfer. Equal latency preserves order across mixed operation kinds.
  operation_valid.next <== request_fire
  when request_fire:
    operation_write.next <== port.request.bits.write
  def produced_data:
    mux(operation_write,
        bits(0, data_width),
        storage.read_write.read_data)
  responses.ingress.valid <== operation_valid
  responses.ingress.bits.data <== produced_data

  def next_outstanding:
    mux(request_fire,
        outstanding + bits(1, count_width),
        outstanding - bits(1, count_width))
  when (request_fire xor response_fire):
    outstanding.next <== next_outstanding

export:
  SimpleMemoryRam
