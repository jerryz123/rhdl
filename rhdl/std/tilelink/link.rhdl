#lang rhdl
// Composes TileLink payloads into uncached and cached directional links.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/tilelink/params.rhdl") open
  lib("rhdl/std/tilelink/bundles.rhdl") open

// TileLink permits an unaccepted first beat to be withdrawn or replaced, so
// protocol channels use Decoupled rather than the stronger Irrevocable.
interface TLUncached(p :: TLBundleParams):
  role client
  role manager
  provider client

  client -> manager:
    a: Decoupled(TLChannelA(p))

  manager -> client:
    d: Decoupled(TLChannelD(p))

interface TLCached(p :: TLBundleParams):
  role client
  role manager
  provider client

  client -> manager:
    a: Decoupled(TLChannelA(p))
    c: Decoupled(TLChannelC(p))
    e: Decoupled(TLChannelE(p))

  manager -> client:
    b: Decoupled(TLChannelB(p))
    d: Decoupled(TLChannelD(p))

export:
  TLUncached
  TLCached
