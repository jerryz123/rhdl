#lang rhdl
// Lowers validated NoC route rows into a deterministic combinational hardware lookup.

import:
  lib("rhdl/std/decode.rhdl") open
  "../../../noc/model/main.rhm" open
  "../../../noc/plan/validated-routing.rhm" open

export:
  RouteComputerEntry
  RouteComputerABI
  RouteComputer

fun list_index(items, predicate, who, description):
  def mutable found = #false
  for (item in items, index in 0..items.length()):
    if predicate(item)
    | found := index
    | #void
  unless found != #false
  | error(~who: who, "unknown " ++ description)
  found

fun origin_equal(left, right):
  cond
  | left is_a Injection && right is_a Injection:
      node_id_equal(left.node, right.node)
  | left is_a HeldVC && right is_a HeldVC:
      vc_id_equal(left.vc, right.vc)
  | ~else: #false

class RouteComputerEntry(route_row,
                         route_key,
                         origin_key,
                         encoded_key,
                         allowed_mask):
  method result_bits():
    (allowed_mask bits.(<<) 2) + (if route_row.eject | 2 | 0) + 1

  method describe():
    String.append("key=", to_string(encoded_key), ": ",
                  route_row.describe(), "; mask=",
                  to_string(allowed_mask))

class RouteComputerABI(validated_routing,
                       route_classes,
                       virtual_channels,
                       route_width,
                       origin_width,
                       key_width,
                       vc_count,
                       entries):
  constructor (validated_routing):
    unless validated_routing is_a ValidatedRouting
    | error(~who: #'RouteComputerABI,
            "route-computer generation requires ValidatedRouting")
    def route_classes = validated_routing.route_classes
    def virtual_channels = validated_routing.topology.virtual_channels()
    unless virtual_channels.length() > 0
    | error(~who: #'RouteComputerABI,
            "route-computer generation requires at least one virtual channel")
    def route_width = index_width(route_classes.length())
    // Zero denotes injection. A held VC uses one plus its global stable index.
    def origin_width = index_width(virtual_channels.length() + 1)
    def key_width = route_width + origin_width
    def mutable entries = []
    for (row in validated_routing.route_table.rows):
      def route_key = list_index(
        route_classes,
        fun (route_class): route_class_id_equal(route_class.id, row.route_class.id),
        #'RouteComputerABI,
        "route class in validated route table"
      )
      def origin_key:
        cond
        | row.origin is_a Injection: 0
        | row.origin is_a HeldVC:
            list_index(
              virtual_channels,
              fun (vc): vc_id_equal(vc, row.origin.vc),
              #'RouteComputerABI,
              "held VC in validated route table"
            ) + 1
        | ~else:
            error(~who: #'RouteComputerABI,
                  "validated route-table origin must be injection or a held VC")
      def mutable allowed_mask = 0
      for (vc in row.allowed_vcs):
        def bit = list_index(
          virtual_channels,
          fun (candidate): vc_id_equal(candidate, vc),
          #'RouteComputerABI,
          "allowed VC in validated route table"
        )
        allowed_mask := allowed_mask bits.or (1 bits.(<<) bit)
      entries := entries ++ [
        RouteComputerEntry(
          row,
          route_key,
          origin_key,
          (route_key bits.(<<) origin_width) + origin_key,
          allowed_mask
        )
      ]
    super(validated_routing,
          route_classes,
          virtual_channels,
          route_width,
          origin_width,
          key_width,
          virtual_channels.length(),
          entries)

  method route_key(route_class):
    unless route_class is_a RouteClass
    | error(~who: #'RouteComputerABI, "route key requires a RouteClass")
    list_index(
      route_classes,
      fun (candidate): route_class_id_equal(candidate.id, route_class.id),
      #'RouteComputerABI,
      "route class"
    )

  method origin_key(origin):
    cond
    | origin is_a Injection: 0
    | origin is_a HeldVC:
        list_index(
          virtual_channels,
          fun (candidate): vc_id_equal(candidate, origin.vc),
          #'RouteComputerABI,
          "held VC"
        ) + 1
    | ~else:
        error(~who: #'RouteComputerABI,
              "route-computer origin must be injection or a held VC")

  method vc_bit(vc):
    list_index(
      virtual_channels,
      fun (candidate): vc_id_equal(candidate, vc),
      #'RouteComputerABI,
      "virtual channel"
    )

  method encode(route_class, origin):
    def encoded_route = route_key(route_class)
    if origin is_a Injection
    | block:
        unless node_id_equal(origin.node, route_class.source)
        | error(~who: #'RouteComputerABI,
                "injection origin must equal the route-class source")
    | #void
    (encoded_route bits.(<<) origin_width) + origin_key(origin)

  method entry(route_class, origin):
    entries.find(
      fun (candidate):
        route_class_id_equal(candidate.route_row.route_class.id,
                             route_class.id) && origin_equal(
          candidate.route_row.origin,
          origin
        )
    )

  method entry_for_keys(route_key, origin_key):
    entries.find(
      fun (candidate):
        (candidate.route_key == route_key) && (candidate.origin_key == origin_key)
    )

  method decoder(~espresso: espresso = #'auto):
    def result_width = vc_count + 2
    def cases = entries.map(
      fun (entry):
        DecodeCase(
          pattern(Bits(key_width), bits(entry.encoded_key, key_width)),
          pattern(Bits(result_width), bits(entry.result_bits(), result_width))
        )
    )
    DecodeGen(
      cases,
      ~default: pattern(Bits(result_width), bits(0, result_width)),
      ~espresso: espresso
    )

circuit RouteComputer(abi, ~espresso: espresso = #'auto):
  unless abi is_a RouteComputerABI
  | error(~who: #'RouteComputer, "expected a RouteComputerABI")

  input route_key: Bits(abi.route_width)
  input origin_key: Bits(abi.origin_width)
  output allowed_mask: Bits(abi.vc_count)
  output eject: Bits(1)
  output valid: Bits(1)

  def result = abi.decoder(~espresso: espresso)(concat(route_key, origin_key))
  allowed_mask <== extract(result, abi.vc_count + 1, 2)
  eject <== extract(result, 1, 1)
  valid <== extract(result, 0, 0)
