#lang rhdl
// Lowers one validated router plan into a local combinational route lookup.

import:
  lib("rhdl/std/decode.rhdl") open
  "../../../noc/model/main.rhm" open
  "../../../noc/plan/router-plan.rhm" open

export:
  RouteComputerEntry
  RouteComputerABI
  RouteComputer

class RouteComputerEntry(plan_row,
                         route_key,
                         origin_key,
                         encoded_key,
                         allowed_mask):
  method result_bits():
    (allowed_mask bits.(<<) 2) + (
      if plan_row.route_row.eject | 2 | 0
    ) + 1

  method describe():
    String.append("key=", to_string(encoded_key), ": ",
                  plan_row.route_row.describe(), "; local-mask=",
                  to_string(allowed_mask))

class RouteComputerABI(router_plan,
                       route_classes,
                       origins,
                       output_vcs,
                       route_width,
                       origin_width,
                       key_width,
                       output_count,
                       mask_width,
                       entries):
  constructor (router_plan :: RouterPlan):
    unless router_plan.rows.length() > 0
    | error(~who: #'RouteComputerABI,
            "route-computer generation requires at least one local route row")
    def route_classes = router_plan.route_classes
    def origins = router_plan.origins
    def output_vcs = router_plan.output_vcs
    def route_width = index_width(route_classes.length())
    def origin_width = index_width(origins.length())
    def key_width = route_width + origin_width
    def output_count = output_vcs.length()
    // RHDL has no zero-width Bits value. An ejection-only router therefore
    // carries one constant-zero padding bit without inventing an output VC.
    def mask_width = if output_count > 0 | output_count | 1
    def entries = router_plan.rows.map(
      fun (row):
        RouteComputerEntry(
          row,
          row.route_key,
          row.origin_key,
          (row.route_key bits.(<<) origin_width) + row.origin_key,
          row.allowed_mask
        )
    )
    super(router_plan,
          route_classes,
          origins,
          output_vcs,
          route_width,
          origin_width,
          key_width,
          output_count,
          mask_width,
          entries)

  method route_key(route_class):
    router_plan.route_key(route_class)

  method origin_key(origin):
    router_plan.origin_key(origin)

  method output_bit(vc):
    router_plan.output_bit(vc)

  method encode(route_class, origin):
    def encoded_route = route_key(route_class)
    if origin is_a Injection
    | block:
        unless node_id_equal(origin.node, route_class.source)
        | error(~who: #'RouteComputerABI,
                "injection origin must equal the route-class source")
    | #void
    (encoded_route bits.(<<) origin_width) + origin_key(origin)

  method entry(route_class, origin):
    def encoded_key = encode(route_class, origin)
    entries.find(
      fun (candidate): candidate.encoded_key == encoded_key
    )

  method entry_for_keys(route_key, origin_key):
    entries.find(
      fun (candidate):
        (candidate.route_key == route_key) && (candidate.origin_key == origin_key)
    )

  method decoder(~espresso: espresso = #'auto):
    def result_width = mask_width + 2
    def cases = entries.map(
      fun (entry):
        DecodeCase(
          pattern(Bits(key_width), bits(entry.encoded_key, key_width)),
          pattern(Bits(result_width), bits(entry.result_bits(), result_width))
        )
    )
    DecodeGen(
      cases,
      ~default: pattern(Bits(result_width), bits(0, result_width)),
      ~espresso: espresso
    )

circuit RouteComputer(abi :: RouteComputerABI, ~espresso: espresso = #'auto):

  input route_key: Bits(abi.route_width)
  input origin_key: Bits(abi.origin_width)
  output allowed_mask: Bits(abi.mask_width)
  output eject: Bits(1)
  output valid: Bits(1)

  def result :: Bits(abi.mask_width + 2) = abi.decoder(~espresso: espresso)(concat(route_key, origin_key))
  allowed_mask <== result[2..(abi.mask_width + 2)]
  eject <== result[1]
  valid <== result[0]
