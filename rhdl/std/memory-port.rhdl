#lang rhdl
// Defines a one-outstanding aligned byte-masked memory transaction protocol.

fun power_of_two(value :: Int):
  value > 0 && (value and (value - 1)) == 0

fun alignment_bits(data_bytes :: Int):
  fun loop(bytes, bits):
    if (bytes == 1)
    | bits
    | loop(bytes / 2, bits + 1)
  loop(data_bytes, 0)

fun checked_address_type(address_width :: Int, data_bytes :: Int):
  unless address_width > 0
  | error(~who: #'MemoryPort,
          "address width must be a positive host Int")
  unless data_bytes > 0
  | error(~who: #'MemoryPort,
          "data byte count must be a positive host Int")
  unless power_of_two(data_bytes)
  | error(~who: #'MemoryPort,
          "data byte count must be a power of two")
  unless address_width >= alignment_bits(data_bytes)
  | error(~who: #'MemoryPort,
          "address width must cover the data alignment bits")
  Bits(address_width)

// The requester presents one stable aligned byte-addressed request until it
// transfers. The responder returns exactly one stable response before another
// request can be outstanding. Response data is meaningful only for reads.
interface MemoryPort(address_width :: Int, data_bytes :: Int):
  role requester
  role responder

  requester -> responder:
    request_valid: Bool
    request_address: checked_address_type(address_width, data_bytes)
    request_write: Bool
    request_data: Bits(data_bytes * 8)
    request_mask: Bits(data_bytes)
    response_ready: Bool

  responder -> requester:
    request_ready: Bool
    response_valid: Bool
    response_data: Bits(data_bytes * 8)

// Checks the behavioral address-alignment obligation without changing the
// byte-address representation used by software images and processors.
fun memory_address_aligned(address,
                           data_bytes :: Int) :~ Bool:
  unless data_bytes > 0 && power_of_two(data_bytes)
  | error(~who: #'memory_address_aligned,
          "data byte count must be a positive power of two")
  def low_width = alignment_bits(data_bytes)
  if (low_width == 0)
  | Bool(#true)
  | extract(address, low_width - 1, 0) === bits(0, low_width)

export:
  MemoryPort
  memory_address_aligned
