#lang rhdl
// Defines RHDL's canonical valid-only and ready-valid protocol interfaces.

// Every cycle with valid asserted carries one payload; there is no
// backpressure signal or pending-transfer state.
interface Valid(T):
  role producer
  role consumer

  producer -> consumer:
    valid: Bool
    bits: T

// Transfer occurs when ready and valid are both asserted. Before transfer,
// either endpoint may withdraw its indication and the producer may change bits.
interface Decoupled(T):
  role producer
  role consumer

  producer -> consumer:
    valid: Bool
    bits: T

  consumer -> producer:
    ready: Bool

// Irrevocable has Decoupled's wire shape but a stronger temporal contract:
// an offered payload remains valid and stable until it transfers. This
// contract is documented but not yet enforced by generated assertions.
interface Irrevocable(T):
  role producer
  role consumer

  producer -> consumer:
    valid: Bool
    bits: T

  consumer -> producer:
    ready: Bool

// Extracts the payload type used by flow-control helpers. The subsequent bulk
// connection still performs the complete nominal type and direction check.
fun decoupled_payload_type(endpoint :: Endpoint):
  unless endpoint.type.name == "Decoupled"
  | error(~who: #'decoupled_payload_type,
          "flow-control chaining requires a Decoupled endpoint")
  endpoint.type.members.find(
    fun (member): member.name == "bits"
  ).type

export:
  Valid
  Decoupled
  Irrevocable
  decoupled_payload_type
