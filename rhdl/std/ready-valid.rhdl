#lang rhdl
// Defines RHDL's canonical valid-only and ready-valid protocol interfaces.

// Every cycle with valid asserted carries one payload; there is no
// backpressure signal or pending-transfer state.
interface Valid(T):
  role producer
  role consumer
  provider producer

  producer -> consumer:
    valid: Bool
    bits: T

// The ready-valid family has independent payload and stability axes:
//
// DecoupledCtrl ---- add payload ----> Decoupled(T)
//       |                                  |
//  strengthen                         strengthen
//       v                                  v
// IrrevocableCtrl -- add payload --> Irrevocable(T)
//
// Horizontal refinement adds `bits`; vertical strengthening promises that an
// offered transaction cannot be withdrawn before it is accepted.

// Defines the reusable offer/accept control plane. Transfer occurs whenever
// valid and ready are both asserted in the same cycle.
interface DecoupledCtrl():
  role producer
  role consumer
  provider producer

  producer -> consumer:
    valid: Bool

  consumer -> producer:
    ready: Bool

// Once valid is asserted, the indicated offer cannot be withdrawn until a
// transfer. What the offer denotes is defined by the refining protocol.
interface IrrevocableCtrl() refines DecoupledCtrl()

// Adds an unconstrained payload to the decoupled control plane. Before a
// transfer, the producer may withdraw valid or change bits.
interface Decoupled(T) refines DecoupledCtrl():
  producer -> consumer:
    bits: T

// Adds an explicit payload to the persistent-offer control plane. It also
// supports the weaker Decoupled payload contract for producer-side connection.
// While valid is waiting for ready, both valid and bits remain asserted and
// stable.
interface Irrevocable(T) refines IrrevocableCtrl():
  supports producer: Decoupled(T)
  producer -> consumer:
    bits: T

// Reports the transfer event for any endpoint that nominally refines the
// decoupled control contract.
fun fire(
  endpoint :: Endpoint.supports(DecoupledCtrl())
) :~ Bool:
  endpoint.valid & endpoint.ready

// Extracts the payload type used by flow-control helpers. Both payload-bearing
// ready-valid contracts are accepted; the subsequent bulk connection still
// performs the complete nominal type and direction check.
fun decoupled_payload_type(endpoint :: Endpoint):
  unless endpoint.type.name == "Decoupled" || endpoint.type.name == "Irrevocable"
  | error(~who: #'decoupled_payload_type,
          "flow-control chaining requires a Decoupled or Irrevocable endpoint")
  endpoint.type.members.find(
    fun (member): member.name == "bits"
  ).type

// Validates the payloadless ready-valid family for Ctrl flow helpers while
// retaining the endpoint itself and its static interface information.
fun ctrl_endpoint(endpoint :: Endpoint) :~ Endpoint:
  unless endpoint.type.name == "DecoupledCtrl" || endpoint.type.name == "IrrevocableCtrl"
  | error(~who: #'ctrl_endpoint,
          "control-flow chaining requires a DecoupledCtrl or IrrevocableCtrl endpoint")
  endpoint

export:
  Valid
  DecoupledCtrl
  IrrevocableCtrl
  Decoupled
  Irrevocable
  fire
  decoupled_payload_type
  ctrl_endpoint
