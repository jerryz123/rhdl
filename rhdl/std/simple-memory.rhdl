#lang rhdl
// Defines an ordered multi-outstanding aligned byte-masked memory protocol.

import:
  lib("rhdl/std/ready-valid.rhdl") open

fun power_of_two(value :: Int):
  value > 0 && (value and (value - 1)) == 0

fun simple_memory_alignment_bits(data_bytes :: Int):
  fun loop(bytes, bits):
    if (bytes == 1)
    | bits
    | loop(bytes / 2, bits + 1)
  loop(data_bytes, 0)

fun checked_address_type(address_width :: Int, data_bytes :: Int):
  unless address_width > 0
  | error(~who: #'SimpleMemory,
          "address width must be a positive host Int")
  unless data_bytes > 0
  | error(~who: #'SimpleMemory,
          "data byte count must be a positive host Int")
  unless power_of_two(data_bytes)
  | error(~who: #'SimpleMemory,
          "data byte count must be a power of two")
  unless address_width >= simple_memory_alignment_bits(data_bytes)
  | error(~who: #'SimpleMemory,
          "address width must cover the data alignment bits")
  Bits(address_width)

fun checked_data_type(data_bytes :: Int):
  unless data_bytes > 0
  | error(~who: #'SimpleMemory,
          "data byte count must be a positive host Int")
  unless power_of_two(data_bytes)
  | error(~who: #'SimpleMemory,
          "data byte count must be a power of two")
  Bits(data_bytes * 8)

// Separates the transfer payload from ready-valid control so generic channel
// contracts and flow-control components remain applicable.
bundle SimpleMemoryReq(address_width :: Int, data_bytes :: Int):
  address: checked_address_type(address_width, data_bytes)
  write: Bool
  data: Bits(data_bytes * 8)
  mask: Bits(data_bytes)

bundle SimpleMemoryResp(data_bytes :: Int):
  data: checked_data_type(data_bytes)

// The requester may have multiple accepted requests awaiting responses. The
// responder returns exactly one response per request in request order.
// Response data is meaningful only for reads.
interface SimpleMemory(address_width :: Int, data_bytes :: Int):
  role requester
  role responder

  requester -> responder:
    request: Irrevocable(SimpleMemoryReq(address_width, data_bytes))

  responder -> requester:
    response: Irrevocable(SimpleMemoryResp(data_bytes))

// Checks the behavioral address-alignment obligation without changing the
// byte-address representation used by software images and processors.
fun memory_address_aligned(address,
                           data_bytes :: Int) :~ Bool:
  unless data_bytes > 0 && power_of_two(data_bytes)
  | error(~who: #'memory_address_aligned,
          "data byte count must be a positive power of two")
  def low_width = simple_memory_alignment_bits(data_bytes)
  if (low_width == 0)
  | Bool(#true)
  | extract(address, low_width - 1, 0) === bits(0, low_width)

export:
  SimpleMemoryReq
  SimpleMemoryResp
  SimpleMemory
  simple_memory_alignment_bits
  memory_address_aligned
