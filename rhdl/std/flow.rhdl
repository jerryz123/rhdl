#lang rhdl
// Re-exports Valid and ready-valid generators with generic handle stages.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/stage.rhdl") open
  lib("rhdl/std/flow/pipe.rhdl") open
  lib("rhdl/std/flow/queue.rhdl") open
  lib("rhdl/std/flow/arbiter.rhdl") open
  lib("rhdl/std/flow/rr-arbiter.rhdl") open
  lib("rhdl/std/flow/demux.rhdl") open
  lib("rhdl/std/flow/join.rhdl") open
  lib("rhdl/std/flow/zip.rhdl") open
  lib("rhdl/std/flow/broadcast.rhdl") open
  lib("rhdl/std/flow/atomic-fork.rhdl") open
  lib("rhdl/std/flow/map.rhdl") open
  lib("rhdl/std/flow/filter.rhdl") open
  lib("rhdl/std/flow/gate.rhdl") open
  lib("rhdl/std/flow/parallel.rhdl") open

export:
  Valid
  DecoupledCtrl
  IrrevocableCtrl
  Decoupled
  Irrevocable
  fire
  decoupled_payload_type
  ctrl_endpoint
  Pipe
  pipe
  ValidPipe
  valid_pipe
  CtrlPipe
  ctrl_pipe
  Queue
  queue
  CtrlQueue
  ctrl_queue
  Arbiter
  CtrlArbiter
  RRArbiter
  rr_arbiter
  CtrlRRArbiter
  Demux
  demux_flow
  CtrlDemux
  Join
  CtrlJoin
  zip_flow
  Broadcast
  CtrlBroadcast
  AtomicFork
  atomic_fork
  CtrlAtomicFork
  ctrl_atomic_fork
  map_flow
  filter_flow
  gate_flow
  parallel
