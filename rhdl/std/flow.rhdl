#lang rhdl
// Defines the first standard ready-valid pipe, FIFO queue, and fixed-priority arbiter.

import:
  lib("rhdl/std/ready-valid.rhdl") open

// The stateful primitives hold valid payloads stable under backpressure, but
// use Decoupled ports until nominal protocol refinement is part of connection
// compatibility. Arbiter intentionally permits stalled priority preemption.

// A registered elastic pipeline. Each stage stores one item, contributes one
// cycle of unloaded latency, and propagates readiness combinationally backward.
sync_circuit Pipe(T, stages :: Int):
  unless stages > 0
  | error(~who: #'Pipe, "stages must be a positive host Int")

  interface ingress(Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)

  def initial_valid = vec(
    for List (_ in 0..stages): Bool(#false)
  )
  reg stage_valid(~init: initial_valid)
  reg stage_bits(Vec(stages, T))

  def mutable downstream_ready = egress.ready
  def mutable ready = []
  for (offset in 0..stages):
    def index = stages - offset - 1
    def current_ready = (not stage_valid[index]) or downstream_ready
    ready := [current_ready] ++ ready
    downstream_ready := current_ready

  ingress.ready <== ready[0]
  egress.valid <== stage_valid[stages - 1]
  egress.bits <== stage_bits[stages - 1]

  for (index in 0..stages):
    def upstream_valid:
      if (index == 0)
      | ingress.valid
      | stage_valid[index - 1]
    def upstream_bits:
      if (index == 0)
      | ingress.bits
      | stage_bits[index - 1]
    when (ready[index]):
      stage_valid.next[index] <== upstream_valid
      when (upstream_valid):
        stage_bits.next[index] <== upstream_bits

// A non-flow-through FIFO with asynchronous head read. A full queue can accept
// a replacement item in the same cycle that its current head is consumed.
sync_circuit Queue(T, depth :: Int):
  unless depth > 0
  | error(~who: #'Queue, "depth must be a positive host Int")

  interface ingress(Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)

  if (depth == 1)
  | block:
      reg occupied(~init: Bool(#false))
      reg payload(T)
      def input_ready = (not occupied) or egress.ready
      def enqueue = ingress.valid and input_ready

      ingress.ready <== input_ready
      egress.valid <== occupied
      egress.bits <== payload

      when (input_ready):
        occupied.next <== ingress.valid
      when (enqueue):
        payload.next <== ingress.bits
      #void
  | block:
      def pointer_width = index_width(depth)
      def count_width = index_width(depth + 1)
      mem storage(depth, T)
      reg read_pointer(~init: bits(0, pointer_width))
      reg write_pointer(~init: bits(0, pointer_width))
      reg count(~init: bits(0, count_width))

      def empty = count === bits(0, count_width)
      def full = count === bits(depth, count_width)
      def output_valid = not empty
      def dequeue = output_valid and egress.ready
      def input_ready = (not full) or dequeue
      def enqueue = ingress.valid and input_ready

      ingress.ready <== input_ready
      egress.valid <== output_valid
      egress.bits <== storage[read_pointer]
      storage.write(write_pointer, ingress.bits, ~enable: enqueue)

      fun increment(pointer):
        mux(pointer === bits(depth - 1, pointer_width),
            bits(0, pointer_width),
            pointer + bits(1, pointer_width))

      when (enqueue):
        write_pointer.next <== increment(write_pointer)
      when (dequeue):
        read_pointer.next <== increment(read_pointer)
      when (enqueue and not dequeue):
        count.next <== count + bits(1, count_width)
      elsewhen (dequeue and not enqueue):
        count.next <== count - bits(1, count_width)
      #void

// A combinational fixed-priority arbiter. Lower indices have higher priority;
// a higher-priority arrival may change a stalled Decoupled output selection.
circuit Arbiter(T, n :: Int):
  unless n > 0
  | error(~who: #'Arbiter, "input count must be a positive host Int")

  interface ingress[n](Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)
  output chosen: Bits(index_width(n))

  def mutable selected_bits = ingress[0].bits
  def mutable selected_index = bits(0, index_width(n))
  for (offset in 0..n):
    def index = n - offset - 1
    selected_bits := mux(ingress[index].valid,
                         ingress[index].bits,
                         selected_bits)
    selected_index := mux(ingress[index].valid,
                          bits(index, index_width(n)),
                          selected_index)

  def mutable prior_valid = Bool(#false)
  for (index in 0..n):
    def granted = ingress[index].valid and not prior_valid
    ingress[index].ready <== egress.ready and granted
    prior_valid := prior_valid or ingress[index].valid

  egress.valid <== prior_valid
  egress.bits <== selected_bits
  chosen <== selected_index

export:
  Pipe
  Queue
  Arbiter
