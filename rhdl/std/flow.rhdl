#lang rhdl
// Re-exports the standard ready-valid flow-control circuit generators.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/pipe.rhdl") open
  lib("rhdl/std/flow/queue.rhdl") open
  lib("rhdl/std/flow/arbiter.rhdl") open
  lib("rhdl/std/flow/rr-arbiter.rhdl") open
  lib("rhdl/std/flow/demux.rhdl") open
  lib("rhdl/std/flow/join.rhdl") open
  lib("rhdl/std/flow/broadcast.rhdl") open

export:
  Valid
  DecoupledCtrl
  IrrevocableCtrl
  Decoupled
  Irrevocable
  fire
  decoupled_payload_type
  ctrl_endpoint
  Pipe
  pipe
  CtrlPipe
  ctrl_pipe
  Queue
  queue
  CtrlQueue
  ctrl_queue
  Arbiter
  CtrlArbiter
  RRArbiter
  CtrlRRArbiter
  Demux
  CtrlDemux
  Join
  CtrlJoin
  Broadcast
  CtrlBroadcast
