#lang rhdl
// Defines protocol-neutral flit payload shapes and their structural classifiers.

// A variable-length packet carries explicit boundaries on every flit. The
// payload shape is independent of the transport used to move it.
bundle VariableFlit(T :: DataType):
  head: Bool
  tail: Bool
  payload: T

// A fixed-length packet may retain explicit boundaries for checking and
// resynchronization. Its length is a transfer-sequence contract supplied to
// conversion and monitoring operations, not a wire field.
bundle FramedFixedFlit(T :: DataType):
  first: Bool
  last: Bool
  payload: T

// Fixed-length packets can omit explicit boundaries. Packet phase is then
// determined solely by the number of successful flit transfers.
bundle FixedFlit(T :: DataType):
  payload: T

fun require_fixed_flit_payload_type(type :: DataType):
  unless type is_a RecordType && type.fields.length() == 1 && (
    type.fields[0].name == "payload"
  )
  | error(~who: #'FixedFlit,
          "expected a FixedFlit payload shape")
  type.fields[0].type

fun exact_bool_type(type):
  type.type_equal(Bool) && Bool.type_equal(type)

fun require_variable_flit_payload_type(type :: DataType):
  unless type is_a RecordType && type.fields.length() == 3 && (
    type.fields[0].name == "head"
  ) && (
    type.fields[1].name == "tail"
  ) && (
    type.fields[2].name == "payload"
  ) && exact_bool_type(type.fields[0].type) && exact_bool_type(type.fields[1].type)
  | error(~who: #'VariableFlit,
          "expected a VariableFlit payload shape")
  type.fields[2].type

fun require_framed_fixed_flit_payload_type(type :: DataType):
  unless type is_a RecordType && type.fields.length() == 3 && (
    type.fields[0].name == "first"
  ) && (
    type.fields[1].name == "last"
  ) && (
    type.fields[2].name == "payload"
  ) && exact_bool_type(type.fields[0].type) && exact_bool_type(type.fields[1].type)
  | error(~who: #'FramedFixedFlit,
          "expected a FramedFixedFlit payload shape")
  type.fields[2].type

export:
  VariableFlit
  FramedFixedFlit
  FixedFlit
  require_fixed_flit_payload_type
  require_variable_flit_payload_type
  require_framed_fixed_flit_payload_type
