#lang rhdl
// Defines registered pipelines for Valid and ready-valid protocol families.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/stage.rhdl") open

// Each stage stores one item, contributes one cycle of unloaded latency, and
// propagates readiness combinationally backward. Stored payloads remain stable
// under backpressure.
sync_circuit Pipe(T, stages :: PosInt):

  interface ingress(Decoupled(T), ~role: consumer)
  interface egress(Irrevocable(T), ~role: producer)

  def initial_valid = vec(
    for List (_ in 0..stages): Bool(#false)
  )
  reg stage_valid(~init: initial_valid)
  reg stage_bits(Vec(stages, T))

  def valid_sources = [ingress.valid] ++ (
    for List (index in 0..(stages - 1)): stage_valid[index]
  )
  def bits_sources = [ingress.bits] ++ (
    for List (index in 0..(stages - 1)): stage_bits[index]
  )

  def mutable ready = [egress.ready]
  for (offset in 0..stages):
    def index = stages - offset - 1
    ready := [!stage_valid[index] ||| ready[0]] ++ ready

  ingress.ready <== ready[0]
  egress.valid <== stage_valid[stages - 1]
  egress.bits <== stage_bits[stages - 1]

  for (index in 0..stages):
    when (ready[index]):
      stage_valid[index] <== valid_sources[index]
      when (valid_sources[index]):
        stage_bits[index] <== bits_sources[index]

// Valid has no backpressure: every stage advances on every clock, and each
// asserted input cycle emerges after exactly `stages` cycles.
sync_circuit ValidPipe(T, stages :: PosInt):

  interface ingress(Valid(T), ~role: consumer)
  interface egress(Valid(T), ~role: producer)

  def initial_valid = vec(
    for List (_ in 0..stages): Bool(#false)
  )
  reg stage_valid(~init: initial_valid)
  reg stage_bits(Vec(stages, T))

  def valid_sources = [ingress.valid] ++ (
    for List (index in 0..(stages - 1)): stage_valid[index]
  )
  def bits_sources = [ingress.bits] ++ (
    for List (index in 0..(stages - 1)): stage_bits[index]
  )

  egress.valid <== stage_valid[stages - 1]
  egress.bits <== stage_bits[stages - 1]

  for (index in 0..stages):
    stage_valid.next[index] <== valid_sources[index]
    when (valid_sources[index]):
      stage_bits.next[index] <== bits_sources[index]

// The control-only specialization stores just the validity of each token.
// Its output is irrevocable because an occupied stage cannot withdraw while
// its downstream endpoint is stalled.
sync_circuit CtrlPipe(stages :: PosInt):

  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(IrrevocableCtrl(), ~role: producer)

  def initial_valid = vec(
    for List (_ in 0..stages): Bool(#false)
  )
  reg stage_valid(~init: initial_valid)
  def valid_sources = [ingress.valid] ++ (
    for List (index in 0..(stages - 1)): stage_valid[index]
  )

  def mutable ready = [egress.ready]
  for (offset in 0..stages):
    def index = stages - offset - 1
    ready := [!stage_valid[index] ||| ready[0]] ++ ready

  ingress.ready <== ready[0]
  egress.valid <== stage_valid[stages - 1]

  for (index in 0..stages):
    when (ready[index]):
      stage_valid[index] <== valid_sources[index]

// A payload type constructs an unconnected handle; an endpoint or earlier
// handle connects immediately and returns the remaining far end.
fun pipe(source_or_type, stages :: PosInt):
  def T = flow_payload_type(source_or_type)
  def PipeModule = Pipe(T, stages)
  inst pipe_stage(PipeModule)
  finish_flow_stage(
    source_or_type,
    InterfaceHandle(pipe_stage.ingress, pipe_stage.egress)
  )

fun valid_pipe(source_or_type, stages :: PosInt):
  def T = valid_flow_payload_type(source_or_type)
  def ValidPipeModule = ValidPipe(T, stages)
  inst valid_pipe_stage(ValidPipeModule)
  finish_flow_stage(
    source_or_type,
    InterfaceHandle(valid_pipe_stage.ingress, valid_pipe_stage.egress)
  )

// Control-only chaining keeps exact endpoint static information without
// introducing a dummy payload field.
fun ctrl_pipe(source :: Endpoint, stages :: PosInt) :~ Endpoint:
  def checked = ctrl_endpoint(source)
  inst ctrl_pipe_stage(CtrlPipe(stages))
  ctrl_pipe_stage.ingress <=> checked
  ctrl_pipe_stage.egress

export:
  Pipe
  pipe
  ValidPipe
  valid_pipe
  CtrlPipe
  ctrl_pipe
