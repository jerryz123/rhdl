#lang rhdl
// Defines payload-bearing and control-only fixed-priority arbiters.

import:
  lib("rhdl/std/ready-valid.rhdl") open

// Lower indices have higher priority. The output uses Decoupled because a new
// higher-priority arrival may change the selected payload while stalled.
circuit Arbiter(T, n :: PosInt):

  interface ingress[n](Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(for List (index in 0..n): ingress[index].valid)
  def grants = cast(priority_encoder_oh(requests), Vec(n, Bool))
  def mutable selected_bits = ingress[0].bits
  for (offset in 0..n):
    def index = n - offset - 1
    selected_bits := mux(ingress[index].valid,
                         ingress[index].bits,
                         selected_bits)
  for (index in 0..n):
    ingress[index].ready <== egress.ready & grants[index]

  egress.valid <== or_reduce(requests)
  egress.bits <== selected_bits
  chosen <== priority_encoder(requests)

// Lower indices have higher priority among payloadless token offers.
circuit CtrlArbiter(n :: PosInt):

  interface ingress[n](DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(for List (index in 0..n): ingress[index].valid)
  def grants = cast(priority_encoder_oh(requests), Vec(n, Bool))
  for (index in 0..n):
    ingress[index].ready <== egress.ready & grants[index]

  egress.valid <== or_reduce(requests)
  chosen <== priority_encoder(requests)

export:
  Arbiter
  CtrlArbiter
