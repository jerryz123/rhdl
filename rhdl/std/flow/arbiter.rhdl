#lang rhdl
// Defines payload-bearing and control-only fixed-priority arbiters.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/ready-valid-support.rhdl") open

// Lower indices have higher priority. The output uses Decoupled because a new
// higher-priority arrival may change the selected payload while stalled.
circuit Arbiter(T, n :: PosInt):

  interface ingress[n](Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(for List (index in 0..n): ingress[index].valid)
  def grants = cast(priority_encoder_oh(requests), Vec(n, Bool))
  def mutable selected_bits = ingress[0].bits
  for (offset in 0..n):
    def index = n - offset - 1
    selected_bits := mux(ingress[index].valid,
                         ingress[index].bits,
                         selected_bits)
  for (index in 0..n):
    ingress[index].ready <== egress.ready & grants[index]

  egress.valid <== or_reduce(requests)
  egress.bits <== selected_bits
  chosen <== priority_encoder(requests)

// Lower indices have higher priority among payloadless token offers.
circuit CtrlArbiter(n :: PosInt):

  interface ingress[n](DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(for List (index in 0..n): ingress[index].valid)
  def grants = cast(priority_encoder_oh(requests), Vec(n, Bool))
  for (index in 0..n):
    ingress[index].ready <== egress.ready & grants[index]

  egress.valid <== or_reduce(requests)
  chosen <== priority_encoder(requests)

// A connected endpoint array supplies its input count. A disconnected
// topology starts from a payload type and states the count in arbiter.
fun arbiter(n = #false)
  :: ((source :: Any) -> InterfaceTransformResult(source, Endpoint)):
  fun (source) :~ InterfaceTransformResult(source, Endpoint):
    def inputs:
      if source is_a Handle | source.right | source
    def typed = !(inputs is_a Array)
    def input_count:
      if typed
      | block:
          unless n is_a PosInt
          | error(~who: #'arbiter,
                  "typed fixed-priority arbitration requires a positive input count")
          n
      | block:
          unless inputs.length() > 0
          | error(~who: #'arbiter,
                  "fixed-priority arbitration requires at least one input endpoint")
          if n
          | unless n == inputs.length()
            | error(~who: #'arbiter,
                    "configured input count does not match the endpoint array")
          | #void
          inputs.length()
    def T:
      if typed | source | flow_payload_type(inputs[0])
    inst arbiter_stage(Arbiter(T, input_count))
    finish_interface_transform(
      source,
      InterfaceHandle(arbiter_stage.ingress, arbiter_stage.egress)
    )

export:
  Arbiter
  arbiter
  CtrlArbiter
