#lang rhdl
// Preserves flow-named aliases for the generic interface boundary operations.

fun flow_fields(~& bindings):
  interface_fields(~& bindings)

fun inject_flow(type, ~& bindings) :: Endpoint:
  inject_interface(type, ~& bindings)

fun eject_flow(~& bindings):
  eject_interface(~& bindings)

export:
  flow_fields
  inject_flow
  eject_flow
