#lang rhdl
// Defines inline payload transformation as a generic interface handle.

import:
  rhombus/meta open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/stage.rhdl") open

// Joins two local interface links around direct combinational assignments.
// The links are consumed as components and their outer ends become the new
// handle's ends.
fun finish_map_flow_handle(input_link :: Handle,
                           output_link :: Handle,
                           mapped_bits):
  output_link.left.field("valid") <== input_link.right.field("valid")
  output_link.left.field("bits") <== mapped_bits
  input_link.right.field("ready") <== output_link.left.field("ready")
  input_link.consumed := #true
  output_link.consumed := #true
  InterfaceHandle(input_link.left, output_link.right)

// The first argument may be a payload DataType, producing an unconnected
// handle, or a concrete endpoint, applying that same handle immediately. The
// arrow form keeps a mapping inside ordinary parenthesized pipeline syntax.
// A colon block attached to the call extends an arrow expression such as a
// record constructor; the original binder-block form remains supported.
expr.macro
| 'map_flow($source_or_type,
            $(payload :: Identifier) => $body_head ...):
    $(body_tail :: Block)':
    'map_flow($source_or_type, $payload):
       $body_head ... $body_tail'
| 'map_flow($source_or_type,
            $(payload :: Identifier) => $body ...)':
    'map_flow($source_or_type, $payload): $body ...'
| 'map_flow($source_or_type, $(payload :: Identifier)): $body':
    'block:
       def map_flow_argument = $source_or_type
       def map_flow_input_protocol = flow_protocol_type(map_flow_argument)
       def map_flow_input_type = flow_payload_type(map_flow_argument)
       def map_flow_input_link = interface_link(
         map_flow_input_protocol,
         "map_input"
       )
       def map_flow_input :: Endpoint = map_flow_input_link.right
       def $payload = map_flow_input.bits
       fun compute_mapped_bits(): $body
       def mapped_bits = compute_mapped_bits()
       def map_flow_output_protocol = flow_protocol_with_payload(
         map_flow_input_protocol,
         hardware_value_type(mapped_bits)
       )
       def map_flow_output_link = interface_link(
         map_flow_output_protocol,
         "map_output"
       )
       def map_flow_handle = finish_map_flow_handle(
         map_flow_input_link,
         map_flow_output_link,
         mapped_bits
       )
       finish_flow_stage(map_flow_argument, map_flow_handle)'

export:
  map_flow
