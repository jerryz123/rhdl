#lang rhdl
// Defines payload-bearing and control-only round-robin arbiters.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/stage.rhdl") open

// Priority starts immediately after the most recently transferred input.
// Selection may change while stalled, so the output deliberately remains
// Decoupled rather than claiming an irrevocable offer.
sync_circuit RRArbiter(T, n :: PosInt):

  interface ingress[n](Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)
  output chosen: Bits(index_width(n))

  def choice_width = index_width(n)
  reg next_priority(~init: bits(0, choice_width))
  // Prevents the rotating state from selecting an unused encoding.
  assert(next_priority <= bits(n - 1, choice_width),
         "rr_priority_in_range")
  def mutable selected_valid = Bool(#false)
  def mutable selected_bits = ingress[0].bits
  def mutable selected_index = bits(0, choice_width)

  // Build one fixed-priority result for each possible starting point, then
  // select the result named by the rotating priority register.
  for (start in 0..n):
    def mutable candidate_valid = Bool(#false)
    def mutable candidate_bits = ingress[start].bits
    def mutable candidate_index = bits(start, choice_width)
    def priority_order = (
      for List (index in start..n): index
    ) ++ (
      for List (index in 0..start): index
    )
    for (index in priority_order):
      def take = ingress[index].valid & !candidate_valid
      candidate_bits := mux(take, ingress[index].bits, candidate_bits)
      candidate_index := mux(take,
                             bits(index, choice_width),
                             candidate_index)
      candidate_valid := candidate_valid ||| ingress[index].valid

    def starts_here = next_priority === bits(start, choice_width)
    selected_valid := mux(starts_here, candidate_valid, selected_valid)
    selected_bits := mux(starts_here, candidate_bits, selected_bits)
    selected_index := mux(starts_here, candidate_index, selected_index)

  for (index in 0..n):
    def selected = selected_valid & (
      selected_index === bits(index, choice_width)
    )
    ingress[index].ready <== egress.ready & selected

  egress.valid <== selected_valid
  egress.bits <== selected_bits
  chosen <== selected_index

  when (selected_valid & egress.ready):
    next_priority <== mux(
      selected_index === bits(n - 1, choice_width),
      bits(0, choice_width),
      selected_index + bits(1, choice_width)
    )

// The payloadless specialization rotates the same grant policy after each
// transferred token and retains the selected input index.
sync_circuit CtrlRRArbiter(n :: PosInt):

  interface ingress[n](DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  output chosen: Bits(index_width(n))

  def choice_width = index_width(n)
  reg next_priority(~init: bits(0, choice_width))
  // Control-only arbitration retains the same rotating-state invariant.
  assert(next_priority <= bits(n - 1, choice_width),
         "ctrl_rr_priority_in_range")
  def mutable selected_valid = Bool(#false)
  def mutable selected_index = bits(0, choice_width)

  for (start in 0..n):
    def mutable candidate_valid = Bool(#false)
    def mutable candidate_index = bits(start, choice_width)
    def priority_order = (
      for List (index in start..n): index
    ) ++ (
      for List (index in 0..start): index
    )
    for (index in priority_order):
      def take = ingress[index].valid & !candidate_valid
      candidate_index := mux(take,
                             bits(index, choice_width),
                             candidate_index)
      candidate_valid := candidate_valid ||| ingress[index].valid

    def starts_here = next_priority === bits(start, choice_width)
    selected_valid := mux(starts_here, candidate_valid, selected_valid)
    selected_index := mux(starts_here, candidate_index, selected_index)

  for (index in 0..n):
    def selected = selected_valid & (
      selected_index === bits(index, choice_width)
    )
    ingress[index].ready <== egress.ready & selected

  egress.valid <== selected_valid
  chosen <== selected_index

  when (selected_valid & egress.ready):
    next_priority <== mux(
      selected_index === bits(n - 1, choice_width),
      bits(0, choice_width),
      selected_index + bits(1, choice_width)
    )

// A connected endpoint array supplies its own input count. A disconnected
// topology starts from a payload type and states the count once in rr_arbiter.
fun rr_arbiter(n = #false)
  :: ((source :: Any) -> StageResult(source, Endpoint)):
  fun (source) :~ StageResult(source, Endpoint):
    def inputs:
      if source is_a Handle | source.right | source
    def typed = !(inputs is_a Array)
    def input_count:
      if typed
      | block:
          unless n is_a PosInt
          | error(~who: #'rr_arbiter,
                  "typed round-robin arbitration requires a positive input count")
          n
      | block:
          unless inputs.length() > 0
          | error(~who: #'rr_arbiter,
                  "round-robin arbitration requires at least one input endpoint")
          if n
          | unless n == inputs.length()
            | error(~who: #'rr_arbiter,
                    "configured input count does not match the endpoint array")
          | #void
          inputs.length()
    def T:
      if typed | source | flow_payload_type(inputs[0])
    inst arbiter_stage(RRArbiter(T, input_count))
    finish_flow_stage(
      source,
      InterfaceHandle(arbiter_stage.ingress, arbiter_stage.egress)
    )

export:
  RRArbiter
  rr_arbiter
  CtrlRRArbiter
