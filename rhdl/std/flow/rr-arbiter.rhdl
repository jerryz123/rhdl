#lang rhdl
// Defines payload-bearing and control-only round-robin arbiters.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/ready-valid-support.rhdl") open
  lib("rhdl/std/flow/matcher.rhdl") open

// A one-output RoundRobinMatcher owns transfer-based rotation. Selection may
// change while stalled, so the output deliberately remains Decoupled rather
// than claiming an irrevocable offer.
sync_circuit RRArbiter(T :: DataType, n :: PosInt):

  interface ingress[n](Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(
    for List (index in 0..n): vec(ingress[index].valid)
  )
  inst matcher(RoundRobinMatcher(n, 1))
  matcher.requests <== requests
  matcher.accepts <== vec(egress.ready)
  def grants = vec(
    for List (index in 0..n): matcher.grants[index][0]
  )
  def selected_valid = or_reduce(grants)
  def mutable selected_bits = ingress[0].bits
  for (index in 0..n):
    selected_bits := mux(grants[index], ingress[index].bits, selected_bits)

  for (index in 0..n):
    ingress[index].ready <== egress.ready & grants[index]

  egress.valid <== selected_valid
  egress.bits <== selected_bits
  chosen <== priority_encoder(grants)

// The payloadless specialization uses the same generic matching policy.
sync_circuit CtrlRRArbiter(n :: PosInt):

  interface ingress[n](DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(
    for List (index in 0..n): vec(ingress[index].valid)
  )
  inst matcher(RoundRobinMatcher(n, 1))
  matcher.requests <== requests
  matcher.accepts <== vec(egress.ready)
  def grants = vec(
    for List (index in 0..n): matcher.grants[index][0]
  )
  def selected_valid = or_reduce(grants)

  for (index in 0..n):
    ingress[index].ready <== egress.ready & grants[index]

  egress.valid <== selected_valid
  chosen <== priority_encoder(grants)

// A connected endpoint array supplies its own input count. A disconnected
// topology starts from a payload type and states the count once in rr_arbiter.
fun rr_arbiter(n = #false)
  :: ((source :: Any) -> InterfaceTransformResult(source, Endpoint)):
  fun (source) :~ InterfaceTransformResult(source, Endpoint):
    def inputs:
      if source is_a Handle | source.right | source
    def typed = !(inputs is_a Array)
    def input_count:
      if typed
      | block:
          unless n is_a PosInt
          | error(~who: #'rr_arbiter,
                  "typed round-robin arbitration requires a positive input count")
          n
      | block:
          unless inputs.length() > 0
          | error(~who: #'rr_arbiter,
                  "round-robin arbitration requires at least one input endpoint")
          if n
          | unless n == inputs.length()
            | error(~who: #'rr_arbiter,
                    "configured input count does not match the endpoint array")
          | #void
          inputs.length()
    def T:
      if typed | source | flow_payload_type(inputs[0])
    inst arbiter_stage(RRArbiter(T, input_count))
    finish_interface_transform(
      source,
      InterfaceHandle(arbiter_stage.ingress, arbiter_stage.egress)
    )

export:
  RRArbiter
  rr_arbiter
  CtrlRRArbiter
