#lang rhdl
// Defines atomic one-to-many forks for payload-bearing and control-only flows.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/ready-valid-support.rhdl") open
  lib("rhdl/std/flow/reduction.rhdl").and_exclusion_reduce

// Every output transfers in the same cycle or none do. Unlike Broadcast, the
// fork has no storage and does not retain independently pending recipients.
// Output offers are Decoupled because each valid depends on peer readiness.
circuit AtomicFork(T :: DataType, n :: PosInt):

  interface ingress(Decoupled(T), ~role: consumer)
  interface egress[n](Decoupled(T), ~role: producer)

  def ready_reduction = and_exclusion_reduce(vec(
    for List (index in 0..n): egress[index].ready
  ))
  ingress.ready <== ready_reduction.all
  for (index in 0..n):
    egress[index].valid <== ingress.valid & ready_reduction.except[index]
    egress[index].bits <== ingress.bits

// The control-only specialization atomically duplicates indistinguishable
// tokens without manufacturing a payload.
circuit CtrlAtomicFork(n :: PosInt):

  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress[n](DecoupledCtrl(), ~role: producer)

  def ready_reduction = and_exclusion_reduce(vec(
    for List (index in 0..n): egress[index].ready
  ))
  ingress.ready <== ready_reduction.all
  for (index in 0..n):
    egress[index].valid <== ingress.valid & ready_reduction.except[index]

// Instantiates an atomic fork and returns its indexable output endpoint array.
fun atomic_fork(n :: PosInt)
  :: ((source :: Any) -> InterfaceTransformResult(source, InterfaceArrayFields)):
  fun (source) :~ InterfaceTransformResult(source, InterfaceArrayFields):
    def T = flow_payload_type(source)
    inst fork_stage(AtomicFork(T, n))
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(fork_stage.ingress, fork_stage.egress),
        "atomic-fork",
        {"outputs": n},
        fork_stage
      )
    )

// Configures the payloadless atomic fork for control-only token flows.
fun ctrl_atomic_fork(n :: PosInt)
  :: ((source :: Any) -> InterfaceTransformResult(source, InterfaceArrayFields)):
  fun (source) :~ InterfaceTransformResult(source, InterfaceArrayFields):
    ctrl_flow_protocol_type(source)
    inst ctrl_fork_stage(CtrlAtomicFork(n))
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(ctrl_fork_stage.ingress, ctrl_fork_stage.egress),
        "ctrl-atomic-fork",
        {"outputs": n},
        ctrl_fork_stage
      )
    )

export:
  AtomicFork
  atomic_fork
  CtrlAtomicFork
  ctrl_atomic_fork
