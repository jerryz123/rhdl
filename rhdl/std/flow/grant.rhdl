#lang rhdl
// Defines optional-one-hot grant routing and merging for ready-valid flows.

import:
  lib("rhdl/std/ready-valid.rhdl") open

export:
  GrantDemux
  GrantMerge

// A zero grant blocks the input; a one-hot grant routes it to the selected
// output. At most one grant bit may be asserted. Selection may change while
// stalled, so the output offers use the Decoupled contract.
circuit GrantDemux(T, output_count :: PosInt):
  interface ingress(Decoupled(T), ~role: consumer)
  input grants: Vec(output_count, Bool)
  interface egress[output_count](Decoupled(T), ~role: producer)

  ingress.ready <== or_reduce(vec(
    for List (output_index in 0..output_count):
      grants[output_index] & egress[output_index].ready
  ))
  for (output_index in 0..output_count):
    def selected = grants[output_index]
    egress[output_index].valid <== ingress.valid & selected
    egress[output_index].bits <== ingress.bits

// A zero grant produces no offer; a one-hot grant selects the corresponding
// input. At most one grant bit may be asserted. Readiness is returned only to
// the selected input, and the output remains Decoupled under changing grants.
circuit GrantMerge(T, input_count :: PosInt):
  interface ingress[input_count](Decoupled(T), ~role: consumer)
  input grants: Vec(input_count, Bool)
  interface egress(Decoupled(T), ~role: producer)

  def mutable selected_valid = Bool(#false)
  def mutable selected_bits = ingress[0].bits
  for (input_index in 0..input_count):
    def selected = grants[input_index]
    def active = selected & ingress[input_index].valid
    selected_valid := selected_valid ||| active
    selected_bits := mux(active,
                         ingress[input_index].bits,
                         selected_bits)
    ingress[input_index].ready <== selected & egress.ready

  egress.valid <== selected_valid
  egress.bits <== selected_bits
