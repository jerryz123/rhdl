#lang rhdl
// Defines inline payload transformation for non-backpressured Valid flows.

import:
  rhombus/meta open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/stage.rhdl") open

fun finish_map_valid_handle(input_link :: Handle,
                            output_link :: Handle,
                            mapped_bits):
  output_link.left.field("valid") <== input_link.right.field("valid")
  output_link.left.field("bits") <== mapped_bits
  input_link.consumed := #true
  output_link.consumed := #true
  InterfaceHandle(input_link.left, output_link.right)

// The first argument may be a payload type, Valid protocol, endpoint, or
// earlier handle. Mapping is purely combinational because Valid has no
// readiness path or pending-offer contract.
expr.macro
| 'map_valid($source_or_type,
             $(payload :: Identifier) => $body_head ...):
    $(body_tail :: Block)':
    'map_valid($source_or_type, $payload):
       $body_head ... $body_tail'
| 'map_valid($source_or_type,
             $(payload :: Identifier) => $body ...)':
    'map_valid($source_or_type, $payload): $body ...'
| 'map_valid($source_or_type, $(payload :: Identifier)): $body':
    'block:
       def map_valid_argument = $source_or_type
       def map_valid_input_protocol = valid_flow_protocol_type(map_valid_argument)
       def map_valid_input_link = interface_link(
         map_valid_input_protocol,
         "map_valid_input"
       )
       def map_valid_input :: Endpoint = map_valid_input_link.right
       def $payload :: Hardware = map_valid_input.bits
       fun compute_mapped_bits(): $body
       def mapped_bits = compute_mapped_bits()
       def map_valid_output_link = interface_link(
         Valid(hardware_value_type(mapped_bits)),
         "map_valid_output"
       )
       def map_valid_handle = finish_map_valid_handle(
         map_valid_input_link,
         map_valid_output_link,
         mapped_bits
       )
       finish_flow_stage(map_valid_argument, map_valid_handle)'

export:
  map_valid
