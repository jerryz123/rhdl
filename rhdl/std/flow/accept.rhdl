#lang rhdl
// Converts an always-accepted ready-valid input into a Valid event stream.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/flow/stage.rhdl") open

// Every offered item transfers immediately because the adapter permanently
// asserts ready. The output is therefore a nonbackpressured Valid event.
fun accept_flow(source_or_type):
  def input_protocol = flow_protocol_type(source_or_type)
  def input_link = interface_link(input_protocol, "accept_flow_input")
  def input_endpoint = input_link.right
  def output_link = interface_link(
    Valid(flow_payload_type(source_or_type)),
    "accept_flow_output"
  )
  def output_endpoint = output_link.left
  input_endpoint.field("ready") <== Bool(#true)
  output_endpoint.field("valid") <== input_endpoint.field("valid")
  output_endpoint.field("bits") <== input_endpoint.field("bits")
  input_link.consumed := #true
  output_link.consumed := #true
  finish_flow_stage(
    source_or_type,
    InterfaceHandle(input_link.left, output_link.right)
  )

export:
  accept_flow
