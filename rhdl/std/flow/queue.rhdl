#lang rhdl
// Defines payload-bearing and control-only configurable ready-valid queues.

import:
  lib("rhdl/std/ready-valid.rhdl") open
  lib("rhdl/std/counter.rhdl") open

// Queue uses asynchronous-read storage. A synchronous-read option belongs here
// once RHDL has a corresponding memory primitive. Stored payloads remain stable
// under backpressure.
sync_circuit Queue(T,
                   depth :: Int,
                   ~pipe: pipe :: Boolean = #false,
                   ~flow: flow :: Boolean = #false):
  unless depth > 0
  | error(~who: #'Queue, "depth must be a positive host Int")

  interface ingress(Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)
  output count: Bits(index_width(depth + 1))

  def pipe_enabled = Bool(pipe)
  def flow_enabled = Bool(flow)

  // Flow changes an empty queue into a combinational bypass. Pipe lets a full
  // queue replace the item being removed without inserting a bubble.
  fun ready_for_input(full): (not full) or (pipe_enabled and egress.ready)
  fun valid_for_output(empty): (not empty) or (flow_enabled and ingress.valid)
  fun bits_for_output(empty, stored_bits):
    mux(flow_enabled and empty, ingress.bits, stored_bits)

  // A flow-through transfer does not touch storage, so internal enqueue and
  // dequeue events differ from the externally visible ready-valid handshakes.
  fun stores_input(empty, ingress_ready):
    ingress.valid and ingress_ready and not (
      flow_enabled and empty and egress.ready
    )
  fun removes_output(empty): (not empty) and egress.ready

  if (depth == 1)
  | block:
      reg occupied(~init: Bool(#false))
      reg payload(T)
      def empty = not occupied
      def input_ready = ready_for_input(occupied)
      def output_valid = valid_for_output(empty)
      def enqueue = stores_input(empty, input_ready)
      def dequeue = removes_output(empty)

      ingress.ready <== input_ready
      egress.valid <== output_valid
      egress.bits <== bits_for_output(empty, payload)
      count <== occupied.into(Bits(1))

      when (enqueue xor dequeue):
        occupied.next <== enqueue
      when (enqueue):
        payload.next <== ingress.bits
      #void
  | block:
      def count_width = index_width(depth + 1)
      mem storage(depth, T)
      reg occupancy(~init: bits(0, count_width))
      def PointerCounter = Counter(depth)
      inst read_pointer(PointerCounter)
      inst write_pointer(PointerCounter)

      def empty = occupancy === bits(0, count_width)
      def full = occupancy === bits(depth, count_width)
      def input_ready = ready_for_input(full)
      def output_valid = valid_for_output(empty)
      def stored_bits = storage[read_pointer.value]
      def enqueue = stores_input(empty, input_ready)
      def dequeue = removes_output(empty)

      ingress.ready <== input_ready
      egress.valid <== output_valid
      egress.bits <== bits_for_output(empty, stored_bits)
      count <== occupancy
      storage.write(write_pointer.value, ingress.bits, ~enable: enqueue)

      read_pointer.enable <== dequeue
      write_pointer.enable <== enqueue
      when (enqueue xor dequeue):
        occupancy.next <== mux(
          enqueue,
          occupancy + bits(1, count_width),
          occupancy - bits(1, count_width)
        )
      #void

// Tokens are indistinguishable, so the control-only queue needs occupancy
// state but no payload memory or read/write pointers.
sync_circuit CtrlQueue(depth :: Int,
                       ~pipe: pipe :: Boolean = #false,
                       ~flow: flow :: Boolean = #false):
  unless depth > 0
  | error(~who: #'CtrlQueue, "depth must be a positive host Int")

  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  output count: Bits(index_width(depth + 1))

  def pipe_enabled = Bool(pipe)
  def flow_enabled = Bool(flow)
  fun ready_for_input(full): (not full) or (pipe_enabled and egress.ready)
  fun valid_for_output(empty): (not empty) or (flow_enabled and ingress.valid)
  fun stores_input(empty, ingress_ready):
    ingress.valid and ingress_ready and not (
      flow_enabled and empty and egress.ready
    )
  fun removes_output(empty): (not empty) and egress.ready

  if (depth == 1)
  | block:
      reg occupied(~init: Bool(#false))
      def empty = not occupied
      def input_ready = ready_for_input(occupied)
      def enqueue = stores_input(empty, input_ready)
      def dequeue = removes_output(empty)

      ingress.ready <== input_ready
      egress.valid <== valid_for_output(empty)
      count <== occupied.into(Bits(1))

      when (enqueue xor dequeue):
        occupied.next <== enqueue
      #void
  | block:
      def count_width = index_width(depth + 1)
      reg occupancy(~init: bits(0, count_width))
      def empty = occupancy === bits(0, count_width)
      def full = occupancy === bits(depth, count_width)
      def input_ready = ready_for_input(full)
      def enqueue = stores_input(empty, input_ready)
      def dequeue = removes_output(empty)

      ingress.ready <== input_ready
      egress.valid <== valid_for_output(empty)
      count <== occupancy

      when (enqueue xor dequeue):
        occupancy.next <== mux(
          enqueue,
          occupancy + bits(1, count_width),
          occupancy - bits(1, count_width)
        )
      #void
// Instantiates a queue in the ambient sync domain and returns its downstream
// endpoint. Use an explicit Queue instance when count must remain accessible.
fun queue(source :: Endpoint,
          depth :: Int,
          ~pipe: pipe_enabled :: Boolean = #false,
          ~flow: flow_enabled :: Boolean = #false) :~ Endpoint:
  def T = decoupled_payload_type(source)
  def QueueModule = Queue(T,
                          depth,
                          ~pipe: pipe_enabled,
                          ~flow: flow_enabled)
  inst queue_stage(QueueModule)
  queue_stage.ingress <=> source
  queue_stage.egress

// Instantiates the payloadless token FIFO in the ambient sync domain.
fun ctrl_queue(source :: Endpoint,
               depth :: Int,
               ~pipe: pipe_enabled :: Boolean = #false,
               ~flow: flow_enabled :: Boolean = #false) :~ Endpoint:
  def checked = ctrl_endpoint(source)
  def CtrlQueueModule = CtrlQueue(depth,
                                  ~pipe: pipe_enabled,
                                  ~flow: flow_enabled)
  inst ctrl_queue_stage(CtrlQueueModule)
  ctrl_queue_stage.ingress <=> checked
  ctrl_queue_stage.egress

export:
  Queue
  queue
  CtrlQueue
  ctrl_queue
