#lang rhombus/and_meta
// Layers Chisel-like hardware operators over the embedded elaboration kernel.

import:
  rhombus
  rhombus/meta open
  "frontend-runtime.rhm" open

export:
  all_from("frontend-runtime.rhm")
  +
  -
  &
  ^
  ===
  <==
  circuit
  elaborate

defn.macro 'circuit $(name :: Identifier)($argument, ...): $body; ...':
  def circuit_name = name.to_source_string()
  'fun $name($argument, ...):
     fun implementation():
       $body
       ...
     build_circuit($circuit_name, [$argument, ...], implementation)'

expr.macro 'elaborate($body)':
  'run_elaboration(fun (): $body)'

operator (left + right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_add(left, right)
  | left rhombus.(+) right

operator (left - right):
  if hardware_entity(left) || hardware_entity(right)
  | hw_sub(left, right)
  | left rhombus.(-) right

operator (left & right):
  bit_and(left, right)

operator (left ^ right):
  bit_xor(left, right)

operator (left === right):
  hw_eq(left, right)

operator (place <== entity):
  ~weaker_than: ~other
  connect(place, entity)
