#lang rhombus

export:
  OperationSchema
  schemas
  schema_for
  combinational_opcode

class OperationSchema(opcode,
                      kind,
                      operand_count,
                      result_count,
                      place_count)

def schemas:
  [OperationSchema("input_port", "structural", 0, 1, 0),
   OperationSchema("output_port", "structural", 0, 0, 1),
   OperationSchema("constant", "combinational", 0, 1, 0),
   OperationSchema("add", "combinational", 2, 1, 0),
   OperationSchema("register", "sequential", 1, 1, 1),
   OperationSchema("register_reset", "sequential", 3, 1, 1),
   OperationSchema("instance", "structural", #false, #false, #false),
   OperationSchema("drive", "structural", 1, 0, 1)]

fun schema_for(opcode):
  schemas.find(fun (schema): schema.opcode == opcode)

fun combinational_opcode(opcode):
  def schema = schema_for(opcode)
  schema && schema.kind == "combinational"
