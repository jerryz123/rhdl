#lang rhombus/and_meta
// Assembles #lang rhdl/base from Rhombus and the minimal RHDL frontend surface.

import:
  rhombus
  rhombus/meta open
  "../frontend/base.rhm" open
  "../frontend/kernel.rhm".host_condition

export:
  all_from(rhombus)
  all_from("../frontend/base.rhm")
  if

expr.macro 'if $condition | $true_result | $false_result':
  'rhombus.if host_condition($condition) | $true_result | $false_result'
