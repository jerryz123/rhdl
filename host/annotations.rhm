#lang rhombus/and_meta
// Defines dependency-neutral host refinements shared by RHDL domain packages.

import:
  rhombus/meta open
  rhombus/rx open

export:
  NonemptyString
  AsciiIdentifier

fun nonempty_string(value):
  value is_a String && value.length() > 0

annot.macro 'NonemptyString':
  'String && satisfying(nonempty_string)'

def ascii_identifier_pattern = rx'bof ["A"-"Z" "a"-"z" "_"] ["A"-"Z" "a"-"z" "0"-"9" "_"]* eof'

fun ascii_identifier(value):
  value is_a String && ascii_identifier_pattern.is_match(value)

annot.macro 'AsciiIdentifier':
  'String && satisfying(ascii_identifier)'
