#lang rhombus
// Checks BootROM image generation, CHI metadata, immutable storage, and validation.

import:
  rhombus.bits.(<<) as <<
  "../../rhodium/core/main.rhm" open
  "../../chi/main.rhdl" as chi
  "../../riscv/model/main.rhm" open
  "../../riscv/isa/integer-common.rhm" open
  "../../riscv/isa/privileged.rhm" open
  "../../riscv/isa/zicsr.rhm" open
  "../bootrom-image.rhm" open
  "../bootrom.rhdl" as bootrom
  "bootrom-fixture.rhdl" as fixture

fun image_word(image :: BootROMImage, index :: Nat):
  def mutable word = 0
  for (byte_index in 0..4):
    word := word + (image.bytes[(index * 4) + byte_index] << (byte_index * 8))
  word

fun sign_extend(value :: Nat, width :: PosInt):
  def sign = 1 << (width - 1)
  if value >= sign | value - (1 << width) | value

fun trampoline_target(image :: BootROMImage,
                      reset_address :: Nat,
                      auipc_index :: Nat):
  def auipc_word = image_word(image, auipc_index)
  def jalr_word = image_word(image, auipc_index + 1)
  reset_address + (auipc_index * 4) + sign_extend(UImmediate.decode(auipc_word), 32) + (
    sign_extend(IImmediate.decode(jalr_word), 12)
  )

def default_image = DefaultRiscvBootROMImage
def relocated_image = riscv_bootrom_image(0x20000, 0x7f000000)
def default_words = for List (index in 0..(default_image.size_bytes / 4)):
  image_word(default_image, index)
def top = fixture.design.modules.find(fun (module_def): module_def.name == "CHIBootROM")
def register_names = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
).map(fun (operation): operation.attribute("name"))
def assertion_labels = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "verif.assert"
).map(fun (operation): operation.attribute("label"))
def constant_widths = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.constant"
).map(fun (operation): operation.results[0].type.width)

check:
  default_image.size_bytes ~is 28
  default_words ~is [
    0xf1402573,
    0x00051863,
    0x00000593,
    0x7fff0297,
    0xff428067,
    0x10500073,
    0xffdff06f
  ]
  CSRRS.matches(default_words[0]) ~is #true
  BNE.matches(default_words[1]) ~is #true
  ADDI.matches(default_words[2]) ~is #true
  AUIPC.matches(default_words[3]) ~is #true
  JALR.matches(default_words[4]) ~is #true
  WFI.matches(default_words[5]) ~is #true
  JAL.matches(default_words[6]) ~is #true
  BImmediate.decode(default_words[1]) ~is 16
  JImmediate.decode(default_words[6]) ~is 0x1ffffc
  trampoline_target(default_image, RiscvBootROMResetAddress, 3) ~is RiscvBootROMPayloadAddress

  trampoline_target(relocated_image, 0x20000, 3) ~is 0x7f000000
  BootROMImage([0xaa, 0x55]).padded_bytes(4) ~is [0xaa, 0x55, 0, 0]

  fixture.config.image === DefaultRiscvBootROMImage ~is #true
  fixture.params.node.kind ~is chi.CHINodeKind.SNI
  fixture.params.node.max_outstanding ~is 1
  fixture.params.node.supports.req ~is [chi.CHIReqOpcode.ReadNoSnp]
  fixture.params.node.emits.dat ~is [chi.CHIDatOpcode.CompData]
  fixture.params.service.address_sets ~is [chi.AddressSet(RiscvBootROMResetAddress, 63)]
  fixture.params.service.supports(chi.CHIReqOpcode.ReadNoSnp, 64) ~is #true
  fixture.params.service.supports(chi.CHIReqOpcode.WriteNoSnpFull, 4) ~is #false
  top.inputs.map(fun (port): port.name) ~is ["clock", "reset", "identity", "port_in"]
  top.outputs.map(fun (port): port.name) ~is ["port_out"]
  register_names ~is ["active", "request", "pending_data_ids"]
  assertion_labels.contains("chi_bootrom_request_supported") ~is #true
  assertion_labels.contains("chi_bootrom_write_data_unsupported") ~is #true
  constant_widths.contains(512) ~is #true
  verify_design(fixture.design) ~is #void

  BootROMImage([0x100]) ~throws "image elements must be bytes"
  bootrom.CHIBootROMConfig(fixture.flit, ~window_bytes: 32) ~throws "maximum-size transfer"
  bootrom.CHIBootROMConfig(
    fixture.flit,
    ~window_bytes: 64,
    ~image: BootROMImage(for List (_index in 0..65): 0)
  ) ~throws "image must fit"
  bootrom.CHIBootROMParams("misaligned", 12, fixture.config, ~base_address: 0x10020) ~throws "aligned"
  bootrom.CHIBootROMParams("wide-node", 128, fixture.config) ~throws "NodeID"
  riscv_bootrom_image(0x10002, 0x80000000) ~throws "reset address"
  riscv_bootrom_image(0x10000, 0x80000002) ~throws "payload address"
  riscv_bootrom_image(0, 0x80000000) ~throws "PC-relative range"
