#lang rhodium
// Elaborates the default multihart RISC-V image in a standalone CHI BootROM.

import:
  lib("devices/bootrom.rhdl") open
  lib("chi/main.rhdl").CHIFlitParams

def flit = CHIFlitParams()
def config = CHIBootROMConfig(flit, ~window_bytes: 64)
def params = CHIBootROMParams("test-bootrom", 12, config)
def design = elaborate(CHIBootROM(config))

export:
  flit
  config
  params
  design
