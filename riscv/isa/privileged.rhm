#lang rhombus
// Enumerates the first Ricket privileged return instructions.

import:
  "integer-common.rhm" open
  "../model/main.rhm" open

export:
  PrivilegedInstructions
  MRET
  SRET

def MRET = system_instruction("MRET", 0x302)
def SRET = system_instruction("SRET", 0x102)
def PrivilegedInstructions = [MRET, SRET]
