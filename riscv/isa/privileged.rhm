#lang rhombus
// Enumerates Ricket's privileged return and address-translation instructions.

import:
  "integer-common.rhm" open
  "../model/main.rhm" open

export:
  PrivilegedInstructions
  MRET
  SRET
  SFENCE_VMA

def MRET = system_instruction("MRET", 0x302)
def SRET = system_instruction("SRET", 0x102)
def FenceVmaFormat = InstructionFormat(
  "SFENCE.VMA",
  [RegisterOperand("rs1", rs1, "source"),
   RegisterOperand("rs2", rs2, "source")]
)
def SFENCE_VMA = instruction(
  "SFENCE.VMA",
  FenceVmaFormat,
  [opcode.constrain(SYSTEM), funct3.constrain(0), rd.constrain(0), funct7.constrain(9)]
)
def PrivilegedInstructions = [MRET, SRET, SFENCE_VMA]
