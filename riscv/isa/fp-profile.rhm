#lang rhombus
// Defines the host-side floating-point specialization selected by a core.

enum FloatingPointProfile
| None
| F
| D

def DefaultFloatingPointProfile = FloatingPointProfile.None

fun floating_point_supports_f(profile :: FloatingPointProfile):
  profile != FloatingPointProfile.None

fun floating_point_supports_d(profile :: FloatingPointProfile):
  profile == FloatingPointProfile.D

fun floating_point_register_width(profile :: FloatingPointProfile) :: PosInt:
  cond
  | profile == FloatingPointProfile.F: 32
  | profile == FloatingPointProfile.D: 64
  | ~else:
      error(~who: #'floating_point_register_width,
            "the None profile has no floating-point register file")

export:
  FloatingPointProfile
  DefaultFloatingPointProfile
  floating_point_supports_f
  floating_point_supports_d
  floating_point_register_width
