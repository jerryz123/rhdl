#lang rhombus
// Composes Zca, Zcf, and Zcd into selectable compressed-instruction profiles.

import:
  "compressed.rhm" open
  "fp-profile.rhm" open
  "xlen.rhm" open
  "zca.rhm" open
  "zcf.rhm" open
  "zcd.rhm" open

enum CompressedProfile
| None
| Zca
| C

def DefaultCompressedProfile = CompressedProfile.None

fun compressed_profile_enabled(profile :: CompressedProfile):
  profile != CompressedProfile.None

fun compressed_profile_reports_misa_c(profile :: CompressedProfile,
                                      floating_point :: FloatingPointProfile):
  (profile == CompressedProfile.C) || (
    (profile == CompressedProfile.Zca) && !floating_point_supports_f(floating_point)
  )

fun zca_instructions(xlen :: XLen):
  if xlen == XLen.X32 | RV32ZcaInstructions | RV64ZcaInstructions

fun c_instructions(xlen :: XLen, floating_point :: FloatingPointProfile):
  if xlen == XLen.X32
  | RV32ZcaInstructions ++ (
      if floating_point_supports_f(floating_point) | RV32ZcfInstructions | []
    ) ++ (
      if floating_point_supports_d(floating_point) | RV32ZcdInstructions | []
    )
  | RV64ZcaInstructions ++ (
      if floating_point_supports_d(floating_point) | RV64ZcdInstructions | []
    )

fun compressed_profile_instructions(xlen :: XLen,
                                    floating_point :: FloatingPointProfile,
                                    compressed :: CompressedProfile):
  cond
  | compressed == CompressedProfile.Zca: zca_instructions(xlen)
  | compressed == CompressedProfile.C: c_instructions(xlen, floating_point)
  | ~else:
      error(~who: #'compressed_profile_instructions,
            "the None profile has no compressed instructions")

export:
  CompressedInstructionSpec
  CompressedInstructionCatalog
  CompressedProfile
  DefaultCompressedProfile
  compressed_profile_enabled
  compressed_profile_reports_misa_c
  zca_instructions
  c_instructions
  compressed_profile_instructions
