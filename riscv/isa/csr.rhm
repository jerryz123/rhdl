#lang rhombus
// Defines architectural CSR identifiers and their canonical 12-bit addresses.

enum CsrId
| Sstatus
| Sie
| Stvec
| Scounteren
| Senvcfg
| Sscratch
| Sepc
| Scause
| Stval
| Sip
| Satp
| Mstatus
| Misa
| Medeleg
| Mideleg
| Mie
| Mtvec
| Mcounteren
| Menvcfg
| Mscratch
| Mepc
| Mcause
| Mtval
| Mip
| Mvendorid
| Marchid
| Mimpid
| Mhartid

def CsrIds = [
  CsrId.Sstatus, CsrId.Sie, CsrId.Stvec, CsrId.Scounteren,
  CsrId.Senvcfg, CsrId.Sscratch, CsrId.Sepc, CsrId.Scause,
  CsrId.Stval, CsrId.Sip, CsrId.Satp,
  CsrId.Mstatus, CsrId.Misa, CsrId.Medeleg, CsrId.Mideleg,
  CsrId.Mie, CsrId.Mtvec, CsrId.Mcounteren, CsrId.Menvcfg,
  CsrId.Mscratch, CsrId.Mepc, CsrId.Mcause, CsrId.Mtval, CsrId.Mip,
  CsrId.Mvendorid, CsrId.Marchid, CsrId.Mimpid, CsrId.Mhartid
]

fun csr_address(id :: CsrId) :: Nat:
  match id
  | CsrId.Sstatus: 0x100
  | CsrId.Sie: 0x104
  | CsrId.Stvec: 0x105
  | CsrId.Scounteren: 0x106
  | CsrId.Senvcfg: 0x10a
  | CsrId.Sscratch: 0x140
  | CsrId.Sepc: 0x141
  | CsrId.Scause: 0x142
  | CsrId.Stval: 0x143
  | CsrId.Sip: 0x144
  | CsrId.Satp: 0x180
  | CsrId.Mstatus: 0x300
  | CsrId.Misa: 0x301
  | CsrId.Medeleg: 0x302
  | CsrId.Mideleg: 0x303
  | CsrId.Mie: 0x304
  | CsrId.Mtvec: 0x305
  | CsrId.Mcounteren: 0x306
  | CsrId.Menvcfg: 0x30a
  | CsrId.Mscratch: 0x340
  | CsrId.Mepc: 0x341
  | CsrId.Mcause: 0x342
  | CsrId.Mtval: 0x343
  | CsrId.Mip: 0x344
  | CsrId.Mvendorid: 0xf11
  | CsrId.Marchid: 0xf12
  | CsrId.Mimpid: 0xf13
  | CsrId.Mhartid: 0xf14

export:
  CsrId
  CsrIds
  csr_address
