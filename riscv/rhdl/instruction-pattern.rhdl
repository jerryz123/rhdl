#lang rhdl
// Converts pure RISC-V instruction encodings into typed RHDL input patterns.

import:
  "../model/encoding.rhm".InstructionEncoding
  "../model/instruction.rhm".InstructionSpec
  lib("rhdl/std/decode/pattern.rhdl").Pattern

// Architectural value/care images become ordinary Bits patterns at their
// declared instruction width. The pure model remains unaware of RHDL.
fun encoding_pattern(encoding):
  unless encoding is_a InstructionEncoding
  | error(~who: #'encoding_pattern,
          "instruction encoding must be an InstructionEncoding")
  Pattern(
    ~value: bits(encoding.value, encoding.width),
    ~care: bits(encoding.care, encoding.width)
  )

fun instruction_pattern(instruction):
  unless instruction is_a InstructionSpec
  | error(~who: #'instruction_pattern,
          "instruction must be an InstructionSpec")
  encoding_pattern(instruction.encoding)

export:
  encoding_pattern
  instruction_pattern
