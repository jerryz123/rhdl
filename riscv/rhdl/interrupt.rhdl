#lang rhdl
// Converts architectural interrupt causes into typed xcause hardware values.

import:
  "../isa/interrupt.rhm" open

fun interrupt_cause_bits(cause :: InterruptCause,
                         width :: PosInt) :~ Bits(width):
  bits((1 bits.(<<) (width - 1)) bits.or interrupt_code(cause), width)

export:
  interrupt_cause_bits
