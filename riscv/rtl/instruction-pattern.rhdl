#lang rhodium
// Converts pure RISC-V instruction encodings into typed Rhodium input patterns.

import:
  "../model/encoding.rhm".InstructionEncoding
  "../model/instruction.rhm".InstructionSpec
  lib("rhodium/std/decode/pattern.rhdl").Pattern

// Architectural value/care images become ordinary Bits patterns at their
// declared instruction width. The pure model remains unaware of Rhodium.
fun encoding_pattern(encoding :: InstructionEncoding):
  Pattern(
    ~value: bits(encoding.value, encoding.width),
    ~care: bits(encoding.care, encoding.width)
  )

fun instruction_pattern(instruction :: InstructionSpec):
  encoding_pattern(instruction.encoding)

export:
  encoding_pattern
  instruction_pattern
