#lang rhombus
// Defines named instruction bit fields and fixed-value encoding constraints.

export:
  BitField
  FieldConstraint
  width_mask

fun width_mask(width :: PosInt):
  (1 bits.(<<) width) - 1

class BitField(name, high :: Nat, low :: Nat, width :: PosInt):
  constructor (name, high :: Nat, low :: Nat):
    unless name is_a String && name.length() > 0
    | error(~who: #'BitField, "field name must be a nonempty String")
    unless low <= high
    | error(~who: #'BitField,
            "field bounds must be natural numbers with high >= low")
    super(name, high, low, high - low + 1)

  method mask():
    width_mask(width) bits.(<<) low

  method extract(word :: Nat):
    (word bits.(>>) low) bits.and width_mask(width)

  method constrain(value):
    FieldConstraint(this, value)

class FieldConstraint(field, value :: Nat, mask :: Nat, value_bits :: Nat):
  constructor (field, value :: Nat):
    unless field is_a BitField
    | error(~who: #'FieldConstraint, "constraint field must be a BitField")
    unless value <= width_mask(field.width)
    | error(~who: #'FieldConstraint,
            "constraint value must fit its instruction field")
    super(field,
          value,
          field.mask(),
          value bits.(<<) field.low)
