#lang rhombus
// Defines named instruction bit fields and fixed-value encoding constraints.

import:
  "../../host/annotations.rhm" open

export:
  BitField
  FieldConstraint
  width_mask

fun width_mask(width :: PosInt):
  (1 bits.(<<) width) - 1

class BitField(name :: NonemptyString, high :: Nat, low :: Nat, width :: PosInt):
  constructor (name :: NonemptyString, high :: Nat, low :: Nat):
    unless low <= high
    | error(~who: #'BitField,
            "field bounds must be natural numbers with high >= low")
    super(name, high, low, high - low + 1)

  method mask():
    width_mask(width) bits.(<<) low

  method extract(word :: Nat):
    (word bits.(>>) low) bits.and width_mask(width)

  method constrain(value):
    FieldConstraint(this, value)

class FieldConstraint(field :: BitField, value :: Nat, mask :: Nat, value_bits :: Nat):
  constructor (field :: BitField, value :: Nat):
    unless value <= width_mask(field.width)
    | error(~who: #'FieldConstraint,
            "constraint value must fit its instruction field")
    super(field,
          value,
          field.mask(),
          value bits.(<<) field.low)
