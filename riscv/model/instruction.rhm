#lang rhombus
// Defines validated instruction specifications and disjoint ISA catalogs.

import:
  "../../host/annotations.rhm" open
  "fields.rhm" open
  "encoding.rhm" open
  "formats.rhm" open

export:
  InstructionSpec
  InstructionCatalog
  instruction

class InstructionSpec(name :: NonemptyString,
                      format :: InstructionFormat,
                      requirements :: NonemptyList.of(FieldConstraint),
                      encoding :: InstructionEncoding,
                      operands :: List.of(RegisterOperand),
                      immediate :: False || ImmediateLayout,
                      encoding_fields :: List.of(BitField)):
  constructor (name :: NonemptyString,
               format :: InstructionFormat,
               requirements :: NonemptyList.of(FieldConstraint)):
    def encoding = InstructionEncoding(requirements)
    when (encoding.care bits.and format.variable_mask) != 0
    | error(~who: #'InstructionSpec,
            "fixed encoding requirements overlap variable instruction fields")
    unless (encoding.care bits.or format.variable_mask) == width_mask(32)
    | error(~who: #'InstructionSpec,
            "encoding requirements and format fields must cover 32 bits")
    super(name,
          format,
          requirements,
          encoding,
          format.operands,
          format.immediate,
          format.variable_fields)

  method matches(word :: Nat):
    encoding.matches(word)

class InstructionCatalog(name :: NonemptyString,
                         revision :: NonemptyString,
                         instructions :: NonemptyList.of(InstructionSpec)):
  constructor (name :: NonemptyString,
               revision :: NonemptyString,
               instructions :: NonemptyList.of(InstructionSpec)):
    for (instruction in instructions):
      when instructions.filter(
        ~keep: fun (candidate): candidate.name == instruction.name
      ).length() != 1
      | error(~who: #'InstructionCatalog,
              "duplicate instruction name " ++ instruction.name)
    for (left_index in 0..instructions.length()):
      for (right_index in (left_index + 1)..instructions.length()):
        def left = instructions[left_index]
        def right = instructions[right_index]
        when left.encoding.overlaps(right.encoding)
        | error(~who: #'InstructionCatalog,
                String.append("instruction encodings overlap: ",
                              left.name,
                              " and ",
                              right.name))
    super(name, revision, instructions)

  method find(instruction_name :: String):
    def found = instructions.find(
      fun (candidate): candidate.name == instruction_name
    )
    unless found
    | error(~who: #'find, "unknown instruction " ++ instruction_name)
    found

  method matching(word :: Nat):
    instructions.find(fun (instruction): instruction.matches(word))

fun instruction(name :: NonemptyString,
                format :: InstructionFormat,
                requirement :: FieldConstraint || List.of(FieldConstraint), ...):
  def supplied = [requirement, ...]
  def requirements:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  InstructionSpec(name, format, requirements)
