#lang rhombus
// Checks host floating-point profiles and their implied extension support.

import:
  "../isa/fp-profile.rhm" open

check:
  DefaultFloatingPointProfile == FloatingPointProfile.None ~is #true
  floating_point_supports_f(FloatingPointProfile.None) ~is #false
  floating_point_supports_d(FloatingPointProfile.None) ~is #false
  floating_point_supports_f(FloatingPointProfile.F) ~is #true
  floating_point_supports_d(FloatingPointProfile.F) ~is #false
  floating_point_supports_f(FloatingPointProfile.D) ~is #true
  floating_point_supports_d(FloatingPointProfile.D) ~is #true
