#lang rhombus
// Checks compressed catalogs, XLEN distinctions, and expander elaboration.

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../isa/c.rhm" open
  "../isa/fp-profile.rhm" open
  "../isa/xlen.rhm" open
  "../rtl/compressed.rhdl" open

def rv32_design = embedded.run_elaboration(
  fun (): RiscvCompressedExpander(XLen.X32, FloatingPointProfile.F)
)
def rv64_design = embedded.run_elaboration(
  fun (): RiscvCompressedExpander(XLen.X64, FloatingPointProfile.D)
)
def rv32d_design = embedded.run_elaboration(
  fun (): RiscvCompressedExpander(XLen.X32, FloatingPointProfile.D)
)
def addi = RV32CInteger.matching(0x0085)
def lui_hint = RV64CInteger.matching(0x6005)
fun expansions_match_targets(catalog :: CompressedInstructionCatalog):
  for all (word in 0..0x10000):
    def instruction = catalog.matching(word)
    if instruction
    | instruction.expansion.target.matches(instruction.expand(word))
    | #true

check:
  RV64CInteger.find("C.ADDIW").name ~is "C.ADDIW"
  addi.name ~is "C.ADDI"
  addi.expand(0x0085) ~is 0x00108093
  lui_hint.name ~is "C.LUI"
  lui_hint.expand(0x6005) ~is 0x00001037
  RV64CInteger.matching(0x0000) ~is #false
  RV64CInteger.matching(0x6081) ~is #false
  RV64CInteger.matching(0x6101) ~is #false
  RV64CInteger.matching(0x2005) ~is #false
  RV64CInteger.matching(0x2085).name ~is "C.ADDIW"
  RV32CInteger.matching(0x2085).name ~is "C.JAL"
  RV64CInteger.matching(0x9002).name ~is "C.EBREAK"
  RV32CFloat.matching(0x6000).name ~is "C.FLW"
  RV32CDouble.matching(0x2000).name ~is "C.FLD"
  RV64CDouble.matching(0x2000).name ~is "C.FLD"
  expansions_match_targets(RV32CInteger) ~is #true
  expansions_match_targets(RV64CInteger) ~is #true
  expansions_match_targets(RV32CFloat) ~is #true
  expansions_match_targets(RV32CDouble) ~is #true
  expansions_match_targets(RV64CDouble) ~is #true
  verify_design(rv32_design) ~is #void
  verify_design(rv64_design) ~is #void
  verify_design(rv32d_design) ~is #void
