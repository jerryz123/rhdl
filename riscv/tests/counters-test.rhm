#lang rhombus
// Checks reusable RISC-V base-counter widths, state, ports, and elaboration.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../isa/xlen.rhm" open
  "../rhdl/counters.rhdl" as counters

fun state_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))

def rv64_design = embedded.run_elaboration(fun (): counters.RiscvBaseCounters(XLen.X64))
def rv32_design = embedded.run_elaboration(fun (): counters.RiscvBaseCounters(XLen.X32))
def rv64 = rv64_design.modules[0]
def rv32 = rv32_design.modules[0]

check:
  rv64.find_input("machine_write_in").type.field("bits").type.field("value").type.width ~is 64
  rv32.find_input("machine_write_in").type.field("bits").type.field("value").type.width ~is 32
  rv64.find_output("cycle").type.width ~is 64
  rv32.find_output("instret").type.width ~is 64
  state_names(rv64) ~is ["cycle_counter", "instret_counter"]
  state_names(rv32) ~is ["cycle_counter", "instret_counter"]
  verify_design(rv64_design) ~is #void
  verify_design(rv32_design) ~is #void
