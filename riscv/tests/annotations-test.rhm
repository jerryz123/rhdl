#lang rhombus
// Checks typed control defaults, complete materialization, and strict layer composition.

import:
  "../annotations/main.rhm" open
  "../isa/rv64i.rhm" open

class Operation(name)
def NoOperation = Operation("none")
def AddOperation = Operation("add")

def operation = ControlKey(
  "operation",
  fun (value): value is_a Operation,
  ~default: NoOperation
)
def writes_register = ControlKey(
  "writes_register",
  fun (value): value is_a Boolean,
  ~default: #false
)
def issue_width = ControlKey(
  "issue_width",
  fun (value): value is_a Int && value > 0,
  ~default: 1
)

def execution = ControlLayer(
  "execution",
  RV64I,
  [operation, writes_register],
  [control(ADD, operation(AddOperation), writes_register(#true))]
)
def scheduling = ControlLayer(
  "scheduling",
  RV64I,
  [issue_width],
  [control(ADD, issue_width(2))]
)
def annotated = annotate(RV64I, execution, scheduling)

check:
  annotated.instructions.length() ~is RV64I.instructions.length()
  annotated.find("ADD").instruction === ADD ~is #true
  annotated.find("ADD").control(operation) === AddOperation ~is #true
  annotated.find("ADD").control(writes_register) ~is #true
  annotated.find("ADD").control(issue_width) ~is 2
  annotated.find("SUB").control(operation) === NoOperation ~is #true
  annotated.find("SUB").control(writes_register) ~is #false
  annotated.find("SUB").control(issue_width) ~is 1

check:
  ControlKey("positive", fun (value): value is_a Int && value > 0, ~default: 0) ~throws "default value is invalid"
  operation("add") ~throws "invalid value"
  ControlLayer("missing", RV64I, [ControlKey("required", fun (value): value is_a Int)], []) ~throws "missing required control"
  AnnotatedCatalog(RV64I, [execution, ControlLayer("duplicate", RV64I, [operation], [])]) ~throws "multiple layers"
