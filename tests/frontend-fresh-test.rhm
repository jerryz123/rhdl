#lang rhombus
// Checks that repeated frontend generator calls create fresh module definitions.

import:
  "../rhdl/main.rhm" open
  "frontend/fresh-generators.rhdl" open

check:
  design.modules.map(fun (module_def): module_def.name) ~is ["Top8", "Adder8", "Adder8_1"]
  design.modules.filter(~keep: fun (module_def): module_def.name.starts_with("Adder8")).length() ~is 2
  verify_design(design) ~is #void
