#lang rhombus

import:
  "../rhdl/main.rhm" open
  "support.rhm" open

def [adder_design, _, _, _, _, _, _] = make_adder_design()
def adder_sv = emit_systemverilog(adder_design)

check:
  adder_sv.contains("module Adder8") ~is #true
  adder_sv.contains("assign result = a + b;") ~is #true
  adder_sv.contains("assign sum = result;") ~is #true
  adder_sv ~is emit_systemverilog(adder_design)

def [counter_design, _, _, _, _] = make_counter_design()
def counter_sv = emit_systemverilog(counter_design)

check:
  counter_sv.contains("always_ff @(posedge clk)") ~is #true
  counter_sv.contains("if (reset)") ~is #true
  counter_sv.contains("state <= next;") ~is #true

def [hierarchy_design, _, _, _, _, _] = make_hierarchy_design()
def hierarchy_sv = emit_systemverilog(hierarchy_design)

check:
  hierarchy_sv.contains("Adder8 u0") ~is #true
  hierarchy_sv.contains("Adder8 u1") ~is #true
  hierarchy_sv.contains(".sum(u0_sum)") ~is #true
