#lang rhombus
// Checks deterministic public RHDL IR printing for combinational and sequential designs.

import:
  "../rhdl/main.rhm" open
  "support.rhm" open

def [design, _, _, _, _, _, _] = make_adder_design()
def first = dump_ir(design)
def second = dump_ir(design)

check:
  first ~is second
  first.contains("rhdl.module @Adder8") ~is #true
  first.contains("%result = rtl.add %a, %b : bits<8>") ~is #true
  first.contains("rtl.drive &sum, %result") ~is #true

def [counter_design, _, _, _, _] = make_counter_design()
def counter_ir = dump_ir(counter_design)

check:
  counter_ir.contains("rtl.register clock %clk reset %reset to %zero") ~is #true
  counter_ir.contains("rtl.drive &state.next, %next") ~is #true

def [alu_design, _, _, _, _, _, _, _] = make_alu_design()
def alu_ir = dump_ir(alu_design)

check:
  alu_ir.contains("%not_result = rtl.not %a : bits<8>") ~is #true
  alu_ir.contains("%equal_result = rtl.eq %a, %b : bits<1>") ~is #true
  alu_ir.contains("%selected = rtl.mux %is_and, %and_result, %select_or : bits<8>") ~is #true
