#lang rhdl
// Composes the FESVR host with a stub processor and shared simulation memory.

import:
  "../../sim/fesvr/direct-memory-htif.rhdl".FesvrHost
  "../../sim/fesvr/shared-memory.rhdl".FesvrSharedMemory
  "stub-core.rhdl".FesvrStubCore

// This is an integration fixture, not the future processor harness API. A real
// top-level core can replace only FesvrStubCore while retaining the host,
// arbitration, memory, and DPI support owned by sim/fesvr.
sync_circuit FesvrStubHarness():
  output exit: Bits(32)

  inst host(FesvrHost())
  inst processor(FesvrStubCore())
  inst memory(FesvrSharedMemory(32,
                                4,
                                0x2000,
                                ~base_address: 0x80000000))

  memory.fesvr <=> host.memory
  memory.processor <=> processor.memory
  processor.start <=> host.start
  exit <== host.exit

def design = elaborate(FesvrStubHarness())

export:
  FesvrStubHarness
  design
