#lang rhombus
// Checks the FESVR requester and its independently validated REQ, RSP, and DAT NoC planes.

import:
  "../../rhdl/core/main.rhm" open
  "../../sim/fesvr/direct-memory-htif.rhdl" as host
  "../../sim/fesvr/chi-top.rhdl" as soc

def soc_design = soc.design
def requester_top = soc_design.modules.find(
  fun (module_def): module_def.name == "FesvrRequester"
)
def soc_top = soc_design.modules.find(
  fun (module_def): module_def.name == "FesvrTop"
)
def module_names = soc_design.modules.map(fun (module_def): module_def.name)

check:
  requester_top.name ~is "FesvrRequester"
  requester_top.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "port_in", "start_in"
  ]
  requester_top.outputs.map(fun (port): port.name) ~is [
    "port_out", "start_out", "exit"
  ]
  soc_design.dpi_imports.map(fun (dpi): dpi.name) ~is ["rhdl_htif_tick"]
  module_names.contains("CHIHNI") ~is #true
  module_names.contains("CHIRam") ~is #true
  module_names.contains("SimpleRouter") ~is #true
  module_names.contains("CHIReqNoCInjector") ~is #true
  module_names.contains("CHIReqNoCEjector") ~is #true
  module_names.contains("CHIRspNoCInjector") ~is #true
  module_names.contains("CHIRspNoCEjector") ~is #true
  module_names.contains("CHIDatNoCInjector") ~is #true
  module_names.contains("CHIDatNoCEjector") ~is #true
  soc.fesvr_topology.injections ~is []
  soc.fesvr_topology.ejections ~is []
  soc.fesvr_compilations.req.network.validated_routing.dependency_graph.vertices ~is []
  soc.fesvr_compilations.rsp.network.validated_routing.dependency_graph.vertices ~is []
  soc.fesvr_compilations.dat.network.validated_routing.dependency_graph.vertices ~is []
  soc.fesvr_compilations.req.routes.map(
    fun (route):
      [route.source.node_id,
       route.destination.node_id,
       route.route_key]
  ) ~is [[3, 5, 0]]
  soc.fesvr_req_router_config.input_count ~is 1
  soc.fesvr_req_router_config.target_count ~is 1
  soc.fesvr_rsp_router_config.input_count ~is 2
  soc.fesvr_rsp_router_config.target_count ~is 2
  soc.fesvr_dat_router_config.input_count ~is 2
  soc.fesvr_dat_router_config.target_count ~is 2
  soc.fesvr_adapter_plans.req.injections.length() ~is 1
  soc.fesvr_adapter_plans.rsp.injections.length() ~is 2
  soc.fesvr_adapter_plans.dat.injections.length() ~is 2
  soc.fesvr_requester_site.req.terminal.describe() ~is "requester/req"
  soc.fesvr_home_requester_site.req.terminal.describe() ~is "home/requester/req"
  soc_top.name ~is "FesvrTop"
  soc_top.inputs.map(fun (port): port.name) ~is ["clock", "reset"]
  soc_top.outputs.map(fun (port): port.name) ~is ["loaded", "entry", "exit"]

  verify_design(soc_design) ~is #void
