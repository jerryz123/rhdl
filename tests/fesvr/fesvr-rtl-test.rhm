#lang rhombus
// Checks the native RN-I FESVR host and its direct HN-I-to-SN-I composition.

import:
  "../../rhdl/core/main.rhm" open
  "../../sim/fesvr/direct-memory-htif.rhdl" as host
  "../../sim/fesvr/chi-top.rhdl" as soc

def soc_design = soc.design
def host_top = soc_design.modules.find(
  fun (module_def): module_def.name == "FesvrHost"
)
def soc_top = soc_design.modules.find(
  fun (module_def): module_def.name == "FesvrTop"
)
def module_names = soc_design.modules.map(fun (module_def): module_def.name)

check:
  host_top.name ~is "FesvrHost"
  host_top.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "memory_in", "start_in"
  ]
  host_top.outputs.map(fun (port): port.name) ~is [
    "memory_out", "start_out", "exit"
  ]
  soc_design.dpi_imports.map(fun (dpi): dpi.name) ~is ["rhdl_htif_tick"]
  module_names.contains("CHIHNI") ~is #true
  module_names.contains("CHIRam") ~is #true
  soc_top.name ~is "FesvrTop"
  soc_top.inputs.map(fun (port): port.name) ~is ["clock", "reset"]
  soc_top.outputs.map(fun (port): port.name) ~is ["loaded", "entry", "exit"]

  verify_design(soc_design) ~is #void
