#lang rhombus
// Checks the canonical HardwareType abstraction and Bits-specific predicates.

import:
  "../../rhdl/core/main.rhm" open

class ExtensionType(name):
  implements DataType
  override method describe(): "extension<" ++ name ++ ">"
  override method type_equal(other):
    other is_a ExtensionType && name == other.name

class ExtensionBits(name):
  implements BitwiseType
  override method describe(): "extension-bits<" ++ name ++ ">"
  override method type_equal(other):
    other is_a ExtensionBits && name == other.name
  override method bit_width(): 1

def bits8 = Bits(8)
def another_bits8 = Bits(8)
def bits4 = Bits(4)
def extension = ExtensionType("packet")
def same_extension = ExtensionType("packet")
def other_extension = ExtensionType("control")
def extension_bits = ExtensionBits("flag")
def same_extension_bits = ExtensionBits("flag")

check:
  bits8 is_a HardwareType ~is #true
  hardware_type(bits8) ~is #true
  type_well_formed(bits8) ~is #true
  bits_type(bits8) ~is #true
  type_equal(bits8, Bits(1)) ~is #false
  type_equal(Bits(1), Bits(1)) ~is #true
  clock_type(Clock) ~is #true
  reset_type(Reset) ~is #true
  flat_data_type(bits8) ~is #true
  bitwise_type(bits8) ~is #true
  data_type(Clock) ~is #false
  data_type(Reset) ~is #false
  data_type(extension_bits) ~is #true
  flat_data_type(extension_bits) ~is #true
  bitwise_type(extension_bits) ~is #true
  data_width(extension_bits) ~is 1
  type_equal(extension_bits, same_extension_bits) ~is #true
  type_equal(extension_bits, Bits(1)) ~is #false
  type_equal(Clock, Clock) ~is #true
  type_equal(Reset, Reset) ~is #true
  type_equal(bits8, another_bits8) ~is #true
  type_equal(bits8, bits4) ~is #false
  hardware_type(extension) ~is #true
  type_well_formed(extension) ~is #true
  bits_type(extension) ~is #false
  type_equal(extension, same_extension) ~is #true
  type_equal(extension, other_extension) ~is #false
  type_equal(extension, bits8) ~is #false
  schema_for("rtl.add").type_rule ~is "bits_same_width_binary"
  schema_for("rtl.mux_lookup").type_rule ~is "data_mux_lookup"
  schema_for("rtl.register").type_rule ~is "data_register"
  schema_for("rtl.register_reset").type_rule ~is "data_register_reset"
  schema_for("rtl.cast").type_rule ~is "packed_cast"
  schema_for("rtl.drive").type_rule ~is "type_equal_drive"
  schema_for("rtl.record_create").type_rule ~is "record_create"
  schema_for("rtl.record_get").print_form ~is "record_get"

def pair8 = RecordType([RecordField("left", Bits(8)),
                        RecordField("right", Bits(8))])
def another_pair8 = RecordType([RecordField("left", Bits(8)),
                                RecordField("right", Bits(8))])
def reversed_pair8 = RecordType([RecordField("right", Bits(8)),
                                 RecordField("left", Bits(8))])
def nested_pair = RecordType([RecordField("payload", pair8),
                              RecordField("valid", Bits(1))])
def opaque_record = RecordType([RecordField("payload", extension)])

check:
  record_type(pair8) ~is #true
  data_type(pair8) ~is #true
  flat_data_type(pair8) ~is #false
  bitwise_type(pair8) ~is #false
  packed_width(bits8) ~is 8
  packed_width(pair8) ~is 16
  packed_width(nested_pair) ~is 17
  packed_width(Clock) ~is 1
  packed_width(Reset) ~is 1
  packed_width(extension) ~is #false
  packed_width(opaque_record) ~is #false
  packable_type(pair8) ~is #true
  cast_compatible(pair8, Bits(16)) ~is #true
  cast_compatible(pair8, Bits(15)) ~is #false
  cast_compatible(Clock, extension_bits) ~is #true
  type_well_formed(nested_pair) ~is #true
  type_equal(pair8, another_pair8) ~is #true
  type_equal(pair8, reversed_pair8) ~is #false
  pair8.field("left").type.width ~is 8
  RecordType([]) ~throws "nonempty List"
  RecordType([RecordField("value", Bits(1)),
              RecordField("value", Bits(1))]) ~throws "unique"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("LayeredType")
  def clock = builder.input(module_def, "clock", Clock)
  def reset = builder.input(module_def, "reset", Reset)
  def select = builder.input(module_def, "select", Bits(1))
  def raw_control = builder.input(module_def, "raw_control", Bits(1))
  def extension_control = builder.input(module_def, "extension_control", extension_bits)
  def lookup_select = builder.input(module_def, "lookup_select", Bits(2))
  def source = builder.input(module_def, "source", extension)
  def alternate = builder.input(module_def, "alternate", same_extension)
  def target = builder.output(module_def, "target", same_extension)
  def selected = builder.mux_lookup(module_def, select, source, [[1, alternate]])
  def converted_flat = builder.cast(module_def, raw_control, extension_bits)
  def converted_clock = builder.cast(module_def, raw_control, Clock)
  def converted_reset = builder.cast(module_def, raw_control, Reset)
  def converted_bits = builder.cast(module_def, converted_reset, Bits(1))
  def inverted = builder.bit_not(module_def, extension_control)
  def combined = builder.bit_and(module_def, extension_control, converted_flat)
  def lookup = builder.mux_lookup(module_def,
                                  lookup_select,
                                  source,
                                  [[2, alternate], [0, selected]])
  def state = builder.register(module_def,
                               "state",
                               same_extension,
                               clock,
                               reset,
                               source)
  builder.drive(state.next, lookup)
  builder.drive(target, state.current)
  check:
    builder.add(module_def, source, source) ~throws "same Bits width"
    lookup.module_def.find_operation(lookup.defining_op_id).attribute("keys") ~is [0, 2]
    lookup.module_def.find_operation(lookup.defining_op_id).opcode ~is "rtl.mux_lookup"
    type_equal(converted_flat.type, extension_bits) ~is #true
    clock_type(converted_clock.type) ~is #true
    reset_type(converted_reset.type) ~is #true
    type_equal(converted_bits.type, Bits(1)) ~is #true
    type_equal(inverted.type, extension_bits) ~is #true
    type_equal(combined.type, extension_bits) ~is #true
  def finished = builder.finish(module_def)
  verify_design(design)

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("Records")
  def clock = builder.input(module_def, "clock", Clock)
  def reset = builder.input(module_def, "reset", Reset)
  def select = builder.input(module_def, "select", Bits(1))
  def left = builder.input(module_def, "left", Bits(8))
  def right = builder.input(module_def, "right", Bits(8))
  def output = builder.output(module_def, "output", pair8)
  def initial = builder.record_create(module_def,
                                      pair8,
                                      [["right", right], ["left", left]],
                                      "initial")
  def initial_left = builder.record_get(module_def, initial, "left", "initial_left")
  def packed = builder.cast(module_def, initial, Bits(16), "packed")
  def unpacked = builder.cast(module_def, packed, pair8, "unpacked")
  def alternate = builder.record_create(module_def,
                                        pair8,
                                        [["left", right], ["right", left]],
                                        "alternate")
  def selected = builder.mux_lookup(module_def,
                                    select,
                                    initial,
                                    [[1, alternate]],
                                    "selected")
  def state = builder.register(module_def,
                               "state",
                               pair8,
                               clock,
                               reset,
                               initial)
  builder.drive(state.next, selected)
  builder.drive(builder.project(output, "left"),
                builder.record_get(module_def, state.current, "right"))
  builder.drive(builder.project(output, "right"), initial_left)
  def finished = builder.finish(module_def)
  check:
    output.driver.type.type_equal(pair8) ~is #true
    packed.type.type_equal(Bits(16)) ~is #true
    unpacked.type.type_equal(pair8) ~is #true
    module_def.operations.filter(
      ~keep: fun (operation): operation.opcode == "rtl.record_create"
    ).length() ~is 3
    module_def.operations.filter(
      ~keep: fun (operation): operation.opcode == "rtl.drive" && operation.places[0] === output
    ).length() ~is 1
    verify_design(design) ~is #void
