#lang rhombus
// Covers builder rejection and whole-design verification of malformed RHDL IR.

import:
  "../../rhdl/core/main.rhm" open

check:
  Bits(0) ~throws "width must be a positive host Int"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadWidth")
  check:
    builder.input(module_def, "a", "not a type") ~throws "expected a well-formed HardwareType"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadConnectionType")
  def source = builder.input(module_def, "source", Bits(4))
  def target = builder.output(module_def, "target", Bits(8))
  check:
    builder.drive(target, source) ~throws "same hardware type"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadConstant")
  check:
    builder.constant(module_def, Bits(4), 16) ~throws "does not fit bits<4>"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadAdd")
  def a = builder.input(module_def, "a", Bits(4))
  def b = builder.input(module_def, "b", Bits(8))
  check:
    builder.add(module_def, a, b) ~throws "same Bits width"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadCombinationalWidths")
  def select = builder.input(module_def, "select", Bits(1))
  def four_bits = builder.input(module_def, "four_bits", Bits(4))
  def eight_bits = builder.input(module_def, "eight_bits", Bits(8))
  check:
    builder.bit_and(module_def, four_bits, eight_bits) ~throws "same bitwise type"
    builder.bit_or(module_def, four_bits, eight_bits) ~throws "same bitwise type"
    builder.bit_xor(module_def, four_bits, eight_bits) ~throws "same bitwise type"
    builder.sub(module_def, four_bits, eight_bits) ~throws "same Bits width"
    builder.eq(module_def, four_bits, eight_bits) ~throws "same Bits width"
    builder.mux_lookup(module_def, select, four_bits, [[1, eight_bits]]) ~throws "same DataType"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadWidthChangingOperations")
  def four_bits = builder.input(module_def, "four_bits", Bits(4))
  def eight_bits = builder.input(module_def, "eight_bits", Bits(8))
  check:
    builder.concat(module_def, four_bits) ~throws "supplied as a List"
    builder.concat(module_def, [four_bits]) ~throws "at least two operands"
    builder.extract(module_def, eight_bits, "five", 2) ~throws "host Int"
    builder.extract(module_def, eight_bits, 8, 2) ~throws "0 <= low <= high < source width"
    builder.extract(module_def, eight_bits, 2, 5) ~throws "0 <= low <= high < source width"
    builder.zext(module_def, eight_bits, 8) ~throws "larger than the source width"
    builder.zext(module_def, eight_bits, 4) ~throws "larger than the source width"
    builder.trunc(module_def, eight_bits, 8) ~throws "smaller than the source width"
    builder.trunc(module_def, four_bits, 8) ~throws "smaller than the source width"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadMuxLookup")
  def selector = builder.input(module_def, "selector", Bits(2))
  def value = builder.input(module_def, "value", Bits(4))
  def clock = builder.input(module_def, "clock", Clock)
  check:
    builder.mux_lookup(module_def, selector, value, []) ~throws "at least one case"
    builder.mux_lookup(module_def, selector, value, [["zero", value]]) ~throws "host Int"
    builder.mux_lookup(module_def, selector, value, [[4, value]]) ~throws "does not fit"
    builder.mux_lookup(module_def, selector, value, [[1, value], [1, value]]) ~throws "unique"
    builder.mux_lookup(module_def, clock, value, [[0, value]]) ~throws "selector must be Bits"
    builder.mux_lookup(module_def, selector, clock, [[0, clock]]) ~throws "DataType"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MalformedExtract")
  def operand = builder.input(module_def, "operand", Bits(8))
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "result", Bits(3), module_def, operation_id)
  def operation = Operation(operation_id,
                            "rtl.extract",
                            module_def,
                            [operand],
                            [result],
                            [],
                            {"name": "result", "high": 5, "low": 2})
  operand.add_user(operation_id)
  module_def.add_value(result)
  module_def.add_operation(operation)
  def finished = builder.finish(module_def)
  check:
    verify_design(design) ~throws "extract result width does not match its indices"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MalformedMuxLookup")
  def selector = builder.input(module_def, "selector", Bits(2))
  def default_value = builder.input(module_def, "default_value", Bits(4))
  def first = builder.input(module_def, "first", Bits(4))
  def second = builder.input(module_def, "second", Bits(4))
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "result", Bits(4), module_def, operation_id)
  def operation = Operation(operation_id,
                            "rtl.mux_lookup",
                            module_def,
                            [selector, default_value, first, second],
                            [result],
                            [],
                            {"name": "result", "keys": [1, 0]})
  for (operand in operation.operands):
    operand.add_user(operation_id)
  module_def.add_value(result)
  module_def.add_operation(operation)
  def finished = builder.finish(module_def)
  check:
    verify_design(design) ~throws "unique and increasing"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MalformedConcat")
  def left = builder.input(module_def, "left", Bits(4))
  def right = builder.input(module_def, "right", Bits(4))
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "result", Bits(7), module_def, operation_id)
  def operation = Operation(operation_id,
                            "rtl.concat",
                            module_def,
                            [left, right],
                            [result],
                            [],
                            {"name": "result"})
  left.add_user(operation_id)
  right.add_user(operation_id)
  module_def.add_value(result)
  module_def.add_operation(operation)
  def finished = builder.finish(module_def)
  check:
    verify_design(design) ~throws "sum of its operand widths"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MalformedExtension")
  def operand = builder.input(module_def, "operand", Bits(8))
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "result", Bits(4), module_def, operation_id)
  def operation = Operation(operation_id,
                            "rtl.zext",
                            module_def,
                            [operand],
                            [result],
                            [],
                            {"name": "result", "target_width": 4})
  operand.add_user(operation_id)
  module_def.add_value(result)
  module_def.add_operation(operation)
  def finished = builder.finish(module_def)
  check:
    verify_design(design) ~throws "larger than the source width"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MalformedTruncation")
  def operand = builder.input(module_def, "operand", Bits(4))
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "result", Bits(8), module_def, operation_id)
  def operation = Operation(operation_id,
                            "rtl.trunc",
                            module_def,
                            [operand],
                            [result],
                            [],
                            {"name": "result", "target_width": 8})
  operand.add_user(operation_id)
  module_def.add_value(result)
  module_def.add_operation(operation)
  def finished = builder.finish(module_def)
  check:
    verify_design(design) ~throws "smaller than the source width"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("Undriven")
  def output = builder.output(module_def, "out", Bits(1))
  def finished = builder.finish(module_def)
  check:
    verify_design(design) ~throws "place out is undriven"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MultipleDrive")
  def a = builder.input(module_def, "a", Bits(8))
  def b = builder.input(module_def, "b", Bits(8))
  def sum = builder.output(module_def, "sum", Bits(8))
  def result = builder.add(module_def, a, b)
  builder.drive(sum, result)
  check:
    builder.drive(sum, result) ~throws "already has a driver"
    builder.drive(a, b) ~throws "drive target must be a hardware Place"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("ReadBeforeDrive")
  def output = builder.output(module_def, "out", Bits(1))
  check:
    builder.read(output) ~throws "must be driven before it is read"

block:
  def design = Design()
  def builder = Builder(design)
  def left = builder.module("Left")
  def right = builder.module("Right")
  def source = builder.input(left, "source", Bits(1))
  def target = builder.output(right, "target", Bits(1))
  check:
    builder.drive(target, source) ~throws "different module"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadClock")
  def clock = builder.input(module_def, "clock", Bits(2))
  def real_clock = builder.input(module_def, "real_clock", Clock)
  check:
    builder.register(module_def, "state", Bits(8), clock) ~throws "clock must be Clock"
    builder.register(module_def, "clock_state", Clock, real_clock) ~throws "expected a DataType"

block:
  def design = Design()
  def module_def = Module(design, design.fresh_id(), "Cycle")
  design.add_module(module_def)
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "result", Bits(8), module_def, operation_id)
  def add_operation = Operation(operation_id,
                                "rtl.add",
                                module_def,
                                [result, result],
                                [result],
                                [],
                                {"name": "result"})
  result.add_user(operation_id)
  result.add_user(operation_id)
  module_def.add_value(result)
  module_def.add_operation(add_operation)
  module_def.finished := #true
  check:
    verify_design(design) ~throws "combinational cycle reaches value result"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("Names")
  def a = builder.input(module_def, "a", Bits(8))
  check:
    builder.constant(module_def, Bits(8), 0, "a") ~throws "duplicate hardware name a"

block:
  def design = Design()
  def builder = Builder(design)
  def child = builder.module("Child")
  def child_in = builder.input(child, "in", Bits(1))
  def child_out = builder.output(child, "out", Bits(1))
  builder.drive(child_out, child_in)
  def finished_child = builder.finish(child)
  def top = builder.module("Top")
  def instance = builder.instance(top, child, "u")
  def top_out = builder.output(top, "out", Bits(1))
  builder.drive(top_out, instance.output("out"))
  def finished_top = builder.finish(top)
  check:
    verify_design(design) ~throws "place u.in is undriven"

block:
  def source_design = Design()
  def source_builder = Builder(source_design)
  def source_module = source_builder.module("Source")
  def foreign_value = source_builder.input(source_module, "value", Bits(1))
  def target_design = Design()
  def target_builder = Builder(target_design)
  def target_module = target_builder.module("Target")
  def target = target_builder.output(target_module, "target", Bits(1))
  check:
    source_module.id ~is target_module.id
    (source_module === target_module) ~is #false
    target_builder.drive(target, foreign_value) ~throws "different module"

block:
  def source_design = Design()
  def source_builder = Builder(source_design)
  def child = source_builder.module("Child")
  def child_input = source_builder.input(child, "input", Bits(1))
  def child_output = source_builder.output(child, "output", Bits(1))
  source_builder.drive(child_output, child_input)
  def finished_child = source_builder.finish(child)
  def target_design = Design()
  def target_builder = Builder(target_design)
  def top = target_builder.module("Top")
  check:
    child.id ~is top.id
    target_builder.instance(top, child, "u") ~throws "different design"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("Membership")
  def real = builder.input(module_def, "real", Bits(1))
  def forged = Value(design.fresh_id(), "forged", Bits(1), module_def, real.defining_op_id)
  check:
    builder.add(module_def, real, forged) ~throws "different module"

block:
  def design = Design()
  def builder = Builder(design)
  check:
    builder.module("Bad.Name") ~throws "ASCII identifier"
    builder.module("__rhdl_internal") ~throws "reserved"

block:
  def design = Design()
  def module_def = Module(design, design.fresh_id(), "MissingAttribute")
  design.add_module(module_def)
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "constant", Bits(1), module_def, operation_id)
  def operation = Operation(operation_id,
                            "rtl.constant",
                            module_def,
                            [],
                            [result],
                            [],
                            {"name": "constant"})
  module_def.add_value(result)
  module_def.add_operation(operation)
  module_def.finished := #true
  check:
    verify_design(design) ~throws "requires attribute value"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("IncompleteRecordDrive")
  def pair_type = RecordType([RecordField("left", Bits(8)),
                              RecordField("right", Bits(8))])
  def source = builder.input(module_def, "source", Bits(8))
  def target = builder.output(module_def, "target", pair_type)
  builder.drive(builder.project(target, "left"), source)
  check:
    builder.finish(module_def) ~throws "incomplete field-wise drivers"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MixedRecordDrive")
  def pair_type = RecordType([RecordField("left", Bits(8)),
                              RecordField("right", Bits(8))])
  def left = builder.input(module_def, "left", Bits(8))
  def right = builder.input(module_def, "right", Bits(8))
  def whole = builder.record_create(module_def,
                                    pair_type,
                                    [["left", left], ["right", right]])
  def target = builder.output(module_def, "target", pair_type)
  builder.drive(builder.project(target, "left"), left)
  check:
    builder.drive(target, whole) ~throws "cannot mix"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadRecordConstruction")
  def pair_type = RecordType([RecordField("left", Bits(8)),
                              RecordField("right", Bits(8))])
  def value = builder.input(module_def, "value", Bits(8))
  def narrow = builder.input(module_def, "narrow", Bits(4))
  check:
    builder.record_create(module_def,
                          pair_type,
                          [["left", value]]) ~throws "exactly one value"
    builder.record_create(module_def,
                          pair_type,
                          [["left", value], ["left", value]]) ~throws "unique"
    builder.record_create(module_def,
                          pair_type,
                          [["left", value], ["missing", value]]) ~throws "no field named missing"
    builder.record_create(module_def,
                          pair_type,
                          [["left", value], ["right", narrow]]) ~throws "wrong hardware type"
    builder.record_get(module_def, value, "left") ~throws "must have a RecordType"
    builder.record_get(module_def,
                       builder.record_create(module_def,
                                             pair_type,
                                             [["left", value], ["right", value]]),
                       "missing") ~throws "no field named missing"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("AtomicNestedRecordDrive")
  def pair_type = RecordType([RecordField("left", Bits(8)),
                              RecordField("right", Bits(8))])
  def envelope_type = RecordType([RecordField("payload", pair_type),
                                  RecordField("tag", Bits(2))])
  def value = builder.input(module_def, "value", Bits(8))
  def target = builder.output(module_def, "target", envelope_type)
  def payload = builder.project(target, "payload")
  builder.drive(builder.project(payload, "left"), value)
  builder.drive(builder.project(payload, "right"), value)
  check:
    builder.finish(module_def) ~throws "incomplete field-wise drivers"
    module_def.operations.filter(
      ~keep: fun (operation): operation.opcode == "rtl.record_create"
    ).length() ~is 0
