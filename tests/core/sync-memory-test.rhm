#lang rhombus
// Covers fixed synchronous-memory ports, ownership, typing, printing, and verification.

import:
  "../../rhdl/core/main.rhm" open

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("SyncMemoryCore")
  def clock = builder.input(module_def, "clock", Clock)
  def read_address = builder.input(module_def, "read_address", Bits(2))
  def read_enable = builder.input(module_def, "read_enable", Bits(1))
  def write_address = builder.input(module_def, "write_address", Bits(2))
  def write_data = builder.input(module_def, "write_data", Bits(8))
  def write_enable = builder.input(module_def, "write_enable", Bits(1))
  def read_data = builder.output(module_def, "read_data", Bits(8))
  def storage = builder.sync_memory(module_def,
                                    "storage",
                                    4,
                                    Bits(8),
                                    clock)
  builder.drive(storage.read_port.address, read_address)
  builder.drive(storage.read_port.enable, read_enable)
  builder.drive(storage.write_port.address, write_address)
  builder.drive(storage.write_port.data, write_data)
  builder.drive(storage.write_port.enable, write_enable)
  builder.drive(read_data, storage.read_port.data)
  builder.finish(module_def)
  check:
    storage.operation.opcode ~is "rtl.sync_memory"
    storage.operation.places.length() ~is 5
    storage.operation.results.length() ~is 1
    storage.read_port.data.type.width ~is 8
    dump_ir(design).contains("rtl.sync_memory @storage depth 4 clock %clock") ~is #true
    dump_ir(design).contains("read(address &storage.read.address") ~is #true
    dump_ir(design).contains("write(address &storage.write.address") ~is #true
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadSyncMemory")
  def clock = builder.input(module_def, "clock", Clock)
  def not_clock = builder.input(module_def, "not_clock", Bits(1))
  check:
    builder.sync_memory(module_def, "empty", 4, Bits(8), clock, #false, #false) ~throws "requires a read or write port"
    builder.sync_memory(module_def, "bad_depth", 0, Bits(8), clock) ~throws "positive host Int"
    builder.sync_memory(module_def, "bad_clock", 4, Bits(8), not_clock) ~throws "clock must be Clock"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("UndrivenSyncMemory")
  def clock = builder.input(module_def, "clock", Clock)
  def storage = builder.sync_memory(module_def,
                                    "storage",
                                    4,
                                    Bits(8),
                                    clock,
                                    #true,
                                    #false)
  builder.finish(module_def)
  check:
    verify_design(design) ~throws "storage.read.address is undriven"
