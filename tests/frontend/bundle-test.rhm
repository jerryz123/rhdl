#lang rhombus
// Checks bundle syntax as a frontend layer over canonical core record semantics.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../examples/bundle.rhdl" as bundle_fixture

def pipeline_design = bundle_fixture.design
def pipeline = pipeline_design.modules[0]
def pair_type = bundle_fixture.Pair(Bits(8))
def selected = pipeline.operations.find(
  fun (operation): operation.opcode == "rtl.mux_lookup"
)
def state = pipeline.operations.find(
  fun (operation): operation.opcode == "rtl.register_reset"
)
def swap_design = embedded.run_elaboration(fun (): bundle_fixture.Swap(8))
def swap = swap_design.modules[0]
def nested_design = embedded.run_elaboration(fun (): bundle_fixture.NestedSwap(8))
def nested = nested_design.modules[0]
def hierarchy_design = embedded.run_elaboration(fun (): bundle_fixture.BundleHierarchy(8))
def hierarchy = hierarchy_design.modules.find(
  fun (module_def): module_def.name.starts_with("BundleHierarchy")
)
def hierarchy_instance = hierarchy.operations.find(
  fun (operation): operation.opcode == "rtl.instance"
)
def swap_ir = dump_ir(swap_design)

check:
  record_type(pair_type) ~is #true
  pair_type.fields.map(fun (field): field.name) ~is ["left", "right"]
  type_equal(pipeline.find_input("direct").type, pair_type) ~is #true
  type_equal(pipeline.find_output("result").type, pair_type) ~is #true
  type_equal(selected.results[0].type, pair_type) ~is #true
  type_equal(state.results[0].type, pair_type) ~is #true
  type_equal(state.places[0].type, pair_type) ~is #true
  pipeline.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.record_create"
  ).length() ~is 1
  swap.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.record_get"
  ).length() ~is 2
  swap.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.record_create"
  ).length() ~is 1
  swap.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.drive"
  ).length() ~is 1
  record_type(nested.find_input("source").type.field("payload").type) ~is #true
  nested.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.record_create"
  ).length() ~is 2
  hierarchy_instance.places.length() ~is 1
  type_equal(hierarchy_instance.places[0].type, pair_type) ~is #true
  type_equal(hierarchy_instance.results[0].type, pair_type) ~is #true
  swap_ir.contains("record<left: bits<8>, right: bits<8>>") ~is #true
  swap_ir.contains("rtl.record_get %source.right") ~is #true
  swap_ir.contains("rtl.record_create {left:") ~is #true
  verify_design(pipeline_design) ~is #void
  verify_design(swap_design) ~is #void
  verify_design(nested_design) ~is #void
  verify_design(hierarchy_design) ~is #void
