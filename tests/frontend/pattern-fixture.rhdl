#lang rhdl
// Builds scalar, aggregate, and extension-defined host patterns for focused tests.

import:
  lib("rhdl/std/decode/pattern.rhdl") open
  "hardware-literal-fixture.rhdl" as literals

def bits_pattern = Pattern(
  ~value: bits(0b1010, 4),
  ~care: bits(0b1100, 4)
)

def bool_pattern = Pattern(
  ~value: Bool(#true),
  ~care: Bool(#true)
)

def enum_pattern = Pattern(
  ~value: literals.Mode.Run,
  ~care: literal(literals.Mode, 1)
)

def one_hot_pattern = Pattern(
  ~value: literals.Grant(2),
  ~care: literal(literals.Grant, 0b1111)
)

def nibble_pattern = Pattern(
  ~value: literals.NibbleLiteral(0b1010),
  ~care: literal(literals.Nibble, 0b1100)
)

def pair_care = record(literals.Pair()):
  left: bits(0b1111, 4)
  right: bits(0, 4)
def lane_care = vec(bits(0b1111, 4), bits(0b1000, 4))
def aggregate_care = record(literals.Aggregate()):
  pair: pair_care
  lanes: lane_care

def aggregate_pattern = Pattern(
  ~value: literals.aggregate_initial,
  ~care: aggregate_care
)

def matching_pair = record(literals.Pair()):
  left: bits(0b1010, 4)
  right: bits(0b1111, 4)
def matching_lanes = vec(bits(0b0100, 4), bits(0b0111, 4))
def aggregate_match = record(literals.Aggregate()):
  pair: matching_pair
  lanes: matching_lanes

def missing_pair = record(literals.Pair()):
  left: bits(0b1011, 4)
  right: bits(0b0011, 4)
def missing_lanes = vec(bits(0b0100, 4), bits(0b0101, 4))
def aggregate_miss = record(literals.Aggregate()):
  pair: missing_pair
  lanes: missing_lanes

export:
  bits_pattern
  bool_pattern
  enum_pattern
  one_hot_pattern
  nibble_pattern
  aggregate_care
  aggregate_pattern
  aggregate_match
  aggregate_miss
