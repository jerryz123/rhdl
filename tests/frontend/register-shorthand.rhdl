#lang rhdl/base
// Exercises inferred-type and immediate-next register forms in ambient and explicit domains.

import:
  lib("rhdl/frontend/layers/sequential.rhm") open
  lib("rhdl/frontend/layers/sync.rhm") open

sync_circuit AmbientShorthand():
  input(data_in, reset_only_next, init_value): Bits(8)
  output(a, b, c, d, e): Bits(8)

  reg inferred_init(~init: init_value)
  inferred_init.next <== data_in
  reg inferred_next(~next: data_in)
  reg inferred_both(~next: reset_only_next, ~init: init_value)
  reg typed(Bits(8))
  typed.next <== inferred_both
  reg typed_init(Bits(8), ~init: init_value)
  typed_init.next <== data_in

  a <== inferred_init
  b <== inferred_next
  c <== inferred_both
  d <== typed
  e <== typed_init

circuit ExplicitShorthand():
  input clock: Clock
  input reset: Reset
  input(data_in, init_value): Bits(8)
  output(a, b, c, d, e): Bits(8)

  reg inferred_init(~clock: clock, ~reset: reset, ~init: init_value)
  inferred_init.next <== data_in
  reg inferred_next(~next: data_in, ~clock: clock)
  reg inferred_both(~next: data_in,
                    ~clock: clock,
                    ~reset: reset,
                    ~init: init_value)
  reg typed(Bits(8), ~clock: clock)
  typed.next <== data_in
  reg typed_init(Bits(8),
                 ~clock: clock,
                 ~reset: reset,
                 ~init: init_value)
  typed_init.next <== data_in

  a <== inferred_init
  b <== inferred_next
  c <== inferred_both
  d <== typed
  e <== typed_init

sync_circuit DoubleDrive():
  input data_in: Bits(8)
  output result: Bits(8)

  reg state(~next: data_in)
  state.next <== data_in
  result <== state

export:
  AmbientShorthand
  ExplicitShorthand
  DoubleDrive
