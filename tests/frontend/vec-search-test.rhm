#lang rhombus
// Checks host-pattern vector construction, registered indexing, and lookup default.

import:
  "../../rhdl/core/main.rhm" open
  "../../examples/vec-search.rhdl" as fixture

def module_def = fixture.design.modules[0]
def vector_create = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.vector_create"
)
def lookup = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.mux_lookup"
)

fun defining_operation(value):
  module_def.find_operation(value.defining_op_id)

check:
  fixture.search_pattern ~is [0, 4, 15, 14, 2, 5, 13]
  module_def.name ~is "VecSearch"
  module_def.inputs.map(fun (port): port.name) ~is ["clock", "reset"]
  type_equal(module_def.find_output("out").type, Bits(4)) ~is #true
  type_equal(vector_create.results[0].type, VectorType(7, Bits(4))) ~is #true
  vector_create.operands.map(
    fun (value): defining_operation(value).attribute("value")
  ) ~is fixture.search_pattern
  lookup.attribute("keys") ~is [0, 1, 2, 3, 4, 5, 6]
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register_reset"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.add"
  ).length() ~is 1
  verify_design(fixture.design) ~is #void
