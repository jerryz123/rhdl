#lang rhombus
// Exhaustively checks router-local route ABIs and their RHDL decode operations.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/std/noc/route-computer.rhdl" open
  "../../noc/model/main.rhm" open
  "../../noc/plan/main.rhm" open
  "../../examples/std/noc-route-computer.rhdl" as fixture

fun decoded_result(abi, encoded_key):
  def table = abi.decoder(~espresso: #false).table
  def matching = table.cases.find(
    fun (case): case.input.value_bits == encoded_key
  )
  if matching
  | matching.output.value_bits
  | table.default.value_bits

fun expected_result(abi, encoded_key):
  def origin_mask = (1 bits.(<<) abi.origin_width) - 1
  def route_key = encoded_key bits.(>>) abi.origin_width
  def origin_key = encoded_key bits.and origin_mask
  def entry = abi.entry_for_keys(route_key, origin_key)
  if entry | entry.result_bits() | 0

fun decoded_results(abi):
  for List (key in 0..(1 bits.(<<) abi.key_width)):
    decoded_result(abi, key)

fun expected_results(abi):
  for List (key in 0..(1 bits.(<<) abi.key_width)):
    expected_result(abi, key)

fun materialized_mask(abi, entry):
  def mutable mask = 0
  for (vc in fixture.routing.materialized.allowed_candidates(
             entry.plan_row.route_row.route_class,
             entry.plan_row.route_row.origin
           )):
    mask := mask bits.or (1 bits.(<<) abi.output_bit(vc))
  mask

fun masks_match_materialized(abi):
  abi.entries.map(fun (entry): entry.allowed_mask) == abi.entries.map(
    fun (entry): materialized_mask(abi, entry)
  )

def source_abi = fixture.source_abi
def middle_abi = fixture.middle_abi
def destination_abi = fixture.destination_abi
def top = fixture.design.modules.find(
  fun (module_def): module_def.name == "RouteComputerFixture"
)

fun contains_decode(module_def):
  module_def.operations.find(
    fun (operation): operation.opcode == "rtl.decode"
  ) != #false

def decode_modules = fixture.design.modules.filter(
  ~keep: contains_decode
)

check:
  source_abi.router_plan === fixture.source_plan ~is #true
  source_abi.route_width ~is 1
  source_abi.origin_width ~is 1
  source_abi.key_width ~is 2
  source_abi.output_count ~is 2
  source_abi.mask_width ~is 2
  source_abi.encode(fixture.route, Injection(fixture.n0)) ~is 0
  source_abi.output_bit(VCId(fixture.first.id, 1)) ~is 1
  source_abi.entries.map(fun (entry): entry.encoded_key) ~is [0]
  source_abi.entries.map(fun (entry): entry.allowed_mask) ~is [0b11]
  source_abi.entries.map(fun (entry): entry.result_bits()) ~is [0b1101]
  masks_match_materialized(source_abi) ~is #true
  decoded_results(source_abi) ~is expected_results(source_abi)
  decoded_results(source_abi) ~is [0b1101, 0, 0, 0]

check:
  middle_abi.router_plan === fixture.middle_plan ~is #true
  middle_abi.route_width ~is 1
  middle_abi.origin_width ~is 1
  middle_abi.key_width ~is 2
  middle_abi.output_count ~is 2
  middle_abi.mask_width ~is 2
  middle_abi.encode(
    fixture.route,
    HeldVC(VCId(fixture.first.id, 1))
  ) ~is 1
  middle_abi.output_bit(VCId(fixture.second.id, 1)) ~is 1
  middle_abi.entries.map(fun (entry): entry.encoded_key) ~is [0, 1]
  middle_abi.entries.map(fun (entry): entry.allowed_mask) ~is [0b01, 0b10]
  middle_abi.entries.map(fun (entry): entry.result_bits()) ~is [0b0101, 0b1001]
  masks_match_materialized(middle_abi) ~is #true
  decoded_results(middle_abi) ~is expected_results(middle_abi)
  decoded_results(middle_abi) ~is [0b0101, 0b1001, 0, 0]

check:
  destination_abi.router_plan === fixture.destination_plan ~is #true
  destination_abi.route_width ~is 1
  destination_abi.origin_width ~is 1
  destination_abi.key_width ~is 2
  destination_abi.output_count ~is 0
  destination_abi.mask_width ~is 1
  destination_abi.entries.map(fun (entry): entry.encoded_key) ~is [0, 1]
  destination_abi.entries.map(fun (entry): entry.allowed_mask) ~is [0, 0]
  destination_abi.entries.map(fun (entry): entry.result_bits()) ~is [0b011, 0b011]
  masks_match_materialized(destination_abi) ~is #true
  decoded_results(destination_abi) ~is expected_results(destination_abi)
  decoded_results(destination_abi) ~is [0b011, 0b011, 0, 0]

check:
  top != #false ~is #true
  type_equal(top.find_input("source_route_key").type, Bits(1)) ~is #true
  type_equal(top.find_input("middle_origin_key").type, Bits(1)) ~is #true
  type_equal(top.find_output("source_allowed_mask").type, Bits(2)) ~is #true
  type_equal(top.find_output("middle_allowed_mask").type, Bits(2)) ~is #true
  type_equal(top.find_output("destination_allowed_mask").type, Bits(1)) ~is #true
  decode_modules.length() ~is 3
  verify_design(fixture.design) ~is #void

def isolated_node = NodeId(0)
def unused_node = NodeId(1)
def self_route = RouteClass(RouteClassId(0), isolated_node, isolated_node)
def no_vc_routing = compile_routing(
  RoutingProblem(
    Topology([unused_node, isolated_node], []),
    [self_route],
    RoutingRelation(fun (_route, _origin, _candidate): #false)
  )
)
def local_plan = RouterPlan(no_vc_routing, isolated_node)
def local_abi = RouteComputerABI(local_plan)
def unused_plan = RouterPlan(no_vc_routing, unused_node)

check:
  RouteComputerABI("not a plan") ~throws "RouterPlan"
  RouteComputerABI(no_vc_routing) ~throws "RouterPlan"
  RouteComputerABI(unused_plan) ~throws "at least one local route row"
  source_abi.route_key("not a route") ~throws "RouteClass"
  source_abi.encode(
    fixture.route,
    Injection(fixture.n1)
  ) ~throws "must equal the route-class source"
  local_abi.output_count ~is 0
  local_abi.mask_width ~is 1
  local_abi.entries.map(fun (entry): entry.result_bits()) ~is [0b011]
