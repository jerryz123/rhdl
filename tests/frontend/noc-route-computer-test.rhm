#lang rhombus
// Exhaustively checks router-local route ABIs and their RHDL decode operations.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/layers/bool.rhm" as bool
  "../../rhdl/frontend/layers/comb.rhm" as comb
  "../../noc/rtl/main.rhdl" open
  "../../noc/model/main.rhm" open
  "../../noc/plan/main.rhm" open
  "../../examples/noc/noc-route-computer.rhdl" as fixture

fun pattern_field(cube, field_name):
  def field = cube.value.fields.find(
    fun (candidate): candidate[0] == field_name
  )
  field[1].packed_value()

fun decision_result(cube):
  [pattern_field(cube, "allowed_mask"),
   pattern_field(cube, "eject") != 0,
   pattern_field(cube, "valid") != 0]

fun decoded_result(route_decoder, encoded_key):
  def origin_mask = (1 bits.(<<) route_decoder.origin_width) - 1
  def selector = RouteLookupKey(
    route_decoder.route_width,
    route_decoder.origin_width
  ):
    route_key: comb.bits(
      encoded_key bits.(>>) route_decoder.origin_width,
      route_decoder.route_width
    )
    origin_key: comb.bits(
      encoded_key bits.and origin_mask,
      route_decoder.origin_width
    )
  def table = route_decoder.decoder.table
  def matching = table.cases.find(
    fun (case): case.input.matches(selector)
  )
  if matching
  | decision_result(matching.output)
  | decision_result(table.default)

fun expected_result(route_decoder, encoded_key):
  def origin_mask = (1 bits.(<<) route_decoder.origin_width) - 1
  def route_key = encoded_key bits.(>>) route_decoder.origin_width
  def origin_key = encoded_key bits.and origin_mask
  def entry = route_decoder.router_plan.rows.find(
    fun (candidate):
      candidate.route_key == route_key && candidate.origin_key == origin_key
  )
  if entry
  | [entry.allowed_mask, entry.route_row.eject, #true]
  | [0, #false, #false]

fun key_space_size(route_decoder):
  1 bits.(<<) (route_decoder.route_width + route_decoder.origin_width)

fun decoded_results(route_decoder):
  for List (key in 0..key_space_size(route_decoder)):
    decoded_result(route_decoder, key)

fun expected_results(route_decoder):
  for List (key in 0..key_space_size(route_decoder)):
    expected_result(route_decoder, key)

fun materialized_mask(route_decoder, entry):
  def mutable mask = 0
  for (vc in fixture.routing.materialized.allowed_candidates(
             entry.route_row.route_class,
             entry.route_row.origin
           )):
    mask := mask bits.or (
      1 bits.(<<) route_decoder.router_plan.output_bit(vc)
    )
  mask

fun masks_match_materialized(route_decoder):
  def rows = route_decoder.router_plan.rows
  rows.map(fun (entry): entry.allowed_mask) == rows.map(
    fun (entry): materialized_mask(route_decoder, entry)
  )

def source_decoder = fixture.source_decoder
def middle_decoder = fixture.middle_decoder
def destination_decoder = fixture.destination_decoder
def top = fixture.design.modules.find(
  fun (module_def): module_def.name == "RouteComputerFixture"
)

fun contains_decode(module_def):
  module_def.operations.find(
    fun (operation): operation.opcode == "rtl.decode"
  ) != #false

def decode_modules = fixture.design.modules.filter(
  ~keep: contains_decode
)

check:
  source_decoder.router_plan === fixture.source_plan ~is #true
  source_decoder.route_width ~is 1
  source_decoder.origin_width ~is 1
  source_decoder.mask_width ~is 2
  fixture.source_plan.row(
    fixture.route,
    Injection(fixture.n0)
  ) === fixture.source_plan.rows[0] ~is #true
  fixture.source_plan.output_bit(VCId(fixture.first.id, 1)) ~is 1
  fixture.source_plan.rows.map(fun (entry): entry.route_key) ~is [0]
  fixture.source_plan.rows.map(fun (entry): entry.origin_key) ~is [0]
  fixture.source_plan.rows.map(fun (entry): entry.allowed_mask) ~is [0b11]
  masks_match_materialized(source_decoder) ~is #true
  decoded_results(source_decoder) ~is expected_results(source_decoder)
  decoded_results(source_decoder) ~is [
    [0b11, #false, #true],
    [0, #false, #false],
    [0, #false, #false],
    [0, #false, #false]
  ]

check:
  middle_decoder.router_plan === fixture.middle_plan ~is #true
  middle_decoder.route_width ~is 1
  middle_decoder.origin_width ~is 1
  middle_decoder.mask_width ~is 2
  fixture.middle_plan.row(
    fixture.route,
    HeldVC(VCId(fixture.first.id, 1))
  ) === fixture.middle_plan.rows[1] ~is #true
  fixture.middle_plan.output_bit(VCId(fixture.second.id, 1)) ~is 1
  fixture.middle_plan.rows.map(fun (entry): entry.route_key) ~is [0, 0]
  fixture.middle_plan.rows.map(fun (entry): entry.origin_key) ~is [0, 1]
  fixture.middle_plan.rows.map(fun (entry): entry.allowed_mask) ~is [0b01, 0b10]
  masks_match_materialized(middle_decoder) ~is #true
  decoded_results(middle_decoder) ~is expected_results(middle_decoder)
  decoded_results(middle_decoder) ~is [
    [0b01, #false, #true],
    [0b10, #false, #true],
    [0, #false, #false],
    [0, #false, #false]
  ]

check:
  destination_decoder.router_plan === fixture.destination_plan ~is #true
  destination_decoder.route_width ~is 1
  destination_decoder.origin_width ~is 1
  destination_decoder.mask_width ~is 1
  fixture.destination_plan.rows.map(fun (entry): entry.route_key) ~is [0, 0]
  fixture.destination_plan.rows.map(fun (entry): entry.origin_key) ~is [0, 1]
  fixture.destination_plan.rows.map(fun (entry): entry.allowed_mask) ~is [0, 0]
  masks_match_materialized(destination_decoder) ~is #true
  decoded_results(destination_decoder) ~is expected_results(destination_decoder)
  decoded_results(destination_decoder) ~is [
    [0, #true, #true],
    [0, #true, #true],
    [0, #false, #false],
    [0, #false, #false]
  ]

check:
  top != #false ~is #true
  type_equal(top.find_input("source_route_key").type, Bits(1)) ~is #true
  type_equal(top.find_input("middle_origin_key").type, Bits(1)) ~is #true
  type_equal(top.find_output("source_allowed_mask").type, Bits(2)) ~is #true
  type_equal(top.find_output("middle_allowed_mask").type, Bits(2)) ~is #true
  type_equal(top.find_output("destination_allowed_mask").type, Bits(1)) ~is #true
  bool.bool_type(top.find_output("source_eject").type) ~is #true
  bool.bool_type(top.find_output("source_valid").type) ~is #true
  bool.bool_type(top.find_output("destination_eject").type) ~is #true
  bool.bool_type(top.find_output("destination_valid").type) ~is #true
  decode_modules.length() ~is 3
  decode_modules.map(
    fun (module_def):
      module_def.operations.filter(
        ~keep: fun (operation): operation.opcode == "rtl.record_create"
      ).length()
  ) ~is [1, 1, 1]
  decode_modules.map(
    fun (module_def):
      module_def.operations.filter(
        ~keep: fun (operation): operation.opcode == "rtl.record_get"
      ).length()
  ) ~is [3, 3, 3]
  verify_design(fixture.design) ~is #void

def isolated_node = NodeId(0)
def unused_node = NodeId(1)
def self_route = RouteClass(RouteClassId(0), isolated_node, isolated_node)
def no_vc_routing = compile_routing(
  RoutingProblem(
    Topology([unused_node, isolated_node], []),
    [self_route],
    RoutingRelation(fun (_route, _origin, _candidate): #false)
  )
)
def local_plan = RouterPlan(no_vc_routing, isolated_node)
def local_decoder = compile_route_decoder(local_plan, ~espresso: #false)
def unused_plan = RouterPlan(no_vc_routing, unused_node)

check:
  compile_route_decoder("not a plan") ~throws "RouterPlan"
  compile_route_decoder(no_vc_routing) ~throws "RouterPlan"
  compile_route_decoder(unused_plan) ~throws "at least one local route row"
  fixture.source_plan.route_key("not a route") ~throws "RouteClass"
  local_decoder.mask_width ~is 1
  local_decoder.router_plan.rows.map(fun (entry): entry.allowed_mask) ~is [0]
