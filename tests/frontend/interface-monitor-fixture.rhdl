#lang rhdl
// Defines explicit endpoint-monitor fixtures over read-only interface observations.

interface MonitoredWordStream(width :: PosInt):
  role producer
  role consumer
  producer -> consumer:
    valid: Bool
    bits: Bits(width)
  consumer -> producer:
    ready: Bool

fun monitor_word_stream(link :: Observation, endpoint_role :: String):
  def label:
    if endpoint_role == "producer"
    | "producer_ready_requires_valid"
    | "consumer_ready_requires_valid"
  assert(!(link.ready & !link.valid), label)

interface RefinedMonitoredWordStream() refines MonitoredWordStream(8)

sync_circuit MonitoredProducer():
  interface stream(MonitoredWordStream(8), ~role: producer)

  stream.valid <== Bool(#false)
  stream.bits <== bits(0, 8)
  monitor_word_stream(observe(stream), "producer")

sync_circuit MonitoredConsumer():
  interface stream(MonitoredWordStream(8), ~role: consumer)

  stream.ready <== Bool(#false)
  monitor_word_stream(observe(stream), "consumer")

sync_circuit UnmonitoredProducer():
  interface stream(MonitoredWordStream(8), ~role: producer)

  stream.valid <== Bool(#false)
  stream.bits <== bits(0, 8)

sync_circuit MonitoredProducerArray():
  interface streams[2](MonitoredWordStream(8), ~role: producer)

  for (index in 0..2):
    streams[index].valid <== Bool(#false)
    streams[index].bits <== bits(0, 8)
    monitor_word_stream(observe(streams[index]), "producer")

sync_circuit RefinedMonitoredProducer():
  interface stream(RefinedMonitoredWordStream(), ~role: producer)

  stream.valid <== Bool(#false)
  stream.bits <== bits(0, 8)
  monitor_word_stream(observe(stream), "producer")

export:
  MonitoredWordStream
  MonitoredProducer
  MonitoredConsumer
  UnmonitoredProducer
  MonitoredProducerArray
  RefinedMonitoredProducer
