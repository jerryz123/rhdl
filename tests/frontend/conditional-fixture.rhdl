#lang rhdl
// Defines valid and invalid circuits for hardware conditional-assignment tests.

circuit PrioritySelect():
  input first: Bool
  input second: Bool
  input a: Bits(4)
  input b: Bits(4)
  input fallback: Bits(4)
  output selected: Bits(4)

  when first:
    selected <== a
  elsewhen second:
    selected <== b
  otherwise:
    selected <== fallback

circuit NestedSelect():
  input outer: Bool
  input inner: Bool
  input a: Bits(4)
  input b: Bits(4)
  input fallback: Bits(4)
  output selected: Bits(4)

  when outer:
    when inner:
      selected <== a
    otherwise:
      selected <== b
  otherwise:
    selected <== fallback

circuit HostCondition():
  output selected: Bits(1)
  when #true:
    selected <== bits(1, 1)

circuit WideCondition():
  input condition: Bits(2)
  output selected: Bits(1)
  when condition:
    selected <== bits(1, 1)

circuit MissingOtherwise():
  input condition: Bool
  output selected: Bits(1)
  when condition:
    selected <== bits(1, 1)

circuit DuplicateBranch():
  input condition: Bool
  output selected: Bits(1)
  when condition:
    selected <== bits(0, 1)
    selected <== bits(1, 1)

circuit MissingBranch():
  input first: Bool
  input second: Bool
  input a: Bits(1)
  input fallback: Bits(1)
  output selected: Bits(1)
  when first:
    selected <== a
  elsewhen second:
    def unused = a
    #void
  otherwise:
    selected <== fallback

circuit SeparateConditionals():
  input first: Bool
  input second: Bool
  output selected: Bits(1)
  when first:
    selected <== bits(0, 1)
  otherwise:
    selected <== bits(1, 1)
  when second:
    selected <== bits(0, 1)
  otherwise:
    selected <== bits(1, 1)

export:
  PrioritySelect
  NestedSelect
  HostCondition
  WideCondition
  MissingOtherwise
  DuplicateBranch
  MissingBranch
  SeparateConditionals
