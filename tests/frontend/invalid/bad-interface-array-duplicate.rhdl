#lang rhdl
// Rejects a scalar endpoint whose name collides with an array element port group.

import:
  lib("rhdl/std/ready-valid.rhdl") open

circuit BadInterfaceArrayDuplicate():
  interface links[2](Decoupled(Bits(8)), ~role: consumer)
  interface links_0(Decoupled(Bits(8)), ~role: consumer)
  #void

elaborate(BadInterfaceArrayDuplicate())
