#lang rhdl
// Rejects a TileLink interface that omits role-specific client or manager link parameters.

import:
  lib("rhdl/std/tilelink.rhdl") open

def bundle = TLBundleParams(32, 8, 4, 3, 2)

circuit BadTileLinkLinkParams():
  interface endpoint(TLUncached(bundle), ~role: client)
  #void

def design = elaborate(BadTileLinkLinkParams())
