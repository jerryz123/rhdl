#lang rhdl
// Rejects monitor activation on an interface that defines no monitor factory.

interface UnmonitoredLink():
  role producer
  role consumer
  producer -> consumer:
    valid: Bool
  consumer -> producer:
    ready: Bool

sync_circuit BadInterfaceMonitorMissing():
  interface stream(UnmonitoredLink(), ~role: producer, ~monitor)
  stream.valid <== Bool(#false)

def design = elaborate(BadInterfaceMonitorMissing())
