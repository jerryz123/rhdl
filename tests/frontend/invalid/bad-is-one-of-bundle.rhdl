#lang rhdl
// Rejects receiver membership on an aggregate rather than a flat hardware value.

bundle Pair():
  left: Bits(4)
  right: Bits(4)

circuit BadBundleMembership():
  input pair: Pair()
  output selected: Bool

  selected <== pair.is_one_of(pair)

def design = elaborate(BadBundleMembership())

export:
  BadBundleMembership
  design
