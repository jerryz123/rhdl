#lang rhdl/base
// Rejects temporal environment declarations owned by a child rather than the explicit top.

import:
  lib("rhdl/frontend/layers/hierarchy.rhm") open
  lib("rhdl/frontend/layers/clocking.rhm") open

circuit Child():
  input clock: Clock
  input data: Bits(1)
  synchronous_input(data, clock)

circuit Top():
  input clock: Clock
  input data: Bits(1)
  inst child(Child())
  child.clock <== clock
  child.data <== data

def clocked = elaborate_with_clocking(Top())
