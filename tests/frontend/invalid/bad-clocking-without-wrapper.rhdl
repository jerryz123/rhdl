#lang rhdl/base
// Rejects clocking declarations made outside the clock-aware elaboration wrapper.

import:
  lib("rhdl/frontend/layers/clocking.rhm") open

circuit BadClockingWithoutWrapper():
  input clock: Clock
  input data: Bits(1)
  synchronous_input(data, clock)

def design = elaborate(BadClockingWithoutWrapper())
