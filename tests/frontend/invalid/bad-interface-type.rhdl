#lang rhdl
// Must reject bulk connection between distinct interface definitions.

interface FirstLink(T):
  role producer
  role consumer
  producer -> consumer:
    payload: T
  consumer -> producer:
    ready: Bool

interface SecondLink(T):
  role producer
  role consumer
  producer -> consumer:
    payload: T
  consumer -> producer:
    ready: Bool

circuit BadInterfaceType(width):
  interface left(FirstLink(Bits(width)), ~role: producer)
  interface right(SecondLink(Bits(width)), ~role: consumer)
  left <=> right

def design = elaborate(BadInterfaceType(8))
