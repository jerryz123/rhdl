#lang rhdl
// Rejects an interface monitor that attempts to drive its read-only observation.

interface BadMonitorDrive():
  role producer
  role consumer
  monitor (link, endpoint_role):
    link.ready <== Bool(#true)
  producer -> consumer:
    valid: Bool
  consumer -> producer:
    ready: Bool

sync_circuit BadInterfaceMonitorDrive():
  interface stream(BadMonitorDrive(), ~role: producer, ~monitor)
  stream.valid <== Bool(#false)

def design = elaborate(BadInterfaceMonitorDrive())
