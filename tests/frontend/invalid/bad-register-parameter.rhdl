#lang rhdl
// Rejects passing a register handle directly to a circuit generator.

circuit Child(parameter):
  input x: Bits(1)
  output y: Bits(1)
  y <== x

circuit BadRegisterParameter():
  input clk: Clock
  reg state(Bits(1), ~clock: clk)
  state.next <== state
  Child(state)

def design = elaborate(BadRegisterParameter())
