#lang rhdl
// Must reject an endpoint whose selected role is absent from its interface.

interface Link(T):
  role producer
  role consumer

  producer -> consumer:
    payload: T

  consumer -> producer:
    ready: Bool

circuit BadInterfaceRole(width):
  interface link(Link(Bits(width)), ~role: observer)
  #void

def design = elaborate(BadInterfaceRole(8))
