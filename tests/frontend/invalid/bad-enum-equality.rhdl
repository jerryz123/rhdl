#lang rhdl
// Rejects equality between distinct nominal hardware-enum declarations.

import:
  lib("rhdl/frontend/layers/enum.rhm") open

hardware_enum LeftState:
  Idle
  Run

hardware_enum RightState:
  Idle
  Run

circuit BadEnumEquality():
  input left: LeftState
  input right: RightState
  output equal: Bool
  equal <== left === right

def design = elaborate(BadEnumEquality())
