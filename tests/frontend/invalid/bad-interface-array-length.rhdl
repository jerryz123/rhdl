#lang rhodium
// Rejects bulk connection between interface endpoint arrays of different lengths.

import:
  lib("rhodium/std/ready-valid.rhdl") open

circuit BadInterfaceArrayLength():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress[3](Decoupled(Bits(8)), ~role: producer)

  egress <=> ingress

elaborate(BadInterfaceArrayLength())
