#lang rhdl/base
// Rejects an input timing contract attached to a top-level output.

import:
  lib("rhdl/frontend/layers/clocking.rhm") open

circuit BadClockingOutputContract():
  input clock: Clock
  input data: Bits(1)
  output result: Bits(1)
  result <== data
  synchronous_input(result, clock)

def clocked = elaborate_with_clocking(BadClockingOutputContract())
