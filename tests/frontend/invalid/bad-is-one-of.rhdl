#lang rhodium
// Rejects .is_one_of alternatives whose hardware type differs from the subject.

hardware_enum FirstState:
  Idle
  Busy

hardware_enum OtherState:
  Idle
  Busy

circuit BadIsOneOf():
  input state: FirstState
  output selected: Bool

  selected <== state.is_one_of(FirstState.Idle, OtherState.Busy)

def design = elaborate(BadIsOneOf())

export:
  BadIsOneOf
  design
