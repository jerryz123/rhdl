#lang rhdl
// Rejects inequality between distinct nominal hardware-enum declarations.

hardware_enum LeftState:
  Idle
  Run

hardware_enum RightState:
  Idle
  Run

circuit BadEnumInequality():
  input left: LeftState
  input right: RightState
  output different: Bool
  different <== left =/= right

def design = elaborate(BadEnumInequality())
