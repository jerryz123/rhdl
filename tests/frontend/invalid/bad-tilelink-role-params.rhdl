#lang rhdl
// Rejects using client link parameters for both roles of one TileLink connection.

import:
  lib("rhdl/std/tilelink.rhdl") open
  "../std-tilelink-fixture.rhdl" as fixture

def bundle = TLBundleParams(32, 8, 4, 3, 2)
def client = TLClientParams("cpu", IdRange(0, 4), ~emits: TLAOperationSizes())
def client_link = TLClientLinkParams(bundle, client)
def design = elaborate(fixture.TLUncachedAdapter(client_link, client_link))
