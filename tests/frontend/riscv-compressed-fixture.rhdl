#lang rhodium
// Exposes RV32F, RV32D, and RV64D compressed expansion for backend simulation.

import:
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/rtl/compressed.rhdl") open

circuit RiscvCompressedFixture():
  input compressed: Bits(16)
  output rv32f: RiscvCompressedExpansion()
  output rv32d: RiscvCompressedExpansion()
  output rv64d: RiscvCompressedExpansion()

  inst expand_rv32f(RiscvCompressedExpander(XLen.X32, FloatingPointProfile.F))
  inst expand_rv32d(RiscvCompressedExpander(XLen.X32, FloatingPointProfile.D))
  inst expand_rv64d(RiscvCompressedExpander(XLen.X64, FloatingPointProfile.D))
  expand_rv32f.compressed <== compressed
  expand_rv32d.compressed <== compressed
  expand_rv64d.compressed <== compressed
  rv32f <== expand_rv32f.expansion
  rv32d <== expand_rv32d.expansion
  rv64d <== expand_rv64d.expansion

export:
  RiscvCompressedFixture
