#lang rhdl
// Defines invalid vector uses for focused frontend diagnostic checks.

circuit OutOfBoundsVector():
  input source: Vec(2, Bits(4))
  output result: Bits(4)
  result <== source[2]

circuit DynamicVectorIndex():
  input source: Vec(2, Bits(4))
  input index: Bits(1)
  output result: Bits(4)
  result <== source[index]

circuit NarrowVectorLookup():
  input source: Vec(3, Bits(4))
  input index: Bits(1)
  input fallback: Bits(4)
  output result: Bits(4)
  result <== source.lookup(index, ~default: fallback)

circuit MixedVectorElements():
  input wide: Bits(4)
  input narrow: Bits(2)
  output result: Vec(2, Bits(4))
  result <== vec(wide, narrow)

circuit PartialVectorDrive():
  input source: Bits(4)
  output result: Vec(2, Bits(4))
  result[0] <== source

circuit MixedVectorDrive():
  input(a, b): Bits(4)
  output result: Vec(2, Bits(4))
  result[0] <== a
  result <== vec(a, b)

export:
  OutOfBoundsVector
  DynamicVectorIndex
  NarrowVectorLookup
  MixedVectorElements
  PartialVectorDrive
  MixedVectorDrive
