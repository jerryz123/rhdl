#lang rhombus
// Checks standard valid interfaces, directions, nominal identity, and bulk connection.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/frontend/layers/bool.rhm" as bool
  "../../rhdl/frontend/layers/interface.rhm" open
  "../../rhdl/std/ready-valid.rhm" as std
  "std-ready-valid.rhdl" as fixture

def valid_type = std.Valid(Bits(8))
def decoupled_type = std.Decoupled(Bits(8))
def irrevocable_type = std.Irrevocable(Bits(8))

def valid_design = embedded.run_elaboration(fun (): fixture.ValidAdapter())
def valid_adapter = valid_design.modules[0]
def decoupled_design = embedded.run_elaboration(fun (): fixture.DecoupledAdapter())
def decoupled_adapter = decoupled_design.modules[0]
def irrevocable_design = embedded.run_elaboration(fun (): fixture.IrrevocableAdapter())
def irrevocable_adapter = irrevocable_design.modules[0]

check:
  valid_type.name ~is "Valid"
  valid_type.roles ~is ["producer", "consumer"]
  valid_type.members.map(fun (member): member.name) ~is ["valid", "bits"]
  valid_type.flows.length() ~is 1
  decoupled_type.name ~is "Decoupled"
  decoupled_type.members.map(fun (member): member.name) ~is ["valid", "bits", "ready"]
  decoupled_type.flows.length() ~is 2
  irrevocable_type.name ~is "Irrevocable"
  irrevocable_type.members.map(fun (member): member.name) ~is ["valid", "bits", "ready"]
  irrevocable_type.flows.length() ~is 2
  valid_adapter.inputs.map(fun (port): port.name) ~is ["ingress_in"]
  valid_adapter.outputs.map(fun (port): port.name) ~is ["egress_out"]
  decoupled_adapter.inputs.map(fun (port): port.name) ~is ["ingress_in", "egress_in"]
  decoupled_adapter.outputs.map(fun (port): port.name) ~is ["ingress_out", "egress_out"]
  irrevocable_adapter.inputs.map(fun (port): port.name) ~is ["ingress_in", "egress_in"]
  irrevocable_adapter.outputs.map(fun (port): port.name) ~is ["ingress_out", "egress_out"]
  valid_adapter.find_input("ingress_in").type.field("valid").type === bool.Bool ~is #true
  valid_adapter.find_input("ingress_in").type.field("bits").type.width ~is 8
  decoupled_adapter.find_output("ingress_out").type.field("ready").type === bool.Bool ~is #true
  verify_design(valid_design) ~is #void
  verify_design(decoupled_design) ~is #void
  verify_design(irrevocable_design) ~is #void
  embedded.run_elaboration(fun (): fixture.MismatchedAdapter()) ~throws "same interface type"
