#lang rhdl/golf
// Isolates block-bodied compact circuits and the B type alias beyond the executable Golf example.

c BodyAdder(width)[a, b: B(width) -> sum: B(width)]:
  sum <== a + b

c HomogeneousBody(width)[a,b->sum:B(width)]:
  sum <== a + b

def body_design = elaborate(BodyAdder(8))
def homogeneous_body_design = elaborate(HomogeneousBody(8))
def short_type = B(8)
def canonical_type = Bits(8)

export:
  body_design
  homogeneous_body_design
  short_type
  canonical_type
