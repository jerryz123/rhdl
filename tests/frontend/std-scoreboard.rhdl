#lang rhdl
// Provides positive and invalid fixtures for the standard occupancy scoreboard.

import:
  lib("rhdl/std/scoreboard.rhdl") open

circuit ScoreboardLookup():
  input busy: Bits(8)
  input index: Bits(3)
  output result: Bool
  result <== scoreboard_busy(8, busy, index)

circuit BadScoreboardLookup():
  input busy: Bits(4)
  input index: Bits(3)
  output result: Bool
  result <== scoreboard_busy(4, busy, index)

def lookup_design = elaborate(ScoreboardLookup())

export:
  ScoreboardLookup
  BadScoreboardLookup
  lookup_design
