#lang rhdl
// Defines valid and invalid Queue-to-Pipe chains for endpoint static-info tests.

import:
  lib("rhdl/std/flow.rhdl") open

fun preserve_endpoint(endpoint :: Endpoint) :~ Endpoint:
  endpoint

fun require_byte_irrevocable(
  endpoint :: Endpoint.of(Irrevocable(Bits(8)))
) :~ Endpoint:
  endpoint

fun require_ctrl_irrevocable(
  endpoint :: Endpoint.of(IrrevocableCtrl())
) :~ Endpoint:
  endpoint

sync_circuit FlowChain():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  output observed_valid: Bool
  output observed_bits: Bits(8)

  def buffered = preserve_endpoint(ingress |> queue(_, 3, ~pipe: #true) |> pipe(_, 2))
  def checked = require_byte_irrevocable(buffered)

  observed_valid <== checked.valid
  observed_bits <== checked.bits
  egress <=> checked

// Verifies that one-to-one helpers accept the stronger Pipe output contract.
sync_circuit PipeToQueueChain():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)

  def buffered = ingress |> pipe(_, 1) |> queue(_, 2)
  egress <=> buffered

sync_circuit CtrlFlowChain():
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  output observed_valid: Bool

  def buffered = preserve_endpoint(
    ingress |> ctrl_queue(_, 3, ~pipe: #true) |> ctrl_pipe(_, 2)
  )
  def checked = require_ctrl_irrevocable(buffered)

  observed_valid <== checked.valid
  egress <=> checked

// Verifies that the stronger CtrlPipe result can feed a CtrlQueue.
sync_circuit CtrlPipeToQueueChain():
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)

  def buffered = ingress |> ctrl_pipe(_, 1) |> ctrl_queue(_, 2)
  egress <=> buffered

sync_circuit WrongProtocolChain():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  queue(ingress, 2)

sync_circuit WrongEndpointType():
  interface ingress(Decoupled(Bits(16)), ~role: consumer)
  require_byte_irrevocable(ingress)

sync_circuit NonEndpointChain():
  queue(bits(0, 8), 2)

sync_circuit CtrlWrongProtocolChain():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  ctrl_queue(ingress, 2)

sync_circuit CtrlNonEndpointChain():
  ctrl_queue(bits(0, 8), 2)

circuit MissingSyncDomain():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  queue(ingress, 2)

circuit CtrlMissingSyncDomain():
  interface ingress(DecoupledCtrl(), ~role: consumer)
  ctrl_queue(ingress, 2)

def design = elaborate(FlowChain())

export:
  FlowChain
  PipeToQueueChain
  CtrlFlowChain
  CtrlPipeToQueueChain
  WrongProtocolChain
  WrongEndpointType
  NonEndpointChain
  CtrlWrongProtocolChain
  CtrlNonEndpointChain
  MissingSyncDomain
  CtrlMissingSyncDomain
  design
