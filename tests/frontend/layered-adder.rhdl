#lang rhdl
// Uses an ordinary imported Rhombus library to extend RHDL without reader changes.

import:
  "add-pair.rhm" open

fun choose_width(wide):
  if wide | 4 + 4 | 4

circuit LayeredAdder(width):
  def a = input("a", Bits(width))
  def b = input("b", Bits(width))
  def sum = output("sum", Bits(width))
  sum <== add_pair(a, b)

def design = elaborate(LayeredAdder(choose_width(#true)))

export:
  design
