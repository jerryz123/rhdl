;; Lists invalid Golf fixtures and the compact-syntax diagnostics each must produce.

(("golf-duplicate-port.rhdl" "compact circuit port name is repeated")
 ("golf-malformed-header.rhdl" "compact circuit header requires exactly one ->")
 ("golf-malformed-homogeneous-header.rhdl" "compact circuit port group requires an explicit type")
 ("golf-multiple-expression-outputs.rhdl" "expression-bodied c requires compact inputs and exactly one output")
 ("golf-result-arity.rhdl" "bracket-bodied c requires one expression per multiple output"))
