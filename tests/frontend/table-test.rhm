#lang rhombus
// Checks host-generated table contents and exhaustive hardware vector lookup.

import:
  "../../rhdl/core/main.rhm" open
  "../../examples/table.rhdl" as fixture

def module_def = fixture.design.modules[0]
def vector_create = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.vector_create"
)
def lookup = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.mux_lookup"
)

fun defining_operation(value):
  module_def.find_operation(value.defining_op_id)

check:
  module_def.name ~is "Tbl"
  type_equal(module_def.find_input("addr").type, Bits(8)) ~is #true
  type_equal(module_def.find_output("out").type, Bits(8)) ~is #true
  type_equal(vector_create.results[0].type, VectorType(256, Bits(8))) ~is #true
  vector_create.operands.length() ~is 256
  defining_operation(vector_create.operands[0]).attribute("value") ~is 0
  defining_operation(vector_create.operands[255]).attribute("value") ~is 255
  lookup.attribute("keys").length() ~is 256
  lookup.attribute("keys")[0] ~is 0
  lookup.attribute("keys")[255] ~is 255
  type_equal(lookup.results[0].type, Bits(8)) ~is #true
  verify_design(fixture.design) ~is #void
