#lang rhdl
// Exercises generic packed OR and AND reductions over Bits and aggregate Boolean data.

circuit OrReduce():
  input bits_value: Bits(8)
  input flags: Vec(4, Bool)
  output any_bits: Bool
  output any_flags: Bool
  output all_bits: Bool
  output all_flags: Bool

  any_bits <== or_reduce(bits_value)
  any_flags <== or_reduce(flags)
  all_bits <== and_reduce(bits_value)
  all_flags <== and_reduce(flags)

def design = elaborate(OrReduce())

export:
  OrReduce
  design
