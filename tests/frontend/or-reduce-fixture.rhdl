#lang rhdl
// Exercises packed OR and AND reductions over hardware data and host lists.

circuit OrReduce():
  input bits_value: Bits(8)
  input flags: Vec(4, Bool)
  output any_bits: Bool
  output any_flags: Bool
  output all_bits: Bool
  output all_flags: Bool
  output any_list: Bool
  output all_list: Bool
  output any_empty: Bool
  output all_empty: Bool

  any_bits <== or_reduce(bits_value)
  any_flags <== or_reduce(flags)
  all_bits <== and_reduce(bits_value)
  all_flags <== and_reduce(flags)
  any_list <== or_reduce([flags[0], flags[1], flags[2], flags[3]])
  all_list <== and_reduce([flags[0], flags[1], flags[2], flags[3]])
  any_empty <== or_reduce([])
  all_empty <== and_reduce([])

def design = elaborate(OrReduce())

export:
  OrReduce
  design
