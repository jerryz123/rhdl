#lang rhdl/base
// Defines sync-circuit edge cases kept separate from the composed-profile example.

import:
  lib("rhdl/frontend/layers/comb.rhm") open
  lib("rhdl/frontend/layers/sequential.rhm") open
  lib("rhdl/frontend/layers/hierarchy.rhm") open
  lib("rhdl/frontend/layers/sync.rhm") open
  "../../examples/lop/counter-composed.rhdl".Counter

circuit OrdinaryControlChild():
  input clock: Clock
  input reset: Reset
  output value: Bits(1)
  value <== bits(0, 1)

sync_circuit MixedTop():
  output value: Bits(1)

  def ChildModule = OrdinaryControlChild()
  inst child(ChildModule)
  // Ordinary circuits are wired explicitly even when their port names match.
  child.clock <== clock
  child.reset <== reset
  value <== child.value

sync_circuit LocalResetCounter():
  input local_reset: Reset
  output count: Bits(1)

  def zero = bits(0, 1)
  reg state(Bits(1), ~clock: clock, ~reset: local_reset, ~init: zero)
  state <== state + bits(1, 1)
  count <== state

sync_circuit LocalResetChildTop():
  input local_reset: Reset
  output count: Bits(1)

  def CounterModule = Counter(1)
  inst counter(CounterModule, ~clock: clock, ~reset: local_reset)
  count <== counter.count

export:
  MixedTop
  LocalResetCounter
  LocalResetChildTop
