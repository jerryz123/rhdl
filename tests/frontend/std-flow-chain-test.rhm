#lang rhombus
// Checks functional flow chaining, retained endpoint fields, and invalid uses.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/frontend/standard.rhm" as frontend
  "std-flow-chain.rhdl" as fixture

def design = fixture.design
def top = design.modules[0]
def pipe_to_queue_design = embedded.run_elaboration(
  fun (): fixture.PipeToQueueChain()
)
def ctrl_design = embedded.run_elaboration(
  fun (): fixture.CtrlFlowChain()
)
def ctrl_top = ctrl_design.modules[0]
def ctrl_pipe_to_queue_design = embedded.run_elaboration(
  fun (): fixture.CtrlPipeToQueueChain()
)

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

check:
  design.modules.map(fun (module_def): module_def.name) ~is [
    "FlowChain", "Queue", "Counter", "Pipe"
  ]
  top.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_in", "egress_in"
  ]
  top.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_out", "observed_valid", "observed_bits"
  ]
  operations(top, "rtl.instance").length() ~is 2
  type_equal(top.find_output("observed_valid").type, frontend.Bool) ~is #true
  top.find_output("observed_bits").type.width ~is 8
  verify_design(design) ~is #void
  verify_design(pipe_to_queue_design) ~is #void

  ctrl_design.modules.map(fun (module_def): module_def.name) ~is [
    "CtrlFlowChain", "CtrlQueue", "CtrlPipe"
  ]
  ctrl_top.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_out", "observed_valid"
  ]
  ctrl_top.find_output("egress_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid"]
  verify_design(ctrl_design) ~is #void
  verify_design(ctrl_pipe_to_queue_design) ~is #void

  embedded.run_elaboration(
    fun (): fixture.WrongProtocolChain()
  ) ~throws "flow-control chaining requires a Decoupled or Irrevocable endpoint"
  embedded.run_elaboration(
    fun (): fixture.WrongEndpointType()
  ) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(
    fun (): fixture.NonEndpointChain()
  ) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(
    fun (): fixture.CtrlWrongProtocolChain()
  ) ~throws "control-flow chaining requires a DecoupledCtrl or IrrevocableCtrl endpoint"
  embedded.run_elaboration(
    fun (): fixture.CtrlNonEndpointChain()
  ) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(
    fun (): fixture.MissingSyncDomain()
  ) ~throws "active sync_circuit"
  embedded.run_elaboration(
    fun (): fixture.CtrlMissingSyncDomain()
  ) ~throws "active sync_circuit"
