#lang rhombus
// Checks flat and nested interfaces, bulk connection, field access, and instance reconstruction.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/frontend/extensions/bool.rhm" as bool
  "../../rhdl/frontend/extensions/interface.rhm" open
  "../../examples/interface.rhdl" as interface_fixture
  "../../examples/nested-interface.rhdl" as nested_fixture

def adapter_design = interface_fixture.design
def adapter = adapter_design.modules[0]
def source_design = embedded.run_elaboration(fun (): interface_fixture.ReadyValidSource(8))
def source = source_design.modules[0]
def hierarchy_design = embedded.run_elaboration(
  fun (): interface_fixture.ReadyValidHierarchy(8)
)
def hierarchy = hierarchy_design.modules.find(
  fun (module_def): module_def.name.starts_with("ReadyValidHierarchy")
)
def hierarchy_instance = hierarchy.operations.find(
  fun (operation): operation.opcode == "rtl.instance"
)
def nested_adapter_design = nested_fixture.design
def nested_adapter = nested_adapter_design.modules[0]
def nested_member_design = embedded.run_elaboration(
  fun (): nested_fixture.NestedMemberAdapter(8)
)
def nested_member_adapter = nested_member_design.modules[0]
def deep_nested_design = embedded.run_elaboration(
  fun (): nested_fixture.DeepNestedAdapter(8)
)
def deep_nested_adapter = deep_nested_design.modules[0]
def nested_source_design = embedded.run_elaboration(
  fun (): nested_fixture.NestedInterfaceSource(8)
)
def nested_source = nested_source_design.modules[0]
def nested_hierarchy_design = embedded.run_elaboration(
  fun (): nested_fixture.NestedInterfaceHierarchy(8)
)
def nested_hierarchy = nested_hierarchy_design.modules.find(
  fun (module_def): module_def.name.starts_with("NestedInterfaceHierarchy")
)
def nested_hierarchy_instance = nested_hierarchy.operations.find(
  fun (operation): operation.opcode == "rtl.instance"
)

check:
  adapter.inputs.map(fun (port): port.name) ~is ["ingress__producer_to_consumer", "egress__consumer_to_producer"]
  adapter.outputs.map(fun (port): port.name) ~is ["ingress__consumer_to_producer", "egress__producer_to_consumer"]
  adapter.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.drive"
  ).length() ~is 2
  source.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.record_create"
  ).length() ~is 1
  source.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.record_get"
  ).length() ~is 1
  hierarchy_instance.places.length() ~is 3
  hierarchy_instance.results.length() ~is 2
  hierarchy.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.drive"
  ).length() ~is 5
  nested_adapter.inputs.map(fun (port): port.name) ~is ["ingress__manager_to_device", "egress__device_to_manager"]
  nested_adapter.outputs.map(fun (port): port.name) ~is ["ingress__device_to_manager", "egress__manager_to_device"]
  nested_adapter.find_input("ingress__manager_to_device").type.field("command").type.field("valid").type === bool.Bool ~is #true
  nested_adapter.find_output("ingress__device_to_manager").type.field("command").type.field("ready").type === bool.Bool ~is #true
  nested_adapter.find_input("ingress__manager_to_device").type.field("response").type.field("ready").type === bool.Bool ~is #true
  nested_adapter.find_output("ingress__device_to_manager").type.field("response").type.field("valid").type === bool.Bool ~is #true
  nested_member_adapter.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.drive"
  ).length() ~is 2
  deep_nested_adapter.find_input("peripheral__host_to_peripheral").type.field("control").type.field("command").type.field("bits").type.width ~is 8
  nested_source.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.record_create"
  ).length() ~is 3
  nested_source.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.record_get"
  ).length() ~is 6
  nested_hierarchy_instance.places.length() ~is 5
  nested_hierarchy_instance.results.length() ~is 5
  verify_design(adapter_design) ~is #void
  verify_design(source_design) ~is #void
  verify_design(hierarchy_design) ~is #void
  verify_design(nested_adapter_design) ~is #void
  verify_design(nested_member_design) ~is #void
  verify_design(deep_nested_design) ~is #void
  verify_design(nested_source_design) ~is #void
  verify_design(nested_hierarchy_design) ~is #void

block:
  def payload = RecordType([RecordField("payload", Bits(8))])
  def first = InterfaceType(
    "First",
    ["producer", "consumer"],
    [InterfaceFlow("producer", "consumer", payload)]
  )
  check:
    InterfaceType("BadRoles",
                  ["producer", "producer"],
                  [InterfaceMember("payload", Bits(8), "producer", "consumer")]) ~throws "two distinct roles"
    InterfaceType("DuplicateMember",
                  ["producer", "consumer"],
                  [InterfaceMember("payload", Bits(8), "producer", "consumer"),
                   InterfaceMember("payload", Bits(8), "consumer", "producer")]) ~throws "member names must be unique"
    first.complementary_role("producer") ~is "consumer"
