#lang rhombus
// Checks inferred Bits widths, identity packing, and rejection of control types.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "as-bits-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def casts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.cast"
)

check:
  casts.length() ~is 2
  record_type(casts[0].operands[0].type) ~is #true
  casts[0].results[0].type.width ~is 4
  vector_type(casts[1].operands[0].type) ~is #true
  casts[1].results[0].type.width ~is 6
  module_def.find_output("pair_bits").place.driver === casts[0].results[0] ~is #true
  module_def.find_output("lane_bits").place.driver === casts[1].results[0] ~is #true
  module_def.find_output("raw_bits").place.driver === module_def.find_input("raw").value ~is #true
  verify_design(fixture.design) ~is #void
  embedded.run_elaboration(fun (): fixture.ControlAsBits()) ~throws "value must have a packable DataType"
