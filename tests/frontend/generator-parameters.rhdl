#lang rhdl
// Exercises ordinary and synchronous generator parameters with host defaults and keywords.

circuit OrdinaryDefaults(width = 4 + 4, ~extra: extra = 2 - 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

circuit OrdinaryTypedDefaults(width :: Int = 3 * 2,
                              ~extra: extra :: Int = 1 + 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

circuit OrdinaryRequiredKeyword(~width: width :: Int):
  output result: Bits(width)
  result <== bits(0, width)

sync_circuit SyncDefaults(width = 2 + 3, ~extra: extra = 1 + 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

sync_circuit SyncTypedDefaults(width :: Int = 2 * 2,
                               ~extra: extra :: Int = 1 + 2):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

circuit ParameterSink(~parameter: parameter):
  output result: Bits(1)
  result <== bits(0, 1)

circuit InvalidKeywordHardwareParameter():
  input source: Bits(1)
  output result: Bits(1)

  def child = ParameterSink(~parameter: source)
  result <== bits(0, 1)

def ordinary_defaults = elaborate(OrdinaryDefaults())
def ordinary_overrides = elaborate(OrdinaryDefaults(3, ~extra: 4))
def ordinary_typed_defaults = elaborate(OrdinaryTypedDefaults())
def ordinary_required_keyword = elaborate(OrdinaryRequiredKeyword(~width: 9))
def sync_defaults = elaborate(SyncDefaults())
def sync_overrides = elaborate(SyncDefaults(6, ~extra: 2))
def sync_typed_defaults = elaborate(SyncTypedDefaults())

export:
  InvalidKeywordHardwareParameter
  ordinary_defaults
  ordinary_overrides
  ordinary_typed_defaults
  ordinary_required_keyword
  sync_defaults
  sync_overrides
  sync_typed_defaults
