#lang rhdl
// Defines the invalid hardware-valued generator parameter case retained by tests.

circuit ParameterSink(~parameter: parameter):
  output result: Bits(1)
  result <== bits(0, 1)

circuit InvalidKeywordHardwareParameter():
  input source: Bits(1)
  output result: Bits(1)

  def child = ParameterSink(~parameter: source)
  result <== bits(0, 1)

export:
  InvalidKeywordHardwareParameter
