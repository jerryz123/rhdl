#lang rhdl/base
// Checks that hardware conditional assignment composes from independently selected frontend layers.

import:
  lib("rhdl/frontend/layers/sequential.rhm") open
  lib("rhdl/frontend/layers/conditional.rhm") open

circuit ComposedConditionalRegister():
  input data_in: Bits(4)
  input enable: Bits(1)
  input clk: Clock
  output data_out: Bits(4)

  reg state(Bits(4), ~clock: clk)
  when enable:
    state <== data_in
  data_out <== state

def design = elaborate(ComposedConditionalRegister())

export:
  ComposedConditionalRegister
  design
