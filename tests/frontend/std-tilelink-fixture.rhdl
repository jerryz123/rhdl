#lang rhdl
// Elaborates transparent uncached and cached TileLink link adapters for tests.

import:
  lib("rhdl/std/tilelink.rhdl") open

circuit TLUncachedAdapter(p):
  interface ingress(TLUncached(p), ~role: manager)
  interface egress(TLUncached(p), ~role: client)
  egress <=> ingress

circuit TLCachedAdapter(p):
  interface ingress(TLCached(p), ~role: manager)
  interface egress(TLCached(p), ~role: client)
  egress <=> ingress

def params = TLBundleParams(32, 8, 4, 3, 2)
def uncached_design = elaborate(TLUncachedAdapter(params))
def cached_design = elaborate(TLCachedAdapter(params))

export:
  TLUncachedAdapter
  TLCachedAdapter
  params
  uncached_design
  cached_design
