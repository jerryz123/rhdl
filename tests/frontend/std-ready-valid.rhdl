#lang rhdl
// Provides elaboration fixtures for the canonical RHDL ready-valid protocols.

import:
  lib("rhdl/std/ready-valid.rhdl") open

circuit ValidAdapter():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  interface egress(Valid(Bits(8)), ~role: producer)
  egress <=> ingress

circuit DecoupledAdapter():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> ingress

circuit IrrevocableAdapter():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  egress <=> ingress

circuit MismatchedAdapter():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  egress <=> ingress

export:
  ValidAdapter
  DecoupledAdapter
  IrrevocableAdapter
  MismatchedAdapter
