#lang rhdl
// Provides elaboration fixtures for the canonical RHDL ready-valid protocols.

import:
  lib("rhdl/std/ready-valid.rhdl") open

fun require_byte_decoupled(
  endpoint :: Endpoint.supports(Decoupled(Bits(8)))
) :~ Endpoint:
  endpoint

fun require_exact_byte_decoupled(
  endpoint :: Endpoint.of(Decoupled(Bits(8)))
) :~ Endpoint:
  endpoint

circuit ValidAdapter():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  interface egress(Valid(Bits(8)), ~role: producer)
  egress <=> ingress

circuit DecoupledAdapter():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> ingress

circuit IrrevocableAdapter():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  egress <=> ingress

circuit DecoupledControlAdapter():
  interface ingress(DecoupledControl(), ~role: consumer)
  interface egress(DecoupledControl(), ~role: producer)
  egress <=> ingress

circuit IrrevocableControlAdapter():
  interface ingress(IrrevocableControl(), ~role: consumer)
  interface egress(IrrevocableControl(), ~role: producer)
  egress <=> ingress

// Exercises the common control annotation on a payload-bearing endpoint.
circuit DecoupledFire():
  input accept: Bool
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  output transferred: Bool

  ingress.ready <== accept
  transferred <== fire(ingress)

// Exercises transitive refinement through IrrevocableControl.
circuit IrrevocableFire():
  input accept: Bool
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  output transferred: Bool

  ingress.ready <== accept
  transferred <== fire(ingress)

circuit IrrevocableToDecoupled():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> require_byte_decoupled(ingress)

circuit ReversedCompatibleSpelling():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  ingress <=> egress

circuit DecoupledToControl():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(DecoupledControl(), ~role: producer)
  egress <=> ingress

circuit IrrevocableToControl():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(IrrevocableControl(), ~role: producer)
  egress <=> ingress

circuit IrrevocableControlToDecoupledControl():
  interface ingress(IrrevocableControl(), ~role: consumer)
  interface egress(DecoupledControl(), ~role: producer)
  egress <=> ingress

circuit TransitiveControlCompatibility():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(DecoupledControl(), ~role: producer)
  egress <=> ingress

circuit DecoupledPayloadExtension():
  input payload: Bits(8)
  interface ingress(DecoupledControl(), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)

  egress <=> require_exact_byte_decoupled(
    ingress.extend(Decoupled(Bits(8)), ~bits: payload)
  )

circuit IrrevocablePayloadExtension():
  input payload: Bits(8)
  interface ingress(IrrevocableControl(), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)

  egress <=> ingress.extend(Irrevocable(Bits(8)), ~bits: payload)

fun require_exact_control(
  endpoint :: Endpoint.of(DecoupledControl())
) :~ Endpoint:
  endpoint

circuit MismatchedAdapter():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  egress <=> ingress

circuit UnsupportedFire():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  fire(ingress)

circuit RefinedIsNotExact():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  require_exact_control(ingress)

circuit WrongExtensionParent():
  input payload: Bits(8)
  interface ingress(DecoupledControl(), ~role: consumer)
  ingress.extend(Irrevocable(Bits(8)), ~bits: payload)

circuit MissingExtensionMember():
  interface ingress(DecoupledControl(), ~role: consumer)
  ingress.extend(Decoupled(Bits(8)))

circuit ExtraExtensionMember():
  input payload: Bits(8)
  interface ingress(DecoupledControl(), ~role: consumer)
  ingress.extend(Decoupled(Bits(8)), ~bits: payload, ~extra: payload)

circuit WrongExtensionMemberType():
  input payload: Bits(16)
  interface ingress(DecoupledControl(), ~role: consumer)
  ingress.extend(Decoupled(Bits(8)), ~bits: payload)

circuit ValidIsNotReadyValidCompatible():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> ingress

circuit UnsafeControlStrengthening():
  interface ingress(DecoupledControl(), ~role: consumer)
  interface egress(IrrevocableControl(), ~role: producer)
  egress <=> ingress

export:
  ValidAdapter
  DecoupledAdapter
  IrrevocableAdapter
  DecoupledControlAdapter
  IrrevocableControlAdapter
  DecoupledFire
  IrrevocableFire
  IrrevocableToDecoupled
  ReversedCompatibleSpelling
  DecoupledToControl
  IrrevocableToControl
  IrrevocableControlToDecoupledControl
  TransitiveControlCompatibility
  DecoupledPayloadExtension
  IrrevocablePayloadExtension
  MismatchedAdapter
  UnsupportedFire
  RefinedIsNotExact
  WrongExtensionParent
  MissingExtensionMember
  ExtraExtensionMember
  WrongExtensionMemberType
  ValidIsNotReadyValidCompatible
  UnsafeControlStrengthening
