#lang rhdl
// Exercises inferred canonical packing for aggregate data and existing Bits values.

bundle Pair(T):
  high: T
  low: T

circuit AsBits():
  input pair: Pair(Bits(2))
  input lanes: Vec(2, Bits(3))
  input raw: Bits(2)
  output pair_bits: Bits(4)
  output lane_bits: Bits(6)
  output raw_bits: Bits(2)

  pair_bits <== as_bits(pair)
  lane_bits <== as_bits(lanes)
  raw_bits <== as_bits(raw)

circuit ControlAsBits():
  input clk: Clock
  output result: Bits(1)
  result <== as_bits(clk)

def design = elaborate(AsBits())

export:
  AsBits
  ControlAsBits
  design
