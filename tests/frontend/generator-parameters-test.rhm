#lang rhombus
// Checks normalized generator bindings for positional and keyword defaults and overrides.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../examples/rhdl/generator-parameters.rhdl" as example
  "generator-parameters.rhdl" as fixture

fun result_width(design):
  design.modules[0].find_output("result").type.width

check:
  result_width(example.ordinary_defaults_design) ~is 9
  result_width(example.ordinary_overrides_design) ~is 7
  result_width(example.ordinary_typed_defaults_design) ~is 8
  result_width(example.ordinary_required_keyword_design) ~is 9
  result_width(example.sync_defaults_design) ~is 7
  result_width(example.sync_overrides_design) ~is 8
  result_width(example.sync_typed_defaults_design) ~is 7
  verify_design(example.ordinary_defaults_design) ~is #void
  verify_design(example.ordinary_overrides_design) ~is #void
  verify_design(example.ordinary_typed_defaults_design) ~is #void
  verify_design(example.ordinary_required_keyword_design) ~is #void
  verify_design(example.sync_defaults_design) ~is #void
  verify_design(example.sync_overrides_design) ~is #void
  verify_design(example.sync_typed_defaults_design) ~is #void
  embedded.run_elaboration(
    fun (): fixture.InvalidKeywordHardwareParameter()
  ) ~throws "circuit parameters must be host values"
