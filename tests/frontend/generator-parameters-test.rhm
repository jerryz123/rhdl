#lang rhombus
// Checks normalized generator bindings for positional and keyword defaults and overrides.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "generator-parameters.rhdl" as fixture

fun result_width(design):
  design.modules[0].find_output("result").type.width

check:
  result_width(fixture.ordinary_defaults) ~is 9
  result_width(fixture.ordinary_overrides) ~is 7
  result_width(fixture.ordinary_typed_defaults) ~is 8
  result_width(fixture.ordinary_required_keyword) ~is 9
  result_width(fixture.sync_defaults) ~is 7
  result_width(fixture.sync_overrides) ~is 8
  result_width(fixture.sync_typed_defaults) ~is 7
  verify_design(fixture.ordinary_defaults) ~is #void
  verify_design(fixture.ordinary_overrides) ~is #void
  verify_design(fixture.ordinary_typed_defaults) ~is #void
  verify_design(fixture.ordinary_required_keyword) ~is #void
  verify_design(fixture.sync_defaults) ~is #void
  verify_design(fixture.sync_overrides) ~is #void
  verify_design(fixture.sync_typed_defaults) ~is #void
  embedded.run_elaboration(
    fun (): fixture.InvalidKeywordHardwareParameter()
  ) ~throws "circuit parameters must be host values"
