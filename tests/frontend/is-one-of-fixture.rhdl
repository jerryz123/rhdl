#lang rhdl
// Exercises variadic, host-list, and empty typed hardware membership comparisons.

hardware_enum MembershipState:
  Idle
  Refill
  Respond

circuit IsOneOf():
  input state: MembershipState
  input value: Bits(4)
  output active: Bool
  output small: Bool
  output exact: Bool
  output listed: Bool
  output never: Bool

  active <== is_one_of(
    state,
    MembershipState.Refill,
    MembershipState.Respond
  )
  small <== is_one_of(value, bits(1, 4), bits(2, 4), bits(3, 4))
  exact <== is_one_of(value, bits(7, 4))
  listed <== is_one_of(value, [bits(4, 4), bits(5, 4)])
  never <== is_one_of(value, [])

def design = elaborate(IsOneOf())

export:
  MembershipState
  IsOneOf
  design
