#lang rhdl/base
// Builds the enum switch state machine from explicitly selected frontend layers.

import:
  lib("rhdl/frontend/layers/comb.rhm") open
  lib("rhdl/frontend/layers/sequential.rhm") open
  lib("rhdl/frontend/layers/enum.rhm") open
  lib("rhdl/frontend/layers/conditional.rhm") open

hardware_enum State:
  Idle
  Running
  Done

circuit StateMachine():
  input clock: Clock
  input reset: Reset
  output state_out: State

  reg current(State, ~clock: clock, ~reset: reset, ~init: State.Idle)
  switch current:
    case State.Idle:
      current.next <== State.Running
    case State.Running:
      current.next <== State.Done
    case State.Done:
      current.next <== State.Idle
    otherwise:
      current.next <== State.Idle
  state_out <== current

def design = elaborate(StateMachine())

export:
  State
  StateMachine
  design
