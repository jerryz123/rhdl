#lang rhdl/base
// Builds the enum state machine from only explicitly selected frontend layers.

import:
  lib("rhdl/frontend/layers/comb.rhm") open
  lib("rhdl/frontend/layers/sequential.rhm") open
  lib("rhdl/frontend/layers/enum.rhm") open

hardware_enum State:
  Idle
  Running
  Done

circuit StateMachine():
  input clock: Clock
  input reset: Reset
  output state_out: State

  reg current(State, ~clock: clock, ~reset: reset, ~init: State.Idle)
  current.next <== mux_lookup(current, ~default: State.Idle):
    State.Idle: State.Running
    State.Running: State.Done
    State.Done: State.Idle
  state_out <== current

def design = elaborate(StateMachine())

export:
  State
  StateMachine
  design
