#lang rhdl
// Elaborates an embedded RHDL ALU at width five to test host parameterization.

circuit ALU(width):
  def a = input("a", Bits(width))
  def b = input("b", Bits(width))
  def op = input("op", Bits(3))
  def result = output("result", Bits(width))
  def equal = output("equal", Bits(1))
  def and_result = a & b
  def or_result = bit_or(a, b)
  def xor_result = a ^ b
  def add_result = a + b
  def sub_result = a - b
  def not_result = bit_not(a)
  def equal_result = a === b
  def op_and = literal(Bits(3), 0)
  def op_or = literal(Bits(3), 1)
  def op_xor = literal(Bits(3), 2)
  def op_add = literal(Bits(3), 3)
  def op_sub = literal(Bits(3), 4)
  def is_and = op === op_and
  def is_or = op === op_or
  def is_xor = op === op_xor
  def is_add = op === op_add
  def is_sub = op === op_sub
  def select_sub = mux(is_sub, sub_result, not_result)
  def select_add = mux(is_add, add_result, select_sub)
  def select_xor = mux(is_xor, xor_result, select_add)
  def select_or = mux(is_or, or_result, select_xor)
  def selected = mux(is_and, and_result, select_or)
  result <== selected
  equal <== equal_result

def design = elaborate(ALU(5))

export:
  design
