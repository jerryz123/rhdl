#lang rhdl
// Defines invalid OneHot uses for focused elaboration diagnostics.

def Grant4 = OneHot(4)
def Grant3 = OneHot(3)

fun require_grant4(value :: OneHot(4)):
  value

circuit ForeignMuxKey():
  input selector: Grant4
  output result: Grant4
  result <== mux_lookup(selector, ~default: Grant4(0)):
    Grant3(0): Grant4(1)

circuit IntegerMuxKey():
  input selector: Grant4
  output result: Grant4
  result <== mux_lookup(selector, ~default: Grant4(0)):
    1: Grant4(1)

circuit BitwiseOneHot():
  input(left, right): Grant4
  output result: Grant4
  result <== left & right

circuit WrongDrive():
  input raw: Bits(4)
  output result: Grant4
  result <== raw

circuit WrongAnnotation():
  input value: Grant3
  require_grant4(value)

export:
  ForeignMuxKey
  IntegerMuxKey
  BitwiseOneHot
  WrongDrive
  WrongAnnotation
