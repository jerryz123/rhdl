#lang rhombus
// Checks fresh frontend module symbols and declaration-identity recursion tracking.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as kernel
  "../../examples/fresh-generators.rhdl" open

def outer_identity = kernel.new_circuit_identity("SameName")
def inner_identity = kernel.new_circuit_identity("SameName")

fun inner_generator():
  fun implementation(): #void
  kernel.build_circuit(inner_identity, "SameName", [], implementation)

fun outer_generator():
  fun implementation(): inner_generator()
  kernel.build_circuit(outer_identity, "SameName", [], implementation)

def same_name_design = kernel.run_elaboration(fun (): outer_generator())

check:
  design.modules.map(fun (module_def): module_def.name) ~is ["Top", "Adder", "Adder_1"]
  design.modules.filter(~keep: fun (module_def): module_def.name.starts_with("Adder")).length() ~is 2
  verify_design(design) ~is #void
  same_name_design.modules.map(fun (module_def): module_def.name) ~is ["SameName", "SameName_1"]
  verify_design(same_name_design) ~is #void
