#lang rhdl
// Defines invalid multi-result DPI uses for focused frontend diagnostics.

dpi_import function rhdl_step_pair(value: Bits(8)) -> (out doubled: Bits(8), return incremented: Bits(8))

sync_circuit SingularBinding():
  input value: Bits(8)
  output result: Bits(8)

  dpi_reg step = rhdl_step_pair(value)
  result <== step

sync_circuit WrongResultCount():
  input value: Bits(8)
  output result: Bits(8)

  dpi_reg (first, second, third) = rhdl_step_pair(value)
  result <== first

export:
  SingularBinding
  WrongResultCount
