#lang rhombus
// Checks OneHot typing, literals, mux selection, casts, and invalid uses.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/frontend/layers/one-hot.rhm" as one_hot
  "../../rhdl/frontend/support/mux-lookup.rhm" as mux_support
  "../../examples/one-hot.rhdl" as fixture
  "one-hot-invalid.rhdl" as invalid

def design = fixture.design
def module_def = design.modules[0]
def lookup = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.mux_lookup"
)
def equality = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.eq"
)

check:
  one_hot.one_hot_type(fixture.Grant) ~is #true
  one_hot.one_hot_width(fixture.Grant) ~is 4
  type_text(fixture.Grant) ~is "onehot<4>"
  type_equal(fixture.Grant, one_hot.OneHot(4)) ~is #true
  type_equal(fixture.Grant, Bits(4)) ~is #false
  fixture.Grant(0) is_a mux_support.MuxLookupKey ~is #true
  one_hot.OneHot(4)(3) is_a mux_support.MuxLookupKey ~is #true
  type_equal(module_def.find_input("current").type, fixture.Grant) ~is #true
  type_equal(module_def.find_output("next_grant").type, fixture.Grant) ~is #true
  type_equal(module_def.find_output("current_bits").type, Bits(4)) ~is #true
  lookup.attribute("keys") ~is [1, 2, 4, 8]
  type_equal(lookup.operands[0].type, Bits(4)) ~is #true
  (for all (case_value in lookup.operands.drop(1)):
     type_equal(case_value.type, fixture.Grant)) ~is #true
  type_equal(lookup.results[0].type, fixture.Grant) ~is #true
  type_equal(equality.operands[0].type, Bits(4)) ~is #true
  type_equal(equality.operands[1].type, Bits(4)) ~is #true
  verify_design(design) ~is #void

  one_hot.OneHot(0) ~throws "width must be a positive host Int"
  one_hot.one_hot_width(Bits(4)) ~throws "expected a OneHot type"
  fixture.Grant(-1) ~throws "literal index must satisfy 0 <= index < width"
  fixture.Grant(4) ~throws "literal index must satisfy 0 <= index < width"
  embedded.run_elaboration(fun (): invalid.ForeignMuxKey()) ~throws "one-hot mux lookup keys must belong to the selector's OneHot type"
  embedded.run_elaboration(fun (): invalid.IntegerMuxKey()) ~throws "one-hot mux lookup keys must belong to the selector's OneHot type"
  embedded.run_elaboration(fun (): invalid.BitwiseOneHot()) ~throws "operands must have exactly the same bitwise type"
  embedded.run_elaboration(fun (): invalid.WrongDrive()) ~throws "exactly the same hardware type"
  embedded.run_elaboration(fun (): invalid.WrongAnnotation()) ~throws "argument does not satisfy annotation"
