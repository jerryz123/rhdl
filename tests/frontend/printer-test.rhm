#lang rhombus
// Checks deterministic IR printing using designs elaborated by the frontend.

import:
  "../../rhdl/core/main.rhm" open
  "../../examples/adder.rhdl" as adder_fixture
  "../../examples/alu.rhdl" as alu_fixture
  "../../examples/width-ops.rhdl" as width_fixture
  "../../examples/counter.rhdl" as counter_fixture

def first = dump_ir(adder_fixture.design)
def second = dump_ir(adder_fixture.design)

check:
  first ~is second
  first.contains("rhdl.module @Adder8") ~is #true
  first.contains("%v7 = rtl.add %a, %b : bits<8>") ~is #true
  first.contains("rtl.drive &sum, %v7") ~is #true

def counter_ir = dump_ir(counter_fixture.design)

check:
  counter_ir.contains("rtl.register clock %clk reset %reset to %zero") ~is #true
  counter_ir.contains("rtl.drive &state.next, %next") ~is #true

def alu_ir = dump_ir(alu_fixture.design)

check:
  alu_ir.contains(" = rtl.not %a : bits<8>") ~is #true
  alu_ir.contains(" = rtl.eq %a, %b : bits<1>") ~is #true
  alu_ir.contains(" = rtl.mux ") ~is #true

def width_ir = dump_ir(width_fixture.design)

check:
  width_ir.contains("%joined_value = rtl.concat %a, %b : bits<12>") ~is #true
  width_ir.contains("%middle_value = rtl.extract %a 5:2 : bits<4>") ~is #true
  width_ir.contains("%widened_value = rtl.zext %a to bits<12>") ~is #true
  width_ir.contains("%narrowed_value = rtl.trunc %a to bits<4>") ~is #true
