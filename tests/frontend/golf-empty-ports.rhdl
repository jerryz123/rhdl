#lang rhdl/golf
// Exercises compact circuits with empty input, output, or complete port sides.

c Source(w)[->value:B(w)] = bits(0, w)

c Sink(w)[value:B(w)->]:
  def observed = value

c Empty()[->]:
  def host_only = #true

def source_design = elaborate(Source(8))
def sink_design = elaborate(Sink(8))
def empty_design = elaborate(Empty())

export:
  source_design
  sink_design
  empty_design
