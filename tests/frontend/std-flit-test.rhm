#lang rhombus
// Checks standard flit shapes, conversion composition, and invalid authoring uses.

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../rhodium/std/flit.rhdl" as flit
  "std-flit.rhdl" as fixture

def fixed_design = embedded.run_elaboration(
  fun (): fixture.FixedFramingRoundTrip()
)
def variable_design = embedded.run_elaboration(
  fun (): fixture.VariableFixedRoundTrip()
)
def fixed_top = fixed_design.modules[0]
def variable_top = variable_design.modules[0]
def structural_fixed_flit = fixture.FixedFlitImpostor(Bits(8))

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

check:
  fixed_design.modules.map(fun (module_def): module_def.name) ~is [
    "FixedFramingRoundTrip", "Counter"
  ]
  operations(fixed_top, "rtl.instance").length() ~is 2
  operations(fixed_top, "verif.assert").map(
    fun (operation): operation.attribute("label")
  ) ~is ["fixed_flit_first_matches_phase",
         "fixed_flit_last_matches_phase"]
  verify_design(fixed_design) ~is #void

  variable_design.modules.map(fun (module_def): module_def.name) ~is [
    "VariableFixedRoundTrip", "Counter"
  ]
  operations(variable_top, "rtl.instance").length() ~is 1
  operations(variable_top, "verif.assert").map(
    fun (operation): operation.attribute("label")
  ) ~is ["fixed_flit_first_matches_phase",
         "fixed_flit_last_matches_phase"]
  verify_design(variable_design) ~is #void

  type_equal(structural_fixed_flit, flit.FixedFlit(Bits(8))) ~is #true
  flit.FixedFlit.require_specialization(structural_fixed_flit) ~throws "expected a FixedFlit specialization"

  embedded.run_elaboration(
    fun (): fixture.FrameWrongShape()
  ) ~throws "expected a FixedFlit specialization"
  embedded.run_elaboration(
    fun (): fixture.RequireWrongShape()
  ) ~throws "expected a VariableFlit specialization"
  embedded.run_elaboration(
    fun (): fixture.StripVariableShape()
  ) ~throws "expected a FramedFixedFlit specialization"
  embedded.run_elaboration(
    fun (): fixture.DirectFramingConnection()
  ) ~throws "provider interface does not support the peer interface contract"
  embedded.run_elaboration(
    fun (): fixture.FrameMissingSyncDomain()
  ) ~throws "active sync_circuit"
