#lang rhombus
// Checks standard flow-control generators, parameter validation, and public IR shape.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/std/flow.rhdl" as flow
  "../../rhdl/std/flow/pipe.rhdl" as pipe
  "../../rhdl/std/flow/queue.rhdl" as queue
  "../../rhdl/std/flow/arbiter.rhdl" as arbiter
  "../../rhdl/std/flow/rr-arbiter.rhdl" as rr_arbiter
  "../../rhdl/std/flow/demux.rhdl" as demux
  "../../rhdl/std/flow/join.rhdl" as join
  "../../rhdl/std/flow/broadcast.rhdl" as broadcast

// The aggregate and focused modules are both supported public import paths.
def direct_pipe_design = embedded.run_elaboration(
  fun (): pipe.Pipe(Bits(8), 1)
)
def direct_queue_design = embedded.run_elaboration(
  fun (): queue.Queue(Bits(8), 1)
)
def direct_arbiter_design = embedded.run_elaboration(
  fun (): arbiter.Arbiter(Bits(8), 1)
)
def direct_rr_arbiter_design = embedded.run_elaboration(
  fun (): rr_arbiter.RRArbiter(Bits(8), 1)
)
def direct_demux_design = embedded.run_elaboration(
  fun (): demux.Demux(Bits(8), 1)
)
def direct_join_design = embedded.run_elaboration(
  fun (): join.Join(Bits(8), 1)
)
def direct_broadcast_design = embedded.run_elaboration(
  fun (): broadcast.Broadcast(Bits(8), 1)
)
def direct_ctrl_pipe_design = embedded.run_elaboration(
  fun (): pipe.CtrlPipe(1)
)
def direct_ctrl_queue_design = embedded.run_elaboration(
  fun (): queue.CtrlQueue(1)
)
def direct_ctrl_arbiter_design = embedded.run_elaboration(
  fun (): arbiter.CtrlArbiter(1)
)
def direct_ctrl_rr_arbiter_design = embedded.run_elaboration(
  fun (): rr_arbiter.CtrlRRArbiter(1)
)
def direct_ctrl_demux_design = embedded.run_elaboration(
  fun (): demux.CtrlDemux(1)
)
def direct_ctrl_join_design = embedded.run_elaboration(
  fun (): join.CtrlJoin(1)
)
def direct_ctrl_broadcast_design = embedded.run_elaboration(
  fun (): broadcast.CtrlBroadcast(1)
)

def pipe_one_design = embedded.run_elaboration(
  fun (): flow.Pipe(Bits(8), 1)
)
def pipe_one = pipe_one_design.modules[0]
def pipe_three_design = embedded.run_elaboration(
  fun (): flow.Pipe(Bits(16), 3)
)
def pipe_three = pipe_three_design.modules[0]
def queue_one_design = embedded.run_elaboration(
  fun (): flow.Queue(Bits(8), 1)
)
def queue_one = queue_one_design.modules[0]
def queue_three_design = embedded.run_elaboration(
  fun (): flow.Queue(Bits(8), 3)
)
def queue_three = queue_three_design.modules[0]
def queue_three_pointer_counter = queue_three_design.modules[1]
def queue_pipe_design = embedded.run_elaboration(
  fun (): flow.Queue(Bits(8), 2, ~pipe: #true)
)
def queue_flow_design = embedded.run_elaboration(
  fun (): flow.Queue(Bits(8), 2, ~flow: #true)
)
def queue_options_design = embedded.run_elaboration(
  fun ():
    flow.Queue(Bits(8), 2,
               ~pipe: #true,
               ~flow: #true)
)
def queue_options = queue_options_design.modules[0]
def arbiter_one_design = embedded.run_elaboration(
  fun (): flow.Arbiter(Bits(8), 1)
)
def arbiter_one = arbiter_one_design.modules[0]
def arbiter_three_design = embedded.run_elaboration(
  fun (): flow.Arbiter(Bits(8), 3)
)
def arbiter_three = arbiter_three_design.modules[0]
def rr_arbiter_three_design = embedded.run_elaboration(
  fun (): flow.RRArbiter(Bits(8), 3)
)
def rr_arbiter_three = rr_arbiter_three_design.modules[0]
def demux_three_design = embedded.run_elaboration(
  fun (): flow.Demux(Bits(8), 3)
)
def demux_three = demux_three_design.modules[0]
def join_three_design = embedded.run_elaboration(
  fun (): flow.Join(Bits(8), 3)
)
def join_three = join_three_design.modules[0]
def broadcast_three_design = embedded.run_elaboration(
  fun (): flow.Broadcast(Bits(8), 3)
)
def broadcast_three = broadcast_three_design.modules[0]
def ctrl_pipe_three_design = embedded.run_elaboration(
  fun (): flow.CtrlPipe(3)
)
def ctrl_pipe_three = ctrl_pipe_three_design.modules[0]
def ctrl_queue_one_design = embedded.run_elaboration(
  fun (): flow.CtrlQueue(1)
)
def ctrl_queue_one = ctrl_queue_one_design.modules[0]
def ctrl_queue_three_design = embedded.run_elaboration(
  fun (): flow.CtrlQueue(3)
)
def ctrl_queue_three = ctrl_queue_three_design.modules[0]
def ctrl_queue_options_design = embedded.run_elaboration(
  fun ():
    flow.CtrlQueue(2,
                   ~pipe: #true,
                   ~flow: #true)
)
def ctrl_arbiter_three_design = embedded.run_elaboration(
  fun (): flow.CtrlArbiter(3)
)
def ctrl_arbiter_three = ctrl_arbiter_three_design.modules[0]
def ctrl_rr_arbiter_three_design = embedded.run_elaboration(
  fun (): flow.CtrlRRArbiter(3)
)
def ctrl_rr_arbiter_three = ctrl_rr_arbiter_three_design.modules[0]
def ctrl_demux_three_design = embedded.run_elaboration(
  fun (): flow.CtrlDemux(3)
)
def ctrl_demux_three = ctrl_demux_three_design.modules[0]
def ctrl_join_three_design = embedded.run_elaboration(
  fun (): flow.CtrlJoin(3)
)
def ctrl_join_three = ctrl_join_three_design.modules[0]
def ctrl_broadcast_three_design = embedded.run_elaboration(
  fun (): flow.CtrlBroadcast(3)
)
def ctrl_broadcast_three = ctrl_broadcast_three_design.modules[0]
def aggregate_type = RecordType([
  RecordField("tag", Bits(2)),
  RecordField("data", Bits(8))
])
def aggregate_pipe_design = embedded.run_elaboration(
  fun (): flow.Pipe(aggregate_type, 2)
)
def aggregate_queue_design = embedded.run_elaboration(
  fun (): flow.Queue(aggregate_type, 2)
)
def aggregate_arbiter_design = embedded.run_elaboration(
  fun (): flow.Arbiter(aggregate_type, 2)
)
def aggregate_rr_arbiter_design = embedded.run_elaboration(
  fun (): flow.RRArbiter(aggregate_type, 2)
)
def aggregate_demux_design = embedded.run_elaboration(
  fun (): flow.Demux(aggregate_type, 2)
)
def aggregate_join_design = embedded.run_elaboration(
  fun (): flow.Join(aggregate_type, 2)
)
def aggregate_broadcast_design = embedded.run_elaboration(
  fun (): flow.Broadcast(aggregate_type, 2)
)

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

check:
  verify_design(direct_pipe_design) ~is #void
  verify_design(direct_queue_design) ~is #void
  verify_design(direct_arbiter_design) ~is #void
  verify_design(direct_rr_arbiter_design) ~is #void
  verify_design(direct_demux_design) ~is #void
  verify_design(direct_join_design) ~is #void
  verify_design(direct_broadcast_design) ~is #void
  verify_design(direct_ctrl_pipe_design) ~is #void
  verify_design(direct_ctrl_queue_design) ~is #void
  verify_design(direct_ctrl_arbiter_design) ~is #void
  verify_design(direct_ctrl_rr_arbiter_design) ~is #void
  verify_design(direct_ctrl_demux_design) ~is #void
  verify_design(direct_ctrl_join_design) ~is #void
  verify_design(direct_ctrl_broadcast_design) ~is #void

  pipe_one.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_in", "egress_in"
  ]
  pipe_one.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_out"
  ]
  operations(pipe_one, "rtl.register_reset").length() ~is 1
  operations(pipe_one, "rtl.register").length() ~is 1
  operations(pipe_three, "rtl.register_reset")[0].results[0].type.length ~is 3
  operations(pipe_three, "rtl.register")[0].results[0].type.length ~is 3

  queue_one.memories.length() ~is 0
  operations(queue_one, "rtl.register_reset").length() ~is 1
  operations(queue_one, "rtl.register").length() ~is 1
  queue_three.memories[0].depth ~is 3
  operations(queue_three, "rtl.memory_read_async").length() ~is 1
  operations(queue_three, "rtl.memory_write").length() ~is 1
  operations(queue_three, "rtl.register_reset").length() ~is 1
  operations(queue_three, "rtl.instance").length() ~is 2
  queue_three_design.modules.length() ~is 2
  queue_three_pointer_counter.name ~is "Counter"
  queue_three_pointer_counter.find_output("value").type.width ~is 2
  operations(queue_three_pointer_counter, "rtl.register_reset").length() ~is 1
  queue_one.find_output("count").type.width ~is 1
  queue_three.find_output("count").type.width ~is 2
  queue_options.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_in", "egress_in"
  ]
  queue_options.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_out", "count"
  ]

  arbiter_one.find_output("chosen").type.width ~is 1
  arbiter_three.inputs.map(fun (port): port.name) ~is [
    "ingress_0_in", "ingress_1_in", "ingress_2_in", "egress_in"
  ]
  arbiter_three.outputs.map(fun (port): port.name) ~is [
    "ingress_0_out", "ingress_1_out", "ingress_2_out", "egress_out", "chosen"
  ]
  arbiter_three.find_output("chosen").type.width ~is 2

  rr_arbiter_three.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_0_in", "ingress_1_in", "ingress_2_in", "egress_in"
  ]
  rr_arbiter_three.find_output("chosen").type.width ~is 2
  operations(rr_arbiter_three, "rtl.register_reset").length() ~is 1

  demux_three.inputs.map(fun (port): port.name) ~is [
    "ingress_in", "select", "egress_0_in", "egress_1_in", "egress_2_in"
  ]
  demux_three.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_0_out", "egress_1_out", "egress_2_out"
  ]

  join_three.find_output("egress_out").type.field("bits").type.length ~is 3
  join_three.find_output("egress_out").type.field("bits").type.element_type.width ~is 8

  broadcast_three.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_in", "egress_0_in", "egress_1_in", "egress_2_in"
  ]
  operations(broadcast_three, "rtl.register_reset").length() ~is 1
  operations(broadcast_three, "rtl.register").length() ~is 1

  // Control-only modules expose only valid/ready protocol fields and avoid
  // payload registers, memories, and pointer instances.
  ctrl_pipe_three.find_output("egress_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid"]
  operations(ctrl_pipe_three, "rtl.register_reset").length() ~is 1
  operations(ctrl_pipe_three, "rtl.register").length() ~is 0
  operations(ctrl_pipe_three, "rtl.register_reset")[0].results[0].type.length ~is 3

  ctrl_queue_one.memories.length() ~is 0
  operations(ctrl_queue_one, "rtl.register_reset").length() ~is 1
  operations(ctrl_queue_one, "rtl.register").length() ~is 0
  ctrl_queue_three.memories.length() ~is 0
  operations(ctrl_queue_three, "rtl.instance").length() ~is 0
  operations(ctrl_queue_three, "rtl.register_reset").length() ~is 1
  operations(ctrl_queue_three, "rtl.register").length() ~is 0
  ctrl_queue_three.find_output("count").type.width ~is 2

  ctrl_arbiter_three.find_output("chosen").type.width ~is 2
  ctrl_rr_arbiter_three.find_output("chosen").type.width ~is 2
  operations(ctrl_rr_arbiter_three, "rtl.register_reset").length() ~is 1
  ctrl_demux_three.find_output("egress_0_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid"]
  ctrl_join_three.find_output("egress_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid"]
  operations(ctrl_broadcast_three, "rtl.register_reset").length() ~is 1
  operations(ctrl_broadcast_three, "rtl.register").length() ~is 0

  verify_design(pipe_one_design) ~is #void
  verify_design(pipe_three_design) ~is #void
  verify_design(queue_one_design) ~is #void
  verify_design(queue_three_design) ~is #void
  verify_design(queue_pipe_design) ~is #void
  verify_design(queue_flow_design) ~is #void
  verify_design(queue_options_design) ~is #void
  verify_design(arbiter_one_design) ~is #void
  verify_design(arbiter_three_design) ~is #void
  verify_design(rr_arbiter_three_design) ~is #void
  verify_design(demux_three_design) ~is #void
  verify_design(join_three_design) ~is #void
  verify_design(broadcast_three_design) ~is #void
  verify_design(aggregate_pipe_design) ~is #void
  verify_design(aggregate_queue_design) ~is #void
  verify_design(aggregate_arbiter_design) ~is #void
  verify_design(aggregate_rr_arbiter_design) ~is #void
  verify_design(aggregate_demux_design) ~is #void
  verify_design(aggregate_join_design) ~is #void
  verify_design(aggregate_broadcast_design) ~is #void
  verify_design(ctrl_pipe_three_design) ~is #void
  verify_design(ctrl_queue_one_design) ~is #void
  verify_design(ctrl_queue_three_design) ~is #void
  verify_design(ctrl_queue_options_design) ~is #void
  verify_design(ctrl_arbiter_three_design) ~is #void
  verify_design(ctrl_rr_arbiter_three_design) ~is #void
  verify_design(ctrl_demux_three_design) ~is #void
  verify_design(ctrl_join_three_design) ~is #void
  verify_design(ctrl_broadcast_three_design) ~is #void

  embedded.run_elaboration(fun (): flow.Pipe(Bits(8), 0)) ~throws "stages must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Pipe(Bits(8), -1)) ~throws "stages must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Queue(Bits(8), 0)) ~throws "depth must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Queue(Bits(8), -1)) ~throws "depth must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Arbiter(Bits(8), 0)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Arbiter(Bits(8), -1)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.RRArbiter(Bits(8), 0)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Demux(Bits(8), 0)) ~throws "output count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Join(Bits(8), 0)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Broadcast(Bits(8), 0)) ~throws "output count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.RRArbiter(Bits(8), -1)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Demux(Bits(8), -1)) ~throws "output count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Join(Bits(8), -1)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Broadcast(Bits(8), -1)) ~throws "output count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.Pipe(Bits(8), "two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.Queue(Bits(8), "two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(
    fun (): flow.Queue(Bits(8), 2, ~pipe: "yes")
  ) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(
    fun (): flow.Queue(Bits(8), 2, ~flow: 1)
  ) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.Arbiter(Bits(8), "two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.RRArbiter(Bits(8), "two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.Demux(Bits(8), "two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.Join(Bits(8), "two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.Broadcast(Bits(8), "two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.CtrlPipe(0)) ~throws "stages must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlPipe(-1)) ~throws "stages must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlQueue(0)) ~throws "depth must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlQueue(-1)) ~throws "depth must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlArbiter(0)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlArbiter(-1)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlRRArbiter(0)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlRRArbiter(-1)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlDemux(0)) ~throws "output count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlDemux(-1)) ~throws "output count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlJoin(0)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlJoin(-1)) ~throws "input count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlBroadcast(0)) ~throws "output count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlBroadcast(-1)) ~throws "output count must be a positive host Int"
  embedded.run_elaboration(fun (): flow.CtrlPipe("two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.CtrlQueue("two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(
    fun (): flow.CtrlQueue(2, ~pipe: "yes")
  ) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(
    fun (): flow.CtrlQueue(2, ~flow: 1)
  ) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.CtrlArbiter("two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.CtrlRRArbiter("two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.CtrlDemux("two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.CtrlJoin("two")) ~throws "argument does not satisfy annotation"
  embedded.run_elaboration(fun (): flow.CtrlBroadcast("two")) ~throws "argument does not satisfy annotation"
