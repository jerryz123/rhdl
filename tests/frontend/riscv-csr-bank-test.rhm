#lang rhombus
// Checks CSR-bank expansion, aggregate effects, and table validation.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "riscv-csr-bank-fixture.rhdl" as fixture

def design = embedded.run_elaboration(fun (): fixture.CsrBankFixture())
def module_def = design.modules[0]

check:
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name")) ~is ["stored"]
  verify_design(design) ~is #void
  embedded.run_elaboration(
    fun (): fixture.DuplicateCsrBankFixture()
  ) ~throws "unique"
  embedded.run_elaboration(
    fun (): fixture.NarrowCsrBankFixture()
  ) ~throws "Bits(12)"
