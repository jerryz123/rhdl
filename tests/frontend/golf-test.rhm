#lang rhombus
// Checks the first Golf surface, standard compatibility, and public-IR equivalence.

import:
  "../../rhdl/core/main.rhm" open
  "golf-adder.rhdl" as golf_fixture
  "golf-standard.rhdl" as golf_standard_fixture
  "../../examples/golf/adder.rhdl" as golf_example
  "../../examples/lop/adder-standard.rhdl" as standard_fixture

def golf_ir = dump_ir(golf_example.design)
def golf_standard_ir = dump_ir(golf_standard_fixture.design)
def standard_ir = dump_ir(standard_fixture.design)
def golf_module = golf_example.design.modules[0]
def golf_body_module = golf_fixture.body_design.modules[0]
def golf_homogeneous_body_module = golf_fixture.homogeneous_body_design.modules[0]
def golf_inputs = golf_module.inputs.map(fun (port): [port.name, type_text(port.type)])
def golf_outputs = golf_module.outputs.map(fun (port): [port.name, type_text(port.type)])
def golf_opcodes = golf_module.operations.map(fun (operation): operation.opcode)
def golf_body_opcodes = golf_body_module.operations.map(fun (operation): operation.opcode)
def golf_homogeneous_body_opcodes = golf_homogeneous_body_module.operations.map(fun (operation): operation.opcode)

check:
  verify_design(golf_example.design) ~is #void
  verify_design(golf_fixture.body_design) ~is #void
  verify_design(golf_fixture.homogeneous_body_design) ~is #void
  verify_design(golf_standard_fixture.design) ~is #void
  golf_ir ~is standard_ir
  golf_standard_ir ~is standard_ir
  golf_body_opcodes ~is golf_opcodes
  golf_homogeneous_body_opcodes ~is golf_opcodes
  type_equal(golf_fixture.short_type, golf_fixture.canonical_type) ~is #true
  golf_module.name ~is "Adder"
  golf_inputs ~is [["a", "bits<8>"], ["b", "bits<8>"]]
  golf_outputs ~is [["sum", "bits<8>"]]
