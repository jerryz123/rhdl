#lang rhombus
// Constructs shared arithmetic, sequential, and hierarchy fixtures for RHDL tests.

import:
  "../rhdl/main.rhm" open

export:
  make_adder_design
  make_alu_design
  make_counter_design
  make_hierarchy_design

fun make_adder_design(width = 8):
  def design = Design()
  def builder = Builder(design)
  def adder = builder.module("Adder" ++ to_string(width))
  def a = builder.input(adder, "a", Bits(width))
  def b = builder.input(adder, "b", Bits(width))
  def sum = builder.output(adder, "sum", Bits(width))
  def result = builder.add(adder, a, b, "result")
  builder.drive(sum, result)
  def finished = builder.finish(adder)
  [design, builder, adder, a, b, sum, result]

fun make_alu_design(width = 8):
  def design = Design()
  def builder = Builder(design)
  def alu = builder.module("ALU" ++ to_string(width))
  def a = builder.input(alu, "a", Bits(width))
  def b = builder.input(alu, "b", Bits(width))
  def op = builder.input(alu, "op", Bits(3))
  def result = builder.output(alu, "result", Bits(width))
  def equal = builder.output(alu, "equal", Bits(1))

  def and_result = builder.bit_and(alu, a, b, "and_result")
  def or_result = builder.bit_or(alu, a, b, "or_result")
  def xor_result = builder.bit_xor(alu, a, b, "xor_result")
  def add_result = builder.add(alu, a, b, "add_result")
  def sub_result = builder.sub(alu, a, b, "sub_result")
  def not_result = builder.bit_not(alu, a, "not_result")
  def equal_result = builder.eq(alu, a, b, "equal_result")

  def op_and = builder.constant(alu, Bits(3), 0, "op_and")
  def op_or = builder.constant(alu, Bits(3), 1, "op_or")
  def op_xor = builder.constant(alu, Bits(3), 2, "op_xor")
  def op_add = builder.constant(alu, Bits(3), 3, "op_add")
  def op_sub = builder.constant(alu, Bits(3), 4, "op_sub")
  def is_and = builder.eq(alu, op, op_and, "is_and")
  def is_or = builder.eq(alu, op, op_or, "is_or")
  def is_xor = builder.eq(alu, op, op_xor, "is_xor")
  def is_add = builder.eq(alu, op, op_add, "is_add")
  def is_sub = builder.eq(alu, op, op_sub, "is_sub")

  def select_sub = builder.mux(alu, is_sub, sub_result, not_result, "select_sub")
  def select_add = builder.mux(alu, is_add, add_result, select_sub, "select_add")
  def select_xor = builder.mux(alu, is_xor, xor_result, select_add, "select_xor")
  def select_or = builder.mux(alu, is_or, or_result, select_xor, "select_or")
  def selected = builder.mux(alu, is_and, and_result, select_or, "selected")

  builder.drive(result, selected)
  builder.drive(equal, equal_result)
  def finished = builder.finish(alu)
  [design, builder, alu, a, b, op, result, equal]

fun make_counter_design(width = 8):
  def design = Design()
  def builder = Builder(design)
  def counter = builder.module("Counter" ++ to_string(width))
  def clk = builder.input(counter, "clk", Bits(1))
  def reset = builder.input(counter, "reset", Bits(1))
  def count = builder.output(counter, "count", Bits(width))
  def zero = builder.constant(counter, Bits(width), 0, "zero")
  def one = builder.constant(counter, Bits(width), 1, "one")
  def state = builder.register(counter, "state", Bits(width), clk, reset, zero)
  def next = builder.add(counter, state.current, one, "next")
  builder.drive(state.next, next)
  builder.drive(count, state.current)
  def finished = builder.finish(counter)
  [design, builder, counter, count, state]

fun make_hierarchy_design(width = 8):
  def [design, builder, adder, _, _, _, _] = make_adder_design(width)
  def top = builder.module("TwoAdders")
  def a = builder.input(top, "a", Bits(width))
  def b = builder.input(top, "b", Bits(width))
  def c = builder.input(top, "c", Bits(width))
  def sum0 = builder.output(top, "sum0", Bits(width))
  def sum1 = builder.output(top, "sum1", Bits(width))
  def u0 = builder.instance(top, adder, "u0")
  def u1 = builder.instance(top, adder, "u1")
  builder.drive(u0.input("a"), a)
  builder.drive(u0.input("b"), b)
  builder.drive(u1.input("a"), a)
  builder.drive(u1.input("b"), c)
  builder.drive(sum0, u0.output("sum"))
  builder.drive(sum1, u1.output("sum"))
  def finished = builder.finish(top)
  [design, builder, adder, top, u0, u1]
