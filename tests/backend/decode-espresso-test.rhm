#lang rhombus
// Checks backend Espresso cover construction independently of frontend elaboration.

import:
  "../../rhdl/backend/decode/espresso.rhm" open

def inverted = minimize_decode_relation(
  2,
  1,
  [[0, 3, 0, 1]],
  1,
  1
)

check:
  inverted.invert_mask ~is 1
  inverted.terms.length() ~is 1
  inverted.terms[0].input_value ~is 0
  inverted.terms[0].input_care ~is 3
  inverted.terms[0].output_ones ~is 1
