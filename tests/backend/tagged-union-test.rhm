#lang rhombus
// Checks that frontend tagged unions lower through the generic flat CIRCT path.

import:
  "../../rhdl/backend/circt.rhm".emit_circt
  "../../examples/rhdl/tagged-union.rhdl" as fixture
  "../../examples/rhdl/nested-tagged-union.rhdl" as nested_fixture

def circt = emit_circt(fixture.design)
def nested_circt = emit_circt(nested_fixture.design)

check:
  circt.contains("in %request : i18") ~is #true
  circt.contains("out request_tag : i2") ~is #true
  circt.contains("hw.bitcast") ~is #true
  nested_circt.contains("in %message : i10") ~is #true
  nested_circt.contains("out rebuilt : i10") ~is #true
