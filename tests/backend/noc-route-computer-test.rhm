#lang rhombus
// Checks that router-local validated route tables lower into combinational CIRCT.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../examples/std/noc-route-computer.rhdl" as fixture

def circt = emit_circt(fixture.design)

check:
  circt.contains("hw.module @RouteComputerFixture") ~is #true
  circt.contains("in %source_route_key : i1") ~is #true
  circt.contains("out source_allowed_mask : i2") ~is #true
  circt.contains("in %middle_origin_key : i1") ~is #true
  circt.contains("out middle_allowed_mask : i2") ~is #true
  circt.contains("in %destination_origin_key : i1") ~is #true
  circt.contains("out destination_allowed_mask : i1") ~is #true
  circt.contains("rtl.decode") ~is #false
  circt.contains("comb.icmp eq") ~is #true
  circt.contains("comb.mux") ~is #true
  circt.contains("comb.extract") ~is #true
  circt ~is emit_circt(fixture.design)
