#lang rhombus
// Emits CIRCT MLIR for RV5Stage's cacheable/uncached instruction-memory router.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../cores/rv5stage/instruction-memory-router.rhdl".RV5StageInstructionMemoryRouter
  "../../riscv/isa/xlen.rhm".XLen

def design = embedded.run_elaboration(fun (): RV5StageInstructionMemoryRouter(XLen.X64))
print(emit_circt(design))
