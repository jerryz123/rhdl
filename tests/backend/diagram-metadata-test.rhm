#lang rhombus
// Checks that logical diagram metadata is invisible to CIRCT lowering.

import:
  "../../rhdl/backend/circt.rhm" open
  "../frontend/diagram-fixture.rhdl" as fixture

def circt = emit_circt(fixture.logical.design)

check:
  circt.contains("hw.module @DiagramFlow") ~is #true
  circt.contains("rhdl.interface.") ~is #false
  circt.contains("rhdl.sync-circuit") ~is #false
  circt.contains("transform:") ~is #false
