#lang rhombus
// Emits CIRCT MLIR for the reusable eight-bit iterative multiplier fixture.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../cores/multiplier.rhdl" as multiplier

def design = embedded.run_elaboration(fun (): multiplier.IterativeMultiplier(8))
print(emit_circt(design))
