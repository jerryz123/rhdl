#lang rhombus
// Emits CIRCT MLIR for the RV32 specialization of reusable RISC-V base counters.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rhdl/counters.rhdl" as counters

def design = embedded.run_elaboration(fun (): counters.RiscvBaseCounters(XLen.X32))
print(emit_circt(design))
