#lang rhombus
// Checks CIRCT preservation of synthesis freedom in RV64I ALU control decoding.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../cores/ricket/decode/alu-ctrl.rhdl" as controls

def design = embedded.run_elaboration(
  fun (): controls.RV64IAluInstructionDecoder()
)
def circt = emit_circt(design)

check:
  circt.contains("default_value_free_mask = hw.constant 1023 : i11") ~is #true
  circt.contains("output_value_free_mask = hw.constant 6 : i11") ~is #true
  circt.contains("output_value_free_mask = hw.constant 15 : i11") ~is #true
  circt.contains("sv.constantX : i11") ~is #true
