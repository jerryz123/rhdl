#lang rhombus
// Checks CIRCT output for automatic or fallback RV64I ALU control decoding.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/std/decode/espresso.rhdl" open
  "../../cores/ricket/decode/alu-ctrl.rhdl" as controls

def design = embedded.run_elaboration(
  fun (): controls.RV64IAluInstructionDecoder()
)
def circt = emit_circt(design)
def espresso_path = find_decode_espresso()

check:
  circt.contains("default_value_free_mask = hw.constant 1023 : i11") ~is !espresso_path
  circt.contains("output_value_free_mask = hw.constant 6 : i11") ~is !espresso_path
  circt.contains("output_value_free_mask = hw.constant 15 : i11") ~is !espresso_path
  circt.contains("sv.constantX : i11") ~is !espresso_path
  circt.contains("comb.icmp eq") ~is !espresso_path
  circt.contains("comb.mux") ~is !espresso_path
