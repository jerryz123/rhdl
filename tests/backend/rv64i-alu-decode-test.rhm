#lang rhombus
// Checks mandatory Espresso lowering of the RV64I ALU control relation.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../cores/ricket/decode/alu-ctrl.rhdl" as controls

def design = embedded.run_elaboration(
  fun (): controls.RV64IAluInstructionDecoder()
)
def circt = emit_circt(design)

check:
  circt.contains("sv.constantX : i11") ~is #false
  circt.contains("comb.icmp eq") ~is #false
  circt.contains("comb.mux") ~is #false
  circt.contains("_product_19_") ~is #true
  circt.contains("_output_") ~is #true
