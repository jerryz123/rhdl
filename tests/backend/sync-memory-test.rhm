#lang rhombus
// Checks CIRCT lowering for fixed one-cycle synchronous-memory ports.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../examples/sync-memory.rhdl" as fixture

def circt = emit_circt(fixture.design)

check:
  circt.contains("seq.hlmem @storage") ~is #true
  circt.contains("seq.read") ~is #true
  circt.contains("rden %read_enable") ~is #true
  circt.contains("seq.write") ~is #true
  circt.contains("wren %write_enable") ~is #true
  circt.contains("{latency = 1 : i64}") ~is #true
  circt.contains("rtl.sync_memory") ~is #false
