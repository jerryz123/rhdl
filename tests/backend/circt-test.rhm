#lang rhombus
// Checks deterministic CIRCT lowering primarily from frontend-elaborated designs.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/layers/bool.rhm" as bool
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../examples/lop/adder-standard.rhdl" as adder_fixture
  "../../examples/adder4.rhdl" as adder4_fixture
  "../../examples/generated-adder.rhdl" as generated_adder_fixture
  "../../examples/alu.rhdl" as alu_fixture
  "../../examples/shifts.rhdl" as shifts_fixture
  "../../examples/width-ops.rhdl" as width_fixture
  "../../examples/counter.rhdl" as counter_fixture
  "../../examples/hierarchy.rhdl" as hierarchy_fixture
  "../../examples/layered-adder.rhdl" as layered_fixture
  "../../examples/bundle.rhdl" as bundle_fixture
  "../../examples/interface.rhdl" as interface_fixture
  "../../examples/nested-interface.rhdl" as nested_interface_fixture
  "../../examples/vector.rhdl" as vector_fixture
  "../../examples/wire.rhdl" as wire_fixture

def adder_circt = emit_circt(adder_fixture.design)
def adder4_circt = emit_circt(adder4_fixture.design)
def generated_adder_circt = emit_circt(generated_adder_fixture.design)
def vector_circt = emit_circt(vector_fixture.design)
def wire_circt = emit_circt(wire_fixture.design)

check:
  adder_circt.contains("hw.module @Adder(in %a : i8, in %b : i8, out sum : i8)") ~is #true
  adder_circt.contains("comb.add %a, %b : i8") ~is #true
  adder_circt ~is emit_circt(adder_fixture.design)
  adder4_circt.contains("hw.module @FullAdder") ~is #true
  adder4_circt.contains("hw.module @Adder4") ~is #true
  adder4_circt.contains("hw.instance \"adder0\" @FullAdder") ~is #true
  adder4_circt.contains("comb.concat") ~is #true
  generated_adder_circt.contains("hw.module @Adder(in %A : i8") ~is #true
  generated_adder_circt.contains("hw.instance \"adder\" @FullAdder") ~is #true
  generated_adder_circt.contains("hw.instance \"adder_7\" @FullAdder") ~is #true
  generated_adder_circt.contains("hw.array_create") ~is #true
  vector_circt.contains("!hw.array<3xi4>") ~is #true
  vector_circt.contains("hw.array_create") ~is #true
  vector_circt.contains("hw.array_get") ~is #true
  vector_circt.contains("hw.bitcast") ~is #true
  wire_circt.contains("hw.module @VectorWire") ~is #true
  wire_circt.contains("hw.array_create") ~is #true
  wire_circt.contains("comb.xor") ~is #true
  wire_circt.contains("rtl.wire") ~is #false

def counter_circt = emit_circt(counter_fixture.design)

check:
  counter_circt.contains("seq.to_clock %clk") ~is #true
  counter_circt.contains("reset sync %reset") ~is #true
  counter_circt.contains("hw.constant 0 : i8") ~is #true
  counter_circt.contains("hw.constant 1 : i8") ~is #true
  counter_circt.contains("hw.output %state : i8") ~is #true

def hierarchy_circt = emit_circt(hierarchy_fixture.design)

check:
  hierarchy_circt.contains("hw.instance \"u0\" @Adder(a: %a: i8, b: %b: i8)") ~is #true
  hierarchy_circt.contains("hw.instance \"u1\" @Adder(a: %a: i8, b: %c: i8)") ~is #true

// Direct construction remains to test collision-free backend names independently.
def collision_design = Design()
def collision_builder = Builder(collision_design)
def collision_module = collision_builder.module("CollisionFree")
def collision_input = collision_builder.input(collision_module, "v6", Bits(1))
def collision_output = collision_builder.output(collision_module, "result", Bits(1))
def collision_result = collision_builder.add(collision_module,
                                             collision_input,
                                             collision_input,
                                             "sum")
collision_builder.drive(collision_output, collision_result)
def finished_collision_module = collision_builder.finish(collision_module)
def collision_circt = emit_circt(collision_design)

check:
  collision_result.id ~is 6
  collision_circt.contains("in %v6 : i1") ~is #true
  collision_circt.contains("%__rhdl_value_6 = comb.add %v6, %v6 : i1") ~is #true

def alu_circt = emit_circt(alu_fixture.design)

check:
  alu_circt.contains("comb.and") ~is #true
  alu_circt.contains("comb.or") ~is #true
  alu_circt.contains("comb.xor") ~is #true
  alu_circt.contains("comb.add") ~is #true
  alu_circt.contains("comb.sub") ~is #true
  alu_circt.contains("hw.constant 255 : i8") ~is #true
  alu_circt.contains("comb.icmp eq") ~is #true
  alu_circt.contains("comb.mux") ~is #true
  alu_circt.contains("out equal : i1") ~is #true

def alu5_design = embedded.run_elaboration(fun (): alu_fixture.ALU(5))
def alu5_circt = emit_circt(alu5_design)

check:
  alu5_circt.contains("hw.module @ALU(in %a : i5") ~is #true
  alu5_circt.contains("hw.constant 31 : i5") ~is #true

def shifts_circt = emit_circt(shifts_fixture.design)

check:
  shifts_circt.contains("comb.concat %__rhdl_shift_zero_15, %amount : i5, i3") ~is #true
  shifts_circt.contains("comb.shl %value, %__rhdl_shift_amount_15 : i8") ~is #true
  shifts_circt.contains("comb.shru %value, %__rhdl_shift_amount_18 : i8") ~is #true
  shifts_circt.contains("comb.concat %__rhdl_shift_zero_21, %value : i4, i8") ~is #true
  shifts_circt.contains("comb.shl %__rhdl_shift_value_21, %wide_amount : i12") ~is #true
  shifts_circt.contains("comb.shru %__rhdl_shift_value_24, %wide_amount : i12") ~is #true
  shifts_circt.contains("comb.extract %__rhdl_shift_wide_21 from 0 : (i12) -> i8") ~is #true
  shifts_circt.contains("comb.extract %__rhdl_shift_wide_24 from 0 : (i12) -> i8") ~is #true

def same_shift_design = Design()
def same_shift_builder = Builder(same_shift_design)
def same_shift_module = same_shift_builder.module("SameWidthShifts")
def same_shift_value = same_shift_builder.input(same_shift_module, "value", Bits(8))
def same_shift_amount = same_shift_builder.input(same_shift_module, "amount", Bits(8))
def same_shift_left_output = same_shift_builder.output(same_shift_module, "left", Bits(8))
def same_shift_right_output = same_shift_builder.output(same_shift_module, "right", Bits(8))
def same_shift_left = same_shift_builder.shl(same_shift_module,
                                             same_shift_value,
                                             same_shift_amount)
def same_shift_right = same_shift_builder.shru(same_shift_module,
                                               same_shift_value,
                                               same_shift_amount)
same_shift_builder.drive(same_shift_left_output, same_shift_left)
same_shift_builder.drive(same_shift_right_output, same_shift_right)
def finished_same_shift_module = same_shift_builder.finish(same_shift_module)
def same_shift_circt = emit_circt(same_shift_design)

check:
  same_shift_circt.contains("comb.shl %value, %amount : i8") ~is #true
  same_shift_circt.contains("comb.shru %value, %amount : i8") ~is #true
  same_shift_circt.contains("__rhdl_shift_zero_") ~is #false

def width_circt = emit_circt(width_fixture.design)

check:
  width_circt.contains("comb.concat %a, %b : i8, i4") ~is #true
  width_circt.contains("comb.extract %a from 2 : (i8) -> i4") ~is #true
  width_circt.contains("hw.constant 0 : i4") ~is #true
  width_circt.contains("comb.concat %__rhdl_zext_zero_") ~is #true
  width_circt.contains("comb.extract %a from 0 : (i8) -> i4") ~is #true

def layered_circt = emit_circt(layered_fixture.design)

check:
  layered_circt.contains("comb.mux %bypass") ~is #true
  layered_circt.contains("__rhdl_mux_key_") ~is #false

def conversion_design = Design()
def conversion_builder = Builder(conversion_design)
def conversion_module = conversion_builder.module("Conversion")
def raw_control = conversion_builder.input(conversion_module, "raw_control", Bits(1))
def bool_output = conversion_builder.output(conversion_module, "bool_output", bool.Bool)
def converted = conversion_builder.cast(conversion_module, raw_control, bool.Bool)
conversion_builder.drive(bool_output, converted)
def finished_conversion_module = conversion_builder.finish(conversion_module)
def conversion_circt = emit_circt(conversion_design)

check:
  conversion_circt.contains("out bool_output : i1") ~is #true
  conversion_circt.contains("hw.output %raw_control : i1") ~is #true
  conversion_circt.contains("hw.bitcast") ~is #false

def bundle_circt = emit_circt(bundle_fixture.design)
def record_cast_circt = emit_circt(bundle_fixture.cast_design)

check:
  bundle_circt.contains("!hw.struct<left: i8, right: i8>") ~is #true
  bundle_circt.contains("hw.struct_create") ~is #true
  bundle_circt.contains("comb.mux %select, %direct, %alternate : !hw.struct") ~is #true
  bundle_circt.contains("seq.firreg") ~is #true
  bundle_circt.contains("reset sync %reset") ~is #true
  record_cast_circt.contains("hw.bitcast %source : (!hw.struct<left: i8, right: i8>) -> i16") ~is #true
  record_cast_circt.contains("-> !hw.struct<left: i8, right: i8>") ~is #true

def interface_circt = emit_circt(interface_fixture.design)

check:
  interface_circt.contains("in %ingress__producer_to_consumer : !hw.struct<valid: i1, bits: i8>") ~is #true
  interface_circt.contains("out ingress__consumer_to_producer : !hw.struct<ready: i1>") ~is #true
  interface_circt.contains("hw.output %egress__consumer_to_producer, %ingress__producer_to_consumer") ~is #true

def nested_interface_circt = emit_circt(nested_interface_fixture.design)

check:
  nested_interface_circt.contains("!hw.struct<command: !hw.struct<valid: i1, bits: i8>, enable: i1, response: !hw.struct<ready: i1>>") ~is #true
  nested_interface_circt.contains("!hw.struct<command: !hw.struct<ready: i1>, response: !hw.struct<valid: i1, bits: i8>, status: i8>") ~is #true
  nested_interface_circt.contains("hw.output %egress__device_to_manager, %ingress__manager_to_device") ~is #true

class OpaqueData(name):
  implements DataType
  override method describe(): "opaque<" ++ name ++ ">"
  override method type_equal(other):
    other is_a OpaqueData && name == other.name

def unsupported_design = Design()
def unsupported_builder = Builder(unsupported_design)
def unsupported_module = unsupported_builder.module("UnsupportedType")
def opaque_type = OpaqueData("payload")
def opaque_input = unsupported_builder.input(unsupported_module, "source", opaque_type)
def opaque_output = unsupported_builder.output(unsupported_module, "target", opaque_type)
unsupported_builder.drive(opaque_output, opaque_input)
def finished_unsupported_module = unsupported_builder.finish(unsupported_module)

check:
  emit_circt(unsupported_design) ~throws "CIRCT lowering does not support hardware type opaque<payload>"
