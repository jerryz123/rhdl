#lang rhombus
// Emits CIRCT MLIR for the RV32 specialization of Ricket's core.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/ricket/core.rhdl" as core

