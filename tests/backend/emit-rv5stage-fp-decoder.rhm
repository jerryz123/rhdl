#lang rhombus
// Emits CIRCT MLIR for RV5Stage's combined RV64F/D floating-point decoder.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/decode/fp-ctrl.rhdl" as controls

def design = embedded.run_elaboration(fun (): controls.RV5StageFloatingPointInstructionDecoder(XLen.X64, FloatingPointProfile.D))
print(emit_circt(design))
