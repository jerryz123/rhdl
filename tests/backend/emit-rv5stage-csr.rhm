#lang rhombus
// Emits CIRCT MLIR for RV5Stage's RV64 commit-owned CSR file fixture.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/csr.rhdl" as csr

def design = embedded.run_elaboration(fun (): csr.RV5StageCsrFile(XLen.X64))
print(emit_circt(design))
