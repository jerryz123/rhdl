#lang rhombus
// Emits CIRCT MLIR for RV5Stage's RV64 word/doubleword atomic ALU fixture.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/memory.rhdl" as memory

def design = embedded.run_elaboration(
  fun (): memory.RV5StageAtomicALU(XLen.X64)
)
print(emit_circt(design))
