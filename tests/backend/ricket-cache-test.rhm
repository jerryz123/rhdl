#lang rhombus
// Checks that Ricket's aggregate cache arrays lower through the CIRCT backend.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/ricket/icache/cache.rhdl" as l1i
  "../../cores/ricket/dcache/cache.rhdl" as l1d

def instruction_design = embedded.run_elaboration(
  fun (): l1i.RicketL1ICache(XLen.X64, 8, 32)
)
def data_design = embedded.run_elaboration(
  fun (): l1d.RicketL1DCache(XLen.X64, 8, 32)
)
def rv32_data_design = embedded.run_elaboration(
  fun (): l1d.RicketL1DCache(XLen.X32, 8, 32)
)
def instruction_circt = emit_circt(instruction_design)
def data_circt = emit_circt(data_design)
def rv32_data_circt = emit_circt(rv32_data_design)

check:
  instruction_circt.contains("seq.firmem") ~is #true
  instruction_circt.contains("seq.firmem.read_write_port") ~is #true
  data_circt.contains("seq.firmem") ~is #true
  data_circt.contains("mask") ~is #true
  instruction_circt.contains("rtl.sync_memory") ~is #false
  data_circt.contains("rtl.sync_memory") ~is #false
  rv32_data_circt.contains("seq.firmem") ~is #true
  rv32_data_circt.contains("!hw.struct<data: i32, tag: i5>") ~is #true
