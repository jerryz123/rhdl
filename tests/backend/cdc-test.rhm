#lang rhombus
// Checks CIRCT lowering of verified sync-level evidence into synchronizer attributes.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../examples/clocking/sync-level.rhdl" as fixture

def circt = emit_circt(fixture.design)

check:
  circt.contains("cdc.sync_level") ~is #false
  circt.contains("%stage0 = seq.firreg") ~is #true
  circt.contains("%stage1 = seq.firreg") ~is #true
  circt.contains("#sv.attribute<\"async_reg\" = \"\\\"TRUE\\\"\">") ~is #true
  circt.split("#sv.attribute<\"async_reg\" = \"\\\"TRUE\\\"\">").length() ~is 3
