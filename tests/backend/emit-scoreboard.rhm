#lang rhombus
// Emits CIRCT MLIR for the standard single-set, single-clear scoreboard fixture.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../rhdl/std/scoreboard.rhdl" as scoreboard

def design = embedded.run_elaboration(fun (): scoreboard.Scoreboard(3))
print(emit_circt(design))
