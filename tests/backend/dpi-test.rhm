#lang rhombus
// Checks CIRCT lowering for a mandatory-clock enabled DPI declaration and call.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../examples/clocked-dpi.rhdl" as fixture

def circt = emit_circt(fixture.design)

check:
  circt.contains("sim.func.dpi @rhdl_trace(in %value : i8)") ~is #true
  circt.contains("sim.func.dpi @rhdl_step(in %value : i8, return result : i8)") ~is #true
  circt.contains("seq.to_clock %clock") ~is #true
  circt.contains("sim.func.dpi.call @rhdl_trace(%value) clock") ~is #true
  circt.contains("sim.func.dpi.call @rhdl_step(%value) clock") ~is #true
  circt.contains("enable %enable : (i8) -> ()") ~is #true
  circt.contains("enable %enable : (i8) -> i8") ~is #true
