#lang rhombus
// Emits CIRCT MLIR for the RV32 specialization of Ricket's data cache.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/ricket/dcache/cache.rhdl" as cache
  "../../cores/ricket/tests/params.rhdl" as test_params

def design = embedded.run_elaboration(
  fun (): cache.RicketL1DCache(XLen.X32, 4, ~chi: test_params.test_ricket_chi_config)
)
print(emit_circt(design))
