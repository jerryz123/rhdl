#lang rhombus
// Emits CIRCT MLIR for one-hot selection over a packed aggregate value.

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../frontend/one-hot-invalid.rhdl" as fixture

def design = embedded.run_elaboration(fun (): fixture.AggregateMux())
verify_design(design)
print(emit_circt(design))
