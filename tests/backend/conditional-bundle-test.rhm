#lang rhombus
// Checks that distinct conditional bundle specializations lower to distinct CIRCT types.

import:
  "../../rhdl/backend/circt.rhm" open
  "../frontend/conditional-bundle-fixture.rhdl" as fixture

def circt = emit_circt(fixture.shapes_design)

check:
  circt.contains("hw.typedecl @OptionalPacket") ~is #true
  circt.contains("hw.typedecl @OptionalPacket_1") ~is #true
