#lang rhombus
// Proves all frontend profiles and aggregate abstractions reach identical CIRCT MLIR.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../examples/lop/adder-core.rhm" as core_adder
  "../../examples/lop/adder-kernel.rhm" as kernel_adder
  "../../examples/lop/adder-composed.rhdl" as composed_adder
  "../../examples/lop/adder-standard.rhdl" as standard_adder
  "../../examples/lop/bundle-kernel.rhdl" as bundle_kernel
  "../../examples/lop/bundle-standard.rhdl" as bundle_standard
  "../../examples/lop/interface-records.rhdl" as interface_records
  "../../examples/interface.rhdl" as interface_standard
  "../../examples/lop/width-ops-kernel.rhm" as width_kernel
  "../../examples/width-ops.rhdl" as width_standard

check:
  emit_circt(core_adder.design) ~is emit_circt(kernel_adder.design)
  emit_circt(kernel_adder.design) ~is emit_circt(composed_adder.design)
  emit_circt(composed_adder.design) ~is emit_circt(standard_adder.design)
  emit_circt(bundle_standard.design) ~is emit_circt(bundle_kernel.design)
  emit_circt(interface_standard.design) ~is emit_circt(interface_records.design)
  emit_circt(width_standard.design) ~is emit_circt(width_kernel.design)
