#lang rhombus
// Checks CIRCT lowering for the one-router multi-terminal NoC crossbar fixture.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../examples/noc/noc-crossbar.rhdl" as fixture

def circt = emit_circt(fixture.design)

check:
  circt.contains("hw.module @OneRouterCrossbarFixture") ~is #true
  circt.contains("hw.module @SimpleRouter") ~is #true
  circt.contains("hw.module @RouterAllocator") ~is #true
  circt.contains("hw.module @RoundRobinMatcher") ~is #true
  circt.contains("rtl.decode") ~is #false
  circt ~is emit_circt(fixture.design)
