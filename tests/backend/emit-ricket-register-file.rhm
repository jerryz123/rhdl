#lang rhombus
// Emits CIRCT MLIR for Ricket's two-write register-file fixture.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/ricket/register-file.rhdl" as register_file

def design = embedded.run_elaboration(fun (): register_file.RicketRegisterFile(XLen.X64))
print(emit_circt(design))
