#lang rhombus
// Emits CIRCT MLIR for a memory whose elements use a structural RecordType.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/backend/circt.rhm" open

def design = Design()
def builder = Builder(design)
def module_def = builder.module("AggregateMemory")
def element_type = RecordType([RecordField("left", Bits(4)),
                               RecordField("right", Bits(4))])
def clock = builder.input(module_def, "clock", Clock)
def address = builder.input(module_def, "address", Bits(2))
def write_data = builder.input(module_def, "write_data", element_type)
def write_enable = builder.input(module_def, "write_enable", Bits(1))
def read_data = builder.output(module_def, "read_data", element_type)
def storage = builder.memory(module_def, "storage", 4, element_type)
def read_value = builder.memory_read_async(module_def, storage, address)
def write = builder.memory_write(module_def,
                                 storage,
                                 address,
                                 write_data,
                                 clock,
                                 write_enable)
builder.drive(read_data, read_value)
def finished = builder.finish(module_def)

def read_only_module = builder.module("ReadOnlyMemory")
def read_only_address = builder.input(read_only_module, "address", Bits(1))
def read_only_data = builder.output(read_only_module, "read_data", Bits(8))
def read_only_storage = builder.memory(read_only_module, "storage", 2, Bits(8))
def read_only_value = builder.memory_read_async(read_only_module,
                                                read_only_storage,
                                                read_only_address)
builder.drive(read_only_data, read_only_value)
def read_only_finished = builder.finish(read_only_module)
verify_design(design)
print(emit_circt(design))
