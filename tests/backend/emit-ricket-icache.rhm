#lang rhombus
// Emits CIRCT MLIR for the pipelined-hit Ricket instruction cache fixture.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/ricket/icache/cache.rhdl" as cache
  "../../cores/ricket/tests/params.rhdl" as test_params

def design = embedded.run_elaboration(
  fun (): cache.RicketL1ICache(XLen.X64, 4, ~chi: test_params.test_ricket_chi_params)
)
print(emit_circt(design))
