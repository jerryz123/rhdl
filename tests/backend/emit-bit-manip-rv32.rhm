#lang rhombus
// Emits CIRCT IR for the reusable RV32 ALU with standard-B operations.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/alu.rhdl" as alu

def design = embedded.run_elaboration(fun (): alu.ALU(XLen.X32))
print(emit_circt(design))
