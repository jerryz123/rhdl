#lang rhombus
// Proves compact Golf and standard RHDL adders emit identical CIRCT MLIR.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../examples/golf/adder.rhdl" as golf_fixture
  "../frontend/golf-standard.rhdl" as golf_standard_fixture
  "../../examples/lop/adder-standard.rhdl" as standard_fixture

check:
  emit_circt(golf_fixture.design) ~is emit_circt(standard_fixture.design)
  emit_circt(golf_standard_fixture.design) ~is emit_circt(standard_fixture.design)
