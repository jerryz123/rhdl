#lang rhombus
// Emits CIRCT MLIR for the Ricket deferred-write scoreboard fixture.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../cores/ricket/scoreboard.rhdl" as scoreboard

