#lang rhombus
// Emits CIRCT MLIR for an interface reconstructed across a module instance.

import:
  "../../rhdl/backend/circt.rhm" open
  "../../rhdl/frontend/kernel.rhm" as embedded
  "../../examples/rhdl/interface.rhdl" as interface_fixture

def design = embedded.run_elaboration(
  fun (): interface_fixture.ReadyValidHierarchy(8)
)
print(emit_circt(design))
