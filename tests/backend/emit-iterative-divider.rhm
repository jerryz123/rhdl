#lang rhombus
// Emits CIRCT MLIR for the reusable eight-bit iterative divider fixture.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../cores/divider.rhdl" as divider

