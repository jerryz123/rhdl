#lang rhombus
// Checks first-cut #lang rhdl elaboration, source provenance, and fresh generators.

import:
  "../rhdl/main.rhm" open
  "../examples/adder.rhdl" open

def add_operation = design.modules[0].operations.find(
  fun (operation): operation.opcode == "rtl.add"
)

check:
  design.modules.length() ~is 1
  design.modules[0].name ~is "Adder8"
  design.modules[0].inputs[0].type.width ~is 8
  design.modules[0].outputs[0].type.width ~is 8
  add_operation.location.line ~is 10
  add_operation.location.path.ends_with("examples/adder.rhdl") ~is #true
  add_operation.origin.kind ~is "frontend add"
  verify_design(design) ~is #void
