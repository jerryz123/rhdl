#lang rhombus
// Exercises public IR ownership, use-def links, schemas, and representative designs.

import:
  "../rhdl/main.rhm" open
  "support.rhm" open

def [design, builder, adder, a, b, sum, result] = make_adder_design()

check:
  design.modules.length() ~is 1
  adder.operations.length() ~is 5
  a.type.width ~is 8
  b.type.width ~is 8
  result.type.width ~is 8
  result.defining_op_id ~is 7
  a.users() ~is [7]
  b.users() ~is [7]
  design.walk().length() ~is 5
  builder.read(sum).id ~is result.id
  adder.design === design ~is #true
  result.module_def === adder ~is #true
  adder.operations[0].opcode ~is "rtl.input_port"
  schema_for("rtl.add").required_attributes ~is ["name"]
  verify_design(design) ~is #void

def [counter_design, _, counter, count, state] = make_counter_design()

check:
  state.current.type.width ~is 8
  state.next.type.width ~is 8
  state.next.driver.name ~is "next"
  count.driver.id ~is state.current.id
  verify_design(counter_design) ~is #void

def [alu_design, _, alu, _, _, _, alu_result, alu_equal] = make_alu_design()

check:
  alu_result.type.width ~is 8
  alu_equal.type.width ~is 1
  alu.operations.filter(~keep: fun (operation): operation.opcode == "rtl.mux").length() ~is 5
  alu.operations.find(fun (operation): operation.opcode == "rtl.not") != #false ~is #true
  alu.operations.find(fun (operation): operation.opcode == "rtl.eq") != #false ~is #true
  verify_design(alu_design) ~is #void

def [alu5_design, _, alu5, alu5_a, _, _, alu5_result, _] = make_alu_design(5)

check:
  alu5.name ~is "ALU5"
  alu5_a.type.width ~is 5
  alu5_result.type.width ~is 5
  verify_design(alu5_design) ~is #void

def [width_design, _, width_module, width_a, width_b,
     joined, middle, widened, narrowed] = make_width_ops_design()

check:
  width_module.name ~is "WidthOps8"
  width_a.type.width ~is 8
  width_b.type.width ~is 4
  joined.type.width ~is 12
  middle.type.width ~is 4
  widened.type.width ~is 12
  narrowed.type.width ~is 4
  joined.module_def.find_operation(joined.defining_op_id).operands ~is [width_a, width_b]
  middle.module_def.find_operation(middle.defining_op_id).attribute("high") ~is 5
  middle.module_def.find_operation(middle.defining_op_id).attribute("low") ~is 2
  verify_design(width_design) ~is #void

def [hierarchy_design, _, child, top, u0, u1] = make_hierarchy_design()

check:
  hierarchy_design.modules.length() ~is 2
  u0.module_def.id ~is child.id
  u1.module_def.id ~is child.id
  u0.input("a").driver.name ~is "a"
  u1.input("b").driver.name ~is "c"
  verify_design(hierarchy_design) ~is #void
