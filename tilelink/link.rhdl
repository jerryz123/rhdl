#lang rhdl
// Composes TileLink payloads into uncached and cached directional links.

import:
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open
  lib("tilelink/params.rhdl") open
  lib("tilelink/bundles.rhdl") open

fun transfer_sizes_supported(emitted, supported):
  emitted == #false || supported is_a TransferSizes && supported.contains_all(emitted)

fun a_operations_supported(emitted, supported):
  for all (pair in [[emitted.acquire_block, supported.acquire_block],
                    [emitted.acquire_perm, supported.acquire_perm],
                    [emitted.arithmetic, supported.arithmetic],
                    [emitted.logical, supported.logical],
                    [emitted.get, supported.get],
                    [emitted.put_full, supported.put_full],
                    [emitted.put_partial, supported.put_partial],
                    [emitted.intent, supported.intent]]):
    transfer_sizes_supported(pair[0], pair[1])

fun b_operations_supported(emitted, supported):
  for all (pair in [[emitted.probe, supported.probe],
                    [emitted.arithmetic, supported.arithmetic],
                    [emitted.logical, supported.logical],
                    [emitted.get, supported.get],
                    [emitted.put_full, supported.put_full],
                    [emitted.put_partial, supported.put_partial],
                    [emitted.intent, supported.intent]]):
    transfer_sizes_supported(pair[0], pair[1])

fun b_operations_empty(operations):
  for all (value in [operations.probe,
                     operations.arithmetic,
                     operations.logical,
                     operations.get,
                     operations.put_full,
                     operations.put_partial,
                     operations.intent]):
    value == #false

fun transfer_sizes_fit(value, size_width):
  value == #false || alignment_bits(value.max_bytes) < unsigned_value_count(size_width)

fun a_operation_sizes_fit(operations, size_width):
  for all (value in [operations.acquire_block,
                     operations.acquire_perm,
                     operations.arithmetic,
                     operations.logical,
                     operations.get,
                     operations.put_full,
                     operations.put_partial,
                     operations.intent]):
    transfer_sizes_fit(value, size_width)

fun b_operation_sizes_fit(operations, size_width):
  for all (value in [operations.probe,
                     operations.arithmetic,
                     operations.logical,
                     operations.get,
                     operations.put_full,
                     operations.put_partial,
                     operations.intent]):
    transfer_sizes_fit(value, size_width)

fun uncached_a_operation_pairs(operations):
  [[TLAOpcode.ArithmeticData, operations.arithmetic],
   [TLAOpcode.LogicalData, operations.logical],
   [TLAOpcode.Get, operations.get],
   [TLAOpcode.PutFullData, operations.put_full],
   [TLAOpcode.PutPartialData, operations.put_partial],
   [TLAOpcode.Intent, operations.intent]]

fun transfer_size_matches(size, sizes, size_width):
  if sizes == #false
  | Bool(#false)
  | (size >= bits(alignment_bits(sizes.min_bytes), size_width)) & (
      size <= bits(alignment_bits(sizes.max_bytes), size_width)
    )

fun uncached_a_opcode_supported(opcode, operations):
  or_reduce(vec(
    for List (pair in uncached_a_operation_pairs(operations)):
      if pair[1] == #false
      | Bool(#false)
      | opcode === pair[0]
  ))

fun uncached_a_size_supported(opcode, size, operations, size_width):
  def opcode_supported = uncached_a_opcode_supported(opcode, operations)
  def matching_size = or_reduce(vec(
    for List (pair in uncached_a_operation_pairs(operations)):
      (opcode === pair[0]) & transfer_size_matches(size, pair[1], size_width)
  ))
  !opcode_supported ||| matching_size

fun address_set_matches(address, address_set):
  def width = address.type.bit_width()
  (address & !bits(address_set.mask, width)) === bits(address_set.base, width)

fun address_supported(address, address_sets):
  or_reduce(vec(
    for List (address_set in address_sets):
      address_set_matches(address, address_set)
  ))

fun monitor_a_channel(valid,
                      opcode,
                      param,
                      size,
                      address,
                      mask,
                      manager_link):
  def bundle = manager_link.bundle
  def operations = manager_link.manager.supports
  def opcode_supported = uncached_a_opcode_supported(opcode, operations)
  def size_supported = uncached_a_size_supported(opcode,
                                                 size,
                                                 operations,
                                                 bundle.size_width)
  def request_get = opcode === TLAOpcode.Get
  def request_put_full = opcode === TLAOpcode.PutFullData
  def request_put_partial = opcode === TLAOpcode.PutPartialData
  def zero_param_operation = request_get ||| request_put_full ||| request_put_partial
  def param_supported = !zero_param_operation ||| !or_reduce(param)
  def max_beat_size = alignment_bits(bundle.data_bytes)
  def size_within_beat = size <= bits(max_beat_size, bundle.size_width)
  def size_masks = for List (encoded_size in 0..(max_beat_size + 1)):
    [encoded_size,
     bits((1 bits.(<<) (1 bits.(<<) encoded_size)) - 1,
          bundle.data_bytes)]
  def alignment_cases = for List (encoded_size in 0..(max_beat_size + 1)):
    [encoded_size,
     is_aligned(address, 1 bits.(<<) encoded_size)]
  def base_mask = mux_lookup(size, ~default: bits(0, bundle.data_bytes), size_masks)
  def low_width = alignment_bits(bundle.data_bytes)
  def lane_offset:
    if low_width == 0
    | bits(0, 1)
    | extract(address, low_width - 1, 0)
  def expected_mask = base_mask << lane_offset
  def address_aligned = !size_within_beat ||| mux_lookup(
    size,
    ~default: Bool(#true),
    alignment_cases
  )
  def checked_mask_operation = request_get ||| request_put_full ||| request_put_partial
  def mask_matches = mux(
    request_put_partial,
    (mask & expected_mask) === mask,
    mask === expected_mask
  )
  def mask_supported = !checked_mask_operation ||| !size_within_beat ||| mask_matches
  def request_address_supported = address_supported(
    address,
    manager_link.manager.address_sets
  )

  when valid:
    assert(opcode_supported, "tilelink_a_opcode_supported")
    assert(param_supported, "tilelink_a_param_supported")
    assert(size_supported, "tilelink_a_size_supported")
    assert(address_aligned, "tilelink_a_address_aligned")
    assert(mask_supported, "tilelink_a_mask_supported")
    assert(request_address_supported, "tilelink_a_address_supported")

fun link_params(bundle, endpoint):
  unless bundle is_a TLBundleParams
  | error(~who: #'TLUncached, "TileLink interfaces require TLBundleParams")
  cond
  | endpoint is_a TLClientParams: TLClientLinkParams(bundle, endpoint)
  | endpoint is_a TLManagerParams: TLManagerLinkParams(bundle, endpoint)
  | ~else:
      error(~who: #'TLUncached,
            "TileLink interfaces require TLClientParams or TLManagerParams")

fun link_parameter_pair(provided, required):
  if provided.length() != 2 || required.length() != 2
  | #false
  | block:
      def client_link = link_params(provided[0], provided[1])
      def manager_link = link_params(required[0], required[1])
      if client_link is_a TLClientLinkParams && manager_link is_a TLManagerLinkParams
      | [client_link, manager_link]
      | #false

fun link_bundle(bundle, endpoint):
  link_params(bundle, endpoint).bundle

fun uncached_connection_legal(provided, required):
  def pair = link_parameter_pair(provided, required)
  if !pair
  | #false
  | block:
      def client_link = pair[0]
      def manager_link = pair[1]
      def client = client_link.client
      def manager = manager_link.manager
      def bundle = client_link.bundle
      for all (condition in [client.emits.acquire_block == #false,
                             client.emits.acquire_perm == #false,
                             b_operations_empty(manager.emits),
                             a_operations_supported(client.emits, manager.supports),
                             a_operation_sizes_fit(client.emits, bundle.size_width),
                             client.source_ids.fits_unsigned_width(bundle.source_width),
                             for all (address_set in manager.address_sets):
                               address_set.fits_unsigned_width(bundle.address_width)]):
        condition

fun cached_connection_legal(provided, required):
  def pair = link_parameter_pair(provided, required)
  if !pair
  | #false
  | block:
      def client_link = pair[0]
      def manager_link = pair[1]
      def client = client_link.client
      def manager = manager_link.manager
      def bundle = client_link.bundle
      for all (condition in [a_operations_supported(client.emits, manager.supports),
                             b_operations_supported(manager.emits, client.supports),
                             a_operation_sizes_fit(client.emits, bundle.size_width),
                             b_operation_sizes_fit(manager.emits, bundle.size_width),
                             client.source_ids.fits_unsigned_width(bundle.source_width),
                             manager.sink_ids.fits_unsigned_width(bundle.sink_width),
                             for all (address_set in manager.address_sets):
                               address_set.fits_unsigned_width(bundle.address_width)]):
        condition

// TileLink permits an unaccepted first beat to be withdrawn or replaced, so
// protocol channels use Decoupled rather than the stronger Irrevocable.
interface TLUncached(bundle, endpoint):
  role client
  role manager
  provider client
  connection_compatible client (provided, required):
    uncached_connection_legal(provided, required)
  monitor (link, endpoint_role):
    if endpoint_role == "manager" && endpoint is_a TLManagerParams
    | monitor_a_channel(link.a.valid,
                        link.a.bits.opcode,
                        link.a.bits.param,
                        link.a.bits.size,
                        link.a.bits.address,
                        link.a.bits.mask,
                        link_params(bundle, endpoint))
    | #void

  client -> manager:
    a: Decoupled(TLChannelA(link_bundle(bundle, endpoint)))

  manager -> client:
    d: Decoupled(TLChannelD(link_bundle(bundle, endpoint)))

interface TLCached(bundle, endpoint):
  role client
  role manager
  provider client
  connection_compatible client (provided, required):
    cached_connection_legal(provided, required)

  client -> manager:
    a: Decoupled(TLChannelA(link_bundle(bundle, endpoint)))
    c: Decoupled(TLChannelC(link_bundle(bundle, endpoint)))
    e: Decoupled(TLChannelE(link_bundle(bundle, endpoint)))

  manager -> client:
    b: Decoupled(TLChannelB(link_bundle(bundle, endpoint)))
    d: Decoupled(TLChannelD(link_bundle(bundle, endpoint)))

export:
  TLUncached
  TLCached
