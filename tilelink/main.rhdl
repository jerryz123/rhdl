#lang rhdl
// Re-exports the public top-level TileLink definitions and concrete RAM manager.

import:
  lib("tilelink/params.rhdl") open
  lib("tilelink/bundles.rhdl") open
  lib("tilelink/protocol.rhdl") open
  lib("tilelink/link.rhdl") open
  lib("tilelink/monitor.rhdl") open
  lib("tilelink/ram.rhdl") open

export:
  IdRange
  IdRangeMap
  allocate_id_ranges
  AddressSet
  TransferSizes
  TLAOperationSizes
  TLBOperationSizes
  TLClientParams
  TLManagerParams
  TLClientPortParams
  TLManagerPortParams
  client_port_params
  manager_port_params
  TLBundleParams
  TLEdgeParams
  TLXbarParams
  TLClientLinkParams
  TLManagerLinkParams
  TLAOpcode
  TLBOpcode
  TLCOpcode
  TLDOpcode
  TLChannelA
  TLChannelB
  TLChannelC
  TLChannelD
  TLChannelE
  tl_a_has_data
  tl_b_has_data
  tl_c_has_data
  tl_d_has_data
  tl_a_is_acquire
  tl_b_is_probe
  tl_c_is_probe_ack
  tl_c_is_release
  tl_d_is_grant
  tl_d_requires_ack
  tl_a_response_matches
  tl_b_response_matches
  tl_c_response_matches
  tl_beats_minus_one
  tl_a_beats_minus_one
  tl_b_beats_minus_one
  tl_c_beats_minus_one
  tl_d_beats_minus_one
  TLUncached
  TLCached
  monitor_tl_uncached_manager
  TLRam
