#lang rhdl
// Elaborates a four-word byte-masked TileLink RAM for host and backend tests.

import:
  lib("tilelink/main.rhdl") open

def bundle = TLBundleParams(32, 4, 3, 3, 1)
def design = elaborate(
  TLRam(
    "test_ram",
    bundle,
    16,
    ~base_address: 0x80000000
  )
)

export:
  bundle
  design
