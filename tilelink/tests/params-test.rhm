#lang rhombus
// Checks TileLink host parameter construction, queries, defaults, and rejection.

import:
  "../params.rhdl" as tl

def ids = tl.IdRange(2, 6)
def address = tl.AddressSet(0x8000, 0x0fff)
def transfers = tl.TransferSizes(4, 64)
def reads = tl.TLAOperationSizes(~get: transfers, ~intent: tl.TransferSizes(1, 8))
def probes = tl.TLBOperationSizes(~probe: transfers)
def client = tl.TLClientParams("cpu", ids, ~emits: reads, ~supports: probes)
def manager = tl.TLManagerParams("ram", [address], tl.IdRange(0, 4),
                                 ~supports: reads, ~may_deny_get: #true)
def widths = tl.TLBundleParams(32, 8, 4, 3, 2)
def client_link = tl.TLClientLinkParams(widths, client)
def manager_link = tl.TLManagerLinkParams(widths, manager)
def second_client = tl.TLClientParams(
  "dma",
  tl.IdRange(0, 2),
  ~emits: tl.TLAOperationSizes(~get: tl.TransferSizes(4, 8))
)
def second_manager = tl.TLManagerParams(
  "mmio",
  [tl.AddressSet(0x9000, 0x0fff)],
  tl.IdRange(4, 5),
  ~supports: tl.TLAOperationSizes(~get: transfers)
)
def local_second_manager = tl.TLManagerParams(
  "mmio",
  [tl.AddressSet(0x9000, 0x0fff)],
  tl.IdRange(0, 1),
  ~supports: tl.TLAOperationSizes(~get: transfers)
)
def client_port = tl.TLClientPortParams([client, second_client])
def manager_port = tl.TLManagerPortParams([manager, second_manager])
def wide_sink_widths = tl.TLBundleParams(32, 8, 4, 3, 3)
def edge = tl.TLEdgeParams(wide_sink_widths, client_port, manager_port)
def xbar = tl.TLXbarParams(
  wide_sink_widths,
  [client, second_client],
  [manager, local_second_manager]
)

check:
  ids.start ~is 2
  ids.end ~is 6
  ids.size ~is 4
  ids.contains(2) ~is #true
  ids.contains(5) ~is #true
  ids.contains(6) ~is #false
  address.contains(0x8000) ~is #true
  address.contains(0x8abc) ~is #true
  address.contains(0x9000) ~is #false
  transfers.contains(4) ~is #true
  transfers.contains(32) ~is #true
  transfers.contains(3) ~is #false
  transfers.contains(128) ~is #false
  reads.get === transfers ~is #true
  reads.put_full ~is #false
  probes.probe === transfers ~is #true
  client.name ~is "cpu"
  client.source_ids === ids ~is #true
  client.emits === reads ~is #true
  client.supports === probes ~is #true
  manager.address_sets ~is [address]
  manager.supports === reads ~is #true
  manager.emits.probe ~is #false
  manager.may_deny_get ~is #true
  manager.may_deny_put ~is #false
  manager.sink_ids.overlaps(local_second_manager.sink_ids) ~is #true
  widths.address_width ~is 32
  widths.data_bytes ~is 8
  widths.data_width ~is 64
  widths.mask_width ~is 8
  client_link.bundle === widths ~is #true
  client_link.client === client ~is #true
  manager_link.bundle === widths ~is #true
  manager_link.manager === manager ~is #true
  client_port.clients ~is [client, second_client]
  client_port.source_ids ~is tl.IdRange(0, 6)
  manager_port.managers ~is [manager, second_manager]
  manager_port.sink_ids ~is tl.IdRange(0, 5)
  manager_port.address_sets ~is [address, tl.AddressSet(0x9000, 0x0fff)]
  edge.bundle === wide_sink_widths ~is #true
  edge.client_port === client_port ~is #true
  edge.manager_port === manager_port ~is #true
  xbar.client_ports.map(fun (port): port.clients) ~is [[client], [second_client]]
  xbar.manager_ports.map(fun (port): port.managers) ~is [[manager], [local_second_manager]]
  xbar.source_maps.map(fun (mapping): mapping.local) ~is [
    tl.IdRange(2, 6),
    tl.IdRange(0, 2)
  ]
  xbar.source_maps.map(fun (mapping): mapping.global) ~is [
    tl.IdRange(0, 4),
    tl.IdRange(4, 6)
  ]
  xbar.sink_maps.map(fun (mapping): mapping.global) ~is [
    tl.IdRange(0, 4),
    tl.IdRange(4, 5)
  ]
  xbar.downstream_client_port.clients.map(
    fun (mapped_client): mapped_client.source_ids
  ) ~is [tl.IdRange(0, 4), tl.IdRange(4, 6)]
  xbar.upstream_manager_port.managers.map(
    fun (mapped_manager): mapped_manager.sink_ids
  ) ~is [tl.IdRange(0, 4), tl.IdRange(4, 5)]
  tl.TLAOperationSizes(~get: "unsupported") ~throws "get must be #false or TransferSizes"
  tl.TLClientParams("", ids, ~emits: reads) ~throws "nonempty String"
  tl.TLManagerParams("ram", [], ids, ~supports: reads) ~throws "nonempty List"
  tl.TLManagerParams("ram", ["bad"], ids, ~supports: reads) ~throws "elements must be AddressSet"
  tl.TLBundleParams(32, 3, 4, 3, 2) ~throws "Pow2Int"
  tl.TLBundleParams(32, 8, 4, 0, 2) ~throws "PosInt"
  tl.TLBundleParams(32, 8, 1, 3, 2) ~throws "encode the physical data beat"
  tl.TLClientPortParams([]) ~throws "nonempty List"
  tl.TLClientPortParams([client, client]) ~throws "source ID ranges must not overlap"
  tl.TLManagerPortParams([manager, manager]) ~throws "sink ID ranges must not overlap"
  tl.TLManagerPortParams([
    manager,
    tl.TLManagerParams(
      "overlap",
      [tl.AddressSet(0x8800, 0x07ff)],
      tl.IdRange(4, 5),
      ~supports: reads
    )
  ]) ~throws "address sets must not overlap"
  tl.TLXbarParams(
    tl.TLBundleParams(32, 8, 4, 2, 3),
    [tl.TLClientParams("first", tl.IdRange(0, 4), ~emits: reads),
     tl.TLClientParams("second", tl.IdRange(0, 4), ~emits: reads)],
    [manager]
  ) ~throws "allocated source IDs must fit"
  tl.TLXbarParams(
    widths,
    [client],
    [manager, local_second_manager]
  ) ~throws "allocated sink IDs must fit"
  tl.TLXbarParams(
    wide_sink_widths,
    [client],
    [manager,
     tl.TLManagerParams(
       "overlap",
       [tl.AddressSet(0x8800, 0x07ff)],
       tl.IdRange(0, 1),
       ~supports: reads
     )]
  ) ~throws "address sets must not overlap"
  tl.TLEdgeParams(
    widths,
    tl.TLClientParams("wide", tl.IdRange(0, 9), ~emits: reads),
    manager
  ) ~throws "source ID range must fit"
  tl.TLClientLinkParams(widths, manager) ~throws "client must be a TLClientParams"
  tl.TLManagerLinkParams(widths, client) ~throws "manager must be a TLManagerParams"
