#lang rhdl
// Rejects coherence acquisition traffic on a link without TileLink B, C, and E channels.

import:
  lib("tilelink/main.rhdl") open
  "../../../examples/tilelink.rhdl" as fixture

def bundle = TLBundleParams(32, 8, 4, 3, 2)
def acquire = TransferSizes(64, 64)
def client = TLClientParams(
  "cache",
  IdRange(0, 4),
  ~emits: TLAOperationSizes(~acquire_block: acquire)
)
def manager = TLManagerParams(
  "ram",
  [AddressSet(0x80000000, 0x0fffffff)],
  IdRange(0, 4),
  ~supports: TLAOperationSizes(~acquire_block: acquire)
)
def design = elaborate(
  fixture.TLUncachedAdapter(bundle, client, bundle, manager)
)
