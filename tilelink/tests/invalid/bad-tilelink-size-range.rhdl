#lang rhdl
// Rejects emitted TileLink transfer sizes that do not fit the physical size field.

import:
  lib("tilelink/main.rhdl") open
  "../../../examples/tilelink/tilelink.rhdl" as fixture

def bundle = TLBundleParams(32, 8, 2, 3, 2)
def transfers = TransferSizes(16, 16)
def client = TLClientParams(
  "cpu",
  IdRange(0, 4),
  ~emits: TLAOperationSizes(~get: transfers)
)
def manager = TLManagerParams(
  "ram",
  [AddressSet(0x80000000, 0x0fffffff)],
  IdRange(0, 4),
  ~supports: TLAOperationSizes(~get: transfers)
)
def design = elaborate(
  fixture.TLUncachedAdapter(bundle, client, bundle, manager)
)
