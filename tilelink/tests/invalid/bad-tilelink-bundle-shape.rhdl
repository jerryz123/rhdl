#lang rhdl
// Rejects TileLink endpoints whose physical bundle widths differ despite legal capabilities.

import:
  lib("tilelink/main.rhdl") open
  "../../../examples/tilelink.rhdl" as fixture

def client_bundle = TLBundleParams(32, 8, 4, 3, 2)
def manager_bundle = TLBundleParams(32, 4, 4, 3, 2)
def client = TLClientParams("cpu", IdRange(0, 4), ~emits: TLAOperationSizes())
def manager = TLManagerParams(
  "ram",
  [AddressSet(0x80000000, 0x0fffffff)],
  IdRange(0, 4),
  ~supports: TLAOperationSizes()
)
def design = elaborate(
  fixture.TLUncachedAdapter(TLClientLinkParams(client_bundle, client),
                            TLManagerLinkParams(manager_bundle, manager))
)
