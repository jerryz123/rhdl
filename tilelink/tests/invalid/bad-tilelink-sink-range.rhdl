#lang rhdl
// Rejects a cached manager sink-ID range that does not fit the physical link width.

import:
  lib("tilelink/main.rhdl") open
  "../../../examples/tilelink/tilelink.rhdl" as fixture

def bundle = TLBundleParams(32, 8, 4, 3, 2)
def client = TLClientParams("cpu", IdRange(0, 4), ~emits: TLAOperationSizes())
def manager = TLManagerParams(
  "cache",
  [AddressSet(0x80000000, 0x0fffffff)],
  IdRange(0, 5),
  ~supports: TLAOperationSizes()
)
def design = elaborate(
  fixture.TLCachedAdapter(bundle, client, bundle, manager)
)
