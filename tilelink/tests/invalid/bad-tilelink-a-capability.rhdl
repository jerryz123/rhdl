#lang rhdl
// Rejects a TileLink client operation range that its connected manager cannot accept.

import:
  lib("tilelink/main.rhdl") open
  "../../../examples/tilelink/tilelink.rhdl" as fixture

def bundle = TLBundleParams(32, 8, 4, 3, 2)
def client = TLClientParams(
  "cpu",
  IdRange(0, 4),
  ~emits: TLAOperationSizes(~get: TransferSizes(1, 64))
)
def manager = TLManagerParams(
  "ram",
  [AddressSet(0x80000000, 0x0fffffff)],
  IdRange(0, 4),
  ~supports: TLAOperationSizes(~get: TransferSizes(1, 8))
)
def design = elaborate(
  fixture.TLUncachedAdapter(bundle, client, bundle, manager)
)
