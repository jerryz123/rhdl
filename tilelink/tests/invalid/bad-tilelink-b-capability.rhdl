#lang rhdl
// Rejects manager probe sizes that its connected cached client cannot accept.

import:
  lib("tilelink/main.rhdl") open
  "../../../examples/tilelink.rhdl" as fixture

def bundle = TLBundleParams(32, 8, 4, 3, 2)
def client = TLClientParams(
  "cpu",
  IdRange(0, 4),
  ~emits: TLAOperationSizes(),
  ~supports: TLBOperationSizes(~probe: TransferSizes(1, 8))
)
def manager = TLManagerParams(
  "cache",
  [AddressSet(0x80000000, 0x0fffffff)],
  IdRange(0, 4),
  ~supports: TLAOperationSizes(),
  ~emits: TLBOperationSizes(~probe: TransferSizes(1, 64))
)
def design = elaborate(
  fixture.TLCachedAdapter(TLClientLinkParams(bundle, client),
                          TLManagerLinkParams(bundle, manager))
)
