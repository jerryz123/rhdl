#lang rhombus
// Checks TileLink opcode and multibeat helper elaboration and generated hardware.

import:
  "../../rhdl/core/main.rhm" open
  "../../rhdl/backend/circt.rhm" open
  "protocol-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def circt = emit_circt(fixture.design)

check:
  module_def.inputs.map(fun (input): input.name) ~is [
    "a_opcode",
    "b_opcode",
    "c_opcode",
    "d_opcode",
    "size",
    "response_d_opcode",
    "response_c_opcode"
  ]
  module_def.outputs.map(fun (output): output.name) ~is [
    "a_has_data",
    "b_has_data",
    "c_has_data",
    "d_has_data",
    "a_response_matches",
    "b_response_matches",
    "c_response_matches",
    "d_requires_ack",
    "a_beats_minus_one",
    "b_beats_minus_one",
    "c_beats_minus_one",
    "d_beats_minus_one"
  ]
  module_def.outputs.slice(8).map(
    fun (output): output.place.type.bit_width()
  ) ~is [8, 8, 8, 8]
  circt.contains("comb.shl") ~is #true
  circt.contains("comb.shru") ~is #true
  circt.contains("comb.mux") ~is #true
  verify_design(fixture.design) ~is #void
