#lang rhdl
// Elaborates TileLink opcode and beat classifiers over a four-byte physical link.

import:
  lib("rhdl/std/bits.rhdl").unsigned_value_count
  lib("tilelink/main.rhdl") open

def bundle = TLBundleParams(32, 4, 3, 2, 2)

circuit TLProtocolFixture():
  input a_opcode: TLAOpcode
  input b_opcode: TLBOpcode
  input c_opcode: TLCOpcode
  input d_opcode: TLDOpcode
  input size: Bits(bundle.size_width)
  input response_d_opcode: TLDOpcode
  input response_c_opcode: TLCOpcode
  output a_has_data: Bool
  output b_has_data: Bool
  output c_has_data: Bool
  output d_has_data: Bool
  output a_response_matches: Bool
  output b_response_matches: Bool
  output c_response_matches: Bool
  output d_requires_ack: Bool
  output a_beats_minus_one: Bits(unsigned_value_count(bundle.size_width))
  output b_beats_minus_one: Bits(unsigned_value_count(bundle.size_width))
  output c_beats_minus_one: Bits(unsigned_value_count(bundle.size_width))
  output d_beats_minus_one: Bits(unsigned_value_count(bundle.size_width))

  a_has_data <== tl_a_has_data(a_opcode)
  b_has_data <== tl_b_has_data(b_opcode)
  c_has_data <== tl_c_has_data(c_opcode)
  d_has_data <== tl_d_has_data(d_opcode)
  a_response_matches <== tl_a_response_matches(a_opcode, response_d_opcode)
  b_response_matches <== tl_b_response_matches(b_opcode, response_c_opcode)
  c_response_matches <== tl_c_response_matches(c_opcode, response_d_opcode)
  d_requires_ack <== tl_d_requires_ack(d_opcode)
  a_beats_minus_one <== tl_a_beats_minus_one(a_opcode, size, bundle)
  b_beats_minus_one <== tl_b_beats_minus_one(b_opcode, size, bundle)
  c_beats_minus_one <== tl_c_beats_minus_one(c_opcode, size, bundle)
  d_beats_minus_one <== tl_d_beats_minus_one(d_opcode, size, bundle)

def design = elaborate(TLProtocolFixture())

export:
  bundle
  TLProtocolFixture
  design
