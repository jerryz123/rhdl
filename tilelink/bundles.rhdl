#lang rhdl
// Defines the exact TileLink A-E opcode and payload bundle shapes.

import:
  lib("tilelink/params.rhdl") open

hardware_enum TLAOpcode(~width: 3):
  PutFullData = 0
  PutPartialData = 1
  ArithmeticData = 2
  LogicalData = 3
  Get = 4
  Intent = 5
  AcquireBlock = 6
  AcquirePerm = 7

hardware_enum TLBOpcode(~width: 3):
  PutFullData = 0
  PutPartialData = 1
  ArithmeticData = 2
  LogicalData = 3
  Get = 4
  Intent = 5
  ProbeBlock = 6
  ProbePerm = 7

hardware_enum TLCOpcode(~width: 3):
  AccessAck = 0
  AccessAckData = 1
  HintAck = 2
  ProbeAck = 4
  ProbeAckData = 5
  Release = 6
  ReleaseData = 7

hardware_enum TLDOpcode(~width: 3):
  AccessAck = 0
  AccessAckData = 1
  HintAck = 2
  Grant = 4
  GrantData = 5
  ReleaseAck = 6

bundle TLChannelA(p :: TLBundleParams):
  opcode: TLAOpcode
  param: Bits(3)
  size: Bits(p.size_width)
  source: Bits(p.source_width)
  address: Bits(p.address_width)
  mask: Bits(p.mask_width)
  data: Bits(p.data_width)
  corrupt: Bool

bundle TLChannelB(p :: TLBundleParams):
  opcode: TLBOpcode
  param: Bits(3)
  size: Bits(p.size_width)
  source: Bits(p.source_width)
  address: Bits(p.address_width)
  mask: Bits(p.mask_width)
  data: Bits(p.data_width)
  corrupt: Bool

bundle TLChannelC(p :: TLBundleParams):
  opcode: TLCOpcode
  param: Bits(3)
  size: Bits(p.size_width)
  source: Bits(p.source_width)
  address: Bits(p.address_width)
  data: Bits(p.data_width)
  corrupt: Bool

bundle TLChannelD(p :: TLBundleParams):
  opcode: TLDOpcode
  param: Bits(2)
  size: Bits(p.size_width)
  source: Bits(p.source_width)
  sink: Bits(p.sink_width)
  denied: Bool
  data: Bits(p.data_width)
  corrupt: Bool

bundle TLChannelE(p :: TLBundleParams):
  sink: Bits(p.sink_width)

export:
  TLAOpcode
  TLBOpcode
  TLCOpcode
  TLDOpcode
  TLChannelA
  TLChannelB
  TLChannelC
  TLChannelD
  TLChannelE
