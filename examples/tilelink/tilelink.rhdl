#lang rhdl
// Demonstrates parameterized uncached and cached TileLink interfaces through transparent adapters.

import:
  lib("tilelink/main.rhdl") open

circuit TLUncachedAdapter(client_bundle, client, manager_bundle, manager):
  interface ingress(TLUncached(client_bundle, client), ~role: manager)
  interface egress(TLUncached(manager_bundle, manager), ~role: client)
  ingress |> egress

circuit TLCachedAdapter(client_bundle, client, manager_bundle, manager):
  interface ingress(TLCached(client_bundle, client), ~role: manager)
  interface egress(TLCached(manager_bundle, manager), ~role: client)
  ingress |> egress

def params = TLBundleParams(32, 8, 4, 3, 2)
def transfers = TransferSizes(1, 8)
def manager_transfers = TransferSizes(1, 64)
def client = TLClientParams(
  "cpu",
  IdRange(0, 4),
  ~emits: TLAOperationSizes(~get: transfers),
  ~supports: TLBOperationSizes(~probe: manager_transfers)
)
def uncached_manager = TLManagerParams(
  "ram",
  [AddressSet(0x80000000, 0x0fffffff)],
  IdRange(0, 4),
  ~supports: TLAOperationSizes(~get: manager_transfers)
)
def cached_manager = TLManagerParams(
  "cache",
  [AddressSet(0x80000000, 0x0fffffff)],
  IdRange(0, 4),
  ~supports: TLAOperationSizes(~get: manager_transfers),
  ~emits: TLBOperationSizes(~probe: transfers)
)
def client_link = TLClientLinkParams(params, client)
def uncached_manager_link = TLManagerLinkParams(params, uncached_manager)
def cached_manager_link = TLManagerLinkParams(params, cached_manager)
def uncached_design = elaborate(TLUncachedAdapter(params,
                                                  client,
                                                  params,
                                                  uncached_manager))
def cached_design = elaborate(TLCachedAdapter(params,
                                              client,
                                              params,
                                              cached_manager))

def uncached_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic [2:0] opcode; logic [2:0] param; logic [3:0] size; logic [2:0] source; logic [31:0] address; logic [7:0] mask; logic [63:0] data; logic corrupt; }
    TLChannelA;
  typedef
    struct packed {logic [2:0] opcode; logic [1:0] param; logic [3:0] size; logic [2:0] source; logic [1:0] sink; logic denied; logic [63:0] data; logic corrupt; }
    TLChannelD;
`endif // _TYPESCOPE_rhdl_types
module TLUncachedAdapter(
  input  struct packed {struct packed {logic valid; TLChannelA bits; } a; struct packed {logic ready; } d; } ingress_in,
  input  struct packed {struct packed {logic ready; } a; struct packed {logic valid; TLChannelD bits; } d; } egress_in,
  output struct packed {struct packed {logic ready; } a; struct packed {logic valid; TLChannelD bits; } d; } ingress_out,
  output struct packed {struct packed {logic valid; TLChannelA bits; } a; struct packed {logic ready; } d; } egress_out
);

  assign ingress_out = egress_in;
  assign egress_out = ingress_in;
endmodule
}>>|
def cached_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic [2:0] opcode; logic [2:0] param; logic [3:0] size; logic [2:0] source; logic [31:0] address; logic [7:0] mask; logic [63:0] data; logic corrupt; }
    TLChannelA;
  typedef
    struct packed {logic [2:0] opcode; logic [2:0] param; logic [3:0] size; logic [2:0] source; logic [31:0] address; logic [63:0] data; logic corrupt; }
    TLChannelC;
  typedef struct packed {logic [1:0] sink; } TLChannelE;
  typedef
    struct packed {logic [2:0] opcode; logic [1:0] param; logic [3:0] size; logic [2:0] source; logic [1:0] sink; logic denied; logic [63:0] data; logic corrupt; }
    TLChannelD;
`endif // _TYPESCOPE_rhdl_types
module TLCachedAdapter(
  input  struct packed {struct packed {logic valid; TLChannelA bits; } a; struct packed {logic valid; TLChannelC bits; } c; struct packed {logic valid; TLChannelE bits; } e; struct packed {logic ready; } b; struct packed {logic ready; } d; } ingress_in,
  input  struct packed {struct packed {logic ready; } a; struct packed {logic ready; } c; struct packed {logic ready; } e; struct packed {logic valid; TLChannelA bits; } b; struct packed {logic valid; TLChannelD bits; } d; }                  egress_in,
  output struct packed {struct packed {logic ready; } a; struct packed {logic ready; } c; struct packed {logic ready; } e; struct packed {logic valid; TLChannelA bits; } b; struct packed {logic valid; TLChannelD bits; } d; }                  ingress_out,
  output struct packed {struct packed {logic valid; TLChannelA bits; } a; struct packed {logic valid; TLChannelC bits; } c; struct packed {logic valid; TLChannelE bits; } e; struct packed {logic ready; } b; struct packed {logic ready; } d; } egress_out
);

  assign ingress_out = egress_in;
  assign egress_out = ingress_in;
endmodule
}>>|

export:
  TLUncachedAdapter
  TLCachedAdapter
  params
  client
  uncached_manager
  cached_manager
  client_link
  uncached_manager_link
  cached_manager_link
  uncached_design
  cached_design
  uncached_verilog_reference
  cached_verilog_reference
