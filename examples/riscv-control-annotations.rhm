#lang rhombus
// Demonstrates composing independent host-defined control layers over the immutable RV64I catalog.

import:
  "../riscv/annotations/main.rhm" open
  "../riscv/isa/rv64i.rhm" open

// These values and keys belong to this example microarchitecture, not to the
// architectural instruction model.
class AluOperation(name)
def NoAluOperation = AluOperation("none")
def Add = AluOperation("add")
def Subtract = AluOperation("subtract")

class PipelineClass(name)
def IntegerPipeline = PipelineClass("integer")
def MemoryPipeline = PipelineClass("memory")

def alu_operation = ControlKey(
  "alu_operation",
  fun (value): value is_a AluOperation,
  ~default: NoAluOperation
)
def pipeline_class = ControlKey(
  "pipeline_class",
  fun (value): value is_a PipelineClass,
  ~default: IntegerPipeline
)

def execution_controls = ControlLayer(
  "execution",
  RV64I,
  [alu_operation],
  [control(ADD, alu_operation(Add)),
   control(SUB, alu_operation(Subtract))]
)

def pipeline_controls = ControlLayer(
  "pipeline",
  RV64I,
  [pipeline_class],
  [control(LD, pipeline_class(MemoryPipeline)),
   control(SD, pipeline_class(MemoryPipeline))]
)

def CoreRV64I = annotate(RV64I, execution_controls, pipeline_controls)
def add_controls = CoreRV64I.find("ADD")
def load_controls = CoreRV64I.find("LD")

check:
  add_controls.control(alu_operation) === Add ~is #true
  add_controls.control(pipeline_class) === IntegerPipeline ~is #true
  load_controls.control(alu_operation) === NoAluOperation ~is #true
  load_controls.control(pipeline_class) === MemoryPipeline ~is #true

export:
  CoreRV64I
