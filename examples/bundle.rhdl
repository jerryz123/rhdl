#lang rhdl
// Demonstrates core record semantics through concise bundle syntax.

bundle Pair(T):
  left: T
  right: T

bundle Envelope(T):
  payload: Pair(T)
  tag: Bits(2)

circuit Swap(width):
  input source: Pair(Bits(width))
  output result: Pair(Bits(width))

  result.left <== source.right
  result.right <== source.left

circuit NestedSwap(width):
  input source: Envelope(Bits(width))
  output result: Envelope(Bits(width))

  result.payload.left <== source.payload.right
  result.payload.right <== source.payload.left
  result.tag <== source.tag

circuit BundleHierarchy(width):
  input source: Pair(Bits(width))
  output result: Pair(Bits(width))

  inst swap(Swap(width))
  swap.source <== source
  result <== swap.result

circuit BundleCast(width):
  input source: Pair(Bits(width))
  output bits_out: Bits(width + width)
  output restored: Pair(Bits(width))

  def raw = source.into(Bits(width + width))
  bits_out <== raw
  restored <== raw.into(Pair(Bits(width)))

circuit BundlePipeline(width):
  input clk: Clock
  input reset: Reset
  input select: Bool
  input direct: Pair(Bits(width))
  input alternate: Pair(Bits(width))
  output result: Pair(Bits(width))

  def zero = bits(0, ~width: width)
  def zero_pair = record(Pair(Bits(width))):
    left: zero
    right: zero
  def selected = mux(select, direct, alternate)
  reg state(Pair(Bits(width)), ~clock: clk, ~reset: reset, ~init: zero_pair)
  state.next <== selected
  result <== state

def design = elaborate(BundlePipeline(8))
def cast_design = elaborate(BundleCast(8))

def verilog_reference = @str|<<{

// Include register initializers in init blocks unless synthesis is set
`ifndef RANDOMIZE
  `ifdef RANDOMIZE_REG_INIT
    `define RANDOMIZE
  `endif // RANDOMIZE_REG_INIT
`endif // not def RANDOMIZE
`ifndef SYNTHESIS
  `ifndef ENABLE_INITIAL_REG_
    `define ENABLE_INITIAL_REG_
  `endif // not def ENABLE_INITIAL_REG_
`endif // not def SYNTHESIS

// Standard header to adapt well known macros for register randomization.

// RANDOM may be set to an expression that produces a 32-bit random unsigned value.
`ifndef RANDOM
  `define RANDOM $random
`endif // not def RANDOM

// Users can define INIT_RANDOM as general code that gets injected into the
// initializer block for modules with registers.
`ifndef INIT_RANDOM
  `define INIT_RANDOM
`endif // not def INIT_RANDOM

// If using random initialization, you can also define RANDOMIZE_DELAY to
// customize the delay used, otherwise 0.002 is used.
`ifndef RANDOMIZE_DELAY
  `define RANDOMIZE_DELAY 0.002
`endif // not def RANDOMIZE_DELAY

// Define INIT_RANDOM_PROLOG_ for use in our modules below.
`ifndef INIT_RANDOM_PROLOG_
  `ifdef RANDOMIZE
    `ifdef VERILATOR
      `define INIT_RANDOM_PROLOG_ `INIT_RANDOM
    `else  // VERILATOR
      `define INIT_RANDOM_PROLOG_ `INIT_RANDOM #`RANDOMIZE_DELAY begin end
    `endif // VERILATOR
  `else  // RANDOMIZE
    `define INIT_RANDOM_PROLOG_
  `endif // RANDOMIZE
`endif // not def INIT_RANDOM_PROLOG_
module BundlePipeline(
  input                                                        clk,
                                                               reset,
                                                               select,
  input  struct packed {logic [7:0] left; logic [7:0] right; } direct,
                                                               alternate,
  output struct packed {logic [7:0] left; logic [7:0] right; } result
);

  struct packed {logic [7:0] left; logic [7:0] right; } state;
  always @(posedge clk) begin
    if (reset)
      state <= '{left: (8'h0), right: (8'h0)};
    else
      state <= select ? direct : alternate;
  end // always @(posedge)
  `ifdef ENABLE_INITIAL_REG_
    `ifdef FIRRTL_BEFORE_INITIAL
      `FIRRTL_BEFORE_INITIAL
    `endif // FIRRTL_BEFORE_INITIAL
    initial begin
      automatic logic [31:0] _RANDOM[0:0];
      automatic logic [15:0] _GEN;
      `ifdef INIT_RANDOM_PROLOG_
        `INIT_RANDOM_PROLOG_
      `endif // INIT_RANDOM_PROLOG_
      `ifdef RANDOMIZE_REG_INIT
        for (logic  i = 1'h0; i < 1'h1; i += 1'h1) begin
          _RANDOM[/*Zero width*/ 1'b0] = `RANDOM;
        end
        _GEN = _RANDOM[/*Zero width*/ 1'b0][15:0];
        state.left = _GEN[15:8];
        state.right = _GEN[7:0];
      `endif // RANDOMIZE_REG_INIT
    end // initial
    `ifdef FIRRTL_AFTER_INITIAL
      `FIRRTL_AFTER_INITIAL
    `endif // FIRRTL_AFTER_INITIAL
  `endif // ENABLE_INITIAL_REG_
  assign result = state;
endmodule
}>>|
def cast_verilog_reference = @str|<<{
module BundleCast(
  input  struct packed {logic [7:0] left; logic [7:0] right; } source,
  output [15:0]                                                bits_out,
  output struct packed {logic [7:0] left; logic [7:0] right; } restored
);

  wire [15:0] _GEN = /*cast(bit[15:0])*/source;
  assign bits_out = _GEN;
  assign restored = /*cast(bit)*/_GEN;
endmodule
}>>|

export:
  Pair
  Envelope
  Swap
  NestedSwap
  BundleHierarchy
  BundleCast
  BundlePipeline
  design
  cast_design
  verilog_reference
  cast_verilog_reference
