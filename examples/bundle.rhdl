#lang rhdl
// Demonstrates core record semantics through concise bundle syntax.

bundle Pair(T):
  left: T
  right: T

bundle Envelope(T):
  payload: Pair(T)
  tag: Bits(2)

circuit Swap(width):
  input source: Pair(Bits(width))
  output result: Pair(Bits(width))

  result.left <== source.right
  result.right <== source.left

circuit NestedSwap(width):
  input source: Envelope(Bits(width))
  output result: Envelope(Bits(width))

  result.payload.left <== source.payload.right
  result.payload.right <== source.payload.left
  result.tag <== source.tag

circuit BundleHierarchy(width):
  input source: Pair(Bits(width))
  output result: Pair(Bits(width))

  inst swap(Swap(width))
  swap.source <== source
  result <== swap.result

circuit BundleCast(width):
  input source: Pair(Bits(width))
  output bits_out: Bits(width + width)
  output restored: Pair(Bits(width))

  def raw = source.into(Bits(width + width))
  bits_out <== raw
  restored <== raw.into(Pair(Bits(width)))

circuit BundleSpecializations():
  input narrow: Pair(Bits(8))
  input wide: Pair(Bits(16))
  output narrow_result: Pair(Bits(8))
  output wide_result: Pair(Bits(16))

  narrow_result <== narrow
  wide_result <== wide

circuit BundlePipeline(width):
  input clk: Clock
  input reset: Reset
  input select: Bool
  input direct: Pair(Bits(width))
  input alternate: Pair(Bits(width))
  output result: Pair(Bits(width))

  def zero_pair = Pair(Bits(width)):
    left: bits(0, width)
    right: bits(0, width)
  def selected = mux(select, direct, alternate)
  reg state(Pair(Bits(width)), ~clock: clk, ~reset: reset, ~init: zero_pair)
  state <== selected
  result <== state

def design = elaborate(BundlePipeline(8))
def cast_design = elaborate(BundleCast(8))
def specialization_design = elaborate(BundleSpecializations())

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef struct packed {logic [7:0] left; logic [7:0] right; } Pair;
`endif // _TYPESCOPE_rhdl_types
module BundlePipeline(
  input       clk,
              reset,
              select,
  input  Pair direct,
              alternate,
  output Pair result
);

  Pair state;
  always @(posedge clk) begin
    if (reset)
      state <= '{left: 8'h0, right: 8'h0};
    else
      state <= select ? direct : alternate;
  end // always @(posedge)
  assign result = state;
endmodule
}>>|
def cast_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef struct packed {logic [7:0] left; logic [7:0] right; } Pair;
`endif // _TYPESCOPE_rhdl_types
module BundleCast(
  input  Pair   source,
  output [15:0] bits_out,
  output Pair   restored
);

  assign bits_out = /*cast(bit[15:0])*/source;
  assign restored = source;
endmodule
}>>|

export:
  Pair
  Envelope
  Swap
  NestedSwap
  BundleHierarchy
  BundleCast
  BundleSpecializations
  BundlePipeline
  design
  cast_design
  specialization_design
  verilog_reference
  cast_verilog_reference
