#lang rhdl
// Demonstrates nominal enums with automatic and explicit hardware encodings.

hardware_enum State:
  Idle
  Running
  Done

hardware_enum Opcode(~width: 4):
  Add = 0
  Sub = 1
  Load = 8

circuit StateMachine():
  input clock: Clock
  input reset: Reset
  output state_out: State

  reg current(State, ~clock: clock, ~reset: reset, ~init: State.Idle)
  // The mandatory default recovers from State's unused two-bit encoding.
  current.next <== mux_lookup(current, ~default: State.Idle):
    State.Idle: State.Running
    State.Running: State.Done
    State.Done: State.Idle
  state_out <== current

circuit OpcodeDecoder():
  input opcode: Opcode
  output is_load: Bool
  output next_opcode: Opcode
  is_load <== opcode === Opcode.Load
  next_opcode <== mux_lookup(opcode, ~default: Opcode.Add):
    Opcode.Add: Opcode.Sub
    Opcode.Sub: Opcode.Load
    Opcode.Load: Opcode.Add

def design = elaborate(StateMachine())

def verilog_reference = @str|<<{
module StateMachine(
  input        clock,
               reset,
  output [1:0] state_out
);

  reg [1:0] current;
  always @(posedge clock) begin
    if (reset)
      current <= 2'h0;
    else
      current <=
        current == 2'h0 ? 2'h1 : current == 2'h1 ? 2'h2 : current == 2'h2 ? 2'h0 : 2'h0;
  end // always @(posedge)
  assign state_out = current;
endmodule
}>>|

export:
  State
  Opcode
  StateMachine
  OpcodeDecoder
  design
  verilog_reference
