module RV5StageTlb(
  input                                                                clock,
                                                                       reset,
  input  [63:0]                                                        virtual_address,
  input  [1:0]                                                         access,
                                                                       privilege,
  input                                                                sum,
                                                                       mxr,
                                                                       enabled,
                                                                       invalidate_all,
  input  struct packed {logic valid; RV5StageTranslationResult bits; } fill_in,
  output                                                               hit,
                                                                       fault,
  output [55:0]                                                        physical_address
);

  wire RV5StageTlbEntry[7:0] _GEN =
    '{'{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global_mapping: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global_mapping: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global_mapping: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global_mapping: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global_mapping: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global_mapping: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global_mapping: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global_mapping: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0}};
  RV5StageTlbEntry[7:0]      entries;
  reg  [2:0]                 replacement;
  wire [7:0]                 _GEN_0 =
    {{entries[3'h7].valid
        & (entries[3'h7].level == 2'h1
             ? entries[3'h7].vpn[26:9] == virtual_address[38:21]
             : entries[3'h7].level == 2'h2
                 ? entries[3'h7].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h7].vpn == virtual_address[38:12])},
     {entries[3'h6].valid
        & (entries[3'h6].level == 2'h1
             ? entries[3'h6].vpn[26:9] == virtual_address[38:21]
             : entries[3'h6].level == 2'h2
                 ? entries[3'h6].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h6].vpn == virtual_address[38:12])},
     {entries[3'h5].valid
        & (entries[3'h5].level == 2'h1
             ? entries[3'h5].vpn[26:9] == virtual_address[38:21]
             : entries[3'h5].level == 2'h2
                 ? entries[3'h5].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h5].vpn == virtual_address[38:12])},
     {entries[3'h4].valid
        & (entries[3'h4].level == 2'h1
             ? entries[3'h4].vpn[26:9] == virtual_address[38:21]
             : entries[3'h4].level == 2'h2
                 ? entries[3'h4].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h4].vpn == virtual_address[38:12])},
     {entries[3'h3].valid
        & (entries[3'h3].level == 2'h1
             ? entries[3'h3].vpn[26:9] == virtual_address[38:21]
             : entries[3'h3].level == 2'h2
                 ? entries[3'h3].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h3].vpn == virtual_address[38:12])},
     {entries[3'h2].valid
        & (entries[3'h2].level == 2'h1
             ? entries[3'h2].vpn[26:9] == virtual_address[38:21]
             : entries[3'h2].level == 2'h2
                 ? entries[3'h2].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h2].vpn == virtual_address[38:12])},
     {entries[3'h1].valid
        & (entries[3'h1].level == 2'h1
             ? entries[3'h1].vpn[26:9] == virtual_address[38:21]
             : entries[3'h1].level == 2'h2
                 ? entries[3'h1].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h1].vpn == virtual_address[38:12])},
     {entries[3'h0].valid
        & (entries[3'h0].level == 2'h1
             ? entries[3'h0].vpn[26:9] == virtual_address[38:21]
             : entries[3'h0].level == 2'h2
                 ? entries[3'h0].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h0].vpn == virtual_address[38:12])}};
  wire [6:0]                 _GEN_1 = _GEN_0[6:0] | {_GEN_0[5:0], 1'h0};
  wire [6:0]                 _GEN_2 = _GEN_1 | {_GEN_1[4:0], 2'h0};
  wire [6:0]                 _GEN_3 = _GEN_0[7:1] & ~(_GEN_2 | {_GEN_2[2:0], 4'h0});
  wire RV5StageTlbEntry      _GEN_4 =
    entries[{|(_GEN_3[6:3]),
             |{_GEN_3[6:5], _GEN_3[2:1]},
             |{_GEN_3[6], _GEN_3[4], _GEN_3[2], _GEN_3[0]}}];
  wire                       _GEN_5 =
    enabled & virtual_address[63:39] == {25{virtual_address[38]}} & (|_GEN_0);
  wire                       _GEN_6 = fill_in.valid & ~fill_in.bits.fault;
  wire RV5StageTlbEntry      _GEN_7 =
    '{valid: (1'h1),
      vpn: (fill_in.bits.virtual_address[38:12]),
      ppn: fill_in.bits.ppn,
      level: fill_in.bits.level,
      user: fill_in.bits.user,
      read: fill_in.bits.read,
      write: fill_in.bits.write,
      execute: fill_in.bits.execute,
      global_mapping: fill_in.bits.global_mapping,
      accessed: fill_in.bits.accessed,
      dirty: fill_in.bits.dirty};
  always @(posedge clock) begin
    if (reset) begin
      entries <= _GEN;
      replacement <= 3'h0;
    end
    else begin
      entries <=
        invalidate_all
          ? _GEN
          : _GEN_6
              ? {{(&replacement) ? _GEN_7 : entries[3'h7]},
                 {replacement == 3'h6 ? _GEN_7 : entries[3'h6]},
                 {replacement == 3'h5 ? _GEN_7 : entries[3'h5]},
                 {replacement == 3'h4 ? _GEN_7 : entries[3'h4]},
                 {replacement == 3'h3 ? _GEN_7 : entries[3'h3]},
                 {replacement == 3'h2 ? _GEN_7 : entries[3'h2]},
                 {replacement == 3'h1 ? _GEN_7 : entries[3'h1]},
                 {replacement == 3'h0 ? _GEN_7 : entries[3'h0]}}
              : entries;
      replacement <= invalidate_all ? 3'h0 : _GEN_6 ? replacement + 3'h1 : replacement;
    end
  end // always @(posedge)
  assign hit = ~enabled | _GEN_5;
  assign fault =
    _GEN_5
    & ~((privilege == 2'h0
           ? _GEN_4.user
           : ~_GEN_4.user | privilege == 2'h1 & sum & (|access))
        & (access == 2'h0
             ? _GEN_4.execute
             : access == 2'h1
                 ? _GEN_4.read | mxr & _GEN_4.execute
                 : _GEN_4.write & _GEN_4.dirty) & _GEN_4.accessed);
  assign physical_address =
    enabled
      ? (_GEN_4.level == 2'h0
           ? {_GEN_4.ppn, virtual_address[11:0]}
           : _GEN_4.level == 2'h1
               ? {_GEN_4.ppn[43:9], virtual_address[20:0]}
               : {_GEN_4.ppn[43:18], virtual_address[29:0]})
      : virtual_address[55:0];
endmodule

module RV5StagePageTableWalker(
  input                                                                                                                                                 clock,
                                                                                                                                                        reset,
  input  struct packed {logic valid; RV5StageTranslationRequest bits; }                                                                                 request_in,
  input  struct packed {logic ready; }                                                                                                                  completion_in,
  input  struct packed {struct packed {logic ready; } request; logic request_access_fault; struct packed {logic valid; logic [63:0] bits; } response; } memory_in,
  input                                                                                                                                                 cancel,
  output struct packed {logic ready; }                                                                                                                  request_out,
  output struct packed {logic valid; RV5StageTranslationResult bits; }                                                                                  completion_out,
  output struct packed {struct packed {logic valid; logic [63:0] bits; } request; struct packed {logic ready; } response; }                             memory_out
);

  reg  [1:0]                         state;
  RV5StageTranslationRequest         operation;
  reg  [1:0]                         level;
  reg  [43:0]                        table_ppn;
  reg                                global_mapping;
  RV5StageTranslationResult          result;
  wire                               _GEN = state == 2'h0;
  wire                               _GEN_0 = request_in.valid & _GEN;
  wire                               _GEN_1 = level == 2'h1;
  wire                               _GEN_2 = level == 2'h0;
  wire                               _GEN_3 = state == 2'h1;
  wire                               _GEN_4 = _GEN_3 & memory_in.request.ready;
  wire                               _GEN_5 = state == 2'h2;
  wire                               _GEN_6 = memory_in.response.valid & _GEN_5;
  wire                               _GEN_7 =
    memory_in.response.bits[1] | memory_in.response.bits[3];
  wire                               _GEN_8 =
    ~(memory_in.response.bits[0]
      & ~(memory_in.response.bits[2] & ~(memory_in.response.bits[1]))
      & memory_in.response.bits[63:54] == 10'h0) | _GEN_7
    & ~(_GEN_2
        | (_GEN_1
             ? memory_in.response.bits[18:10] == 9'h0
             : memory_in.response.bits[27:10] == 18'h0)) | ~_GEN_7
    & (_GEN_2 | memory_in.response.bits[7] | memory_in.response.bits[6]
       | memory_in.response.bits[4]);
  wire                               _GEN_9 = _GEN_8 | _GEN_7;
  wire                               _GEN_10 = &state;
  wire                               _GEN_11 = _GEN_4 & memory_in.request_access_fault;
  wire                               _GEN_12 = _GEN_4 & ~memory_in.request_access_fault;
  wire [24:0]                        _GEN_13 = {25{request_in.bits.virtual_address[38]}};
  wire                               _GEN_14 =
    request_in.bits.virtual_address[63:39] == _GEN_13;
  wire                               _GEN_15 =
    request_in.bits.virtual_address[63:39] != _GEN_13;
  wire RV5StageTranslationResult     _GEN_16 =
    '{virtual_address: request_in.bits.virtual_address,
      physical_address: (56'h0),
      ppn: (44'h0),
      level: (2'h0),
      user: (1'h0),
      read: (1'h0),
      write: (1'h0),
      execute: (1'h0),
      global_mapping: (1'h0),
      accessed: (1'h0),
      dirty: (1'h0),
      fault: (1'h1),
      access_fault: (1'h0)};
  wire RV5StageTranslationResult     _GEN_17 =
    '{virtual_address: operation.virtual_address,
      physical_address: (56'h0),
      ppn: (44'h0),
      level: level,
      user: (1'h0),
      read: (1'h0),
      write: (1'h0),
      execute: (1'h0),
      global_mapping: (1'h0),
      accessed: (1'h0),
      dirty: (1'h0),
      fault: (1'h0),
      access_fault: (1'h1)};
  wire RV5StageTranslationResult     _GEN_18 =
    '{virtual_address: operation.virtual_address,
      physical_address:
        (_GEN_2
           ? {memory_in.response.bits[53:10], operation.virtual_address[11:0]}
           : _GEN_1
               ? {memory_in.response.bits[53:19], operation.virtual_address[20:0]}
               : {memory_in.response.bits[53:28], operation.virtual_address[29:0]}),
      ppn: (memory_in.response.bits[53:10]),
      level: level,
      user: (memory_in.response.bits[4]),
      read: (memory_in.response.bits[1]),
      write: (memory_in.response.bits[2]),
      execute: (memory_in.response.bits[3]),
      global_mapping: (global_mapping | memory_in.response.bits[5]),
      accessed: (memory_in.response.bits[6]),
      dirty: (memory_in.response.bits[7]),
      fault:
        (_GEN_8 | _GEN_7
         & ~((operation.privilege == 2'h0
                ? memory_in.response.bits[4]
                : ~(memory_in.response.bits[4]) | operation.privilege == 2'h1
                  & operation.sum & (|operation.access))
             & (operation.access == 2'h0
                  ? memory_in.response.bits[3]
                  : operation.access == 2'h1
                      ? memory_in.response.bits[1] | operation.mxr
                        & memory_in.response.bits[3]
                      : memory_in.response.bits[2] & memory_in.response.bits[7])
             & memory_in.response.bits[6])),
      access_fault: (1'h0)};
  wire                               _GEN_19 = _GEN_11 | _GEN_12 | ~_GEN_6 | _GEN_9;
  wire struct packed {logic valid; logic [63:0] bits; } _GEN_20 =
    '{valid: _GEN_3,
      bits:
        ({8'h0, table_ppn, 12'h0}
         + {52'h0,
            _GEN_2
              ? operation.virtual_address[20:12]
              : _GEN_1
                  ? operation.virtual_address[29:21]
                  : operation.virtual_address[38:30],
            3'h0})};
  wire struct packed {logic ready; } _GEN_21 = '{ready: _GEN_5};
  always @(posedge clock) begin
    if (reset) begin
      state <= 2'h0;
      level <= 2'h2;
      global_mapping <= 1'h0;
    end
    else begin
      state <=
        cancel
          ? 2'h0
          : _GEN_0
              ? (_GEN_14 ? 2'h1 : _GEN_15 ? 2'h3 : state)
              : _GEN_11
                  ? 2'h3
                  : _GEN_12
                      ? 2'h2
                      : _GEN_6
                          ? (_GEN_9 ? 2'h3 : ~_GEN_9 ? 2'h1 : state)
                          : _GEN_10 & completion_in.ready ? 2'h0 : state;
      level <= cancel ? level : _GEN_0 ? 2'h2 : _GEN_19 ? level : level - 2'h1;
      global_mapping <=
        cancel
          ? global_mapping
          : ~_GEN_0
            & (~_GEN_11 & ~_GEN_12 & _GEN_6 & ~_GEN_9 & ~_GEN_9
               & memory_in.response.bits[5] | global_mapping);
    end
  end // always @(posedge)
  always @(posedge clock) begin
    operation <= cancel | ~_GEN_0 ? operation : request_in.bits;
    table_ppn <=
      cancel
        ? table_ppn
        : _GEN_0
            ? request_in.bits.root_ppn
            : _GEN_19 ? table_ppn : memory_in.response.bits[53:10];
    result <=
      cancel
        ? result
        : _GEN_0
            ? (_GEN_14 | ~_GEN_15 ? result : _GEN_16)
            : _GEN_11 ? _GEN_17 : _GEN_12 | ~(_GEN_6 & _GEN_9) ? result : _GEN_18;
  end // always @(posedge)
  assign request_out = '{ready: _GEN};
  assign completion_out = '{valid: _GEN_10, bits: result};
  assign memory_out = '{request: _GEN_20, response: _GEN_21};
endmodule

module Queue_1(
  input                                                               clock,
                                                                      reset,
  input  struct packed {logic valid; RV5StageInstructionFault bits; } ingress_in,
  input  struct packed {logic ready; }                                egress_in,
  output struct packed {logic ready; }                                ingress_out,
  output struct packed {logic valid; RV5StageInstructionFault bits; } egress_out,
  output [1:0]                                                        count
);

  wire RV5StageInstructionFault _GEN;
  wire                          _GEN_0;
  wire                          _write_pointer_value;
  wire                          _read_pointer_value;
  wire                          _GEN_1 = 1'h0;
  RV5StageInstructionFault      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]                    occupancy;
  wire                          _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire                          _GEN_3 = occupancy != 2'h2;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire                          _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

