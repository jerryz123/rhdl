                                  ? 64'h0
                                  : _GEN_10
                                      ? state.sscratch
                                      : _GEN_11
                                          ? state.sepc
                                          : _GEN_12
                                              ? state.scause
                                              : _GEN_13
                                                  ? state.stval
                                                  : _GEN_14
                                                      ? _GEN_1 & state.mideleg
                                                      : _GEN_15
                                                          ? state.satp
                                                          : _GEN_22
