  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_1[1])};
  assign ingress_2_out = '{ready: (egress_in.ready & _GEN_1[2])};
  assign ingress_3_out = '{ready: (egress_in.ready & _GEN_1[3])};
  assign egress_out = '{valid: (|_GEN_1), bits: _GEN_6};
  assign chosen = {|(_GEN_1[3:2]), |{_GEN_1[3], _GEN_1[1]}};
endmodule

module RV5StageMmu(
  input                                                                                                                                                                                         clock,
                                                                                                                                                                                                reset,
  input  struct packed {logic flush; logic invalidate_all; struct packed {logic valid; RV5StageInstructionReq bits; } request; struct packed {logic ready; } response; }                        instruction_in,
  input  struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }                                                                                                          data_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; RV5StageInstructionResp bits; } response; }                                                          instruction_memory_in,
  input  struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; } data_memory_in,
  input  [1:0]                                                                                                                                                                                  privilege,
  input  [63:0]                                                                                                                                                                                 mstatus,
                                                                                                                                                                                                satp,
  input                                                                                                                                                                                         invalidate_all,
  output struct packed {struct packed {logic ready; } request; struct packed {logic valid; RV5StageInstructionResp bits; } response; }                                                          instruction_out,
  output struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; } data_out,
  output struct packed {logic flush; logic invalidate_all; struct packed {logic valid; RV5StageInstructionReq bits; } request; struct packed {logic ready; } response; }                        instruction_memory_out,
  output struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }                                                                                                          data_memory_out
);

  wire struct packed {logic ready; } _instruction_owners_ingress_out;
  wire struct packed {logic valid; RV5StageInstructionFault bits; }
    _instruction_owners_egress_out;
  wire struct packed {logic ready; } _walker_request_out;
  wire struct packed {logic valid; RV5StageTranslationResult bits; }
    _walker_completion_out;
  wire
    struct packed {struct packed {logic valid; logic [63:0] bits; } request; struct packed {logic ready; } response; }
    _walker_memory_out;
  wire                               _dtlb_hit;
  wire                               _dtlb_fault;
  wire [55:0]                        _dtlb_physical_address;
  wire                               _itlb_hit;
  wire                               _itlb_fault;
  wire [55:0]                        _itlb_physical_address;
  wire                               _GEN = satp[63:60] == 4'h8;
  wire                               _GEN_0 = _GEN & privilege != 2'h3;
  wire [1:0]                         _GEN_1 =
    mstatus[12:11] == 2'h0 ? 2'h0 : {mstatus[12:11] != 2'h1, 1'h1};
  wire                               _GEN_2 = (&privilege) & mstatus[17];
  wire [1:0]                         _GEN_3 = _GEN_2 ? _GEN_1 : privilege;
  wire                               _GEN_4 = _GEN & _GEN_3 != 2'h3;
  wire [1:0]                         _GEN_5 =
    (|{data_in.request.bits.access == 3'h2,
       data_in.request.bits.access == 3'h4,
       data_in.request.bits.access == 3'h5})
      ? 2'h2
      : 2'h1;
  reg                                walk_active;
  reg                                walk_is_data;
  reg                                fault_valid;
  reg                                fault_is_data;
  reg                                fault_is_access;
  reg  [63:0]                        fault_address;
  reg                                walker_data_quiet_previous;
  reg                                walker_data_quiet_twice;
  reg                                walker_memory_outstanding;
  wire                               _GEN_6 =
    data_memory_in.drained & ~data_memory_in.response.valid;
  wire                               _GEN_7 = ~walk_active & ~fault_valid;
  wire                               _GEN_8 =
    instruction_in.request.valid & _GEN_0 & ~_itlb_hit;
  wire                               _GEN_9 =
    _GEN_7 & ~_GEN_8 & data_in.request.valid & _GEN_4 & ~_dtlb_hit;
  wire                               _GEN_10 = _GEN_7 & _GEN_8 | _GEN_9;
  wire RV5StageTranslationRequest    _GEN_11 =
    '{virtual_address:
        (_GEN_9 ? data_in.request.bits.address : instruction_in.request.bits.address),
      root_ppn: (satp[43:0]),
      access: (_GEN_9 ? _GEN_5 : 2'h0),
      privilege: (_GEN_9 & _GEN_2 ? _GEN_1 : privilege),
      sum: (mstatus[18]),
      mxr: (mstatus[19])};
  wire                               _GEN_12 = _GEN_10 & _walker_request_out.ready;
  wire                               _GEN_13 =
    invalidate_all | instruction_in.flush & walk_active & ~walk_is_data;
  wire                               _GEN_14 =
    _walker_completion_out.valid & ~fault_valid;
  wire                               _GEN_15 =
    fault_valid & ~fault_is_data & fault_address == instruction_in.request.bits.address;
  wire                               _GEN_16 =
    fault_valid & fault_is_data & fault_address == data_in.request.bits.address;
  wire                               _GEN_17 =
    _GEN_0 & (_itlb_hit & _itlb_fault | _GEN_15 & ~fault_is_access);
  wire                               _GEN_18 =
    _GEN_4 & (_dtlb_hit & _dtlb_fault | _GEN_16 & ~fault_is_access);
  wire                               _GEN_19 = _GEN_4 & _GEN_16 & fault_is_access;
  wire                               _GEN_20 = ~_GEN_0 | _itlb_hit | _GEN_15;
  wire [63:0]                        _GEN_21 =
    _GEN_0 ? {8'h0, _itlb_physical_address} : instruction_in.request.bits.address;
  wire [64:0]                        _GEN_22 = {1'h0, _GEN_21} + 65'h3;
  wire                               _GEN_23 =
    _GEN_0 & _GEN_15 & fault_is_access | (~_GEN_0 | _itlb_hit) & ~_GEN_17
    & ~(_GEN_21[63:44] == 20'h0 & _GEN_22[64:44] == 21'h0);
  wire                               _GEN_24 = _GEN_17 | _GEN_23;
  wire                               _GEN_25 =
    _GEN_20 & _instruction_owners_ingress_out.ready
    & (_GEN_24 | instruction_memory_in.request.ready);
  wire RV5StageInstructionFault      _GEN_26 = '{page: _GEN_17, access: _GEN_23};
  wire                               _GEN_27 =
    _instruction_owners_egress_out.bits.page | _instruction_owners_egress_out.bits.access;
  wire                               _GEN_28 =
    _instruction_owners_egress_out.valid
    & (_GEN_27 | instruction_memory_in.response.valid);
  wire RV5StageInstructionResp       _GEN_29 =
    '{instruction: (32'h0),
      page_fault: _instruction_owners_egress_out.bits.page,
      access_fault: _instruction_owners_egress_out.bits.access};
  wire                               _GEN_30 =
    walk_active & walker_data_quiet_twice & _walker_memory_out.request.valid;
  wire                               _GEN_31 = ~_GEN_4 | _dtlb_hit;
  wire                               _GEN_32 =
    _GEN_18 | _GEN_19 | ~walk_active & _GEN_31 & data_memory_in.request.ready;
  wire                               _GEN_33 = _GEN_18 | _GEN_19;
  wire RV5StageDataReq               _GEN_34 =
    '{address: _walker_memory_out.request.bits,
      access: (3'h1),
      atomic: (4'h0),
      width: (2'h3),
      unsigned_0: (1'h1),
      data: (64'h0),
      destination: (2'h0),
      rd: (5'h0),
      floating_point_double: (1'h0)};
  wire RV5StageDataReq               _GEN_35 =
    '{address: (_GEN_4 ? {8'h0, _dtlb_physical_address} : data_in.request.bits.address),
      access: data_in.request.bits.access,
      atomic: data_in.request.bits.atomic,
      width: data_in.request.bits.width,
      unsigned_0: data_in.request.bits.unsigned_0,
      data: data_in.request.bits.data,
      destination: data_in.request.bits.destination,
      rd: data_in.request.bits.rd,
      floating_point_double: data_in.request.bits.floating_point_double};
  wire                               _GEN_36 =
    walk_active & walker_data_quiet_twice & data_memory_in.request.ready;
  wire                               _GEN_37 =
    data_memory_in.response.valid & walker_memory_outstanding;
  wire                               _GEN_38 =
    instruction_in.request.valid & _GEN_25 & _GEN_24 | data_in.request.valid & _GEN_32
    & _GEN_33;
  wire                               _GEN_39 =
    _GEN_14
    & (_walker_completion_out.bits.fault | _walker_completion_out.bits.access_fault);
  wire                               _GEN_40 = _GEN_13 | _GEN_38 | ~_GEN_39;
  wire struct packed {logic ready; } _GEN_41 =
    '{ready: (instruction_in.response.ready & _GEN_28)};
  wire struct packed {logic valid; RV5StageInstructionFault bits; } _GEN_42 =
    '{valid: (instruction_in.request.valid & _GEN_25), bits: _GEN_26};
  wire struct packed {logic ready; } _GEN_43 = '{ready: _GEN_36};
  wire struct packed {logic valid; logic [63:0] bits; } _GEN_44 =
    '{valid: _GEN_37, bits: data_memory_in.response.bits.data};
  wire
    struct packed {struct packed {logic ready; } request; logic request_access_fault; struct packed {logic valid; logic [63:0] bits; } response; }
    _GEN_45 =
    '{request: _GEN_43,
      request_access_fault: data_memory_in.request_access_fault,
      response: _GEN_44};
  wire struct packed {logic ready; } _GEN_46 = '{ready: (~fault_valid)};
  wire struct packed {logic valid; RV5StageTranslationRequest bits; } _GEN_47 =
    '{valid: _GEN_10, bits: _GEN_11};
  wire struct packed {logic valid; RV5StageTranslationResult bits; } _GEN_48 =
    '{valid: (_GEN_14 & walk_is_data & ~_walker_completion_out.bits.access_fault),
      bits: _walker_completion_out.bits};
  wire struct packed {logic valid; RV5StageTranslationResult bits; } _GEN_49 =
    '{valid: (_GEN_14 & ~walk_is_data & ~_walker_completion_out.bits.access_fault),
      bits: _walker_completion_out.bits};
  wire struct packed {logic valid; RV5StageDataReq bits; } _GEN_50 =
    '{valid:
        (_GEN_30
           ? _walker_memory_out.request.valid
           : data_in.request.valid & ~walk_active & _GEN_31 & ~_GEN_33),
      bits: (_GEN_30 ? _GEN_34 : _GEN_35)};
  wire RV5StageInstructionReq        _GEN_51 = '{address: _GEN_21};
  wire struct packed {logic valid; RV5StageInstructionReq bits; } _GEN_52 =
    '{valid:
        (instruction_in.request.valid & _GEN_20 & ~_GEN_24
         & _instruction_owners_ingress_out.ready),
      bits: _GEN_51};
  wire struct packed {logic ready; } _GEN_53 =
    '{ready:
        (instruction_in.response.ready & _instruction_owners_egress_out.valid
         & ~_GEN_27)};
  wire struct packed {logic ready; } _GEN_54 = '{ready: _GEN_32};
  wire struct packed {logic valid; RV5StageDataResp bits; } _GEN_55 =
    '{valid: (data_memory_in.response.valid & ~walker_memory_outstanding),
      bits: data_memory_in.response.bits};
  wire struct packed {logic ready; } _GEN_56 = '{ready: _GEN_25};
  wire struct packed {logic valid; RV5StageInstructionResp bits; } _GEN_57 =
    '{valid: _GEN_28, bits: (_GEN_27 ? _GEN_29 : instruction_memory_in.response.bits)};
  RV5StageTlb itlb (
    .clock            (clock),
    .reset            (reset),
    .virtual_address  (instruction_in.request.bits.address),
    .access           (2'h0),
    .privilege        (privilege),
    .sum              (mstatus[18]),
    .mxr              (mstatus[19]),
    .enabled          (_GEN_0),
    .invalidate_all   (invalidate_all),
    .fill_in          (_GEN_49),
    .hit              (_itlb_hit),
    .fault            (_itlb_fault),
    .physical_address (_itlb_physical_address)
  );
  RV5StageTlb dtlb (
    .clock            (clock),
    .reset            (reset),
    .virtual_address  (data_in.request.bits.address),
    .access           (_GEN_5),
    .privilege        (_GEN_3),
    .sum              (mstatus[18]),
    .mxr              (mstatus[19]),
    .enabled          (_GEN_4),
    .invalidate_all   (invalidate_all),
    .fill_in          (_GEN_48),
    .hit              (_dtlb_hit),
    .fault            (_dtlb_fault),
    .physical_address (_dtlb_physical_address)
  );
  RV5StagePageTableWalker walker (
    .clock          (clock),
    .reset          (reset),
    .request_in     (_GEN_47),
    .completion_in  (_GEN_46),
    .memory_in      (_GEN_45),
    .cancel         (_GEN_13),
    .request_out    (_walker_request_out),
    .completion_out (_walker_completion_out),
    .memory_out     (_walker_memory_out)
  );
  Queue_1 instruction_owners (
    .clock       (clock),
    .reset       (reset | instruction_in.flush),
    .ingress_in  (_GEN_42),
    .egress_in   (_GEN_41),
    .ingress_out (_instruction_owners_ingress_out),
    .egress_out  (_instruction_owners_egress_out),
    .count       (/* unused */)
  );
  always @(posedge clock) begin
    if (reset) begin
      walk_active <= 1'h0;
      walk_is_data <= 1'h0;
      fault_valid <= 1'h0;
      fault_is_data <= 1'h0;
      fault_is_access <= 1'h0;
      walker_data_quiet_previous <= 1'h0;
      walker_data_quiet_twice <= 1'h0;
      walker_memory_outstanding <= 1'h0;
    end
    else begin
      walk_active <= ~_GEN_13 & (_GEN_12 | ~_GEN_14 & walk_active);
      walk_is_data <= _GEN_13 | ~_GEN_12 ? walk_is_data : _GEN_9;
      fault_valid <= ~_GEN_13 & ~_GEN_38 & (_GEN_39 | fault_valid);
      fault_is_data <= _GEN_40 ? fault_is_data : walk_is_data;
      fault_is_access <=
        _GEN_40 ? fault_is_access : _walker_completion_out.bits.access_fault;
      walker_data_quiet_previous <=
        ~_GEN_12 & (walk_active ? _GEN_6 : walker_data_quiet_previous);
      walker_data_quiet_twice <=
        ~_GEN_12
        & (walk_active ? _GEN_6 & walker_data_quiet_previous : walker_data_quiet_twice);
      walker_memory_outstanding <=
        ~_GEN_13
        & (_walker_memory_out.request.valid & _GEN_36
           & ~data_memory_in.request_access_fault | ~_GEN_37 & walker_memory_outstanding);
    end
