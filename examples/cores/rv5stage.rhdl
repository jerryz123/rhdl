module BranchResolver(
  input  struct packed {logic valid; BranchResolverRequest bits; } request_in,
  output struct packed {logic valid; BranchResult bits; }          result_out
);

  wire BranchResult _GEN =
    '{taken:
        (request_in.bits.control.enable
         & (request_in.bits.control.unconditional
            | (request_in.bits.control.compare_equal
                 ? request_in.bits.left == request_in.bits.right
                 : request_in.bits.control.signed_mode
                   & (request_in.bits.left[63] ^ request_in.bits.right[63])
                     ? request_in.bits.left[63]
                     : request_in.bits.left < request_in.bits.right)
            ^ request_in.bits.control.invert))};
  assign result_out = '{valid: request_in.valid, bits: _GEN};
endmodule

