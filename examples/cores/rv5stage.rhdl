    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [2:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 3'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmode)
      Memory[RW0_addr] <= RW0_wdata;
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

module SyncRam1RW_3(
  input                                                                                   clock,
                                                                                          reset,
  input  struct packed {struct packed {logic valid; ReadWriteRequest_3 bits; } request; } port_in,
  output struct packed {struct packed {logic valid; logic [0:0][2:0] bits; } response; }  port_out
);

  wire [0:0][2:0] _GEN;
  wire            _GEN_0;
  wire            _GEN_1;
  wire [5:0]      _GEN_2;
  wire [2:0]      _GEN_3;
  wire [2:0]      _storage_ext_RW0_rdata;
  storage_64x3 storage_ext (
    .RW0_addr  (_GEN_2),
    .RW0_en    (_GEN_1),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_0),
    .RW0_wdata (_GEN_3),
    .RW0_rdata (_storage_ext_RW0_rdata)
  );
  assign _GEN_3 = /*cast(bit[2:0])*/_GEN;
  wire [0:0][2:0] _GEN_4 = /*cast(bit[0:0][2:0])*/_storage_ext_RW0_rdata;
  reg             response_valid;
  assign _GEN_2 = port_in.request.bits.address;
  assign _GEN_1 = port_in.request.valid;
  assign _GEN_0 = port_in.request.bits.write;
  assign _GEN = port_in.request.bits.data;
  wire struct packed {logic valid; logic [0:0][2:0] bits; } _GEN_5 =
    '{valid: response_valid, bits: _GEN_4};
  always @(posedge clock) begin
    if (reset)
      response_valid <= 1'h0;
    else
      response_valid <= _GEN_1 & ~_GEN_0;
  end // always @(posedge)
  assign port_out = '{response: _GEN_5};
endmodule

module LoadGen(
  input  [63:0] address,
                data,
  input  [1:0]  width,
  input         unsigned_load,
  output [63:0] value
);

  wire [63:0]      _GEN = data >> {58'h0, address[2:0], 3'h0};
  wire [3:0][63:0] _GEN_0 =
    {{_GEN},
     {{{32{_GEN[31]}}, _GEN[31:0]}},
     {{{48{_GEN[15]}}, _GEN[15:0]}},
     {{{56{_GEN[7]}}, _GEN[7:0]}}};
  wire [3:0][63:0] _GEN_1 =
    {{_GEN}, {{32'h0, _GEN[31:0]}}, {{48'h0, _GEN[15:0]}}, {{56'h0, _GEN[7:0]}}};
  assign value = unsigned_load ? _GEN_1[width] : _GEN_0[width];
endmodule

module StoreGen(
  input  [63:0] address,
                value,
  input  [1:0]  width,
  output [63:0] data,
  output [7:0]  mask
);

  wire [3:0][7:0] _GEN = '{8'hFF, 8'hF, 8'h3, 8'h1};
  assign data = value << {58'h0, address[2:0], 3'h0};
  assign mask = _GEN[width] << address[2:0];
endmodule

module RV5StageAtomicALU(
  input  [63:0] old_value,
                operand,
  input  [1:0]  memory_width,
  input  [3:0]  operation,
  output [63:0] value
);

  wire        _GEN = memory_width == 2'h2;
  wire [63:0] _GEN_0 = _GEN ? {32'h0, old_value[31:0]} : old_value;
  wire [63:0] _GEN_1 = _GEN ? {32'h0, operand[31:0]} : operand;
  wire        _GEN_2 = _GEN_0 < _GEN_1;
  wire        _GEN_3 = _GEN ? _GEN_0[31] : _GEN_0[63];
  wire        _GEN_4 = _GEN_3 ^ (_GEN ? _GEN_1[31] : _GEN_1[63]) ? _GEN_3 : _GEN_2;
  wire [63:0] _GEN_5 =
    operation == 4'h1
      ? _GEN_0 + _GEN_1
      : operation == 4'h2
          ? _GEN_0 ^ _GEN_1
          : operation == 4'h3
              ? _GEN_0 & _GEN_1
              : operation == 4'h4
                  ? _GEN_0 | _GEN_1
                  : operation == 4'h5
                      ? (_GEN_4 ? _GEN_0 : _GEN_1)
                      : operation == 4'h6
                          ? (_GEN_4 ? _GEN_1 : _GEN_0)
                          : operation == 4'h7
                              ? (_GEN_2 ? _GEN_0 : _GEN_1)
                              : operation != 4'h8 | _GEN_2 ? _GEN_1 : _GEN_0;
  assign value = _GEN ? {32'h0, _GEN_5[31:0]} : _GEN_5;
endmodule

module RV5StageLineRefill_1(
  input                                                                  clock,
                                                                         reset,
  input  [6:0]                                                           node_id,
  input  struct packed {logic valid; RV5StageLineRefillCommand_1 bits; } command_in,
  input  struct packed {logic ready; }                                   completion_in,
                                                                         requests_in,
                                                                         acknowledgements_in,
  input  struct packed {logic valid; CHIRspFlit bits; }                  responses_in,
  input  struct packed {logic valid; CHIDatFlit bits; }                  response_data_in,
  output struct packed {logic ready; }                                   command_out,
  output struct packed {logic valid; RV5StageLineRefillResult_1 bits; }  completion_out,
  output struct packed {logic valid; CHIReqFlit bits; }                  requests_out,
  output struct packed {logic valid; CHIRspFlit bits; }                  acknowledgements_out,
  output struct packed {logic ready; }                                   responses_out,
                                                                         response_data_out
);

  wire CHIReqFlit                    _GEN;
  wire struct packed {logic valid; CHIRequestAttempt bits; } _control_attempt_out;
  wire struct packed {logic valid; CHIResponseEvent bits; } _control_event_out;
  wire                               _control_active;
  wire                               _control_attempt_outstanding;
  wire CHIMemAttr                    _GEN_0 =
