module RV5Stage(
  input                                                                                                                                                                                                                                                                                                                                         clock,
                                                                                                                                                                                                                                                                                                                                                reset,
  input  RV5StageCHIIdentity                                                                                                                                                                                                                                                                                                                    chi_identity,
  input  struct packed {logic valid; logic [63:0] bits; }                                                                                                                                                                                                                                                                                       start_in,
  input  RV5StageInterrupts                                                                                                                                                                                                                                                                                                                     interrupts,
  input  [63:0]                                                                                                                                                                                                                                                                                                                                 hart_id,
                                                                                                                                                                                                                                                                                                                                                time_counter,
  input  struct packed {struct packed {logic ready; } requests; struct packed {logic ready; } requester_responses; struct packed {logic ready; } request_data; struct packed {logic valid; CHIRspFlit bits; } responses; struct packed {logic valid; CHIDatFlit bits; } response_data; struct packed {logic valid; CHISnpFlit bits; } snoops; } imem_in,
                                                                                                                                                                                                                                                                                                                                                dmem_in,
  input  struct packed {struct packed {logic ready; } req; struct packed {struct packed {logic ready; } requester; struct packed {logic valid; CHIRspFlit bits; } response; } rsp; struct packed {struct packed {logic ready; } request; struct packed {logic valid; CHIDatFlit bits; } response; } dat; }                                      umem_in,
  output struct packed {logic ready; }                                                                                                                                                                                                                                                                                                          start_out,
  output struct packed {struct packed {logic valid; CHIReqFlit bits; } requests; struct packed {logic valid; CHIRspFlit bits; } requester_responses; struct packed {logic valid; CHIDatFlit bits; } request_data; struct packed {logic ready; } responses; struct packed {logic ready; } response_data; struct packed {logic ready; } snoops; } imem_out,
                                                                                                                                                                                                                                                                                                                                                dmem_out,
  output struct packed {struct packed {logic valid; CHIReqFlit bits; } req; struct packed {struct packed {logic valid; CHIRspFlit bits; } requester; struct packed {logic ready; } response; } rsp; struct packed {struct packed {logic valid; CHIDatFlit bits; } request; struct packed {logic ready; } response; } dat; }                     umem_out,
  output                                                                                                                                                                                                                                                                                                                                        fault
);

  wire
    struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; }
    _uncached_core_out;
  wire
    struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; }
    _memory_router_core_out;
  wire struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }
    _memory_router_cache_out;
  wire struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }
    _memory_router_device_out;
  wire
    struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; }
    _l1d_core_out;
  wire
    struct packed {struct packed {logic ready; } request; struct packed {logic valid; RV5StageInstructionResp bits; } response; }
    _l1i_core_out;
  wire
    struct packed {struct packed {logic ready; } request; struct packed {logic valid; RV5StageInstructionResp bits; } response; }
    _mmu_instruction_out;
  wire
    struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; }
    _mmu_data_out;
  wire
    struct packed {logic flush; logic invalidate_all; struct packed {logic valid; RV5StageInstructionReq bits; } request; struct packed {logic ready; } response; }
    _mmu_instruction_memory_out;
  wire struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }
    _mmu_data_memory_out;
  wire
    struct packed {logic flush; logic invalidate_all; struct packed {logic valid; RV5StageInstructionReq bits; } request; struct packed {logic ready; } response; }
    _core_instruction_access_out;
  wire struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }
    _core_data_access_out;
  wire [1:0]  _core_privilege;
  wire [63:0] _core_mstatus;
  wire [63:0] _core_satp;
  wire        _core_translation_flush;
  RV5StageCore core (
    .clock                  (clock),
    .reset                  (reset),
    .start_in               (start_in),
    .interrupts             (interrupts),
    .hart_id                (hart_id),
    .time_counter           (time_counter),
    .instruction_access_in  (_mmu_instruction_out),
    .data_access_in         (_mmu_data_out),
    .start_out              (start_out),
    .instruction_access_out (_core_instruction_access_out),
    .data_access_out        (_core_data_access_out),
    .fault                  (fault),
    .privilege              (_core_privilege),
    .mstatus                (_core_mstatus),
    .satp                   (_core_satp),
    .translation_flush      (_core_translation_flush)
  );
  RV5StageMmu mmu (
    .clock                  (clock),
    .reset                  (reset),
    .instruction_in         (_core_instruction_access_out),
    .data_in                (_core_data_access_out),
    .instruction_memory_in  (_l1i_core_out),
    .data_memory_in         (_memory_router_core_out),
    .privilege              (_core_privilege),
    .mstatus                (_core_mstatus),
    .satp                   (_core_satp),
    .invalidate_all         (_core_translation_flush),
    .instruction_out        (_mmu_instruction_out),
    .data_out               (_mmu_data_out),
    .instruction_memory_out (_mmu_instruction_memory_out),
    .data_memory_out        (_mmu_data_memory_out)
  );
  RV5StageL1ICache l1i (
    .clock    (clock),
    .reset    (reset),
    .node_id  (chi_identity.instruction_node_id),
    .core_in  (_mmu_instruction_memory_out),
    .chi_in   (imem_in),
    .core_out (_l1i_core_out),
    .chi_out  (imem_out)
  );
  RV5StageL1DCache l1d (
    .clock    (clock),
    .reset    (reset),
    .node_id  (chi_identity.data_node_id),
    .core_in  (_memory_router_cache_out),
    .chi_in   (dmem_in),
    .core_out (_l1d_core_out),
    .chi_out  (dmem_out)
  );
  RV5StageMemoryRouter memory_router (
    .clock      (clock),
    .reset      (reset),
    .core_in    (_mmu_data_memory_out),
    .cache_in   (_l1d_core_out),
    .device_in  (_uncached_core_out),
    .core_out   (_memory_router_core_out),
    .cache_out  (_memory_router_cache_out),
    .device_out (_memory_router_device_out)
  );
  RV5StageUncached uncached (
    .clock    (clock),
    .reset    (reset),
    .node_id  (chi_identity.device_node_id),
    .core_in  (_memory_router_device_out),
    .chi_in   (umem_in),
    .core_out (_uncached_core_out),
    .chi_out  (umem_out)
  );
endmodule

module RV5StageCore(
  input                                                                                                                                                                                         clock,
                                                                                                                                                                                                reset,
  input  struct packed {logic valid; logic [63:0] bits; }                                                                                                                                       start_in,
  input  RV5StageInterrupts                                                                                                                                                                     interrupts,
  input  [63:0]                                                                                                                                                                                 hart_id,
                                                                                                                                                                                                time_counter,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; RV5StageInstructionResp bits; } response; }                                                          instruction_access_in,
  input  struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; } data_access_in,
  output struct packed {logic ready; }                                                                                                                                                          start_out,
  output struct packed {logic flush; logic invalidate_all; struct packed {logic valid; RV5StageInstructionReq bits; } request; struct packed {logic ready; } response; }                        instruction_access_out,
  output struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }                                                                                                          data_access_out,
  output                                                                                                                                                                                        fault,
  output [1:0]                                                                                                                                                                                  privilege,
  output [63:0]                                                                                                                                                                                 mstatus,
                                                                                                                                                                                                satp,
  output                                                                                                                                                                                        translation_flush
);

  wire [4:0]                         _GEN;
  wire                               _GEN_0;
  wire [63:0]                        _GEN_1;
