  wire                               _GEN_2 = command_in.valid & ~_control_active;
  wire                               _GEN_3 = _GEN_2 & ~reset;
  wire                               _GEN_4 = ~_GEN_3;
  `ifndef SYNTHESIS
    line_refill_address_aligned:
      assert property (@(posedge clock) disable iff (_GEN_4)
                         command_in.bits.line_address[5:0] == 6'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_5 = ~_GEN_3;
  `ifndef SYNTHESIS
    line_refill_address_fits_chi:
      assert property (@(posedge clock) disable iff (_GEN_5)
                         command_in.bits.line_address[63:44] == 20'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_6 = ~_GEN_3;
  `ifndef SYNTHESIS
    line_refill_opcode_supported:
      assert property (@(posedge clock) disable iff (_GEN_6)
                         |{command_in.bits.opcode == 7'h2,
                           command_in.bits.opcode == 7'h7});
  `endif // not def SYNTHESIS
  wire                               _GEN_7 = _control_event_out.valid & ~reset;
  wire                               _GEN_8 = ~_GEN_7;
  `ifndef SYNTHESIS
    line_refill_retry_response_target:
      assert property (@(posedge clock) disable iff (_GEN_8)
                         _control_event_out.bits.flit.tgt_id == node_id);
  `endif // not def SYNTHESIS
  wire                               _GEN_9 = ~_GEN_7;
  `ifndef SYNTHESIS
    line_refill_retry_response_home:
      assert property (@(posedge clock) disable iff (_GEN_9)
                         _control_event_out.bits.flit.src_id == home_id);
  `endif // not def SYNTHESIS
  wire                               _GEN_10 =
    ~(_control_event_out.valid & _control_event_out.bits.retry_ack & ~reset);
  `ifndef SYNTHESIS
    line_refill_retry_txn_id:
      assert property (@(posedge clock) disable iff (_GEN_10)
                         _control_event_out.bits.flit.txn_id == 12'h0);
  `endif // not def SYNTHESIS
  wire CHICoherentResponse           _GEN_11 = /*cast(bit)*/response_data_in.bits.resp;
  wire [3:0]                         _GEN_12 = received_packets;
  wire                               _GEN_13 = &_GEN_12;
  wire                               _GEN_14 = _GEN_12 == 4'h0;
  wire [3:0][1:0]                    _GEN_15 =
    {{line_address[5:4] - 2'h1},
     {line_address[5:4] - 2'h2},
     {line_address[5:4] + 2'h1},
     {line_address[5:4]}};
  wire                               _GEN_16 = response_data_in.bits.data_id == 2'h0;
  wire                               _GEN_17 = response_data_in.bits.data_id == 2'h1;
  wire                               _GEN_18 = response_data_in.bits.data_id == 2'h2;
  wire                               _GEN_19 = &response_data_in.bits.data_id;
  wire [3:0][127:0]                  _GEN_20 = /*cast(bit[3:0][127:0])*/line;
  wire                               _GEN_21 =
    _control_active & _control_attempt_outstanding & ~_GEN_13;
  wire                               _GEN_22 = response_data_in.valid & _GEN_21;
  wire                               _GEN_23 = _GEN_22 & ~reset;
  wire                               _GEN_24 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_is_comp_data:
      assert property (@(posedge clock) disable iff (_GEN_24)
                         response_data_in.bits.opcode == 4'h4);
  `endif // not def SYNTHESIS
  wire                               _GEN_25 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_txn_id:
      assert property (@(posedge clock) disable iff (_GEN_25)
                         response_data_in.bits.txn_id == 12'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_26 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_target:
      assert property (@(posedge clock) disable iff (_GEN_26)
                         response_data_in.bits.tgt_id == node_id);
  `endif // not def SYNTHESIS
  wire                               _GEN_27 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_home:
      assert property (@(posedge clock) disable iff (_GEN_27)
                         response_data_in.bits.home_nid_or_pbha_or_mismatched_mecid == home_id);
  `endif // not def SYNTHESIS
  wire                               _GEN_28 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_data_id:
      assert property (@(posedge clock) disable iff (_GEN_28)
                         response_data_in.bits.data_id == _GEN_15[response_data_in.bits.data_id]);
  `endif // not def SYNTHESIS
  wire                               _GEN_29 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_data_id_unique:
      assert property (@(posedge clock) disable iff (_GEN_29)
                         ~received_packets[response_data_in.bits.data_id]);
  `endif // not def SYNTHESIS
  wire                               _GEN_30 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_num_dat_zero:
      assert property (@(posedge clock) disable iff (_GEN_30)
                         response_data_in.bits.num_dat == 2'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_31 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_not_replicated:
      assert property (@(posedge clock) disable iff (_GEN_31)
                         ~response_data_in.bits.replicate);
  `endif // not def SYNTHESIS
  wire                               _GEN_32 = ~_GEN_23;
  `ifndef SYNTHESIS
    line_refill_response_ok:
      assert property (@(posedge clock) disable iff (_GEN_32)
                         response_data_in.bits.resp_err == 2'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_33 = _GEN_22 & ~_GEN_14 & ~reset;
  wire                               _GEN_34 = ~_GEN_33;
  `ifndef SYNTHESIS
    line_refill_response_dbid_consistent:
      assert property (@(posedge clock) disable iff (_GEN_34)
                         response_data_in.bits.dbid_or_mecid[11:0] == dbid);
  `endif // not def SYNTHESIS
  wire                               _GEN_35 = ~_GEN_33;
  `ifndef SYNTHESIS
    line_refill_response_state_consistent:
      assert property (@(posedge clock) disable iff (_GEN_35)
                         _GEN_11.state == response_state);
  `endif // not def SYNTHESIS
  wire                               _GEN_36 = ~_GEN_33;
  `ifndef SYNTHESIS
    line_refill_response_pass_dirty_consistent:
      assert property (@(posedge clock) disable iff (_GEN_36)
                         _GEN_11.pass_dirty == pass_dirty);
  `endif // not def SYNTHESIS
  wire                               _GEN_37 =
    _control_active & _GEN_13 & ~acknowledgement_sent;
  wire CHIRspFlit                    _GEN_38 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: (12'h0),
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (5'h2),
      txn_id: dbid,
      src_id: node_id,
      tgt_id: home_id,
      qos: (4'h0)};
  wire                               _GEN_39 = _control_active & acknowledgement_sent;
  wire [7:0][63:0]                   _GEN_40 = /*cast(bit[7:0][63:0])*/line;
  wire RV5StageLineRefillResult_1    _GEN_41 =
    '{line_address: line_address,
      context_0: context_0,
      line: _GEN_40,
      state: response_state,
      pass_dirty: pass_dirty};
  wire [511:0]                       _GEN_42 =
    /*cast(bit[511:0])*/{{_GEN_19 ? response_data_in.bits.data : _GEN_20[2'h3]},
                         {_GEN_18 ? response_data_in.bits.data : _GEN_20[2'h2]},
                         {_GEN_17 ? response_data_in.bits.data : _GEN_20[2'h1]},
                         {_GEN_16 ? response_data_in.bits.data : _GEN_20[2'h0]}};
  wire                               _GEN_43 = _GEN_22 & _GEN_14;
  assign _GEN =
    '{trace_tag: (1'h0),
      tag_op: (2'h0),
      exp_comp_ack: (1'h1),
      excl_snoop_me_cah: (1'h0),
      group_id_or_lpid: (8'h0),
      snp_attr_or_do_dwt: (1'h1),
      mem_attr: _GEN_0,
      pcrd_type: _control_attempt_out.bits.pcrd_type,
      order: (2'h0),
      allow_retry: _control_attempt_out.bits.allow_retry,
      likely_shared: (1'h0),
      pas: (3'h0),
      address: (line_address[43:0]),
      size_or_num_req: (6'h6),
      multi_req: (1'h0),
      opcode: opcode,
      return_txn_id_or_stash_lpid: (12'h0),
      stash_nid_valid_endian_deep_prefetch_tgt_hint: (1'h0),
      return_nid_or_stash_nid_or_data_target: node_id,
      txn_id: (12'h0),
      src_id: node_id,
      tgt_id: home_id,
      qos: (4'h0)};
  CHIRetryableTransactionControl control (
    .clock               (clock),
    .reset               (reset),
    .start               (_GEN_2),
    .finish              (_GEN_39 & completion_in.ready),
    .external_progress   (_GEN_22),
    .attempt_in          (requests_in),
    .response_in         (responses_in),
    .attempt_out         (_control_attempt_out),
    .response_out        (responses_out),
    .event_out           (_control_event_out),
    .active              (_control_active),
    .attempt_outstanding (_control_attempt_outstanding),
    .received            (/* unused */)
  );
  always @(posedge clock) begin
    if (reset) begin
      received_packets <= _GEN_1;
      acknowledgement_sent <= 1'h0;
      line_address <= 64'h0;
      opcode <= 7'h2;
      line <= 512'h0;
      home_id <= 7'h0;
      dbid <= 12'h0;
      response_state <= 2'h0;
      pass_dirty <= 1'h0;
    end
    else begin
      received_packets <=
