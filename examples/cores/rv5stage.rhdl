  wire [3:0]                         _GEN_1 = '{1'h0, 1'h0, 1'h0, 1'h0};
  reg  [3:0]                         received_packets;
  reg                                acknowledgement_sent;
  reg  [63:0]                        line_address;
  reg  [6:0]                         opcode;
  RV5StageL1DTransactionContext      context_0;
