module RiscvBaseCounters(
  input                                                        clock,
                                                               reset,
                                                               retire,
  input  struct packed {logic valid; RiscvCounterWrite bits; } machine_write_in,
  output [63:0]                                                cycle,
                                                               instret
);

  reg [63:0] cycle_counter;
  reg [63:0] instret_counter;
  always @(posedge clock) begin
    if (reset) begin
      cycle_counter <= 64'h0;
      instret_counter <= 64'h0;
    end
    else begin
      cycle_counter <=
        machine_write_in.valid & machine_write_in.bits.address == 12'hB00
          ? machine_write_in.bits.value
          : cycle_counter + 64'h1;
      instret_counter <=
        machine_write_in.valid & machine_write_in.bits.address == 12'hB02
          ? machine_write_in.bits.value
          : retire ? instret_counter + 64'h1 : instret_counter;
    end
  end // always @(posedge)
  assign cycle = cycle_counter;
  assign instret = instret_counter;
endmodule

