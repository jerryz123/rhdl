    & {219{_GEN_0 == 2'h0}};
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_0[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_0[1])};
  assign egress_out = '{valid: (|_GEN_0), bits: _GEN_3};
  assign chosen = _GEN_0[1];
endmodule

module RV5StageMemoryRouter(
  input                                                                                                                                                                                         clock,
                                                                                                                                                                                                reset,
  input  struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }                                                                                                          core_in,
  input  struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; } cache_in,
                                                                                                                                                                                                device_in,
  output struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; } core_out,
  output struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }                                                                                                          cache_out,
                                                                                                                                                                                                device_out
);

  wire [64:0]                        _GEN =
    {1'h0, core_in.request.bits.address}
    + {1'h0,
       core_in.request.bits.width == 2'h0
         ? 64'h0
         : core_in.request.bits.width == 2'h1
             ? 64'h1
             : {61'h0, core_in.request.bits.width != 2'h2, 2'h3}};
  wire                               _GEN_0 =
    core_in.request.bits.address[63:44] == 20'h0;
  wire                               _GEN_1 = _GEN[64:44] == 21'h0;
  wire                               _GEN_2 = _GEN_0 & _GEN_1;
  wire                               _GEN_3 = core_in.request.bits.access == 3'h3;
  wire                               _GEN_4 = core_in.request.bits.access == 3'h5;
  wire                               _GEN_5 = core_in.request.bits.access == 3'h4;
  wire                               _GEN_6 =
    _GEN_0 & _GEN_1
    & (~((|{core_in.request.bits.access == 3'h1, _GEN_3}) | _GEN_4) | _GEN_2)
    & ({core_in.request.bits.access == 3'h2, _GEN_5, _GEN_4} == 3'h0 | _GEN_2)
    & ({_GEN_3, _GEN_5, _GEN_4} == 3'h0 | _GEN_2);
  `ifndef SYNTHESIS
    rv5stage_memory_response_paths_exclusive:
      assert property (@(posedge clock) disable iff (reset)
                         ~(cache_in.response.valid & device_in.response.valid));
  `endif // not def SYNTHESIS
  wire struct packed {logic valid; RV5StageDataReq bits; } _GEN_7 =
    '{valid: (core_in.request.valid & _GEN_6 & ~_GEN_2 & cache_in.drained),
      bits: core_in.request.bits};
  wire struct packed {logic valid; RV5StageDataReq bits; } _GEN_8 =
    '{valid: (core_in.request.valid & _GEN_6 & _GEN_2 & device_in.drained),
      bits: core_in.request.bits};
  wire struct packed {logic ready; } _GEN_9 =
    '{ready:
        (~_GEN_6
         | (~_GEN_2
              ? cache_in.drained & device_in.request.ready
              : device_in.drained & cache_in.request.ready))};
  wire struct packed {logic valid; RV5StageDataResp bits; } _GEN_10 =
    '{valid: (cache_in.response.valid | device_in.response.valid),
      bits:
        (device_in.response.valid ? device_in.response.bits : cache_in.response.bits)};
  assign core_out =
    '{request: _GEN_9,
      request_fault:
        (core_in.request.valid & _GEN_6
         & (~_GEN_2 ? device_in.request_fault : cache_in.request_fault)),
      request_access_fault:
        (core_in.request.valid
         & (~_GEN_6
            | (~_GEN_2
                 ? device_in.request_access_fault
                 : cache_in.request_access_fault))),
      response: _GEN_10,
      drained: (cache_in.drained & device_in.drained)};
  assign cache_out = '{request: _GEN_8};
  assign device_out = '{request: _GEN_7};
endmodule

module RV5StageUncached(
  input                                                                                                                                                                                                                                                                                                                     clock,
                                                                                                                                                                                                                                                                                                                            reset,
  input  [6:0]                                                                                                                                                                                                                                                                                                              node_id,
  input  struct packed {struct packed {logic valid; RV5StageDataReq bits; } request; }                                                                                                                                                                                                                                      core_in,
  input  struct packed {struct packed {logic ready; } req; struct packed {struct packed {logic ready; } requester; struct packed {logic valid; CHIRspFlit bits; } response; } rsp; struct packed {struct packed {logic ready; } request; struct packed {logic valid; CHIDatFlit bits; } response; } dat; }                  chi_in,
  output struct packed {struct packed {logic ready; } request; logic request_fault; logic request_access_fault; struct packed {logic valid; RV5StageDataResp bits; } response; logic drained; }                                                                                                                             core_out,
  output struct packed {struct packed {logic valid; CHIReqFlit bits; } req; struct packed {struct packed {logic valid; CHIRspFlit bits; } requester; struct packed {logic ready; } response; } rsp; struct packed {struct packed {logic valid; CHIDatFlit bits; } request; struct packed {logic ready; } response; } dat; } chi_out
);

  wire [63:0]                        _store_gen_data;
  wire [7:0]                         _store_gen_mask;
  wire [63:0]                        _load_gen_value;
  wire CHIRspFlit                    _GEN =
    '{cache_line_id: 6'h0,
      trace_tag: 1'h0,
      tag_op: 2'h0,
      pcrd_type: 4'h0,
      dbid_or_group_id: 12'h0,
      c_busy: 3'h0,
      fwd_state_or_data_pull: 3'h0,
      resp: 3'h0,
      resp_err: 2'h0,
      opcode: 5'h0,
      txn_id: 12'h0,
      src_id: 7'h0,
      tgt_id: 7'h0,
      qos: 4'h0};
  wire CHIMemAttr                    _GEN_0 =
    '{allocate: 1'h0, cacheable: 1'h0, device: 1'h1, early_write_acknowledge: 1'h0};
  reg  [2:0]                         state;
  reg  [63:0]                        address;
  reg  [1:0]                         memory_width;
  reg                                unsigned_load;
  reg  [1:0]                         destination;
  reg  [4:0]                         rd;
  reg                                floating_point_double;
  reg  [11:0]                        dbid;
  reg  [63:0]                        write_data;
  reg  [7:0]                         write_mask;
  wire                               _GEN_1 = state == 3'h0;
  wire                               _GEN_2 = core_in.request.bits.access == 3'h2;
  wire                               _GEN_3 =
    |{core_in.request.bits.access == 3'h1, _GEN_2};
  wire                               _GEN_4 = core_in.request.valid & _GEN_1 & _GEN_3;
  wire                               _GEN_5 = _GEN_4 & chi_in.req.ready;
  wire                               _GEN_6 = |chi_in.rsp.response.bits.opcode;
  wire                               _GEN_7 = state == 3'h2;
  wire                               _GEN_8 = state == 3'h4;
  wire                               _GEN_9 =
    _GEN_7 & chi_in.rsp.response.bits.opcode == 5'h6 | _GEN_8
    & chi_in.rsp.response.bits.opcode == 5'h4;
  wire                               _GEN_10 = ~_GEN_6 | _GEN_9;
  wire                               _GEN_11 =
    chi_in.rsp.response.valid & _GEN_10 & _GEN_6;
  wire                               _GEN_12 = _GEN_11 & _GEN_7;
  wire                               _GEN_13 = state == 3'h3;
  wire                               _GEN_14 = |chi_in.dat.response.bits.opcode;
  wire                               _GEN_15 = state == 3'h1;
  wire [1:0][63:0]                   _GEN_16 =
    /*cast(bit[1:0][63:0])*/chi_in.dat.response.bits.data;
  wire                               _GEN_17 = ~_GEN_14 | _GEN_15;
  wire                               _GEN_18 =
    chi_in.dat.response.valid & _GEN_17 & _GEN_14;
  wire                               _GEN_19 = _GEN_18 | _GEN_11 & _GEN_8;
  wire RV5StageDataResp              _GEN_20 =
    '{data: (_GEN_18 ? _load_gen_value : 64'h0),
      destination: destination,
      rd: rd,
      floating_point_double: floating_point_double};
  wire                               _GEN_21 =
    ~(core_in.request.valid & _GEN_1 & _GEN_3 & ~reset);
  `ifndef SYNTHESIS
    rv5stage_uncached_address_fits:
      assert property (@(posedge clock) disable iff (_GEN_21)
                         core_in.request.bits.address[63:44] == 20'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_22 =
    chi_in.rsp.response.valid & _GEN_6 & ~reset;
  wire                               _GEN_23 = ~_GEN_22;
  `ifndef SYNTHESIS
    rv5stage_uncached_response_expected:
      assert property (@(posedge clock) disable iff (_GEN_23) _GEN_9);
  `endif // not def SYNTHESIS
  wire                               _GEN_24 = ~_GEN_22;
  `ifndef SYNTHESIS
    rv5stage_uncached_response_home:
      assert property (@(posedge clock) disable iff (_GEN_24)
                         chi_in.rsp.response.bits.src_id == 7'h1);
  `endif // not def SYNTHESIS
  wire                               _GEN_25 = ~_GEN_22;
  `ifndef SYNTHESIS
    rv5stage_uncached_response_ok:
      assert property (@(posedge clock) disable iff (_GEN_25)
                         chi_in.rsp.response.bits.resp_err == 2'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_26 =
    chi_in.dat.response.valid & _GEN_14 & ~reset;
  wire                               _GEN_27 = ~_GEN_26;
  `ifndef SYNTHESIS
    rv5stage_uncached_read_data_expected:
      assert property (@(posedge clock) disable iff (_GEN_27) _GEN_15);
  `endif // not def SYNTHESIS
  wire                               _GEN_28 = ~_GEN_26;
  `ifndef SYNTHESIS
    rv5stage_uncached_read_data_home:
      assert property (@(posedge clock) disable iff (_GEN_28)
                         chi_in.dat.response.bits.home_nid_or_pbha_or_mismatched_mecid == 7'h1);
  `endif // not def SYNTHESIS
  wire                               _GEN_29 = ~_GEN_26;
  `ifndef SYNTHESIS
    rv5stage_uncached_read_data_ok:
      assert property (@(posedge clock) disable iff (_GEN_29)
                         chi_in.dat.response.bits.resp_err == 2'h0);
  `endif // not def SYNTHESIS
  wire CHIDatFlit                    _GEN_30 =
    '{data: ({64'h0, write_data} << {121'h0, address[3], 6'h0}),
      byte_enable: ({8'h0, write_mask} << {12'h0, address[3], 3'h0}),
      replicate: (1'h0),
      num_dat: (2'h0),
      cah: (1'h0),
      trace_tag: (1'h0),
      tag_update: (1'h0),
      tag: (4'h0),
      tag_op: (2'h0),
      cache_line_id: (6'h0),
      data_id: (address[5:4]),
      ccid: (address[5:4]),
      dbid_or_mecid: {4'h0, dbid},
      c_busy: (3'h0),
      data_pull: (1'h0),
      data_source_or_fwd_state: (8'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (4'h3),
      home_nid_or_pbha_or_mismatched_mecid: (7'h1),
      txn_id: dbid,
      src_id: node_id,
      tgt_id: (7'h1),
      qos: (4'h0)};
  wire CHIReqFlit                    _GEN_31 =
    '{trace_tag: (1'h0),
      tag_op: (2'h0),
      exp_comp_ack: (1'h0),
      excl_snoop_me_cah: (1'h0),
      group_id_or_lpid: (8'h0),
      snp_attr_or_do_dwt: (1'h1),
      mem_attr: _GEN_0,
      pcrd_type: (4'h0),
      order: (2'h0),
      allow_retry: (1'h0),
      likely_shared: (1'h0),
      pas: (3'h0),
      address: (core_in.request.bits.address[43:0]),
      size_or_num_req: {4'h0, core_in.request.bits.width},
      multi_req: (1'h0),
      opcode: (_GEN_2 ? 7'h1C : 7'h4),
      return_txn_id_or_stash_lpid: (12'h0),
      stash_nid_valid_endian_deep_prefetch_tgt_hint: (1'h0),
      return_nid_or_stash_nid_or_data_target: node_id,
      txn_id: (12'h0),
      src_id: node_id,
      tgt_id: (7'h1),
      qos: (4'h0)};
  wire struct packed {logic valid; CHIReqFlit bits; } _GEN_32 =
    '{valid: _GEN_4, bits: _GEN_31};
  wire struct packed {logic valid; CHIRspFlit bits; } _GEN_33 =
    '{valid: (1'h0), bits: _GEN};
  wire struct packed {logic ready; } _GEN_34 = '{ready: _GEN_10};
  wire
    struct packed {struct packed {logic valid; CHIRspFlit bits; } requester; struct packed {logic ready; } response; }
    _GEN_35 = '{requester: _GEN_33, response: _GEN_34};
  wire struct packed {logic valid; CHIDatFlit bits; } _GEN_36 =
    '{valid: _GEN_13, bits: _GEN_30};
  wire struct packed {logic ready; } _GEN_37 = '{ready: _GEN_17};
  wire
    struct packed {struct packed {logic valid; CHIDatFlit bits; } request; struct packed {logic ready; } response; }
    _GEN_38 = '{request: _GEN_36, response: _GEN_37};
  wire struct packed {logic ready; } _GEN_39 =
    '{ready: (_GEN_1 & (~_GEN_3 | chi_in.req.ready))};
  wire struct packed {logic valid; RV5StageDataResp bits; } _GEN_40 =
    '{valid: _GEN_19, bits: _GEN_20};
  LoadGen_1 load_gen (
    .address       (address),
    .data          (_GEN_16[address[3]]),
    .width         (memory_width),
    .unsigned_load (unsigned_load),
    .value         (_load_gen_value)
  );
  StoreGen_1 store_gen (
    .address (core_in.request.bits.address),
    .value   (core_in.request.bits.data),
    .width   (core_in.request.bits.width),
    .data    (_store_gen_data),
    .mask    (_store_gen_mask)
  );
  always @(posedge clock) begin
    if (reset) begin
      state <= 3'h0;
      unsigned_load <= 1'h0;
    end
    else begin
      state <=
        _GEN_5
          ? (_GEN_2 ? 3'h2 : 3'h1)
          : _GEN_12
              ? 3'h3
              : _GEN_13 & chi_in.dat.request.ready ? 3'h4 : _GEN_19 ? 3'h0 : state;
      unsigned_load <= _GEN_5 ? core_in.request.bits.unsigned_0 : unsigned_load;
    end
  end // always @(posedge)
  always @(posedge clock) begin
    address <= _GEN_5 ? core_in.request.bits.address : address;
    memory_width <= _GEN_5 ? core_in.request.bits.width : memory_width;
    destination <= _GEN_5 ? core_in.request.bits.destination : destination;
    rd <= _GEN_5 ? core_in.request.bits.rd : rd;
    floating_point_double <=
      _GEN_5 ? core_in.request.bits.floating_point_double : floating_point_double;
    dbid <= _GEN_5 | ~_GEN_12 ? dbid : chi_in.rsp.response.bits.dbid_or_group_id;
    write_data <= _GEN_5 ? _store_gen_data : write_data;
    write_mask <= _GEN_5 ? _store_gen_mask : write_mask;
  end // always @(posedge)
  assign core_out =
    '{request: _GEN_39,
      request_fault: (1'h0),
      request_access_fault: (core_in.request.valid & ~_GEN_3),
      response: _GEN_40,
      drained: _GEN_1};
  assign chi_out = '{req: _GEN_32, rsp: _GEN_35, dat: _GEN_38};
endmodule

module LoadGen_1(
  input  [63:0] address,
                data,
  input  [1:0]  width,
  input         unsigned_load,
  output [63:0] value
);

  wire [63:0]      _GEN = data >> {58'h0, address[2:0], 3'h0};
  wire [3:0][63:0] _GEN_0 =
    {{_GEN},
     {{{32{_GEN[31]}}, _GEN[31:0]}},
     {{{48{_GEN[15]}}, _GEN[15:0]}},
     {{{56{_GEN[7]}}, _GEN[7:0]}}};
  wire [3:0][63:0] _GEN_1 =
    {{_GEN}, {{32'h0, _GEN[31:0]}}, {{48'h0, _GEN[15:0]}}, {{56'h0, _GEN[7:0]}}};
  assign value = unsigned_load ? _GEN_1[width] : _GEN_0[width];
endmodule

module StoreGen_1(
  input  [63:0] address,
                value,
  input  [1:0]  width,
  output [63:0] data,
  output [7:0]  mask
);

  wire [3:0][7:0] _GEN = '{8'hFF, 8'hF, 8'h3, 8'h1};
  assign data = value << {58'h0, address[2:0], 3'h0};
  assign mask = _GEN[width] << address[2:0];
endmodule
