module CHIRetryableTransactionControl(
  input                                                        clock,
                                                               reset,
                                                               start,
                                                               finish,
                                                               external_progress,
  input  struct packed {logic ready; }                         attempt_in,
  input  struct packed {logic valid; CHIRspFlit bits; }        response_in,
  output struct packed {logic valid; CHIRequestAttempt bits; } attempt_out,
  output struct packed {logic ready; }                         response_out,
  output struct packed {logic valid; CHIResponseEvent bits; }  event_out,
  output                                                       active,
                                                               attempt_outstanding,
                                                               received
);

  reg                    active_state;
  reg                    attempt_sent;
  reg                    received_state;
  reg                    irreversible_progress;
  reg                    retry_received;
  reg                    retry_credit_received;
  reg  [3:0]             retry_credit_type;
  reg  [3:0]             granted_credit_type;
  wire                   _GEN =
    active_state & ~attempt_sent
    & (~retry_received | retry_received & retry_credit_received);
  wire CHIRequestAttempt _GEN_0 =
    '{allow_retry: (~retry_received),
      pcrd_type: (retry_received ? retry_credit_type : 4'h0)};
  wire                   _GEN_1 = _GEN & attempt_in.ready;
  wire                   _GEN_2 = |response_in.bits.opcode;
  wire                   _GEN_3 = response_in.bits.opcode == 5'h3;
  wire                   _GEN_4 = response_in.bits.opcode == 5'h7;
  wire                   _GEN_5 =
    active_state & _GEN_3 & attempt_sent & ~irreversible_progress | active_state & _GEN_4
    & (attempt_sent | retry_received);
  wire                   _GEN_6 = ~_GEN_2 | _GEN_5;
  wire                   _GEN_7 = response_in.valid & _GEN_6 & _GEN_2;
  wire                   _GEN_8 = _GEN_7 & _GEN_3;
  wire                   _GEN_9 = _GEN_7 & _GEN_4;
  wire CHIResponseEvent  _GEN_10 =
    '{flit: response_in.bits,
      effects: (1'h0),
      retry_ack: _GEN_3,
      protocol_credit: _GEN_4};
  wire                   _GEN_11 = ~(response_in.valid & _GEN_2 & ~reset);
  `ifndef SYNTHESIS
    rv5stage_refill_response_expected:
      assert property (@(posedge clock) disable iff (_GEN_11) _GEN_5);
  `endif // not def SYNTHESIS
  wire                   _GEN_12 = ~(retry_received & retry_credit_received & ~reset);
  `ifndef SYNTHESIS
    rv5stage_refill_retry_credit_type_matches:
      assert property (@(posedge clock) disable iff (_GEN_12)
                         retry_credit_type == granted_credit_type);
  `endif // not def SYNTHESIS
  wire                   _GEN_13 = start | finish;
  wire                   _GEN_14 = start | _GEN_1 & retry_received | finish;
  always @(posedge clock) begin
    if (reset) begin
      active_state <= 1'h0;
      attempt_sent <= 1'h0;
      received_state <= 1'h0;
      irreversible_progress <= 1'h0;
      retry_received <= 1'h0;
      retry_credit_received <= 1'h0;
      retry_credit_type <= 4'h0;
      granted_credit_type <= 4'h0;
    end
    else begin
      active_state <= start | ~finish & active_state;
      attempt_sent <= ~(start | _GEN_8 | finish) & (_GEN_1 | attempt_sent);
      received_state <= ~_GEN_13 & received_state;
      irreversible_progress <= ~_GEN_13 & (external_progress | irreversible_progress);
      retry_received <= ~_GEN_14 & (_GEN_8 | retry_received);
      retry_credit_received <= ~_GEN_14 & (~_GEN_8 & _GEN_9 | retry_credit_received);
      retry_credit_type <=
        _GEN_14 ? 4'h0 : _GEN_8 ? response_in.bits.pcrd_type : retry_credit_type;
      granted_credit_type <=
        _GEN_14
          ? 4'h0
          : _GEN_8 | ~_GEN_9 ? granted_credit_type : response_in.bits.pcrd_type;
    end
  end // always @(posedge)
  assign attempt_out = '{valid: _GEN, bits: _GEN_0};
  assign response_out = '{ready: _GEN_6};
  assign event_out = '{valid: _GEN_7, bits: _GEN_10};
  assign active = active_state;
  assign attempt_outstanding = attempt_sent;
  assign received = received_state;
endmodule

module RV5StageCleanSnoop(
  input                                                                     clock,
                                                                            reset,
  input  [6:0]                                                              node_id,
  input                                                                     cache_ready,
  input  struct packed {logic valid; CHISnpFlit bits; }                     snoops_in,
  input  struct packed {logic ready; }                                      responses_in,
  input  struct packed {logic valid; RV5StageCleanSnoopLookupResult bits; } lookup_result_in,
  output                                                                    pending,
  output [63:0]                                                             address,
  output struct packed {logic ready; }                                      snoops_out,
  output struct packed {logic valid; CHIRspFlit bits; }                     responses_out,
  output struct packed {logic valid; logic [63:0] bits; }                   lookup_out,
  output struct packed {logic valid; RV5StageCleanSnoopUpdate bits; }       update_out
);

  reg                           active_state;
  reg                           uses_lookup;
  CHISnpFlit                    request;
  reg                           lookup_complete;
  reg                           line_hit;
  reg  [1:0]                    line_state;
  reg                           dvm_first_pending;
  reg  [6:0]                    dvm_source_id;
  reg  [11:0]                   dvm_txn_id;
  wire                          _GEN = |snoops_in.bits.opcode;
  wire                          _GEN_0 = snoops_in.bits.opcode == 5'hD;
  wire                          _GEN_1 =
    ~_GEN | ~active_state & cache_ready & (~dvm_first_pending | _GEN_0);
  wire                          _GEN_2 = snoops_in.valid & _GEN_1 & _GEN;
  wire                          _GEN_3 = _GEN_2 & ~_GEN_0;
  wire                          _GEN_4 = _GEN_2 & _GEN_0 & ~dvm_first_pending;
  wire                          _GEN_5 = _GEN_2 & _GEN_0 & dvm_first_pending;
  wire                          _GEN_6 = _GEN_5 & ~reset;
  wire                          _GEN_7 = ~_GEN_6;
  `ifndef SYNTHESIS
    clean_snoop_dvm_source_consistent:
      assert property (@(posedge clock) disable iff (_GEN_7)
                         snoops_in.bits.src_id == dvm_source_id);
  `endif // not def SYNTHESIS
  wire                          _GEN_8 = ~_GEN_6;
  `ifndef SYNTHESIS
    clean_snoop_dvm_txn_id_consistent:
      assert property (@(posedge clock) disable iff (_GEN_8)
                         snoops_in.bits.txn_id == dvm_txn_id);
  `endif // not def SYNTHESIS
  wire [63:0]                   _GEN_9 =
    {20'h0, _GEN_3 ? snoops_in.bits.address : request.address, 3'h0};
  wire                          _GEN_10 =
    active_state & uses_lookup & ~lookup_complete & lookup_result_in.valid;
  wire                          _GEN_11 =
    |{request.opcode == 5'h1,
      request.opcode == 5'h2,
      request.opcode == 5'h4,
      request.opcode == 5'h8};
  wire                          _GEN_12 =
    (|{request.opcode == 5'h5,
       request.opcode == 5'h6,
       request.opcode == 5'h7,
       request.opcode == 5'h9,
       request.opcode == 5'hA,
       request.opcode == 5'h15,
       request.opcode == 5'h11,
       request.opcode == 5'h12,
       request.opcode == 5'h13,
       request.opcode == 5'h14,
       request.opcode == 5'h16,
       request.opcode == 5'h17}) | request.ret_to_src;
  wire                          _GEN_13 = active_state & (~uses_lookup | lookup_complete);
  wire CHIRspFlit               _GEN_14 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: (12'h0),
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp:
        {1'h0, ~(uses_lookup & line_hit) | _GEN_12 ? 2'h0 : _GEN_11 ? 2'h1 : line_state},
      resp_err: (2'h0),
      opcode: (5'h1),
      txn_id: request.txn_id,
      src_id: node_id,
      tgt_id: request.src_id,
      qos: (4'h0)};
  wire                          _GEN_15 = _GEN_13 & responses_in.ready;
  wire RV5StageCleanSnoopUpdate _GEN_16 =
    '{address: {20'h0, request.address, 3'h0}, invalidate: _GEN_12, state: (2'h1)};
  wire                          _GEN_17 = _GEN_3 | _GEN_5;
  wire                          _GEN_18 = _GEN_10 | ~_GEN_15;
  always @(posedge clock) begin
    if (reset) begin
      active_state <= 1'h0;
      uses_lookup <= 1'h0;
      lookup_complete <= 1'h0;
      line_hit <= 1'h0;
      line_state <= 2'h0;
      dvm_first_pending <= 1'h0;
      dvm_source_id <= 7'h0;
      dvm_txn_id <= 12'h0;
    end
    else begin
      active_state <= _GEN_17 | _GEN_18 & active_state;
      uses_lookup <= _GEN_17 ? _GEN_3 : _GEN_18 & uses_lookup;
      lookup_complete <= ~_GEN_17 & (_GEN_10 | ~_GEN_15 & lookup_complete);
      line_hit <= ~_GEN_17 & (_GEN_10 ? lookup_result_in.bits.hit : line_hit);
      line_state <= _GEN_17 ? 2'h0 : _GEN_10 ? lookup_result_in.bits.state : line_state;
      dvm_first_pending <= _GEN_4 | ~_GEN_5 & dvm_first_pending;
      dvm_source_id <= _GEN_4 ? snoops_in.bits.src_id : dvm_source_id;
      dvm_txn_id <= _GEN_4 ? snoops_in.bits.txn_id : dvm_txn_id;
    end
  end // always @(posedge)
  always @(posedge clock)
    request <= _GEN_17 ? snoops_in.bits : request;
  assign pending = snoops_in.valid & _GEN | active_state | dvm_first_pending;
  assign address = _GEN_9;
  assign snoops_out = '{ready: _GEN_1};
  assign responses_out = '{valid: _GEN_13, bits: _GEN_14};
  assign lookup_out = '{valid: _GEN_3, bits: _GEN_9};
  assign update_out =
    '{valid: (_GEN_15 & uses_lookup & line_hit & (_GEN_12 | _GEN_11)), bits: _GEN_16};
endmodule

module Pipe_2(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; logic [63:0] bits; } ingress_in,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_out,
  output struct packed {logic valid; logic [63:0] bits; } egress_out
);

  reg  [0:0]       stage_valid;
  reg  [0:0][63:0] stage_bits;
  wire             _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire             _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire [63:0]      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module Arbiter_1(
  input  struct packed {logic valid; RV5StageInstructionResp bits; } ingress_0_in,
                                                                     ingress_1_in,
  input  struct packed {logic ready; }                               egress_in,
  output struct packed {logic ready; }                               ingress_0_out,
                                                                     ingress_1_out,
  output struct packed {logic valid; RV5StageInstructionResp bits; } egress_out,
  output                                                             chosen
);

  wire [1:0]                   _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0]                   _GEN_0 = _GEN & {~(_GEN[0]), 1'h1};
  wire [33:0]                  _GEN_1 = /*cast(bit[33:0])*/ingress_0_in.bits;
  wire [33:0]                  _GEN_2 = /*cast(bit[33:0])*/ingress_1_in.bits;
  wire RV5StageInstructionResp _GEN_3 =
    /*cast(bit)*/_GEN_1 & {34{_GEN_0[0]}} | _GEN_2 & {34{_GEN_0[1]}} | _GEN_1
    & {34{_GEN_0 == 2'h0}};
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_0[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_0[1])};
  assign egress_out = '{valid: (|_GEN_0), bits: _GEN_3};
  assign chosen = _GEN_0[1];
endmodule

module Queue_2(
  input                                                              clock,
                                                                     reset,
  input  struct packed {logic valid; RV5StageInstructionResp bits; } ingress_in,
  input  struct packed {logic ready; }                               egress_in,
  output struct packed {logic ready; }                               ingress_out,
  output struct packed {logic valid; RV5StageInstructionResp bits; } egress_out,
  output [1:0]                                                       count
);

  wire RV5StageInstructionResp _GEN;
  wire                         _GEN_0;
  wire                         _write_pointer_value;
