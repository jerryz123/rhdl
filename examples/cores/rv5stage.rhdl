      line_address <= _GEN_2 ? command_in.bits.line_address : line_address;
      opcode <= _GEN_2 ? command_in.bits.opcode : opcode;
      line <= _GEN_2 ? 512'h0 : _GEN_22 ? _GEN_42 : line;
      home_id <= _GEN_2 ? 7'h1 : home_id;
      dbid <= _GEN_2 ? 12'h0 : _GEN_43 ? response_data_in.bits.dbid_or_mecid[11:0] : dbid;
      response_state <= _GEN_2 ? 2'h0 : _GEN_43 ? _GEN_11.state : response_state;
      pass_dirty <= ~_GEN_2 & (_GEN_43 ? _GEN_11.pass_dirty : pass_dirty);
    end
  end // always @(posedge)
  always @(posedge clock)
    context_0 <= _GEN_2 ? command_in.bits.context_0 : context_0;
  assign command_out = '{ready: (~_control_active)};
  assign completion_out = '{valid: _GEN_39, bits: _GEN_41};
  assign requests_out = '{valid: _control_attempt_out.valid, bits: _GEN};
  assign acknowledgements_out = '{valid: _GEN_37, bits: _GEN_38};
  assign response_data_out = '{ready: _GEN_21};
