module RV5StageDataSnoop(
  input                                                                    clock,
                                                                           reset,
  input  [6:0]                                                             node_id,
  input                                                                    cache_ready,
  input  struct packed {logic valid; CHISnpFlit bits; }                    snoops_in,
  input  struct packed {logic ready; }                                     responses_in,
                                                                           data_in,
  input  struct packed {logic valid; RV5StageDataSnoopLookupResult bits; } lookup_result_in,
  output                                                                   pending,
  output [63:0]                                                            address,
  output struct packed {logic ready; }                                     snoops_out,
  output struct packed {logic valid; CHIRspFlit bits; }                    responses_out,
  output struct packed {logic valid; CHIDatFlit bits; }                    data_out,
  output struct packed {logic valid; logic [63:0] bits; }                  lookup_out,
  output struct packed {logic valid; RV5StageDataSnoopUpdate bits; }       update_out
);

  reg                          active_state;
  reg                          uses_lookup;
  CHISnpFlit                   request;
  reg                          lookup_complete;
  reg                          line_hit;
  reg  [2:0]                   line_state;
  reg  [7:0][63:0]             line;
  reg  [1:0]                   packet_index;
  reg                          dvm_first_pending;
  reg  [6:0]                   dvm_source_id;
  reg  [11:0]                  dvm_txn_id;
  wire                         _GEN = |snoops_in.bits.opcode;
  wire                         _GEN_0 = snoops_in.bits.opcode == 5'hD;
  wire                         _GEN_1 =
    ~_GEN | ~active_state & cache_ready & (~dvm_first_pending | _GEN_0);
  wire                         _GEN_2 = snoops_in.valid & _GEN_1 & _GEN;
  wire                         _GEN_3 = _GEN_2 & ~_GEN_0;
  wire                         _GEN_4 = _GEN_2 & _GEN_0 & ~dvm_first_pending;
  wire                         _GEN_5 = _GEN_2 & _GEN_0 & dvm_first_pending;
  wire [63:0]                  _GEN_6 =
    {20'h0, _GEN_3 ? snoops_in.bits.address : request.address, 3'h0};
  wire                         _GEN_7 =
    active_state & uses_lookup & ~lookup_complete & lookup_result_in.valid;
  wire                         _GEN_8 = line_state == 3'h3;
  wire                         _GEN_9 =
    uses_lookup & line_hit & (|{_GEN_8, line_state == 3'h4, line_state == 3'h6});
  wire                         _GEN_10 =
    |{request.opcode == 5'h1,
      request.opcode == 5'h2,
      request.opcode == 5'h4,
      request.opcode == 5'h8};
  wire                         _GEN_11 =
    (|{request.opcode == 5'h5,
       request.opcode == 5'h6,
       request.opcode == 5'h7,
       request.opcode == 5'h9,
       request.opcode == 5'hA,
       request.opcode == 5'h15,
       request.opcode == 5'h11,
       request.opcode == 5'h12,
       request.opcode == 5'h13,
       request.opcode == 5'h14,
       request.opcode == 5'h16,
       request.opcode == 5'h17}) | request.ret_to_src;
  wire                         _GEN_12 =
    active_state & (~uses_lookup | lookup_complete) & ~_GEN_9;
  wire CHIRspFlit              _GEN_13 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: (12'h0),
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp:
        {1'h0,
         ~(uses_lookup & line_hit) | _GEN_11
           ? 2'h0
           : _GEN_10 | (|{line_state == 3'h1, _GEN_8}) ? 2'h1 : 2'h2},
      resp_err: (2'h0),
      opcode: (5'h1),
      txn_id: request.txn_id,
      src_id: node_id,
      tgt_id: request.src_id,
      qos: (4'h0)};
  wire [3:0][127:0]            _GEN_14 = /*cast(bit[3:0][127:0])*/line;
  wire                         _GEN_15 = &packet_index;
  wire [3:0][1:0]              _GEN_16 = {{{2{_GEN_15}}}, {2'h2}, {2'h1}, {2'h0}};
  wire [1:0]                   _GEN_17 = _GEN_16[packet_index];
  wire                         _GEN_18 = active_state & lookup_complete & _GEN_9;
  wire                         _GEN_19 = _GEN_18 & data_in.ready;
  wire                         _GEN_20 = _GEN_12 & responses_in.ready | _GEN_19 & _GEN_15;
  wire RV5StageDataSnoopUpdate _GEN_21 =
    '{address: {20'h0, request.address, 3'h0},
      invalidate: (_GEN_9 | _GEN_11),
      state: (3'h1)};
  wire                         _GEN_22 = _GEN_3 | _GEN_5;
  wire                         _GEN_23 = _GEN_19 & ~_GEN_15;
  wire                         _GEN_24 = _GEN_7 | _GEN_23 | ~_GEN_20;
  wire CHIDatFlit              _GEN_25 =
    '{data: _GEN_14[packet_index],
      byte_enable: (16'hFFFF),
      replicate: (1'h0),
      num_dat: (2'h0),
      cah: (1'h0),
      trace_tag: request.trace_tag,
      tag_update: (1'h0),
      tag: (4'h0),
      tag_op: (2'h0),
      cache_line_id: (6'h0),
      data_id: _GEN_17,
      ccid: _GEN_17,
      dbid_or_mecid: (16'h0),
      c_busy: (3'h0),
      data_pull: (1'h0),
      data_source_or_fwd_state: (8'h0),
      resp: (3'h4),
      resp_err: (2'h0),
