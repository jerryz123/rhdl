  input  [63:0]                                                interrupt_pc,
  input  struct packed {logic valid; RV5StageCsrCommit bits; } commit_in,
  input  struct packed {logic valid; logic [4:0] bits; }       fp_update_in,
  output struct packed {logic valid; logic [63:0] bits; }      redirect_out,
