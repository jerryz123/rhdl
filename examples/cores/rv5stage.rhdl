                                                                      : _GEN_25
                                                                          ? state.mideleg
                                                                          : _GEN_26
                                                                              ? state.mie
                                                                              : _GEN_27
                                                                                  ? state.mtvec
                                                                                  : _GEN_28
                                                                                      ? state.mcounteren
                                                                                      : _GEN_29
                                                                                          ? 64'h0
                                                                                          : _GEN_30
                                                                                              ? state.mscratch
                                                                                              : _GEN_31
                                                                                                  ? state.mepc
                                                                                                  : _GEN_32
                                                                                                      ? state.mcause
                                                                                                      : _GEN_33
                                                                                                          ? state.mtval
                                                                                                          : _GEN_34
                                                                                                              ? _GEN_1
                                                                                                              : _GEN_35
                                                                                                                  ? _counters_cycle
                                                                                                                  : _GEN_36
                                                                                                                      ? _counters_instret
                                                                                                                      : _GEN_37
                                                                                                                        | _GEN_38
                                                                                                                          ? 64'h0
                                                                                                                          : _GEN_16
                                                                                                                              ? _counters_cycle
                                                                                                                              : _GEN_17
                                                                                                                                  ? time_counter
                                                                                                                                  : _GEN_18
                                                                                                                                      ? _counters_instret
