  always @(posedge clock)
    fault_address <=
      _GEN_40 ? fault_address : _walker_completion_out.bits.virtual_address;
  assign instruction_out = '{request: _GEN_56, response: _GEN_57};
  assign data_out =
    '{request: _GEN_54,
      request_fault: (data_in.request.valid & _GEN_18),
      request_access_fault:
        (data_in.request.valid & ~_GEN_18
         & (_GEN_19 | ~walk_active & data_memory_in.request_access_fault)),
      response: _GEN_55,
      drained: (~walk_active & ~fault_valid & data_memory_in.drained)};
  assign instruction_memory_out =
    '{flush: instruction_in.flush,
      invalidate_all: instruction_in.invalidate_all,
      request: _GEN_52,
      response: _GEN_53};
  assign data_memory_out = '{request: _GEN_50};
