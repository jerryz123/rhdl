    .egress_in     (chi_in.requests),
    .ingress_0_out (_protocol_requests_ingress_0_out),
    .ingress_1_out (_protocol_requests_ingress_1_out),
    .egress_out    (_protocol_requests_egress_out),
    .chosen        (/* unused */)
  );
  Arbiter_2 protocol_responses (
    .ingress_0_in  (_refill_acknowledgements_out),
    .ingress_1_in  (_snoop_responses_out),
    .egress_in     (chi_in.requester_responses),
    .ingress_0_out (_protocol_responses_ingress_0_out),
    .ingress_1_out (_protocol_responses_ingress_1_out),
    .egress_out    (_protocol_responses_egress_out),
    .chosen        (/* unused */)
  );
  Arbiter_4 protocol_data (
    .ingress_0_in  (_writeback_data_out),
    .ingress_1_in  (_snoop_data_out),
    .egress_in     (chi_in.request_data),
    .ingress_0_out (_protocol_data_ingress_0_out),
    .ingress_1_out (_protocol_data_ingress_1_out),
    .egress_out    (_protocol_data_egress_out),
    .chosen        (/* unused */)
  );
  Arbiter_5 refill_commands (
    .ingress_0_in  (_GEN_61),
    .ingress_1_in  (_GEN_60),
    .egress_in     (_refill_command_out),
    .ingress_0_out (_refill_commands_ingress_0_out),
    .ingress_1_out (_refill_commands_ingress_1_out),
    .egress_out    (_refill_commands_egress_out),
    .chosen        (/* unused */)
  );
  always @(posedge clock) begin
    if (reset) begin
      valid_lines <=
        '{1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
