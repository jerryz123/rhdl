module Pipe_3(
  input                                                    clock,
                                                           reset,
  input  struct packed {logic valid; RicketDataReq bits; } ingress_in,
  input  struct packed {logic ready; }                     egress_in,
  output struct packed {logic ready; }                     ingress_out,
  output struct packed {logic valid; RicketDataReq bits; } egress_out
);

  reg  [0:0]              stage_valid;
  RicketDataReq[0:0]      stage_bits;
  wire                    _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire                    _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire RicketDataReq      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module ValidPipe_2(
  input                                                     clock,
                                                            reset,
  input  struct packed {logic valid; RicketDataResp bits; } ingress_in,
  output struct packed {logic valid; RicketDataResp bits; } egress_out
);

  reg  [0:0]               stage_valid;
  RicketDataResp[0:0]      stage_bits;
  wire RicketDataResp      _GEN = ingress_in.valid ? ingress_in.bits : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= ingress_in.valid;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN;
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module Arbiter_3(
  input  struct packed {logic valid; CHIReqFlit bits; } ingress_0_in,
                                                        ingress_1_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
  output struct packed {logic valid; CHIReqFlit bits; } egress_out,
  output                                                chosen
);

  wire [1:0] _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0] _GEN_0 = _GEN & {~(_GEN[0]), 1'h1};
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_0[1'h0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_0[1'h1])};
  assign egress_out =
    '{valid: (|_GEN),
      bits:
        (ingress_0_in.valid
           ? ingress_0_in.bits
           : ingress_1_in.valid ? ingress_1_in.bits : ingress_0_in.bits)};
  assign chosen = _GEN[1] & ~(_GEN[0]);
endmodule
