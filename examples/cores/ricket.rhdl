module RicketInstructionDecoder(
  input  [31:0]        instruction,
  output               valid,
  output RicketControl control
);

  wire              _GEN =
    ~(instruction[2]) & instruction[4] & instruction[13] & ~(instruction[14]);
  wire              _GEN_0 = ~(instruction[2]) & instruction[5] & instruction[25];
  wire              _GEN_1 =
    ~(instruction[2]) & instruction[4] & instruction[12] & ~(instruction[13]);
  wire              _GEN_2 = instruction[2] & ~(instruction[3]) & ~(instruction[5]);
  wire              _GEN_3 =
    ~(instruction[2]) & instruction[4] & instruction[5] & ~(instruction[6]);
  wire              _GEN_4 = instruction[2] & ~(instruction[3]) & ~(instruction[4]);
  wire              _GEN_5 = ~(instruction[2]) & ~(instruction[4]) & ~(instruction[5]);
  wire              _GEN_6 = ~(instruction[4]) & instruction[5] & ~(instruction[6]);
  wire              _GEN_7 = instruction[2] & instruction[4] & instruction[5];
  wire              _GEN_8 = ~(instruction[2]) & ~(instruction[4]) & instruction[6];
  wire              _GEN_9 = instruction[3] & instruction[6];
  wire              _GEN_10 = ~(instruction[2]) & ~(instruction[5]);
  wire              _GEN_11 =
    instruction[0] & instruction[1] & ~(instruction[2]) & ~(instruction[3])
    & instruction[5] & ~(instruction[7]) & ~(instruction[8]) & ~(instruction[9])
    & ~(instruction[10]) & ~(instruction[11]) & ~(instruction[12]) & ~(instruction[13])
    & ~(instruction[14]) & ~(instruction[15]) & ~(instruction[16]) & ~(instruction[17])
    & ~(instruction[18]) & ~(instruction[19]) & ~(instruction[21]) & ~(instruction[22])
    & ~(instruction[23]) & ~(instruction[24]) & ~(instruction[25]) & ~(instruction[26])
    & ~(instruction[27]) & ~(instruction[28]) & ~(instruction[29]) & ~(instruction[30])
    & ~(instruction[31]) | instruction[0] & instruction[1] & ~(instruction[2])
    & instruction[4] & ~(instruction[6]) & instruction[12] & ~(instruction[13])
    & instruction[14] & ~(instruction[25]) & ~(instruction[26]) & ~(instruction[27])
    & ~(instruction[28]) & ~(instruction[29]) & ~(instruction[31]) | instruction[0]
    & instruction[1] & ~(instruction[2]) & instruction[4] & ~(instruction[6])
    & instruction[12] & ~(instruction[13]) & ~(instruction[25]) & ~(instruction[26])
    & ~(instruction[27]) & ~(instruction[28]) & ~(instruction[29]) & ~(instruction[30])
    & ~(instruction[31]) | instruction[0] & instruction[1] & ~(instruction[2])
    & instruction[4] & ~(instruction[6]) & ~(instruction[12]) & ~(instruction[13])
    & ~(instruction[14]) & ~(instruction[25]) & ~(instruction[26]) & ~(instruction[27])
    & ~(instruction[28]) & ~(instruction[29]) & ~(instruction[31]) | instruction[0]
    & instruction[1] & ~(instruction[2]) & instruction[4] & ~(instruction[6])
    & ~(instruction[12]) & ~(instruction[13]) & ~(instruction[14]) & ~(instruction[26])
    & ~(instruction[27]) & ~(instruction[28]) & ~(instruction[29]) & ~(instruction[30])
    & ~(instruction[31]) | instruction[0] & instruction[1] & ~(instruction[3])
    & instruction[4] & ~(instruction[5]) & ~(instruction[6]) & instruction[14]
    & ~(instruction[26]) & ~(instruction[27]) & ~(instruction[28]) & ~(instruction[29])
    & ~(instruction[31]) | instruction[0] & instruction[1] & ~(instruction[3])
    & instruction[4] & ~(instruction[6]) & ~(instruction[25]) & ~(instruction[26])
    & ~(instruction[27]) & ~(instruction[28]) & ~(instruction[29]) & ~(instruction[30])
    & ~(instruction[31]) | instruction[0] & instruction[1] & ~(instruction[2])
    & ~(instruction[3]) & ~(instruction[6]) & ~(instruction[14]) & ~(instruction[26])
    & ~(instruction[27]) & ~(instruction[28]) & ~(instruction[29]) & ~(instruction[30])
    & ~(instruction[31]) | instruction[0] & instruction[1] & instruction[2]
    & instruction[3] & ~(instruction[4]) & ~(instruction[5]) & ~(instruction[6])
    & ~(instruction[12]) & ~(instruction[13]) & ~(instruction[14]) | instruction[0]
    & instruction[1] & ~(instruction[3]) & ~(instruction[4]) & instruction[5]
    & instruction[6] & ~(instruction[12]) & ~(instruction[13]) & ~(instruction[14])
    | instruction[0] & instruction[1] & instruction[2] & instruction[3]
    & ~(instruction[4]) & instruction[5] & instruction[6] | instruction[0]
    & instruction[1] & ~(instruction[2]) & ~(instruction[3]) & ~(instruction[4])
    & instruction[5] & instruction[6] & instruction[14] | instruction[0] & instruction[1]
    & ~(instruction[2]) & instruction[4] & ~(instruction[5]) & ~(instruction[6])
    & ~(instruction[12]) & ~(instruction[13]) & ~(instruction[14]) | instruction[0]
    & instruction[1] & ~(instruction[2]) & ~(instruction[3]) & ~(instruction[4])
    & instruction[5] & instruction[6] & ~(instruction[13]) | instruction[0]
    & instruction[1] & ~(instruction[2]) & ~(instruction[3]) & ~(instruction[4])
    & ~(instruction[5]) & ~(instruction[6]) & ~(instruction[13]) | instruction[0]
    & instruction[1] & ~(instruction[3]) & instruction[4] & ~(instruction[5])
    & ~(instruction[6]) & instruction[13] | instruction[0] & instruction[1]
    & ~(instruction[2]) & ~(instruction[3]) & ~(instruction[5]) & ~(instruction[6])
    & ~(instruction[12]) | instruction[0] & instruction[1] & ~(instruction[2])
    & ~(instruction[3]) & ~(instruction[4]) & ~(instruction[6]) & ~(instruction[14])
    | instruction[0] & instruction[1] & instruction[2] & ~(instruction[3])
    & instruction[4] & ~(instruction[6]);
  wire DecodeResult _GEN_12 =
    /*cast(bit)*/{_GEN_11,
                  ~(instruction[2]) & instruction[12] & instruction[13] & instruction[14],
                  ~(instruction[2]) & instruction[4] & ~(instruction[12])
                    & instruction[13] & instruction[14],
                  ~(instruction[2]) & instruction[4] & ~(instruction[12])
                    & ~(instruction[13]) & instruction[14],
                  _GEN,
                  _GEN_1,
                  ~(instruction[12]) & ~(instruction[13]) & ~(instruction[14]) | _GEN_2
                    | _GEN_5 | _GEN_6 | _GEN_7,
                  ~(instruction[2]) & instruction[4] & instruction[5] & instruction[30],
                  ~(instruction[13]) & instruction[30] | ~(instruction[12]),
                  instruction[14],
                  instruction[3],
                  _GEN_3 | _GEN_4 | _GEN_6 | _GEN_8 | _GEN_10,
                  _GEN_3 | _GEN_6 | _GEN_8,
                  _GEN_7,
                  _GEN_2,
                  _GEN_2 | _GEN_6 | _GEN_7 | _GEN_10,
                  _GEN_2 | _GEN_7 | _GEN_9,
                  _GEN_6 | _GEN_8,
                  _GEN_4 | _GEN_8 | _GEN_9 | _GEN_10,
                  _GEN_4 | _GEN_8 | _GEN_9,
                  _GEN_4 | _GEN_9,
                  ~(instruction[14]),
                  ~(instruction[13]),
                  instruction[12],
                  _GEN_4,
                  _GEN_6,
                  _GEN_5,
                  instruction[13:12],
                  instruction[14],
                  ~(instruction[12]) | _GEN_1,
                  _GEN_1,
                  _GEN | _GEN_1,
                  instruction[3],
                  _GEN_2 | _GEN_3 | _GEN_4 | _GEN_7 | _GEN_9 | _GEN_10,
                  _GEN_0 | _GEN_4 | _GEN_9,
                  _GEN_0 | _GEN_5,
                  instruction[4] & instruction[6]};
  assign valid = _GEN_12.valid;
  assign control = _GEN_12.value;
endmodule

