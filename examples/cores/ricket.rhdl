module Queue(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; logic [63:0] bits; } ingress_in,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_out,
  output struct packed {logic valid; logic [63:0] bits; } egress_out,
  output [1:0]                                            count
);

  wire [63:0] _GEN;
  wire        _GEN_0;
  wire        _write_pointer_value;
  wire        _read_pointer_value;
  wire        _GEN_1 = 1'h0;
  reg  [63:0] storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]  occupancy;
  wire        _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire        _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire        _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module Counter(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule

module Pipe_1(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; FetchDecode bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; FetchDecode bits; } egress_out
);

  reg  [0:0]            stage_valid;
  FetchDecode[0:0]      stage_bits;
  wire                  _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire                  _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire FetchDecode      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module AtomicFork(
  input  struct packed {logic valid; DecodeExecute bits; } ingress_in,
  input  struct packed {logic ready; }                     egress_0_in,
                                                           egress_1_in,
                                                           egress_2_in,
                                                           egress_3_in,
                                                           egress_4_in,
  output struct packed {logic ready; }                     ingress_out,
  output struct packed {logic valid; DecodeExecute bits; } egress_0_out,
                                                           egress_1_out,
                                                           egress_2_out,
                                                           egress_3_out,
                                                           egress_4_out
);

  wire _GEN = egress_0_in.ready & egress_1_in.ready;
  wire _GEN_0 = egress_3_in.ready & egress_4_in.ready;
  wire _GEN_1 = egress_2_in.ready & _GEN_0;
  wire _GEN_2 = _GEN & egress_2_in.ready;
  assign ingress_out = '{ready: (_GEN & _GEN_1)};
  assign egress_0_out =
    '{valid: (ingress_in.valid & _GEN_1 & egress_1_in.ready), bits: ingress_in.bits};
  assign egress_1_out =
    '{valid: (ingress_in.valid & _GEN_1 & egress_0_in.ready), bits: ingress_in.bits};
  assign egress_2_out =
    '{valid: (ingress_in.valid & _GEN & _GEN_0), bits: ingress_in.bits};
  assign egress_3_out =
    '{valid: (ingress_in.valid & _GEN_2 & egress_4_in.ready), bits: ingress_in.bits};
  assign egress_4_out =
    '{valid: (ingress_in.valid & _GEN_2 & egress_3_in.ready), bits: ingress_in.bits};
endmodule

module Arbiter(
  input  struct packed {logic valid; RegisterFileWrite bits; } ingress_0_in,
                                                               ingress_1_in,
                                                               ingress_2_in,
  input  struct packed {logic ready; }                         egress_in,
  output struct packed {logic ready; }                         ingress_0_out,
                                                               ingress_1_out,
                                                               ingress_2_out,
  output struct packed {logic valid; RegisterFileWrite bits; } egress_out,
  output [1:0]                                                 chosen
);

  wire [2:0] _GEN = {{ingress_2_in.valid}, {ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0] _GEN_0 = _GEN[1:0] | {_GEN[0], 1'h0};
  wire [2:0] _GEN_1 = _GEN & {~_GEN_0, 1'h1};
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_1[2'h0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_1[2'h1])};
  assign ingress_2_out = '{ready: (egress_in.ready & _GEN_1[2'h2])};
  assign egress_out =
    '{valid: (|_GEN),
      bits:
        (ingress_0_in.valid
           ? ingress_0_in.bits
           : ingress_1_in.valid
               ? ingress_1_in.bits
               : ingress_2_in.valid ? ingress_2_in.bits : ingress_0_in.bits)};
  assign chosen = _GEN[2:1] & ~_GEN_0;
endmodule

module RicketMmu(
  input                                                                                                                                                                clock,
                                                                                                                                                                       reset,
  input  struct packed {logic flush; logic invalidate_all; struct packed {logic valid; RicketInstructionReq bits; } request; struct packed {logic ready; } response; } instruction_in,
  input  struct packed {struct packed {logic valid; RicketDataReq bits; } request; }                                                                                   data_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; RicketInstructionResp bits; } response; }                                   instruction_memory_in,
  input  struct packed {struct packed {logic ready; } request; logic request_fault; struct packed {logic valid; RicketDataResp bits; } response; logic drained; }      data_memory_in,
  input  [1:0]                                                                                                                                                         privilege,
  input  [63:0]                                                                                                                                                        mstatus,
                                                                                                                                                                       satp,
  input                                                                                                                                                                invalidate_all,
  output struct packed {struct packed {logic ready; } request; struct packed {logic valid; RicketInstructionResp bits; } response; }                                   instruction_out,
  output struct packed {struct packed {logic ready; } request; logic request_fault; struct packed {logic valid; RicketDataResp bits; } response; logic drained; }      data_out,
  output struct packed {logic flush; logic invalidate_all; struct packed {logic valid; RicketInstructionReq bits; } request; struct packed {logic ready; } response; } instruction_memory_out,
  output struct packed {struct packed {logic valid; RicketDataReq bits; } request; }                                                                                   data_memory_out
);

  wire struct packed {logic ready; } _instruction_owners_ingress_out;
  wire struct packed {logic valid; logic bits; } _instruction_owners_egress_out;
  wire struct packed {logic ready; } _walker_request_out;
  wire struct packed {logic valid; RicketTranslationResult bits; } _walker_completion_out;
  wire
    struct packed {struct packed {logic valid; logic [63:0] bits; } request; struct packed {logic ready; } response; }
    _walker_memory_out;
  wire                               _dtlb_hit;
  wire                               _dtlb_fault;
  wire [55:0]                        _dtlb_physical_address;
  wire                               _itlb_hit;
  wire                               _itlb_fault;
  wire [55:0]                        _itlb_physical_address;
  wire RicketInstructionResp         _GEN = '{instruction: 32'h0, page_fault: 1'h1};
  wire                               _GEN_0 = satp[63:60] == 4'h8;
  wire                               _GEN_1 = _GEN_0 & privilege != 2'h3;
  wire [1:0]                         _GEN_2 =
    mstatus[12:11] == 2'h0 ? 2'h0 : {mstatus[12:11] != 2'h1, 1'h1};
  wire                               _GEN_3 = (&privilege) & mstatus[17];
  wire [1:0]                         _GEN_4 = _GEN_3 ? _GEN_2 : privilege;
  wire                               _GEN_5 = _GEN_0 & _GEN_4 != 2'h3;
  wire [1:0]                         _GEN_6 =
    data_in.request.bits.access == 3'h2 | data_in.request.bits.access == 3'h4
    | data_in.request.bits.access == 3'h5
      ? 2'h2
      : 2'h1;
  reg                                walk_active;
  reg                                walk_is_data;
  reg                                fault_valid;
  reg                                fault_is_data;
  reg  [63:0]                        fault_address;
  reg                                walker_data_quiet_previous;
  reg                                walker_data_quiet_twice;
  reg                                walker_memory_outstanding;
  wire                               _GEN_7 =
    data_memory_in.drained & ~data_memory_in.response.valid;
  wire                               _GEN_8 = ~walk_active & ~fault_valid;
  wire                               _GEN_9 =
    instruction_in.request.valid & _GEN_1 & ~_itlb_hit;
  wire                               _GEN_10 =
    _GEN_8 & ~_GEN_9 & data_in.request.valid & _GEN_5 & ~_dtlb_hit;
  wire                               _GEN_11 = _GEN_8 & _GEN_9 | _GEN_10;
  wire RicketTranslationRequest      _GEN_12 =
    '{virtual_address:
        (_GEN_10 ? data_in.request.bits.address : instruction_in.request.bits.address),
      root_ppn: (satp[43:0]),
      access: (_GEN_10 ? _GEN_6 : 2'h0),
      privilege: (_GEN_10 & _GEN_3 ? _GEN_2 : privilege),
      sum: (mstatus[18]),
      mxr: (mstatus[19])};
  wire                               _GEN_13 = _GEN_11 & _walker_request_out.ready;
  wire                               _GEN_14 =
    invalidate_all | instruction_in.flush & walk_active & ~walk_is_data;
  wire                               _GEN_15 =
    _walker_completion_out.valid & ~fault_valid;
  wire                               _GEN_16 =
    fault_valid & ~fault_is_data & fault_address == instruction_in.request.bits.address;
  wire                               _GEN_17 =
    _GEN_1 & (_itlb_hit & _itlb_fault | _GEN_16);
  wire                               _GEN_18 =
    _GEN_5
    & (_dtlb_hit & _dtlb_fault | fault_valid & fault_is_data
       & fault_address == data_in.request.bits.address);
  wire                               _GEN_19 = ~_GEN_1 | _itlb_hit | _GEN_16;
  wire                               _GEN_20 =
    _GEN_19 & _instruction_owners_ingress_out.ready
    & (_GEN_17 | instruction_memory_in.request.ready);
  wire                               _GEN_21 =
    _instruction_owners_egress_out.valid
    & (_instruction_owners_egress_out.bits | instruction_memory_in.response.valid);
  wire                               _GEN_22 =
    walk_active & walker_data_quiet_twice & _walker_memory_out.request.valid;
  wire                               _GEN_23 = ~_GEN_5 | _dtlb_hit;
  wire                               _GEN_24 =
    _GEN_18 | ~walk_active & _GEN_23 & data_memory_in.request.ready;
  wire RicketDataReq                 _GEN_25 =
    '{address: _walker_memory_out.request.bits,
      access: (3'h1),
      atomic: (4'h0),
      width: (2'h3),
      unsigned_0: (1'h1),
      data: (64'h0),
      tag: (5'h0)};
  wire RicketDataReq                 _GEN_26 =
    '{address: (_GEN_5 ? {8'h0, _dtlb_physical_address} : data_in.request.bits.address),
      access: data_in.request.bits.access,
      atomic: data_in.request.bits.atomic,
      width: data_in.request.bits.width,
      unsigned_0: data_in.request.bits.unsigned_0,
      data: data_in.request.bits.data,
      tag: data_in.request.bits.tag};
  wire                               _GEN_27 =
    walk_active & walker_data_quiet_twice & data_memory_in.request.ready;
  wire                               _GEN_28 =
    data_memory_in.response.valid & walker_memory_outstanding;
  wire                               _GEN_29 =
    instruction_in.request.valid & _GEN_20 & _GEN_17 | data_in.request.valid & _GEN_24
    & _GEN_18;
  wire                               _GEN_30 =
    _GEN_15 & _walker_completion_out.bits.fault;
  wire                               _GEN_31 = _GEN_14 | _GEN_29 | ~_GEN_30;
  wire struct packed {logic ready; } _GEN_32 =
    '{ready: (instruction_in.response.ready & _GEN_21)};
  wire struct packed {logic valid; logic bits; } _GEN_33 =
    '{valid: (instruction_in.request.valid & _GEN_20), bits: _GEN_17};
  wire struct packed {logic ready; } _GEN_34 = '{ready: _GEN_27};
  wire struct packed {logic valid; logic [63:0] bits; } _GEN_35 =
    '{valid: _GEN_28, bits: data_memory_in.response.bits.data};
  wire
    struct packed {struct packed {logic ready; } request; struct packed {logic valid; logic [63:0] bits; } response; }
    _GEN_36 = '{request: _GEN_34, response: _GEN_35};
  wire struct packed {logic ready; } _GEN_37 = '{ready: (~fault_valid)};
  wire struct packed {logic valid; RicketTranslationRequest bits; } _GEN_38 =
    '{valid: _GEN_11, bits: _GEN_12};
  wire struct packed {logic valid; RicketTranslationResult bits; } _GEN_39 =
    '{valid: (_GEN_15 & walk_is_data), bits: _walker_completion_out.bits};
  wire struct packed {logic valid; RicketTranslationResult bits; } _GEN_40 =
    '{valid: (_GEN_15 & ~walk_is_data), bits: _walker_completion_out.bits};
  wire struct packed {logic valid; RicketDataReq bits; } _GEN_41 =
    '{valid:
        (_GEN_22
           ? _walker_memory_out.request.valid
           : data_in.request.valid & ~walk_active & _GEN_23 & ~_GEN_18),
      bits: (_GEN_22 ? _GEN_25 : _GEN_26)};
  wire RicketInstructionReq          _GEN_42 =
    '{address:
        (_GEN_1 ? {8'h0, _itlb_physical_address} : instruction_in.request.bits.address)};
  wire struct packed {logic valid; RicketInstructionReq bits; } _GEN_43 =
    '{valid:
        (instruction_in.request.valid & _GEN_19 & ~_GEN_17
         & _instruction_owners_ingress_out.ready),
      bits: _GEN_42};
  wire struct packed {logic ready; } _GEN_44 =
    '{ready:
        (instruction_in.response.ready & _instruction_owners_egress_out.valid
         & ~_instruction_owners_egress_out.bits)};
  wire struct packed {logic ready; } _GEN_45 = '{ready: _GEN_24};
  wire struct packed {logic valid; RicketDataResp bits; } _GEN_46 =
    '{valid: (data_memory_in.response.valid & ~walker_memory_outstanding),
      bits: data_memory_in.response.bits};
  wire struct packed {logic ready; } _GEN_47 = '{ready: _GEN_20};
  wire struct packed {logic valid; RicketInstructionResp bits; } _GEN_48 =
    '{valid: _GEN_21,
      bits:
        (_instruction_owners_egress_out.bits
           ? _GEN
           : instruction_memory_in.response.bits)};
  RicketTlb itlb (
    .clock            (clock),
    .reset            (reset),
    .virtual_address  (instruction_in.request.bits.address),
    .access           (2'h0),
    .privilege        (privilege),
    .sum              (mstatus[18]),
    .mxr              (mstatus[19]),
    .enabled          (_GEN_1),
    .invalidate_all   (invalidate_all),
    .fill_in          (_GEN_40),
    .hit              (_itlb_hit),
    .fault            (_itlb_fault),
    .physical_address (_itlb_physical_address)
  );
  RicketTlb dtlb (
    .clock            (clock),
    .reset            (reset),
    .virtual_address  (data_in.request.bits.address),
    .access           (_GEN_6),
    .privilege        (_GEN_4),
    .sum              (mstatus[18]),
    .mxr              (mstatus[19]),
    .enabled          (_GEN_5),
    .invalidate_all   (invalidate_all),
    .fill_in          (_GEN_39),
    .hit              (_dtlb_hit),
    .fault            (_dtlb_fault),
    .physical_address (_dtlb_physical_address)
  );
  RicketPageTableWalker walker (
    .clock          (clock),
    .reset          (reset),
    .request_in     (_GEN_38),
    .completion_in  (_GEN_37),
    .memory_in      (_GEN_36),
    .cancel         (_GEN_14),
    .request_out    (_walker_request_out),
    .completion_out (_walker_completion_out),
    .memory_out     (_walker_memory_out)
  );
  Queue_1 instruction_owners (
    .clock       (clock),
    .reset       (reset | instruction_in.flush),
    .ingress_in  (_GEN_33),
    .egress_in   (_GEN_32),
    .ingress_out (_instruction_owners_ingress_out),
    .egress_out  (_instruction_owners_egress_out),
    .count       (/* unused */)
  );
  always @(posedge clock) begin
    if (reset) begin
      walk_active <= 1'h0;
      walk_is_data <= 1'h0;
      fault_valid <= 1'h0;
      fault_is_data <= 1'h0;
      walker_data_quiet_previous <= 1'h0;
      walker_data_quiet_twice <= 1'h0;
      walker_memory_outstanding <= 1'h0;
    end
    else begin
      walk_active <= ~_GEN_14 & (_GEN_13 | ~_GEN_15 & walk_active);
      walk_is_data <= _GEN_14 | ~_GEN_13 ? walk_is_data : _GEN_10;
      fault_valid <= ~_GEN_14 & ~_GEN_29 & (_GEN_30 | fault_valid);
      fault_is_data <= _GEN_31 ? fault_is_data : walk_is_data;
      walker_data_quiet_previous <=
        ~_GEN_13 & (walk_active ? _GEN_7 : walker_data_quiet_previous);
      walker_data_quiet_twice <=
        ~_GEN_13
        & (walk_active ? _GEN_7 & walker_data_quiet_previous : walker_data_quiet_twice);
      walker_memory_outstanding <=
        ~_GEN_14
        & (_walker_memory_out.request.valid & _GEN_27 | ~_GEN_28
           & walker_memory_outstanding);
    end
  end // always @(posedge)
  always @(posedge clock)
    fault_address <=
      _GEN_31 ? fault_address : _walker_completion_out.bits.virtual_address;
  assign instruction_out = '{request: _GEN_47, response: _GEN_48};
  assign data_out =
    '{request: _GEN_45,
      request_fault: (data_in.request.valid & _GEN_18),
      response: _GEN_46,
      drained: (~walk_active & ~fault_valid & data_memory_in.drained)};
  assign instruction_memory_out =
    '{flush: instruction_in.flush,
      invalidate_all: instruction_in.invalidate_all,
      request: _GEN_43,
      response: _GEN_44};
  assign data_memory_out = '{request: _GEN_41};
endmodule

module RicketTlb(
  input                                                              clock,
                                                                     reset,
  input  [63:0]                                                      virtual_address,
  input  [1:0]                                                       access,
                                                                     privilege,
  input                                                              sum,
                                                                     mxr,
                                                                     enabled,
                                                                     invalidate_all,
  input  struct packed {logic valid; RicketTranslationResult bits; } fill_in,
  output                                                             hit,
                                                                     fault,
  output [55:0]                                                      physical_address
);

  wire RicketTlbEntry[7:0] _GEN =
    '{'{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0},
      '{valid: 1'h0,
        vpn: 27'h0,
        ppn: 44'h0,
        level: 2'h0,
        user: 1'h0,
        read: 1'h0,
        write: 1'h0,
        execute: 1'h0,
        global: 1'h0,
        accessed: 1'h0,
        dirty: 1'h0}};
  RicketTlbEntry[7:0]      entries;
  reg  [2:0]               replacement;
  wire [7:0]               _GEN_0 =
    {{entries[3'h7].valid
        & (entries[3'h7].level == 2'h1
             ? entries[3'h7].vpn[26:9] == virtual_address[38:21]
             : entries[3'h7].level == 2'h2
                 ? entries[3'h7].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h7].vpn == virtual_address[38:12])},
     {entries[3'h6].valid
        & (entries[3'h6].level == 2'h1
             ? entries[3'h6].vpn[26:9] == virtual_address[38:21]
             : entries[3'h6].level == 2'h2
                 ? entries[3'h6].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h6].vpn == virtual_address[38:12])},
     {entries[3'h5].valid
        & (entries[3'h5].level == 2'h1
             ? entries[3'h5].vpn[26:9] == virtual_address[38:21]
             : entries[3'h5].level == 2'h2
                 ? entries[3'h5].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h5].vpn == virtual_address[38:12])},
     {entries[3'h4].valid
        & (entries[3'h4].level == 2'h1
             ? entries[3'h4].vpn[26:9] == virtual_address[38:21]
             : entries[3'h4].level == 2'h2
                 ? entries[3'h4].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h4].vpn == virtual_address[38:12])},
     {entries[3'h3].valid
        & (entries[3'h3].level == 2'h1
             ? entries[3'h3].vpn[26:9] == virtual_address[38:21]
             : entries[3'h3].level == 2'h2
                 ? entries[3'h3].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h3].vpn == virtual_address[38:12])},
     {entries[3'h2].valid
        & (entries[3'h2].level == 2'h1
             ? entries[3'h2].vpn[26:9] == virtual_address[38:21]
             : entries[3'h2].level == 2'h2
                 ? entries[3'h2].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h2].vpn == virtual_address[38:12])},
     {entries[3'h1].valid
        & (entries[3'h1].level == 2'h1
             ? entries[3'h1].vpn[26:9] == virtual_address[38:21]
             : entries[3'h1].level == 2'h2
                 ? entries[3'h1].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h1].vpn == virtual_address[38:12])},
     {entries[3'h0].valid
        & (entries[3'h0].level == 2'h1
             ? entries[3'h0].vpn[26:9] == virtual_address[38:21]
             : entries[3'h0].level == 2'h2
                 ? entries[3'h0].vpn[26:18] == virtual_address[38:30]
                 : entries[3'h0].vpn == virtual_address[38:12])}};
  wire [6:0]               _GEN_1 = _GEN_0[6:0] | {_GEN_0[5:0], 1'h0};
  wire [6:0]               _GEN_2 = _GEN_1 | {_GEN_1[4:0], 2'h0};
  wire [6:0]               _GEN_3 = _GEN_0[7:1] & ~(_GEN_2 | {_GEN_2[2:0], 4'h0});
  wire RicketTlbEntry      _GEN_4 =
    entries[{|(_GEN_3[6:3]),
             |{_GEN_3[6:5], _GEN_3[2:1]},
             |{_GEN_3[6], _GEN_3[4], _GEN_3[2], _GEN_3[0]}}];
  wire                     _GEN_5 =
    enabled & virtual_address[63:39] == {25{virtual_address[38]}} & (|_GEN_0);
  wire                     _GEN_6 = fill_in.valid & ~fill_in.bits.fault;
  wire RicketTlbEntry      _GEN_7 =
    '{valid: (1'h1),
      vpn: (fill_in.bits.virtual_address[38:12]),
      ppn: fill_in.bits.ppn,
      level: fill_in.bits.level,
      user: fill_in.bits.user,
      read: fill_in.bits.read,
      write: fill_in.bits.write,
      execute: fill_in.bits.execute,
      global: fill_in.bits.global,
      accessed: fill_in.bits.accessed,
      dirty: fill_in.bits.dirty};
  always @(posedge clock) begin
    if (reset) begin
      entries <= _GEN;
      replacement <= 3'h0;
    end
    else begin
      entries <=
        invalidate_all
          ? _GEN
          : _GEN_6
              ? {{(&replacement) ? _GEN_7 : entries[3'h7]},
                 {replacement == 3'h6 ? _GEN_7 : entries[3'h6]},
                 {replacement == 3'h5 ? _GEN_7 : entries[3'h5]},
                 {replacement == 3'h4 ? _GEN_7 : entries[3'h4]},
                 {replacement == 3'h3 ? _GEN_7 : entries[3'h3]},
                 {replacement == 3'h2 ? _GEN_7 : entries[3'h2]},
                 {replacement == 3'h1 ? _GEN_7 : entries[3'h1]},
                 {replacement == 3'h0 ? _GEN_7 : entries[3'h0]}}
              : entries;
      replacement <= invalidate_all ? 3'h0 : _GEN_6 ? replacement + 3'h1 : replacement;
    end
  end // always @(posedge)
  assign hit = ~enabled | _GEN_5;
  assign fault =
    _GEN_5
    & ~((privilege == 2'h0
           ? _GEN_4.user
           : ~_GEN_4.user | privilege == 2'h1 & sum & (|access))
        & (access == 2'h0
             ? _GEN_4.execute
             : access == 2'h1
                 ? _GEN_4.read | mxr & _GEN_4.execute
                 : _GEN_4.write & _GEN_4.dirty) & _GEN_4.accessed);
  assign physical_address =
    enabled
      ? (_GEN_4.level == 2'h0
           ? {_GEN_4.ppn, virtual_address[11:0]}
           : _GEN_4.level == 2'h1
               ? {_GEN_4.ppn[43:9], virtual_address[20:0]}
               : {_GEN_4.ppn[43:18], virtual_address[29:0]})
      : virtual_address[55:0];
endmodule

module RicketPageTableWalker(
  input                                                                                                                     clock,
                                                                                                                            reset,
  input  struct packed {logic valid; RicketTranslationRequest bits; }                                                       request_in,
  input  struct packed {logic ready; }                                                                                      completion_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; logic [63:0] bits; } response; } memory_in,
  input                                                                                                                     cancel,
  output struct packed {logic ready; }                                                                                      request_out,
  output struct packed {logic valid; RicketTranslationResult bits; }                                                        completion_out,
  output struct packed {struct packed {logic valid; logic [63:0] bits; } request; struct packed {logic ready; } response; } memory_out
);

  reg  [1:0]                         state;
  RicketTranslationRequest           operation;
  reg  [1:0]                         level;
  reg  [43:0]                        table_ppn;
  reg                                global_mapping;
  RicketTranslationResult            result;
  wire                               _GEN = state == 2'h0;
  wire                               _GEN_0 = request_in.valid & _GEN;
  wire                               _GEN_1 = level == 2'h1;
  wire                               _GEN_2 = level == 2'h0;
  wire                               _GEN_3 = state == 2'h1;
  wire                               _GEN_4 = _GEN_3 & memory_in.request.ready;
  wire                               _GEN_5 = state == 2'h2;
  wire                               _GEN_6 = memory_in.response.valid & _GEN_5;
  wire                               _GEN_7 =
    memory_in.response.bits[1] | memory_in.response.bits[3];
  wire                               _GEN_8 =
    ~(memory_in.response.bits[0]
      & ~(memory_in.response.bits[2] & ~(memory_in.response.bits[1]))
      & memory_in.response.bits[63:54] == 10'h0) | _GEN_7
    & ~(_GEN_2
        | (_GEN_1
             ? memory_in.response.bits[18:10] == 9'h0
             : memory_in.response.bits[27:10] == 18'h0)) | ~_GEN_7
    & (_GEN_2 | memory_in.response.bits[7] | memory_in.response.bits[6]
       | memory_in.response.bits[4]);
  wire                               _GEN_9 = _GEN_8 | _GEN_7;
  wire                               _GEN_10 = &state;
  wire [24:0]                        _GEN_11 = {25{request_in.bits.virtual_address[38]}};
  wire                               _GEN_12 =
    request_in.bits.virtual_address[63:39] == _GEN_11;
  wire                               _GEN_13 =
    request_in.bits.virtual_address[63:39] != _GEN_11;
  wire RicketTranslationResult       _GEN_14 =
    '{virtual_address: request_in.bits.virtual_address,
      physical_address: (56'h0),
      ppn: (44'h0),
      level: (2'h0),
      user: (1'h0),
      read: (1'h0),
      write: (1'h0),
      execute: (1'h0),
      global: (1'h0),
      accessed: (1'h0),
      dirty: (1'h0),
      fault: (1'h1)};
  wire RicketTranslationResult       _GEN_15 =
    '{virtual_address: operation.virtual_address,
      physical_address:
        (_GEN_2
           ? {memory_in.response.bits[53:10], operation.virtual_address[11:0]}
           : _GEN_1
               ? {memory_in.response.bits[53:19], operation.virtual_address[20:0]}
               : {memory_in.response.bits[53:28], operation.virtual_address[29:0]}),
      ppn: (memory_in.response.bits[53:10]),
      level: level,
      user: (memory_in.response.bits[4]),
      read: (memory_in.response.bits[1]),
      write: (memory_in.response.bits[2]),
      execute: (memory_in.response.bits[3]),
      global: (global_mapping | memory_in.response.bits[5]),
      accessed: (memory_in.response.bits[6]),
      dirty: (memory_in.response.bits[7]),
      fault:
        (_GEN_8 | _GEN_7
         & ~((operation.privilege == 2'h0
                ? memory_in.response.bits[4]
                : ~(memory_in.response.bits[4]) | operation.privilege == 2'h1
                  & operation.sum & (|operation.access))
             & (operation.access == 2'h0
                  ? memory_in.response.bits[3]
                  : operation.access == 2'h1
                      ? memory_in.response.bits[1] | operation.mxr
                        & memory_in.response.bits[3]
                      : memory_in.response.bits[2] & memory_in.response.bits[7])
             & memory_in.response.bits[6]))};
  wire                               _GEN_16 = _GEN_4 | ~_GEN_6 | _GEN_9;
  wire struct packed {logic valid; logic [63:0] bits; } _GEN_17 =
    '{valid: _GEN_3,
      bits:
        ({8'h0, table_ppn, 12'h0}
         + {52'h0,
            _GEN_2
              ? operation.virtual_address[20:12]
              : _GEN_1
                  ? operation.virtual_address[29:21]
                  : operation.virtual_address[38:30],
            3'h0})};
  wire struct packed {logic ready; } _GEN_18 = '{ready: _GEN_5};
  always @(posedge clock) begin
    if (reset) begin
      state <= 2'h0;
      level <= 2'h2;
      global_mapping <= 1'h0;
    end
    else begin
      state <=
        cancel
          ? 2'h0
          : _GEN_0
              ? (_GEN_12 ? 2'h1 : _GEN_13 ? 2'h3 : state)
              : _GEN_4
                  ? 2'h2
                  : _GEN_6
                      ? (_GEN_9 ? 2'h3 : ~_GEN_9 ? 2'h1 : state)
                      : _GEN_10 & completion_in.ready ? 2'h0 : state;
      level <= cancel ? level : _GEN_0 ? 2'h2 : _GEN_16 ? level : level - 2'h1;
      global_mapping <=
        cancel
          ? global_mapping
          : ~_GEN_0
            & (~_GEN_4 & _GEN_6 & ~_GEN_9 & ~_GEN_9 & memory_in.response.bits[5]
               | global_mapping);
    end
  end // always @(posedge)
  always @(posedge clock) begin
    operation <= cancel | ~_GEN_0 ? operation : request_in.bits;
    table_ppn <=
      cancel
        ? table_ppn
        : _GEN_0
            ? request_in.bits.root_ppn
            : _GEN_16 ? table_ppn : memory_in.response.bits[53:10];
    result <=
      cancel
        ? result
        : _GEN_0
            ? (_GEN_12 | ~_GEN_13 ? result : _GEN_14)
            : _GEN_4 | ~(_GEN_6 & _GEN_9) ? result : _GEN_15;
  end // always @(posedge)
  assign request_out = '{ready: _GEN};
  assign completion_out = '{valid: _GEN_10, bits: result};
  assign memory_out = '{request: _GEN_17, response: _GEN_18};
endmodule

module Queue_1(
  input                                            clock,
                                                   reset,
  input  struct packed {logic valid; logic bits; } ingress_in,
  input  struct packed {logic ready; }             egress_in,
  output struct packed {logic ready; }             ingress_out,
  output struct packed {logic valid; logic bits; } egress_out,
  output [1:0]                                     count
);

  wire       _GEN;
  wire       _GEN_0;
  wire       _write_pointer_value;
  wire       _read_pointer_value;
  wire       _GEN_1 = 1'h0;
  reg        storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0] occupancy;
  wire       _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire       _GEN_3 = occupancy != 2'h2;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire       _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module RicketL1ICache(
  input                                                                                                                                                                                                                                                                                                                                         clock,
                                                                                                                                                                                                                                                                                                                                                reset,
