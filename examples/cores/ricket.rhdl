  `endif // not def SYNTHESIS
  wire                        _GEN_20 = _GEN_14 & ~reset;
  wire                        _GEN_21 = ~_GEN_20;
  `ifndef SYNTHESIS
    line_refill_retry_has_request:
      assert property (@(posedge clock) disable iff (_GEN_21) request_sent);
  `endif // not def SYNTHESIS
  wire                        _GEN_22 = ~_GEN_20;
  `ifndef SYNTHESIS
    line_refill_retry_txn_id:
      assert property (@(posedge clock) disable iff (_GEN_22)
                         responses_in.bits.txn_id == 12'h0);
  `endif // not def SYNTHESIS
  wire                        _GEN_23 =
    ~(retry_received & retry_credit_received & ~reset);
  `ifndef SYNTHESIS
    line_refill_retry_credit_type_matches:
      assert property (@(posedge clock) disable iff (_GEN_23)
                         retry_credit_type == granted_credit_type);
  `endif // not def SYNTHESIS
  wire CHICoherentResponse    _GEN_24 = /*cast(bit)*/response_data_in.bits.resp;
