#lang rhdl
// Materializes a complete RV64 Ricket processor with private instruction and data caches.

import:
  lib("cores/ricket/ricket.rhdl") open
  lib("cores/ricket/chi.rhdl") open
  lib("chi/main.rhdl") open
  lib("riscv/isa/xlen.rhm") open

def example_flit = CHIFlitParams()
def example_home = CHIHomeParams("example-home", 1, CHINodeKind.HNF, ~max_outstanding: 2)
def example_home_map = CHIHomeMap(
  example_flit,
  [CHIHomeMapEntry(AddressSet(0, (1 << example_flit.request_address_width) - 1), example_home)]
)
def example_chi = RicketCHIParams(example_flit, example_home_map, 2, 3)
def design = elaborate(Ricket(XLen.X64, ~chi: example_chi))

