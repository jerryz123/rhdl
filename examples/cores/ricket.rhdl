module RicketLineRefill(
  input                                                              clock,
                                                                     reset,
  input  struct packed {logic valid; RicketLineRefillCommand bits; } command_in,
  input  struct packed {logic ready; }                               completion_in,
                                                                     requests_in,
                                                                     acknowledgements_in,
  input  struct packed {logic valid; CHIDatFlit bits; }              response_data_in,
  output struct packed {logic ready; }                               command_out,
  output struct packed {logic valid; RicketLineRefillResult bits; }  completion_out,
  output struct packed {logic valid; CHIReqFlit bits; }              requests_out,
  output struct packed {logic valid; CHIRspFlit bits; }              acknowledgements_out,
  output struct packed {logic ready; }                               response_data_out
);

  wire [1:0]                  _GEN = '{1'h0, 1'h0};
  reg                         active_state;
  reg                         request_sent;
  reg  [1:0]                  received_packets;
  reg                         acknowledgement_sent;
  reg  [63:0]                 line_address;
  reg  [63:0]                 context_0;
  reg  [255:0]                line;
  reg  [6:0]                  home_id;
  reg  [11:0]                 dbid;
  reg  [1:0]                  response_state;
  reg                         pass_dirty;
  wire                        _GEN_0 = command_in.valid & ~active_state;
  wire                        _GEN_1 = _GEN_0 & ~reset;
  wire                        _GEN_2 = ~_GEN_1;
  `ifndef SYNTHESIS
    line_refill_address_aligned:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         command_in.bits.line_address[4:0] == 5'h0);
  `endif // not def SYNTHESIS
  wire                        _GEN_3 = ~_GEN_1;
  `ifndef SYNTHESIS
    line_refill_address_fits_chi:
      assert property (@(posedge clock) disable iff (_GEN_3)
                         command_in.bits.line_address[63:44] == 20'h0);
  `endif // not def SYNTHESIS
  wire                        _GEN_4 = active_state & ~request_sent;
  wire                        _GEN_5 = _GEN_4 & requests_in.ready;
  wire [1:0]                  _GEN_6 = received_packets;
  wire                        _GEN_7 = &_GEN_6;
  wire                        _GEN_8 = _GEN_6 == 2'h0;
  wire [1:0][127:0]           _GEN_9 = /*cast(bit[1:0][127:0])*/line;
  wire                        _GEN_10 = active_state & request_sent & ~_GEN_7;
  wire                        _GEN_11 = response_data_in.valid & _GEN_10;
  wire                        _GEN_12 = _GEN_11 & ~reset;
  wire                        _GEN_13 = ~_GEN_12;
  `ifndef SYNTHESIS
    line_refill_response_is_comp_data:
      assert property (@(posedge clock) disable iff (_GEN_13)
                         response_data_in.bits.opcode == 4'h4);
  `endif // not def SYNTHESIS
  wire                        _GEN_14 = ~_GEN_12;
  `ifndef SYNTHESIS
    line_refill_response_txn_id:
      assert property (@(posedge clock) disable iff (_GEN_14)
                         response_data_in.bits.txn_id == 12'h0);
  `endif // not def SYNTHESIS
  wire                        _GEN_15 = ~_GEN_12;
  `ifndef SYNTHESIS
    line_refill_response_target:
      assert property (@(posedge clock) disable iff (_GEN_15)
                         response_data_in.bits.tgt_id == 7'h2);
  `endif // not def SYNTHESIS
  wire                        _GEN_16 = ~_GEN_12;
  `ifndef SYNTHESIS
    line_refill_response_data_id:
      assert property (@(posedge clock) disable iff (_GEN_16)
                         response_data_in.bits.data_id == (~(response_data_in.bits.data_id[0])
                                                             ? line_address[5:4]
                                                             : response_data_in.bits.data_id[0]
                                                                 ? line_address[5:4]
                                                                   + 2'h1
                                                                 : 2'h0));
  `endif // not def SYNTHESIS
  wire                        _GEN_17 = ~_GEN_12;
  `ifndef SYNTHESIS
    line_refill_response_data_id_unique:
      assert property (@(posedge clock) disable iff (_GEN_17)
                         ~received_packets[response_data_in.bits.data_id[0]]);
  `endif // not def SYNTHESIS
  wire                        _GEN_18 = ~_GEN_12;
  `ifndef SYNTHESIS
    line_refill_response_num_dat_zero:
      assert property (@(posedge clock) disable iff (_GEN_18)
                         response_data_in.bits.num_dat == 2'h0);
  `endif // not def SYNTHESIS
  wire                        _GEN_19 = ~_GEN_12;
  `ifndef SYNTHESIS
    line_refill_response_not_replicated:
      assert property (@(posedge clock) disable iff (_GEN_19)
                         ~response_data_in.bits.replicate);
  `endif // not def SYNTHESIS
  wire                        _GEN_20 = ~_GEN_12;
  `ifndef SYNTHESIS
    line_refill_response_ok:
      assert property (@(posedge clock) disable iff (_GEN_20)
                         response_data_in.bits.resp_err == 2'h0);
  `endif // not def SYNTHESIS
  wire                        _GEN_21 = _GEN_11 & ~_GEN_8 & ~reset;
  wire                        _GEN_22 = ~_GEN_21;
  `ifndef SYNTHESIS
    line_refill_response_home_consistent:
      assert property (@(posedge clock) disable iff (_GEN_22)
                         response_data_in.bits.home_nid_or_pbha_or_mismatched_mecid == home_id);
  `endif // not def SYNTHESIS
  wire                        _GEN_23 = ~_GEN_21;
  `ifndef SYNTHESIS
    line_refill_response_dbid_consistent:
      assert property (@(posedge clock) disable iff (_GEN_23)
                         response_data_in.bits.dbid_or_mecid[11:0] == dbid);
  `endif // not def SYNTHESIS
  wire                        _GEN_24 = ~_GEN_21;
  `ifndef SYNTHESIS
    line_refill_response_state_consistent:
      assert property (@(posedge clock) disable iff (_GEN_24)
                         response_data_in.bits.resp[1:0] == response_state);
  `endif // not def SYNTHESIS
  wire                        _GEN_25 = ~_GEN_21;
  `ifndef SYNTHESIS
    line_refill_response_pass_dirty_consistent:
      assert property (@(posedge clock) disable iff (_GEN_25)
                         response_data_in.bits.resp[2] == pass_dirty);
  `endif // not def SYNTHESIS
  wire                        _GEN_26 = active_state & _GEN_7 & ~acknowledgement_sent;
  wire CHIRspFlit             _GEN_27 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: (12'h0),
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (5'h2),
      txn_id: dbid,
      src_id: (7'h2),
      tgt_id: home_id,
      qos: (4'h0)};
  wire                        _GEN_28 = _GEN_26 & acknowledgements_in.ready;
  wire                        _GEN_29 = active_state & acknowledgement_sent;
  wire [3:0][63:0]            _GEN_30 = /*cast(bit[3:0][63:0])*/line;
  wire RicketLineRefillResult _GEN_31 =
    '{line_address: line_address,
      context_0: context_0,
      line: _GEN_30,
      state: response_state,
      pass_dirty: pass_dirty};
  wire [255:0]                _GEN_32 =
    /*cast(bit[255:0])*/{{response_data_in.bits.data_id[0]
                            ? response_data_in.bits.data
                            : _GEN_9[1'h1]},
                         {~(response_data_in.bits.data_id[0])
                            ? response_data_in.bits.data
                            : _GEN_9[1'h0]}};
  wire                        _GEN_33 = _GEN_5 | ~_GEN_11;
  wire                        _GEN_34 = _GEN_5 | ~(_GEN_11 & _GEN_8);
  wire CHIReqFlit             _GEN_35 =
    '{trace_tag: (1'h0),
      tag_op: (2'h0),
      exp_comp_ack: (1'h1),
      excl_snoop_me_cah: (1'h0),
      group_id_or_lpid: (8'h0),
      snp_attr_or_do_dwt: (1'h1),
      mem_attr: (4'h0),
      pcrd_type: (4'h0),
      order: (2'h0),
      allow_retry: (1'h0),
      likely_shared: (1'h0),
      pas: (3'h0),
      address: (line_address[43:0]),
      size_or_num_req: (6'h5),
      multi_req: (1'h0),
      opcode: (7'h1),
      return_txn_id_or_stash_lpid: (12'h0),
      stash_nid_valid_endian_deep_prefetch_tgt_hint: (1'h0),
      return_nid_or_stash_nid_or_data_target: (7'h2),
      txn_id: (12'h0),
      src_id: (7'h2),
      tgt_id: (7'h1),
      qos: (4'h0)};
  always @(posedge clock) begin
    if (reset) begin
      active_state <= 1'h0;
      request_sent <= 1'h0;
      received_packets <= _GEN;
      acknowledgement_sent <= 1'h0;
      line_address <= 64'h0;
      line <= 256'h0;
      home_id <= 7'h0;
      dbid <= 12'h0;
      response_state <= 2'h0;
      pass_dirty <= 1'h0;
    end
    else begin
      active_state <=
        _GEN_0 | (_GEN_5 | _GEN_11 | _GEN_28 | ~(_GEN_29 & completion_in.ready))
        & active_state;
      request_sent <= ~_GEN_0 & (_GEN_5 | request_sent);
      received_packets <=
        _GEN_0
          ? _GEN
          : _GEN_33
              ? received_packets
              : {{response_data_in.bits.data_id[0] | received_packets[1'h1]},
                 {~(response_data_in.bits.data_id[0]) | received_packets[1'h0]}};
      acknowledgement_sent <=
        ~_GEN_0 & (~_GEN_5 & ~_GEN_11 & _GEN_28 | acknowledgement_sent);
      line_address <= _GEN_0 ? command_in.bits.line_address : line_address;
      line <= _GEN_0 ? 256'h0 : _GEN_33 ? line : _GEN_32;
      home_id <=
        _GEN_0
          ? 7'h0
          : _GEN_34
              ? home_id
              : response_data_in.bits.home_nid_or_pbha_or_mismatched_mecid;
      dbid <= _GEN_0 ? 12'h0 : _GEN_34 ? dbid : response_data_in.bits.dbid_or_mecid[11:0];
      response_state <=
        _GEN_0 ? 2'h0 : _GEN_34 ? response_state : response_data_in.bits.resp[1:0];
      pass_dirty <= ~_GEN_0 & (_GEN_34 ? pass_dirty : response_data_in.bits.resp[2]);
    end
  end // always @(posedge)
  always @(posedge clock)
    context_0 <= _GEN_0 ? command_in.bits.context_0 : context_0;
  assign command_out = '{ready: (~active_state)};
  assign completion_out = '{valid: _GEN_29, bits: _GEN_31};
  assign requests_out = '{valid: _GEN_4, bits: _GEN_35};
  assign acknowledgements_out = '{valid: _GEN_26, bits: _GEN_27};
  assign response_data_out = '{ready: _GEN_10};
endmodule

module Pipe_2(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; logic [63:0] bits; } ingress_in,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_out,
  output struct packed {logic valid; logic [63:0] bits; } egress_out
);

  reg  [0:0]       stage_valid;
  reg  [0:0][63:0] stage_bits;
  wire             _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire             _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire [63:0]      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module Arbiter_1(
  input  struct packed {logic valid; RicketInstructionResp bits; } ingress_0_in,
                                                                   ingress_1_in,
  input  struct packed {logic ready; }                             egress_in,
  output struct packed {logic ready; }                             ingress_0_out,
                                                                   ingress_1_out,
  output struct packed {logic valid; RicketInstructionResp bits; } egress_out,
  output                                                           chosen
);

  wire [1:0] _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0] _GEN_0 = _GEN & {~(_GEN[0]), 1'h1};
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_0[1'h0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_0[1'h1])};
  assign egress_out =
    '{valid: (|_GEN),
      bits:
        (ingress_0_in.valid
           ? ingress_0_in.bits
           : ingress_1_in.valid ? ingress_1_in.bits : ingress_0_in.bits)};
  assign chosen = _GEN[1] & ~(_GEN[0]);
endmodule

module Queue_1(
  input                                                            clock,
                                                                   reset,
  input  struct packed {logic valid; RicketInstructionResp bits; } ingress_in,
  input  struct packed {logic ready; }                             egress_in,
  output struct packed {logic ready; }                             ingress_out,
  output struct packed {logic valid; RicketInstructionResp bits; } egress_out,
  output [1:0]                                                     count
);

  wire RicketInstructionResp _GEN;
  wire                       _GEN_0;
  wire                       _write_pointer_value;
  wire                       _read_pointer_value;
  wire                       _GEN_1 = 1'h0;
  RicketInstructionResp      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]                 occupancy;
  wire                       _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire                       _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3 & ~(_GEN_2 & egress_in.ready);
  wire                       _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out =
    '{valid: (~_GEN_2 | ingress_in.valid),
      bits: (_GEN_2 ? _GEN : storage[_read_pointer_value])};
  assign count = occupancy;
endmodule

module Arbiter_2(
  input  struct packed {logic valid; CHIRspFlit bits; } ingress_0_in,
                                                        ingress_1_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
  output struct packed {logic valid; CHIRspFlit bits; } egress_out,
  output                                                chosen
);

  wire [1:0] _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0] _GEN_0 = _GEN & {~(_GEN[0]), 1'h1};
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_0[1'h0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_0[1'h1])};
  assign egress_out =
    '{valid: (|_GEN),
      bits:
        (ingress_0_in.valid
           ? ingress_0_in.bits
           : ingress_1_in.valid ? ingress_1_in.bits : ingress_0_in.bits)};
  assign chosen = _GEN[1] & ~(_GEN[0]);
endmodule

module CreditSender(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; CHIReqFlit bits; } ingress_in,
  input  struct packed {logic credit; }                 link_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; CHIReqFlit bits; } link_out,
  output [1:0]                                          credit_count
);

  wire _balance_empty;
  wire _GEN = ingress_in.valid & ~_balance_empty;
  CreditCounter balance (
    .clock     (clock),
    .reset     (reset),
    .increment (link_in.credit),
    .decrement (_GEN),
    .count     (credit_count),
    .empty     (_balance_empty),
    .full      (/* unused */)
  );
  assign ingress_out = '{ready: (~_balance_empty)};
  assign link_out = '{valid: _GEN, bits: ingress_in.bits};
endmodule

module CreditCounter(
  input        clock,
               reset,
               increment,
               decrement,
  output [1:0] count,
  output       empty,
               full
);

  reg  [1:0] state;
  wire       _GEN = state == 2'h0;
  wire       _GEN_0 = state == 2'h2;
  `ifndef SYNTHESIS
    credit_counter_underflow:
      assert property (@(posedge clock) disable iff (reset) ~decrement | ~_GEN);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_counter_overflow:
      assert property (@(posedge clock) disable iff (reset)
                         ~increment | decrement | ~_GEN_0);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_counter_in_range:
      assert property (@(posedge clock) disable iff (reset) state != 2'h3);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 2'h0;
    else
      state <= increment ^ decrement ? (increment ? state + 2'h1 : state - 2'h1) : state;
  end // always @(posedge)
  assign count = state;
  assign empty = _GEN;
  assign full = _GEN_0;
endmodule

