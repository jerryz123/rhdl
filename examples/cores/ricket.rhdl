          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0};
      reservation_valid <= 1'h0;
      reservation_address <= 64'h0;
      reservation_width <= 2'h2;
    end
    else begin
      valid_lines <= _GEN_58;
      reservation_valid <=
        _GEN_55
        | ~(reservation_valid
            & (_lookup_egress_out.valid & _GEN_23
               & (_GEN_13 | (_GEN_9 | _GEN_11)
                  & _lookup_egress_out.bits.address[63:6] == reservation_address[63:6])
               | _snoop_update_out.valid & _snoop_update_out.bits.invalidate
               & _snoop_update_out.bits.address[63:6] == reservation_address[63:6]
               | _lookup_egress_out.valid & _GEN_23 & _GEN_19 & ~_GEN_4 & _GEN_3
               & {_tags_port_out.response.bits[1'h0],
                  _lookup_egress_out.bits.address[11:6]} == reservation_address[63:6]))
        & reservation_valid;
      reservation_address <= _GEN_55 ? _GEN_29 : reservation_address;
      reservation_width <= _GEN_55 ? _GEN_30 : reservation_width;
    end
  end // always @(posedge)
  assign core_out =
    '{request: _GEN_75,
      request_fault: (1'h0),
      response: _responses_egress_out,
      drained:
        (~_GEN_46 & ~_lookup_egress_out.valid & _refill_command_out.ready
         & _writeback_command_out.ready)};
  assign chi_out =
    '{requests: _protocol_requests_egress_out,
      requester_responses: _protocol_responses_egress_out,
      request_data: _protocol_data_egress_out,
      responses: _GEN_74,
      response_data: _refill_response_data_out,
      snoops: _snoop_snoops_out};
endmodule

module storage_64x3(
  input  [5:0] RW0_addr,
  input        RW0_en,
               RW0_clk,
               RW0_wmode,
  input  [2:0] RW0_wdata,
  output [2:0] RW0_rdata
);

  reg  [2:0] Memory[0:63];
  reg  [5:0] _RW0_raddr_d0;
  reg        _RW0_ren_d0;
  reg        _RW0_rmode_d0;
  always @(posedge RW0_clk) begin
    _RW0_raddr_d0 <= RW0_addr;
    _RW0_ren_d0 <= RW0_en;
    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [2:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 3'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmode)
      Memory[RW0_addr] <= RW0_wdata;
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

module SyncRam1RW_3(
  input                                                                                   clock,
                                                                                          reset,
  input  struct packed {struct packed {logic valid; ReadWriteRequest_3 bits; } request; } port_in,
  output struct packed {struct packed {logic valid; logic [0:0][2:0] bits; } response; }  port_out
);

  wire [0:0][2:0] _GEN;
  wire            _GEN_0;
  wire            _GEN_1;
  wire [5:0]      _GEN_2;
  wire [2:0]      _GEN_3;
  wire [2:0]      _storage_ext_RW0_rdata;
  storage_64x3 storage_ext (
    .RW0_addr  (_GEN_2),
    .RW0_en    (_GEN_1),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_0),
    .RW0_wdata (_GEN_3),
    .RW0_rdata (_storage_ext_RW0_rdata)
  );
  assign _GEN_3 = /*cast(bit[2:0])*/_GEN;
  wire [0:0][2:0] _GEN_4 = /*cast(bit[0:0][2:0])*/_storage_ext_RW0_rdata;
  reg             response_valid;
  assign _GEN_2 = port_in.request.bits.address;
  assign _GEN_1 = port_in.request.valid;
  assign _GEN_0 = port_in.request.bits.write;
  assign _GEN = port_in.request.bits.data;
  wire struct packed {logic valid; logic [0:0][2:0] bits; } _GEN_5 =
    '{valid: response_valid, bits: _GEN_4};
  always @(posedge clock) begin
    if (reset)
      response_valid <= 1'h0;
    else
      response_valid <= _GEN_1 & ~_GEN_0;
  end // always @(posedge)
  assign port_out = '{response: _GEN_5};
endmodule

