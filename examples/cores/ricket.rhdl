                                                                                                                                                                                                                                                                                                                                                dmem_in,
  output struct packed {logic ready; }                                                                                                                                                                                                                                                                                                          start_out,
  output struct packed {struct packed {logic valid; CHIReqFlit bits; } requests; struct packed {logic valid; CHIRspFlit bits; } requester_responses; struct packed {logic valid; CHIDatFlit bits; } request_data; struct packed {logic ready; } responses; struct packed {logic ready; } response_data; struct packed {logic ready; } snoops; } imem_out,
                                                                                                                                                                                                                                                                                                                                                dmem_out,
  output                                                                                                                                                                                                                                                                                                                                        fault
);

  wire
    struct packed {struct packed {logic ready; } request; struct packed {logic valid; RicketDataResp bits; } response; logic drained; }
    _l1d_core_out;
  wire
    struct packed {struct packed {logic ready; } request; struct packed {logic valid; RicketInstructionResp bits; } response; }
    _l1i_core_out;
  wire
