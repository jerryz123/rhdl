      ? writes_0_in.bits.data & {64{_GEN_52}} | writes_1_in.bits.data & {64{_GEN_53}}
      : registers[5'h11];
  wire              _GEN_55 = _GEN & writes_0_in.bits.address == 5'h12;
  wire              _GEN_56 = _GEN_0 & writes_1_in.bits.address == 5'h12;
  wire [63:0]       _GEN_57 =
    _GEN_55 | _GEN_56
      ? writes_0_in.bits.data & {64{_GEN_55}} | writes_1_in.bits.data & {64{_GEN_56}}
      : registers[5'h12];
  wire              _GEN_58 = _GEN & writes_0_in.bits.address == 5'h13;
  wire              _GEN_59 = _GEN_0 & writes_1_in.bits.address == 5'h13;
  wire [63:0]       _GEN_60 =
    _GEN_58 | _GEN_59
      ? writes_0_in.bits.data & {64{_GEN_58}} | writes_1_in.bits.data & {64{_GEN_59}}
      : registers[5'h13];
  wire              _GEN_61 = _GEN & writes_0_in.bits.address == 5'h14;
  wire              _GEN_62 = _GEN_0 & writes_1_in.bits.address == 5'h14;
  wire [63:0]       _GEN_63 =
    _GEN_61 | _GEN_62
      ? writes_0_in.bits.data & {64{_GEN_61}} | writes_1_in.bits.data & {64{_GEN_62}}
      : registers[5'h14];
  wire              _GEN_64 = _GEN & writes_0_in.bits.address == 5'h15;
  wire              _GEN_65 = _GEN_0 & writes_1_in.bits.address == 5'h15;
  wire [63:0]       _GEN_66 =
    _GEN_64 | _GEN_65
      ? writes_0_in.bits.data & {64{_GEN_64}} | writes_1_in.bits.data & {64{_GEN_65}}
      : registers[5'h15];
  wire              _GEN_67 = _GEN & writes_0_in.bits.address == 5'h16;
  wire              _GEN_68 = _GEN_0 & writes_1_in.bits.address == 5'h16;
  wire [63:0]       _GEN_69 =
    _GEN_67 | _GEN_68
      ? writes_0_in.bits.data & {64{_GEN_67}} | writes_1_in.bits.data & {64{_GEN_68}}
      : registers[5'h16];
  wire              _GEN_70 = _GEN & writes_0_in.bits.address == 5'h17;
  wire              _GEN_71 = _GEN_0 & writes_1_in.bits.address == 5'h17;
  wire [63:0]       _GEN_72 =
    _GEN_70 | _GEN_71
      ? writes_0_in.bits.data & {64{_GEN_70}} | writes_1_in.bits.data & {64{_GEN_71}}
      : registers[5'h17];
  wire              _GEN_73 = _GEN & writes_0_in.bits.address == 5'h18;
  wire              _GEN_74 = _GEN_0 & writes_1_in.bits.address == 5'h18;
  wire [63:0]       _GEN_75 =
    _GEN_73 | _GEN_74
      ? writes_0_in.bits.data & {64{_GEN_73}} | writes_1_in.bits.data & {64{_GEN_74}}
      : registers[5'h18];
  wire              _GEN_76 = _GEN & writes_0_in.bits.address == 5'h19;
  wire              _GEN_77 = _GEN_0 & writes_1_in.bits.address == 5'h19;
  wire [63:0]       _GEN_78 =
    _GEN_76 | _GEN_77
      ? writes_0_in.bits.data & {64{_GEN_76}} | writes_1_in.bits.data & {64{_GEN_77}}
      : registers[5'h19];
  wire              _GEN_79 = _GEN & writes_0_in.bits.address == 5'h1A;
  wire              _GEN_80 = _GEN_0 & writes_1_in.bits.address == 5'h1A;
  wire [63:0]       _GEN_81 =
    _GEN_79 | _GEN_80
      ? writes_0_in.bits.data & {64{_GEN_79}} | writes_1_in.bits.data & {64{_GEN_80}}
      : registers[5'h1A];
  wire              _GEN_82 = _GEN & writes_0_in.bits.address == 5'h1B;
  wire              _GEN_83 = _GEN_0 & writes_1_in.bits.address == 5'h1B;
  wire [63:0]       _GEN_84 =
    _GEN_82 | _GEN_83
      ? writes_0_in.bits.data & {64{_GEN_82}} | writes_1_in.bits.data & {64{_GEN_83}}
      : registers[5'h1B];
  wire              _GEN_85 = _GEN & writes_0_in.bits.address == 5'h1C;
  wire              _GEN_86 = _GEN_0 & writes_1_in.bits.address == 5'h1C;
  wire [63:0]       _GEN_87 =
    _GEN_85 | _GEN_86
      ? writes_0_in.bits.data & {64{_GEN_85}} | writes_1_in.bits.data & {64{_GEN_86}}
      : registers[5'h1C];
  wire              _GEN_88 = _GEN & writes_0_in.bits.address == 5'h1D;
  wire              _GEN_89 = _GEN_0 & writes_1_in.bits.address == 5'h1D;
  wire [63:0]       _GEN_90 =
    _GEN_88 | _GEN_89
      ? writes_0_in.bits.data & {64{_GEN_88}} | writes_1_in.bits.data & {64{_GEN_89}}
      : registers[5'h1D];
  wire              _GEN_91 = _GEN & writes_0_in.bits.address == 5'h1E;
  wire              _GEN_92 = _GEN_0 & writes_1_in.bits.address == 5'h1E;
  wire [63:0]       _GEN_93 =
    _GEN_91 | _GEN_92
      ? writes_0_in.bits.data & {64{_GEN_91}} | writes_1_in.bits.data & {64{_GEN_92}}
      : registers[5'h1E];
  wire              _GEN_94 = _GEN & (&writes_0_in.bits.address);
  wire              _GEN_95 = _GEN_0 & (&writes_1_in.bits.address);
  wire [63:0]       _GEN_96 =
    _GEN_94 | _GEN_95
      ? writes_0_in.bits.data & {64{_GEN_94}} | writes_1_in.bits.data & {64{_GEN_95}}
      : registers[5'h1F];
  always @(posedge clock) begin
    if (reset)
      registers <=
        '{64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0,
          64'h0};
    else begin
      registers[5'h1F] <= _GEN_96;
      registers[5'h1E] <= _GEN_93;
      registers[5'h1D] <= _GEN_90;
      registers[5'h1C] <= _GEN_87;
      registers[5'h1B] <= _GEN_84;
      registers[5'h1A] <= _GEN_81;
      registers[5'h19] <= _GEN_78;
      registers[5'h18] <= _GEN_75;
      registers[5'h17] <= _GEN_72;
      registers[5'h16] <= _GEN_69;
      registers[5'h15] <= _GEN_66;
      registers[5'h14] <= _GEN_63;
      registers[5'h13] <= _GEN_60;
      registers[5'h12] <= _GEN_57;
      registers[5'h11] <= _GEN_54;
      registers[5'h10] <= _GEN_51;
      registers[5'hF] <= _GEN_48;
      registers[5'hE] <= _GEN_45;
      registers[5'hD] <= _GEN_42;
      registers[5'hC] <= _GEN_39;
      registers[5'hB] <= _GEN_36;
      registers[5'hA] <= _GEN_33;
      registers[5'h9] <= _GEN_30;
      registers[5'h8] <= _GEN_27;
      registers[5'h7] <= _GEN_24;
      registers[5'h6] <= _GEN_21;
      registers[5'h5] <= _GEN_18;
      registers[5'h4] <= _GEN_15;
      registers[5'h3] <= _GEN_12;
      registers[5'h2] <= _GEN_9;
      registers[5'h1] <= _GEN_6;
      registers[5'h0] <= _GEN_3;
    end
  end // always @(posedge)
  assign read_data_1 =
    read_address_1 == 5'h0
      ? 64'h0
      : _GEN_0 & writes_1_in.bits.address == read_address_1
          ? writes_1_in.bits.data
          : _GEN & writes_0_in.bits.address == read_address_1
              ? writes_0_in.bits.data
              : registers[read_address_1];
  assign read_data_2 =
    read_address_2 == 5'h0
      ? 64'h0
      : _GEN_0 & writes_1_in.bits.address == read_address_2
          ? writes_1_in.bits.data
          : _GEN & writes_0_in.bits.address == read_address_2
              ? writes_0_in.bits.data
              : registers[read_address_2];
endmodule

module ALU(
  input  [63:0]     left,
                    right,
  input  AluControl control,
  output [63:0]     result
);

  wire [63:0] _GEN = {58'h0, control.word ? {1'h0, right[4:0]} : right[5:0]};
  wire [63:0] _GEN_0 =
    (control.subtract ? left - right : left + right) & {64{control.result_select[0]}}
    | (control.shift_right
         ? (control.signed_mode
              ? $signed($signed(control.word ? {{32{left[31]}}, left[31:0]} : left)
                        >>> _GEN)
              : (control.word ? {32'h0, left[31:0]} : left) >> _GEN)
         : left << _GEN) & {64{control.result_select[1]}}
    | {63'h0, control.signed_mode & (left[63] ^ right[63]) ? left[63] : left < right}
    & {64{control.result_select[2]}} | (left ^ right) & {64{control.result_select[3]}}
    | (left | right) & {64{control.result_select[4]}} | left & right
    & {64{control.result_select[5]}};
  assign result =
    control.word & (control.result_select == 6'h1 | control.result_select == 6'h2)
      ? {{32{_GEN_0[31]}}, _GEN_0[31:0]}
      : _GEN_0;
endmodule

module BranchResolver(
  input  struct packed {logic valid; BranchResolverRequest bits; } request_in,
  output struct packed {logic valid; BranchResult bits; }          result_out
);

  wire BranchResult _GEN =
    '{taken:
        (request_in.bits.control.enable
         & (request_in.bits.control.unconditional
            | (request_in.bits.control.compare_equal
                 ? request_in.bits.left == request_in.bits.right
                 : request_in.bits.control.signed_mode
                   & (request_in.bits.left[63] ^ request_in.bits.right[63])
                     ? request_in.bits.left[63]
                     : request_in.bits.left < request_in.bits.right)
            ^ request_in.bits.control.invert))};
  assign result_out = '{valid: request_in.valid, bits: _GEN};
endmodule

module RicketMultiplier(
  input                                                               clock,
                                                                      reset,
  input  struct packed {logic valid; RicketMultiplyIssue bits; }      issue_in,
  input  struct packed {logic ready; }                                completion_in,
  output struct packed {logic valid; RicketMultiplyCompletion bits; } completion_out,
  output                                                              available
);

  wire struct packed {logic ready; } _multiplier_request_out;
  wire struct packed {logic valid; logic [127:0] bits; } _multiplier_response_out;
  reg  [4:0]                         destination;
  reg                                high_result;
  reg                                word_result;
  wire MultiplierRequest             _GEN =
    '{left: issue_in.bits.left,
      right: issue_in.bits.right,
      mode: issue_in.bits.control.mode};
  `ifndef SYNTHESIS
    ricket_multiplier_issue_available:
      assert property (@(posedge clock) disable iff (reset)
                         ~issue_in.valid | _multiplier_request_out.ready);
  `endif // not def SYNTHESIS
  wire RicketMultiplyCompletion      _GEN_0 =
    '{rd: destination,
      value:
        (word_result
           ? {{32{_multiplier_response_out.bits[31]}},
              _multiplier_response_out.bits[31:0]}
           : high_result
               ? _multiplier_response_out.bits[127:64]
               : _multiplier_response_out.bits[63:0])};
  wire struct packed {logic valid; MultiplierRequest bits; } _GEN_1 =
    '{valid: issue_in.valid, bits: _GEN};
  IterativeMultiplier multiplier (
    .clock        (clock),
    .reset        (reset),
    .request_in   (_GEN_1),
    .response_in  (completion_in),
    .request_out  (_multiplier_request_out),
    .response_out (_multiplier_response_out)
  );
  always @(posedge clock) begin
    destination <= issue_in.valid ? issue_in.bits.rd : destination;
    high_result <= issue_in.valid ? issue_in.bits.control.high_result : high_result;
    word_result <= issue_in.valid ? issue_in.bits.control.word_result : word_result;
  end // always @(posedge)
  assign completion_out = '{valid: _multiplier_response_out.valid, bits: _GEN_0};
  assign available = _multiplier_request_out.ready;
endmodule

module IterativeMultiplier(
  input                                                        clock,
                                                               reset,
  input  struct packed {logic valid; MultiplierRequest bits; } request_in,
  input  struct packed {logic ready; }                         response_in,
  output struct packed {logic ready; }                         request_out,
  output struct packed {logic valid; logic [127:0] bits; }     response_out
);

  reg          active;
  reg  [5:0]   count;
  reg  [127:0] multiplicand;
  reg  [63:0]  multiplier;
  reg  [127:0] accumulator;
  reg          negate_result;
  reg          response_valid;
  reg  [127:0] response_bits;
  wire         _GEN = ~active & (~response_valid | response_in.ready);
  wire         _GEN_0 = request_in.valid & _GEN;
  wire         _GEN_1 = request_in.bits.mode.left_signed & request_in.bits.left[63];
  wire         _GEN_2 = request_in.bits.mode.right_signed & request_in.bits.right[63];
  wire [127:0] _GEN_3 = accumulator + (multiplier[0] ? multiplicand : 128'h0);
  wire         _GEN_4 = active & (&count);
  wire         _GEN_5 = _GEN_4 | ~active;
  always @(posedge clock) begin
    if (reset) begin
      active <= 1'h0;
      count <= 6'h0;
      response_valid <= 1'h0;
    end
    else begin
      active <= _GEN_0 | ~_GEN_4 & active;
      count <= _GEN_0 ? 6'h0 : _GEN_5 ? count : count + 6'h1;
      response_valid <=
        ~_GEN_0
        & (_GEN_4 | (active | ~(response_valid & response_in.ready)) & response_valid);
    end
  end // always @(posedge)
  always @(posedge clock) begin
    multiplicand <=
      _GEN_0
        ? {64'h0, _GEN_1 ? 64'h0 - request_in.bits.left : request_in.bits.left}
        : _GEN_5 ? multiplicand : {multiplicand[126:0], 1'h0};
    multiplier <=
      _GEN_0
        ? (_GEN_2 ? 64'h0 - request_in.bits.right : request_in.bits.right)
        : _GEN_5 ? multiplier : {1'h0, multiplier[63:1]};
    accumulator <= _GEN_0 ? 128'h0 : _GEN_5 ? accumulator : _GEN_3;
    negate_result <= _GEN_0 ? _GEN_1 ^ _GEN_2 : negate_result;
    response_bits <=
      _GEN_0 | ~_GEN_4 ? response_bits : negate_result ? 128'h0 - _GEN_3 : _GEN_3;
  end // always @(posedge)
  assign request_out = '{ready: _GEN};
  assign response_out = '{valid: response_valid, bits: response_bits};
endmodule

module Scoreboard(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [4:0] bits; } set_in,
                                                         clear_in,
  output [31:0]                                          busy
);

  reg  [31:0] state;
  wire [31:0] _GEN = 32'h1 << set_in.bits;
  wire [31:0] _GEN_0 = 32'h1 << clear_in.bits;
  wire        _GEN_1 = ~(set_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_set_free:
      assert property (@(posedge clock) disable iff (_GEN_1)
                         (state & _GEN) == 32'h0 | clear_in.valid
                         & clear_in.bits == set_in.bits);
  `endif // not def SYNTHESIS
  wire        _GEN_2 = ~(clear_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_clear_busy:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         (|(state & _GEN_0)) | set_in.valid
                         & set_in.bits == clear_in.bits);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 32'h0;
    else
      state <=
        set_in.valid | clear_in.valid
          ? (state | (set_in.valid ? _GEN : 32'h0)) & ~(clear_in.valid ? _GEN_0 : 32'h0)
          : state;
  end // always @(posedge)
  assign busy = state;
endmodule

module Queue(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; logic [63:0] bits; } ingress_in,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_out,
  output struct packed {logic valid; logic [63:0] bits; } egress_out,
  output [1:0]                                            count
);

  wire [63:0] _GEN;
  wire        _GEN_0;
  wire        _write_pointer_value;
  wire        _read_pointer_value;
  wire        _GEN_1 = 1'h0;
  reg  [63:0] storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]  occupancy;
  wire        _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire        _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire        _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module Counter(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule

module Pipe_1(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; FetchDecode bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; FetchDecode bits; } egress_out
);

  reg  [0:0]            stage_valid;
  FetchDecode[0:0]      stage_bits;
  wire                  _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire                  _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire FetchDecode      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module AtomicFork(
  input  struct packed {logic valid; DecodeExecute bits; } ingress_in,
  input  struct packed {logic ready; }                     egress_0_in,
                                                           egress_1_in,
                                                           egress_2_in,
                                                           egress_3_in,
  output struct packed {logic ready; }                     ingress_out,
  output struct packed {logic valid; DecodeExecute bits; } egress_0_out,
                                                           egress_1_out,
                                                           egress_2_out,
                                                           egress_3_out
);

  assign ingress_out =
    '{ready:
        (&({{egress_3_in.ready},
            {egress_2_in.ready},
            {egress_1_in.ready},
            {egress_0_in.ready}}))};
  assign egress_0_out =
    '{valid:
        (ingress_in.valid
         & (&({{egress_3_in.ready}, {egress_2_in.ready}, {egress_1_in.ready}}))),
      bits: ingress_in.bits};
  assign egress_1_out =
    '{valid:
        (ingress_in.valid
         & (&({{egress_3_in.ready}, {egress_2_in.ready}, {egress_0_in.ready}}))),
      bits: ingress_in.bits};
  assign egress_2_out =
    '{valid:
        (ingress_in.valid
         & (&({{egress_3_in.ready}, {egress_1_in.ready}, {egress_0_in.ready}}))),
      bits: ingress_in.bits};
  assign egress_3_out =
    '{valid:
        (ingress_in.valid
         & (&({{egress_2_in.ready}, {egress_1_in.ready}, {egress_0_in.ready}}))),
      bits: ingress_in.bits};
endmodule

module Arbiter(
  input  struct packed {logic valid; RegisterFileWrite bits; } ingress_0_in,
                                                               ingress_1_in,
  input  struct packed {logic ready; }                         egress_in,
  output struct packed {logic ready; }                         ingress_0_out,
                                                               ingress_1_out,
  output struct packed {logic valid; RegisterFileWrite bits; } egress_out,
  output                                                       chosen
);

  wire [1:0] _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0] _GEN_0 = _GEN & {~(_GEN[0]), 1'h1};
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_0[1'h0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_0[1'h1])};
  assign egress_out =
    '{valid: (|_GEN),
      bits:
        (ingress_0_in.valid
           ? ingress_0_in.bits
           : ingress_1_in.valid ? ingress_1_in.bits : ingress_0_in.bits)};
  assign chosen = _GEN[1] & ~(_GEN[0]);
endmodule

module RicketL1ICache(
  input                                                                                                                                          clock,
                                                                                                                                                 reset,
  input  struct packed {logic flush; struct packed {logic valid; RicketInstructionReq bits; } request; struct packed {logic ready; } response; } core_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; }                  memory_in,
  output struct packed {struct packed {logic ready; } request; struct packed {logic valid; RicketInstructionResp bits; } response; }             core_out,
  output struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }                   memory_out
);

  wire                               _GEN;
  wire                               _GEN_0;
  wire                               _GEN_1;
