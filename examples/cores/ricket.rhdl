      registers[5'h1F] <= _GEN_96;
      registers[5'h1E] <= _GEN_93;
      registers[5'h1D] <= _GEN_90;
      registers[5'h1C] <= _GEN_87;
      registers[5'h1B] <= _GEN_84;
      registers[5'h1A] <= _GEN_81;
      registers[5'h19] <= _GEN_78;
      registers[5'h18] <= _GEN_75;
      registers[5'h17] <= _GEN_72;
      registers[5'h16] <= _GEN_69;
      registers[5'h15] <= _GEN_66;
      registers[5'h14] <= _GEN_63;
      registers[5'h13] <= _GEN_60;
      registers[5'h12] <= _GEN_57;
      registers[5'h11] <= _GEN_54;
      registers[5'h10] <= _GEN_51;
      registers[5'hF] <= _GEN_48;
      registers[5'hE] <= _GEN_45;
      registers[5'hD] <= _GEN_42;
      registers[5'hC] <= _GEN_39;
      registers[5'hB] <= _GEN_36;
      registers[5'hA] <= _GEN_33;
      registers[5'h9] <= _GEN_30;
      registers[5'h8] <= _GEN_27;
      registers[5'h7] <= _GEN_24;
      registers[5'h6] <= _GEN_21;
      registers[5'h5] <= _GEN_18;
      registers[5'h4] <= _GEN_15;
      registers[5'h3] <= _GEN_12;
      registers[5'h2] <= _GEN_9;
      registers[5'h1] <= _GEN_6;
      registers[5'h0] <= _GEN_3;
    end
  end // always @(posedge)
  assign read_data_1 =
    read_address_1 == 5'h0
      ? 64'h0
      : _GEN_0 & writes_1_in.bits.address == read_address_1
          ? writes_1_in.bits.data
          : _GEN & writes_0_in.bits.address == read_address_1
              ? writes_0_in.bits.data
              : registers[read_address_1];
  assign read_data_2 =
    read_address_2 == 5'h0
      ? 64'h0
      : _GEN_0 & writes_1_in.bits.address == read_address_2
          ? writes_1_in.bits.data
          : _GEN & writes_0_in.bits.address == read_address_2
              ? writes_0_in.bits.data
              : registers[read_address_2];
endmodule

module ALU(
  input  [63:0]     left,
                    right,
  input  AluControl control,
  output [63:0]     result
);

  wire [63:0] _GEN = {58'h0, control.word ? {1'h0, right[4:0]} : right[5:0]};
  wire [63:0] _GEN_0 =
    (control.subtract ? left - right : left + right) & {64{control.result_select[0]}}
    | (control.shift_right
         ? (control.signed_mode
              ? $signed($signed(control.word ? {{32{left[31]}}, left[31:0]} : left)
                        >>> _GEN)
              : (control.word ? {32'h0, left[31:0]} : left) >> _GEN)
         : left << _GEN) & {64{control.result_select[1]}}
    | {63'h0, control.signed_mode & (left[63] ^ right[63]) ? left[63] : left < right}
    & {64{control.result_select[2]}} | (left ^ right) & {64{control.result_select[3]}}
    | (left | right) & {64{control.result_select[4]}} | left & right
    & {64{control.result_select[5]}};
  assign result =
    control.word & (control.result_select == 6'h1 | control.result_select == 6'h2)
      ? {{32{_GEN_0[31]}}, _GEN_0[31:0]}
      : _GEN_0;
endmodule

module BranchResolver(
  input  struct packed {logic valid; BranchResolverRequest bits; } request_in,
  output struct packed {logic valid; BranchResult bits; }          result_out
);

  wire BranchResult _GEN =
    '{taken:
        (request_in.bits.control.enable
         & (request_in.bits.control.unconditional
            | (request_in.bits.control.compare_equal
                 ? request_in.bits.left == request_in.bits.right
                 : request_in.bits.control.signed_mode
                   & (request_in.bits.left[63] ^ request_in.bits.right[63])
                     ? request_in.bits.left[63]
                     : request_in.bits.left < request_in.bits.right)
            ^ request_in.bits.control.invert))};
  assign result_out = '{valid: request_in.valid, bits: _GEN};
endmodule

module RicketMultiplier(
  input                                                               clock,
                                                                      reset,
  input  struct packed {logic valid; RicketMultiplyIssue bits; }      issue_in,
  input  struct packed {logic ready; }                                completion_in,
  output struct packed {logic valid; RicketMultiplyCompletion bits; } completion_out,
  output                                                              available
);

  wire struct packed {logic ready; } _multiplier_request_out;
  wire struct packed {logic valid; logic [127:0] bits; } _multiplier_response_out;
  reg  [4:0]                         destination;
  reg                                high_result;
  reg                                word_result;
  wire MultiplierRequest             _GEN =
    '{left: issue_in.bits.left,
      right: issue_in.bits.right,
      mode: issue_in.bits.control.mode};
  `ifndef SYNTHESIS
    ricket_multiplier_issue_available:
      assert property (@(posedge clock) disable iff (reset)
                         ~issue_in.valid | _multiplier_request_out.ready);
  `endif // not def SYNTHESIS
  wire RicketMultiplyCompletion      _GEN_0 =
    '{rd: destination,
      value:
        (word_result
           ? {{32{_multiplier_response_out.bits[31]}},
              _multiplier_response_out.bits[31:0]}
           : high_result
               ? _multiplier_response_out.bits[127:64]
               : _multiplier_response_out.bits[63:0])};
  wire struct packed {logic valid; MultiplierRequest bits; } _GEN_1 =
    '{valid: issue_in.valid, bits: _GEN};
  IterativeMultiplier multiplier (
    .clock        (clock),
    .reset        (reset),
    .request_in   (_GEN_1),
    .response_in  (completion_in),
    .request_out  (_multiplier_request_out),
    .response_out (_multiplier_response_out)
  );
  always @(posedge clock) begin
    destination <= issue_in.valid ? issue_in.bits.rd : destination;
    high_result <= issue_in.valid ? issue_in.bits.control.high_result : high_result;
    word_result <= issue_in.valid ? issue_in.bits.control.word_result : word_result;
  end // always @(posedge)
  assign completion_out = '{valid: _multiplier_response_out.valid, bits: _GEN_0};
  assign available = _multiplier_request_out.ready;
endmodule

module IterativeMultiplier(
  input                                                        clock,
                                                               reset,
  input  struct packed {logic valid; MultiplierRequest bits; } request_in,
  input  struct packed {logic ready; }                         response_in,
  output struct packed {logic ready; }                         request_out,
  output struct packed {logic valid; logic [127:0] bits; }     response_out
);

  reg          active;
  reg  [5:0]   count;
  reg  [127:0] multiplicand;
  reg  [63:0]  multiplier;
  reg  [127:0] accumulator;
  reg          negate_result;
  reg          response_valid;
  reg  [127:0] response_bits;
  wire         _GEN = ~active & (~response_valid | response_in.ready);
  wire         _GEN_0 = request_in.valid & _GEN;
  wire         _GEN_1 = request_in.bits.mode.left_signed & request_in.bits.left[63];
  wire         _GEN_2 = request_in.bits.mode.right_signed & request_in.bits.right[63];
  wire [127:0] _GEN_3 = accumulator + (multiplier[0] ? multiplicand : 128'h0);
  wire         _GEN_4 = active & (&count);
  wire         _GEN_5 = _GEN_4 | ~active;
  always @(posedge clock) begin
    if (reset) begin
      active <= 1'h0;
      count <= 6'h0;
      response_valid <= 1'h0;
    end
    else begin
      active <= _GEN_0 | ~_GEN_4 & active;
      count <= _GEN_0 ? 6'h0 : _GEN_5 ? count : count + 6'h1;
      response_valid <=
        ~_GEN_0
        & (_GEN_4 | (active | ~(response_valid & response_in.ready)) & response_valid);
    end
  end // always @(posedge)
  always @(posedge clock) begin
    multiplicand <=
      _GEN_0
        ? {64'h0, _GEN_1 ? 64'h0 - request_in.bits.left : request_in.bits.left}
        : _GEN_5 ? multiplicand : {multiplicand[126:0], 1'h0};
    multiplier <=
      _GEN_0
        ? (_GEN_2 ? 64'h0 - request_in.bits.right : request_in.bits.right)
        : _GEN_5 ? multiplier : {1'h0, multiplier[63:1]};
    accumulator <= _GEN_0 ? 128'h0 : _GEN_5 ? accumulator : _GEN_3;
    negate_result <= _GEN_0 ? _GEN_1 ^ _GEN_2 : negate_result;
    response_bits <=
      _GEN_0 | ~_GEN_4 ? response_bits : negate_result ? 128'h0 - _GEN_3 : _GEN_3;
  end // always @(posedge)
  assign request_out = '{ready: _GEN};
  assign response_out = '{valid: response_valid, bits: response_bits};
endmodule

module RicketDivider(
  input                                                               clock,
                                                                      reset,
  input  struct packed {logic valid; RicketDivideIssue bits; }        issue_in,
  input  struct packed {logic ready; }                                completion_in,
  output struct packed {logic valid; RicketMultiplyCompletion bits; } completion_out,
  output                                                              available
);

  wire struct packed {logic ready; } _divider_request_out;
  wire struct packed {logic valid; DividerResponse bits; } _divider_response_out;
  reg  [4:0]                         destination;
  reg                                remainder_result;
  reg                                word_result;
  wire DividerRequest                _GEN =
    '{dividend:
        (issue_in.bits.control.word_result
           ? (issue_in.bits.control.signed_mode
                ? {{32{issue_in.bits.dividend[31]}}, issue_in.bits.dividend[31:0]}
                : {32'h0, issue_in.bits.dividend[31:0]})
           : issue_in.bits.dividend),
      divisor:
        (issue_in.bits.control.word_result
           ? (issue_in.bits.control.signed_mode
                ? {{32{issue_in.bits.divisor[31]}}, issue_in.bits.divisor[31:0]}
                : {32'h0, issue_in.bits.divisor[31:0]})
           : issue_in.bits.divisor),
      signed_mode: issue_in.bits.control.signed_mode};
  `ifndef SYNTHESIS
    ricket_divider_issue_available:
      assert property (@(posedge clock) disable iff (reset)
                         ~issue_in.valid | _divider_request_out.ready);
  `endif // not def SYNTHESIS
  wire [63:0]                        _GEN_0 =
    remainder_result
      ? _divider_response_out.bits.remainder
      : _divider_response_out.bits.quotient;
  wire RicketMultiplyCompletion      _GEN_1 =
    '{rd: destination, value: (word_result ? {{32{_GEN_0[31]}}, _GEN_0[31:0]} : _GEN_0)};
  wire struct packed {logic valid; DividerRequest bits; } _GEN_2 =
    '{valid: issue_in.valid, bits: _GEN};
  IterativeDivider divider (
    .clock        (clock),
    .reset        (reset),
    .request_in   (_GEN_2),
    .response_in  (completion_in),
    .request_out  (_divider_request_out),
    .response_out (_divider_response_out)
  );
  always @(posedge clock) begin
    destination <= issue_in.valid ? issue_in.bits.rd : destination;
    remainder_result <=
      issue_in.valid ? issue_in.bits.control.remainder : remainder_result;
    word_result <= issue_in.valid ? issue_in.bits.control.word_result : word_result;
  end // always @(posedge)
  assign completion_out = '{valid: _divider_response_out.valid, bits: _GEN_1};
  assign available = _divider_request_out.ready;
endmodule

module IterativeDivider(
  input                                                      clock,
                                                             reset,
  input  struct packed {logic valid; DividerRequest bits; }  request_in,
  input  struct packed {logic ready; }                       response_in,
  output struct packed {logic ready; }                       request_out,
  output struct packed {logic valid; DividerResponse bits; } response_out
);

  reg                  active;
  reg  [5:0]           count;
  reg  [63:0]          dividend;
  reg  [63:0]          divisor;
  reg  [64:0]          partial_remainder;
  reg                  negate_quotient;
  reg                  negate_remainder;
  reg                  divide_by_zero;
  reg  [63:0]          original_dividend;
  reg                  response_valid;
  DividerResponse      response_bits;
  wire                 _GEN = ~active & (~response_valid | response_in.ready);
  wire                 _GEN_0 = request_in.valid & _GEN;
  wire                 _GEN_1 =
    request_in.bits.signed_mode & request_in.bits.dividend[63];
  wire                 _GEN_2 = request_in.bits.signed_mode & request_in.bits.divisor[63];
  wire [64:0]          _GEN_3 = {partial_remainder[63:0], dividend[63]};
  wire [64:0]          _GEN_4 = {1'h0, divisor};
  wire                 _GEN_5 = _GEN_3 >= _GEN_4;
  wire [64:0]          _GEN_6 = _GEN_5 ? _GEN_3 - _GEN_4 : _GEN_3;
  wire [63:0]          _GEN_7 = {dividend[62:0], 1'h0} | {63'h0, _GEN_5};
  wire                 _GEN_8 = active & (&count);
  wire DividerResponse _GEN_9 =
    '{quotient:
        (divide_by_zero
           ? 64'hFFFFFFFFFFFFFFFF
           : negate_quotient ? 64'h0 - _GEN_7 : _GEN_7),
      remainder:
        (divide_by_zero
           ? original_dividend
           : negate_remainder ? 64'h0 - _GEN_6[63:0] : _GEN_6[63:0])};
  wire                 _GEN_10 = _GEN_8 | ~active;
  always @(posedge clock) begin
    if (reset) begin
      active <= 1'h0;
      count <= 6'h0;
      response_valid <= 1'h0;
    end
    else begin
      active <= _GEN_0 | ~_GEN_8 & active;
      count <= _GEN_0 ? 6'h0 : _GEN_10 ? count : count + 6'h1;
      response_valid <=
        ~_GEN_0
        & (_GEN_8 | (active | ~(response_valid & response_in.ready)) & response_valid);
    end
  end // always @(posedge)
  always @(posedge clock) begin
    dividend <=
      _GEN_0
        ? (_GEN_1 ? 64'h0 - request_in.bits.dividend : request_in.bits.dividend)
        : _GEN_10 ? dividend : _GEN_7;
    divisor <=
      _GEN_0
        ? (_GEN_2 ? 64'h0 - request_in.bits.divisor : request_in.bits.divisor)
        : divisor;
    partial_remainder <= _GEN_0 ? 65'h0 : _GEN_10 ? partial_remainder : _GEN_6;
    negate_quotient <= _GEN_0 ? _GEN_1 ^ _GEN_2 : negate_quotient;
    negate_remainder <= _GEN_0 ? _GEN_1 : negate_remainder;
    divide_by_zero <= _GEN_0 ? request_in.bits.divisor == 64'h0 : divide_by_zero;
    original_dividend <= _GEN_0 ? request_in.bits.dividend : original_dividend;
    response_bits <= _GEN_0 | ~_GEN_8 ? response_bits : _GEN_9;
  end // always @(posedge)
  assign request_out = '{ready: _GEN};
  assign response_out = '{valid: response_valid, bits: response_bits};
endmodule

module Scoreboard(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [4:0] bits; } set_in,
                                                         clear_in,
  output [31:0]                                          busy
);

  reg  [31:0] state;
  wire [31:0] _GEN = 32'h1 << set_in.bits;
  wire [31:0] _GEN_0 = 32'h1 << clear_in.bits;
  wire        _GEN_1 = ~(set_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_set_free:
      assert property (@(posedge clock) disable iff (_GEN_1)
                         (state & _GEN) == 32'h0 | clear_in.valid
                         & clear_in.bits == set_in.bits);
  `endif // not def SYNTHESIS
  wire        _GEN_2 = ~(clear_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_clear_busy:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         (|(state & _GEN_0)) | set_in.valid
                         & set_in.bits == clear_in.bits);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 32'h0;
    else
      state <=
        set_in.valid | clear_in.valid
          ? (state | (set_in.valid ? _GEN : 32'h0)) & ~(clear_in.valid ? _GEN_0 : 32'h0)
          : state;
  end // always @(posedge)
  assign busy = state;
endmodule

module RicketCsrFile(
  input                                                      clock,
                                                             reset,
  input  struct packed {logic valid; RicketCsrCommit bits; } commit_in,
  output struct packed {logic valid; logic [63:0] bits; }    redirect_out,
  output                                                     writeback_valid,
  output [63:0]                                              writeback_value,
  output [1:0]                                               privilege,
  output [63:0]                                              mstatus,
                                                             satp
);

  reg  [1:0]          privilege_state;
  RicketCsrState      state;
  wire                _GEN = commit_in.bits.csr_address == 12'h100;
  wire                _GEN_0 = commit_in.bits.csr_address == 12'h104;
  wire                _GEN_1 = commit_in.bits.csr_address == 12'h105;
  wire                _GEN_2 = commit_in.bits.csr_address == 12'h106;
  wire                _GEN_3 = commit_in.bits.csr_address == 12'h10A;
  wire                _GEN_4 = commit_in.bits.csr_address == 12'h140;
  wire                _GEN_5 = commit_in.bits.csr_address == 12'h141;
  wire                _GEN_6 = commit_in.bits.csr_address == 12'h142;
  wire                _GEN_7 = commit_in.bits.csr_address == 12'h143;
  wire                _GEN_8 = commit_in.bits.csr_address == 12'h144;
  wire                _GEN_9 = commit_in.bits.csr_address == 12'h180;
  wire                _GEN_10 = commit_in.bits.csr_address == 12'h300;
  wire                _GEN_11 = commit_in.bits.csr_address == 12'h301;
  wire                _GEN_12 = commit_in.bits.csr_address == 12'h302;
  wire                _GEN_13 = commit_in.bits.csr_address == 12'h303;
  wire                _GEN_14 = commit_in.bits.csr_address == 12'h304;
  wire                _GEN_15 = commit_in.bits.csr_address == 12'h305;
  wire                _GEN_16 = commit_in.bits.csr_address == 12'h306;
  wire                _GEN_17 = commit_in.bits.csr_address == 12'h30A;
  wire                _GEN_18 = commit_in.bits.csr_address == 12'h340;
  wire                _GEN_19 = commit_in.bits.csr_address == 12'h341;
  wire                _GEN_20 = commit_in.bits.csr_address == 12'h342;
  wire                _GEN_21 = commit_in.bits.csr_address == 12'h343;
  wire [63:0]         _GEN_22 =
    _GEN
      ? {44'h0, state.mstatus[19:0] & 20'hC0133}
      : _GEN_0
          ? state.mie & state.mideleg
          : _GEN_1
              ? state.stvec
              : _GEN_2
                  ? state.scounteren
                  : _GEN_3
                      ? 64'h0
                      : _GEN_4
                          ? state.sscratch
                          : _GEN_5
                              ? state.sepc
                              : _GEN_6
                                  ? state.scause
                                  : _GEN_7
                                      ? state.stval
                                      : _GEN_8
                                          ? 64'h0
                                          : _GEN_9
                                              ? state.satp
                                              : _GEN_10
                                                  ? state.mstatus
                                                  : _GEN_11
                                                      ? 64'h8000000000140101
                                                      : _GEN_12
                                                          ? state.medeleg
                                                          : _GEN_13
                                                              ? state.mideleg
                                                              : _GEN_14
                                                                  ? state.mie
                                                                  : _GEN_15
                                                                      ? state.mtvec
                                                                      : _GEN_16
                                                                          ? state.mcounteren
                                                                          : _GEN_17
                                                                              ? 64'h0
                                                                              : _GEN_18
                                                                                  ? state.mscratch
                                                                                  : _GEN_19
                                                                                      ? state.mepc
                                                                                      : _GEN_20
                                                                                          ? state.mcause
                                                                                          : _GEN_21
                                                                                              ? state.mtval
                                                                                              : 64'h0;
  wire                _GEN_23 = commit_in.bits.csr_operation == 2'h1;
  wire                _GEN_24 = commit_in.bits.csr_operation == 2'h2;
  wire                _GEN_25 =
    _GEN_23 | (_GEN_24 | (&commit_in.bits.csr_operation)) & (|commit_in.bits.csr_source);
  wire                _GEN_26 =
    (_GEN | _GEN_0 | _GEN_1 | _GEN_2 | _GEN_3 | _GEN_4 | _GEN_5 | _GEN_6 | _GEN_7 | _GEN_8
     | _GEN_9 | _GEN_10 | _GEN_11 | _GEN_12 | _GEN_13 | _GEN_14 | _GEN_15 | _GEN_16
     | _GEN_17 | _GEN_18 | _GEN_19 | _GEN_20 | _GEN_21
     | commit_in.bits.csr_address == 12'h344 | commit_in.bits.csr_address == 12'hF11
     | commit_in.bits.csr_address == 12'hF12 | commit_in.bits.csr_address == 12'hF13
     | commit_in.bits.csr_address == 12'hF14)
    & privilege_state >= commit_in.bits.csr_address[9:8]
    & ~(_GEN_25 & (&(commit_in.bits.csr_address[11:10])));
  wire                _GEN_27 = |commit_in.bits.csr_operation;
  wire                _GEN_28 = commit_in.valid & _GEN_27;
  wire                _GEN_29 = commit_in.valid & _GEN_27 & ~_GEN_26;
  wire                _GEN_30 = commit_in.bits.system_operation == 3'h3;
  wire                _GEN_31 = privilege_state != 2'h3;
  wire                _GEN_32 = commit_in.bits.system_operation == 3'h4;
  wire                _GEN_33 = privilege_state == 2'h0;
  wire                _GEN_34 = commit_in.valid & (_GEN_30 & _GEN_31 | _GEN_32 & _GEN_33);
  wire                _GEN_35 = commit_in.valid & commit_in.bits.exception_valid;
  wire                _GEN_36 = commit_in.valid & commit_in.bits.system_operation == 3'h1;
  wire                _GEN_37 = commit_in.valid & commit_in.bits.system_operation == 3'h2;
  wire                _GEN_38 = _GEN_35 | _GEN_29 | _GEN_34 | _GEN_36 | _GEN_37;
  wire [63:0]         _GEN_39 =
    _GEN_35
      ? commit_in.bits.exception_cause
      : _GEN_36
          ? (_GEN_33 ? 64'h8 : {62'h2, privilege_state != 2'h1, 1'h1})
          : {63'h1, _GEN_37};
  wire [63:0]         _GEN_40 =
    _GEN_35
      ? commit_in.bits.exception_value
      : _GEN_29 | _GEN_34 ? {32'h0, commit_in.bits.instruction} : 64'h0;
  wire                _GEN_41 =
    _GEN_38 & _GEN_31
    & (_GEN_39 == 64'h0
         ? state.medeleg[0]
         : _GEN_39 == 64'h2
             ? state.medeleg[2]
             : _GEN_39 == 64'h3
                 ? state.medeleg[3]
                 : _GEN_39 == 64'h4
                     ? state.medeleg[4]
                     : _GEN_39 == 64'h6
                         ? state.medeleg[6]
                         : _GEN_39 == 64'h8
                             ? state.medeleg[8]
                             : _GEN_39 == 64'hC
                                 ? state.medeleg[12]
                                 : _GEN_39 == 64'hD
                                     ? state.medeleg[13]
                                     : _GEN_39 == 64'hF & state.medeleg[15]);
  wire [63:0]         _GEN_42 =
    _GEN_23
      ? commit_in.bits.csr_source
      : _GEN_24
          ? _GEN_22 | commit_in.bits.csr_source
          : ({64{commit_in.bits.csr_operation != 2'h3}} | ~commit_in.bits.csr_source)
            & _GEN_22;
  wire                _GEN_43 = _GEN_28 & _GEN_26 & _GEN_25;
  wire                _GEN_44 = commit_in.valid & ~_GEN_38 & _GEN_30;
  wire                _GEN_45 = commit_in.valid & ~_GEN_38 & _GEN_32;
  wire [1:0]          _GEN_46 =
