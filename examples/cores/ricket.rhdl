module SyncRam1RW_3(
  input                                                                                   clock,
                                                                                          reset,
  input  struct packed {struct packed {logic valid; ReadWriteRequest_2 bits; } request; } port_in,
  output struct packed {struct packed {logic valid; logic [31:0][7:0] bits; } response; } port_out
);

  wire [31:0]      _GEN;
  wire [31:0][7:0] _GEN_0;
  wire             _GEN_1;
  wire             _GEN_2;
  wire [5:0]       _GEN_3;
  wire [255:0]     _GEN_4;
  wire [255:0]     _storage_ext_RW0_rdata;
  storage_64x256_0 storage_ext (
    .RW0_addr  (_GEN_3),
    .RW0_en    (_GEN_2),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_1),
    .RW0_wdata (_GEN_4),
    .RW0_rdata (_storage_ext_RW0_rdata),
    .RW0_wmask (_GEN)
  );
  assign _GEN_4 = /*cast(bit[255:0])*/_GEN_0;
  wire [31:0][7:0] _GEN_5 = /*cast(bit[31:0][7:0])*/_storage_ext_RW0_rdata;
  reg              response_valid;
  assign _GEN_3 = port_in.request.bits.address;
  assign _GEN_2 = port_in.request.valid;
  assign _GEN_1 = port_in.request.bits.write;
  assign _GEN_0 = port_in.request.bits.data;
  assign _GEN = port_in.request.bits.mask;
  wire struct packed {logic valid; logic [31:0][7:0] bits; } _GEN_6 =
    '{valid: response_valid, bits: _GEN_5};
  always @(posedge clock) begin
    if (reset)
      response_valid <= 1'h0;
    else
      response_valid <= _GEN_2 & ~_GEN_1;
  end // always @(posedge)
  assign port_out = '{response: _GEN_6};
endmodule

module LoadGen(
  input  [63:0] address,
                data,
  input  [1:0]  width,
  input         unsigned_load,
  output [63:0] value
);

  wire [63:0]      _GEN = data >> {58'h0, address[2:0], 3'h0};
  wire [3:0][63:0] _GEN_0 =
    {{data},
     {{{32{_GEN[31]}}, _GEN[31:0]}},
     {{{48{_GEN[15]}}, _GEN[15:0]}},
     {{{56{_GEN[7]}}, _GEN[7:0]}}};
  wire [3:0][63:0] _GEN_1 =
    {{data}, {{32'h0, _GEN[31:0]}}, {{48'h0, _GEN[15:0]}}, {{56'h0, _GEN[7:0]}}};
  assign value = unsigned_load ? _GEN_1[width] : _GEN_0[width];
endmodule

module StoreGen(
  input  [63:0] address,
                value,
  input  [1:0]  width,
  output [63:0] data,
  output [7:0]  mask
);

  wire [3:0][7:0] _GEN = '{8'hFF, 8'hF, 8'h3, 8'h1};
  assign data = value << {58'h0, address[2:0], 3'h0};
  assign mask = _GEN[width] << address[2:0];
endmodule

module RicketLineRefill_1(
  input                                                                                                                         clock,
                                                                                                                                reset,
  input  struct packed {logic valid; RicketLineRefillCommand_1 bits; }                                                          command_in,
  input  struct packed {logic ready; }                                                                                          completion_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; } memory_in,
  output struct packed {logic ready; }                                                                                          command_out,
  output struct packed {logic valid; RicketLineRefillResult_1 bits; }                                                           completion_out,
  output struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }  memory_out
);

  wire [3:0][63:0]                   _GEN = '{64'h0, 64'h0, 64'h0, 64'h0};
  reg                                active_state;
  reg  [63:0]                        line_address;
  RicketDataReq                      context_0;
  reg  [2:0]                         requested;
  reg  [2:0]                         received;
  reg  [3:0][63:0]                   line;
  wire                               _GEN_0 = command_in.valid & ~active_state;
  `ifndef SYNTHESIS
    line_refill_address_aligned:
      assert property (@(posedge clock) disable iff (reset)
                         ~_GEN_0 | command_in.bits.line_address[4:0] == 5'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_1 = active_state & ~(requested[2]);
  wire SimpleMemoryReq               _GEN_2 =
    '{address: (line_address + {58'h0, requested, 3'h0}),
      write: (1'h0),
      data: (64'h0),
      mask: (8'hFF)};
  wire [3:0][63:0]                   _GEN_3 =
    {{(&(received[1:0])) ? memory_in.response.bits.data : line[2'h3]},
     {received[1:0] == 2'h2 ? memory_in.response.bits.data : line[2'h2]},
     {received[1:0] == 2'h1 ? memory_in.response.bits.data : line[2'h1]},
     {received[1:0] == 2'h0 ? memory_in.response.bits.data : line[2'h0]}};
  wire                               _GEN_4 = received == 3'h3;
  wire RicketLineRefillResult_1      _GEN_5 =
    '{line_address: line_address, context_0: context_0, line: _GEN_3};
  wire                               _GEN_6 =
    active_state & (~_GEN_4 | completion_in.ready);
  wire                               _GEN_7 = _GEN_1 & memory_in.request.ready;
  wire                               _GEN_8 = memory_in.response.valid & _GEN_6;
  wire                               _GEN_9 = _GEN_7 | _GEN_8;
  wire                               _GEN_10 = _GEN_9 & _GEN_8 & ~_GEN_4;
  wire struct packed {logic valid; SimpleMemoryReq bits; } _GEN_11 =
    '{valid: _GEN_1, bits: _GEN_2};
  wire struct packed {logic ready; } _GEN_12 = '{ready: _GEN_6};
  always @(posedge clock) begin
    if (reset) begin
      active_state <= 1'h0;
      line_address <= 64'h0;
      requested <= 3'h0;
      received <= 3'h0;
      line <= _GEN;
    end
    else begin
      active_state <= _GEN_0 | (~_GEN_9 | ~(_GEN_8 & _GEN_4)) & active_state;
      line_address <= _GEN_0 ? command_in.bits.line_address : line_address;
      requested <= _GEN_0 ? 3'h0 : _GEN_9 & _GEN_7 ? requested + 3'h1 : requested;
      received <= _GEN_0 ? 3'h0 : _GEN_10 ? received + 3'h1 : received;
      line <= _GEN_0 ? _GEN : _GEN_10 ? _GEN_3 : line;
    end
  end // always @(posedge)
  always @(posedge clock)
    context_0 <= _GEN_0 ? command_in.bits.context_0 : context_0;
  assign command_out = '{ready: (~active_state)};
  assign completion_out =
    '{valid: (active_state & memory_in.response.valid & _GEN_4), bits: _GEN_5};
  assign memory_out = '{request: _GEN_11, response: _GEN_12};
endmodule

module Pipe_3(
  input                                                    clock,
                                                           reset,
  input  struct packed {logic valid; RicketDataReq bits; } ingress_in,
  input  struct packed {logic ready; }                     egress_in,
  output struct packed {logic ready; }                     ingress_out,
  output struct packed {logic valid; RicketDataReq bits; } egress_out
);

  reg  [0:0]              stage_valid;
  RicketDataReq[0:0]      stage_bits;
  wire                    _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire                    _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire RicketDataReq      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module ValidPipe_2(
  input                                                     clock,
                                                            reset,
  input  struct packed {logic valid; RicketDataResp bits; } ingress_in,
  output struct packed {logic valid; RicketDataResp bits; } egress_out
);

  reg  [0:0]               stage_valid;
  RicketDataResp[0:0]      stage_bits;
  wire RicketDataResp      _GEN = ingress_in.valid ? ingress_in.bits : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= ingress_in.valid;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN;
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule
}>>|

