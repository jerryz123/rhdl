module RicketCleanSnoop(
  input                                                                   clock,
                                                                          reset,
                                                                          cache_ready,
  input  struct packed {logic valid; CHISnpFlit bits; }                   snoops_in,
  input  struct packed {logic ready; }                                    responses_in,
  input  struct packed {logic valid; RicketCleanSnoopLookupResult bits; } lookup_result_in,
  output                                                                  pending,
  output [63:0]                                                           address,
  output struct packed {logic ready; }                                    snoops_out,
  output struct packed {logic valid; CHIRspFlit bits; }                   responses_out,
  output struct packed {logic valid; logic [63:0] bits; }                 lookup_out,
  output struct packed {logic valid; RicketCleanSnoopUpdate bits; }       update_out
);

  reg                         active_state;
  reg                         uses_lookup;
  CHISnpFlit                  request;
  reg                         lookup_complete;
  reg                         line_hit;
  reg  [1:0]                  line_state;
  reg                         dvm_first_pending;
  reg  [6:0]                  dvm_source_id;
