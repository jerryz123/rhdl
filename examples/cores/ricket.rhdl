    .lookup_out       (_snoop_lookup_out),
    .update_out       (_snoop_update_out)
  );
  RicketWriteUnique write_unique (
    .clock          (clock),
    .reset          (reset),
    .command_in     (_GEN_31),
    .completion_in  (_GEN_0),
    .requests_in    (_protocol_requests_ingress_1_out),
    .data_in        (chi_in.request_data),
    .responses_in   (_GEN_30),
    .command_out    (_write_unique_command_out),
    .completion_out (/* unused */),
    .requests_out   (_write_unique_requests_out),
    .data_out       (_write_unique_data_out),
    .responses_out  (_write_unique_responses_out)
  );
  Pipe_3 lookup (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_GEN_29),
    .egress_in   (_GEN_27),
    .ingress_out (_lookup_ingress_out),
    .egress_out  (_lookup_egress_out)
  );
  ValidPipe_2 responses (
    .clock      (clock),
    .reset      (reset),
    .ingress_in (_GEN_28),
    .egress_out (_responses_egress_out)
  );
  Arbiter_3 protocol_requests (
    .ingress_0_in  (_refill_requests_out),
    .ingress_1_in  (_write_unique_requests_out),
    .egress_in     (chi_in.requests),
    .ingress_0_out (_protocol_requests_ingress_0_out),
    .ingress_1_out (_protocol_requests_ingress_1_out),
    .egress_out    (_protocol_requests_egress_out),
    .chosen        (/* unused */)
  );
  Arbiter_2 protocol_responses (
    .ingress_0_in  (_refill_acknowledgements_out),
    .ingress_1_in  (_snoop_responses_out),
    .egress_in     (chi_in.requester_responses),
    .ingress_0_out (_protocol_responses_ingress_0_out),
    .ingress_1_out (_protocol_responses_ingress_1_out),
    .egress_out    (_protocol_responses_egress_out),
    .chosen        (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      valid_lines <=
        '{1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
