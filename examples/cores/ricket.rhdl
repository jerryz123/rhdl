module SyncRam1RW_3(
  input                                                                                   clock,
                                                                                          reset,
  input  struct packed {struct packed {logic valid; ReadWriteRequest_3 bits; } request; } port_in,
  output struct packed {struct packed {logic valid; logic [63:0][7:0] bits; } response; } port_out
);

  wire [63:0]      _GEN;
  wire [63:0][7:0] _GEN_0;
  wire             _GEN_1;
  wire             _GEN_2;
  wire [5:0]       _GEN_3;
  wire [511:0]     _GEN_4;
  wire [511:0]     _storage_ext_RW0_rdata;
  storage_64x512_0 storage_ext (
    .RW0_addr  (_GEN_3),
    .RW0_en    (_GEN_2),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_1),
    .RW0_wdata (_GEN_4),
    .RW0_rdata (_storage_ext_RW0_rdata),
    .RW0_wmask (_GEN)
  );
  assign _GEN_4 = /*cast(bit[511:0])*/_GEN_0;
  wire [63:0][7:0] _GEN_5 = /*cast(bit[63:0][7:0])*/_storage_ext_RW0_rdata;
  reg              response_valid;
  assign _GEN_3 = port_in.request.bits.address;
  assign _GEN_2 = port_in.request.valid;
  assign _GEN_1 = port_in.request.bits.write;
  assign _GEN_0 = port_in.request.bits.data;
  assign _GEN = port_in.request.bits.mask;
  wire struct packed {logic valid; logic [63:0][7:0] bits; } _GEN_6 =
    '{valid: response_valid, bits: _GEN_5};
  always @(posedge clock) begin
    if (reset)
      response_valid <= 1'h0;
    else
      response_valid <= _GEN_2 & ~_GEN_1;
  end // always @(posedge)
  assign port_out = '{response: _GEN_6};
endmodule

module LoadGen(
  input  [63:0] address,
                data,
  input  [1:0]  width,
  input         unsigned_load,
  output [63:0] value
);

  wire [63:0]      _GEN = data >> {58'h0, address[2:0], 3'h0};
  wire [3:0][63:0] _GEN_0 =
    {{data},
     {{{32{_GEN[31]}}, _GEN[31:0]}},
     {{{48{_GEN[15]}}, _GEN[15:0]}},
     {{{56{_GEN[7]}}, _GEN[7:0]}}};
  wire [3:0][63:0] _GEN_1 =
    {{data}, {{32'h0, _GEN[31:0]}}, {{48'h0, _GEN[15:0]}}, {{56'h0, _GEN[7:0]}}};
  assign value = unsigned_load ? _GEN_1[width] : _GEN_0[width];
endmodule

module StoreGen(
  input  [63:0] address,
                value,
  input  [1:0]  width,
  output [63:0] data,
  output [7:0]  mask
);

  wire [3:0][7:0] _GEN = '{8'hFF, 8'hF, 8'h3, 8'h1};
  assign data = value << {58'h0, address[2:0], 3'h0};
  assign mask = _GEN[width] << address[2:0];
endmodule

