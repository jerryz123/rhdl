  reg         _RW0_rmode_d0;
  always @(posedge RW0_clk) begin
    _RW0_raddr_d0 <= RW0_addr;
    _RW0_ren_d0 <= RW0_en;
    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [52:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 53'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmode)
      Memory[RW0_addr] <= RW0_wdata;
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

module SyncRam1RW(
  input                                                                                   clock,
                                                                                          reset,
  input  struct packed {struct packed {logic valid; ReadWriteRequest bits; } request; }   port_in,
  output struct packed {struct packed {logic valid; logic [0:0][52:0] bits; } response; } port_out
);

  wire [0:0][52:0] _GEN;
  wire             _GEN_0;
  wire             _GEN_1;
  wire [5:0]       _GEN_2;
  wire [52:0]      _GEN_3;
  wire [52:0]      _storage_ext_RW0_rdata;
  storage_64x53 storage_ext (
    .RW0_addr  (_GEN_2),
    .RW0_en    (_GEN_1),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_0),
    .RW0_wdata (_GEN_3),
    .RW0_rdata (_storage_ext_RW0_rdata)
  );
  assign _GEN_3 = /*cast(bit[52:0])*/_GEN;
  wire [0:0][52:0] _GEN_4 = /*cast(bit[0:0][52:0])*/_storage_ext_RW0_rdata;
  reg              response_valid;
  assign _GEN_2 = port_in.request.bits.address;
  assign _GEN_1 = port_in.request.valid;
  assign _GEN_0 = port_in.request.bits.write;
  assign _GEN = port_in.request.bits.data;
  wire struct packed {logic valid; logic [0:0][52:0] bits; } _GEN_5 =
    '{valid: response_valid, bits: _GEN_4};
  always @(posedge clock) begin
    if (reset)
      response_valid <= 1'h0;
    else
      response_valid <= _GEN_1 & ~_GEN_0;
  end // always @(posedge)
  assign port_out = '{response: _GEN_5};
endmodule

module storage_64x256(
  input  [5:0]   RW0_addr,
  input          RW0_en,
                 RW0_clk,
                 RW0_wmode,
  input  [255:0] RW0_wdata,
  output [255:0] RW0_rdata,
  input  [3:0]   RW0_wmask
);

  reg  [255:0] Memory[0:63];
  reg  [5:0]   _RW0_raddr_d0;
  reg          _RW0_ren_d0;
  reg          _RW0_rmode_d0;
  always @(posedge RW0_clk) begin
    _RW0_raddr_d0 <= RW0_addr;
    _RW0_ren_d0 <= RW0_en;
    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [255:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 256'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[0] & RW0_wmode)
      Memory[RW0_addr][32'h0 +: 64] <= RW0_wdata[63:0];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[1] & RW0_wmode)
      Memory[RW0_addr][32'h40 +: 64] <= RW0_wdata[127:64];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[2] & RW0_wmode)
      Memory[RW0_addr][32'h80 +: 64] <= RW0_wdata[191:128];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[3] & RW0_wmode)
      Memory[RW0_addr][32'hC0 +: 64] <= RW0_wdata[255:192];
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

module SyncRam1RW_1(
  input                                                                                   clock,
                                                                                          reset,
  input  struct packed {struct packed {logic valid; ReadWriteRequest_1 bits; } request; } port_in,
  output struct packed {struct packed {logic valid; logic [3:0][63:0] bits; } response; } port_out
);

  wire [3:0]       _GEN;
  wire [3:0][63:0] _GEN_0;
  wire             _GEN_1;
  wire             _GEN_2;
  wire [5:0]       _GEN_3;
  wire [255:0]     _GEN_4;
  wire [255:0]     _storage_ext_RW0_rdata;
  storage_64x256 storage_ext (
    .RW0_addr  (_GEN_3),
    .RW0_en    (_GEN_2),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_1),
    .RW0_wdata (_GEN_4),
    .RW0_rdata (_storage_ext_RW0_rdata),
    .RW0_wmask (_GEN)
  );
  assign _GEN_4 = /*cast(bit[255:0])*/_GEN_0;
  wire [3:0][63:0] _GEN_5 = /*cast(bit[3:0][63:0])*/_storage_ext_RW0_rdata;
  reg              response_valid;
  assign _GEN_3 = port_in.request.bits.address;
  assign _GEN_2 = port_in.request.valid;
  assign _GEN_1 = port_in.request.bits.write;
  assign _GEN_0 = port_in.request.bits.data;
  assign _GEN = port_in.request.bits.mask;
  wire struct packed {logic valid; logic [3:0][63:0] bits; } _GEN_6 =
    '{valid: response_valid, bits: _GEN_5};
  always @(posedge clock) begin
    if (reset)
      response_valid <= 1'h0;
    else
      response_valid <= _GEN_2 & ~_GEN_1;
  end // always @(posedge)
  assign port_out = '{response: _GEN_6};
endmodule

module RicketLineRefill(
  input                                                                                                                         clock,
                                                                                                                                reset,
  input  struct packed {logic valid; RicketLineRefillCommand bits; }                                                            command_in,
  input  struct packed {logic ready; }                                                                                          completion_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; } memory_in,
  output struct packed {logic ready; }                                                                                          command_out,
  output struct packed {logic valid; RicketLineRefillResult bits; }                                                             completion_out,
  output struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }  memory_out
);

  wire [3:0][63:0]                   _GEN = '{64'h0, 64'h0, 64'h0, 64'h0};
  reg                                active_state;
  reg  [63:0]                        line_address;
  reg  [63:0]                        context_0;
  reg  [2:0]                         requested;
  reg  [2:0]                         received;
  reg  [3:0][63:0]                   line;
  wire                               _GEN_0 = command_in.valid & ~active_state;
  `ifndef SYNTHESIS
    line_refill_address_aligned:
      assert property (@(posedge clock) disable iff (reset)
                         ~_GEN_0 | command_in.bits.line_address[4:0] == 5'h0);
  `endif // not def SYNTHESIS
  wire                               _GEN_1 = active_state & ~(requested[2]);
  wire SimpleMemoryReq               _GEN_2 =
    '{address: (line_address + {58'h0, requested, 3'h0}),
      write: (1'h0),
      data: (64'h0),
      mask: (8'hFF)};
  wire [3:0][63:0]                   _GEN_3 =
    {{(&(received[1:0])) ? memory_in.response.bits.data : line[2'h3]},
     {received[1:0] == 2'h2 ? memory_in.response.bits.data : line[2'h2]},
     {received[1:0] == 2'h1 ? memory_in.response.bits.data : line[2'h1]},
     {received[1:0] == 2'h0 ? memory_in.response.bits.data : line[2'h0]}};
  wire                               _GEN_4 = received == 3'h3;
  wire RicketLineRefillResult        _GEN_5 =
    '{line_address: line_address, context_0: context_0, line: _GEN_3};
  wire                               _GEN_6 =
    active_state & (~_GEN_4 | completion_in.ready);
  wire                               _GEN_7 = _GEN_1 & memory_in.request.ready;
  wire                               _GEN_8 = memory_in.response.valid & _GEN_6;
  wire                               _GEN_9 = _GEN_7 | _GEN_8;
  wire                               _GEN_10 = _GEN_9 & _GEN_8 & ~_GEN_4;
  wire struct packed {logic valid; SimpleMemoryReq bits; } _GEN_11 =
    '{valid: _GEN_1, bits: _GEN_2};
  wire struct packed {logic ready; } _GEN_12 = '{ready: _GEN_6};
  always @(posedge clock) begin
    if (reset) begin
      active_state <= 1'h0;
      line_address <= 64'h0;
      requested <= 3'h0;
      received <= 3'h0;
      line <= _GEN;
    end
    else begin
      active_state <= _GEN_0 | (~_GEN_9 | ~(_GEN_8 & _GEN_4)) & active_state;
      line_address <= _GEN_0 ? command_in.bits.line_address : line_address;
      requested <= _GEN_0 ? 3'h0 : _GEN_9 & _GEN_7 ? requested + 3'h1 : requested;
      received <= _GEN_0 ? 3'h0 : _GEN_10 ? received + 3'h1 : received;
      line <= _GEN_0 ? _GEN : _GEN_10 ? _GEN_3 : line;
    end
  end // always @(posedge)
  always @(posedge clock)
    context_0 <= _GEN_0 ? command_in.bits.context_0 : context_0;
  assign command_out = '{ready: (~active_state)};
  assign completion_out =
    '{valid: (active_state & memory_in.response.valid & _GEN_4), bits: _GEN_5};
  assign memory_out = '{request: _GEN_11, response: _GEN_12};
endmodule

module Pipe_2(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; logic [63:0] bits; } ingress_in,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_out,
  output struct packed {logic valid; logic [63:0] bits; } egress_out
);

  reg  [0:0]       stage_valid;
  reg  [0:0][63:0] stage_bits;
  wire             _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire             _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire [63:0]      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module Arbiter_1(
  input  struct packed {logic valid; RicketInstructionResp bits; } ingress_0_in,
                                                                   ingress_1_in,
  input  struct packed {logic ready; }                             egress_in,
  output struct packed {logic ready; }                             ingress_0_out,
                                                                   ingress_1_out,
  output struct packed {logic valid; RicketInstructionResp bits; } egress_out,
  output                                                           chosen
);

  wire [1:0] _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0] _GEN_0 = _GEN & {~(_GEN[0]), 1'h1};
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_0[1'h0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_0[1'h1])};
  assign egress_out =
    '{valid: (|_GEN),
      bits:
        (ingress_0_in.valid
           ? ingress_0_in.bits
           : ingress_1_in.valid ? ingress_1_in.bits : ingress_0_in.bits)};
  assign chosen = _GEN[1] & ~(_GEN[0]);
endmodule

module Queue_1(
  input                                                            clock,
                                                                   reset,
  input  struct packed {logic valid; RicketInstructionResp bits; } ingress_in,
  input  struct packed {logic ready; }                             egress_in,
  output struct packed {logic ready; }                             ingress_out,
  output struct packed {logic valid; RicketInstructionResp bits; } egress_out,
  output [1:0]                                                     count
);

  wire RicketInstructionResp _GEN;
  wire                       _GEN_0;
  wire                       _write_pointer_value;
  wire                       _read_pointer_value;
  wire                       _GEN_1 = 1'h0;
  RicketInstructionResp      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]                 occupancy;
  wire                       _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire                       _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3 & ~(_GEN_2 & egress_in.ready);
  wire                       _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter_1 read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter_1 write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out =
    '{valid: (~_GEN_2 | ingress_in.valid),
      bits: (_GEN_2 ? _GEN : storage[_read_pointer_value])};
  assign count = occupancy;
endmodule

module Counter_1(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule

module RicketL1DCache(
  input                                                                                                                         clock,
                                                                                                                                reset,
  input  struct packed {struct packed {logic valid; RicketDataReq bits; } request; }                                            core_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; } memory_in,
  output struct packed {struct packed {logic ready; } request; struct packed {logic valid; RicketDataResp bits; } response; }   core_out,
  output struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }  memory_out
);

  wire                               _GEN;
  wire struct packed {logic valid; RicketDataResp bits; } _responses_egress_out;
  wire struct packed {logic ready; } _lookup_ingress_out;
  wire struct packed {logic valid; RicketDataReq bits; } _lookup_egress_out;
  wire struct packed {logic ready; } _refill_command_out;
  wire struct packed {logic valid; RicketLineRefillResult_1 bits; }
    _refill_completion_out;
  wire
    struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }
    _refill_memory_out;
  wire [63:0]                        _store_gen_data;
  wire [7:0]                         _store_gen_mask;
  wire [63:0]                        _load_gen_value;
  wire struct packed {struct packed {logic valid; logic [31:0][7:0] bits; } response; }
    _lines_port_out;
  wire struct packed {struct packed {logic valid; logic [0:0][52:0] bits; } response; }
    _tags_port_out;
  wire struct packed {logic ready; } _GEN_0 = '{ready: 1'h1};
  reg  [63:0]                        valid_lines;
  reg                                store_active;
  reg                                store_sent;
  reg  [63:0]                        store_address;
  reg  [63:0]                        store_data;
  reg  [7:0]                         store_mask;
  wire                               _GEN_1 =
    valid_lines[_lookup_egress_out.bits.address[10:5]]
    & _tags_port_out.response.bits[1'h0] == _lookup_egress_out.bits.address[63:11];
  wire                               _GEN_2 =
    _lookup_egress_out.valid & _tags_port_out.response.valid
    & _lookup_egress_out.bits.write;
  wire                               _GEN_3 =
    _lookup_egress_out.valid & _tags_port_out.response.valid
    & ~_lookup_egress_out.bits.write;
  wire                               _GEN_4 = _GEN_3 & ~_GEN_1;
  wire [3:0][63:0]                   _GEN_5 =
    /*cast(bit[3:0][63:0])*/_lines_port_out.response.bits;
  wire                               _GEN_6 = ~_GEN_4 | _GEN;
  wire RicketLineRefillCommand_1     _GEN_7 =
    '{line_address: {_lookup_egress_out.bits.address[63:5], 5'h0},
      context_0: _lookup_egress_out.bits};
  assign _GEN = _refill_command_out.ready;
  `ifndef SYNTHESIS
    l1d_refill_command_accepted:
      assert property (@(posedge clock) disable iff (reset) _GEN_6);
  `endif // not def SYNTHESIS
  wire                               _GEN_8 =
    _refill_completion_out.valid | _GEN_2 & _GEN_1;
  `ifndef SYNTHESIS
    l1d_backing_owner_exclusive:
      assert property (@(posedge clock) disable iff (reset) _GEN | ~store_active);
  `endif // not def SYNTHESIS
  wire                               _GEN_9 = _GEN & ~store_active & ~_GEN_4 & ~_GEN_2;
  wire                               _GEN_10 = _lookup_ingress_out.ready & _GEN_9;
  wire                               _GEN_11 = core_in.request.valid & _GEN_10;
  wire                               _GEN_12 = store_active & ~store_sent;
  wire                               _GEN_13 = _refill_memory_out.request.valid | _GEN_12;
  wire SimpleMemoryReq               _GEN_14 =
    '{address: (_GEN_12 ? store_address : _refill_memory_out.request.bits.address),
      write: _GEN_12,
      data: (_GEN_12 ? store_data : _refill_memory_out.request.bits.data),
      mask: (_GEN_12 ? store_mask : _refill_memory_out.request.bits.mask)};
  wire                               _GEN_15 =
    _refill_memory_out.response.ready | store_active & store_sent;
  wire                               _GEN_16 = _GEN_3 & _GEN_1;
  wire RicketDataResp                _GEN_17 =
    '{data: (_GEN_16 | _refill_completion_out.valid ? _load_gen_value : 64'h0),
      tag:
        (_refill_completion_out.valid
           ? _refill_completion_out.bits.context_0.tag
           : _lookup_egress_out.bits.tag)};
  wire [5:0]                         _GEN_18 =
    _GEN_8
      ? (_refill_completion_out.valid
           ? _refill_completion_out.bits.context_0.address[10:5]
           : _lookup_egress_out.bits.address[10:5])
      : core_in.request.bits.address[10:5];
  wire ReadWriteRequest              _GEN_19 =
    '{address: _GEN_18,
      write: _refill_completion_out.valid,
      data:
        ({1{_refill_completion_out.valid
              ? _refill_completion_out.bits.context_0.address[63:11]
              : _lookup_egress_out.bits.address[63:11]}}),
      mask: (1'h1)};
  wire [31:0][7:0]                   _GEN_20 =
    /*cast(bit[31:0][7:0])*/_refill_completion_out.valid
                              ? _refill_completion_out.bits.line
                              : {{(&(_lookup_egress_out.bits.address[4:3]))
                                    ? _store_gen_data
                                    : _GEN_5[2'h3]},
                                 {_lookup_egress_out.bits.address[4:3] == 2'h2
                                    ? _store_gen_data
                                    : _GEN_5[2'h2]},
                                 {_lookup_egress_out.bits.address[4:3] == 2'h1
                                    ? _store_gen_data
                                    : _GEN_5[2'h1]},
                                 {_lookup_egress_out.bits.address[4:3] == 2'h0
                                    ? _store_gen_data
                                    : _GEN_5[2'h0]}};
  wire ReadWriteRequest_2            _GEN_21 =
    '{address: _GEN_18,
      write: _GEN_8,
      data: _GEN_20,
      mask:
        (_refill_completion_out.valid
           ? 32'hFFFFFFFF
           : {24'h0, _store_gen_mask}
             << {27'h0, _lookup_egress_out.bits.address[4:3], 3'h0})};
  wire                               _GEN_22 =
    store_active & ~store_sent & _GEN_13 & memory_in.request.ready;
  wire                               _GEN_23 =
    store_active & store_sent & memory_in.response.valid & _GEN_15;
  wire                               _GEN_24 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h0 | valid_lines[6'h0];
  wire                               _GEN_25 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h1 | valid_lines[6'h1];
  wire                               _GEN_26 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h2 | valid_lines[6'h2];
  wire                               _GEN_27 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h3 | valid_lines[6'h3];
  wire                               _GEN_28 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h4 | valid_lines[6'h4];
  wire                               _GEN_29 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h5 | valid_lines[6'h5];
  wire                               _GEN_30 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h6 | valid_lines[6'h6];
  wire                               _GEN_31 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h7 | valid_lines[6'h7];
  wire                               _GEN_32 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h8 | valid_lines[6'h8];
  wire                               _GEN_33 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'h9 | valid_lines[6'h9];
  wire                               _GEN_34 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'hA | valid_lines[6'hA];
  wire                               _GEN_35 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'hB | valid_lines[6'hB];
  wire                               _GEN_36 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'hC | valid_lines[6'hC];
  wire                               _GEN_37 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'hD | valid_lines[6'hD];
  wire                               _GEN_38 =
    _refill_completion_out.valid
    & _refill_completion_out.bits.context_0.address[10:5] == 6'hE | valid_lines[6'hE];
  wire                               _GEN_39 =
    _refill_completion_out.valid
