    .reserved     (_snoop_receiver_reserved)
  );
  always @(posedge clock) begin
    if (reset) begin
      valid_lines <= _GEN_6;
      refill_live <= 1'h0;
      refill_installable <= 1'h0;
      outstanding <= 2'h0;
      transmit_request <= 1'h0;
      receive_ack <= 1'h0;
      rn_tx_previous_request <= 1'h0;
      rn_tx_previous_ack <= 1'h0;
      rn_rx_previous_request <= 1'h0;
      rn_rx_previous_ack <= 1'h0;
      rn_tx_req_credit_balance <= 2'h0;
      rn_tx_rsp_credit_balance <= 2'h0;
      rn_tx_dat_credit_balance <= 2'h0;
      rn_rx_rsp_credit_balance <= 2'h0;
      rn_rx_dat_credit_balance <= 2'h0;
      rn_rx_snp_credit_balance <= 2'h0;
      reads <=
        '{'{phase: 2'h0,
            txn_id: 12'h0,
            home_id: 7'h0,
            comp_ack_txn_id: 12'h0,
            expected_data_ids: 4'h0,
            received_data_ids: 4'h0,
            comp_ack_seen: 1'h0},
          '{phase: 2'h0,
            txn_id: 12'h0,
            home_id: 7'h0,
            comp_ack_txn_id: 12'h0,
            expected_data_ids: 4'h0,
            received_data_ids: 4'h0,
            comp_ack_seen: 1'h0}};
      snoops <=
        '{'{live: 1'h0,
            forward: 1'h0,
            txn_id: 12'h0,
            home_id: 7'h0,
            forward_txn_id: 12'h0,
            forward_id: 7'h0,
            response_seen: 1'h0,
            forward_data_seen: 1'h0},
          '{live: 1'h0,
            forward: 1'h0,
            txn_id: 12'h0,
            home_id: 7'h0,
            forward_txn_id: 12'h0,
            forward_id: 7'h0,
            response_seen: 1'h0,
            forward_data_seen: 1'h0}};
    end
    else begin
      valid_lines <=
        core_in.invalidate_all | _snoop_receiver_egress_out.valid & _GEN_13 & _GEN_10
          ? _GEN_6
          : _GEN_229;
      refill_live <=
        ~_GEN_7 & (_GEN_231 ? _GEN_219 | ~_GEN_220 & refill_live : refill_live);
      refill_installable <=
        ~core_in.invalidate_all & (_GEN_219 | ~_GEN_220 & refill_installable);
      outstanding <=
        _GEN_7
          ? 2'h0
          : _GEN_231 & _GEN_230
              ? (_GEN_210 ? outstanding + 2'h1 : outstanding - 2'h1)
              : outstanding;
      transmit_request <=
        ~transmit_request & ~chi_in.tx_link_active_ack | transmit_request;
      receive_ack <=
        ~receive_ack & chi_in.rx_link_active_request
        | ~(receive_ack & ~chi_in.rx_link_active_request
            & _response_receiver_reserved == 2'h0
            & _response_data_receiver_reserved == 2'h0 & _snoop_receiver_reserved == 2'h0)
        & receive_ack;
      rn_tx_previous_request <= transmit_request;
      rn_tx_previous_ack <= chi_in.tx_link_active_ack;
      rn_rx_previous_request <= chi_in.rx_link_active_request;
      rn_rx_previous_ack <= receive_ack;
      rn_tx_req_credit_balance <=
        chi_in.tx_req.credit ^ _request_transmitter_link_out.valid
          ? (chi_in.tx_req.credit
               ? rn_tx_req_credit_balance + 2'h1
               : rn_tx_req_credit_balance - 2'h1)
          : rn_tx_req_credit_balance;
      rn_tx_rsp_credit_balance <=
        chi_in.tx_rsp.credit ^ _requester_response_transmitter_link_out.valid
          ? (chi_in.tx_rsp.credit
               ? rn_tx_rsp_credit_balance + 2'h1
               : rn_tx_rsp_credit_balance - 2'h1)
          : rn_tx_rsp_credit_balance;
      rn_tx_dat_credit_balance <=
        chi_in.tx_dat.credit ^ _request_data_transmitter_link_out.valid
          ? (chi_in.tx_dat.credit
               ? rn_tx_dat_credit_balance + 2'h1
               : rn_tx_dat_credit_balance - 2'h1)
          : rn_tx_dat_credit_balance;
      rn_rx_rsp_credit_balance <=
        _response_receiver_link_out.credit ^ chi_in.rx_rsp.valid
          ? (_response_receiver_link_out.credit
               ? rn_rx_rsp_credit_balance + 2'h1
               : rn_rx_rsp_credit_balance - 2'h1)
          : rn_rx_rsp_credit_balance;
      rn_rx_dat_credit_balance <=
        _response_data_receiver_link_out.credit ^ chi_in.rx_dat.valid
          ? (_response_data_receiver_link_out.credit
               ? rn_rx_dat_credit_balance + 2'h1
               : rn_rx_dat_credit_balance - 2'h1)
          : rn_rx_dat_credit_balance;
      rn_rx_snp_credit_balance <=
        _snoop_receiver_link_out.credit ^ chi_in.rx_snp.valid
          ? (_snoop_receiver_link_out.credit
               ? rn_rx_snp_credit_balance + 2'h1
               : rn_rx_snp_credit_balance - 2'h1)
          : rn_rx_snp_credit_balance;
      reads[1'h1] <= _GEN_153;
      reads[1'h0] <= _GEN_145;
      snoops[1'h1] <= _GEN_201;
      snoops[1'h0] <= _GEN_194;
    end
  end // always @(posedge)
  assign core_out = '{request: _GEN_246, response: _GEN_247};
  assign chi_out =
    '{tx_link_active_request: transmit_request,
      rx_link_active_ack: receive_ack,
      tx_req: _request_transmitter_link_out,
      tx_rsp: _requester_response_transmitter_link_out,
      tx_dat: _request_data_transmitter_link_out,
      rx_rsp: _response_receiver_link_out,
      rx_dat: _response_data_receiver_link_out,
      rx_snp: _snoop_receiver_link_out};
endmodule

module storage_64x53(
  input  [5:0]  RW0_addr,
  input         RW0_en,
                RW0_clk,
                RW0_wmode,
  input  [52:0] RW0_wdata,
  output [52:0] RW0_rdata
);

  reg  [52:0] Memory[0:63];
  reg  [5:0]  _RW0_raddr_d0;
  reg         _RW0_ren_d0;
  reg         _RW0_rmode_d0;
  always @(posedge RW0_clk) begin
    _RW0_raddr_d0 <= RW0_addr;
    _RW0_ren_d0 <= RW0_en;
    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [52:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 53'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmode)
      Memory[RW0_addr] <= RW0_wdata;
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

