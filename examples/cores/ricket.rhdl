  wire                        _GEN_2 = _GEN_1 & ~reset;
  wire                        _GEN_3 = ~_GEN_2;
  `ifndef SYNTHESIS
    line_refill_address_aligned:
      assert property (@(posedge clock) disable iff (_GEN_3)
                         command_in.bits.line_address[5:0] == 6'h0);
  `endif // not def SYNTHESIS
  wire                        _GEN_4 = ~_GEN_2;
  `ifndef SYNTHESIS
    line_refill_address_fits_chi:
      assert property (@(posedge clock) disable iff (_GEN_4)
                         command_in.bits.line_address[63:44] == 20'h0);
  `endif // not def SYNTHESIS
  wire                        _GEN_5 = ~_GEN_2;
  `ifndef SYNTHESIS
    line_refill_opcode_supported:
      assert property (@(posedge clock) disable iff (_GEN_5)
                         command_in.bits.opcode == 7'h2 | command_in.bits.opcode == 7'h7);
  `endif // not def SYNTHESIS
  wire                        _GEN_6 =
    active_state & ~request_sent
    & (~retry_received | retry_received & retry_credit_received);
  wire                        _GEN_7 = _GEN_6 & requests_in.ready;
  wire                        _GEN_8 = |responses_in.bits.opcode;
  wire                        _GEN_9 = responses_in.bits.opcode == 5'h3;
  wire                        _GEN_10 = responses_in.bits.opcode == 5'h7;
  wire                        _GEN_11 = _GEN_9 | _GEN_10;
  wire                        _GEN_12 =
    ~_GEN_8 | active_state & _GEN_11 & (request_sent | retry_received);
  wire                        _GEN_13 = responses_in.valid & _GEN_12 & _GEN_8;
  wire                        _GEN_14 = _GEN_13 & _GEN_9;
  wire                        _GEN_15 = _GEN_13 & _GEN_10;
  wire                        _GEN_16 = _GEN_13 & ~reset;
  wire                        _GEN_17 = ~_GEN_16;
  `ifndef SYNTHESIS
    line_refill_retry_response_supported:
      assert property (@(posedge clock) disable iff (_GEN_17) _GEN_11);
  `endif // not def SYNTHESIS
  wire                        _GEN_18 = ~_GEN_16;
  `ifndef SYNTHESIS
    line_refill_retry_response_target:
      assert property (@(posedge clock) disable iff (_GEN_18)
                         responses_in.bits.tgt_id == 7'h2);
  `endif // not def SYNTHESIS
  wire                        _GEN_19 = ~_GEN_16;
  `ifndef SYNTHESIS
    line_refill_retry_response_home:
