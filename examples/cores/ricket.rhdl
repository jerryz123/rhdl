          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0,
          1'h0};
    else
      valid_lines <= _GEN_25;
  end // always @(posedge)
  assign core_out =
    '{request: _GEN_41,
      response: _responses_egress_out,
      drained:
        (~_GEN_15 & ~_lookup_egress_out.valid & _GEN & _write_unique_command_out.ready)};
  assign chi_out =
    '{requests: _protocol_requests_egress_out,
      requester_responses: _protocol_responses_egress_out,
      request_data: _write_unique_data_out,
      responses: _GEN_40,
      response_data: _refill_response_data_out,
      snoops: _snoop_snoops_out};
endmodule

