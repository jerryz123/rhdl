module RicketLineRefill(
  input                                                              clock,
                                                                     reset,
  input  struct packed {logic valid; RicketLineRefillCommand bits; } command_in,
  input  struct packed {logic ready; }                               completion_in,
                                                                     requests_in,
                                                                     acknowledgements_in,
  input  struct packed {logic valid; CHIRspFlit bits; }              responses_in,
  input  struct packed {logic valid; CHIDatFlit bits; }              response_data_in,
  output struct packed {logic ready; }                               command_out,
  output struct packed {logic valid; RicketLineRefillResult bits; }  completion_out,
  output struct packed {logic valid; CHIReqFlit bits; }              requests_out,
  output struct packed {logic valid; CHIRspFlit bits; }              acknowledgements_out,
  output struct packed {logic ready; }                               responses_out,
                                                                     response_data_out
);

  wire CHIMemAttr             _GEN =
    '{allocate: 1'h1, cacheable: 1'h1, device: 1'h0, early_write_acknowledge: 1'h1};
  wire [3:0]                  _GEN_0 = '{1'h0, 1'h0, 1'h0, 1'h0};
  reg                         active_state;
  reg                         request_sent;
  reg  [3:0]                  received_packets;
  reg                         acknowledgement_sent;
  reg  [63:0]                 line_address;
  reg  [6:0]                  opcode;
  reg  [63:0]                 context_0;
  reg  [511:0]                line;
  reg  [6:0]                  home_id;
  reg  [11:0]                 dbid;
  reg  [1:0]                  response_state;
  reg                         pass_dirty;
  reg                         retry_received;
  reg                         retry_credit_received;
  reg  [3:0]                  retry_credit_type;
  reg  [3:0]                  granted_credit_type;
