    context_0 <= _GEN_0 ? command_in.bits.context_0 : context_0;
  assign command_out = '{ready: (~active_state)};
  assign completion_out = '{valid: _GEN_26, bits: _GEN_27};
  assign requests_out = '{valid: _GEN_2, bits: _GEN_32};
  assign data_out = '{valid: _GEN_25, bits: _GEN_31};
  assign responses_out = '{ready: _GEN_11};
