module Ricket(
  input                                                                                                                         clock,
                                                                                                                                reset,
  input  struct packed {logic valid; logic [63:0] bits; }                                                                       start_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; } imem_in,
                                                                                                                                dmem_in,
  output struct packed {logic ready; }                                                                                          start_out,
  output struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }  imem_out,
                                                                                                                                dmem_out,
  output                                                                                                                        fault
);

  wire
    struct packed {struct packed {logic ready; } request; struct packed {logic valid; RicketDataResp bits; } response; }
    _l1d_core_out;
  wire
    struct packed {struct packed {logic ready; } request; struct packed {logic valid; RicketInstructionResp bits; } response; }
    _l1i_core_out;
  wire
    struct packed {logic flush; struct packed {logic valid; RicketInstructionReq bits; } request; struct packed {logic ready; } response; }
    _core_instruction_access_out;
  wire struct packed {struct packed {logic valid; RicketDataReq bits; } request; }
    _core_data_access_out;
  RicketCore core (
    .clock                  (clock),
    .reset                  (reset),
    .start_in               (start_in),
    .instruction_access_in  (_l1i_core_out),
    .data_access_in         (_l1d_core_out),
    .start_out              (start_out),
    .instruction_access_out (_core_instruction_access_out),
    .data_access_out        (_core_data_access_out),
    .fault                  (fault)
  );
  RicketL1ICache l1i (
    .clock      (clock),
    .reset      (reset),
    .core_in    (_core_instruction_access_out),
    .memory_in  (imem_in),
    .core_out   (_l1i_core_out),
    .memory_out (imem_out)
  );
  RicketL1DCache l1d (
    .clock      (clock),
    .reset      (reset),
    .core_in    (_core_data_access_out),
    .memory_in  (dmem_in),
    .core_out   (_l1d_core_out),
    .memory_out (dmem_out)
  );
endmodule

