             | _GEN_10 | _GEN_12 | _GEN_13 | _GEN_14
             | commit_in.bits.csr_address != 12'h305
               ? state.mtvec
               : _GEN_50),
      mcounteren:
        (_GEN_54
           ? state.mcounteren
           : _GEN | _GEN_0 | _GEN_1 | _GEN_2 | _GEN_4 | _GEN_5 | _GEN_6 | _GEN_7 | _GEN_9
             | _GEN_10 | _GEN_12 | _GEN_13 | _GEN_14 | _GEN_15
