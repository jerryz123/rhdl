module RicketDataSnoop(
  input                                                                  clock,
                                                                         reset,
                                                                         cache_ready,
  input  struct packed {logic valid; CHISnpFlit bits; }                  snoops_in,
  input  struct packed {logic ready; }                                   responses_in,
                                                                         data_in,
  input  struct packed {logic valid; RicketDataSnoopLookupResult bits; } lookup_result_in,
  output                                                                 pending,
  output [63:0]                                                          address,
  output struct packed {logic ready; }                                   snoops_out,
  output struct packed {logic valid; CHIRspFlit bits; }                  responses_out,
  output struct packed {logic valid; CHIDatFlit bits; }                  data_out,
  output struct packed {logic valid; logic [63:0] bits; }                lookup_out,
  output struct packed {logic valid; RicketDataSnoopUpdate bits; }       update_out
);

  reg                        active_state;
  reg                        uses_lookup;
  CHISnpFlit                 request;
  reg                        lookup_complete;
  reg                        line_hit;
  reg  [2:0]                 line_state;
  reg  [7:0][63:0]           line;
  reg  [1:0]                 packet_index;
  reg                        dvm_first_pending;
  reg  [6:0]                 dvm_source_id;
  reg  [11:0]                dvm_txn_id;
  wire                       _GEN = |snoops_in.bits.opcode;
  wire                       _GEN_0 = snoops_in.bits.opcode == 5'hD;
  wire                       _GEN_1 =
    ~_GEN | ~active_state & cache_ready & (~dvm_first_pending | _GEN_0);
  wire                       _GEN_2 = snoops_in.valid & _GEN_1 & _GEN;
  wire                       _GEN_3 = _GEN_2 & ~_GEN_0;
  wire                       _GEN_4 = _GEN_2 & _GEN_0 & ~dvm_first_pending;
  wire                       _GEN_5 = _GEN_2 & _GEN_0 & dvm_first_pending;
  wire [63:0]                _GEN_6 =
    {20'h0, _GEN_3 ? snoops_in.bits.address : request.address, 3'h0};
  wire                       _GEN_7 =
    active_state & uses_lookup & ~lookup_complete & lookup_result_in.valid;
  wire                       _GEN_8 = line_state == 3'h3;
  wire                       _GEN_9 =
    uses_lookup & line_hit & (_GEN_8 | line_state == 3'h4 | line_state == 3'h6);
  wire                       _GEN_10 =
    request.opcode == 5'h1 | request.opcode == 5'h2 | request.opcode == 5'h4
    | request.opcode == 5'h8;
  wire                       _GEN_11 =
    request.opcode == 5'h5 | request.opcode == 5'h6 | request.opcode == 5'h7
    | request.opcode == 5'h9 | request.opcode == 5'hA | request.opcode == 5'h15
    | request.opcode == 5'h11 | request.opcode == 5'h12 | request.opcode == 5'h13
    | request.opcode == 5'h14 | request.opcode == 5'h16 | request.opcode == 5'h17
    | request.ret_to_src;
  wire                       _GEN_12 =
    active_state & (~uses_lookup | lookup_complete) & ~_GEN_9;
  wire CHIRspFlit            _GEN_13 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: (12'h0),
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp:
        {1'h0,
         ~(uses_lookup & line_hit) | _GEN_11
           ? 2'h0
