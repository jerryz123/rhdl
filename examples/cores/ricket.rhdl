                         responses_in.bits.resp_err == 2'h0);
  `endif // not def SYNTHESIS
  wire                         _GEN_22 = ~(_GEN_12 & ~_GEN_6 & ~reset);
  `ifndef SYNTHESIS
    write_unique_response_txn_id:
      assert property (@(posedge clock) disable iff (_GEN_22)
                         responses_in.bits.txn_id == 12'h1);
  `endif // not def SYNTHESIS
  wire                         _GEN_23 =
