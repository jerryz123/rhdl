module Pipe(
  input                                                    clock,
                                                           reset,
  input  struct packed {logic valid; DecodeExecute bits; } ingress_in,
  input  struct packed {logic ready; }                     egress_in,
  output struct packed {logic ready; }                     ingress_out,
  output struct packed {logic valid; DecodeExecute bits; } egress_out
);

  reg  [0:0]              stage_valid;
  DecodeExecute[0:0]      stage_bits;
  wire                    _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire                    _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire DecodeExecute      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module ValidPipe(
  input                                                    clock,
                                                           reset,
  input  struct packed {logic valid; ExecuteMemory bits; } ingress_in,
  output struct packed {logic valid; ExecuteMemory bits; } egress_out
);

  reg  [0:0]              stage_valid;
  ExecuteMemory[0:0]      stage_bits;
  wire ExecuteMemory      _GEN = ingress_in.valid ? ingress_in.bits : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= ingress_in.valid;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN;
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module ValidPipe_1(
  input                                                      clock,
                                                             reset,
  input  struct packed {logic valid; MemoryWriteback bits; } ingress_in,
  output struct packed {logic valid; MemoryWriteback bits; } egress_out
