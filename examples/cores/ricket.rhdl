  wire RicketWriteUniqueResult _GEN_27 = '{context_0: context_0};
  wire                         _GEN_28 = _GEN_26 & completion_in.ready;
  wire                         _GEN_29 = _GEN_0 | _GEN_28;
  wire                         _GEN_30 = _GEN_0 | _GEN_3 & retry_received | _GEN_28;
  wire CHIDatFlit              _GEN_31 =
    '{data: ({64'h0, write_data} << {121'h0, address[3], 6'h0}),
      byte_enable: ({8'h0, write_mask} << {12'h0, address[3], 3'h0}),
      replicate: (1'h0),
      num_dat: (2'h0),
      cah: (1'h0),
      trace_tag: (1'h0),
      tag_update: (1'h0),
      tag: (4'h0),
      tag_op: (2'h0),
      cache_line_id: (6'h0),
      data_id: (address[5:4]),
      ccid: (address[5:4]),
      dbid_or_mecid: {4'h0, dbid},
      c_busy: (3'h0),
      data_pull: (1'h0),
      data_source_or_fwd_state: (8'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (4'h3),
      home_nid_or_pbha_or_mismatched_mecid: home_id,
      txn_id: dbid,
      src_id: (7'h3),
      tgt_id: home_id,
      qos: (4'h0)};
  wire CHIReqFlit              _GEN_32 =
    '{trace_tag: (1'h0),
      tag_op: (2'h0),
      exp_comp_ack: (1'h0),
      excl_snoop_me_cah: (1'h0),
      group_id_or_lpid: (8'h0),
      snp_attr_or_do_dwt: (1'h1),
      mem_attr: _GEN,
      pcrd_type: (retry_received ? retry_credit_type : 4'h0),
      order: (2'h0),
      allow_retry: (~retry_received),
