#lang rhdl
// Demonstrates RV64I instruction decoding connected directly to the reusable ALU.

import:
  lib("cores/alu.rhdl") open
  lib("cores/rv5stage/decode/alu-ctrl.rhdl") open
  lib("riscv/isa/xlen.rhm") open

circuit DecodedALU():
  input instruction: Bits(32)
  input(left, right): Bits(64)
  output valid: Bool
  output result: Bits(64)

  inst decoder(RV64IAluInstructionDecoder())
  inst alu(ALU(XLen.X64))
  decoder.instruction <== instruction
  alu.left <== left
  alu.right <== right
  alu.control <== decoder.control
  valid <== decoder.valid
  result <== alu.result

def design = elaborate(DecodedALU())

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic [2:0] result_select; logic [1:0] logic_select; logic [1:0] count_select; logic [2:0] unary_select; logic subtract; logic signed_compare; logic maximum; logic shift_right; logic arithmetic_shift; logic extract_bit; logic invert_right; logic one_hot_right; logic unsigned_word; logic [1:0] shift_add_amount; logic word; }
    AluControl;
  typedef struct packed {logic valid; AluControl value; } DecodeResult;
`endif // _TYPESCOPE_rhdl_types
module DecodedALU(
  input  [31:0] instruction,
  input  [63:0] left,
                right,
  output        valid,
  output [63:0] result
);

  wire AluControl _decoder_control;
  RV64IAluInstructionDecoder decoder (
    .instruction (instruction),
    .valid       (valid),
    .control     (_decoder_control)
  );
  ALU alu (
    .left    (left),
    .right   (right),
    .control (_decoder_control),
    .result  (result)
  );
endmodule

module RV64IAluInstructionDecoder(
  input  [31:0]     instruction,
  output            valid,
  output AluControl control
);

  logic [22:0]       __rhdl_decode_3_result;
  wire  [6:0]        _GEN = {7{1'bx}};
  wire  [22:0]       _GEN_0 = {4'h8, _GEN, 1'h0, _GEN, 4'h0};
  wire  [9:0]        _GEN_1 = {10{1'bx}};
  wire  [1:0]        _GEN_2 = {2{1'bx}};
  wire  [22:0]       _GEN_3 = {4'h9, _GEN_1, 3'h0, _GEN_2, 1'h0, _GEN_2, 1'h0};
  wire  [5:0]        _GEN_4 = {6{1'bx}};
  wire  [22:0]       _GEN_5 = {4'hB, _GEN, 2'h3, _GEN_4, 4'h0};
  wire  [22:0]       _GEN_6 = {4'hB, _GEN, 2'h2, _GEN_4, 4'h0};
  wire  [10:0]       _GEN_7 = {11{1'bx}};
  wire  [2:0]        _GEN_8 = {3{1'bx}};
  wire  [22:0]       _GEN_9 = {6'h2A, _GEN_7, 2'h0, _GEN_8, 1'h0};
  wire  [22:0]       _GEN_10 = {4'h9, _GEN_1, 3'h4, _GEN_2, 1'h0, _GEN_2, 1'h0};
  wire  [22:0]       _GEN_11 = {4'h9, _GEN_1, 3'h6, _GEN_2, 1'h0, _GEN_2, 1'h0};
  wire  [22:0]       _GEN_12 = {6'h29, _GEN_7, 2'h0, _GEN_8, 1'h0};
  wire  [22:0]       _GEN_13 = {6'h28, _GEN_7, 2'h0, _GEN_8, 1'h0};
  wire  [22:0]       _GEN_14 = {4'h8, _GEN, 1'h0, _GEN, 4'h1};
  wire  [22:0]       _GEN_15 = {4'h9, _GEN_1, 3'h0, _GEN_2, 1'h0, _GEN_2, 1'h1};
  wire  [22:0]       _GEN_16 = {4'h9, _GEN_1, 3'h4, _GEN_2, 1'h0, _GEN_2, 1'h1};
  wire  [22:0]       _GEN_17 = {4'h9, _GEN_1, 3'h6, _GEN_2, 1'h0, _GEN_2, 1'h1};
  always_comb begin
    casez (instruction)
      32'bzzzzzzzzzzzzzzzzz000zzzzz0010011:
        __rhdl_decode_3_result = _GEN_0;
      32'b0000000zzzzzzzzzz000zzzzz0110011:
        __rhdl_decode_3_result = _GEN_0;
      32'b0100000zzzzzzzzzz000zzzzz0110011:
        __rhdl_decode_3_result = {4'h8, _GEN, 1'h1, _GEN, 4'h0};
      32'b000000zzzzzzzzzzz001zzzzz0010011:
        __rhdl_decode_3_result = _GEN_3;
      32'b0000000zzzzzzzzzz001zzzzz0110011:
        __rhdl_decode_3_result = _GEN_3;
      32'bzzzzzzzzzzzzzzzzz010zzzzz0010011:
        __rhdl_decode_3_result = _GEN_5;
      32'b0000000zzzzzzzzzz010zzzzz0110011:
        __rhdl_decode_3_result = _GEN_5;
      32'bzzzzzzzzzzzzzzzzz011zzzzz0010011:
        __rhdl_decode_3_result = _GEN_6;
      32'b0000000zzzzzzzzzz011zzzzz0110011:
        __rhdl_decode_3_result = _GEN_6;
      32'bzzzzzzzzzzzzzzzzz100zzzzz0010011:
        __rhdl_decode_3_result = _GEN_9;
      32'b0000000zzzzzzzzzz100zzzzz0110011:
        __rhdl_decode_3_result = _GEN_9;
      32'b000000zzzzzzzzzzz101zzzzz0010011:
        __rhdl_decode_3_result = _GEN_10;
      32'b0000000zzzzzzzzzz101zzzzz0110011:
        __rhdl_decode_3_result = _GEN_10;
      32'b010000zzzzzzzzzzz101zzzzz0010011:
        __rhdl_decode_3_result = _GEN_11;
      32'b0100000zzzzzzzzzz101zzzzz0110011:
        __rhdl_decode_3_result = _GEN_11;
      32'bzzzzzzzzzzzzzzzzz110zzzzz0010011:
        __rhdl_decode_3_result = _GEN_12;
      32'b0000000zzzzzzzzzz110zzzzz0110011:
        __rhdl_decode_3_result = _GEN_12;
      32'bzzzzzzzzzzzzzzzzz111zzzzz0010011:
        __rhdl_decode_3_result = _GEN_13;
      32'b0000000zzzzzzzzzz111zzzzz0110011:
        __rhdl_decode_3_result = _GEN_13;
      32'bzzzzzzzzzzzzzzzzz000zzzzz0011011:
        __rhdl_decode_3_result = _GEN_14;
      32'b0000000zzzzzzzzzz000zzzzz0111011:
        __rhdl_decode_3_result = _GEN_14;
      32'b0100000zzzzzzzzzz000zzzzz0111011:
        __rhdl_decode_3_result = {4'h8, _GEN, 1'h1, _GEN, 4'h1};
      32'b0000000zzzzzzzzzz001zzzzz0011011:
        __rhdl_decode_3_result = _GEN_15;
      32'b0000000zzzzzzzzzz001zzzzz0111011:
        __rhdl_decode_3_result = _GEN_15;
      32'b0000000zzzzzzzzzz101zzzzz0011011:
        __rhdl_decode_3_result = _GEN_16;
      32'b0000000zzzzzzzzzz101zzzzz0111011:
        __rhdl_decode_3_result = _GEN_16;
      32'b0100000zzzzzzzzzz101zzzzz0011011:
        __rhdl_decode_3_result = _GEN_17;
      32'b0100000zzzzzzzzzz101zzzzz0111011:
        __rhdl_decode_3_result = _GEN_17;
      default:
        __rhdl_decode_3_result = {1'h0, {22{1'bx}}};
    endcase
  end // always_comb
  wire  DecodeResult _GEN_18 = /*cast(bit)*/__rhdl_decode_3_result;
  assign valid = _GEN_18.valid;
  assign control = _GEN_18.value;
endmodule

module ALU(
