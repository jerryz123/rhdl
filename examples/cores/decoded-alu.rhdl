  wire [63:0]      _GEN_20 =
    control.count_select == 2'h2
      ? {57'h0,
         {1'h0,
          {1'h0,
           {1'h0,
            {1'h0,
             {1'h0, {1'h0, _GEN_12[0]} + {1'h0, _GEN_12[1]}}
               + {1'h0, {1'h0, _GEN_12[2]} + {1'h0, _GEN_12[3]}}}
              + {1'h0,
                 {1'h0, {1'h0, _GEN_12[4]} + {1'h0, _GEN_12[5]}}
                   + {1'h0, {1'h0, _GEN_12[6]} + {1'h0, _GEN_12[7]}}}}
             + {1'h0,
                {1'h0,
                 {1'h0, {1'h0, _GEN_12[8]} + {1'h0, _GEN_12[9]}}
