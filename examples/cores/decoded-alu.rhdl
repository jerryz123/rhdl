  wire [63:0]      _GEN_8 = control.shift_right ? _GEN_6 : _GEN_7;
  wire [64:0]      _GEN_9 =
    $unsigned($signed($signed({control.arithmetic_shift & _GEN_8[63], _GEN_8})
                      >>> (control.word ? {1'h0, right[4:0]} : right[5:0])));
  wire [63:0]      _GEN_10 =
    control.shift_right
      ? _GEN_9[63:0]
