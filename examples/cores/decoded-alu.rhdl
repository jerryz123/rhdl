#lang rhdl
// Demonstrates RV64I instruction decoding connected directly to the reusable ALU.

import:
  lib("cores/alu.rhdl") open
  lib("cores/ricket/decode/alu-ctrl.rhdl") open
  lib("riscv/isa/xlen.rhm") open

circuit DecodedALU():
  input instruction: Bits(32)
  input(left, right): Bits(64)
  output valid: Bool
  output result: Bits(64)

  inst decoder(RV64IAluInstructionDecoder())
  inst alu(ALU(XLen.X64))
  decoder.instruction <== instruction
  alu.left <== left
  alu.right <== right
  alu.control <== decoder.control
  valid <== decoder.valid
  result <== alu.result

def design = elaborate(DecodedALU())

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic [5:0] result_select; logic subtract; logic signed_mode; logic shift_right; logic word; }
    AluControl;
  typedef struct packed {logic valid; AluControl value; } DecodeResult;
`endif // _TYPESCOPE_rhdl_types
module DecodedALU(
  input  [31:0] instruction,
  input  [63:0] left,
                right,
  output        valid,
  output [63:0] result
);

  wire AluControl _decoder_control;
  RV64IAluInstructionDecoder decoder (
    .instruction (instruction),
    .valid       (valid),
    .control     (_decoder_control)
  );
  ALU alu (
    .left    (left),
    .right   (right),
    .control (_decoder_control),
    .result  (result)
  );
endmodule

module RV64IAluInstructionDecoder(
  input  [31:0]     instruction,
  output            valid,
  output AluControl control
);

  logic [10:0]       __rhdl_decode_3_result;
  wire  [1:0]        _GEN = {2{1'bx}};
  wire  [10:0]       _GEN_0 = {8'h82, _GEN, 1'h0};
  wire  [10:0]       _GEN_1 = {7'h42, _GEN, 2'h0};
  wire  [10:0]       _GEN_2 = {7'h44, 1'bx, 1'h1, _GEN};
  wire  [10:0]       _GEN_3 = {7'h44, 1'bx, 1'h0, _GEN};
  wire  [3:0]        _GEN_4 = {4{1'bx}};
  wire  [10:0]       _GEN_5 = {7'h48, _GEN_4};
  wire  [10:0]       _GEN_6 = {7'h42, 1'bx, 3'h2};
  wire  [10:0]       _GEN_7 = {7'h42, 1'bx, 3'h6};
  wire  [10:0]       _GEN_8 = {7'h50, _GEN_4};
  wire  [10:0]       _GEN_9 = {7'h60, _GEN_4};
  wire  [10:0]       _GEN_10 = {8'h82, _GEN, 1'h1};
  wire  [10:0]       _GEN_11 = {7'h42, _GEN, 2'h1};
  wire  [10:0]       _GEN_12 = {7'h42, 1'bx, 3'h3};
  wire  [10:0]       _GEN_13 = {7'h42, 1'bx, 3'h7};
  always_comb begin
    casez (instruction)
      32'bzzzzzzzzzzzzzzzzz000zzzzz0010011:
        __rhdl_decode_3_result = _GEN_0;
      32'b0000000zzzzzzzzzz000zzzzz0110011:
        __rhdl_decode_3_result = _GEN_0;
      32'b0100000zzzzzzzzzz000zzzzz0110011:
        __rhdl_decode_3_result = {8'h83, _GEN, 1'h0};
      32'b000000zzzzzzzzzzz001zzzzz0010011:
        __rhdl_decode_3_result = _GEN_1;
      32'b0000000zzzzzzzzzz001zzzzz0110011:
        __rhdl_decode_3_result = _GEN_1;
      32'bzzzzzzzzzzzzzzzzz010zzzzz0010011:
        __rhdl_decode_3_result = _GEN_2;
      32'b0000000zzzzzzzzzz010zzzzz0110011:
        __rhdl_decode_3_result = _GEN_2;
      32'bzzzzzzzzzzzzzzzzz011zzzzz0010011:
        __rhdl_decode_3_result = _GEN_3;
      32'b0000000zzzzzzzzzz011zzzzz0110011:
        __rhdl_decode_3_result = _GEN_3;
      32'bzzzzzzzzzzzzzzzzz100zzzzz0010011:
        __rhdl_decode_3_result = _GEN_5;
      32'b0000000zzzzzzzzzz100zzzzz0110011:
        __rhdl_decode_3_result = _GEN_5;
      32'b000000zzzzzzzzzzz101zzzzz0010011:
        __rhdl_decode_3_result = _GEN_6;
      32'b0000000zzzzzzzzzz101zzzzz0110011:
        __rhdl_decode_3_result = _GEN_6;
      32'b010000zzzzzzzzzzz101zzzzz0010011:
        __rhdl_decode_3_result = _GEN_7;
      32'b0100000zzzzzzzzzz101zzzzz0110011:
        __rhdl_decode_3_result = _GEN_7;
      32'bzzzzzzzzzzzzzzzzz110zzzzz0010011:
        __rhdl_decode_3_result = _GEN_8;
      32'b0000000zzzzzzzzzz110zzzzz0110011:
        __rhdl_decode_3_result = _GEN_8;
      32'bzzzzzzzzzzzzzzzzz111zzzzz0010011:
        __rhdl_decode_3_result = _GEN_9;
      32'b0000000zzzzzzzzzz111zzzzz0110011:
        __rhdl_decode_3_result = _GEN_9;
      32'bzzzzzzzzzzzzzzzzz000zzzzz0011011:
        __rhdl_decode_3_result = _GEN_10;
      32'b0000000zzzzzzzzzz000zzzzz0111011:
        __rhdl_decode_3_result = _GEN_10;
      32'b0100000zzzzzzzzzz000zzzzz0111011:
        __rhdl_decode_3_result = {8'h83, _GEN, 1'h1};
      32'b0000000zzzzzzzzzz001zzzzz0011011:
        __rhdl_decode_3_result = _GEN_11;
      32'b0000000zzzzzzzzzz001zzzzz0111011:
        __rhdl_decode_3_result = _GEN_11;
      32'b0000000zzzzzzzzzz101zzzzz0011011:
        __rhdl_decode_3_result = _GEN_12;
      32'b0000000zzzzzzzzzz101zzzzz0111011:
        __rhdl_decode_3_result = _GEN_12;
      32'b0100000zzzzzzzzzz101zzzzz0011011:
        __rhdl_decode_3_result = _GEN_13;
      32'b0100000zzzzzzzzzz101zzzzz0111011:
        __rhdl_decode_3_result = _GEN_13;
      default:
        __rhdl_decode_3_result = {1'h0, {10{1'bx}}};
    endcase
  end // always_comb
  wire  DecodeResult _GEN_14 = /*cast(bit)*/__rhdl_decode_3_result;
  assign valid = _GEN_14.valid;
  assign control = _GEN_14.value;
endmodule

module ALU(
  input  [63:0]     left,
                    right,
  input  AluControl control,
  output [63:0]     result
);

  wire [63:0] _GEN = {58'h0, control.word ? {1'h0, right[4:0]} : right[5:0]};
  wire [63:0] _GEN_0 =
    (control.subtract ? left - right : left + right) & {64{control.result_select[0]}}
    | (control.shift_right
         ? (control.signed_mode
              ? $signed($signed(control.word ? {{32{left[31]}}, left[31:0]} : left)
                        >>> _GEN)
              : (control.word ? {32'h0, left[31:0]} : left) >> _GEN)
         : left << _GEN) & {64{control.result_select[1]}}
    | {63'h0, control.signed_mode & (left[63] ^ right[63]) ? left[63] : left < right}
    & {64{control.result_select[2]}} | (left ^ right) & {64{control.result_select[3]}}
    | (left | right) & {64{control.result_select[4]}} | left & right
    & {64{control.result_select[5]}};
  assign result =
    control.word & (control.result_select == 6'h1 | control.result_select == 6'h2)
      ? {{32{_GEN_0[31]}}, _GEN_0[31:0]}
      : _GEN_0;
endmodule
}>>|

export:
  DecodedALU
  design
  verilog_reference
