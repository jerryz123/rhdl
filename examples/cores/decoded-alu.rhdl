  wire [63:0]      _GEN = {32'h0, left[31:0]};
  wire [63:0]      _GEN_0 = control.unsigned_word ? _GEN : left;
  wire [63:0]      _GEN_1 =
    (_GEN_0 << control.shift_add_amount) + ({64{control.subtract}} ^ right)
    + {63'h0, control.subtract};
  wire             _GEN_2 =
    left[63] == right[63] ? _GEN_1[63] : control.signed_compare ? left[63] : right[63];
  wire [63:0]      _GEN_3 =
    {64{control.invert_right}} ^ (control.one_hot_right ? 64'h1 << right[5:0] : right);
  wire [63:0]      _GEN_4 = left ^ _GEN_3;
  wire [63:0]      _GEN_5 = left & _GEN_3;
  wire [63:0]      _GEN_6 =
    control.word
      ? {control.arithmetic_shift ? {32{left[31]}} : 32'h0, left[31:0]}
      : _GEN_0;
  wire [63:0]      _GEN_7 =
