#lang rhdl
// Demonstrates a masked fixed-latency synchronous RAM through Valid flows.

import:
  lib("rhdl/std/read-write.rhdl") open
  lib("rhdl/std/sync-ram.rhdl") open

sync_circuit SyncRamExample():
  interface port(ReadWritePort(2, Bits(8), 4), ~role: responder)
  inst storage(SyncRam1RW(4, Bits(8), 4))
  port <=> storage.port

def design = elaborate(SyncRamExample())

export:
  SyncRamExample
  design
