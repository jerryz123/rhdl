#lang rhdl
// Demonstrates a typed aggregate DecodeGen with input and output don't-cares.

import:
  lib("rhdl/std/decode.rhdl") open

bundle Instruction():
  opcode: Bits(4)
  mode: Bool

hardware_enum AluOp:
  None
  Add
  Sub

bundle Control():
  alu: AluOp
  write: Bool

def add_input = pattern(Instruction()):
  opcode: bits(0, 4)
  mode: _
def sub_input = pattern(Instruction()):
  opcode: bits(1, 4)
  mode: _

def default_control = pattern(Control()):
  alu: AluOp.None
  write: _

def control_cases = decode_groups(Control()):
  [add_input]:
    alu: AluOp.Add
    write: Bool(#false)

  [sub_input]:
    alu: AluOp.Sub
    write: _

def control_decode = DecodeGen(
  control_cases,
  ~default: default_control
)

circuit InstructionDecoder():
  input encoded: Bits(5)
  output alu: AluOp
  output write: Bool

  def instruction = encoded.into(Instruction())
  def control = control_decode(instruction)
  alu <== control.alu
  write <== control.write

def design = elaborate(InstructionDecoder())

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef struct packed {logic [3:0] opcode; logic mode; } Instruction;
  typedef struct packed {logic [1:0] alu; logic write; } Control;
`endif // _TYPESCOPE_rhdl_types
module InstructionDecoder(
  input  [4:0] encoded,
  output [1:0] alu,
  output       write
);

  wire Control _GEN =
    /*cast(bit)*/{encoded[1] & ~(encoded[2]) & ~(encoded[3]) & ~(encoded[4]),
                  ~(encoded[1]) & ~(encoded[2]) & ~(encoded[3]) & ~(encoded[4]),
                  1'h0};
  assign alu = _GEN.alu;
  assign write = _GEN.write;
endmodule
}>>|

export:
  Instruction
  AluOp
  Control
  control_decode
  InstructionDecoder
  design
  verilog_reference
