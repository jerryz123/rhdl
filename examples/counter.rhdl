#lang rhdl
// Showcases literal and register syntax layered over primitive synchronous state.

circuit Counter(width):
  input clk: Clock
  input reset: Reset
  output count: Bits(width)

  reg state(Bits(width), ~clock: clk, ~reset: reset,
            ~init: bits(0, width))
  state.next <== state + bits(1, width)
  count <== state

circuit CounterNoReset(width):
  input clk: Clock
  output count: Bits(width)

  reg state(Bits(width), ~clock: clk)
  state.next <== state + bits(1, width)
  count <== state

def design = elaborate(Counter(8))

def verilog_reference = @str|<<{
module Counter(
  input        clk,
               reset,
  output [7:0] count
);

  reg [7:0] state;
  always @(posedge clk) begin
    if (reset)
      state <= 8'h0;
    else
      state <= state + 8'h1;
  end // always @(posedge)
  assign count = state;
endmodule
}>>|

export:
  Counter
  CounterNoReset
  design
  verilog_reference
