#lang rhdl
// Defines the canonical RHDL counter with concise ports and synchronous reset.

circuit Counter(width):
  input(clk, reset): Bits(1)
  output count: Bits(width)

  def zero = literal(Bits(width), 0)
  def one = literal(Bits(width), 1)
  def state = reg("state", Bits(width), clk, reset, zero)
  state.next <== state + one
  count <== state

def design = elaborate(Counter(8))

export:
  Counter
  design
