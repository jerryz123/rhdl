#lang rhdl
// Defines the canonical embedded RHDL counter with synchronous reset.

circuit Counter(width):
  def clk = input("clk", Bits(1))
  def reset = input("reset", Bits(1))
  def count = output("count", Bits(width))

  def zero = literal(Bits(width), 0, "zero")
  def one = literal(Bits(width), 1, "one")
  def state = reg("state", Bits(width), clk, reset, zero)
  def next = hw_add(state, one, "next")
  state.next <== next
  count <== state

def design = elaborate(Counter(8))

export:
  Counter
  design
