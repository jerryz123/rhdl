#lang rhdl
// Defines the canonical frontend counter with an active-high synchronous reset.

module Counter(width: Int):
  input:
    clk: Bits(1)
    reset: Bits(1)
  output:
    count: Bits(width)

  zero = Bits(width)(0)
  one = Bits(width)(1)
  state = reg(Bits(width), clk, reset, zero)
  next = state + one
  state.next := next
  count := state

elaborate(Counter(8))
