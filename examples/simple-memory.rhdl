#lang rhdl
// Demonstrates the aligned byte-masked memory protocol and generic alignment helpers.

import:
  lib("rhdl/std/simple-memory.rhdl") open
  lib("rhdl/std/bits.rhdl") open
  lib("rhdl/std/ready-valid.rhdl") open

circuit SimpleMemoryAdapter(address_width, data_bytes):
  interface ingress(SimpleMemory(address_width, data_bytes), ~role: responder)
  interface egress(SimpleMemory(address_width, data_bytes), ~role: requester)
  egress <=> ingress

circuit MemoryAlignmentCheck():
  input address: Bits(32)
  output word_aligned: Bool
  output byte_aligned: Bool
  output word_base: Bits(32)

  word_aligned <== is_aligned(address, 4)
  byte_aligned <== is_aligned(address, 1)
  word_base <== align_down(address, 4)

circuit SimpleMemoryActivity():
  input request_valid: Bool
  input request_bits: SimpleMemoryReq(32, 4)
  input response_ready: Bool
  interface memory(SimpleMemory(32, 4), ~role: requester)
  output request_transfer: Bool
  output response_transfer: Bool

  memory.request.valid <== request_valid
  memory.request.bits <== request_bits
  memory.response.ready <== response_ready
  request_transfer <== fire(memory.request)
  response_transfer <== fire(memory.response)

def design = elaborate(SimpleMemoryAdapter(32, 4))
def alignment_design = elaborate(MemoryAlignmentCheck())
def activity_design = elaborate(SimpleMemoryActivity())

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic [31:0] address; logic write; logic [31:0] data; logic [3:0] mask; }
    SimpleMemoryReq;
  typedef struct packed {logic [31:0] data; } SimpleMemoryResp;
`endif // _TYPESCOPE_rhdl_types
module SimpleMemoryAdapter(
  input  struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }  ingress_in,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; } egress_in,
  output struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; } ingress_out,
  output struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }  egress_out
);

  assign ingress_out = egress_in;
  assign egress_out = ingress_in;
endmodule
}>>|

def alignment_verilog_reference = @str|<<{
module MemoryAlignmentCheck(
  input  [31:0] address,
  output        word_aligned,
                byte_aligned,
  output [31:0] word_base
);

  assign word_aligned = address[1:0] == 2'h0;
  assign byte_aligned = 1'h1;
  assign word_base = {address[31:2], 2'h0};
endmodule
}>>|
def activity_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic [31:0] address; logic write; logic [31:0] data; logic [3:0] mask; }
    SimpleMemoryReq;
  typedef struct packed {logic [31:0] data; } SimpleMemoryResp;
`endif // _TYPESCOPE_rhdl_types
module SimpleMemoryActivity(
  input                                                                                                                         request_valid,
  input  SimpleMemoryReq                                                                                                        request_bits,
  input                                                                                                                         response_ready,
  input  struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; } memory_in,
  output struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }  memory_out,
  output                                                                                                                        request_transfer,
                                                                                                                                response_transfer
);

  wire struct packed {logic valid; SimpleMemoryReq bits; } _GEN =
    '{valid: request_valid, bits: request_bits};
  wire struct packed {logic ready; } _GEN_0 = '{ready: response_ready};
  assign memory_out = '{request: _GEN, response: _GEN_0};
  assign request_transfer = request_valid & memory_in.request.ready;
  assign response_transfer = memory_in.response.valid & response_ready;
endmodule
}>>|

export:
  SimpleMemoryAdapter
  MemoryAlignmentCheck
  SimpleMemoryActivity
  design
  alignment_design
  activity_design
  verilog_reference
  alignment_verilog_reference
  activity_verilog_reference
