#lang rhdl
// Showcases layer-defined Bool, equality, and canonical N-way selection.

circuit ALU(width):
  input(a, b): Bits(width)
  input op: Bits(3)
  output result: Bits(width)
  output equal: Bool

  result <== mux_lookup(op, ~default: not a):
    0: a and b
    1: a or b
    2: a xor b
    3: a + b
    4: a - b

  equal <== a === b

def design = elaborate(ALU(8))

def verilog_reference = @str|<<{
module ALU(
  input  [7:0] a,
               b,
  input  [2:0] op,
  output [7:0] result,
  output       equal
);

  wire [7:0][7:0] _GEN = {{~a}, {~a}, {~a}, {a - b}, {a + b}, {a ^ b}, {a | b}, {a & b}};
  assign result = _GEN[op];
  assign equal = a == b;
endmodule
}>>|

export:
  ALU
  design
  verilog_reference
