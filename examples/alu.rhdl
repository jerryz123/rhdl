#lang rhdl
// Defines the canonical RHDL ALU using concise standard frontend forms.

circuit ALU(width):
  input(a, b): Bits(width)
  input op: Bits(3)
  output result: Bits(width)
  output equal: Bool

  result <== mux_lookup(op, ~default: not a):
    0: a and b
    1: a or b
    2: a xor b
    3: a + b
    4: a - b

  equal <== a === b

def design = elaborate(ALU(8))

export:
  ALU
  design
