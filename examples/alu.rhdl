#lang rhdl
// Defines the canonical embedded RHDL ALU over the initial operation surface.

circuit ALU(width):
  def a = input("a", Bits(width))
  def b = input("b", Bits(width))
  def op = input("op", Bits(3))
  def result = output("result", Bits(width))
  def equal = output("equal", Bits(1))

  def and_result = bit_and(a, b, "and_result")
  def or_result = bit_or(a, b, "or_result")
  def xor_result = bit_xor(a, b, "xor_result")
  def add_result = hw_add(a, b, "add_result")
  def sub_result = hw_sub(a, b, "sub_result")
  def not_result = bit_not(a, "not_result")
  def equal_result = hw_eq(a, b, "equal_result")

  def op_and = literal(Bits(3), 0, "op_and")
  def op_or = literal(Bits(3), 1, "op_or")
  def op_xor = literal(Bits(3), 2, "op_xor")
  def op_add = literal(Bits(3), 3, "op_add")
  def op_sub = literal(Bits(3), 4, "op_sub")
  def is_and = hw_eq(op, op_and, "is_and")
  def is_or = hw_eq(op, op_or, "is_or")
  def is_xor = hw_eq(op, op_xor, "is_xor")
  def is_add = hw_eq(op, op_add, "is_add")
  def is_sub = hw_eq(op, op_sub, "is_sub")

  def select_sub = mux(is_sub, sub_result, not_result, "select_sub")
  def select_add = mux(is_add, add_result, select_sub, "select_add")
  def select_xor = mux(is_xor, xor_result, select_add, "select_xor")
  def select_or = mux(is_or, or_result, select_xor, "select_or")
  def selected = mux(is_and, and_result, select_or, "selected")
  result <== selected
  equal <== equal_result

def design = elaborate(ALU(8))

export:
  design
