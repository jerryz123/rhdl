#lang rhdl
// Defines the canonical frontend ALU covering the initial same-width operation surface.

module ALU(width: Int):
  input:
    a: Bits(width)
    b: Bits(width)
    op: Bits(3)
  output:
    result: Bits(width)
    equal: Bits(1)

  and_result = a & b
  or_result = a | b
  xor_result = a ^ b
  add_result = a + b
  sub_result = a - b
  not_result = not(a)
  equal_result = a == b

  op_and = Bits(3)(0)
  op_or = Bits(3)(1)
  op_xor = Bits(3)(2)
  op_add = Bits(3)(3)
  op_sub = Bits(3)(4)
  is_and = op == op_and
  is_or = op == op_or
  is_xor = op == op_xor
  is_add = op == op_add
  is_sub = op == op_sub

  select_sub = mux(is_sub, sub_result, not_result)
  select_add = mux(is_add, add_result, select_sub)
  select_xor = mux(is_xor, xor_result, select_add)
  select_or = mux(is_or, or_result, select_xor)
  selected = mux(is_and, and_result, select_or)
  result := selected
  equal := equal_result

elaborate(ALU(8))
