#lang rhdl
// Elaborates the flow-oriented RV64 Ricket core into a logical diagram.

import:
  "../../cores/ricket/core-flow.rhdl" open
  "../../rhdl/diagram/main.rhm" open
  "../../riscv/isa/xlen.rhm" open

def logical = elaborate_with_top(RicketCore(XLen.X64))
def view = diagram(logical)
def core_diagram = view.module("RicketCore")
def json = diagram_module_to_json(core_diagram)
def dot = diagram_module_to_dot(core_diagram)

export:
  logical
  view
  core_diagram
  json
  dot
