#lang rhdl
// Demonstrates a circuit-shaped synchronous memory with fixed read and write ports.

sync_circuit SyncMemoryExample(depth, width):
  input read_address: Bits(index_width(depth))
  input read_enable: Bits(1)
  input write_address: Bits(index_width(depth))
  input write_data: Bits(width)
  input write_enable: Bits(1)
  output read_data: Bits(width)

  sync_mem storage(depth, Bits(width)):
    read
    write

  storage.read.address <== read_address
  storage.read.enable <== read_enable
  read_data <== storage.read.data

  storage.write.address <== write_address
  storage.write.data <== write_data
  storage.write.enable <== write_enable

def design = elaborate(SyncMemoryExample(4, 8))

def verilog_reference = @str|<<{
module SyncMemoryExample(
  input        clock,
               reset,
  input  [1:0] read_address,
  input        read_enable,
  input  [1:0] write_address,
  input  [7:0] write_data,
  input        write_enable,
  output [7:0] read_data
);

  wire       _GEN = 1'h0;
  reg  [7:0] storage[0:3];
  always_ff @(posedge clock) begin
    if (_GEN) begin
    end
    else begin
      if (write_enable)
        storage[write_address] <= write_data;
    end
  end // always_ff @(posedge)
  reg  [7:0] storage_rd0_reg;
  always_ff @(posedge clock)
    storage_rd0_reg <= storage[read_address];
  assign read_data = storage_rd0_reg;
endmodule
}>>|

export:
  SyncMemoryExample
  design
  verilog_reference
