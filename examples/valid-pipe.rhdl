#lang rhdl
// Demonstrates fixed-latency pipelining for a Valid payload with no backpressure.

import:
  lib("rhdl/std/flow.rhdl") open

sync_circuit ValidDelay(T, stages :: Int):
  interface ingress(Valid(T), ~role: consumer)
  interface egress(Valid(T), ~role: producer)

  (ingress |> valid_pipe(_, stages)) <=> egress

def design = elaborate(ValidDelay(Bits(8), 2))

export:
  ValidDelay
  design
