#lang rhdl
// Builds a host-parameterized, zero-initialized vector shift register.

sync_circuit VecShiftRegisterParam(n :: Int, w :: Int):
  input data_in: Bits(w)
  output data_out: Bits(w)

  def initial = vec(for List (_ in 0..n): bits(0, w))
  reg delays(~init: initial)

  // Every source reads current state, so host iteration order does not affect
  // the generated parallel next-state assignments.
  for (i in 1..n):
    delays[i] <== delays[i - 1]

  delays[0] <== data_in
  data_out <== delays[n - 1]

def design = elaborate(VecShiftRegisterParam(4, 4))

def verilog_reference = @str|<<{
module VecShiftRegisterParam(
  input        clock,
               reset,
  input  [3:0] data_in,
  output [3:0] data_out
);

  reg [3:0][3:0] delays;
  always @(posedge clock) begin
    if (reset)
      delays <= '{4'h0, 4'h0, 4'h0, 4'h0};
    else begin
      delays[2'h3] <= delays[2'h2];
      delays[2'h2] <= delays[2'h1];
      delays[2'h1] <= delays[2'h0];
      delays[2'h0] <= data_in;
    end
  end // always @(posedge)
  assign data_out = delays[2'h3];
endmodule
}>>|

export:
  VecShiftRegisterParam
  design
  verilog_reference
