#lang rhdl
// Implements a one-bit full adder with nominal Boolean ports and combinational logic.

circuit FullAdder():
  input(a, b, cin): Bool
  output(sum, cout): Bool

  def a_xor_b = a ^ b
  sum <== a_xor_b ^ cin

  def a_and_b = a & b
  def b_and_cin = b & cin
  def a_and_cin = a & cin
  cout <== a_and_b or b_and_cin or a_and_cin

def design = elaborate(FullAdder())

export:
  FullAdder
  design
