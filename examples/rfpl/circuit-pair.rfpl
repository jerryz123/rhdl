#lang rfpl
// Demonstrates placed floorplans, pure wiring, and stamped RHDL circuit hierarchy.

import:
  "../hierarchy.rhdl".Adder

floorplan AdderShell(bit_width):
  size(width: um(bit_width * 5), height: um(bit_width * 3))
  input(a, b): Bits(bit_width)
  output sum: Bits(bit_width)

  def adder = Adder(bit_width)
  inst wrapped(adder)
  wrapped.a <== a
  wrapped.b <== b
  sum <== wrapped.sum

floorplan CrossedWires(bit_width):
  size(width: um(bit_width * 2), height: nm(bit_width * 1000))
  input(a, b): Bits(bit_width)
  output(a_out, b_out): Bits(bit_width)

  a_out <== b
  b_out <== a

floorplan AdderPair(bit_width):
  size(width: um(100), height: um(50))
  input(a, b): Bits(bit_width)
  output(sum0, sum1): Bits(bit_width)

  def shell = AdderShell(bit_width)
  def crossed_wires = CrossedWires(bit_width)
  inst left(shell, at: (um(0), um(0)))
  inst right(shell, at: (um(50), um(0)))
  inst crossed(crossed_wires, at: (um(42), um(30)))
  left.a <== a
  left.b <== b
  crossed.a <== a
  crossed.b <== b
  right.a <== crossed.a_out
  right.b <== crossed.b_out
  sum0 <== left.sum
  sum1 <== right.sum

def elaboration = elaborate(AdderPair(8))
def design = elaboration.design

// This normalized reference is generated by CIRCT's ExportVerilog pipeline.
def verilog_reference = @str|<<{
module AdderPair(
  input  [7:0] a,
               b,
  output [7:0] sum0,
               sum1
);

  wire [7:0] _crossed_a_out;
  wire [7:0] _crossed_b_out;
  AdderShell left (
    .a   (a),
    .b   (b),
    .sum (sum0)
  );
  AdderShell right (
    .a   (_crossed_a_out),
    .b   (_crossed_b_out),
    .sum (sum1)
  );
  CrossedWires crossed (
    .a     (a),
    .b     (b),
    .a_out (_crossed_a_out),
    .b_out (_crossed_b_out)
  );
endmodule

module AdderShell(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  Adder wrapped (
    .a   (a),
    .b   (b),
    .sum (sum)
  );
endmodule

module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule

module CrossedWires(
  input  [7:0] a,
               b,
  output [7:0] a_out,
               b_out
);

  assign a_out = b;
  assign b_out = a;
endmodule
}>>|

export:
  AdderShell
  CrossedWires
  AdderPair
  elaboration
  design
  verilog_reference
