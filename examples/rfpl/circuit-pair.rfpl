#lang rfpl
// Demonstrates pure wiring and nested floorplans stamping one imported RHDL circuit.

import:
  "../hierarchy.rhdl".Adder

floorplan AdderShell(width):
  input(a, b): Bits(width)
  output sum: Bits(width)

  def adder = Adder(width)
  inst wrapped(adder)
  wrapped.a <== a
  wrapped.b <== b
  sum <== wrapped.sum

floorplan CrossedWires(width):
  input(a, b): Bits(width)
  output(a_out, b_out): Bits(width)

  a_out <== b
  b_out <== a

floorplan AdderPair(width):
  input(a, b): Bits(width)
  output(sum0, sum1): Bits(width)

  def shell = AdderShell(width)
  def crossed_wires = CrossedWires(width)
  inst left(shell)
  inst right(shell)
  inst crossed(crossed_wires)
  left.a <== a
  left.b <== b
  crossed.a <== a
  crossed.b <== b
  right.a <== crossed.a_out
  right.b <== crossed.b_out
  sum0 <== left.sum
  sum1 <== right.sum

def elaboration = elaborate(AdderPair(8))
def design = elaboration.design

// This normalized reference is generated by CIRCT's ExportVerilog pipeline.
def verilog_reference = @str|<<{
module AdderPair(
  input  [7:0] a,
               b,
  output [7:0] sum0,
               sum1
);

  wire [7:0] _crossed_a_out;
  wire [7:0] _crossed_b_out;
  AdderShell left (
    .a   (a),
    .b   (b),
    .sum (sum0)
  );
  AdderShell right (
    .a   (_crossed_a_out),
    .b   (_crossed_b_out),
    .sum (sum1)
  );
  CrossedWires crossed (
    .a     (a),
    .b     (b),
    .a_out (_crossed_a_out),
    .b_out (_crossed_b_out)
  );
endmodule

module AdderShell(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  Adder wrapped (
    .a   (a),
    .b   (b),
    .sum (sum)
  );
endmodule

module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule

module CrossedWires(
  input  [7:0] a,
               b,
  output [7:0] a_out,
               b_out
);

  assign a_out = b;
  assign b_out = a;
endmodule
}>>|

export:
  AdderShell
  CrossedWires
  AdderPair
  elaboration
  design
  verilog_reference
