#lang rfpl
// Annotates an existing RHDL hierarchy and retains its generated Verilog golden.

import:
  "circuit-pair.rhdl" as logical_fixture

def logical = logical_fixture.logical
def pair = logical.top
def left = child_instance(pair, "left")
def right = child_instance(pair, "right")
def crossed = child_instance(pair, "crossed")
def shell = instance_target(left)
def wrapped = child_instance(shell, "wrapped")
def adder = instance_target(wrapped)
def crossed_wires = instance_target(crossed)

def adder_macro = hard_macro(
  adder,
  width: um(40),
  height: um(24)
)
def shell_floorplan = floorplan(
  shell,
  width: um(40),
  height: um(24),
  placements: [
    place(wrapped, adder_macro, at: (um(0), um(0)))
  ]
)
def crossed_macro = hard_macro(
  crossed_wires,
  width: um(16),
  height: um(8)
)
def pair_floorplan = floorplan(
  pair,
  width: um(100),
  height: um(50),
  placements: [
    place(left, shell_floorplan, at: (um(0), um(0))),
    place(right, shell_floorplan, at: (um(50), um(0))),
    place(crossed, crossed_macro, at: (um(42), um(30)))
  ]
)

def floorplan_design = annotate(logical, pair_floorplan)
def design = floorplan_design.design

// This normalized reference is generated by CIRCT's ExportVerilog pipeline.
def verilog_reference = @str|<<{
module AdderPair(
  input  [7:0] a,
               b,
  output [7:0] sum0,
               sum1
);

  wire [7:0] _crossed_a_out;
  wire [7:0] _crossed_b_out;
  AdderShell left (
    .a   (a),
    .b   (b),
    .sum (sum0)
  );
  AdderShell right (
    .a   (_crossed_a_out),
    .b   (_crossed_b_out),
    .sum (sum1)
  );
  CrossedWires crossed (
    .a     (a),
    .b     (b),
    .a_out (_crossed_a_out),
    .b_out (_crossed_b_out)
  );
endmodule

module AdderShell(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  Adder wrapped (
    .a   (a),
    .b   (b),
    .sum (sum)
  );
endmodule

module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule

module CrossedWires(
  input  [7:0] a,
               b,
  output [7:0] a_out,
               b_out
);

  assign a_out = b;
  assign b_out = a;
endmodule
}>>|

export:
  logical
  adder_macro
  shell_floorplan
  crossed_macro
  pair_floorplan
  floorplan_design
  design
  verilog_reference
