#lang rhdl
// Demonstrates element-wise conditional updates to one aggregate vector register.

sync_circuit VecShiftRegister():
  input ins: Vec(4, Bits(4))
  input load: Bool
  input shift: Bool
  output out: Bits(4)

  reg delays(Vec(4, Bits(4)))

  when load:
    delays.next[0] <== ins[0]
    delays.next[1] <== ins[1]
    delays.next[2] <== ins[2]
    delays.next[3] <== ins[3]
  elsewhen shift:
    delays.next[0] <== ins[0]
    delays.next[1] <== delays[0]
    delays.next[2] <== delays[1]
    delays.next[3] <== delays[2]

  out <== delays[3]

def design = elaborate(VecShiftRegister())

def verilog_reference = @str|<<{
}>>|

export:
  VecShiftRegister
  design
  verilog_reference
