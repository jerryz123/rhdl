#lang rhdl
// Demonstrates element-wise conditional updates to one aggregate vector register.

sync_circuit VecShiftRegister():
  input ins: Vec(4, Bits(4))
  input load: Bool
  input shift: Bool
  output out: Bits(4)

  reg delays(Vec(4, Bits(4)))

  when load:
    delays.next[0] <== ins[0]
    delays.next[1] <== ins[1]
    delays.next[2] <== ins[2]
    delays.next[3] <== ins[3]
  elsewhen shift:
    delays.next[0] <== ins[0]
    delays.next[1] <== delays[0]
    delays.next[2] <== delays[1]
    delays.next[3] <== delays[2]

  out <== delays[3]

def design = elaborate(VecShiftRegister())

def verilog_reference = @str|<<{
module VecShiftRegister(
  input             clock,
                    reset,
  input  [3:0][3:0] ins,
  input             load,
                    shift,
  output [3:0]      out
);

  reg  [3:0][3:0] delays;
  wire [3:0]      _GEN = load ? ins[2'h0] : shift ? ins[2'h0] : delays[2'h0];
  wire [3:0]      _GEN_0 = load ? ins[2'h1] : shift ? delays[2'h0] : delays[2'h1];
  wire [3:0]      _GEN_1 = load ? ins[2'h2] : shift ? delays[2'h1] : delays[2'h2];
  wire [3:0]      _GEN_2 = load ? ins[2'h3] : shift ? delays[2'h2] : delays[2'h3];
  always @(posedge clock) begin
    delays[2'h3] <= _GEN_2;
    delays[2'h2] <= _GEN_1;
    delays[2'h1] <= _GEN_0;
    delays[2'h0] <= _GEN;
  end // always @(posedge)
  assign out = delays[2'h3];
endmodule
}>>|

export:
  VecShiftRegister
  design
  verilog_reference
