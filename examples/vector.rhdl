#lang rhdl
// Showcases first-class hardware vectors, host indexing, lookup, packing, and state.

circuit CarryEndpoints(n):
  input carries: Vec(n + 1, Bool)
  output(first, last): Bool

  first <== carries[0]
  last <== carries[n]

circuit VectorDatapath():
  input clk: Clock
  input reset: Reset
  input selector: Bits(2)
  input(a, b, c): Bits(4)
  input alternate: Vec(3, Bits(4))
  output assembled: Vec(3, Bits(4))
  output selected: Vec(3, Bits(4))
  output chosen: Bits(4)
  output packed: Bits(12)
  output restored: Vec(3, Bits(4))
  output reversed: Vec(3, Bits(4))
  output state_out: Vec(3, Bits(4))

  def initial = vec(a, b, c)
  assembled <== initial
  selected <== mux_lookup(selector, ~default: initial):
    1: alternate
  chosen <== initial.lookup(selector, ~default: c)

  packed <== initial.into(Bits(12))
  restored <== packed.into(Vec(3, Bits(4)))

  reversed[0] <== initial[2]
  reversed[1] <== initial[1]
  reversed[2] <== initial[0]

  reg state(Vec(3, Bits(4)), ~clock: clk, ~reset: reset, ~init: initial)
  state.next <== selected
  state_out <== state

def design = elaborate(VectorDatapath())
def carry_design = elaborate(CarryEndpoints(4))

def verilog_reference = @str|<<{
module VectorDatapath(
  input             clk,
                    reset,
  input  [1:0]      selector,
  input  [3:0]      a,
                    b,
                    c,
  input  [2:0][3:0] alternate,
  output [2:0][3:0] assembled,
                    selected,
  output [3:0]      chosen,
  output [11:0]     packed_0,
  output [2:0][3:0] restored,
                    reversed,
                    state_out
);

  wire [2:0][3:0] _GEN = {{c}, {b}, {a}};
  wire            _GEN_0 = selector == 2'h1;
  wire [2:0][3:0] _GEN_1 = _GEN_0 ? alternate : _GEN;
  reg  [2:0][3:0] state;
  always @(posedge clk) begin
    if (reset)
      state <= _GEN;
    else
      state <= _GEN_1;
  end // always @(posedge)
  assign assembled = _GEN;
  assign selected = _GEN_1;
  assign chosen = selector == 2'h0 ? a : _GEN_0 ? b : c;
  assign packed_0 = /*cast(bit[11:0])*/_GEN;
  assign restored = _GEN;
  assign reversed = {{a}, {b}, {c}};
  assign state_out = state;
endmodule
}>>|

export:
  CarryEndpoints
  VectorDatapath
  design
  carry_design
  verilog_reference
