#lang rhdl
// Showcases first-class hardware vectors, host indexing, lookup, packing, and state.

circuit CarryEndpoints(n):
  input carries: Vec(n + 1, Bool)
  output(first, last): Bool

  first <== carries[0]
  last <== carries[n]

circuit VectorDatapath():
  input clk: Clock
  input reset: Reset
  input selector: Bits(2)
  input(a, b, c): Bits(4)
  input alternate: Vec(3, Bits(4))
  output assembled: Vec(3, Bits(4))
  output selected: Vec(3, Bits(4))
  output chosen: Bits(4)
  output packed: Bits(12)
  output restored: Vec(3, Bits(4))
  output reversed: Vec(3, Bits(4))
  output state_out: Vec(3, Bits(4))

  def initial = vec(a, b, c)
  assembled <== initial
  selected <== mux_lookup(selector, ~default: initial):
    1: alternate
  chosen <== initial.lookup(selector, ~default: c)

  packed <== initial.into(Bits(12))
  restored <== packed.into(Vec(3, Bits(4)))

  reversed[0] <== initial[2]
  reversed[1] <== initial[1]
  reversed[2] <== initial[0]

  reg state(Vec(3, Bits(4)), ~clock: clk, ~reset: reset, ~init: initial)
  state.next <== selected
  state_out <== state

def design = elaborate(VectorDatapath())
def carry_design = elaborate(CarryEndpoints(4))

export:
  CarryEndpoints
  VectorDatapath
  design
  carry_design
