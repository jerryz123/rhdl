#lang rhdl
// Mixes host-generated structure with runtime hardware control and an imported combinator.

import:
  "add-pair.rhm" open

circuit LayeredAdder(width, stages):
  input(a, b): Bits(width)
  input bypass: Bits(1)
  output sum: Bits(width)

  fun add_stages(remaining, value):
    if (remaining == 0)
    | value
    | add_stages(remaining - 1, add_pair(value, b))

  def staged_sum = add_stages(stages, a)
  sum <== mux(bypass, a, staged_sum)

def design = elaborate(LayeredAdder(8, 3))

export:
  LayeredAdder
  design
