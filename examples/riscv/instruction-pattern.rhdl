#lang rhdl
// Demonstrates materializing RV32I and RV64I encodings as typed RHDL patterns.

import:
  lib("riscv/isa/rv32i.rhm") as rv32
  lib("riscv/isa/rv64i.rhm") as rv64
  lib("riscv/rhdl/instruction-pattern.rhdl") open

def rv32_add_pattern = instruction_pattern(rv32.ADD)
def rv64_add_pattern = instruction_pattern(rv64.ADD)
def rv32_slli_pattern = instruction_pattern(rv32.SLLI)
def rv64_slli_pattern = instruction_pattern(rv64.SLLI)

export:
  rv32_add_pattern
  rv64_add_pattern
  rv32_slli_pattern
  rv64_slli_pattern
