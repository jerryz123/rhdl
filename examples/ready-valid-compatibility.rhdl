#lang rhdl
// Demonstrates safe ready-valid weakening and payload-bearing endpoint extension.

import:
  lib("rhdl/std/ready-valid.rhdl") open

circuit ReadyValidCompatibility():
  input decoupled_payload: Bits(8)
  input irrevocable_payload: Bits(8)

  // A persistent offer safely satisfies the weaker Decoupled contract.
  interface irrevocable_in(Irrevocable(Bits(8)), ~role: consumer)
  interface decoupled_out(Decoupled(Bits(8)), ~role: producer)
  decoupled_out <=> irrevocable_in

  // Payload-bearing protocols can expose just their inherited control plane.
  interface decoupled_in(Decoupled(Bits(8)), ~role: consumer)
  interface decoupled_control_out(DecoupledControl(), ~role: producer)
  decoupled_control_out <=> decoupled_in

  interface irrevocable_data_in(Irrevocable(Bits(8)), ~role: consumer)
  interface irrevocable_control_out(IrrevocableControl(), ~role: producer)
  irrevocable_control_out <=> irrevocable_data_in

  // Supplying every new field forms the direct payload-bearing refinement.
  interface decoupled_control_in(DecoupledControl(), ~role: consumer)
  interface decoupled_extended_out(Decoupled(Bits(8)), ~role: producer)
  decoupled_extended_out <=> decoupled_control_in.extend(
    Decoupled(Bits(8)),
    ~bits: decoupled_payload
  )

  interface irrevocable_control_in(IrrevocableControl(), ~role: consumer)
  interface irrevocable_extended_out(Irrevocable(Bits(8)), ~role: producer)
  irrevocable_extended_out <=> irrevocable_control_in.extend(
    Irrevocable(Bits(8)),
    ~bits: irrevocable_payload
  )

def design = elaborate(ReadyValidCompatibility())

def verilog_reference = @str|<<{
module ReadyValidCompatibility(
  input  [7:0]                                           decoupled_payload,
                                                         irrevocable_payload,
  input  struct packed {logic valid; logic [7:0] bits; } irrevocable_in_in,
  input  struct packed {logic ready; }                   decoupled_out_in,
  input  struct packed {logic valid; logic [7:0] bits; } decoupled_in_in,
  input  struct packed {logic ready; }                   decoupled_control_out_in,
  input  struct packed {logic valid; logic [7:0] bits; } irrevocable_data_in_in,
  input  struct packed {logic ready; }                   irrevocable_control_out_in,
  input  struct packed {logic valid; }                   decoupled_control_in_in,
  input  struct packed {logic ready; }                   decoupled_extended_out_in,
  input  struct packed {logic valid; }                   irrevocable_control_in_in,
  input  struct packed {logic ready; }                   irrevocable_extended_out_in,
  output struct packed {logic ready; }                   irrevocable_in_out,
  output struct packed {logic valid; logic [7:0] bits; } decoupled_out_out,
  output struct packed {logic ready; }                   decoupled_in_out,
  output struct packed {logic valid; }                   decoupled_control_out_out,
  output struct packed {logic ready; }                   irrevocable_data_in_out,
  output struct packed {logic valid; }                   irrevocable_control_out_out,
  output struct packed {logic ready; }                   decoupled_control_in_out,
  output struct packed {logic valid; logic [7:0] bits; } decoupled_extended_out_out,
  output struct packed {logic ready; }                   irrevocable_control_in_out,
  output struct packed {logic valid; logic [7:0] bits; } irrevocable_extended_out_out
);

  assign irrevocable_in_out = decoupled_out_in;
  assign decoupled_out_out = irrevocable_in_in;
  assign decoupled_in_out = decoupled_control_out_in;
  assign decoupled_control_out_out = '{valid: decoupled_in_in.valid};
  assign irrevocable_data_in_out = irrevocable_control_out_in;
  assign irrevocable_control_out_out = '{valid: irrevocable_data_in_in.valid};
  assign decoupled_control_in_out = decoupled_extended_out_in;
  assign decoupled_extended_out_out =
    '{valid: decoupled_control_in_in.valid, bits: decoupled_payload};
  assign irrevocable_control_in_out = irrevocable_extended_out_in;
  assign irrevocable_extended_out_out =
    '{valid: irrevocable_control_in_in.valid, bits: irrevocable_payload};
endmodule
}>>|

export:
  ReadyValidCompatibility
  design
  verilog_reference
