#lang rhdl/golf
// Demonstrates the first Golf slice with a compact parameterized adder and top-level elaboration.

c Adder(w)[a,b->sum:B(w)]=a+b

top Adder(8)

def verilog_reference = @str|<<{
module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule
}>>|

export:
  Adder
  design
  verilog_reference
