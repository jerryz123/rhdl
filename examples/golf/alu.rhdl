#lang rhdl/golf
// Demonstrates dense selection and positional multiple-output Golf logic.

c ALU(w)[a,b:B(w),op:B(3)->result:B(w),equal:Bool]=[sel(op,!a,a&b,a|||b,a^b,a+b,a-b),a===b]

top ALU(8)

def verilog_reference = @str|<<{
module ALU(
  input  [7:0] a,
               b,
  input  [2:0] op,
  output [7:0] result,
  output       equal
);

  wire [7:0][7:0] _GEN = {{~a}, {~a}, {~a}, {a - b}, {a + b}, {a ^ b}, {a | b}, {a & b}};
  assign result = _GEN[op];
  assign equal = a == b;
endmodule
}>>|

export:
  ALU
  design
  verilog_reference
