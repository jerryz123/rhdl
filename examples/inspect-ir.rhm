#lang rhombus
// Demonstrates backend-independent inspection of an elaborated RHDL design.

import:
  lib("rhdl/core/main.rhm") open
  "lop/adder-standard.rhdl" as adder

fun operation_count(design, opcode):
  design.walk().filter(
    ~keep: fun (operation): operation.opcode == opcode
  ).length()

fun summarize_design(design):
  [["modules", design.modules.length()],
   ["operations", design.walk().length()],
   ["additions", operation_count(design, "rtl.add")]]

print(summarize_design(adder.design))

export:
  operation_count
  summarize_design
