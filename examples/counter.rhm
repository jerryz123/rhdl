#lang rhombus
// Builds a synchronous-reset counter and prints its RHDL IR and CIRCT lowering.

import:
  "../rhdl/main.rhm" open

def design = Design()
def builder = Builder(design)
def counter = builder.module("Counter8")
def clk = builder.input(counter, "clk", Bits(1))
def reset = builder.input(counter, "reset", Bits(1))
def count = builder.output(counter, "count", Bits(8))
def zero = builder.constant(counter, Bits(8), 0, "zero")
def one = builder.constant(counter, Bits(8), 1, "one")
def state = builder.register(counter,
                             "state",
                             Bits(8),
                             clk,
                             reset,
                             zero)
def next = builder.add(counter, state.current, one, "next")
builder.drive(state.next, next)
builder.drive(count, state.current)
def readable_count = builder.read(count)
def finished_counter = builder.finish(counter)

verify_design(design)
println(dump_ir(design))
println(emit_circt(design))
