#lang rhdl
// Defines the canonical embedded RHDL datapath for width-changing operations.

circuit WidthOps8():
  def a = input("a", Bits(8))
  def b = input("b", Bits(4))
  def joined = output("joined", Bits(12))
  def middle = output("middle", Bits(4))
  def widened = output("widened", Bits(12))
  def narrowed = output("narrowed", Bits(4))

  def joined_value = concat([a, b], "joined_value")
  def middle_value = extract(a, 5, 2, "middle_value")
  def widened_value = zext(a, 12, "widened_value")
  def narrowed_value = trunc(a, 4, "narrowed_value")
  joined <== joined_value
  middle <== middle_value
  widened <== widened_value
  narrowed <== narrowed_value

def design = elaborate(WidthOps8())

export:
  design
