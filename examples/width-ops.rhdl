#lang rhdl
// Defines the canonical width-changing RHDL datapath with concise connections.

circuit WidthOps8():
  input a: Bits(8)
  input b: Bits(4)
  output joined: Bits(12)
  output(middle, narrowed): Bits(4)
  output widened: Bits(12)

  joined <== concat([a, b])
  middle <== extract(a, 5, 2)
  widened <== zext(a, 12)
  narrowed <== trunc(a, 4)

def design = elaborate(WidthOps8())

export:
  WidthOps8
  design
