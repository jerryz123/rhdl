#lang rhdl
// Defines the canonical frontend datapath for explicit width-changing operations.

module WidthOps8():
  input:
    a: Bits(8)
    b: Bits(4)
  output:
    joined: Bits(12)
    middle: Bits(4)
    widened: Bits(12)
    narrowed: Bits(4)

  joined_value = concat(a, b)
  middle_value = extract(a, 5, 2)
  widened_value = zext(a, 12)
  narrowed_value = trunc(a, 4)
  joined := joined_value
  middle := middle_value
  widened := widened_value
  narrowed := narrowed_value

elaborate(WidthOps8())
