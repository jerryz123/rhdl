#lang rhombus
// Builds a reused child-module hierarchy and prints its RHDL IR and CIRCT lowering.

import:
  "../rhdl/main.rhm" open

def design = Design()
def builder = Builder(design)

def adder = builder.module("Adder8")
def child_a = builder.input(adder, "a", Bits(8))
def child_b = builder.input(adder, "b", Bits(8))
def child_sum = builder.output(adder, "sum", Bits(8))
def child_result = builder.add(adder, child_a, child_b, "result")
builder.drive(child_sum, child_result)
def finished_adder = builder.finish(adder)

def top = builder.module("TwoAdders")
def a = builder.input(top, "a", Bits(8))
def b = builder.input(top, "b", Bits(8))
def c = builder.input(top, "c", Bits(8))
def sum0 = builder.output(top, "sum0", Bits(8))
def sum1 = builder.output(top, "sum1", Bits(8))
def u0 = builder.instance(top, adder, "u0")
def u1 = builder.instance(top, adder, "u1")
builder.drive(u0.input("a"), a)
builder.drive(u0.input("b"), b)
builder.drive(u1.input("a"), a)
builder.drive(u1.input("b"), c)
builder.drive(sum0, u0.output("sum"))
builder.drive(sum1, u1.output("sum"))
def finished_top = builder.finish(top)

verify_design(design)
println(dump_ir(design))
println(emit_circt(design))
