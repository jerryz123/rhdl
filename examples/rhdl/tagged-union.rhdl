#lang rhdl
// Demonstrates payload-bearing and nullary variants sharing nominal enum tags.

bundle WritePayload():
  address: Bits(8)
  data: Bits(8)

tagged_union Request:
  Idle
  Read(Bits(8))
  Write(WritePayload())

tagged_union ExplicitRequest(~width: 4):
  Idle = 3
  Read(Bits(8)) = 9

tagged_union OneHotRequest(~encoding: one_hot):
  Idle
  Data(Bits(8))

tagged_union Option(T :: DataType):
  None
  Some(T)

def idle_request = Request.Idle
def read_request = Request.Read(bits(0x5A, 8))

circuit TaggedUnionRouter():
  input request: Request
  input write_payload: WritePayload()
  output request_tag: Request.tag_type
  output is_idle: Bits(1)
  output is_read: Bits(1)
  output read_payload: Bits(8)
  output write_address: Bits(8)
  output rebuilt_write: Request

  def read = request.view(Request.Read)
  def write = request.view(Request.Write)
  request_tag <== request.tag
  is_idle <== request.is(Request.Idle)
  is_read <== read.valid
  read_payload <== read.payload
  write_address <== write.payload.address
  rebuilt_write <== Request.Write(write_payload)

def design = elaborate(TaggedUnionRouter())

export:
  WritePayload
  Request
  ExplicitRequest
  OneHotRequest
  Option
  idle_request
  read_request
  TaggedUnionRouter
  design
