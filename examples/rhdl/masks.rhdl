#lang rhdl
// Demonstrates nominal lane-set masks, safe selector widening, and set operations.

circuit LaneSets(n :: PosInt):
  input requested: Mask(n)
  input available: Mask(n)
  input exact: OneHot(n)
  input optional: MaybeOneHot(n)
  output eligible: Mask(n)
  output exact_set: Mask(n)
  output optional_set: Mask(n)
  output any_eligible: Bool
  output first_eligible: MaybeOneHot(n)

  eligible <== requested & available
  exact_set <== exact.into(Mask(n))
  optional_set <== optional.into(Mask(n))
  any_eligible <== or_reduce(eligible)
  first_eligible <== priority_encoder_oh(eligible)

def design = elaborate(LaneSets(4))

export:
  LaneSets
  design
