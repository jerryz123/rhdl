#lang rhdl
// Showcases host iteration creating fresh definitions without automatic deduplication.

circuit Adder(width :: PosInt):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

circuit Top(width :: PosInt):
  for:
    each ignored in [0, 1]
    Adder(width)

def design = elaborate(Top(8))

def verilog_reference = @str|<<{
module Top();
endmodule

module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule

module Adder_1(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule
}>>|

export:
  Adder
  Top
  design
  verilog_reference
