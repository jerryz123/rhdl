#lang rhdl
// Composes host-specialized predicate filters through a reusable Valid interface.

import:
  lib("rhdl/std/ready-valid.rhdl") open

circuit PredicateFilter(T :: DataType,
                        predicate :: Function.of_arity(1)):
  interface ingress(Valid(T), ~role: consumer)
  interface egress(Valid(T), ~role: producer)

  egress.valid <== ingress.valid & predicate(ingress.bits)
  egress.bits <== ingress.bits

fun SingleFilter(T :: DataType):
  fun is_single_digit(x :: Hardware.of(T)) :: Bool:
    x <= bits(9, T.width)

  PredicateFilter(T, is_single_digit)

fun EvenFilter(T :: DataType):
  // This preserves the source example's predicate: it accepts values whose
  // low bit is set, despite the factory's original EvenFilter name.
  fun has_low_bit_set(x :: Hardware.of(T)) :: Bool:
    x[0].into(Bool)

  PredicateFilter(T, has_low_bit_set)

circuit SingleEvenFilter(T :: DataType):
  interface ingress(Valid(T), ~role: consumer)
  interface egress(Valid(T), ~role: producer)

  inst single(SingleFilter(T))
  inst even(EvenFilter(T))

  ingress |> single.ingress
  single.egress |> even.ingress
  even.egress |> egress

def design = elaborate(SingleEvenFilter(Bits(8)))

def verilog_reference = @str|<<{
module SingleEvenFilter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  wire struct packed {logic valid; logic [7:0] bits; } _single_egress_out;
  PredicateFilter single (
    .ingress_in (ingress_in),
    .egress_out (_single_egress_out)
  );
  PredicateFilter_1 even (
    .ingress_in (_single_egress_out),
    .egress_out (egress_out)
  );
endmodule

module PredicateFilter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  assign egress_out =
    '{valid: (ingress_in.valid & ingress_in.bits < 8'hA), bits: ingress_in.bits};
endmodule

module PredicateFilter_1(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  assign egress_out =
    '{valid: (ingress_in.valid & ingress_in.bits[0]), bits: ingress_in.bits};
endmodule
}>>|

export:
  PredicateFilter
  SingleFilter
  EvenFilter
  SingleEvenFilter
  design
  verilog_reference
