#lang rhdl
// Demonstrates explicit-role interfaces layered over directional record ports.

interface ReadyValid(T):
  role producer
  role consumer

  producer -> consumer:
    valid: Bool
    bits: T

  consumer -> producer:
    ready: Bool

circuit ReadyValidAdapter(width):
  interface ingress(ReadyValid(Bits(width)), ~role: consumer)
  interface egress(ReadyValid(Bits(width)), ~role: producer)

  egress <=> ingress

circuit ReadyValidSource(width):
  input valid: Bool
  input bits_in: Bits(width)
  output accepted: Bool
  interface tx(ReadyValid(Bits(width)), ~role: producer)

  tx.valid <== valid
  tx.bits <== bits_in
  accepted <== tx.ready

circuit ReadyValidHierarchy(width):
  input valid: Bool
  input bits_in: Bits(width)
  output accepted: Bool
  interface tx(ReadyValid(Bits(width)), ~role: producer)

  inst source(ReadyValidSource(width))
  source.valid <== valid
  source.bits_in <== bits_in
  accepted <== source.accepted
  tx <=> source.tx

def design = elaborate(ReadyValidAdapter(8))

def verilog_reference = @str|<<{
module ReadyValidAdapter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress__producer_to_consumer,
  input  struct packed {logic ready; }                   egress__consumer_to_producer,
  output struct packed {logic ready; }                   ingress__consumer_to_producer,
  output struct packed {logic valid; logic [7:0] bits; } egress__producer_to_consumer
);

  assign ingress__consumer_to_producer = egress__consumer_to_producer;
  assign egress__producer_to_consumer = ingress__producer_to_consumer;
endmodule
}>>|

export:
  ReadyValid
  ReadyValidAdapter
  ReadyValidSource
  ReadyValidHierarchy
  design
  verilog_reference
