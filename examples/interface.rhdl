#lang rhdl
// Demonstrates explicit-role interfaces layered over directional record ports.

import:
  lib("rhdl/std/ready-valid.rhdl") open

circuit ReadyValidAdapter(width):
  interface ingress(Decoupled(Bits(width)), ~role: consumer)
  interface egress(Decoupled(Bits(width)), ~role: producer)

  egress <=> ingress

circuit ReadyValidSource(width):
  input valid: Bool
  input bits_in: Bits(width)
  output accepted: Bool
  interface tx(Decoupled(Bits(width)), ~role: producer)

  tx.valid <== valid
  tx.bits <== bits_in
  accepted <== tx.ready

circuit ReadyValidHierarchy(width):
  input valid: Bool
  input bits_in: Bits(width)
  output accepted: Bool
  interface tx(Decoupled(Bits(width)), ~role: producer)

  inst source(ReadyValidSource(width))
  source.valid <== valid
  source.bits_in <== bits_in
  accepted <== source.accepted
  tx <=> source.tx

def design = elaborate(ReadyValidAdapter(8))

def verilog_reference = @str|<<{
module ReadyValidAdapter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  assign ingress_out = egress_in;
  assign egress_out = ingress_in;
endmodule
}>>|

export:
  ReadyValidAdapter
  ReadyValidSource
  ReadyValidHierarchy
  design
  verilog_reference
