#lang rhdl
// Builds a four-bit ripple-carry adder from one reusable FullAdder definition.

import:
  "full-adder.rhdl".FullAdder

circuit Adder4():
  input(A, B): Bits(4)
  input Cin: Bits(1)
  output Sum: Bits(4)
  output Cout: Bits(1)

  def FullAdderModule = FullAdder()
  inst adder0(FullAdderModule)
  inst adder1(FullAdderModule)
  inst adder2(FullAdderModule)
  inst adder3(FullAdderModule)

  adder0.a <== cast(A[0], Bool)
  adder0.b <== cast(B[0], Bool)
  adder0.cin <== cast(Cin, Bool)

  adder1.a <== cast(A[1], Bool)
  adder1.b <== cast(B[1], Bool)
  adder1.cin <== adder0.cout

  adder2.a <== cast(A[2], Bool)
  adder2.b <== cast(B[2], Bool)
  adder2.cin <== adder1.cout

  adder3.a <== cast(A[3], Bool)
  adder3.b <== cast(B[3], Bool)
  adder3.cin <== adder2.cout

  Sum <== concat([
    cast(adder3.sum, Bits(1)),
    cast(adder2.sum, Bits(1)),
    cast(adder1.sum, Bits(1)),
    cast(adder0.sum, Bits(1))
  ])
  Cout <== cast(adder3.cout, Bits(1))

def design = elaborate(Adder4())

export:
  Adder4
  design
