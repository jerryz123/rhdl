#lang rhdl
// Builds a four-bit ripple-carry adder from one reusable FullAdder definition.

import:
  "full-adder.rhdl".FullAdder

circuit Adder4():
  input(A, B): Bits(4)
  input Cin: Bits(1)
  output Sum: Bits(4)
  output Cout: Bits(1)

  def FullAdderModule = FullAdder()
  inst adder0(FullAdderModule)
  inst adder1(FullAdderModule)
  inst adder2(FullAdderModule)
  inst adder3(FullAdderModule)

  adder0.a <== A[0].into(Bool)
  adder0.b <== B[0].into(Bool)
  adder0.cin <== Cin.into(Bool)

  adder1.a <== A[1].into(Bool)
  adder1.b <== B[1].into(Bool)
  adder1.cin <== adder0.cout

  adder2.a <== A[2].into(Bool)
  adder2.b <== B[2].into(Bool)
  adder2.cin <== adder1.cout

  adder3.a <== A[3].into(Bool)
  adder3.b <== B[3].into(Bool)
  adder3.cin <== adder2.cout

  Sum <== concat([
    adder3.sum.into(Bits(1)),
    adder2.sum.into(Bits(1)),
    adder1.sum.into(Bits(1)),
    adder0.sum.into(Bits(1))
  ])
  Cout <== adder3.cout.into(Bits(1))

def design = elaborate(Adder4())

export:
  Adder4
  design
