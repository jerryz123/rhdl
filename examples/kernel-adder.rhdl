#lang rhdl
// Uses only explicit elaboration-kernel forms available within #lang rhdl.

export:
  KernelAdder
  design

fun KernelAdder(width):
  fun implementation():
    def a = input("a", Bits(width))
    def b = input("b", Bits(width))
    def sum = output("sum", Bits(width))
    def result = hw_add(a, b)
    connect(sum, result)
  build_circuit("KernelAdder", [width], implementation)

def design = run_elaboration(fun (): KernelAdder(8))
