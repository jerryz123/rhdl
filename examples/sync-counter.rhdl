#lang rhdl
// Demonstrates sync circuits, ambient registers, and nested clock/reset propagation.

sync_circuit Counter(width):
  output count: Bits(width)

  reg state(Bits(width), ~init: bits(0, ~width: width))
  state.next <== state + bits(1, ~width: width)
  count <== state

sync_circuit CounterTop(width):
  output count: Bits(width)

  def CounterModule = Counter(width)
  inst counter(CounterModule)
  count <== counter.count

sync_circuit ResetlessCounter(width):
  output count: Bits(width)

  reg state(Bits(width))
  state.next <== state + bits(1, ~width: width)
  count <== state

// An ordinary parent can supply a sync child's domain explicitly.
circuit ExplicitClockTop(width):
  input source_clock: Clock
  input source_reset: Reset
  output count: Bits(width)

  def CounterModule = Counter(width)
  inst counter(CounterModule,
               ~clock: source_clock,
               ~reset: source_reset)
  count <== counter.count

def design = elaborate(CounterTop(8))

def verilog_reference = @str|<<{
module CounterTop(
  input        clock,
               reset,
  output [7:0] count
);

  Counter counter (
    .clock (clock),
    .reset (reset),
    .count (count)
  );
endmodule

module Counter(
  input        clock,
               reset,
  output [7:0] count
);

  reg [7:0] state;
  always @(posedge clock) begin
    if (reset)
      state <= 8'h0;
    else
      state <= state + 8'h1;
  end // always @(posedge)
  assign count = state;
endmodule
}>>|

export:
  Counter
  CounterTop
  ResetlessCounter
  ExplicitClockTop
  design
  verilog_reference
