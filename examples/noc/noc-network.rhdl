#lang rhodium
// Assembles three user-owned router subsystems into a validated two-hop transport.

import:
  "../../noc/model/main.rhm" open
  "../../noc/plan/main.rhm" open
  lib("rhodium/std/ready-valid.rhdl") open
  "../../noc/rtl/main.rhdl" open

def n0 = NodeId(0)
def n1 = NodeId(1)
def n2 = NodeId(2)
def first = PhysicalLink(LinkId(0), n0, n1, 1)
def second = PhysicalLink(LinkId(1), n1, n2, 1)
def topology = Topology([n2, n0, n1], [second, first])
def near_route = RouteClass(RouteClassId(0), n0, n1)
def far_route = RouteClass(RouteClassId(1), n0, n2)

fun on_link(vc :: VCId, link :: PhysicalLink):
  link_id_equal(vc.link_id, link.id)

fun allows(route_class :: RouteClass,
           origin :: Injection || HeldVC,
           candidate :: VCId):
  cond
  | origin is_a Injection:
      on_link(candidate, first)
  | origin is_a HeldVC:
      route_class_id_equal(route_class.id, far_route.id) && (
        on_link(origin.vc, first)
      ) && (
        on_link(candidate, second)
      )
  | ~else: #false

def routing = compile_routing(
  RoutingProblem(
    topology,
    [far_route, near_route],
    RoutingRelation(allows)
  )
)
unless routing is_a ValidatedRouting
| error(~who: #'HierarchicalNoCFixture,
        "example routing must pass validation before hardware generation")

def network_plan = NetworkPlan(routing)
def source_config = compile_simple_router(network_plan.router_plan(n0))
def transit_config = compile_simple_router(network_plan.router_plan(n1))
def destination_config = compile_simple_router(network_plan.router_plan(n2))

def first_vc = VCId(first.id, 0)
def second_vc = VCId(second.id, 0)
def first_connection = network_plan.vc_connection(first_vc)
def second_connection = network_plan.vc_connection(second_vc)
def source_injection = network_plan.injection_port(InjectionId(0))
def near_ejection = network_plan.ejection_port(EjectionId(1))
def far_ejection = network_plan.ejection_port(EjectionId(2))

// Each user subsystem owns only its local router and chooses how the physical
// VC endpoints appear at its hierarchy boundary.
sync_circuit SourceSubsystem(config :: SimpleRouterConfig,
                             injection_index :: Nat,
                             outgoing_index :: Nat):
  def Beat = RoutedBeat(Bits(8), config.route_decoder.route_width)
  interface injection(Decoupled(Beat), ~role: consumer)
  interface outgoing(Decoupled(Beat), ~role: producer)

  inst router(SimpleRouter(Bits(8), config))
  injection |> router.ingress[injection_index]
  router.target[outgoing_index].egress |> outgoing
  router.target[outgoing_index].available <== router.target[outgoing_index].egress.ready

sync_circuit TransitSubsystem(config :: SimpleRouterConfig,
                              incoming_index :: Nat,
                              outgoing_index :: Nat,
                              ejection_index :: Nat):
  def Beat = RoutedBeat(Bits(8), config.route_decoder.route_width)
  interface incoming(Decoupled(Beat), ~role: consumer)
  interface outgoing(Decoupled(Beat), ~role: producer)
  interface ejection(Decoupled(Beat), ~role: producer)

  inst router(SimpleRouter(Bits(8), config))
  incoming |> router.ingress[incoming_index]
  router.target[outgoing_index].egress |> outgoing
  router.target[outgoing_index].available <== router.target[outgoing_index].egress.ready
  router.target[ejection_index].egress |> ejection
  router.target[ejection_index].available <== router.target[ejection_index].egress.ready

sync_circuit DestinationSubsystem(config :: SimpleRouterConfig,
                                  incoming_index :: Nat,
                                  ejection_index :: Nat):
  def Beat = RoutedBeat(Bits(8), config.route_decoder.route_width)
  interface incoming(Decoupled(Beat), ~role: consumer)
  interface ejection(Decoupled(Beat), ~role: producer)

  inst router(SimpleRouter(Bits(8), config))
  incoming |> router.ingress[incoming_index]
  router.target[ejection_index].egress |> ejection
  router.target[ejection_index].available <== router.target[ejection_index].egress.ready

// The system, not noc/rtl, owns placement in the hierarchy and physical-link
// connections between independently elaborated router-containing subsystems.
sync_circuit HierarchicalNoCFixture():
  def Beat = RoutedBeat(Bits(8), source_config.route_decoder.route_width)
  interface injection(Decoupled(Beat), ~role: consumer)
  interface ejection[2](Decoupled(Beat), ~role: producer)

  inst source(SourceSubsystem(
    source_config,
    source_injection.input_index,
    first_connection.source_target_index
  ))
  inst transit(TransitSubsystem(
    transit_config,
    first_connection.destination_input_index,
    second_connection.source_target_index,
    near_ejection.target_index
  ))
  inst destination(DestinationSubsystem(
    destination_config,
    second_connection.destination_input_index,
    far_ejection.target_index
  ))

  injection |> source.injection
  source.outgoing |> transit.incoming
  transit.outgoing |> destination.incoming
  transit.ejection |> ejection[0]
  destination.ejection |> ejection[1]

def design = elaborate(HierarchicalNoCFixture())

// Updated mechanically by the focused CIRCT golden command.
def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic route_key; logic [7:0] payload; } RoutedBeat;
  typedef struct packed {logic route_key; logic origin_key; } RouteLookupKey;
  typedef struct packed {logic target_mask; logic fallback_mask; logic valid; }
    RouteDecision;
  typedef struct packed {logic valid; logic grant; logic index; } CircularPriorityChoice;
  typedef
    struct packed {logic [1:0] target_mask; logic [1:0] fallback_mask; logic valid; }
    RouteDecision_1;
`endif // _TYPESCOPE_rhodium_types
module HierarchicalNoCFixture(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } injection_in,
  input  struct packed {logic ready; }                  ejection_0_in,
                                                        ejection_1_in,
  output struct packed {logic ready; }                  injection_out,
  output struct packed {logic valid; RoutedBeat bits; } ejection_0_out,
                                                        ejection_1_out
);

  wire struct packed {logic ready; } _destination_incoming_out;
  wire struct packed {logic ready; } _transit_incoming_out;
  wire struct packed {logic valid; RoutedBeat bits; } _transit_outgoing_out;
  wire struct packed {logic valid; RoutedBeat bits; } _source_outgoing_out;
  SourceSubsystem source (
    .clock         (clock),
    .reset         (reset),
    .injection_in  (injection_in),
    .outgoing_in   (_transit_incoming_out),
    .injection_out (injection_out),
    .outgoing_out  (_source_outgoing_out)
  );
  TransitSubsystem transit (
    .clock        (clock),
    .reset        (reset),
    .incoming_in  (_source_outgoing_out),
    .outgoing_in  (_destination_incoming_out),
    .ejection_in  (ejection_0_in),
    .incoming_out (_transit_incoming_out),
    .outgoing_out (_transit_outgoing_out),
    .ejection_out (ejection_0_out)
  );
  DestinationSubsystem destination (
    .clock        (clock),
    .reset        (reset),
    .incoming_in  (_transit_outgoing_out),
    .ejection_in  (ejection_1_in),
    .incoming_out (_destination_incoming_out),
    .ejection_out (ejection_1_out)
  );
endmodule

module SourceSubsystem(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } injection_in,
  input  struct packed {logic ready; }                  outgoing_in,
  output struct packed {logic ready; }                  injection_out,
  output struct packed {logic valid; RoutedBeat bits; } outgoing_out
);

  wire struct packed {struct packed {logic valid; RoutedBeat bits; } egress; }
    _router_target_0_out;
  wire struct packed {struct packed {logic ready; } egress; logic available; } _GEN =
    '{egress: outgoing_in, available: outgoing_in.ready};
  SimpleRouter router (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (injection_in),
    .target_0_in   (_GEN),
    .ingress_0_out (injection_out),
    .target_0_out  (_router_target_0_out)
  );
  assign outgoing_out = _router_target_0_out.egress;
endmodule

module SimpleRouter(
  input                                                                          clock,
                                                                                 reset,
  input  struct packed {logic valid; RoutedBeat bits; }                          ingress_0_in,
  input  struct packed {struct packed {logic ready; } egress; logic available; } target_0_in,
  output struct packed {logic ready; }                                           ingress_0_out,
  output struct packed {struct packed {logic valid; RoutedBeat bits; } egress; } target_0_out
);

  wire  struct packed {logic ready; } _crossbar_stage_ingress_0_out;
  wire  struct packed {logic valid; RoutedBeat bits; } _crossbar_stage_egress_0_out;
  wire  [0:0][0:0]                    _allocator_grants;
  wire  struct packed {logic valid; RoutedBeat bits; } _queue_stage_egress_out;
  logic [2:0]                         __rhodium_decode_10_result;
  wire  RouteLookupKey                _GEN =
    '{route_key: ingress_0_in.bits.route_key, origin_key: (1'h0)};
  wire  [1:0]                         _GEN_0 = /*cast(bit[1:0])*/_GEN;
  always_comb begin
    case (_GEN_0)
      2'b00:
        __rhodium_decode_10_result = 3'h7;
      2'b10:
        __rhodium_decode_10_result = 3'h7;
      default:
        __rhodium_decode_10_result = 3'h0;
    endcase
  end // always_comb
  wire  RouteDecision                 _GEN_1 = /*cast(bit)*/__rhodium_decode_10_result;
  `ifndef SYNTHESIS
    simple_router_ingress_valid_route_0:
      assert property (@(posedge clock) disable iff (reset)
                         ~ingress_0_in.valid | _GEN_1.valid);
  `endif // not def SYNTHESIS
  logic [2:0]                         __rhodium_decode_26_result;
  wire  RouteLookupKey                _GEN_2 =
    '{route_key: _queue_stage_egress_out.bits.route_key, origin_key: (1'h0)};
  wire  [1:0]                         _GEN_3 = /*cast(bit[1:0])*/_GEN_2;
  always_comb begin
    case (_GEN_3)
      2'b00:
        __rhodium_decode_26_result = 3'h7;
      2'b10:
        __rhodium_decode_26_result = 3'h7;
      default:
        __rhodium_decode_26_result = 3'h0;
    endcase
  end // always_comb
  wire  RouteDecision                 _GEN_4 = /*cast(bit)*/__rhodium_decode_26_result;
  Queue queue_stage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (ingress_0_in),
    .egress_in   (_crossbar_stage_ingress_0_out),
    .ingress_out (ingress_0_out),
    .egress_out  (_queue_stage_egress_out),
    .count       (/* unused */)
  );
  RouterAllocator allocator (
    .clock             (clock),
    .reset             (reset),
    .requests
      ({1{{1{_queue_stage_egress_out.valid & _GEN_4.valid & _GEN_4.target_mask}}}}),
    .fallback_requests
      ({1{{1{_queue_stage_egress_out.valid & _GEN_4.valid & _GEN_4.fallback_mask}}}}),
    .target_available  ({1{target_0_in.available}}),
    .accepts
      ({1{_crossbar_stage_egress_0_out.valid & target_0_in.egress.ready}}),
    .grants            (_allocator_grants)
  );
  GrantCrossbar crossbar_stage (
    .ingress_0_in  (_queue_stage_egress_out),
    .grants        (_allocator_grants),
    .egress_0_in   (target_0_in.egress),
    .ingress_0_out (_crossbar_stage_ingress_0_out),
    .egress_0_out  (_crossbar_stage_egress_0_out)
  );
  assign target_0_out = '{egress: _crossbar_stage_egress_0_out};
endmodule

module Queue(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out,
  output                                                count
);

  reg             occupied;
  RoutedBeat      payload;
  wire            _GEN = ingress_in.valid & ~occupied;
  always @(posedge clock) begin
    if (reset)
      occupied <= 1'h0;
    else
      occupied <= _GEN ^ occupied & egress_in.ready ? _GEN : occupied;
  end // always @(posedge)
  always @(posedge clock)
    payload <= _GEN ? ingress_in.bits : payload;
  assign ingress_out = '{ready: (~occupied)};
  assign egress_out = '{valid: occupied, bits: payload};
  assign count = occupied;
endmodule

module RouterAllocator(
  input             clock,
                    reset,
  input  [0:0][0:0] requests,
                    fallback_requests,
  input  [0:0]      target_available,
                    accepts,
  output [0:0][0:0] grants
);

  wire [0:0] _GEN =
    {1{requests[1'h0][1'h0] & ~fallback_requests[1'h0][1'h0] & target_available[1'h0]}};
  wire       _GEN_0 = /*cast(bit)*/_GEN;
  OutputGreedyRoundRobinMatcher matcher (
    .clock    (clock),
    .reset    (reset),
    .requests ({1{_GEN_0 ? _GEN : fallback_requests[1'h0]}}),
    .accepts  (accepts),
    .grants   (grants)
  );
endmodule

module OutputGreedyRoundRobinMatcher(
  input             clock,
                    reset,
  input  [0:0][0:0] requests,
  input  [0:0]      accepts,
  output [0:0][0:0] grants
);

  reg  [0:0] next_priorities;
  `ifndef SYNTHESIS
    output_greedy_round_robin_matcher_priority_in_range_0:
      assert property (@(posedge clock) disable iff (reset) ~next_priorities[1'h0]);
  `endif // not def SYNTHESIS
  wire       _GEN = /*cast(bit)*/{1{requests[1'h0][1'h0] & ~next_priorities[1'h0]}};
  wire       _GEN_0 = /*cast(bit)*/{1{requests[1'h0][1'h0]}};
  wire       _GEN_1 = _GEN ? _GEN : _GEN_0;
  wire       _GEN_2 = ~(_GEN_1 & accepts[1'h0]) & next_priorities[1'h0];
  always @(posedge clock) begin
    if (reset)
      next_priorities <= '{1'h0};
    else
      next_priorities[1'h0] <= _GEN_2;
  end // always @(posedge)
  assign grants = {1{{1{_GEN_1}}}};
endmodule

module GrantCrossbar(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_0_in,
  input  [0:0][0:0]                                     grants,
  input  struct packed {logic ready; }                  egress_0_in,
  output struct packed {logic ready; }                  ingress_0_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out
);

  wire struct packed {logic ready; } _output_stage_ingress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_0_out;
  wire                               _GEN = /*cast(bit)*/grants[1'h0];
  wire                               _GEN_0 = /*cast(bit)*/{1{grants[1'h0][1'h0]}};
  GrantDemux input_stage (
    .ingress_in   (ingress_0_in),
    .grants       (_GEN),
    .egress_0_in  (_output_stage_ingress_0_out),
    .ingress_out  (ingress_0_out),
    .egress_0_out (_input_stage_egress_0_out)
  );
  GrantMerge output_stage (
    .ingress_0_in  (_input_stage_egress_0_out),
    .grants        (_GEN_0),
    .egress_in     (egress_0_in),
    .ingress_0_out (_output_stage_ingress_0_out),
    .egress_out    (egress_0_out)
  );
endmodule

module GrantDemux(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input                                                 grants,
  input  struct packed {logic ready; }                  egress_0_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out
);

  wire _GEN = /*cast(bit)*/{1{grants & egress_0_in.ready}};
  assign ingress_out = '{ready: _GEN};
  assign egress_0_out = '{valid: (ingress_in.valid & grants), bits: ingress_in.bits};
endmodule

module GrantMerge(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_0_in,
  input                                                 grants,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_0_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out
);

  wire            _GEN = /*cast(bit)*/{1{ingress_0_in.valid}};
  wire            _GEN_0 = grants & _GEN;
  wire [8:0]      _GEN_1 = /*cast(bit[8:0])*/ingress_0_in.bits;
  wire RoutedBeat _GEN_2 = /*cast(bit)*/_GEN_1 & {9{_GEN_0}} | _GEN_1 & {9{~_GEN_0}};
  assign ingress_0_out = '{ready: (grants & egress_in.ready)};
  assign egress_out = '{valid: _GEN_0, bits: _GEN_2};
endmodule

module TransitSubsystem(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } incoming_in,
  input  struct packed {logic ready; }                  outgoing_in,
                                                        ejection_in,
  output struct packed {logic ready; }                  incoming_out,
  output struct packed {logic valid; RoutedBeat bits; } outgoing_out,
                                                        ejection_out
);

  wire struct packed {struct packed {logic valid; RoutedBeat bits; } egress; }
    _router_target_0_out;
  wire struct packed {struct packed {logic valid; RoutedBeat bits; } egress; }
    _router_target_1_out;
  wire struct packed {struct packed {logic ready; } egress; logic available; } _GEN =
    '{egress: ejection_in, available: ejection_in.ready};
  wire struct packed {struct packed {logic ready; } egress; logic available; } _GEN_0 =
    '{egress: outgoing_in, available: outgoing_in.ready};
  SimpleRouter_1 router (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (incoming_in),
    .target_0_in   (_GEN_0),
    .target_1_in   (_GEN),
    .ingress_0_out (incoming_out),
    .target_0_out  (_router_target_0_out),
    .target_1_out  (_router_target_1_out)
  );
  assign outgoing_out = _router_target_0_out.egress;
  assign ejection_out = _router_target_1_out.egress;
endmodule

module SimpleRouter_1(
  input                                                                          clock,
                                                                                 reset,
  input  struct packed {logic valid; RoutedBeat bits; }                          ingress_0_in,
  input  struct packed {struct packed {logic ready; } egress; logic available; } target_0_in,
                                                                                 target_1_in,
  output struct packed {logic ready; }                                           ingress_0_out,
  output struct packed {struct packed {logic valid; RoutedBeat bits; } egress; } target_0_out,
                                                                                 target_1_out
);

  wire  struct packed {logic ready; } _crossbar_stage_ingress_0_out;
  wire  struct packed {logic valid; RoutedBeat bits; } _crossbar_stage_egress_0_out;
  wire  struct packed {logic valid; RoutedBeat bits; } _crossbar_stage_egress_1_out;
  wire  [0:0][1:0]                    _allocator_grants;
  wire  struct packed {logic valid; RoutedBeat bits; } _queue_stage_egress_out;
  logic [4:0]                         __rhodium_decode_12_result;
  wire  RouteLookupKey                _GEN =
    '{route_key: ingress_0_in.bits.route_key, origin_key: (1'h0)};
  wire  [1:0]                         _GEN_0 = /*cast(bit[1:0])*/_GEN;
  always_comb begin
    case (_GEN_0)
      2'b00:
        __rhodium_decode_12_result = 5'h15;
      2'b10:
        __rhodium_decode_12_result = 5'hB;
      default:
        __rhodium_decode_12_result = 5'h0;
    endcase
  end // always_comb
  wire  RouteDecision_1               _GEN_1 = /*cast(bit)*/__rhodium_decode_12_result;
  `ifndef SYNTHESIS
    simple_router_ingress_valid_route_0:
      assert property (@(posedge clock) disable iff (reset)
                         ~ingress_0_in.valid | _GEN_1.valid);
  `endif // not def SYNTHESIS
  logic [4:0]                         __rhodium_decode_28_result;
  wire  RouteLookupKey                _GEN_2 =
    '{route_key: _queue_stage_egress_out.bits.route_key, origin_key: (1'h0)};
  wire  [1:0]                         _GEN_3 = /*cast(bit[1:0])*/_GEN_2;
  always_comb begin
    case (_GEN_3)
      2'b00:
        __rhodium_decode_28_result = 5'h15;
      2'b10:
        __rhodium_decode_28_result = 5'hB;
      default:
        __rhodium_decode_28_result = 5'h0;
    endcase
  end // always_comb
  wire  RouteDecision_1               _GEN_4 = /*cast(bit)*/__rhodium_decode_28_result;
  Queue queue_stage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (ingress_0_in),
    .egress_in   (_crossbar_stage_ingress_0_out),
    .ingress_out (ingress_0_out),
    .egress_out  (_queue_stage_egress_out),
    .count       (/* unused */)
  );
  RouterAllocator_1 allocator (
    .clock             (clock),
    .reset             (reset),
    .requests
      ({1{{{_queue_stage_egress_out.valid & _GEN_4.valid & _GEN_4.target_mask[1]},
           {_queue_stage_egress_out.valid & _GEN_4.valid & _GEN_4.target_mask[0]}}}}),
    .fallback_requests
      ({1{{{_queue_stage_egress_out.valid & _GEN_4.valid & _GEN_4.fallback_mask[1]},
           {_queue_stage_egress_out.valid & _GEN_4.valid & _GEN_4.fallback_mask[0]}}}}),
    .target_available  ({{target_1_in.available}, {target_0_in.available}}),
    .accepts
      ({{_crossbar_stage_egress_1_out.valid & target_1_in.egress.ready},
        {_crossbar_stage_egress_0_out.valid & target_0_in.egress.ready}}),
    .grants            (_allocator_grants)
  );
  GrantCrossbar_1 crossbar_stage (
    .ingress_0_in  (_queue_stage_egress_out),
    .grants        (_allocator_grants),
    .egress_0_in   (target_0_in.egress),
    .egress_1_in   (target_1_in.egress),
    .ingress_0_out (_crossbar_stage_ingress_0_out),
    .egress_0_out  (_crossbar_stage_egress_0_out),
    .egress_1_out  (_crossbar_stage_egress_1_out)
  );
  assign target_0_out = '{egress: _crossbar_stage_egress_0_out};
  assign target_1_out = '{egress: _crossbar_stage_egress_1_out};
endmodule

module RouterAllocator_1(
  input             clock,
                    reset,
  input  [0:0][1:0] requests,
                    fallback_requests,
  input  [1:0]      target_available,
                    accepts,
  output [0:0][1:0] grants
);

  wire [1:0] _GEN =
    {{requests[1'h0][1'h1] & ~fallback_requests[1'h0][1'h1] & target_available[1'h1]},
     {requests[1'h0][1'h0] & ~fallback_requests[1'h0][1'h0] & target_available[1'h0]}};
  OutputGreedyRoundRobinMatcher_1 matcher (
    .clock    (clock),
    .reset    (reset),
    .requests ({1{(|_GEN) ? _GEN : fallback_requests[1'h0]}}),
    .accepts  (accepts),
    .grants   (grants)
  );
endmodule

module OutputGreedyRoundRobinMatcher_1(
  input             clock,
                    reset,
  input  [0:0][1:0] requests,
  input  [1:0]      accepts,
  output [0:0][1:0] grants
);

  reg  [1:0] next_priorities;
  `ifndef SYNTHESIS
    output_greedy_round_robin_matcher_priority_in_range_0:
      assert property (@(posedge clock) disable iff (reset) ~next_priorities[1'h0]);
  `endif // not def SYNTHESIS
  wire       _GEN = /*cast(bit)*/{1{requests[1'h0][1'h0] & ~next_priorities[1'h0]}};
  wire       _GEN_0 = /*cast(bit)*/{1{requests[1'h0][1'h0]}};
  wire       _GEN_1 = _GEN ? _GEN : _GEN_0;
  `ifndef SYNTHESIS
    output_greedy_round_robin_matcher_priority_in_range_1:
      assert property (@(posedge clock) disable iff (reset) ~next_priorities[1'h1]);
  `endif // not def SYNTHESIS
  wire       _GEN_2 = requests[1'h0][1'h1] & ~_GEN_1;
  wire       _GEN_3 = /*cast(bit)*/{1{_GEN_2 & ~next_priorities[1'h1]}};
  wire       _GEN_4 = /*cast(bit)*/{1{_GEN_2}};
  wire       _GEN_5 = _GEN_3 ? _GEN_3 : _GEN_4;
  wire       _GEN_6 = ~(_GEN_1 & accepts[1'h0]) & next_priorities[1'h0];
  wire       _GEN_7 = ~(_GEN_5 & accepts[1'h1]) & next_priorities[1'h1];
  always @(posedge clock) begin
    if (reset)
      next_priorities <= '{1'h0, 1'h0};
    else begin
      next_priorities[1'h1] <= _GEN_7;
      next_priorities[1'h0] <= _GEN_6;
    end
  end // always @(posedge)
  assign grants = {1{{{_GEN_5}, {_GEN_1}}}};
endmodule

module GrantCrossbar_1(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_0_in,
  input  [0:0][1:0]                                     grants,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
  output struct packed {logic ready; }                  ingress_0_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out,
                                                        egress_1_out
);

  wire struct packed {logic ready; } _output_stage_1_ingress_0_out;
  wire struct packed {logic ready; } _output_stage_ingress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_1_out;
  wire                               _GEN = /*cast(bit)*/{1{grants[1'h0][1'h0]}};
  wire                               _GEN_0 = /*cast(bit)*/{1{grants[1'h0][1'h1]}};
  GrantDemux_1 input_stage (
    .ingress_in   (ingress_0_in),
    .grants       (grants[1'h0]),
    .egress_0_in  (_output_stage_ingress_0_out),
    .egress_1_in  (_output_stage_1_ingress_0_out),
    .ingress_out  (ingress_0_out),
    .egress_0_out (_input_stage_egress_0_out),
    .egress_1_out (_input_stage_egress_1_out)
  );
  GrantMerge output_stage (
    .ingress_0_in  (_input_stage_egress_0_out),
    .grants        (_GEN),
    .egress_in     (egress_0_in),
    .ingress_0_out (_output_stage_ingress_0_out),
    .egress_out    (egress_0_out)
  );
  GrantMerge output_stage_1 (
    .ingress_0_in  (_input_stage_egress_1_out),
    .grants        (_GEN_0),
    .egress_in     (egress_1_in),
    .ingress_0_out (_output_stage_1_ingress_0_out),
    .egress_out    (egress_1_out)
  );
endmodule

module GrantDemux_1(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  [1:0]                                          grants,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out,
                                                        egress_1_out
);

  assign ingress_out =
    '{ready: (|({{grants[1] & egress_1_in.ready}, {grants[0] & egress_0_in.ready}}))};
  assign egress_0_out = '{valid: (ingress_in.valid & grants[0]), bits: ingress_in.bits};
  assign egress_1_out = '{valid: (ingress_in.valid & grants[1]), bits: ingress_in.bits};
endmodule

module DestinationSubsystem(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } incoming_in,
  input  struct packed {logic ready; }                  ejection_in,
  output struct packed {logic ready; }                  incoming_out,
  output struct packed {logic valid; RoutedBeat bits; } ejection_out
);

  wire struct packed {struct packed {logic valid; RoutedBeat bits; } egress; }
    _router_target_0_out;
  wire struct packed {struct packed {logic ready; } egress; logic available; } _GEN =
    '{egress: ejection_in, available: ejection_in.ready};
  SimpleRouter_2 router (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (incoming_in),
    .target_0_in   (_GEN),
    .ingress_0_out (incoming_out),
    .target_0_out  (_router_target_0_out)
  );
  assign ejection_out = _router_target_0_out.egress;
endmodule

module SimpleRouter_2(
  input                                                                          clock,
                                                                                 reset,
  input  struct packed {logic valid; RoutedBeat bits; }                          ingress_0_in,
  input  struct packed {struct packed {logic ready; } egress; logic available; } target_0_in,
  output struct packed {logic ready; }                                           ingress_0_out,
  output struct packed {struct packed {logic valid; RoutedBeat bits; } egress; } target_0_out
);

  wire  struct packed {logic ready; } _crossbar_stage_ingress_0_out;
  wire  struct packed {logic valid; RoutedBeat bits; } _crossbar_stage_egress_0_out;
  wire  [0:0][0:0]                    _allocator_grants;
  wire  struct packed {logic valid; RoutedBeat bits; } _queue_stage_egress_out;
  logic [2:0]                         __rhodium_decode_10_result;
  wire  RouteLookupKey                _GEN =
    '{route_key: ingress_0_in.bits.route_key, origin_key: (1'h0)};
  wire  [1:0]                         _GEN_0 = /*cast(bit[1:0])*/_GEN;
  always_comb begin
    case (_GEN_0)
      2'b10:
        __rhodium_decode_10_result = 3'h7;
      default:
        __rhodium_decode_10_result = 3'h0;
    endcase
  end // always_comb
  wire  RouteDecision                 _GEN_1 = /*cast(bit)*/__rhodium_decode_10_result;
  `ifndef SYNTHESIS
    simple_router_ingress_valid_route_0:
      assert property (@(posedge clock) disable iff (reset)
                         ~ingress_0_in.valid | _GEN_1.valid);
  `endif // not def SYNTHESIS
  logic [2:0]                         __rhodium_decode_26_result;
  wire  RouteLookupKey                _GEN_2 =
    '{route_key: _queue_stage_egress_out.bits.route_key, origin_key: (1'h0)};
  wire  [1:0]                         _GEN_3 = /*cast(bit[1:0])*/_GEN_2;
  always_comb begin
    case (_GEN_3)
      2'b10:
        __rhodium_decode_26_result = 3'h7;
      default:
        __rhodium_decode_26_result = 3'h0;
    endcase
  end // always_comb
  wire  RouteDecision                 _GEN_4 = /*cast(bit)*/__rhodium_decode_26_result;
  Queue queue_stage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (ingress_0_in),
    .egress_in   (_crossbar_stage_ingress_0_out),
    .ingress_out (ingress_0_out),
    .egress_out  (_queue_stage_egress_out),
    .count       (/* unused */)
  );
  RouterAllocator allocator (
    .clock             (clock),
    .reset             (reset),
    .requests
      ({1{{1{_queue_stage_egress_out.valid & _GEN_4.valid & _GEN_4.target_mask}}}}),
    .fallback_requests
      ({1{{1{_queue_stage_egress_out.valid & _GEN_4.valid & _GEN_4.fallback_mask}}}}),
    .target_available  ({1{target_0_in.available}}),
    .accepts
      ({1{_crossbar_stage_egress_0_out.valid & target_0_in.egress.ready}}),
    .grants            (_allocator_grants)
  );
  GrantCrossbar crossbar_stage (
    .ingress_0_in  (_queue_stage_egress_out),
    .grants        (_allocator_grants),
    .egress_0_in   (target_0_in.egress),
    .ingress_0_out (_crossbar_stage_ingress_0_out),
    .egress_0_out  (_crossbar_stage_egress_0_out)
  );
  assign target_0_out = '{egress: _crossbar_stage_egress_0_out};
endmodule
