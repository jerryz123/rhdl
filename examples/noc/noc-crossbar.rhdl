                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out,
  output                                                count
);

  reg             occupied;
  RoutedBeat      payload;
  wire            _GEN = ingress_in.valid & ~occupied;
  always @(posedge clock) begin
    if (reset)
      occupied <= 1'h0;
    else
      occupied <= _GEN ^ occupied & egress_in.ready ? _GEN : occupied;
  end // always @(posedge)
  always @(posedge clock)
    payload <= _GEN ? ingress_in.bits : payload;
  assign ingress_out = '{ready: (~occupied)};
  assign egress_out = '{valid: occupied, bits: payload};
  assign count = occupied;
endmodule

module Queue_2(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out,
  output                                                count
);

  reg             occupied;
  RoutedBeat      payload;
  wire            _GEN = ingress_in.valid & ~occupied;
  always @(posedge clock) begin
    if (reset)
      occupied <= 1'h0;
    else
      occupied <= _GEN ^ occupied & egress_in.ready ? _GEN : occupied;
  end // always @(posedge)
  always @(posedge clock)
    payload <= _GEN ? ingress_in.bits : payload;
  assign ingress_out = '{ready: (~occupied)};
  assign egress_out = '{valid: occupied, bits: payload};
  assign count = occupied;
endmodule

module GreedyMatcher(
  input  [2:0][2:0] requests,
  output [2:0][2:0] grants
);

  wire _GEN = requests[2'h0][2'h1] & ~requests[2'h0][2'h0];
  wire _GEN_0 = requests[2'h0][2'h2] & ~(requests[2'h0][2'h0] | _GEN);
  wire _GEN_1 = requests[2'h1][2'h0] & ~requests[2'h0][2'h0];
  wire _GEN_2 = requests[2'h1][2'h1] & ~_GEN_1 & ~_GEN;
  wire _GEN_3 = requests[2'h1][2'h2] & ~(_GEN_1 | _GEN_2) & ~_GEN_0;
  wire _GEN_4 = requests[2'h2][2'h0] & ~(requests[2'h0][2'h0] | _GEN_1);
  wire _GEN_5 = requests[2'h2][2'h1] & ~_GEN_4 & ~(_GEN | _GEN_2);
  assign grants =
    {{{{requests[2'h2][2'h2] & ~(_GEN_4 | _GEN_5) & ~(_GEN_0 | _GEN_3)},
       {_GEN_5},
       {_GEN_4}}},
     {{{_GEN_3}, {_GEN_2}, {_GEN_1}}},
     {{{_GEN_0}, {_GEN}, {requests[2'h0][2'h0]}}}};
endmodule

module GrantCrossbar(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_0_in,
                                                        ingress_1_in,
                                                        ingress_2_in,
  input  [2:0][2:0]                                     grants,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
                                                        egress_2_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
                                                        ingress_2_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out,
                                                        egress_1_out,
                                                        egress_2_out
);

  wire struct packed {logic ready; } _output_stage_2_ingress_0_out;
  wire struct packed {logic ready; } _output_stage_2_ingress_1_out;
  wire struct packed {logic ready; } _output_stage_2_ingress_2_out;
  wire struct packed {logic ready; } _output_stage_1_ingress_0_out;
  wire struct packed {logic ready; } _output_stage_1_ingress_1_out;
  wire struct packed {logic ready; } _output_stage_1_ingress_2_out;
  wire struct packed {logic ready; } _output_stage_ingress_0_out;
  wire struct packed {logic ready; } _output_stage_ingress_1_out;
  wire struct packed {logic ready; } _output_stage_ingress_2_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_2_egress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_2_egress_1_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_2_egress_2_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_1_egress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_1_egress_1_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_1_egress_2_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_1_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_2_out;
  GrantDemux input_stage (
    .ingress_in   (ingress_0_in),
    .grants       (grants[2'h0]),
    .egress_0_in  (_output_stage_ingress_0_out),
    .egress_1_in  (_output_stage_1_ingress_0_out),
    .egress_2_in  (_output_stage_2_ingress_0_out),
    .ingress_out  (ingress_0_out),
    .egress_0_out (_input_stage_egress_0_out),
    .egress_1_out (_input_stage_egress_1_out),
    .egress_2_out (_input_stage_egress_2_out)
  );
  GrantDemux_1 input_stage_1 (
    .ingress_in   (ingress_1_in),
    .grants       (grants[2'h1]),
    .egress_0_in  (_output_stage_ingress_1_out),
    .egress_1_in  (_output_stage_1_ingress_1_out),
    .egress_2_in  (_output_stage_2_ingress_1_out),
    .ingress_out  (ingress_1_out),
    .egress_0_out (_input_stage_1_egress_0_out),
    .egress_1_out (_input_stage_1_egress_1_out),
    .egress_2_out (_input_stage_1_egress_2_out)
  );
  GrantDemux_2 input_stage_2 (
    .ingress_in   (ingress_2_in),
    .grants       (grants[2'h2]),
    .egress_0_in  (_output_stage_ingress_2_out),
    .egress_1_in  (_output_stage_1_ingress_2_out),
    .egress_2_in  (_output_stage_2_ingress_2_out),
    .ingress_out  (ingress_2_out),
    .egress_0_out (_input_stage_2_egress_0_out),
    .egress_1_out (_input_stage_2_egress_1_out),
    .egress_2_out (_input_stage_2_egress_2_out)
  );
  GrantMerge output_stage (
    .ingress_0_in  (_input_stage_egress_0_out),
    .ingress_1_in  (_input_stage_1_egress_0_out),
    .ingress_2_in  (_input_stage_2_egress_0_out),
    .grants        ({{grants[2'h2][2'h0]}, {grants[2'h1][2'h0]}, {grants[2'h0][2'h0]}}),
    .egress_in     (egress_0_in),
    .ingress_0_out (_output_stage_ingress_0_out),
    .ingress_1_out (_output_stage_ingress_1_out),
    .ingress_2_out (_output_stage_ingress_2_out),
    .egress_out    (egress_0_out)
  );
  GrantMerge_1 output_stage_1 (
    .ingress_0_in  (_input_stage_egress_1_out),
    .ingress_1_in  (_input_stage_1_egress_1_out),
    .ingress_2_in  (_input_stage_2_egress_1_out),
    .grants        ({{grants[2'h2][2'h1]}, {grants[2'h1][2'h1]}, {grants[2'h0][2'h1]}}),
    .egress_in     (egress_1_in),
    .ingress_0_out (_output_stage_1_ingress_0_out),
    .ingress_1_out (_output_stage_1_ingress_1_out),
    .ingress_2_out (_output_stage_1_ingress_2_out),
    .egress_out    (egress_1_out)
  );
  GrantMerge_2 output_stage_2 (
    .ingress_0_in  (_input_stage_egress_2_out),
    .ingress_1_in  (_input_stage_1_egress_2_out),
    .ingress_2_in  (_input_stage_2_egress_2_out),
    .grants        ({{grants[2'h2][2'h2]}, {grants[2'h1][2'h2]}, {grants[2'h0][2'h2]}}),
    .egress_in     (egress_2_in),
    .ingress_0_out (_output_stage_2_ingress_0_out),
    .ingress_1_out (_output_stage_2_ingress_1_out),
    .ingress_2_out (_output_stage_2_ingress_2_out),
    .egress_out    (egress_2_out)
  );
endmodule

module GrantDemux(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  [2:0]                                          grants,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
                                                        egress_2_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out,
                                                        egress_1_out,
                                                        egress_2_out
);

  assign ingress_out =
    '{ready:
        (|({{grants[2'h2] & egress_2_in.ready},
            {grants[2'h1] & egress_1_in.ready},
            {grants[2'h0] & egress_0_in.ready}}))};
  assign egress_0_out =
    '{valid: (ingress_in.valid & grants[2'h0]), bits: ingress_in.bits};
  assign egress_1_out =
    '{valid: (ingress_in.valid & grants[2'h1]), bits: ingress_in.bits};
  assign egress_2_out =
    '{valid: (ingress_in.valid & grants[2'h2]), bits: ingress_in.bits};
endmodule

module GrantDemux_1(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  [2:0]                                          grants,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
                                                        egress_2_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out,
                                                        egress_1_out,
                                                        egress_2_out
);

  assign ingress_out =
    '{ready:
        (|({{grants[2'h2] & egress_2_in.ready},
            {grants[2'h1] & egress_1_in.ready},
            {grants[2'h0] & egress_0_in.ready}}))};
  assign egress_0_out =
    '{valid: (ingress_in.valid & grants[2'h0]), bits: ingress_in.bits};
  assign egress_1_out =
    '{valid: (ingress_in.valid & grants[2'h1]), bits: ingress_in.bits};
  assign egress_2_out =
    '{valid: (ingress_in.valid & grants[2'h2]), bits: ingress_in.bits};
endmodule

module GrantDemux_2(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  [2:0]                                          grants,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
                                                        egress_2_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out,
                                                        egress_1_out,
                                                        egress_2_out
);

  assign ingress_out =
    '{ready:
        (|({{grants[2'h2] & egress_2_in.ready},
            {grants[2'h1] & egress_1_in.ready},
            {grants[2'h0] & egress_0_in.ready}}))};
  assign egress_0_out =
    '{valid: (ingress_in.valid & grants[2'h0]), bits: ingress_in.bits};
  assign egress_1_out =
    '{valid: (ingress_in.valid & grants[2'h1]), bits: ingress_in.bits};
  assign egress_2_out =
    '{valid: (ingress_in.valid & grants[2'h2]), bits: ingress_in.bits};
endmodule

module GrantMerge(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_0_in,
                                                        ingress_1_in,
                                                        ingress_2_in,
  input  [2:0]                                          grants,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
                                                        ingress_2_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out
);

  wire _GEN = grants[2'h0] & ingress_0_in.valid;
  wire _GEN_0 = grants[2'h1] & ingress_1_in.valid;
  wire _GEN_1 = grants[2'h2] & ingress_2_in.valid;
  assign ingress_0_out = '{ready: (grants[2'h0] & egress_in.ready)};
  assign ingress_1_out = '{ready: (grants[2'h1] & egress_in.ready)};
  assign ingress_2_out = '{ready: (grants[2'h2] & egress_in.ready)};
  assign egress_out =
    '{valid: (_GEN | _GEN_0 | _GEN_1),
      bits:
        (_GEN_1
           ? ingress_2_in.bits
           : _GEN_0 ? ingress_1_in.bits : _GEN ? ingress_0_in.bits : ingress_0_in.bits)};
endmodule

module GrantMerge_1(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_0_in,
                                                        ingress_1_in,
                                                        ingress_2_in,
  input  [2:0]                                          grants,
