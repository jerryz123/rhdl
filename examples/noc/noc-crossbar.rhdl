          {_queue_stage_1_egress_out.valid & _GEN_73.valid & _GEN_73.target_mask[0]}}},
        {{{_queue_stage_egress_out.valid & _GEN_58.valid & _GEN_58.target_mask[2]},
          {_queue_stage_egress_out.valid & _GEN_58.valid & _GEN_58.target_mask[1]},
          {_queue_stage_egress_out.valid & _GEN_58.valid & _GEN_58.target_mask[0]}}}}),
    .fallback_requests
      ({{{{_queue_stage_2_egress_out.valid & _GEN_88.valid & _GEN_88.fallback_mask[2]},
          {_queue_stage_2_egress_out.valid & _GEN_88.valid & _GEN_88.fallback_mask[1]},
          {_queue_stage_2_egress_out.valid & _GEN_88.valid & _GEN_88.fallback_mask[0]}}},
        {{{_queue_stage_1_egress_out.valid & _GEN_73.valid & _GEN_73.fallback_mask[2]},
          {_queue_stage_1_egress_out.valid & _GEN_73.valid & _GEN_73.fallback_mask[1]},
          {_queue_stage_1_egress_out.valid & _GEN_73.valid & _GEN_73.fallback_mask[0]}}},
        {{{_queue_stage_egress_out.valid & _GEN_58.valid & _GEN_58.fallback_mask[2]},
          {_queue_stage_egress_out.valid & _GEN_58.valid & _GEN_58.fallback_mask[1]},
          {_queue_stage_egress_out.valid & _GEN_58.valid & _GEN_58.fallback_mask[0]}}}}),
    .target_available  (target_available),
    .accepts
      ({{_crossbar_stage_egress_2_out.valid & egress_2_in.ready},
        {_crossbar_stage_egress_1_out.valid & egress_1_in.ready},
        {_crossbar_stage_egress_0_out.valid & egress_0_in.ready}}),
    .grants            (_allocator_grants)
  );
  GrantCrossbar crossbar_stage (
    .ingress_0_in  (_queue_stage_egress_out),
    .ingress_1_in  (_queue_stage_1_egress_out),
    .ingress_2_in  (_queue_stage_2_egress_out),
    .grants        (_allocator_grants),
    .egress_0_in   (egress_0_in),
    .egress_1_in   (egress_1_in),
    .egress_2_in   (egress_2_in),
    .ingress_0_out (_crossbar_stage_ingress_0_out),
    .ingress_1_out (_crossbar_stage_ingress_1_out),
    .ingress_2_out (_crossbar_stage_ingress_2_out),
    .egress_0_out  (_crossbar_stage_egress_0_out),
    .egress_1_out  (_crossbar_stage_egress_1_out),
    .egress_2_out  (_crossbar_stage_egress_2_out)
  );
  assign egress_0_out = _crossbar_stage_egress_0_out;
  assign egress_1_out = _crossbar_stage_egress_1_out;
  assign egress_2_out = _crossbar_stage_egress_2_out;
endmodule

module Queue(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out,
  output                                                count
);

  reg             occupied;
  RoutedBeat      payload;
  wire            _GEN = ingress_in.valid & ~occupied;
  always @(posedge clock) begin
    if (reset)
      occupied <= 1'h0;
    else
      occupied <= _GEN ^ occupied & egress_in.ready ? _GEN : occupied;
  end // always @(posedge)
  always @(posedge clock)
    payload <= _GEN ? ingress_in.bits : payload;
  assign ingress_out = '{ready: (~occupied)};
  assign egress_out = '{valid: occupied, bits: payload};
  assign count = occupied;
endmodule

module Queue_1(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out,
  output                                                count
);

