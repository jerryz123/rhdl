  wire  struct packed {logic valid; RoutedBeat bits; } _queue_stage_1_egress_out;
  wire  struct packed {logic valid; RoutedBeat bits; } _queue_stage_egress_out;
  logic [6:0]                         __rhdl_decode_18_result;
  wire  RouteLookupKey                _GEN =
    '{route_key: ingress_0_in.bits.route_key, origin_key: (2'h0)};
  wire  [5:0]                         _GEN_0 = /*cast(bit[5:0])*/_GEN;
  always_comb begin
    case (_GEN_0)
      6'b000000:
        __rhdl_decode_18_result = 7'h13;
      6'b000100:
        __rhdl_decode_18_result = 7'h25;
      6'b001000:
        __rhdl_decode_18_result = 7'h49;
      6'b001101:
        __rhdl_decode_18_result = 7'h13;
      6'b010001:
        __rhdl_decode_18_result = 7'h25;
      6'b010101:
        __rhdl_decode_18_result = 7'h49;
      6'b011010:
        __rhdl_decode_18_result = 7'h13;
      6'b011110:
        __rhdl_decode_18_result = 7'h25;
      6'b100010:
        __rhdl_decode_18_result = 7'h49;
