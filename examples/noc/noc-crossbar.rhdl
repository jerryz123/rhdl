          {_queue_stage_egress_out.valid & _GEN_10.valid & _GEN_10.target_mask[1]},
          {_queue_stage_egress_out.valid & _GEN_10.valid & _GEN_10.target_mask[0]}}}}),
    .fallback_requests
      ({{{{_queue_stage_2_egress_out.valid & _GEN_16.valid & _GEN_16.fallback_mask[2]},
          {_queue_stage_2_egress_out.valid & _GEN_16.valid & _GEN_16.fallback_mask[1]},
          {_queue_stage_2_egress_out.valid & _GEN_16.valid & _GEN_16.fallback_mask[0]}}},
        {{{_queue_stage_1_egress_out.valid & _GEN_13.valid & _GEN_13.fallback_mask[2]},
