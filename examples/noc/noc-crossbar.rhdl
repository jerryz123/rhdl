  Queue queue_stage_2 (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (ingress_2_in),
    .egress_in   (_crossbar_stage_ingress_2_out),
    .ingress_out (ingress_2_out),
    .egress_out  (_queue_stage_2_egress_out),
    .count       (/* unused */)
  );
  RouterAllocator allocator (
    .clock             (clock),
    .reset             (reset),
    .requests
      ({{{{_queue_stage_2_egress_out.valid & _GEN_16.valid & _GEN_16.target_mask[2]},
          {_queue_stage_2_egress_out.valid & _GEN_16.valid & _GEN_16.target_mask[1]},
          {_queue_stage_2_egress_out.valid & _GEN_16.valid & _GEN_16.target_mask[0]}}},
        {{{_queue_stage_1_egress_out.valid & _GEN_13.valid & _GEN_13.target_mask[2]},
          {_queue_stage_1_egress_out.valid & _GEN_13.valid & _GEN_13.target_mask[1]},
          {_queue_stage_1_egress_out.valid & _GEN_13.valid & _GEN_13.target_mask[0]}}},
