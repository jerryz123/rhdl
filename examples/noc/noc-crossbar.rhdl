    .accepts
      ({{_crossbar_stage_egress_2_out.valid & target_2_in.egress.ready},
        {_crossbar_stage_egress_1_out.valid & target_1_in.egress.ready},
        {_crossbar_stage_egress_0_out.valid & target_0_in.egress.ready}}),
    .grants            (_allocator_grants)
  );
  GrantCrossbar crossbar_stage (
    .ingress_0_in  (_queue_stage_egress_out),
    .ingress_1_in  (_queue_stage_1_egress_out),
    .ingress_2_in  (_queue_stage_2_egress_out),
    .grants        (_allocator_grants),
    .egress_0_in   (target_0_in.egress),
    .egress_1_in   (target_1_in.egress),
    .egress_2_in   (target_2_in.egress),
    .ingress_0_out (_crossbar_stage_ingress_0_out),
    .ingress_1_out (_crossbar_stage_ingress_1_out),
    .ingress_2_out (_crossbar_stage_ingress_2_out),
    .egress_0_out  (_crossbar_stage_egress_0_out),
    .egress_1_out  (_crossbar_stage_egress_1_out),
    .egress_2_out  (_crossbar_stage_egress_2_out)
  );
  assign target_0_out = '{egress: _crossbar_stage_egress_0_out};
  assign target_1_out = '{egress: _crossbar_stage_egress_1_out};
  assign target_2_out = '{egress: _crossbar_stage_egress_2_out};
endmodule

module Queue(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out,
  output                                                count
);

  reg             occupied;
  RoutedBeat      payload;
  wire            _GEN = ingress_in.valid & ~occupied;
  always @(posedge clock) begin
    if (reset)
      occupied <= 1'h0;
    else
      occupied <= _GEN ^ occupied & egress_in.ready ? _GEN : occupied;
  end // always @(posedge)
  always @(posedge clock)
    payload <= _GEN ? ingress_in.bits : payload;
  assign ingress_out = '{ready: (~occupied)};
  assign egress_out = '{valid: occupied, bits: payload};
  assign count = occupied;
endmodule

module RouterAllocator(
  input             clock,
                    reset,
  input  [2:0][2:0] requests,
                    fallback_requests,
  input  [2:0]      target_available,
                    accepts,
  output [2:0][2:0] grants
);

  wire [2:0] _GEN =
    {{requests[2'h0][2'h2] & ~fallback_requests[2'h0][2'h2] & target_available[2'h2]},
     {requests[2'h0][2'h1] & ~fallback_requests[2'h0][2'h1] & target_available[2'h1]},
     {requests[2'h0][2'h0] & ~fallback_requests[2'h0][2'h0] & target_available[2'h0]}};
  wire [2:0] _GEN_0 =
    {{requests[2'h1][2'h2] & ~fallback_requests[2'h1][2'h2] & target_available[2'h2]},
     {requests[2'h1][2'h1] & ~fallback_requests[2'h1][2'h1] & target_available[2'h1]},
     {requests[2'h1][2'h0] & ~fallback_requests[2'h1][2'h0] & target_available[2'h0]}};
  wire [2:0] _GEN_1 =
    {{requests[2'h2][2'h2] & ~fallback_requests[2'h2][2'h2] & target_available[2'h2]},
     {requests[2'h2][2'h1] & ~fallback_requests[2'h2][2'h1] & target_available[2'h1]},
     {requests[2'h2][2'h0] & ~fallback_requests[2'h2][2'h0] & target_available[2'h0]}};
  OutputGreedyRoundRobinMatcher matcher (
    .clock    (clock),
    .reset    (reset),
    .requests
      ({{(|_GEN_1) ? _GEN_1 : fallback_requests[2'h2]},
        {(|_GEN_0) ? _GEN_0 : fallback_requests[2'h1]},
        {(|_GEN) ? _GEN : fallback_requests[2'h0]}}),
    .accepts  (accepts),
    .grants   (grants)
  );
endmodule

module OutputGreedyRoundRobinMatcher(
  input             clock,
                    reset,
  input  [2:0][2:0] requests,
  input  [2:0]      accepts,
  output [2:0][2:0] grants
);

  reg  [2:0][1:0] next_priorities;
  wire            _GEN = next_priorities[2'h0] != 2'h3;
  `ifndef SYNTHESIS
    output_greedy_round_robin_matcher_priority_in_range_0:
      assert property (@(posedge clock) disable iff (reset) _GEN);
  `endif // not def SYNTHESIS
  wire [2:0]      _GEN_0 =
    {{requests[2'h2][2'h0] & _GEN},
     {requests[2'h1][2'h0] & ~(next_priorities[2'h0][1])},
     {requests[2'h0][2'h0] & next_priorities[2'h0] == 2'h0}};
  wire [2:0]      _GEN_1 =
    {{requests[2'h2][2'h0]}, {requests[2'h1][2'h0]}, {requests[2'h0][2'h0]}};
  wire [2:0]      _GEN_2 =
    (|_GEN_0)
      ? _GEN_0 & {~(_GEN_0[1:0] | {_GEN_0[0], 1'h0}), 1'h1}
      : _GEN_1 & {~(_GEN_1[1:0] | {_GEN_1[0], 1'h0}), 1'h1};
  wire [1:0]      _GEN_3 = _GEN_2[2'h1 +: 2];
  wire            _GEN_4 = next_priorities[2'h1] != 2'h3;
  `ifndef SYNTHESIS
    output_greedy_round_robin_matcher_priority_in_range_1:
      assert property (@(posedge clock) disable iff (reset) _GEN_4);
  `endif // not def SYNTHESIS
  wire            _GEN_5 = requests[2'h0][2'h1] & ~_GEN_2[2'h0];
  wire            _GEN_6 = requests[2'h1][2'h1] & ~_GEN_2[2'h1];
  wire            _GEN_7 = requests[2'h2][2'h1] & ~_GEN_2[2'h2];
  wire [2:0]      _GEN_8 =
    {{_GEN_7 & _GEN_4},
     {_GEN_6 & ~(next_priorities[2'h1][1])},
     {_GEN_5 & next_priorities[2'h1] == 2'h0}};
  wire [2:0]      _GEN_9 = {{_GEN_7}, {_GEN_6}, {_GEN_5}};
  wire [2:0]      _GEN_10 =
    (|_GEN_8)
      ? _GEN_8 & {~(_GEN_8[1:0] | {_GEN_8[0], 1'h0}), 1'h1}
      : _GEN_9 & {~(_GEN_9[1:0] | {_GEN_9[0], 1'h0}), 1'h1};
  wire [1:0]      _GEN_11 = _GEN_10[2'h1 +: 2];
  wire            _GEN_12 = next_priorities[2'h2] != 2'h3;
  `ifndef SYNTHESIS
    output_greedy_round_robin_matcher_priority_in_range_2:
      assert property (@(posedge clock) disable iff (reset) _GEN_12);
  `endif // not def SYNTHESIS
  wire            _GEN_13 = requests[2'h0][2'h2] & ~(_GEN_2[2'h0] | _GEN_10[2'h0]);
  wire            _GEN_14 = requests[2'h1][2'h2] & ~(_GEN_2[2'h1] | _GEN_10[2'h1]);
  wire            _GEN_15 = requests[2'h2][2'h2] & ~(_GEN_2[2'h2] | _GEN_10[2'h2]);
  wire [2:0]      _GEN_16 =
    {{_GEN_15 & _GEN_12},
     {_GEN_14 & ~(next_priorities[2'h2][1])},
     {_GEN_13 & next_priorities[2'h2] == 2'h0}};
  wire [2:0]      _GEN_17 = {{_GEN_15}, {_GEN_14}, {_GEN_13}};
  wire [2:0]      _GEN_18 =
    (|_GEN_16)
      ? _GEN_16 & {~(_GEN_16[1:0] | {_GEN_16[0], 1'h0}), 1'h1}
      : _GEN_17 & {~(_GEN_17[1:0] | {_GEN_17[0], 1'h0}), 1'h1};
  wire [1:0]      _GEN_19 = _GEN_18[2'h1 +: 2];
  wire [1:0]      _GEN_20 =
    (|_GEN_1) & accepts[2'h0]
      ? (_GEN_3 == 2'h2 ? 2'h0 : _GEN_3 + 2'h1)
      : next_priorities[2'h0];
  wire [1:0]      _GEN_21 =
    (|_GEN_9) & accepts[2'h1]
      ? (_GEN_11 == 2'h2 ? 2'h0 : _GEN_11 + 2'h1)
      : next_priorities[2'h1];
  wire [1:0]      _GEN_22 =
    (|_GEN_17) & accepts[2'h2]
      ? (_GEN_19 == 2'h2 ? 2'h0 : _GEN_19 + 2'h1)
      : next_priorities[2'h2];
  always @(posedge clock) begin
    if (reset)
      next_priorities <= '{2'h0, 2'h0, 2'h0};
    else begin
      next_priorities[2'h2] <= _GEN_22;
      next_priorities[2'h1] <= _GEN_21;
      next_priorities[2'h0] <= _GEN_20;
    end
  end // always @(posedge)
  assign grants =
    {{{{_GEN_18[2'h2]}, {_GEN_10[2'h2]}, {_GEN_2[2'h2]}}},
     {{{_GEN_18[2'h1]}, {_GEN_10[2'h1]}, {_GEN_2[2'h1]}}},
     {{{_GEN_18[2'h0]}, {_GEN_10[2'h0]}, {_GEN_2[2'h0]}}}};
endmodule

module GrantCrossbar(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_0_in,
                                                        ingress_1_in,
                                                        ingress_2_in,
  input  [2:0][2:0]                                     grants,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
                                                        egress_2_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
                                                        ingress_2_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out,
                                                        egress_1_out,
                                                        egress_2_out
);

  wire struct packed {logic ready; } _output_stage_2_ingress_0_out;
  wire struct packed {logic ready; } _output_stage_2_ingress_1_out;
  wire struct packed {logic ready; } _output_stage_2_ingress_2_out;
  wire struct packed {logic ready; } _output_stage_1_ingress_0_out;
  wire struct packed {logic ready; } _output_stage_1_ingress_1_out;
  wire struct packed {logic ready; } _output_stage_1_ingress_2_out;
  wire struct packed {logic ready; } _output_stage_ingress_0_out;
  wire struct packed {logic ready; } _output_stage_ingress_1_out;
  wire struct packed {logic ready; } _output_stage_ingress_2_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_2_egress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_2_egress_1_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_2_egress_2_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_1_egress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_1_egress_1_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_1_egress_2_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_0_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_1_out;
  wire struct packed {logic valid; RoutedBeat bits; } _input_stage_egress_2_out;
  GrantDemux input_stage (
    .ingress_in   (ingress_0_in),
    .grants       (grants[2'h0]),
    .egress_0_in  (_output_stage_ingress_0_out),
    .egress_1_in  (_output_stage_1_ingress_0_out),
    .egress_2_in  (_output_stage_2_ingress_0_out),
    .ingress_out  (ingress_0_out),
    .egress_0_out (_input_stage_egress_0_out),
    .egress_1_out (_input_stage_egress_1_out),
    .egress_2_out (_input_stage_egress_2_out)
  );
  GrantDemux input_stage_1 (
    .ingress_in   (ingress_1_in),
    .grants       (grants[2'h1]),
    .egress_0_in  (_output_stage_ingress_1_out),
    .egress_1_in  (_output_stage_1_ingress_1_out),
    .egress_2_in  (_output_stage_2_ingress_1_out),
    .ingress_out  (ingress_1_out),
    .egress_0_out (_input_stage_1_egress_0_out),
    .egress_1_out (_input_stage_1_egress_1_out),
    .egress_2_out (_input_stage_1_egress_2_out)
  );
  GrantDemux input_stage_2 (
    .ingress_in   (ingress_2_in),
    .grants       (grants[2'h2]),
    .egress_0_in  (_output_stage_ingress_2_out),
    .egress_1_in  (_output_stage_1_ingress_2_out),
    .egress_2_in  (_output_stage_2_ingress_2_out),
    .ingress_out  (ingress_2_out),
    .egress_0_out (_input_stage_2_egress_0_out),
    .egress_1_out (_input_stage_2_egress_1_out),
    .egress_2_out (_input_stage_2_egress_2_out)
  );
  GrantMerge output_stage (
    .ingress_0_in  (_input_stage_egress_0_out),
    .ingress_1_in  (_input_stage_1_egress_0_out),
    .ingress_2_in  (_input_stage_2_egress_0_out),
    .grants        ({{grants[2'h2][2'h0]}, {grants[2'h1][2'h0]}, {grants[2'h0][2'h0]}}),
    .egress_in     (egress_0_in),
    .ingress_0_out (_output_stage_ingress_0_out),
    .ingress_1_out (_output_stage_ingress_1_out),
    .ingress_2_out (_output_stage_ingress_2_out),
    .egress_out    (egress_0_out)
  );
  GrantMerge output_stage_1 (
    .ingress_0_in  (_input_stage_egress_1_out),
    .ingress_1_in  (_input_stage_1_egress_1_out),
    .ingress_2_in  (_input_stage_2_egress_1_out),
    .grants        ({{grants[2'h2][2'h1]}, {grants[2'h1][2'h1]}, {grants[2'h0][2'h1]}}),
    .egress_in     (egress_1_in),
    .ingress_0_out (_output_stage_1_ingress_0_out),
    .ingress_1_out (_output_stage_1_ingress_1_out),
    .ingress_2_out (_output_stage_1_ingress_2_out),
    .egress_out    (egress_1_out)
  );
  GrantMerge output_stage_2 (
    .ingress_0_in  (_input_stage_egress_2_out),
    .ingress_1_in  (_input_stage_1_egress_2_out),
    .ingress_2_in  (_input_stage_2_egress_2_out),
    .grants        ({{grants[2'h2][2'h2]}, {grants[2'h1][2'h2]}, {grants[2'h0][2'h2]}}),
    .egress_in     (egress_2_in),
    .ingress_0_out (_output_stage_2_ingress_0_out),
    .ingress_1_out (_output_stage_2_ingress_1_out),
    .ingress_2_out (_output_stage_2_ingress_2_out),
    .egress_out    (egress_2_out)
  );
endmodule

module GrantDemux(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_in,
  input  [2:0]                                          grants,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
                                                        egress_2_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_0_out,
                                                        egress_1_out,
                                                        egress_2_out
);

  assign ingress_out =
    '{ready:
        (|({{grants[2'h2] & egress_2_in.ready},
            {grants[2'h1] & egress_1_in.ready},
            {grants[2'h0] & egress_0_in.ready}}))};
  assign egress_0_out =
    '{valid: (ingress_in.valid & grants[2'h0]), bits: ingress_in.bits};
  assign egress_1_out =
    '{valid: (ingress_in.valid & grants[2'h1]), bits: ingress_in.bits};
  assign egress_2_out =
    '{valid: (ingress_in.valid & grants[2'h2]), bits: ingress_in.bits};
endmodule

module GrantMerge(
  input  struct packed {logic valid; RoutedBeat bits; } ingress_0_in,
                                                        ingress_1_in,
                                                        ingress_2_in,
  input  [2:0]                                          grants,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
                                                        ingress_2_out,
  output struct packed {logic valid; RoutedBeat bits; } egress_out
);

  wire _GEN = grants[2'h0] & ingress_0_in.valid;
  wire _GEN_0 = grants[2'h1] & ingress_1_in.valid;
  wire _GEN_1 = grants[2'h2] & ingress_2_in.valid;
  assign ingress_0_out = '{ready: (grants[2'h0] & egress_in.ready)};
  assign ingress_1_out = '{ready: (grants[2'h1] & egress_in.ready)};
  assign ingress_2_out = '{ready: (grants[2'h2] & egress_in.ready)};
  assign egress_out =
    '{valid: (_GEN | _GEN_0 | _GEN_1),
      bits:
        (_GEN_1
           ? ingress_2_in.bits
           : _GEN_0 ? ingress_1_in.bits : _GEN ? ingress_0_in.bits : ingress_0_in.bits)};
endmodule
}>>|
