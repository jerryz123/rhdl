          {_queue_stage_egress_out.valid & _GEN_10.valid & _GEN_10.fallback_mask[1]},
          {_queue_stage_egress_out.valid & _GEN_10.valid & _GEN_10.fallback_mask[0]}}}}),
    .target_available
