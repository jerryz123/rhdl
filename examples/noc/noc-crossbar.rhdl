  logic [6:0]                         __rhdl_decode_76_result;
  wire  RouteLookupKey                _GEN_14 =
    '{route_key: _queue_stage_2_egress_out.bits.route_key, origin_key: (2'h2)};
  wire  [5:0]                         _GEN_15 = /*cast(bit[5:0])*/_GEN_14;
