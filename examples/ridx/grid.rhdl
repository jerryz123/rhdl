#lang rhdl
// Demonstrates Ridx-driven instance and connection generation over a finite grid.

import:
  lib("ridx/model/main.rhm") open
  lib("ridx/rhdl/main.rhdl") open

circuit GridCell():
  input seed: Bool
  input dropped_neighbor: Bool
  input wrapped_neighbor: Bool
  output source: Bool

  source <== seed

circuit Grid():
  def width = 2
  def height = 3
  def coordinates = IndexSpace(
    [Axis("x", width), Axis("y", height)],
    ~name: "rhdl-grid"
  )
  def GridCellModule = GridCell()
  def cells = for InstanceArray (_point in coordinates.points()):
    inst cell(GridCellModule)

  for_each_index_point(
    coordinates,
    fun (point):
      cells[point.ordinal()].seed <== Bool(point.coordinate("x") == 1)
  )

  def west_boundary = select_view(
    coordinates,
    fun (point): point.coordinate("x") == 0,
    ~name: "west-boundary"
  )
  for_each_index_point(
    west_boundary,
    fun (point):
      cells[point.ordinal()].dropped_neighbor <== Bool(#false)
  )

  for_each_relation_pair(
    shift_relation(coordinates, "x", 1, ~boundary: "drop"),
    fun (source, destination):
      cells[destination.ordinal()].dropped_neighbor <== cells[source.ordinal()].source
  )

  def wrapped_sources = mapping_by(
    coordinates,
    coordinates,
    fun (destination):
      def y = destination.coordinate("y")
      def source_y = if y == 0 | height - 1 | y - 1
      coordinates.point([destination.coordinate("x"), source_y])
  )
  for_each_direct_mapping(
    wrapped_sources,
    fun (destination, source):
      cells[destination.ordinal()].wrapped_neighbor <== cells[source.ordinal()].source
  )

def design = elaborate(Grid())

def verilog_reference = @str|<<{
module Grid();
  wire _cell_5_source;
  wire _cell_4_source;
  wire _cell_3_source;
  wire _cell_2_source;
  wire _cell_1_source;
  wire _cell_source;
  GridCell cell_0 (
    .seed             (1'h0),
    .dropped_neighbor (1'h0),
    .wrapped_neighbor (_cell_2_source),
    .source           (_cell_source)
  );
  GridCell cell_1 (
    .seed             (1'h0),
    .dropped_neighbor (1'h0),
    .wrapped_neighbor (_cell_source),
    .source           (_cell_1_source)
  );
  GridCell cell_2 (
    .seed             (1'h0),
    .dropped_neighbor (1'h0),
    .wrapped_neighbor (_cell_1_source),
    .source           (_cell_2_source)
  );
  GridCell cell_3 (
    .seed             (1'h1),
    .dropped_neighbor (_cell_source),
    .wrapped_neighbor (_cell_5_source),
    .source           (_cell_3_source)
  );
  GridCell cell_4 (
    .seed             (1'h1),
    .dropped_neighbor (_cell_1_source),
    .wrapped_neighbor (_cell_3_source),
    .source           (_cell_4_source)
  );
  GridCell cell_5 (
    .seed             (1'h1),
    .dropped_neighbor (_cell_2_source),
    .wrapped_neighbor (_cell_4_source),
    .source           (_cell_5_source)
  );
endmodule

module GridCell(
  input  seed,
         dropped_neighbor,
         wrapped_neighbor,
  output source
);

  assign source = seed;
endmodule
}>>|

export:
  GridCell
  Grid
  design
  verilog_reference
