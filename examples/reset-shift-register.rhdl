#lang rhdl
// Mirrors a Chisel ResetShiftRegister with ambient reset registers and conditional shifting.

sync_circuit ResetShiftRegister():
  input data_in: Bits(4)
  input shift: Bool
  output data_out: Bits(4)

  reg r0(~init: bits(0, 4))
  reg r1(~init: bits(0, 4))
  reg r2(~init: bits(0, 4))
  reg r3(~init: bits(0, 4))

  when shift:
    r0.next <== data_in
    r1.next <== r0
    r2.next <== r1
    r3.next <== r2

  data_out <== r3

def design = elaborate(ResetShiftRegister())

def verilog_reference = @str|<<{
module ResetShiftRegister(
  input        clock,
               reset,
  input  [3:0] data_in,
  input        shift,
  output [3:0] data_out
);

  reg [3:0] r0;
  reg [3:0] r1;
  reg [3:0] r2;
  reg [3:0] r3;
  always @(posedge clock) begin
    if (reset) begin
      r0 <= 4'h0;
      r1 <= 4'h0;
      r2 <= 4'h0;
      r3 <= 4'h0;
    end
    else begin
      r0 <= shift ? data_in : r0;
      r1 <= shift ? r0 : r1;
      r2 <= shift ? r1 : r2;
      r3 <= shift ? r2 : r3;
    end
  end // always @(posedge)
  assign data_out = r3;
endmodule
}>>|

export:
  ResetShiftRegister
  design
  verilog_reference
