#lang rhdl
// Demonstrates fresh circuit definitions generated through ordinary host iteration.

circuit Adder(width):
  def a = input("a", Bits(width))
  def b = input("b", Bits(width))
  def sum = output("sum", Bits(width))
  sum <== a + b

circuit Top(width):
  for:
    each ignored in [0, 1]
    Adder(width)

def design = elaborate(Top(8))

export:
  Adder
  Top
  design
