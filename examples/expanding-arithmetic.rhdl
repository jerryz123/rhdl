#lang rhdl
// Demonstrates lossless unsigned addition and multiplication across unequal widths.

circuit ExpandingArithmetic():
  input a: Bits(8)
  input b: Bits(4)
  output sum: Bits(9)
  output product: Bits(12)

  sum <== a +& b
  product <== a *& b

def design = elaborate(ExpandingArithmetic())

def verilog_reference = @str|<<{
module ExpandingArithmetic(
  input  [7:0]  a,
  input  [3:0]  b,
  output [8:0]  sum,
  output [11:0] product
);

  assign sum = {1'h0, a} + {5'h0, b};
  assign product = {4'h0, a} * {8'h0, b};
endmodule
}>>|

export:
  ExpandingArithmetic
  design
  verilog_reference
