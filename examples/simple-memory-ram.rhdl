#lang rhdl
// Materializes the standard synchronous-RAM implementation of SimpleMemory.

import:
  lib("rhdl/std/simple-memory/ram.rhdl") open

def design = elaborate(
  SimpleMemoryRam(32,
                  4,
                  16,
                  ~base_address: 0x80000000)
)

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic [31:0] address; logic write; logic [31:0] data; logic [3:0] mask; }
    SimpleMemoryReq;
  typedef struct packed {logic [31:0] data; } SimpleMemoryResp;
`endif // _TYPESCOPE_rhdl_types
module storage_4x32(
  input  [1:0]  RW0_addr,
  input         RW0_en,
                RW0_clk,
                RW0_wmode,
  input  [31:0] RW0_wdata,
  output [31:0] RW0_rdata,
  input  [3:0]  RW0_wmask
);

  reg  [31:0] Memory[0:3];
  reg  [1:0]  _RW0_raddr_d0;
  reg         _RW0_ren_d0;
  reg         _RW0_rmode_d0;
  always @(posedge RW0_clk) begin
    _RW0_raddr_d0 <= RW0_addr;
    _RW0_ren_d0 <= RW0_en;
    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [31:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 32'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[0] & RW0_wmode)
      Memory[RW0_addr][32'h0 +: 8] <= RW0_wdata[7:0];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[1] & RW0_wmode)
      Memory[RW0_addr][32'h8 +: 8] <= RW0_wdata[15:8];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[2] & RW0_wmode)
      Memory[RW0_addr][32'h10 +: 8] <= RW0_wdata[23:16];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[3] & RW0_wmode)
      Memory[RW0_addr][32'h18 +: 8] <= RW0_wdata[31:24];
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

module SimpleMemoryRam(
  input                                                                                                                         clock,
                                                                                                                                reset,
  input  struct packed {struct packed {logic valid; SimpleMemoryReq bits; } request; struct packed {logic ready; } response; }  port_in,
  output struct packed {struct packed {logic ready; } request; struct packed {logic valid; SimpleMemoryResp bits; } response; } port_out
);

  wire [3:0]                         _GEN;
  wire [31:0]                        _GEN_0;
  wire                               _GEN_1;
  wire                               _GEN_2;
  wire [1:0]                         _GEN_3;
  wire struct packed {logic ready; } _pipe_stage_ingress_out;
  wire struct packed {logic valid; SimpleMemoryResp bits; } _pipe_stage_egress_out;
  wire struct packed {logic valid; SimpleMemoryResp bits; } _responses_egress_out;
  wire [31:0]                        _storage_ext_RW0_rdata;
  storage_4x32 storage_ext (
    .RW0_addr  (_GEN_3),
    .RW0_en    (_GEN_2),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_1),
    .RW0_wdata (_GEN_0),
    .RW0_rdata (_storage_ext_RW0_rdata),
    .RW0_wmask (_GEN)
  );
  reg  [1:0]                         outstanding;
  reg                                operation_valid;
  reg                                operation_write;
  assign _GEN_3 = port_in.request.bits.address[3:2];
  `ifndef SYNTHESIS
    memory_outstanding_in_range:
      assert property (@(posedge clock) disable iff (reset) outstanding != 2'h3);
  `endif // not def SYNTHESIS
  wire                               _GEN_4 =
    _pipe_stage_egress_out.valid & port_in.response.ready;
  wire                               _GEN_5 = ~(_GEN_4 & ~reset);
  `ifndef SYNTHESIS
    memory_response_has_request:
      assert property (@(posedge clock) disable iff (_GEN_5) |outstanding);
  `endif // not def SYNTHESIS
  wire                               _GEN_6 =
    port_in.request.bits.address[31] & port_in.request.bits.address < 32'h80000010
    & port_in.request.bits.address[1:0] == 2'h0 & (outstanding != 2'h2 | _GEN_4);
  assign _GEN_2 = port_in.request.valid & _GEN_6;
  assign _GEN_1 = port_in.request.bits.write;
  assign _GEN_0 = port_in.request.bits.data;
  assign _GEN = port_in.request.bits.mask;
  wire struct packed {logic ready; } _GEN_7 = '{ready: _GEN_6};
  wire SimpleMemoryResp              _GEN_8 =
    '{data: (operation_write ? 32'h0 : _storage_ext_RW0_rdata)};
  wire struct packed {logic valid; SimpleMemoryResp bits; } _GEN_9 =
    '{valid: operation_valid, bits: _GEN_8};
  Queue responses (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_GEN_9),
    .egress_in   (_pipe_stage_ingress_out),
    .ingress_out (/* unused */),
    .egress_out  (_responses_egress_out),
    .count       (/* unused */)
  );
  Pipe pipe_stage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_responses_egress_out),
    .egress_in   (port_in.response),
    .ingress_out (_pipe_stage_ingress_out),
    .egress_out  (_pipe_stage_egress_out)
  );
  always @(posedge clock) begin
    if (reset) begin
      outstanding <= 2'h0;
      operation_valid <= 1'h0;
      operation_write <= 1'h0;
    end
    else begin
      outstanding <=
        _GEN_2 ^ _GEN_4
          ? (_GEN_2 ? outstanding + 2'h1 : outstanding - 2'h1)
          : outstanding;
      operation_valid <= _GEN_2;
      operation_write <= _GEN_2 ? _GEN_1 : operation_write;
    end
  end // always @(posedge)
  assign port_out = '{request: _GEN_7, response: _pipe_stage_egress_out};
endmodule

module Queue(
  input                                                       clock,
                                                              reset,
  input  struct packed {logic valid; SimpleMemoryResp bits; } ingress_in,
  input  struct packed {logic ready; }                        egress_in,
  output struct packed {logic ready; }                        ingress_out,
  output struct packed {logic valid; SimpleMemoryResp bits; } egress_out,
  output [1:0]                                                count
);

  wire SimpleMemoryResp _GEN;
  wire                  _GEN_0;
  wire                  _write_pointer_value;
  wire                  _read_pointer_value;
  wire                  _GEN_1 = 1'h0;
  SimpleMemoryResp      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]            occupancy;
  wire                  _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire                  _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire                  _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module Counter(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule

module Pipe(
  input                                                       clock,
                                                              reset,
  input  struct packed {logic valid; SimpleMemoryResp bits; } ingress_in,
  input  struct packed {logic ready; }                        egress_in,
  output struct packed {logic ready; }                        ingress_out,
  output struct packed {logic valid; SimpleMemoryResp bits; } egress_out
);

  reg  [0:0]                 stage_valid;
  SimpleMemoryResp[0:0]      stage_bits;
  wire                       _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire                       _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire SimpleMemoryResp      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule
}>>|

export:
  design
  verilog_reference
