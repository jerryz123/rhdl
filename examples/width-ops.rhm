#lang rhombus
// Builds a width-changing datapath and prints its RHDL IR and CIRCT lowering.

import:
  "../rhdl/main.rhm" open

def design = Design()
def builder = Builder(design)
def datapath = builder.module("WidthOps8")
def a = builder.input(datapath, "a", Bits(8))
def b = builder.input(datapath, "b", Bits(4))
def joined_output = builder.output(datapath, "joined", Bits(12))
def middle_output = builder.output(datapath, "middle", Bits(4))
def widened_output = builder.output(datapath, "widened", Bits(12))
def narrowed_output = builder.output(datapath, "narrowed", Bits(4))
def joined = builder.concat(datapath, [a, b], "joined_value")
def middle = builder.extract(datapath, a, 5, 2, "middle_value")
def widened = builder.zext(datapath, a, 12, "widened_value")
def narrowed = builder.trunc(datapath, a, 4, "narrowed_value")
builder.drive(joined_output, joined)
builder.drive(middle_output, middle)
builder.drive(widened_output, widened)
builder.drive(narrowed_output, narrowed)
def finished = builder.finish(datapath)

verify_design(design)
println(dump_ir(design))
println(emit_circt(design))
