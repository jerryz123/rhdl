#lang rhdl
// Builds a 256-entry combinational byte table from host-generated vector contents.

circuit Tbl():
  input addr: Bits(8)
  output out: Bits(8)

  def r = vec(for List (i in 0..256): bits(i, 8))

  // Every possible eight-bit selector has a case, so the required lookup
  // default is unreachable in hardware.
  out <== r.lookup(addr, ~default: bits(0, 8))

def design = elaborate(Tbl())

export:
  Tbl
  design
