#lang rhdl
// Defines a concise RHDL hierarchy that reuses one generated adder definition.

circuit Adder(width):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

circuit TwoAdders():
  input(a, b, c): Bits(8)
  output(sum0, sum1): Bits(8)

  def Adder8 = Adder(8)
  def u0 = inst("u0", Adder8)
  def u1 = inst("u1", Adder8)
  u0.input("a") <== a
  u0.input("b") <== b
  u1.input("a") <== a
  u1.input("b") <== c
  sum0 <== u0.output("sum")
  sum1 <== u1.output("sum")

def design = elaborate(TwoAdders())

export:
  Adder
  TwoAdders
  design
