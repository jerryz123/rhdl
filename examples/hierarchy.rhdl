#lang rhdl
// Defines the canonical frontend hierarchy with two instances of one reused definition.

module Adder(width: Int):
  input:
    a: Bits(width)
    b: Bits(width)
  output:
    sum: Bits(width)
  result = a + b
  sum := result

module TwoAdders():
  input:
    a: Bits(8)
    b: Bits(8)
    c: Bits(8)
  output:
    sum0: Bits(8)
    sum1: Bits(8)

  Adder8 = Adder(8)
  u0 = instance(Adder8)
  u1 = instance(Adder8)
  u0.a := a
  u0.b := b
  u1.a := a
  u1.b := c
  sum0 := u0.sum
  sum1 := u1.sum

elaborate(TwoAdders())
