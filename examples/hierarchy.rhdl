#lang rhdl
// Showcases binding-derived instances and dot access to elaborated child ports.

circuit Adder(width):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

circuit TwoAdders():
  input(a, b, c): Bits(8)
  output(sum0, sum1): Bits(8)

  def Adder8 = Adder(8)
  inst u0(Adder8)
  inst u1(Adder8)
  u0.a <== a
  u0.b <== b
  u1.a <== a
  u1.b <== c
  sum0 <== u0.sum
  sum1 <== u1.sum

def design = elaborate(TwoAdders())

export:
  Adder
  TwoAdders
  design
