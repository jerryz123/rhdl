#lang rhdl
// Defines an embedded RHDL hierarchy that reuses one generated adder definition.

circuit Adder(width):
  def a = input("a", Bits(width))
  def b = input("b", Bits(width))
  def sum = output("sum", Bits(width))
  sum <== a + b

circuit TwoAdders():
  def a = input("a", Bits(8))
  def b = input("b", Bits(8))
  def c = input("c", Bits(8))
  def sum0 = output("sum0", Bits(8))
  def sum1 = output("sum1", Bits(8))

  def Adder8 = Adder(8)
  def u0 = inst("u0", Adder8)
  def u1 = inst("u1", Adder8)
  u0.input("a") <== a
  u0.input("b") <== b
  u1.input("a") <== a
  u1.input("b") <== c
  sum0 <== u0.output("sum")
  sum1 <== u1.output("sum")

def design = elaborate(TwoAdders())

export:
  design
