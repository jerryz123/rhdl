#lang rhdl
// Demonstrates assembling and reading a single-driver vector wire.

circuit VectorWire(n):
  input(left, right): Vec(n, Bool)
  output sum: Vec(n, Bool)

  wire staged: Vec(n, Bool)
  for (i in 0..n):
    staged[i] <== left[i] ^ right[i]

  sum <== staged

def design = elaborate(VectorWire(4))

def verilog_reference = @str|<<{
module VectorWire(
  input  [3:0] left,
               right,
  output [3:0] sum
);

  assign sum =
    {{left[2'h3] ^ right[2'h3]},
     {left[2'h2] ^ right[2'h2]},
     {left[2'h1] ^ right[2'h1]},
     {left[2'h0] ^ right[2'h0]}};
endmodule
}>>|

export:
  VectorWire
  design
  verilog_reference
