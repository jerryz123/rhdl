#lang rhdl
// Demonstrates fixed-width logical shifts with independently sized hardware amounts.

circuit ShiftOps8():
  input value: Bits(8)
  input amount: Bits(3)
  input wide_amount: Bits(12)
  output(left, right, left_wide, right_wide): Bits(8)

  left <== value << amount
  right <== value >> amount
  left_wide <== value << wide_amount
  right_wide <== value >> wide_amount

def design = elaborate(ShiftOps8())

export:
  ShiftOps8
  design
