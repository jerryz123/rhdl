#lang rhdl
// Cycles through a host-defined pattern using a registered hardware vector index.

def search_pattern = [0, 4, 15, 14, 2, 5, 13]

sync_circuit VecSearch():
  output out: Bits(4)

  reg index(~init: bits(0, 3))
  def elts = vec(search_pattern.map(fun (value): bits(value, 4)))

  index.next <== index + bits(1, 3)

  // The three-bit counter also reaches 7, outside this seven-element vector.
  // Make that cycle's result explicit instead of relying on undefined access.
  out <== elts.lookup(index, ~default: bits(0, 4))

def design = elaborate(VecSearch())

export:
  search_pattern
  VecSearch
  design
