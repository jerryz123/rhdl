#lang rhdl
// Demonstrates a bounded initial-profile HN-I between one RN-I and one SN-I port.

import:
  lib("chi/main.rhdl") open

def home_flit = CHIFlitParams()
def requester_link = CHIRNILinkParams(home_flit)
def subordinate_link = CHISNLinkParams(home_flit)
def requester_endpoint = CHIICNPortParams(
  "home-requester",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 2
)
def subordinate_endpoint = CHIICNPortParams(
  "home-subordinate",
  9,
  CHINodeKind.SNI,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~supports: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 2
)
def home = CHIHomeParams(
  "test-hni",
  5,
  CHINodeKind.HNI,
  ~max_outstanding: 2
)
def requester_port = CHIFabricPortParams(requester_endpoint, requester_link)
def subordinate_port = CHIFabricPortParams(subordinate_endpoint,
                                           subordinate_link)
def subordinate_service = CHISubordinateServiceParams(
  subordinate_endpoint,
  [AddressSet(0x80000000, 0x0fffffff)],
  [CHIRequestSupport(CHIReqOpcode.ReadNoSnp,
                     TransferSizes(1, home_flit.data_bytes)),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpFull,
                     TransferSizes(1, home_flit.data_bytes)),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl,
                     TransferSizes(1, home_flit.data_bytes))]
)
def home_params = CHIHNIParams(home,
                               requester_port,
                               subordinate_port,
                               subordinate_service)
def home_design = elaborate(CHIHNI(home_params))

def home_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic trace_tag; logic [1:0] tag_op; logic exp_comp_ack; logic excl_snoop_me_cah; logic [7:0] group_id_or_lpid; logic snp_attr_or_do_dwt; logic [3:0] mem_attr; logic [3:0] pcrd_type; logic [1:0] order; logic allow_retry; logic likely_shared; logic [2:0] pas; logic [43:0] address; logic [5:0] size_or_num_req; logic multi_req; logic [6:0] opcode; logic [11:0] return_txn_id_or_stash_lpid; logic stash_nid_valid_endian_deep_prefetch_tgt_hint; logic [6:0] return_nid_or_stash_nid_or_data_target; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
    CHIReqFlit;
  typedef
    struct packed {logic [5:0] cache_line_id; logic trace_tag; logic [1:0] tag_op; logic [3:0] pcrd_type; logic [11:0] dbid_or_group_id; logic [2:0] c_busy; logic [2:0] fwd_state_or_data_pull; logic [2:0] resp; logic [1:0] resp_err; logic [4:0] opcode; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
