module CreditBuffer_3(
  input                                                 clock,
                                                        reset,
                                                        grant_enable,
  input  struct packed {logic valid; CHIRspFlit bits; } link_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic credit; }                 link_out,
  output struct packed {logic valid; CHIRspFlit bits; } egress_out,
  output [1:0]                                          count,
                                                        reserved
);

  wire [1:0]                         _reservations_count;
  wire                               _reservations_full;
  wire struct packed {logic ready; } _storage_ingress_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _storage_egress_out;
  wire [1:0]                         _storage_count;
  wire                               _GEN = _storage_egress_out.valid & egress_in.ready;
  wire                               _GEN_0 = grant_enable & (~_reservations_full | _GEN);
  `ifndef SYNTHESIS
    credit_buffer_reserved_slot_available:
      assert property (@(posedge clock) disable iff (reset)
                         ~link_in.valid | _storage_ingress_out.ready);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_buffer_occupancy_reserved:
      assert property (@(posedge clock) disable iff (reset)
                         _reservations_count >= _storage_count);
  `endif // not def SYNTHESIS
  reg  [1:0]                         credit_balance;
  `ifndef SYNTHESIS
    credited_transfer_has_credit:
      assert property (@(posedge clock) disable iff (reset)
                         ~link_in.valid | (|credit_balance));
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credited_grant_within_limit:
      assert property (@(posedge clock) disable iff (reset)
                         ~_GEN_0 | link_in.valid | credit_balance != 2'h2);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credited_balance_in_range:
      assert property (@(posedge clock) disable iff (reset) credit_balance != 2'h3);
  `endif // not def SYNTHESIS
  Queue_3 storage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (link_in),
    .egress_in   (egress_in),
    .ingress_out (_storage_ingress_out),
    .egress_out  (_storage_egress_out),
    .count       (_storage_count)
  );
  CreditCounter_7 reservations (
    .clock     (clock),
    .reset     (reset),
    .increment (_GEN_0),
    .decrement (_GEN),
    .count     (_reservations_count),
    .empty     (/* unused */),
    .full      (_reservations_full)
  );
  always @(posedge clock) begin
    if (reset)
      credit_balance <= 2'h0;
    else
      credit_balance <=
        _GEN_0 ^ link_in.valid
          ? (_GEN_0 ? credit_balance + 2'h1 : credit_balance - 2'h1)
          : credit_balance;
  end // always @(posedge)
  assign link_out = '{credit: _GEN_0};
  assign egress_out = _storage_egress_out;
  assign count = _storage_count;
  assign reserved = _reservations_count;
endmodule

module Queue_3(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; CHIRspFlit bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; CHIRspFlit bits; } egress_out,
  output [1:0]                                          count
);

  wire CHIRspFlit _GEN;
  wire            _GEN_0;
  wire            _write_pointer_value;
  wire            _read_pointer_value;
  wire            _GEN_1 = 1'h0;
  CHIRspFlit      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]      occupancy;
  wire            _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire            _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire            _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter_3 read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter_3 write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module Counter_3(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule

module CreditCounter_7(
