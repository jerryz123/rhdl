    scoreboard_set_free:
      assert property (@(posedge clock) disable iff (_GEN_1)
                         (state & _GEN) == 2'h0 | clear_in.valid
                         & clear_in.bits == set_in.bits);
  `endif // not def SYNTHESIS
  wire       _GEN_2 = ~(clear_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_clear_busy:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         (|(state & _GEN_0)) | set_in.valid
                         & set_in.bits == clear_in.bits);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 2'h0;
    else
      state <=
        set_in.valid | clear_in.valid
          ? (state | (set_in.valid ? _GEN : 2'h0)) & ~(clear_in.valid ? _GEN_0 : 2'h0)
          : state;
  end // always @(posedge)
  assign busy = state;
