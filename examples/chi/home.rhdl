#lang rhdl
// Demonstrates the ready-valid initial-profile HN-I transaction bridge.

import:
  lib("chi/main.rhdl") open

def home_flit = CHIFlitParams()
def requester_endpoint = CHIICNPortParams(
  "home-requester",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 2
)
def subordinate_endpoint = CHIICNPortParams(
  "home-subordinate",
  9,
  CHINodeKind.SNI,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~supports: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 2
)
def home = CHIHomeParams(
  "test-hni",
  5,
  CHINodeKind.HNI,
  ~max_outstanding: 2
)
def subordinate_service = CHISubordinateServiceParams(
  subordinate_endpoint,
  [AddressSet(0x80000000, 0x0fffffff)],
  [CHIRequestSupport(CHIReqOpcode.ReadNoSnp,
                     TransferSizes(1, home_flit.data_bytes)),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpFull,
                     TransferSizes(1, home_flit.data_bytes)),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl,
                     TransferSizes(1, home_flit.data_bytes))]
)
def home_params = CHIHNIParams(home,
                               home_flit,
                               requester_endpoint,
                               subordinate_endpoint,
                               subordinate_service)
def home_design = elaborate(CHIHNI(home_params))

def home_verilog_reference = @str|<<{
