    '{valid: _GEN_24, bits: _GEN_1};
  wire struct packed {logic valid; CHIDatFlit bits; } _GEN_254 =
    '{valid: _GEN_47, bits: _GEN_0};
  wire struct packed {logic ready; } _GEN_255 = '{ready: _GEN_39};
  wire struct packed {logic ready; } _GEN_256 = '{ready: _GEN_53};
  wire struct packed {logic valid; logic bits; } _GEN_257 =
    '{valid: _GEN_5, bits: _GEN_7};
  wire struct packed {logic valid; logic bits; } _GEN_258 =
    '{valid: (_GEN_41 | _GEN_54),
      bits: (_GEN_41 ? _GEN_4 : _subordinate_adapter_response_data_out.bits.txn_id[0])};
  wire struct packed {logic valid; logic bits; } _GEN_259 =
    '{valid: (_GEN_5 & ~_GEN_26), bits: _GEN_7};
  wire struct packed {logic valid; logic bits; } _GEN_260 =
    '{valid: _GEN_54, bits: (_subordinate_adapter_response_data_out.bits.txn_id[0])};
  wire struct packed {logic valid; logic bits; } _GEN_261 =
    '{valid: (_GEN_5 & _GEN_26), bits: _GEN_7};
  wire struct packed {logic valid; logic bits; } _GEN_262 =
    '{valid: _GEN_3, bits: _GEN_4};
  wire struct packed {logic valid; logic bits; } _GEN_263 =
    '{valid: (_GEN_47 & _subordinate_adapter_request_data_out.ready),
      bits: (_requester_adapter_request_data_out.bits.txn_id[0])};
  wire struct packed {logic valid; logic bits; } _GEN_264 =
    '{valid: _GEN_41, bits: _GEN_4};
  assign _GEN_1 =
    '{trace_tag: _GEN_6.trace_tag,
      tag_op: _GEN_6.tag_op,
      exp_comp_ack: _GEN_10,
      excl_snoop_me_cah: _GEN_6.excl_snoop_me_cah,
      group_id_or_lpid: _GEN_6.group_id_or_lpid,
      snp_attr_or_do_dwt: _GEN_10,
      mem_attr: _GEN_6.mem_attr,
      pcrd_type: (4'h0),
      order: (2'h0),
      allow_retry: _GEN_10,
      likely_shared: _GEN_6.likely_shared,
      pas: _GEN_6.pas,
      address: _GEN_6.address,
      size_or_num_req: _GEN_6.size_or_num_req,
      multi_req: _GEN_10,
      opcode: _GEN_6.opcode,
      return_txn_id_or_stash_lpid: _GEN_25,
      stash_nid_valid_endian_deep_prefetch_tgt_hint: _GEN_10,
      return_nid_or_stash_nid_or_data_target: (7'h5),
      txn_id: _GEN_25,
      src_id: (7'h5),
      tgt_id: (7'h9),
      qos: _GEN_6.qos};
  assign _GEN_0 =
    '{data: _requester_adapter_request_data_out.bits.data,
      byte_enable: _requester_adapter_request_data_out.bits.byte_enable,
      replicate: _requester_adapter_request_data_out.bits.replicate,
      num_dat: _requester_adapter_request_data_out.bits.num_dat,
      cah: _requester_adapter_request_data_out.bits.cah,
      trace_tag: _requester_adapter_request_data_out.bits.trace_tag,
      tag_update: _requester_adapter_request_data_out.bits.tag_update,
      tag: _requester_adapter_request_data_out.bits.tag,
      tag_op: _requester_adapter_request_data_out.bits.tag_op,
      cache_line_id: _requester_adapter_request_data_out.bits.cache_line_id,
      data_id: _requester_adapter_request_data_out.bits.data_id,
      ccid: _requester_adapter_request_data_out.bits.ccid,
      dbid_or_mecid: _requester_adapter_request_data_out.bits.dbid_or_mecid,
      c_busy: _requester_adapter_request_data_out.bits.c_busy,
      data_pull: _requester_adapter_request_data_out.bits.data_pull,
      data_source_or_fwd_state:
        _requester_adapter_request_data_out.bits.data_source_or_fwd_state,
      resp: _requester_adapter_request_data_out.bits.resp,
      resp_err: _requester_adapter_request_data_out.bits.resp_err,
      opcode: _requester_adapter_request_data_out.bits.opcode,
      home_nid_or_pbha_or_mismatched_mecid: (7'h5),
      txn_id: subordinate_dbids[_requester_adapter_request_data_out.bits.txn_id[0]],
      src_id: (7'h5),
      tgt_id: (7'h9),
      qos: requests[_requester_adapter_request_data_out.bits.txn_id[0]].qos};
  assign _GEN =
    '{data: _subordinate_adapter_response_data_out.bits.data,
      byte_enable: _subordinate_adapter_response_data_out.bits.byte_enable,
      replicate: _subordinate_adapter_response_data_out.bits.replicate,
      num_dat: _subordinate_adapter_response_data_out.bits.num_dat,
      cah: _subordinate_adapter_response_data_out.bits.cah,
      trace_tag: _subordinate_adapter_response_data_out.bits.trace_tag,
      tag_update: _subordinate_adapter_response_data_out.bits.tag_update,
      tag: _subordinate_adapter_response_data_out.bits.tag,
      tag_op: _subordinate_adapter_response_data_out.bits.tag_op,
      cache_line_id: _subordinate_adapter_response_data_out.bits.cache_line_id,
      data_id: _subordinate_adapter_response_data_out.bits.data_id,
      ccid: _subordinate_adapter_response_data_out.bits.ccid,
      dbid_or_mecid: _subordinate_adapter_response_data_out.bits.dbid_or_mecid,
      c_busy: _subordinate_adapter_response_data_out.bits.c_busy,
      data_pull: _subordinate_adapter_response_data_out.bits.data_pull,
      data_source_or_fwd_state:
        _subordinate_adapter_response_data_out.bits.data_source_or_fwd_state,
      resp: _subordinate_adapter_response_data_out.bits.resp,
      resp_err: _subordinate_adapter_response_data_out.bits.resp_err,
      opcode: _subordinate_adapter_response_data_out.bits.opcode,
      home_nid_or_pbha_or_mismatched_mecid: (7'h5),
      txn_id:
        requests[_subordinate_adapter_response_data_out.bits.txn_id[0]].return_txn_id_or_stash_lpid,
      src_id: (7'h5),
      tgt_id:
        requests[_subordinate_adapter_response_data_out.bits.txn_id[0]].return_nid_or_stash_nid_or_data_target,
      qos: requests[_subordinate_adapter_response_data_out.bits.txn_id[0]].qos};
  CHIRNIICNFlowAdapter requester_adapter (
    .clock                   (clock),
    .reset                   (reset),
    .transmit_enable         (1'h1),
    .receive_enable          (1'h1),
    .port_in                 (requester_in),
    .requests_in             (_GEN_249),
    .requester_responses_in  (_GEN_8),
    .request_data_in         (_GEN_250),
    .responses_in            (_GEN_251),
    .response_data_in        (_GEN_252),
    .port_out                (_requester_adapter_port_out),
    .requests_out            (_requester_adapter_requests_out),
    .requester_responses_out (/* unused */),
    .request_data_out        (_requester_adapter_request_data_out),
    .responses_out           (_requester_adapter_responses_out),
    .response_data_out       (_requester_adapter_response_data_out),
    .transmit_running        (/* unused */),
    .transmit_deactivating   (/* unused */),
    .transmit_credit_empty   (/* unused */),
    .receive_running         (/* unused */),
    .receive_deactivating    (/* unused */)
  );
  CHISNICNFlowAdapter subordinate_adapter (
    .clock                 (clock),
    .reset                 (reset),
    .transmit_enable       (1'h1),
    .receive_enable        (1'h1),
    .port_in               (subordinate_in),
    .requests_in           (_GEN_253),
    .request_data_in       (_GEN_254),
    .responses_in          (_GEN_255),
    .response_data_in      (_GEN_256),
    .port_out              (_subordinate_adapter_port_out),
    .requests_out          (_subordinate_adapter_requests_out),
    .request_data_out      (_subordinate_adapter_request_data_out),
    .responses_out         (_subordinate_adapter_responses_out),
    .response_data_out     (_subordinate_adapter_response_data_out),
    .transmit_running      (/* unused */),
    .transmit_deactivating (/* unused */),
    .transmit_credit_empty (/* unused */),
    .receive_running       (/* unused */),
    .receive_deactivating  (/* unused */)
  );
  Scoreboard occupancy (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_257),
    .clear_in (_GEN_258),
    .busy     (_occupancy_busy)
  );
  Scoreboard_1 read_pending (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_259),
    .clear_in (_GEN_260),
    .busy     (_read_pending_busy)
  );
  Scoreboard_2 write_await_dbid (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_261),
    .clear_in (_GEN_262),
    .busy     (_write_await_dbid_busy)
  );
  Scoreboard_3 write_await_data (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_262),
    .clear_in (_GEN_263),
    .busy     (_write_await_data_busy)
  );
  Scoreboard_4 write_await_comp (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_263),
    .clear_in (_GEN_264),
    .busy     (_write_await_comp_busy)
  );
  always @(posedge clock) begin
    if (reset) begin
      rni_tx_previous_request <= _GEN_10;
      rni_tx_previous_ack <= _GEN_10;
      rni_rx_previous_request <= _GEN_10;
      rni_rx_previous_ack <= _GEN_10;
      rni_tx_req_credit_balance <= 2'h0;
      rni_tx_rsp_credit_balance <= 2'h0;
      rni_tx_dat_credit_balance <= 2'h0;
      rni_rx_rsp_credit_balance <= 2'h0;
      rni_rx_dat_credit_balance <= 2'h0;
      sn_tx_previous_request <= _GEN_10;
      sn_tx_previous_ack <= _GEN_10;
      sn_rx_previous_request <= _GEN_10;
      sn_rx_previous_ack <= _GEN_10;
      sn_tx_rsp_credit_balance <= 2'h0;
      sn_tx_dat_credit_balance <= 2'h0;
      sn_rx_req_credit_balance <= 2'h0;
      sn_rx_dat_credit_balance <= 2'h0;
      entries <=
        '{'{phase: 3'h0,
            requester_id: 7'h0,
            requester_txn_id: 12'h0,
            requester_return_txn_id: 12'h0,
            requester_data_target: 7'h0,
            requester_qos: 4'h0,
            subordinate_id: 7'h0,
            subordinate_dbid: 12'h0},
          '{phase: 3'h0,
            requester_id: 7'h0,
            requester_txn_id: 12'h0,
            requester_return_txn_id: 12'h0,
            requester_data_target: 7'h0,
            requester_qos: 4'h0,
            subordinate_id: 7'h0,
            subordinate_dbid: 12'h0}};
    end
    else begin
      rni_tx_previous_request <= requester_in.tx_link_active_request;
      rni_tx_previous_ack <= _requester_adapter_port_out.tx_link_active_ack;
      rni_rx_previous_request <= _requester_adapter_port_out.rx_link_active_request;
      rni_rx_previous_ack <= requester_in.rx_link_active_ack;
      rni_tx_req_credit_balance <=
        _requester_adapter_port_out.tx_req.credit ^ requester_in.tx_req.valid
          ? (_requester_adapter_port_out.tx_req.credit
               ? rni_tx_req_credit_balance + 2'h1
               : rni_tx_req_credit_balance - 2'h1)
          : rni_tx_req_credit_balance;
      rni_tx_rsp_credit_balance <=
        _requester_adapter_port_out.tx_rsp.credit ^ requester_in.tx_rsp.valid
          ? (_requester_adapter_port_out.tx_rsp.credit
               ? rni_tx_rsp_credit_balance + 2'h1
               : rni_tx_rsp_credit_balance - 2'h1)
          : rni_tx_rsp_credit_balance;
      rni_tx_dat_credit_balance <=
        _requester_adapter_port_out.tx_dat.credit ^ requester_in.tx_dat.valid
          ? (_requester_adapter_port_out.tx_dat.credit
               ? rni_tx_dat_credit_balance + 2'h1
               : rni_tx_dat_credit_balance - 2'h1)
          : rni_tx_dat_credit_balance;
      rni_rx_rsp_credit_balance <=
        requester_in.rx_rsp.credit ^ _requester_adapter_port_out.rx_rsp.valid
          ? (requester_in.rx_rsp.credit
               ? rni_rx_rsp_credit_balance + 2'h1
               : rni_rx_rsp_credit_balance - 2'h1)
          : rni_rx_rsp_credit_balance;
      rni_rx_dat_credit_balance <=
        requester_in.rx_dat.credit ^ _requester_adapter_port_out.rx_dat.valid
          ? (requester_in.rx_dat.credit
               ? rni_rx_dat_credit_balance + 2'h1
               : rni_rx_dat_credit_balance - 2'h1)
          : rni_rx_dat_credit_balance;
      sn_tx_previous_request <= subordinate_in.tx_link_active_request;
      sn_tx_previous_ack <= _subordinate_adapter_port_out.tx_link_active_ack;
      sn_rx_previous_request <= _subordinate_adapter_port_out.rx_link_active_request;
      sn_rx_previous_ack <= subordinate_in.rx_link_active_ack;
      sn_tx_rsp_credit_balance <=
        _subordinate_adapter_port_out.tx_rsp.credit ^ subordinate_in.tx_rsp.valid
          ? (_subordinate_adapter_port_out.tx_rsp.credit
               ? sn_tx_rsp_credit_balance + 2'h1
               : sn_tx_rsp_credit_balance - 2'h1)
          : sn_tx_rsp_credit_balance;
      sn_tx_dat_credit_balance <=
        _subordinate_adapter_port_out.tx_dat.credit ^ subordinate_in.tx_dat.valid
          ? (_subordinate_adapter_port_out.tx_dat.credit
               ? sn_tx_dat_credit_balance + 2'h1
               : sn_tx_dat_credit_balance - 2'h1)
          : sn_tx_dat_credit_balance;
      sn_rx_req_credit_balance <=
        subordinate_in.rx_req.credit ^ _subordinate_adapter_port_out.rx_req.valid
          ? (subordinate_in.rx_req.credit
               ? sn_rx_req_credit_balance + 2'h1
               : sn_rx_req_credit_balance - 2'h1)
          : sn_rx_req_credit_balance;
      sn_rx_dat_credit_balance <=
        subordinate_in.rx_dat.credit ^ _subordinate_adapter_port_out.rx_dat.valid
          ? (subordinate_in.rx_dat.credit
               ? sn_rx_dat_credit_balance + 2'h1
               : sn_rx_dat_credit_balance - 2'h1)
          : sn_rx_dat_credit_balance;
      entries[1'h1] <= _GEN_248;
      entries[1'h0] <= _GEN_245;
    end
  end // always @(posedge)
  assign requester_out = _requester_adapter_port_out;
  assign subordinate_out = _subordinate_adapter_port_out;
endmodule

module CHIRNIICNFlowAdapter(
  input                                                                                                                                                                                                                                                                                                                              clock,
                                                                                                                                                                                                                                                                                                                                     reset,
                                                                                                                                                                                                                                                                                                                                     transmit_enable,
                                                                                                                                                                                                                                                                                                                                     receive_enable,
  input  struct packed {logic tx_link_active_request; logic rx_link_active_ack; struct packed {logic valid; CHIReqFlit bits; } tx_req; struct packed {logic valid; CHIRspFlit bits; } tx_rsp; struct packed {logic valid; CHIDatFlit bits; } tx_dat; struct packed {logic credit; } rx_rsp; struct packed {logic credit; } rx_dat; } port_in,
  input  struct packed {logic ready; }                                                                                                                                                                                                                                                                                               requests_in,
                                                                                                                                                                                                                                                                                                                                     requester_responses_in,
                                                                                                                                                                                                                                                                                                                                     request_data_in,
  input  struct packed {logic valid; CHIRspFlit bits; }                                                                                                                                                                                                                                                                              responses_in,
  input  struct packed {logic valid; CHIDatFlit bits; }                                                                                                                                                                                                                                                                              response_data_in,
  output struct packed {struct packed {logic credit; } tx_req; struct packed {logic credit; } tx_rsp; struct packed {logic credit; } tx_dat; logic tx_link_active_ack; logic rx_link_active_request; struct packed {logic valid; CHIRspFlit bits; } rx_rsp; struct packed {logic valid; CHIDatFlit bits; } rx_dat; }                 port_out,
  output struct packed {logic valid; CHIReqFlit bits; }                                                                                                                                                                                                                                                                              requests_out,
  output struct packed {logic valid; CHIRspFlit bits; }                                                                                                                                                                                                                                                                              requester_responses_out,
  output struct packed {logic valid; CHIDatFlit bits; }                                                                                                                                                                                                                                                                              request_data_out,
  output struct packed {logic ready; }                                                                                                                                                                                                                                                                                               responses_out,
                                                                                                                                                                                                                                                                                                                                     response_data_out,
  output                                                                                                                                                                                                                                                                                                                             transmit_running,
                                                                                                                                                                                                                                                                                                                                     transmit_deactivating,
                                                                                                                                                                                                                                                                                                                                     transmit_credit_empty,
                                                                                                                                                                                                                                                                                                                                     receive_running,
                                                                                                                                                                                                                                                                                                                                     receive_deactivating
);

  wire struct packed {logic valid; CHIDatFlit bits; } _response_data_transmitter_link_out;
  wire [1:0]                          _response_data_transmitter_credit_count;
  wire struct packed {logic valid; CHIRspFlit bits; } _response_transmitter_link_out;
  wire [1:0]                          _response_transmitter_credit_count;
  wire struct packed {logic credit; } _request_data_receiver_link_out;
  wire [1:0]                          _request_data_receiver_reserved;
  wire struct packed {logic credit; } _request_response_receiver_link_out;
  wire [1:0]                          _request_response_receiver_reserved;
  wire struct packed {logic credit; } _request_receiver_link_out;
  wire [1:0]                          _request_receiver_reserved;
  reg                                 transmit_request;
  reg                                 receive_ack;
  wire                                _GEN =
    receive_ack & port_in.tx_link_active_request & receive_enable;
  CreditBuffer request_receiver (
    .clock        (clock),
    .reset        (reset),
    .grant_enable (_GEN),
    .link_in      (port_in.tx_req),
    .egress_in    (requests_in),
    .link_out     (_request_receiver_link_out),
    .egress_out   (requests_out),
    .count        (/* unused */),
    .reserved     (_request_receiver_reserved)
  );
  CreditBuffer_1 request_response_receiver (
    .clock        (clock),
    .reset        (reset),
    .grant_enable (_GEN),
    .link_in      (port_in.tx_rsp),
    .egress_in    (requester_responses_in),
    .link_out     (_request_response_receiver_link_out),
    .egress_out   (requester_responses_out),
    .count        (/* unused */),
    .reserved     (_request_response_receiver_reserved)
  );
  CreditBuffer_2 request_data_receiver (
    .clock        (clock),
    .reset        (reset),
    .grant_enable (_GEN),
    .link_in      (port_in.tx_dat),
    .egress_in    (request_data_in),
    .link_out     (_request_data_receiver_link_out),
    .egress_out   (request_data_out),
    .count        (/* unused */),
    .reserved     (_request_data_receiver_reserved)
  );
  CreditSender response_transmitter (
    .clock        (clock),
    .reset        (reset),
    .ingress_in   (responses_in),
    .link_in      (port_in.rx_rsp),
    .ingress_out  (responses_out),
    .link_out     (_response_transmitter_link_out),
    .credit_count (_response_transmitter_credit_count)
  );
  CreditSender_1 response_data_transmitter (
    .clock        (clock),
    .reset        (reset),
    .ingress_in   (response_data_in),
    .link_in      (port_in.rx_dat),
    .ingress_out  (response_data_out),
    .link_out     (_response_data_transmitter_link_out),
    .credit_count (_response_data_transmitter_credit_count)
  );
  always @(posedge clock) begin
    if (reset) begin
      transmit_request <= 1'h0;
      receive_ack <= 1'h0;
    end
    else begin
      transmit_request <=
        ~transmit_request & ~port_in.rx_link_active_ack & transmit_enable
        | ~(transmit_request & port_in.rx_link_active_ack & ~transmit_enable)
        & transmit_request;
      receive_ack <=
        ~receive_ack & port_in.tx_link_active_request & receive_enable
        | ~(receive_ack & ~port_in.tx_link_active_request
            & _request_receiver_reserved == 2'h0
            & _request_response_receiver_reserved == 2'h0
            & _request_data_receiver_reserved == 2'h0) & receive_ack;
    end
  end // always @(posedge)
  assign port_out =
    '{tx_req: _request_receiver_link_out,
      tx_rsp: _request_response_receiver_link_out,
      tx_dat: _request_data_receiver_link_out,
      tx_link_active_ack: receive_ack,
      rx_link_active_request: transmit_request,
      rx_rsp: _response_transmitter_link_out,
      rx_dat: _response_data_transmitter_link_out};
  assign transmit_running = transmit_request & port_in.rx_link_active_ack;
  assign transmit_deactivating = ~transmit_request & port_in.rx_link_active_ack;
  assign transmit_credit_empty =
    _response_transmitter_credit_count == 2'h0
    & _response_data_transmitter_credit_count == 2'h0;
  assign receive_running = port_in.tx_link_active_request & receive_ack;
  assign receive_deactivating = ~port_in.tx_link_active_request & receive_ack;
endmodule

module CreditBuffer(
  input                                                 clock,
                                                        reset,
                                                        grant_enable,
  input  struct packed {logic valid; CHIReqFlit bits; } link_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic credit; }                 link_out,
  output struct packed {logic valid; CHIReqFlit bits; } egress_out,
  output [1:0]                                          count,
                                                        reserved
);

  wire [1:0]                         _reservations_count;
  wire                               _reservations_full;
  wire struct packed {logic ready; } _storage_ingress_out;
  wire struct packed {logic valid; CHIReqFlit bits; } _storage_egress_out;
  wire [1:0]                         _storage_count;
  wire                               _GEN = _storage_egress_out.valid & egress_in.ready;
  wire                               _GEN_0 = grant_enable & (~_reservations_full | _GEN);
  `ifndef SYNTHESIS
    credit_buffer_reserved_slot_available:
      assert property (@(posedge clock) disable iff (reset)
                         ~link_in.valid | _storage_ingress_out.ready);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_buffer_occupancy_reserved:
      assert property (@(posedge clock) disable iff (reset)
                         _reservations_count >= _storage_count);
  `endif // not def SYNTHESIS
  reg  [1:0]                         credit_balance;
  `ifndef SYNTHESIS
    credited_transfer_has_credit:
      assert property (@(posedge clock) disable iff (reset)
                         ~link_in.valid | (|credit_balance));
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credited_grant_within_limit:
      assert property (@(posedge clock) disable iff (reset)
                         ~_GEN_0 | link_in.valid | credit_balance != 2'h2);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credited_balance_in_range:
      assert property (@(posedge clock) disable iff (reset) credit_balance != 2'h3);
  `endif // not def SYNTHESIS
  Queue storage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (link_in),
    .egress_in   (egress_in),
    .ingress_out (_storage_ingress_out),
    .egress_out  (_storage_egress_out),
    .count       (_storage_count)
  );
  CreditCounter reservations (
    .clock     (clock),
    .reset     (reset),
    .increment (_GEN_0),
    .decrement (_GEN),
    .count     (_reservations_count),
    .empty     (/* unused */),
