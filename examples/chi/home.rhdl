module CHISNICNFlowAdapter(
  input                                                                                                                                                                                                                                                                       clock,
                                                                                                                                                                                                                                                                              reset,
                                                                                                                                                                                                                                                                              transmit_enable,
                                                                                                                                                                                                                                                                              receive_enable,
  input  struct packed {logic tx_link_active_request; logic rx_link_active_ack; struct packed {logic valid; CHIRspFlit bits; } tx_rsp; struct packed {logic valid; CHIDatFlit bits; } tx_dat; struct packed {logic credit; } rx_req; struct packed {logic credit; } rx_dat; } port_in,
  input  struct packed {logic valid; CHIReqFlit bits; }                                                                                                                                                                                                                       requests_in,
  input  struct packed {logic valid; CHIDatFlit bits; }                                                                                                                                                                                                                       request_data_in,
  input  struct packed {logic ready; }                                                                                                                                                                                                                                        responses_in,
                                                                                                                                                                                                                                                                              response_data_in,
  output struct packed {struct packed {logic credit; } tx_rsp; struct packed {logic credit; } tx_dat; logic tx_link_active_ack; logic rx_link_active_request; struct packed {logic valid; CHIReqFlit bits; } rx_req; struct packed {logic valid; CHIDatFlit bits; } rx_dat; } port_out,
  output struct packed {logic ready; }                                                                                                                                                                                                                                        requests_out,
                                                                                                                                                                                                                                                                              request_data_out,
  output struct packed {logic valid; CHIRspFlit bits; }                                                                                                                                                                                                                       responses_out,
  output struct packed {logic valid; CHIDatFlit bits; }                                                                                                                                                                                                                       response_data_out,
  output                                                                                                                                                                                                                                                                      transmit_running,
                                                                                                                                                                                                                                                                              transmit_deactivating,
                                                                                                                                                                                                                                                                              transmit_credit_empty,
                                                                                                                                                                                                                                                                              receive_running,
                                                                                                                                                                                                                                                                              receive_deactivating
);

  wire struct packed {logic credit; } _response_data_receiver_link_out;
  wire [1:0]                          _response_data_receiver_reserved;
  wire struct packed {logic credit; } _response_receiver_link_out;
  wire [1:0]                          _response_receiver_reserved;
  wire struct packed {logic valid; CHIDatFlit bits; } _request_data_transmitter_link_out;
  wire [1:0]                          _request_data_transmitter_credit_count;
  wire struct packed {logic valid; CHIReqFlit bits; } _request_transmitter_link_out;
  wire [1:0]                          _request_transmitter_credit_count;
  reg                                 transmit_request;
  reg                                 receive_ack;
  wire                                _GEN =
    receive_ack & port_in.tx_link_active_request & receive_enable;
  CreditSender_2 request_transmitter (
    .clock        (clock),
    .reset        (reset),
    .ingress_in   (requests_in),
    .link_in      (port_in.rx_req),
    .ingress_out  (requests_out),
    .link_out     (_request_transmitter_link_out),
    .credit_count (_request_transmitter_credit_count)
  );
  CreditSender_3 request_data_transmitter (
    .clock        (clock),
    .reset        (reset),
    .ingress_in   (request_data_in),
    .link_in      (port_in.rx_dat),
    .ingress_out  (request_data_out),
    .link_out     (_request_data_transmitter_link_out),
    .credit_count (_request_data_transmitter_credit_count)
  );
  CreditBuffer_3 response_receiver (
    .clock        (clock),
    .reset        (reset),
    .grant_enable (_GEN),
    .link_in      (port_in.tx_rsp),
    .egress_in    (responses_in),
    .link_out     (_response_receiver_link_out),
    .egress_out   (responses_out),
    .count        (/* unused */),
    .reserved     (_response_receiver_reserved)
  );
  CreditBuffer_4 response_data_receiver (
    .clock        (clock),
    .reset        (reset),
    .grant_enable (_GEN),
    .link_in      (port_in.tx_dat),
    .egress_in    (response_data_in),
    .link_out     (_response_data_receiver_link_out),
    .egress_out   (response_data_out),
    .count        (/* unused */),
    .reserved     (_response_data_receiver_reserved)
  );
  always @(posedge clock) begin
    if (reset) begin
      transmit_request <= 1'h0;
      receive_ack <= 1'h0;
    end
    else begin
      transmit_request <=
        ~transmit_request & ~port_in.rx_link_active_ack & transmit_enable
        | ~(transmit_request & port_in.rx_link_active_ack & ~transmit_enable)
        & transmit_request;
      receive_ack <=
        ~receive_ack & port_in.tx_link_active_request & receive_enable
        | ~(receive_ack & ~port_in.tx_link_active_request
            & _response_receiver_reserved == 2'h0
            & _response_data_receiver_reserved == 2'h0) & receive_ack;
    end
  end // always @(posedge)
  assign port_out =
    '{tx_rsp: _response_receiver_link_out,
      tx_dat: _response_data_receiver_link_out,
      tx_link_active_ack: receive_ack,
      rx_link_active_request: transmit_request,
      rx_req: _request_transmitter_link_out,
      rx_dat: _request_data_transmitter_link_out};
  assign transmit_running = transmit_request & port_in.rx_link_active_ack;
  assign transmit_deactivating = ~transmit_request & port_in.rx_link_active_ack;
  assign transmit_credit_empty =
    _request_transmitter_credit_count == 2'h0
    & _request_data_transmitter_credit_count == 2'h0;
  assign receive_running = port_in.tx_link_active_request & receive_ack;
  assign receive_deactivating = ~port_in.tx_link_active_request & receive_ack;
endmodule

module CreditSender_2(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; CHIReqFlit bits; } ingress_in,
  input  struct packed {logic credit; }                 link_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; CHIReqFlit bits; } link_out,
  output [1:0]                                          credit_count
);

  wire _balance_empty;
  wire _GEN = ingress_in.valid & ~_balance_empty;
  CreditCounter_5 balance (
    .clock     (clock),
    .reset     (reset),
    .increment (link_in.credit),
    .decrement (_GEN),
    .count     (credit_count),
    .empty     (_balance_empty),
    .full      (/* unused */)
  );
  assign ingress_out = '{ready: (~_balance_empty)};
  assign link_out = '{valid: _GEN, bits: ingress_in.bits};
endmodule

module CreditCounter_5(
  input        clock,
               reset,
               increment,
               decrement,
  output [1:0] count,
  output       empty,
               full
);

  reg  [1:0] state;
  wire       _GEN = state == 2'h0;
  wire       _GEN_0 = state == 2'h2;
  `ifndef SYNTHESIS
    credit_counter_underflow:
      assert property (@(posedge clock) disable iff (reset) ~decrement | ~_GEN);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_counter_overflow:
      assert property (@(posedge clock) disable iff (reset)
                         ~increment | decrement | ~_GEN_0);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_counter_in_range:
      assert property (@(posedge clock) disable iff (reset) state != 2'h3);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 2'h0;
    else
      state <= increment ^ decrement ? (increment ? state + 2'h1 : state - 2'h1) : state;
  end // always @(posedge)
  assign count = state;
  assign empty = _GEN;
  assign full = _GEN_0;
endmodule

