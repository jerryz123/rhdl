    struct packed {logic trace_tag; logic [1:0] tag_op; logic exp_comp_ack; logic excl_snoop_me_cah; logic [7:0] group_id_or_lpid; logic snp_attr_or_do_dwt; CHIMemAttr mem_attr; logic [3:0] pcrd_type; logic [1:0] order; logic allow_retry; logic likely_shared; logic [2:0] pas; logic [43:0] address; logic [5:0] size_or_num_req; logic multi_req; logic [6:0] opcode; logic [11:0] return_txn_id_or_stash_lpid; logic stash_nid_valid_endian_deep_prefetch_tgt_hint; logic [6:0] return_nid_or_stash_nid_or_data_target; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
