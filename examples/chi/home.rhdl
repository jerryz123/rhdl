    struct packed {struct packed {logic ready; } req; struct packed {struct packed {logic ready; } requester; struct packed {logic valid; CHIRspFlit bits; } response; } rsp; struct packed {struct packed {logic ready; } request; struct packed {logic valid; CHIDatFlit bits; } response; } dat; }
    _GEN_172 = '{req: _GEN_166, rsp: _GEN_168, dat: _GEN_171};
  wire struct packed {logic ready; } _GEN_173 = '{ready: _GEN_40};
  wire struct packed {logic valid; CHIReqFlit bits; } _GEN_174 =
    '{valid: _GEN_22, bits: _GEN_157};
  wire struct packed {logic valid; CHIDatFlit bits; } _GEN_175 =
    '{valid: _GEN_52, bits: _GEN_156};
  wire struct packed {logic ready; } _GEN_176 = '{ready: _GEN_63};
  wire
    struct packed {struct packed {logic valid; CHIDatFlit bits; } request; struct packed {logic ready; } response; }
    _GEN_177 = '{request: _GEN_175, response: _GEN_176};
  wire
    struct packed {struct packed {logic ready; } rsp; struct packed {logic valid; CHIReqFlit bits; } req; struct packed {struct packed {logic valid; CHIDatFlit bits; } request; struct packed {logic ready; } response; } dat; }
    _GEN_178 = '{rsp: _GEN_173, req: _GEN_174, dat: _GEN_177};
  Scoreboard occupancy (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_165),
    .clear_in (_GEN_164),
    .busy     (_occupancy_busy)
  );
  Scoreboard read_pending (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_163),
    .clear_in (_GEN_162),
    .busy     (_read_pending_busy)
  );
  Scoreboard write_await_dbid (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_161),
    .clear_in (_GEN_160),
    .busy     (_write_await_dbid_busy)
  );
  Scoreboard write_await_data (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_160),
    .clear_in (_GEN_159),
    .busy     (_write_await_data_busy)
  );
  Scoreboard write_await_comp (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_159),
    .clear_in (_GEN_158),
    .busy     (_write_await_comp_busy)
  );
  always @(posedge clock) begin
    if (reset) begin
      received_write_data_ids <= _GEN_7;
      received_read_data_ids <= _GEN_7;
      entries <=
        '{'{phase: 3'h0,
            requester_id: 7'h0,
            requester_txn_id: 12'h0,
            requester_return_txn_id: 12'h0,
            requester_data_target: 7'h0,
            requester_qos: 4'h0,
            subordinate_id: 7'h0,
            subordinate_dbid: 12'h0,
            expected_data_ids: 4'h0,
            received_data_ids: 4'h0},
          '{phase: 3'h0,
            requester_id: 7'h0,
            requester_txn_id: 12'h0,
            requester_return_txn_id: 12'h0,
            requester_data_target: 7'h0,
            requester_qos: 4'h0,
            subordinate_id: 7'h0,
            subordinate_dbid: 12'h0,
            expected_data_ids: 4'h0,
            received_data_ids: 4'h0}};
    end
    else begin
      received_write_data_ids <=
        _GEN_26 | _GEN_53
          ? {{_GEN_26 & _GEN_4
                ? 4'h0
                : _GEN_53 & port_in.requester.dat.request.bits.txn_id[0]
                    ? _GEN_49
                    : received_write_data_ids[1'h1]},
             {_GEN_26 & ~_GEN_4
                ? 4'h0
                : _GEN_53 & ~(port_in.requester.dat.request.bits.txn_id[0])
                    ? _GEN_49
                    : received_write_data_ids[_GEN_8]}}
          : received_write_data_ids;
      received_read_data_ids <=
        _GEN_27 | _GEN_64
          ? {{_GEN_27 & _GEN_4
                ? 4'h0
                : _GEN_64 & port_in.subordinate.dat.response.bits.txn_id[0]
                    ? _GEN_60
                    : received_read_data_ids[1'h1]},
             {_GEN_27 & ~_GEN_4
                ? 4'h0
                : _GEN_64 & ~(port_in.subordinate.dat.response.bits.txn_id[0])
                    ? _GEN_60
                    : received_read_data_ids[_GEN_8]}}
          : received_read_data_ids;
      entries[1'h1] <= _GEN_154;
      entries[1'h0] <= _GEN_148;
    end
  end // always @(posedge)
  assign port_out = '{requester: _GEN_172, subordinate: _GEN_178};
endmodule

module Scoreboard(
  input                                            clock,
                                                   reset,
  input  struct packed {logic valid; logic bits; } set_in,
                                                   clear_in,
  output [1:0]                                     busy
);

  reg  [1:0] state;
  wire [1:0] _GEN = 2'h1 << set_in.bits;
  wire [1:0] _GEN_0 = 2'h1 << clear_in.bits;
  wire       _GEN_1 = ~(set_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_set_free:
      assert property (@(posedge clock) disable iff (_GEN_1)
                         (state & _GEN) == 2'h0 | clear_in.valid
                         & clear_in.bits == set_in.bits);
  `endif // not def SYNTHESIS
  wire       _GEN_2 = ~(clear_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_clear_busy:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         (|(state & _GEN_0)) | set_in.valid
                         & set_in.bits == clear_in.bits);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 2'h0;
    else
      state <=
        set_in.valid | clear_in.valid
          ? (state | (set_in.valid ? _GEN : 2'h0)) & ~(clear_in.valid ? _GEN_0 : 2'h0)
          : state;
  end // always @(posedge)
  assign busy = state;
endmodule
}>>|

