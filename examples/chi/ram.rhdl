  `endif // not def SYNTHESIS
  wire                                _GEN_45 =
    ~port_in.rx_link_active_request & receive_ack;
  wire                                _GEN_46 = port_in.rx_req.valid & _GEN_41 & ~reset;
  wire                                _GEN_47 = ~_GEN_46;
