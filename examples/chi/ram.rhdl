  `endif // not def SYNTHESIS
  wire                                _GEN_36 =
    _response_data_transmitter_link_out.bits.opcode == 4'h4;
  wire                                _GEN_37 =
    _response_data_transmitter_link_out.valid & ~reset;
  wire                                _GEN_38 = ~_GEN_37;
  `ifndef SYNTHESIS
    chi_tx_dat_opcode_valid:
      assert property (@(posedge clock) disable iff (_GEN_38)
