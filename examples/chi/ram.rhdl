#lang rhdl
// Demonstrates a finite initial-profile non-coherent CHI backing RAM.

import:
  lib("chi/main.rhdl") open

def ram_flit = CHIFlitParams()
def ram_link = CHISNLinkParams(
  ram_flit,
  ~tx_rsp_credits: 2,
  ~tx_dat_credits: 2,
  ~rx_req_credits: 2,
  ~rx_dat_credits: 2
)
def ram_params = CHIRamParams(
  "test-chi-ram",
  9,
  ram_link,
  64,
  ~base_address: 0x80000000,
  ~max_outstanding: 2
)
def ram_design = elaborate(CHIRam(ram_params))

def ram_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef
    struct packed {logic trace_tag; logic [1:0] tag_op; logic exp_comp_ack; logic excl_snoop_me_cah; logic [7:0] group_id_or_lpid; logic snp_attr_or_do_dwt; logic [3:0] mem_attr; logic [3:0] pcrd_type; logic [1:0] order; logic allow_retry; logic likely_shared; logic [2:0] pas; logic [43:0] address; logic [5:0] size_or_num_req; logic multi_req; logic [6:0] opcode; logic [11:0] return_txn_id_or_stash_lpid; logic stash_nid_valid_endian_deep_prefetch_tgt_hint; logic [6:0] return_nid_or_stash_nid_or_data_target; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
    CHIReqFlit;
  typedef
    struct packed {logic [127:0] data; logic [15:0] byte_enable; logic replicate; logic [1:0] num_dat; logic cah; logic trace_tag; logic tag_update; logic [3:0] tag; logic [1:0] tag_op; logic [5:0] cache_line_id; logic [1:0] data_id; logic [1:0] ccid; logic [15:0] dbid_or_mecid; logic [2:0] c_busy; logic data_pull; logic [7:0] data_source_or_fwd_state; logic [2:0] resp; logic [1:0] resp_err; logic [3:0] opcode; logic [6:0] home_nid_or_pbha_or_mismatched_mecid; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
    CHIDatFlit;
  typedef
    struct packed {logic [5:0] cache_line_id; logic trace_tag; logic [1:0] tag_op; logic [3:0] pcrd_type; logic [11:0] dbid_or_group_id; logic [2:0] c_busy; logic [2:0] fwd_state_or_data_pull; logic [2:0] resp; logic [1:0] resp_err; logic [4:0] opcode; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
    CHIRspFlit;
  typedef
    struct packed {logic write; logic slot; CHIReqFlit request; logic [127:0] data; logic [15:0] mask; }
    CHIRamMemoryOperation;
  typedef struct packed {CHIRamMemoryOperation memory_operation; logic [127:0] data; }
    CHIRamMemoryCompletion;
  typedef struct packed {logic slot; logic write; CHIReqFlit request; }
    CHISNAllocatedTransaction;
  typedef struct packed {logic slot; CHIReqFlit request; CHIDatFlit data; }
    CHISNMatchedWrite;
  typedef struct packed {logic write; CHIReqFlit request; } CHISNTransactionAllocation;
  typedef
    struct packed {logic [1:0] address; logic write; logic [15:0][7:0] data; logic [15:0] mask; }
    ReadWriteRequest;
  typedef
    struct packed {logic [2:0] phase; logic [11:0] txn_id; logic [6:0] requester_id; logic [11:0] return_txn_id; logic [6:0] return_node_id; logic [11:0] dbid; }
    CHISubordinateTransaction;
`endif // _TYPESCOPE_rhdl_types
module CHIRam(
  input                                                                                                                                                                                                                                                                       clock,
                                                                                                                                                                                                                                                                              reset,
  input  struct packed {struct packed {logic credit; } tx_rsp; struct packed {logic credit; } tx_dat; logic tx_link_active_ack; logic rx_link_active_request; struct packed {logic valid; CHIReqFlit bits; } rx_req; struct packed {logic valid; CHIDatFlit bits; } rx_dat; } port_in,
  output struct packed {logic tx_link_active_request; logic rx_link_active_ack; struct packed {logic valid; CHIRspFlit bits; } tx_rsp; struct packed {logic valid; CHIDatFlit bits; } tx_dat; struct packed {logic credit; } rx_req; struct packed {logic credit; } rx_dat; } port_out
);

  wire struct packed {logic valid; ReadWriteRequest bits; } _GEN;
  wire                                _GEN_0;
  wire                                _GEN_1;
  wire                                _GEN_2;
  wire struct packed {logic ready; }  _fork_stage_ingress_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _fork_stage_egress_0_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _fork_stage_egress_1_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _valid_pipe_stage_egress_out;
  wire struct packed {logic ready; }  _transaction_slots_allocation_out;
  wire struct packed {logic valid; CHISNAllocatedTransaction bits; }
    _transaction_slots_allocated_out;
  wire struct packed {logic ready; }  _transaction_slots_write_data_out;
  wire struct packed {logic valid; CHISNMatchedWrite bits; }
    _transaction_slots_matched_write_out;
  wire struct packed {logic ready; }  _response_arbiter_ingress_0_out;
  wire struct packed {logic ready; }  _response_arbiter_ingress_1_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _response_arbiter_egress_out;
  wire struct packed {logic ready; }  _completion_router_ingress_out;
  wire struct packed {logic valid; CHIDatFlit bits; }
    _completion_router_read_response_out;
  wire struct packed {logic valid; CHIRspFlit bits; }
    _completion_router_write_response_out;
  wire struct packed {logic valid; logic bits; } _completion_router_completed_out;
  wire struct packed {struct packed {logic valid; logic [15:0][7:0] bits; } response; }
    _storage_port_out;
  wire struct packed {logic ready; }  _memory_operations_request_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _memory_operations_issue_out;
  wire struct packed {logic valid; CHIRamMemoryCompletion bits; }
    _memory_operations_response_out;
  wire struct packed {logic ready; }  _operation_arbiter_ingress_0_out;
  wire struct packed {logic ready; }  _operation_arbiter_ingress_1_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _operation_arbiter_egress_out;
  wire struct packed {logic ready; }  _write_operations_ingress_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _write_operations_egress_out;
  wire struct packed {logic ready; }  _read_operations_ingress_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _read_operations_egress_out;
  wire struct packed {logic ready; }  _dbid_responses_ingress_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _dbid_responses_egress_out;
  wire struct packed {logic ready; }  _response_data_transmitter_ingress_out;
  wire struct packed {logic valid; CHIDatFlit bits; } _response_data_transmitter_link_out;
  wire struct packed {logic ready; }  _response_transmitter_ingress_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _response_transmitter_link_out;
  wire struct packed {logic credit; } _request_data_receiver_link_out;
  wire struct packed {logic valid; CHIDatFlit bits; } _request_data_receiver_egress_out;
  wire [1:0]                          _request_data_receiver_reserved;
  wire struct packed {logic credit; } _request_receiver_link_out;
  wire struct packed {logic valid; CHIReqFlit bits; } _request_receiver_egress_out;
  wire [1:0]                          _request_receiver_reserved;
  wire struct packed {logic ready; }  _GEN_3 = '{ready: 1'h1};
  wire CHISubordinateTransaction      _GEN_4 =
    '{phase: 3'h0,
      txn_id: 12'h0,
      requester_id: 7'h0,
      return_txn_id: 12'h0,
      return_node_id: 7'h0,
      dbid: 12'h0};
  reg                                 transmit_request;
  reg                                 receive_ack;
  wire                                _GEN_5 =
    receive_ack & port_in.rx_link_active_request;
  wire                                _GEN_6 =
    _request_receiver_egress_out.bits.opcode == 7'h1D;
  wire                                _GEN_7 =
    _request_receiver_egress_out.bits.opcode == 7'h1C;
  wire                                _GEN_8 =
    _request_receiver_egress_out.bits.opcode == 7'h4 | _GEN_6 | _GEN_7;
  wire CHISNTransactionAllocation     _GEN_9 =
    '{write: (_GEN_6 | _GEN_7), request: _request_receiver_egress_out.bits};
  assign _GEN_2 = _transaction_slots_allocation_out.ready;
  wire CHIRamMemoryOperation          _GEN_10 =
    '{write: (1'h0),
      slot: _transaction_slots_allocated_out.bits.slot,
      request: _transaction_slots_allocated_out.bits.request,
      data: (128'h0),
      mask: (16'h0)};
  assign _GEN_1 = _read_operations_ingress_out.ready;
  wire CHIRspFlit                     _GEN_11 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: {11'h0, _transaction_slots_allocated_out.bits.slot},
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (5'h6),
      txn_id: _transaction_slots_allocated_out.bits.request.txn_id,
      src_id: (7'h9),
      tgt_id: _transaction_slots_allocated_out.bits.request.src_id,
      qos: _transaction_slots_allocated_out.bits.request.qos};
  assign _GEN_0 = _dbid_responses_ingress_out.ready;
  wire CHIRamMemoryOperation          _GEN_12 =
    '{write: (1'h1),
      slot: _transaction_slots_matched_write_out.bits.slot,
      request: _transaction_slots_matched_write_out.bits.request,
      data: _transaction_slots_matched_write_out.bits.data.data,
      mask: _transaction_slots_matched_write_out.bits.data.byte_enable};
  wire [15:0][7:0]                    _GEN_13 =
    /*cast(bit[15:0][7:0])*/_memory_operations_issue_out.bits.data;
  wire ReadWriteRequest               _GEN_14 =
    '{address: (_memory_operations_issue_out.bits.request.address[5:4]),
      write: _memory_operations_issue_out.bits.write,
      data: _GEN_13,
      mask: _memory_operations_issue_out.bits.mask};
  wire [127:0]                        _GEN_15 =
    /*cast(bit[127:0])*/_storage_port_out.response.bits;
  wire CHIRamMemoryCompletion         _GEN_16 =
    '{memory_operation: _valid_pipe_stage_egress_out.bits,
      data: (_valid_pipe_stage_egress_out.bits.write ? 128'h0 : _GEN_15)};
  reg                                 sn_tx_previous_request;
  reg                                 sn_tx_previous_ack;
  reg                                 sn_rx_previous_request;
  reg                                 sn_rx_previous_ack;
  reg  [1:0]                          sn_tx_rsp_credit_balance;
  reg  [1:0]                          sn_tx_dat_credit_balance;
  reg  [1:0]                          sn_rx_req_credit_balance;
  reg  [1:0]                          sn_rx_dat_credit_balance;
  `ifndef SYNTHESIS
    chi_tx_link_request_after_ack_low:
      assert property (@(posedge clock) disable iff (reset)
                         ~(transmit_request & ~sn_tx_previous_request)
                         | ~sn_tx_previous_ack);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    chi_tx_link_ack_after_request:
      assert property (@(posedge clock) disable iff (reset)
                         ~(port_in.tx_link_active_ack & ~sn_tx_previous_ack)
                         | transmit_request);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    chi_tx_link_request_drop_after_ack:
      assert property (@(posedge clock) disable iff (reset)
                         ~(~transmit_request & sn_tx_previous_request)
                         | sn_tx_previous_ack);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    chi_tx_link_ack_drop_after_request:
      assert property (@(posedge clock) disable iff (reset)
                         ~(~port_in.tx_link_active_ack & sn_tx_previous_ack)
                         | ~transmit_request);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    chi_rx_link_request_after_ack_low:
      assert property (@(posedge clock) disable iff (reset)
                         ~(port_in.rx_link_active_request & ~sn_rx_previous_request)
                         | ~sn_rx_previous_ack);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    chi_rx_link_ack_after_request:
      assert property (@(posedge clock) disable iff (reset)
                         ~(receive_ack & ~sn_rx_previous_ack)
                         | port_in.rx_link_active_request);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    chi_rx_link_request_drop_after_ack:
      assert property (@(posedge clock) disable iff (reset)
                         ~(~port_in.rx_link_active_request & sn_rx_previous_request)
                         | sn_rx_previous_ack);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    chi_rx_link_ack_drop_after_request:
      assert property (@(posedge clock) disable iff (reset)
                         ~(~receive_ack & sn_rx_previous_ack)
                         | ~port_in.rx_link_active_request);
  `endif // not def SYNTHESIS
  wire                                _GEN_17 =
    _response_transmitter_link_out.bits.opcode == 5'h0;
  `ifndef SYNTHESIS
    credited_transfer_has_credit:
      assert property (@(posedge clock) disable iff (reset)
                         ~_response_transmitter_link_out.valid
                         | (|sn_tx_rsp_credit_balance));
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credited_grant_within_limit:
      assert property (@(posedge clock) disable iff (reset)
                         ~port_in.tx_rsp.credit | _response_transmitter_link_out.valid
                         | sn_tx_rsp_credit_balance != 2'h2);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credited_balance_in_range:
      assert property (@(posedge clock) disable iff (reset)
                         sn_tx_rsp_credit_balance != 2'h3);
  `endif // not def SYNTHESIS
  wire                                _GEN_18 =
    port_in.tx_link_active_ack & (transmit_request | sn_tx_previous_request);
  `ifndef SYNTHESIS
    chi_tx_rsp_flit_active:
      assert property (@(posedge clock) disable iff (reset)
                         ~_response_transmitter_link_out.valid
                         | port_in.tx_link_active_ack);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    chi_tx_rsp_credit_active:
