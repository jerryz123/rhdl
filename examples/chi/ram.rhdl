  `endif // not def SYNTHESIS
  wire                                _GEN_21 =
    ~transmit_request & port_in.tx_link_active_ack;
  wire                                _GEN_22 =
    _response_transmitter_link_out.valid & _GEN_17 & ~reset;
  wire                                _GEN_23 = ~_GEN_22;
  `ifndef SYNTHESIS
    chi_tx_rsp_lcrd_during_deactivate:
      assert property (@(posedge clock) disable iff (_GEN_23) _GEN_21);
  `endif // not def SYNTHESIS
  wire                                _GEN_24 =
    ~(_response_transmitter_link_out.valid & ~_GEN_17 & ~reset);
  `ifndef SYNTHESIS
    chi_tx_rsp_source_id:
      assert property (@(posedge clock) disable iff (_GEN_24)
                         _response_transmitter_link_out.bits.src_id == 7'h9);
  `endif // not def SYNTHESIS
  wire                                _GEN_25 =
    _response_transmitter_link_out.bits.opcode == 5'h4;
  wire                                _GEN_26 =
    _response_transmitter_link_out.bits.opcode == 5'h6;
  wire                                _GEN_27 =
    _response_transmitter_link_out.valid & ~reset;
  wire                                _GEN_28 = ~_GEN_27;
  `ifndef SYNTHESIS
    chi_tx_rsp_opcode_valid:
      assert property (@(posedge clock) disable iff (_GEN_28)
                         _GEN_17 | _response_transmitter_link_out.bits.opcode == 5'h1
                         | _response_transmitter_link_out.bits.opcode == 5'h2
                         | _response_transmitter_link_out.bits.opcode == 5'h3 | _GEN_25
                         | _response_transmitter_link_out.bits.opcode == 5'h5 | _GEN_26
                         | _response_transmitter_link_out.bits.opcode == 5'h7
                         | _response_transmitter_link_out.bits.opcode == 5'h8
                         | _response_transmitter_link_out.bits.opcode == 5'h9
                         | _response_transmitter_link_out.bits.opcode == 5'hA
                         | _response_transmitter_link_out.bits.opcode == 5'hB
                         | _response_transmitter_link_out.bits.opcode == 5'hC
                         | _response_transmitter_link_out.bits.opcode == 5'hD
                         | _response_transmitter_link_out.bits.opcode == 5'hE
                         | _response_transmitter_link_out.bits.opcode == 5'h10
                         | _response_transmitter_link_out.bits.opcode == 5'h11
                         | _response_transmitter_link_out.bits.opcode == 5'h14);
  `endif // not def SYNTHESIS
  wire                                _GEN_29 = ~_GEN_27;
  `ifndef SYNTHESIS
    chi_tx_rsp_opcode_supported:
      assert property (@(posedge clock) disable iff (_GEN_29)
