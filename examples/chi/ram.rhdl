#lang rhdl
// Demonstrates a finite initial-profile non-coherent CHI backing RAM.

import:
  lib("chi/main.rhdl") open

def ram_flit = CHIFlitParams()
def ram_config = CHIRamConfig(ram_flit, 64, ~max_outstanding: 2)
def ram_params = CHIRamParams(
  "test-chi-ram",
  9,
  ram_config,
  ~base_address: 0x80000000
)
def ram_design = elaborate(CHIRam(ram_config))

def ram_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef struct packed {logic [6:0] node_id; logic [43:0] base_address; } CHIRamIdentity;
  typedef
    struct packed {logic allocate; logic cacheable; logic device; logic early_write_acknowledge; }
    CHIMemAttr;
  typedef
    struct packed {logic trace_tag; logic [1:0] tag_op; logic exp_comp_ack; logic excl_snoop_me_cah; logic [7:0] group_id_or_lpid; logic snp_attr_or_do_dwt; CHIMemAttr mem_attr; logic [3:0] pcrd_type; logic [1:0] order; logic allow_retry; logic likely_shared; logic [2:0] pas; logic [43:0] address; logic [5:0] size_or_num_req; logic multi_req; logic [6:0] opcode; logic [11:0] return_txn_id_or_stash_lpid; logic stash_nid_valid_endian_deep_prefetch_tgt_hint; logic [6:0] return_nid_or_stash_nid_or_data_target; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
    CHIReqFlit;
  typedef
    struct packed {logic [127:0] data; logic [15:0] byte_enable; logic replicate; logic [1:0] num_dat; logic cah; logic trace_tag; logic tag_update; logic [3:0] tag; logic [1:0] tag_op; logic [5:0] cache_line_id; logic [1:0] data_id; logic [1:0] ccid; logic [15:0] dbid_or_mecid; logic [2:0] c_busy; logic data_pull; logic [7:0] data_source_or_fwd_state; logic [2:0] resp; logic [1:0] resp_err; logic [3:0] opcode; logic [6:0] home_nid_or_pbha_or_mismatched_mecid; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
    CHIDatFlit;
  typedef
    struct packed {logic [5:0] cache_line_id; logic trace_tag; logic [1:0] tag_op; logic [3:0] pcrd_type; logic [11:0] dbid_or_group_id; logic [2:0] c_busy; logic [2:0] fwd_state_or_data_pull; logic [2:0] resp; logic [1:0] resp_err; logic [4:0] opcode; logic [11:0] txn_id; logic [6:0] src_id; logic [6:0] tgt_id; logic [3:0] qos; }
    CHIRspFlit;
  typedef
    struct packed {logic write; logic slot; CHIReqFlit request; logic [127:0] data; logic [15:0] mask; }
    CHIRamMemoryOperation;
  typedef struct packed {CHIRamMemoryOperation memory_operation; logic [127:0] data; }
    CHIRamMemoryCompletion;
  typedef struct packed {logic slot; logic write; CHIReqFlit request; }
    CHISNAllocatedTransaction;
  typedef struct packed {logic slot; CHIReqFlit request; CHIDatFlit data; }
    CHISNMatchedWrite;
  typedef struct packed {logic write; CHIReqFlit request; } CHISNTransactionAllocation;
  typedef
    struct packed {logic [1:0] address; logic write; logic [15:0][7:0] data; logic [15:0] mask; }
    ReadWriteRequest;
  typedef struct packed {logic valid; logic [1:0] grant; logic index; }
    CircularPriorityChoice;
  typedef struct packed {logic all; logic [1:0] except; } AndExclusionReduction;
`endif // _TYPESCOPE_rhdl_types
module CHIRam(
  input                                                                                                                                                                                                                                clock,
                                                                                                                                                                                                                                       reset,
  input  CHIRamIdentity                                                                                                                                                                                                                identity,
  input  struct packed {struct packed {logic ready; } rsp; struct packed {logic valid; CHIReqFlit bits; } req; struct packed {struct packed {logic valid; CHIDatFlit bits; } request; struct packed {logic ready; } response; } dat; } port_in,
  output struct packed {struct packed {logic valid; CHIRspFlit bits; } rsp; struct packed {logic ready; } req; struct packed {struct packed {logic ready; } request; struct packed {logic valid; CHIDatFlit bits; } response; } dat; } port_out
);

  wire                               _GEN;
  wire                               _GEN_0;
  wire                               _GEN_1;
  wire struct packed {logic ready; } _fork_stage_ingress_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _fork_stage_egress_0_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _fork_stage_egress_1_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _valid_pipe_stage_egress_out;
  wire struct packed {logic ready; } _transaction_slots_allocation_out;
  wire struct packed {logic valid; CHISNAllocatedTransaction bits; }
    _transaction_slots_allocated_out;
  wire struct packed {logic ready; } _transaction_slots_write_data_out;
  wire struct packed {logic valid; CHISNMatchedWrite bits; }
    _transaction_slots_matched_write_out;
  wire struct packed {logic ready; } _response_arbiter_ingress_0_out;
  wire struct packed {logic ready; } _response_arbiter_ingress_1_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _response_arbiter_egress_out;
  wire struct packed {logic ready; } _completion_router_ingress_out;
  wire struct packed {logic valid; CHIDatFlit bits; }
    _completion_router_read_response_out;
  wire struct packed {logic valid; CHIRspFlit bits; }
    _completion_router_write_response_out;
  wire struct packed {logic valid; logic bits; } _completion_router_completed_out;
  wire struct packed {struct packed {logic valid; logic [15:0][7:0] bits; } response; }
    _storage_port_out;
  wire struct packed {logic ready; } _memory_operations_request_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _memory_operations_issue_out;
  wire struct packed {logic valid; CHIRamMemoryCompletion bits; }
    _memory_operations_response_out;
  wire struct packed {logic ready; } _operation_arbiter_ingress_0_out;
  wire struct packed {logic ready; } _operation_arbiter_ingress_1_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _operation_arbiter_egress_out;
  wire struct packed {logic ready; } _write_operations_ingress_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _write_operations_egress_out;
  wire struct packed {logic ready; } _read_operations_ingress_out;
  wire struct packed {logic valid; CHIRamMemoryOperation bits; }
    _read_operations_egress_out;
  wire struct packed {logic ready; } _dbid_responses_ingress_out;
  wire struct packed {logic valid; CHIRspFlit bits; } _dbid_responses_egress_out;
  wire struct packed {logic ready; } _GEN_2 = '{ready: 1'h1};
  wire                               _GEN_3 = port_in.req.bits.opcode == 7'h1D;
  wire                               _GEN_4 = port_in.req.bits.opcode == 7'h1C;
  wire                               _GEN_5 =
    |{port_in.req.bits.opcode == 7'h4, _GEN_3, _GEN_4};
  wire CHISNTransactionAllocation    _GEN_6 =
    '{write: (|{_GEN_3, _GEN_4}), request: port_in.req.bits};
  assign _GEN_1 = _transaction_slots_allocation_out.ready;
  wire CHIRamMemoryOperation         _GEN_7 =
    '{write: (1'h0),
      slot: _transaction_slots_allocated_out.bits.slot,
      request: _transaction_slots_allocated_out.bits.request,
      data: (128'h0),
      mask: (16'h0)};
  assign _GEN_0 = _read_operations_ingress_out.ready;
  wire CHIRspFlit                    _GEN_8 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: {11'h0, _transaction_slots_allocated_out.bits.slot},
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (5'h6),
      txn_id: _transaction_slots_allocated_out.bits.request.txn_id,
      src_id: identity.node_id,
      tgt_id: _transaction_slots_allocated_out.bits.request.src_id,
      qos: _transaction_slots_allocated_out.bits.request.qos};
  assign _GEN = _dbid_responses_ingress_out.ready;
  wire CHIRamMemoryOperation         _GEN_9 =
    '{write: (1'h1),
      slot: _transaction_slots_matched_write_out.bits.slot,
      request: _transaction_slots_matched_write_out.bits.request,
      data: _transaction_slots_matched_write_out.bits.data.data,
      mask: _transaction_slots_matched_write_out.bits.data.byte_enable};
  wire [5:0]                         _GEN_10 =
    _memory_operations_issue_out.bits.request.address[5:0] - identity.base_address[5:0];
  wire [15:0][7:0]                   _GEN_11 =
    /*cast(bit[15:0][7:0])*/_memory_operations_issue_out.bits.data;
  wire ReadWriteRequest              _GEN_12 =
    '{address: (_GEN_10[5:4]),
      write: _memory_operations_issue_out.bits.write,
      data: _GEN_11,
      mask: _memory_operations_issue_out.bits.mask};
  wire [127:0]                       _GEN_13 =
    /*cast(bit[127:0])*/_storage_port_out.response.bits;
  wire CHIRamMemoryCompletion        _GEN_14 =
    '{memory_operation: _valid_pipe_stage_egress_out.bits,
      data: (_valid_pipe_stage_egress_out.bits.write ? 128'h0 : _GEN_13)};
  wire                               _GEN_15 =
    port_in.req.valid & (|port_in.req.bits.opcode) & ~reset;
  wire                               _GEN_16 = ~_GEN_15;
  `ifndef SYNTHESIS
    chi_ram_request_opcode_supported:
      assert property (@(posedge clock) disable iff (_GEN_16) _GEN_5);
  `endif // not def SYNTHESIS
  wire                               _GEN_17 = ~_GEN_15;
  `ifndef SYNTHESIS
    chi_ram_request_size_supported:
      assert property (@(posedge clock) disable iff (_GEN_17)
                         port_in.req.bits.size_or_num_req[2:0] < 3'h5);
  `endif // not def SYNTHESIS
  wire                               _GEN_18 = ~_GEN_15;
  `ifndef SYNTHESIS
    chi_ram_request_address_aligned:
      assert property (@(posedge clock) disable iff (_GEN_18)
                         port_in.req.bits.size_or_num_req[2:0] == 3'h0
                         | (port_in.req.bits.size_or_num_req[2:0] == 3'h1
                              ? ~(port_in.req.bits.address[0])
                              : port_in.req.bits.size_or_num_req[2:0] == 3'h2
                                  ? port_in.req.bits.address[1:0] == 2'h0
                                  : port_in.req.bits.size_or_num_req[2:0] == 3'h3
                                      ? port_in.req.bits.address[2:0] == 3'h0
                                      : port_in.req.bits.size_or_num_req[2:0] == 3'h4
                                        & port_in.req.bits.address[3:0] == 4'h0));
  `endif // not def SYNTHESIS
  wire                               _GEN_19 = ~_GEN_15;
  `ifndef SYNTHESIS
    chi_ram_request_address_supported:
      assert property (@(posedge clock) disable iff (_GEN_19)
                         port_in.req.bits.address >= identity.base_address
                         & port_in.req.bits.address < identity.base_address + 44'h40);
  `endif // not def SYNTHESIS
  wire [15:0]                        _GEN_20 =
    (_transaction_slots_matched_write_out.bits.request.size_or_num_req[2:0] == 3'h0
       ? 16'h1
       : _transaction_slots_matched_write_out.bits.request.size_or_num_req[2:0] == 3'h1
           ? 16'h3
           : _transaction_slots_matched_write_out.bits.request.size_or_num_req[2:0] == 3'h2
               ? 16'hF
               : _transaction_slots_matched_write_out.bits.request.size_or_num_req[2:0] == 3'h3
                   ? 16'hFF
                   : {16{_transaction_slots_matched_write_out.bits.request.size_or_num_req[2:0] == 3'h4}})
    << _transaction_slots_matched_write_out.bits.request.address[3:0];
  wire                               _GEN_21 =
    ~(_transaction_slots_matched_write_out.valid & ~reset);
  `ifndef SYNTHESIS
    chi_ram_write_data_mask_supported:
      assert property (@(posedge clock) disable iff (_GEN_21)
                         _transaction_slots_matched_write_out.bits.request.opcode == 7'h1C
                           ? (_transaction_slots_matched_write_out.bits.data.byte_enable
                              & _GEN_20) == _transaction_slots_matched_write_out.bits.data.byte_enable
                           : _transaction_slots_matched_write_out.bits.data.byte_enable == _GEN_20);
  `endif // not def SYNTHESIS
  wire struct packed {logic valid; logic bits; } _GEN_22 =
    '{valid: _fork_stage_egress_1_out.valid,
      bits: (_fork_stage_egress_1_out.bits.dbid_or_group_id[0])};
  wire struct packed {logic valid; CHIRamMemoryCompletion bits; } _GEN_23 =
    '{valid: _valid_pipe_stage_egress_out.valid, bits: _GEN_14};
  wire struct packed {logic valid; ReadWriteRequest bits; } _GEN_24 =
    '{valid: _memory_operations_issue_out.valid, bits: _GEN_12};
  wire struct packed {logic valid; CHIRamMemoryOperation bits; } _GEN_25 =
    '{valid: _transaction_slots_matched_write_out.valid, bits: _GEN_9};
  wire struct packed {logic valid; CHIRspFlit bits; } _GEN_26 =
    '{valid:
        (_transaction_slots_allocated_out.valid
         & _transaction_slots_allocated_out.bits.write),
      bits: _GEN_8};
  wire struct packed {logic valid; CHIRamMemoryOperation bits; } _GEN_27 =
    '{valid:
        (_transaction_slots_allocated_out.valid
         & ~_transaction_slots_allocated_out.bits.write),
      bits: _GEN_7};
  wire struct packed {logic ready; } _GEN_28 =
    '{ready:
        (|({{_transaction_slots_allocated_out.bits.write & _GEN},
            {~_transaction_slots_allocated_out.bits.write & _GEN_0}}))};
  wire struct packed {logic valid; CHISNTransactionAllocation bits; } _GEN_29 =
    '{valid: (port_in.req.valid & _GEN_5), bits: _GEN_6};
  wire struct packed {logic ready; } _GEN_30 = '{ready: (~_GEN_5 | _GEN_1)};
  wire struct packed {struct packed {logic valid; ReadWriteRequest bits; } request; }
    _GEN_31 = '{request: _GEN_24};
  wire
    struct packed {struct packed {logic ready; } request; struct packed {logic valid; CHIDatFlit bits; } response; }
    _GEN_32 =
    '{request: _transaction_slots_write_data_out,
      response: _completion_router_read_response_out};
  Queue dbid_responses (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_GEN_26),
    .egress_in   (_fork_stage_ingress_out),
    .ingress_out (_dbid_responses_ingress_out),
    .egress_out  (_dbid_responses_egress_out),
    .count       (/* unused */)
  );
  Queue_1 read_operations (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_GEN_27),
    .egress_in   (_operation_arbiter_ingress_0_out),
    .ingress_out (_read_operations_ingress_out),
    .egress_out  (_read_operations_egress_out),
    .count       (/* unused */)
  );
  Queue_1 write_operations (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_GEN_25),
    .egress_in   (_operation_arbiter_ingress_1_out),
    .ingress_out (_write_operations_ingress_out),
    .egress_out  (_write_operations_egress_out),
    .count       (/* unused */)
  );
  RRArbiter operation_arbiter (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (_read_operations_egress_out),
    .ingress_1_in  (_write_operations_egress_out),
    .egress_in     (_memory_operations_request_out),
    .ingress_0_out (_operation_arbiter_ingress_0_out),
    .ingress_1_out (_operation_arbiter_ingress_1_out),
    .egress_out    (_operation_arbiter_egress_out),
    .chosen        (/* unused */)
  );
  CompletionQueue memory_operations (
    .clock         (clock),
    .reset         (reset),
    .request_in    (_operation_arbiter_egress_out),
    .completion_in (_GEN_23),
    .response_in   (_completion_router_ingress_out),
    .request_out   (_memory_operations_request_out),
    .issue_out     (_memory_operations_issue_out),
    .response_out  (_memory_operations_response_out)
  );
  SyncRam1RW storage (
    .clock    (clock),
    .reset    (reset),
    .port_in  (_GEN_31),
    .port_out (_storage_port_out)
  );
  CHIRamCompletionRouter completion_router (
    .node_id            (identity.node_id),
    .ingress_in         (_memory_operations_response_out),
    .read_response_in   (port_in.dat.response),
    .write_response_in  (_response_arbiter_ingress_1_out),
    .ingress_out        (_completion_router_ingress_out),
    .read_response_out  (_completion_router_read_response_out),
    .write_response_out (_completion_router_write_response_out),
    .completed_out      (_completion_router_completed_out)
  );
  RRArbiter_1 response_arbiter (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (_fork_stage_egress_0_out),
    .ingress_1_in  (_completion_router_write_response_out),
    .egress_in     (port_in.rsp),
    .ingress_0_out (_response_arbiter_ingress_0_out),
    .ingress_1_out (_response_arbiter_ingress_1_out),
    .egress_out    (_response_arbiter_egress_out),
    .chosen        (/* unused */)
  );
  CHISNTransactionSlots transaction_slots (
    .clock             (clock),
    .reset             (reset),
    .allocation_in     (_GEN_29),
    .allocated_in      (_GEN_28),
    .dbid_sent_in      (_GEN_22),
    .write_data_in     (port_in.dat.request),
    .matched_write_in  (_write_operations_ingress_out),
    .completed_in      (_completion_router_completed_out),
    .allocation_out    (_transaction_slots_allocation_out),
    .allocated_out     (_transaction_slots_allocated_out),
    .write_data_out    (_transaction_slots_write_data_out),
    .matched_write_out (_transaction_slots_matched_write_out)
  );
  ValidPipe valid_pipe_stage (
    .clock      (clock),
    .reset      (reset),
    .ingress_in (_memory_operations_issue_out),
    .egress_out (_valid_pipe_stage_egress_out)
  );
  AtomicFork fork_stage (
    .ingress_in   (_dbid_responses_egress_out),
    .egress_0_in  (_response_arbiter_ingress_0_out),
    .egress_1_in  (_GEN_2),
    .ingress_out  (_fork_stage_ingress_out),
    .egress_0_out (_fork_stage_egress_0_out),
    .egress_1_out (_fork_stage_egress_1_out)
  );
  assign port_out = '{rsp: _response_arbiter_egress_out, req: _GEN_30, dat: _GEN_32};
endmodule

module Queue(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; CHIRspFlit bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; CHIRspFlit bits; } egress_out,
  output [1:0]                                          count
);

  wire CHIRspFlit _GEN;
  wire            _GEN_0;
  wire            _write_pointer_value;
  wire            _read_pointer_value;
  wire            _GEN_1 = 1'h0;
  CHIRspFlit      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]      occupancy;
  wire            _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire            _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire            _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module Counter(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule

module Queue_1(
  input                                                            clock,
                                                                   reset,
  input  struct packed {logic valid; CHIRamMemoryOperation bits; } ingress_in,
  input  struct packed {logic ready; }                             egress_in,
  output struct packed {logic ready; }                             ingress_out,
  output struct packed {logic valid; CHIRamMemoryOperation bits; } egress_out,
  output [1:0]                                                     count
);

  wire CHIRamMemoryOperation _GEN;
  wire                       _GEN_0;
  wire                       _write_pointer_value;
  wire                       _read_pointer_value;
  wire                       _GEN_1 = 1'h0;
  CHIRamMemoryOperation      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]                 occupancy;
  wire                       _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire                       _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire                       _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module RRArbiter(
  input                                                            clock,
                                                                   reset,
  input  struct packed {logic valid; CHIRamMemoryOperation bits; } ingress_0_in,
                                                                   ingress_1_in,
  input  struct packed {logic ready; }                             egress_in,
  output struct packed {logic ready; }                             ingress_0_out,
                                                                   ingress_1_out,
  output struct packed {logic valid; CHIRamMemoryOperation bits; } egress_out,
  output                                                           chosen
);

  reg                        next_priority;
  wire [1:0]                 _GEN =
    {{ingress_1_in.valid}, {ingress_0_in.valid & ~next_priority}};
  wire [1:0]                 _GEN_0 = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0]                 _GEN_1 =
    (|_GEN) ? _GEN & {~(_GEN[0]), 1'h1} : _GEN_0 & {~(_GEN_0[0]), 1'h1};
  wire                       _GEN_2 = |_GEN_1;
  wire [282:0]               _GEN_3 = /*cast(bit[282:0])*/ingress_0_in.bits;
  wire [282:0]               _GEN_4 = /*cast(bit[282:0])*/ingress_1_in.bits;
  wire CHIRamMemoryOperation _GEN_5 =
    /*cast(bit)*/_GEN_3 & {283{_GEN_1[0]}} | _GEN_4 & {283{_GEN_1[1]}} | _GEN_3
    & {283{_GEN_1 == 2'h0}};
  always @(posedge clock) begin
    if (reset)
      next_priority <= 1'h0;
    else
      next_priority <=
        _GEN_2 & egress_in.ready ? ~(_GEN_1[1]) & _GEN_1[1] - 1'h1 : next_priority;
  end // always @(posedge)
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_1[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_1[1])};
  assign egress_out = '{valid: _GEN_2, bits: _GEN_5};
  assign chosen = _GEN_1[1];
endmodule

module CompletionQueue(
  input                                                             clock,
                                                                    reset,
  input  struct packed {logic valid; CHIRamMemoryOperation bits; }  request_in,
  input  struct packed {logic valid; CHIRamMemoryCompletion bits; } completion_in,
  input  struct packed {logic ready; }                              response_in,
  output struct packed {logic ready; }                              request_out,
  output struct packed {logic valid; CHIRamMemoryOperation bits; }  issue_out,
  output struct packed {logic valid; CHIRamMemoryCompletion bits; } response_out
);

  wire struct packed {logic ready; } _completed_ingress_out;
  wire struct packed {logic valid; CHIRamMemoryCompletion bits; } _completed_egress_out;
  wire [1:0]                         _completed_count;
  reg  [1:0]                         outstanding;
  wire                               _GEN =
    _completed_egress_out.valid & response_in.ready;
  wire                               _GEN_0 = ~(outstanding[1]) | _GEN;
  wire                               _GEN_1 = request_in.valid & _GEN_0;
  `ifndef SYNTHESIS
    completion_queue_completion_has_request:
      assert property (@(posedge clock) disable iff (reset)
                         {1'h0, outstanding} + {2'h0, _GEN_1} >= {1'h0, _completed_count}
                         + {2'h0, completion_in.valid});
  `endif // not def SYNTHESIS
  wire                               _GEN_2 = ~(completion_in.valid & ~reset);
  `ifndef SYNTHESIS
    completion_queue_slot_reserved:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         _completed_ingress_out.ready);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    completion_queue_reservations_in_range:
      assert property (@(posedge clock) disable iff (reset) outstanding != 2'h3);
  `endif // not def SYNTHESIS
  Queue_2 completed (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (completion_in),
    .egress_in   (response_in),
    .ingress_out (_completed_ingress_out),
    .egress_out  (_completed_egress_out),
    .count       (_completed_count)
  );
  always @(posedge clock) begin
    if (reset)
      outstanding <= 2'h0;
    else
      outstanding <=
        _GEN_1 ^ _GEN ? (_GEN_1 ? outstanding + 2'h1 : outstanding - 2'h1) : outstanding;
  end // always @(posedge)
  assign request_out = '{ready: _GEN_0};
  assign issue_out = '{valid: _GEN_1, bits: request_in.bits};
  assign response_out = _completed_egress_out;
endmodule

module Queue_2(
  input                                                             clock,
                                                                    reset,
  input  struct packed {logic valid; CHIRamMemoryCompletion bits; } ingress_in,
  input  struct packed {logic ready; }                              egress_in,
  output struct packed {logic ready; }                              ingress_out,
  output struct packed {logic valid; CHIRamMemoryCompletion bits; } egress_out,
  output [1:0]                                                      count
);

  wire CHIRamMemoryCompletion _GEN;
  wire                        _GEN_0;
  wire                        _write_pointer_value;
  wire                        _read_pointer_value;
  wire                        _GEN_1 = 1'h0;
  CHIRamMemoryCompletion      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]                  occupancy;
  wire                        _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire                        _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire                        _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module storage_4x128(
  input  [1:0]   RW0_addr,
  input          RW0_en,
                 RW0_clk,
                 RW0_wmode,
  input  [127:0] RW0_wdata,
  output [127:0] RW0_rdata,
  input  [15:0]  RW0_wmask
);

  reg  [127:0] Memory[0:3];
  reg  [1:0]   _RW0_raddr_d0;
  reg          _RW0_ren_d0;
  reg          _RW0_rmode_d0;
  always @(posedge RW0_clk) begin
    _RW0_raddr_d0 <= RW0_addr;
    _RW0_ren_d0 <= RW0_en;
    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [127:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 128'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[0] & RW0_wmode)
      Memory[RW0_addr][32'h0 +: 8] <= RW0_wdata[7:0];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[1] & RW0_wmode)
      Memory[RW0_addr][32'h8 +: 8] <= RW0_wdata[15:8];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[2] & RW0_wmode)
      Memory[RW0_addr][32'h10 +: 8] <= RW0_wdata[23:16];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[3] & RW0_wmode)
      Memory[RW0_addr][32'h18 +: 8] <= RW0_wdata[31:24];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[4] & RW0_wmode)
      Memory[RW0_addr][32'h20 +: 8] <= RW0_wdata[39:32];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[5] & RW0_wmode)
      Memory[RW0_addr][32'h28 +: 8] <= RW0_wdata[47:40];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[6] & RW0_wmode)
      Memory[RW0_addr][32'h30 +: 8] <= RW0_wdata[55:48];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[7] & RW0_wmode)
      Memory[RW0_addr][32'h38 +: 8] <= RW0_wdata[63:56];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[8] & RW0_wmode)
      Memory[RW0_addr][32'h40 +: 8] <= RW0_wdata[71:64];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[9] & RW0_wmode)
      Memory[RW0_addr][32'h48 +: 8] <= RW0_wdata[79:72];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[10] & RW0_wmode)
      Memory[RW0_addr][32'h50 +: 8] <= RW0_wdata[87:80];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[11] & RW0_wmode)
      Memory[RW0_addr][32'h58 +: 8] <= RW0_wdata[95:88];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[12] & RW0_wmode)
      Memory[RW0_addr][32'h60 +: 8] <= RW0_wdata[103:96];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[13] & RW0_wmode)
      Memory[RW0_addr][32'h68 +: 8] <= RW0_wdata[111:104];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[14] & RW0_wmode)
      Memory[RW0_addr][32'h70 +: 8] <= RW0_wdata[119:112];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[15] & RW0_wmode)
      Memory[RW0_addr][32'h78 +: 8] <= RW0_wdata[127:120];
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

module SyncRam1RW(
  input                                                                                   clock,
                                                                                          reset,
  input  struct packed {struct packed {logic valid; ReadWriteRequest bits; } request; }   port_in,
  output struct packed {struct packed {logic valid; logic [15:0][7:0] bits; } response; } port_out
);

  wire [15:0]      _GEN;
  wire [15:0][7:0] _GEN_0;
  wire             _GEN_1;
  wire             _GEN_2;
  wire [1:0]       _GEN_3;
  wire [127:0]     _GEN_4;
  wire [127:0]     _storage_ext_RW0_rdata;
  storage_4x128 storage_ext (
    .RW0_addr  (_GEN_3),
    .RW0_en    (_GEN_2),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_1),
    .RW0_wdata (_GEN_4),
    .RW0_rdata (_storage_ext_RW0_rdata),
    .RW0_wmask (_GEN)
  );
  assign _GEN_4 = /*cast(bit[127:0])*/_GEN_0;
  wire [15:0][7:0] _GEN_5 = /*cast(bit[15:0][7:0])*/_storage_ext_RW0_rdata;
  reg              response_valid;
  assign _GEN_3 = port_in.request.bits.address;
  assign _GEN_2 = port_in.request.valid;
  assign _GEN_1 = port_in.request.bits.write;
  assign _GEN_0 = port_in.request.bits.data;
  assign _GEN = port_in.request.bits.mask;
  wire struct packed {logic valid; logic [15:0][7:0] bits; } _GEN_6 =
    '{valid: response_valid, bits: _GEN_5};
  always @(posedge clock) begin
    if (reset)
      response_valid <= 1'h0;
    else
      response_valid <= _GEN_2 & ~_GEN_1;
  end // always @(posedge)
  assign port_out = '{response: _GEN_6};
endmodule

module CHIRamCompletionRouter(
  input  [6:0]                                                      node_id,
  input  struct packed {logic valid; CHIRamMemoryCompletion bits; } ingress_in,
  input  struct packed {logic ready; }                              read_response_in,
                                                                    write_response_in,
  output struct packed {logic ready; }                              ingress_out,
  output struct packed {logic valid; CHIDatFlit bits; }             read_response_out,
  output struct packed {logic valid; CHIRspFlit bits; }             write_response_out,
  output struct packed {logic valid; logic bits; }                  completed_out
);

  wire            _GEN =
    ingress_in.bits.memory_operation.write
      ? write_response_in.ready
      : read_response_in.ready;
  wire CHIRspFlit _GEN_0 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: {11'h0, ingress_in.bits.memory_operation.slot},
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (5'h4),
      txn_id: ingress_in.bits.memory_operation.request.txn_id,
      src_id: node_id,
      tgt_id: ingress_in.bits.memory_operation.request.src_id,
      qos: ingress_in.bits.memory_operation.request.qos};
  wire CHIDatFlit _GEN_1 =
    '{data: ingress_in.bits.data,
      byte_enable:
        ((ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h0
            ? 16'h1
            : ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h1
                ? 16'h3
                : ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h2
                    ? 16'hF
                    : ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h3
                        ? 16'hFF
                        : {16{ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h4}})
         << ingress_in.bits.memory_operation.request.address[3:0]),
      replicate: (1'h0),
      num_dat: (2'h0),
      cah: (1'h0),
      trace_tag: (1'h0),
      tag_update: (1'h0),
      tag: (4'h0),
      tag_op: (2'h0),
      cache_line_id: (6'h0),
      data_id: (2'h0),
      ccid: (2'h0),
      dbid_or_mecid: (16'h0),
      c_busy: (3'h0),
      data_pull: (1'h0),
      data_source_or_fwd_state: (8'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (4'h4),
      home_nid_or_pbha_or_mismatched_mecid: node_id,
      txn_id: ingress_in.bits.memory_operation.request.return_txn_id_or_stash_lpid,
      src_id: node_id,
      tgt_id:
        ingress_in.bits.memory_operation.request.return_nid_or_stash_nid_or_data_target,
      qos: ingress_in.bits.memory_operation.request.qos};
  assign ingress_out = '{ready: _GEN};
  assign read_response_out =
    '{valid: (ingress_in.valid & ~ingress_in.bits.memory_operation.write), bits: _GEN_1};
  assign write_response_out =
    '{valid: (ingress_in.valid & ingress_in.bits.memory_operation.write), bits: _GEN_0};
  assign completed_out =
    '{valid: (ingress_in.valid & _GEN), bits: ingress_in.bits.memory_operation.slot};
endmodule

module RRArbiter_1(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; CHIRspFlit bits; } ingress_0_in,
                                                        ingress_1_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
  output struct packed {logic valid; CHIRspFlit bits; } egress_out,
  output                                                chosen
);

  reg             next_priority;
  wire [1:0]      _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid & ~next_priority}};
  wire [1:0]      _GEN_0 = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0]      _GEN_1 =
    (|_GEN) ? _GEN & {~(_GEN[0]), 1'h1} : _GEN_0 & {~(_GEN_0[0]), 1'h1};
  wire            _GEN_2 = |_GEN_1;
  wire [70:0]     _GEN_3 = /*cast(bit[70:0])*/ingress_0_in.bits;
  wire [70:0]     _GEN_4 = /*cast(bit[70:0])*/ingress_1_in.bits;
  wire CHIRspFlit _GEN_5 =
    /*cast(bit)*/_GEN_3 & {71{_GEN_1[0]}} | _GEN_4 & {71{_GEN_1[1]}} | _GEN_3
    & {71{_GEN_1 == 2'h0}};
  always @(posedge clock) begin
    if (reset)
      next_priority <= 1'h0;
    else
      next_priority <=
        _GEN_2 & egress_in.ready ? ~(_GEN_1[1]) & _GEN_1[1] - 1'h1 : next_priority;
  end // always @(posedge)
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_1[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_1[1])};
  assign egress_out = '{valid: _GEN_2, bits: _GEN_5};
  assign chosen = _GEN_1[1];
endmodule

module CHISNTransactionSlots(
  input                                                                 clock,
                                                                        reset,
  input  struct packed {logic valid; CHISNTransactionAllocation bits; } allocation_in,
  input  struct packed {logic ready; }                                  allocated_in,
  input  struct packed {logic valid; logic bits; }                      dbid_sent_in,
  input  struct packed {logic valid; CHIDatFlit bits; }                 write_data_in,
  input  struct packed {logic ready; }                                  matched_write_in,
  input  struct packed {logic valid; logic bits; }                      completed_in,
  output struct packed {logic ready; }                                  allocation_out,
  output struct packed {logic valid; CHISNAllocatedTransaction bits; }  allocated_out,
  output struct packed {logic ready; }                                  write_data_out,
  output struct packed {logic valid; CHISNMatchedWrite bits; }          matched_write_out
);

  wire                           _GEN;
  wire CHIReqFlit                _GEN_0;
  wire                           _GEN_1;
  wire [1:0]                     _awaiting_write_data_busy;
  wire [1:0]                     _occupancy_busy;
  wire                           _GEN_2 = 1'h0;
  wire [1:0]                     _GEN_3 = _occupancy_busy;
  wire [1:0]                     _GEN_4 = _awaiting_write_data_busy;
  CHIReqFlit                     write_requests[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_2) begin
    end
    else begin
      if (_GEN)
        write_requests[_GEN_1] <= _GEN_0;
    end
  end // always_ff @(posedge)
  wire [1:0]                     _GEN_5 = {{~_GEN_3[1'h1]}, {~_GEN_3[_GEN_2]}};
  wire                           _GEN_6 = |_GEN_5;
  assign _GEN_1 = _GEN_5[1] & ~(_GEN_5[0]);
  wire                           _GEN_7 = allocation_in.valid & _GEN_6;
  assign _GEN_0 = allocation_in.bits.request;
  wire CHISNAllocatedTransaction _GEN_8 =
    '{slot: _GEN_1, write: allocation_in.bits.write, request: _GEN_0};
  wire                           _GEN_9 = |write_data_in.bits.opcode;
  wire                           _GEN_10 =
    write_data_in.bits.txn_id < 12'h2 & _GEN_3[write_data_in.bits.txn_id[0]]
    & _GEN_4[write_data_in.bits.txn_id[0]]
    & write_data_in.bits.src_id == write_requests[write_data_in.bits.txn_id[0]].src_id;
  wire                           _GEN_11 = write_data_in.valid & _GEN_9 & _GEN_10;
  wire CHISNMatchedWrite         _GEN_12 =
    '{slot: (write_data_in.bits.txn_id[0]),
      request: write_requests[write_data_in.bits.txn_id[0]],
      data: write_data_in.bits};
  wire                           _GEN_13 = ~(write_data_in.valid & _GEN_9 & ~reset);
  `ifndef SYNTHESIS
    chi_sn_transaction_slot_write_data_has_transaction:
      assert property (@(posedge clock) disable iff (_GEN_13) _GEN_10);
  `endif // not def SYNTHESIS
  wire                           _GEN_14 = _GEN_7 & allocated_in.ready;
  assign _GEN = _GEN_14 & allocation_in.bits.write;
  wire                           _GEN_15 = ~(_GEN_4[_GEN_2] & ~reset);
  `ifndef SYNTHESIS
    chi_sn_transaction_slot_write_is_occupied:
      assert property (@(posedge clock) disable iff (_GEN_15) _GEN_3[_GEN_2]);
  `endif // not def SYNTHESIS
  wire                           _GEN_16 = ~(_GEN_4[1'h1] & ~reset);
  `ifndef SYNTHESIS
    chi_sn_transaction_slot_write_is_occupied_0:
      assert property (@(posedge clock) disable iff (_GEN_16) _GEN_3[1'h1]);
  `endif // not def SYNTHESIS
  wire struct packed {logic valid; logic bits; } _GEN_17 =
    '{valid: (_GEN_11 & matched_write_in.ready), bits: (write_data_in.bits.txn_id[0])};
  wire struct packed {logic valid; logic bits; } _GEN_18 =
    '{valid: _GEN_14, bits: _GEN_1};
  Scoreboard occupancy (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_18),
    .clear_in (completed_in),
    .busy     (_occupancy_busy)
  );
  Scoreboard awaiting_write_data (
    .clock    (clock),
    .reset    (reset),
    .set_in   (dbid_sent_in),
    .clear_in (_GEN_17),
    .busy     (_awaiting_write_data_busy)
  );
  assign allocation_out = '{ready: (_GEN_6 & allocated_in.ready)};
  assign allocated_out = '{valid: _GEN_7, bits: _GEN_8};
  assign write_data_out = '{ready: (~_GEN_9 | ~_GEN_10 | matched_write_in.ready)};
  assign matched_write_out = '{valid: _GEN_11, bits: _GEN_12};
endmodule

module Scoreboard(
  input                                            clock,
                                                   reset,
  input  struct packed {logic valid; logic bits; } set_in,
                                                   clear_in,
  output [1:0]                                     busy
);

  reg  [1:0] state;
  wire [1:0] _GEN = 2'h1 << set_in.bits;
  wire [1:0] _GEN_0 = 2'h1 << clear_in.bits;
  wire       _GEN_1 = ~(set_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_set_free:
      assert property (@(posedge clock) disable iff (_GEN_1)
                         (state & _GEN) == 2'h0 | clear_in.valid
                         & clear_in.bits == set_in.bits);
  `endif // not def SYNTHESIS
  wire       _GEN_2 = ~(clear_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_clear_busy:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         (|(state & _GEN_0)) | set_in.valid
                         & set_in.bits == clear_in.bits);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 2'h0;
    else
      state <=
        set_in.valid | clear_in.valid
          ? (state | (set_in.valid ? _GEN : 2'h0)) & ~(clear_in.valid ? _GEN_0 : 2'h0)
          : state;
  end // always @(posedge)
  assign busy = state;
endmodule

module ValidPipe(
  input                                                            clock,
                                                                   reset,
  input  struct packed {logic valid; CHIRamMemoryOperation bits; } ingress_in,
  output struct packed {logic valid; CHIRamMemoryOperation bits; } egress_out
);

  reg  [0:0]                      stage_valid;
  CHIRamMemoryOperation[0:0]      stage_bits;
  wire CHIRamMemoryOperation      _GEN =
    ingress_in.valid ? ingress_in.bits : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= ingress_in.valid;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN;
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module AtomicFork(
  input  struct packed {logic valid; CHIRspFlit bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; CHIRspFlit bits; } egress_0_out,
                                                        egress_1_out
);

  assign ingress_out = '{ready: (egress_0_in.ready & egress_1_in.ready)};
  assign egress_0_out =
    '{valid: (ingress_in.valid & egress_1_in.ready), bits: ingress_in.bits};
  assign egress_1_out =
    '{valid: (ingress_in.valid & egress_0_in.ready), bits: ingress_in.bits};
endmodule
}>>|

export:
  ram_flit
  ram_config
  ram_params
  ram_design
  ram_verilog_reference
