                         | _response_data_transmitter_link_out.bits.opcode == 4'h2
                         | _response_data_transmitter_link_out.bits.opcode == 4'h3
                         | _GEN_36
                         | _response_data_transmitter_link_out.bits.opcode == 4'h5
                         | _response_data_transmitter_link_out.bits.opcode == 4'h6
                         | _response_data_transmitter_link_out.bits.opcode == 4'h7
                         | _response_data_transmitter_link_out.bits.opcode == 4'hB
