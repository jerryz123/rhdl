    end
  end // always_ff @(posedge)
  reg  [1:0]                  occupancy;
  wire                        _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire                        _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire                        _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter_5 read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter_5 write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module Counter_5(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule

module storage_4x128(
  input  [1:0]   RW0_addr,
  input          RW0_en,
                 RW0_clk,
                 RW0_wmode,
  input  [127:0] RW0_wdata,
  output [127:0] RW0_rdata,
  input  [15:0]  RW0_wmask
);

  reg  [127:0] Memory[0:3];
  reg  [1:0]   _RW0_raddr_d0;
  reg          _RW0_ren_d0;
  reg          _RW0_rmode_d0;
  always @(posedge RW0_clk) begin
    _RW0_raddr_d0 <= RW0_addr;
    _RW0_ren_d0 <= RW0_en;
    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [127:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 128'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[0] & RW0_wmode)
      Memory[RW0_addr][32'h0 +: 8] <= RW0_wdata[7:0];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[1] & RW0_wmode)
      Memory[RW0_addr][32'h8 +: 8] <= RW0_wdata[15:8];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[2] & RW0_wmode)
      Memory[RW0_addr][32'h10 +: 8] <= RW0_wdata[23:16];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[3] & RW0_wmode)
      Memory[RW0_addr][32'h18 +: 8] <= RW0_wdata[31:24];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[4] & RW0_wmode)
      Memory[RW0_addr][32'h20 +: 8] <= RW0_wdata[39:32];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[5] & RW0_wmode)
      Memory[RW0_addr][32'h28 +: 8] <= RW0_wdata[47:40];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[6] & RW0_wmode)
      Memory[RW0_addr][32'h30 +: 8] <= RW0_wdata[55:48];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[7] & RW0_wmode)
      Memory[RW0_addr][32'h38 +: 8] <= RW0_wdata[63:56];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[8] & RW0_wmode)
      Memory[RW0_addr][32'h40 +: 8] <= RW0_wdata[71:64];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[9] & RW0_wmode)
      Memory[RW0_addr][32'h48 +: 8] <= RW0_wdata[79:72];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[10] & RW0_wmode)
      Memory[RW0_addr][32'h50 +: 8] <= RW0_wdata[87:80];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[11] & RW0_wmode)
      Memory[RW0_addr][32'h58 +: 8] <= RW0_wdata[95:88];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[12] & RW0_wmode)
      Memory[RW0_addr][32'h60 +: 8] <= RW0_wdata[103:96];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[13] & RW0_wmode)
      Memory[RW0_addr][32'h68 +: 8] <= RW0_wdata[111:104];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[14] & RW0_wmode)
      Memory[RW0_addr][32'h70 +: 8] <= RW0_wdata[119:112];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[15] & RW0_wmode)
      Memory[RW0_addr][32'h78 +: 8] <= RW0_wdata[127:120];
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

module SyncRam1RW(
  input                                                                                   clock,
                                                                                          reset,
  input  struct packed {struct packed {logic valid; ReadWriteRequest bits; } request; }   port_in,
  output struct packed {struct packed {logic valid; logic [15:0][7:0] bits; } response; } port_out
);

  wire [15:0]      _GEN;
  wire [15:0][7:0] _GEN_0;
  wire             _GEN_1;
  wire             _GEN_2;
  wire [1:0]       _GEN_3;
  wire [127:0]     _GEN_4;
  wire [127:0]     _storage_ext_RW0_rdata;
  storage_4x128 storage_ext (
    .RW0_addr  (_GEN_3),
    .RW0_en    (_GEN_2),
    .RW0_clk   (clock),
    .RW0_wmode (_GEN_1),
    .RW0_wdata (_GEN_4),
    .RW0_rdata (_storage_ext_RW0_rdata),
    .RW0_wmask (_GEN)
  );
  assign _GEN_4 = /*cast(bit[127:0])*/_GEN_0;
  wire [15:0][7:0] _GEN_5 = /*cast(bit[15:0][7:0])*/_storage_ext_RW0_rdata;
  reg              response_valid;
  assign _GEN_3 = port_in.request.bits.address;
  assign _GEN_2 = port_in.request.valid;
  assign _GEN_1 = port_in.request.bits.write;
  assign _GEN_0 = port_in.request.bits.data;
  assign _GEN = port_in.request.bits.mask;
  wire struct packed {logic valid; logic [15:0][7:0] bits; } _GEN_6 =
    '{valid: response_valid, bits: _GEN_5};
  always @(posedge clock) begin
    if (reset)
      response_valid <= 1'h0;
    else
      response_valid <= _GEN_2 & ~_GEN_1;
  end // always @(posedge)
  assign port_out = '{response: _GEN_6};
endmodule

module CHIRamCompletionRouter(
  input  struct packed {logic valid; CHIRamMemoryCompletion bits; } ingress_in,
  input  struct packed {logic ready; }                              read_response_in,
                                                                    write_response_in,
  output struct packed {logic ready; }                              ingress_out,
  output struct packed {logic valid; CHIDatFlit bits; }             read_response_out,
  output struct packed {logic valid; CHIRspFlit bits; }             write_response_out,
  output struct packed {logic valid; logic bits; }                  completed_out
);

  wire CHIDatFlit _GEN;
  wire            _GEN_0 =
    ingress_in.bits.memory_operation.write
      ? write_response_in.ready
      : read_response_in.ready;
  wire CHIRspFlit _GEN_1 =
    '{cache_line_id: (6'h0),
      trace_tag: (1'h0),
      tag_op: (2'h0),
      pcrd_type: (4'h0),
      dbid_or_group_id: {11'h0, ingress_in.bits.memory_operation.slot},
      c_busy: (3'h0),
      fwd_state_or_data_pull: (3'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (5'h4),
      txn_id: ingress_in.bits.memory_operation.request.txn_id,
      src_id: (7'h9),
      tgt_id: ingress_in.bits.memory_operation.request.src_id,
      qos: ingress_in.bits.memory_operation.request.qos};
  assign _GEN =
    '{data: ingress_in.bits.data,
      byte_enable:
        ((ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h0
            ? 16'h1
            : ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h1
                ? 16'h3
                : ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h2
                    ? 16'hF
                    : ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h3
                        ? 16'hFF
                        : {16{ingress_in.bits.memory_operation.request.size_or_num_req[2:0] == 3'h4}})
         << ingress_in.bits.memory_operation.request.address[3:0]),
      replicate: (1'h0),
      num_dat: (2'h0),
      cah: (1'h0),
      trace_tag: (1'h0),
      tag_update: (1'h0),
      tag: (4'h0),
      tag_op: (2'h0),
      cache_line_id: (6'h0),
      data_id: (2'h0),
      ccid: (2'h0),
      dbid_or_mecid: (16'h0),
      c_busy: (3'h0),
      data_pull: (1'h0),
      data_source_or_fwd_state: (8'h0),
      resp: (3'h0),
      resp_err: (2'h0),
      opcode: (4'h4),
      home_nid_or_pbha_or_mismatched_mecid: (7'h9),
      txn_id: ingress_in.bits.memory_operation.request.return_txn_id_or_stash_lpid,
      src_id: (7'h9),
      tgt_id:
        ingress_in.bits.memory_operation.request.return_nid_or_stash_nid_or_data_target,
      qos: ingress_in.bits.memory_operation.request.qos};
  assign ingress_out = '{ready: _GEN_0};
  assign read_response_out =
    '{valid: (ingress_in.valid & ~ingress_in.bits.memory_operation.write), bits: _GEN};
  assign write_response_out =
    '{valid: (ingress_in.valid & ingress_in.bits.memory_operation.write), bits: _GEN_1};
  assign completed_out =
    '{valid: (ingress_in.valid & _GEN_0), bits: ingress_in.bits.memory_operation.slot};
endmodule

module RRArbiter_1(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; CHIRspFlit bits; } ingress_0_in,
                                                        ingress_1_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
  output struct packed {logic valid; CHIRspFlit bits; } egress_out,
  output                                                chosen
);

  wire [1:0][0:0] _matcher_grants;
  wire [1:0]      _GEN = {{_matcher_grants[1'h1][1'h0]}, {_matcher_grants[1'h0][1'h0]}};
  RoundRobinMatcher_1 matcher (
    .clock    (clock),
    .reset    (reset),
    .requests ({{{1{ingress_1_in.valid}}}, {{1{ingress_0_in.valid}}}}),
    .accepts  ({1{egress_in.ready}}),
    .grants   (_matcher_grants)
  );
  assign ingress_0_out = '{ready: (egress_in.ready & _matcher_grants[1'h0][1'h0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _matcher_grants[1'h1][1'h0])};
  assign egress_out =
    '{valid: (|_GEN),
      bits: (_matcher_grants[1'h1][1'h0] ? ingress_1_in.bits : ingress_0_in.bits)};
  assign chosen = _GEN[1] & ~(_GEN[0]);
endmodule

module RoundRobinMatcher_1(
  input             clock,
                    reset,
  input  [1:0][0:0] requests,
  input  [0:0]      accepts,
  output [1:0][0:0] grants
);

  reg  [0:0]      next_priorities;
  wire            _GEN = requests[1'h1][1'h0] & ~requests[1'h0][1'h0];
  wire            _GEN_0 = requests[1'h0][1'h0] & ~requests[1'h1][1'h0];
  wire [1:0][1:0] _GEN_1 =
    {{{{requests[1'h1][1'h0]}, {_GEN_0}}}, {{{_GEN}, {requests[1'h0][1'h0]}}}};
  wire [1:0]      _GEN_2 = {{_GEN_0}, {requests[1'h0][1'h0]}};
  wire [1:0]      _GEN_3 = {{requests[1'h1][1'h0]}, {_GEN}};
  wire [1:0]      _GEN_4 = _GEN_1[next_priorities[1'h0]];
  wire            _GEN_5 = _GEN_4[1] & ~(_GEN_4[0]);
  wire            _GEN_6 =
    (|_GEN_4) & accepts[1'h0] ? ~_GEN_5 & _GEN_5 - 1'h1 : next_priorities[1'h0];
  always @(posedge clock) begin
    if (reset)
      next_priorities <= '{1'h0};
    else
      next_priorities[1'h0] <= _GEN_6;
  end // always @(posedge)
  assign grants =
    {{{1{_GEN_3[next_priorities[1'h0]]}}}, {{1{_GEN_2[next_priorities[1'h0]]}}}};
endmodule

module CHISNTransactionSlots(
  input                                                                 clock,
                                                                        reset,
  input  struct packed {logic valid; CHISNTransactionAllocation bits; } allocation_in,
  input  struct packed {logic ready; }                                  allocated_in,
  input  struct packed {logic valid; logic bits; }                      dbid_sent_in,
  input  struct packed {logic valid; CHIDatFlit bits; }                 write_data_in,
  input  struct packed {logic ready; }                                  matched_write_in,
  input  struct packed {logic valid; logic bits; }                      completed_in,
  output struct packed {logic ready; }                                  allocation_out,
  output struct packed {logic valid; CHISNAllocatedTransaction bits; }  allocated_out,
  output struct packed {logic ready; }                                  write_data_out,
  output struct packed {logic valid; CHISNMatchedWrite bits; }          matched_write_out
);

  wire                           _GEN;
  wire CHIReqFlit                _GEN_0;
  wire                           _GEN_1;
  wire [1:0]                     _awaiting_write_data_busy;
  wire [1:0]                     _occupancy_busy;
  wire                           _GEN_2 = 1'h0;
  wire [1:0]                     _GEN_3 = _occupancy_busy;
  wire [1:0]                     _GEN_4 = _awaiting_write_data_busy;
  CHIReqFlit                     write_requests[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_2) begin
    end
    else begin
      if (_GEN)
        write_requests[_GEN_1] <= _GEN_0;
    end
  end // always_ff @(posedge)
  wire [1:0]                     _GEN_5 = {{~_GEN_3[1'h1]}, {~_GEN_3[_GEN_2]}};
  wire                           _GEN_6 = |_GEN_5;
  assign _GEN_1 = _GEN_5[1] & ~(_GEN_5[0]);
  wire                           _GEN_7 = allocation_in.valid & _GEN_6;
  assign _GEN_0 = allocation_in.bits.request;
  wire CHISNAllocatedTransaction _GEN_8 =
    '{slot: _GEN_1, write: allocation_in.bits.write, request: _GEN_0};
  wire                           _GEN_9 = |write_data_in.bits.opcode;
  wire                           _GEN_10 =
    write_data_in.bits.txn_id < 12'h2 & _GEN_3[write_data_in.bits.txn_id[0]]
    & _GEN_4[write_data_in.bits.txn_id[0]]
    & write_data_in.bits.src_id == write_requests[write_data_in.bits.txn_id[0]].src_id;
  wire                           _GEN_11 = write_data_in.valid & _GEN_9 & _GEN_10;
  wire CHISNMatchedWrite         _GEN_12 =
    '{slot: (write_data_in.bits.txn_id[0]),
      request: write_requests[write_data_in.bits.txn_id[0]],
      data: write_data_in.bits};
  wire                           _GEN_13 = ~(write_data_in.valid & _GEN_9 & ~reset);
  `ifndef SYNTHESIS
    chi_sn_transaction_slot_write_data_has_transaction:
      assert property (@(posedge clock) disable iff (_GEN_13) _GEN_10);
  `endif // not def SYNTHESIS
  wire                           _GEN_14 = _GEN_7 & allocated_in.ready;
  assign _GEN = _GEN_14 & allocation_in.bits.write;
  wire                           _GEN_15 = ~(_GEN_4[_GEN_2] & ~reset);
  `ifndef SYNTHESIS
    chi_sn_transaction_slot_write_is_occupied:
      assert property (@(posedge clock) disable iff (_GEN_15) _GEN_3[_GEN_2]);
  `endif // not def SYNTHESIS
  wire                           _GEN_16 = ~(_GEN_4[1'h1] & ~reset);
  `ifndef SYNTHESIS
    chi_sn_transaction_slot_write_is_occupied_0:
      assert property (@(posedge clock) disable iff (_GEN_16) _GEN_3[1'h1]);
  `endif // not def SYNTHESIS
  wire struct packed {logic valid; logic bits; } _GEN_17 =
    '{valid: _GEN_14, bits: _GEN_1};
  wire struct packed {logic valid; logic bits; } _GEN_18 =
    '{valid: (_GEN_11 & matched_write_in.ready), bits: (write_data_in.bits.txn_id[0])};
  Scoreboard occupancy (
    .clock    (clock),
    .reset    (reset),
    .set_in   (_GEN_17),
    .clear_in (completed_in),
    .busy     (_occupancy_busy)
  );
  Scoreboard_1 awaiting_write_data (
    .clock    (clock),
    .reset    (reset),
    .set_in   (dbid_sent_in),
    .clear_in (_GEN_18),
    .busy     (_awaiting_write_data_busy)
  );
  assign allocation_out = '{ready: (_GEN_6 & allocated_in.ready)};
  assign allocated_out = '{valid: _GEN_7, bits: _GEN_8};
  assign write_data_out = '{ready: (~_GEN_9 | ~_GEN_10 | matched_write_in.ready)};
  assign matched_write_out = '{valid: _GEN_11, bits: _GEN_12};
endmodule

module Scoreboard(
  input                                            clock,
                                                   reset,
  input  struct packed {logic valid; logic bits; } set_in,
                                                   clear_in,
  output [1:0]                                     busy
);

  reg  [1:0] state;
  wire [1:0] _GEN = 2'h1 << set_in.bits;
  wire [1:0] _GEN_0 = 2'h1 << clear_in.bits;
  wire       _GEN_1 = ~(set_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_set_free:
      assert property (@(posedge clock) disable iff (_GEN_1)
                         (state & _GEN) == 2'h0 | clear_in.valid
                         & clear_in.bits == set_in.bits);
  `endif // not def SYNTHESIS
  wire       _GEN_2 = ~(clear_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_clear_busy:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         (|(state & _GEN_0)) | set_in.valid
                         & set_in.bits == clear_in.bits);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 2'h0;
    else
      state <=
        set_in.valid | clear_in.valid
          ? (state | (set_in.valid ? _GEN : 2'h0)) & ~(clear_in.valid ? _GEN_0 : 2'h0)
          : state;
  end // always @(posedge)
  assign busy = state;
endmodule

module Scoreboard_1(
  input                                            clock,
                                                   reset,
  input  struct packed {logic valid; logic bits; } set_in,
                                                   clear_in,
  output [1:0]                                     busy
);

  reg  [1:0] state;
  wire [1:0] _GEN = 2'h1 << set_in.bits;
  wire [1:0] _GEN_0 = 2'h1 << clear_in.bits;
  wire       _GEN_1 = ~(set_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_set_free:
      assert property (@(posedge clock) disable iff (_GEN_1)
                         (state & _GEN) == 2'h0 | clear_in.valid
                         & clear_in.bits == set_in.bits);
  `endif // not def SYNTHESIS
  wire       _GEN_2 = ~(clear_in.valid & ~reset);
  `ifndef SYNTHESIS
    scoreboard_clear_busy:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         (|(state & _GEN_0)) | set_in.valid
                         & set_in.bits == clear_in.bits);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 2'h0;
    else
      state <=
        set_in.valid | clear_in.valid
          ? (state | (set_in.valid ? _GEN : 2'h0)) & ~(clear_in.valid ? _GEN_0 : 2'h0)
          : state;
  end // always @(posedge)
  assign busy = state;
endmodule

module ValidPipe(
  input                                                            clock,
                                                                   reset,
  input  struct packed {logic valid; CHIRamMemoryOperation bits; } ingress_in,
  output struct packed {logic valid; CHIRamMemoryOperation bits; } egress_out
);

  reg  [0:0]                      stage_valid;
  CHIRamMemoryOperation[0:0]      stage_bits;
  wire CHIRamMemoryOperation      _GEN =
    ingress_in.valid ? ingress_in.bits : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= ingress_in.valid;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN;
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module AtomicFork(
  input  struct packed {logic valid; CHIRspFlit bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; CHIRspFlit bits; } egress_0_out,
                                                        egress_1_out
);

  wire _GEN = /*cast(bit)*/{1{egress_1_in.ready}};
  wire _GEN_0 = /*cast(bit)*/{1{egress_0_in.ready}};
  assign ingress_out = '{ready: (&({{egress_1_in.ready}, {egress_0_in.ready}}))};
  assign egress_0_out = '{valid: (ingress_in.valid & _GEN), bits: ingress_in.bits};
  assign egress_1_out = '{valid: (ingress_in.valid & _GEN_0), bits: ingress_in.bits};
endmodule
}>>|

export:
  ram_flit
  ram_link
  ram_params
  ram_design
  ram_verilog_reference
