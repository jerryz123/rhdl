module RRArbiter(
  input                                                            clock,
                                                                   reset,
  input  struct packed {logic valid; CHIRamMemoryOperation bits; } ingress_0_in,
                                                                   ingress_1_in,
  input  struct packed {logic ready; }                             egress_in,
  output struct packed {logic ready; }                             ingress_0_out,
                                                                   ingress_1_out,
  output struct packed {logic valid; CHIRamMemoryOperation bits; } egress_out,
  output                                                           chosen
);

  wire [1:0][0:0] _matcher_grants;
  wire [1:0]      _GEN = {{_matcher_grants[1'h1][1'h0]}, {_matcher_grants[1'h0][1'h0]}};
  RoundRobinMatcher matcher (
    .clock    (clock),
    .reset    (reset),
    .requests ({{{1{ingress_1_in.valid}}}, {{1{ingress_0_in.valid}}}}),
    .accepts  ({1{egress_in.ready}}),
    .grants   (_matcher_grants)
  );
  assign ingress_0_out = '{ready: (egress_in.ready & _matcher_grants[1'h0][1'h0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _matcher_grants[1'h1][1'h0])};
  assign egress_out =
    '{valid: (|_GEN),
      bits: (_matcher_grants[1'h1][1'h0] ? ingress_1_in.bits : ingress_0_in.bits)};
  assign chosen = _GEN[1] & ~(_GEN[0]);
endmodule

module RoundRobinMatcher(
  input             clock,
                    reset,
  input  [1:0][0:0] requests,
  input  [0:0]      accepts,
  output [1:0][0:0] grants
);

  reg  [0:0]      next_priorities;
  wire            _GEN = requests[1'h1][1'h0] & ~requests[1'h0][1'h0];
  wire            _GEN_0 = requests[1'h0][1'h0] & ~requests[1'h1][1'h0];
  wire [1:0][1:0] _GEN_1 =
    {{{{requests[1'h1][1'h0]}, {_GEN_0}}}, {{{_GEN}, {requests[1'h0][1'h0]}}}};
  wire [1:0]      _GEN_2 = {{_GEN_0}, {requests[1'h0][1'h0]}};
  wire [1:0]      _GEN_3 = {{requests[1'h1][1'h0]}, {_GEN}};
  wire [1:0]      _GEN_4 = _GEN_1[next_priorities[1'h0]];
  wire            _GEN_5 = _GEN_4[1] & ~(_GEN_4[0]);
  wire            _GEN_6 =
    (|_GEN_4) & accepts[1'h0] ? ~_GEN_5 & _GEN_5 - 1'h1 : next_priorities[1'h0];
  always @(posedge clock) begin
    if (reset)
      next_priorities <= '{1'h0};
    else
      next_priorities[1'h0] <= _GEN_6;
  end // always @(posedge)
  assign grants =
    {{{1{_GEN_3[next_priorities[1'h0]]}}}, {{1{_GEN_2[next_priorities[1'h0]]}}}};
endmodule

module CompletionQueue(
  input                                                             clock,
                                                                    reset,
  input  struct packed {logic valid; CHIRamMemoryOperation bits; }  request_in,
  input  struct packed {logic valid; CHIRamMemoryCompletion bits; } completion_in,
  input  struct packed {logic ready; }                              response_in,
  output struct packed {logic ready; }                              request_out,
  output struct packed {logic valid; CHIRamMemoryOperation bits; }  issue_out,
  output struct packed {logic valid; CHIRamMemoryCompletion bits; } response_out
);

  wire struct packed {logic ready; } _completed_ingress_out;
  wire struct packed {logic valid; CHIRamMemoryCompletion bits; } _completed_egress_out;
  wire [1:0]                         _completed_count;
  reg  [1:0]                         outstanding;
  wire                               _GEN =
    _completed_egress_out.valid & response_in.ready;
  wire                               _GEN_0 = ~(outstanding[1]) | _GEN;
  wire                               _GEN_1 = request_in.valid & _GEN_0;
  `ifndef SYNTHESIS
    completion_queue_completion_has_request:
      assert property (@(posedge clock) disable iff (reset)
                         {1'h0, outstanding} + {2'h0, _GEN_1} >= {1'h0, _completed_count}
                         + {2'h0, completion_in.valid});
  `endif // not def SYNTHESIS
  wire                               _GEN_2 = ~(completion_in.valid & ~reset);
  `ifndef SYNTHESIS
    completion_queue_slot_reserved:
      assert property (@(posedge clock) disable iff (_GEN_2)
                         _completed_ingress_out.ready);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    completion_queue_reservations_in_range:
      assert property (@(posedge clock) disable iff (reset) outstanding != 2'h3);
  `endif // not def SYNTHESIS
  Queue_5 completed (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (completion_in),
    .egress_in   (response_in),
    .ingress_out (_completed_ingress_out),
    .egress_out  (_completed_egress_out),
    .count       (_completed_count)
  );
  always @(posedge clock) begin
    if (reset)
      outstanding <= 2'h0;
    else
      outstanding <=
        _GEN_1 ^ _GEN ? (_GEN_1 ? outstanding + 2'h1 : outstanding - 2'h1) : outstanding;
  end // always @(posedge)
  assign request_out = '{ready: _GEN_0};
  assign issue_out = '{valid: _GEN_1, bits: request_in.bits};
  assign response_out = _completed_egress_out;
endmodule

