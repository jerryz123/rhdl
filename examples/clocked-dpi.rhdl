#lang rhdl
// Demonstrates explicit DPI procedure effects and result-bearing DPI register state.

dpi_import procedure rhdl_trace(value: Bits(8))
dpi_import function rhdl_step(value: Bits(8)) -> result: Bits(8)

sync_circuit ClockedDPI():
  input enable: Bool
  input value: Bits(8)
  output result: Bits(8)

  rhdl_trace.call(value, ~enable: enable)
  dpi_reg step_result = rhdl_step(value, ~enable: enable)
  result <== step_result

sync_circuit AlwaysClockedDPI():
  input value: Bits(8)
  output result: Bits(8)

  rhdl_trace.call(value)
  dpi_reg step_result = rhdl_step(value)
  result <== step_result

circuit ExplicitClockedDPI():
  input clock: Clock
  input enable: Bool
  input value: Bits(8)
  output result: Bits(8)

  rhdl_trace.call(value, ~clock: clock, ~enable: enable)
  dpi_reg step_result = rhdl_step(value, ~clock: clock, ~enable: enable)
  result <== step_result

def design = elaborate(ClockedDPI())

def verilog_reference = @str|<<{
`ifndef __CIRCT_DPI_IMPORT_RHDL_TRACE
  import "DPI-C" context function void rhdl_trace(
    input byte value
  );


  `define __CIRCT_DPI_IMPORT_RHDL_TRACE
`endif // not def __CIRCT_DPI_IMPORT_RHDL_TRACE
`ifndef __CIRCT_DPI_IMPORT_RHDL_STEP
  import "DPI-C" context function byte rhdl_step(
    input byte value
  );


  `define __CIRCT_DPI_IMPORT_RHDL_STEP
`endif // not def __CIRCT_DPI_IMPORT_RHDL_STEP
module ClockedDPI(
  input        clock,
               reset,
               enable,
  input  [7:0] value,
  output [7:0] result
);

  logic [7:0] _rhdl_step_0;
  always @(posedge clock) begin
    if (enable)
      rhdl_trace(value);
  end // always @(posedge)
  reg   [7:0] _GEN;
  always @(posedge clock) begin
    if (enable) begin
      _rhdl_step_0 = rhdl_step(value);
      _GEN <= _rhdl_step_0;
    end
  end // always @(posedge)
  assign result = _GEN;
endmodule
}>>|

export:
  ClockedDPI
  AlwaysClockedDPI
  ExplicitClockedDPI
  design
  verilog_reference
