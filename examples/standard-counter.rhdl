#lang rhdl
// Materializes the standard ten-state counter and its readable Verilog reference.

import:
  lib("rhdl/std/counter.rhdl") open

def design = elaborate(Counter(10))

def verilog_reference = @str|<<{
module Counter(
  input        clock,
               reset,
               enable,
  output [3:0] value,
  output       wrap
);

  reg  [3:0] state;
  wire       _GEN = state == 4'h9;
  always @(posedge clock) begin
    if (reset)
      state <= 4'h0;
    else
      state <= enable ? (_GEN ? 4'h0 : state + 4'h1) : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & _GEN;
endmodule
}>>|

export:
  design
  verilog_reference
