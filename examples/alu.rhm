#lang rhombus
// Builds an eight-bit combinational ALU and prints its RHDL IR and CIRCT lowering.

import:
  "../rhdl/main.rhm" open

def width = 8
def design = Design()
def builder = Builder(design)
def alu = builder.module("ALU" ++ to_string(width))
def a = builder.input(alu, "a", Bits(width))
def b = builder.input(alu, "b", Bits(width))
def select = builder.input(alu, "select", Bits(1))
def result = builder.output(alu, "result", Bits(width))
def equal = builder.output(alu, "equal", Bits(1))
def sum = builder.add(alu, a, b, "sum")
def difference = builder.sub(alu, a, b, "difference")
def selected = builder.mux(alu, select, difference, sum, "selected")
def equal_value = builder.eq(alu, a, b, "equal_value")
builder.drive(result, selected)
builder.drive(equal, equal_value)
def finished_alu = builder.finish(alu)

verify_design(design)
println(dump_ir(design))
println(emit_circt(design))
