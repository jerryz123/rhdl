#lang rhdl/base
// Builds a ready-valid adapter from explicit directional record ports.

import:
  "../../rhdl/core/types.rhm" open
  "../../rhdl/frontend/layers/bool.rhm".Bool

fun Forward(T):
  RecordType([RecordField("valid", Bool), RecordField("bits", T)])

def Backward = RecordType([RecordField("ready", Bool)])

circuit ReadyValidAdapter(width):
  input ingress_in: Forward(Bits(width))
  output ingress_out: Backward
  output egress_out: Forward(Bits(width))
  input egress_in: Backward

  egress_out <== ingress_in
  ingress_out <== egress_in

def design = elaborate(ReadyValidAdapter(8))

export:
  Forward
  Backward
  ReadyValidAdapter
  design
