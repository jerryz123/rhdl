#lang rhdl/base
// Builds a ready-valid adapter from explicit directional record ports.

import:
  "../../rhdl/core/types.rhm" open
  "../../rhdl/frontend/extensions/bool.rhm".Bool

fun Forward(T):
  RecordType([RecordField("valid", Bool), RecordField("bits", T)])

def Backward = RecordType([RecordField("ready", Bool)])

circuit ReadyValidAdapter(width):
  input ingress__producer_to_consumer: Forward(Bits(width))
  output ingress__consumer_to_producer: Backward
  output egress__producer_to_consumer: Forward(Bits(width))
  input egress__consumer_to_producer: Backward

  egress__producer_to_consumer <== ingress__producer_to_consumer
  ingress__consumer_to_producer <== egress__consumer_to_producer

def design = elaborate(ReadyValidAdapter(8))

export:
  Forward
  Backward
  ReadyValidAdapter
  design
