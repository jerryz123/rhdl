#lang rhdl/base
// Builds a record-valued swap through explicit core types and kernel operations.

import:
  "../../rhdl/core/types.rhm" open
  "../../rhdl/frontend/kernel.rhm" as kernel

fun Pair(T):
  RecordType([RecordField("left", T), RecordField("right", T)], "Pair")

circuit BundleSwap(width :: PosInt):
  input source: Pair(Bits(width))
  output result: Pair(Bits(width))

  kernel.connect(kernel.project(result, "left"),
                 kernel.project(source, "right"))
  kernel.connect(kernel.project(result, "right"),
                 kernel.project(source, "left"))

def design = elaborate(BundleSwap(8))

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhdl_types
`define _TYPESCOPE_rhdl_types
  typedef struct packed {logic [7:0] left; logic [7:0] right; } Pair;
`endif // _TYPESCOPE_rhdl_types
module BundleSwap(
  input  Pair source,
  output Pair result
);

  assign result = '{left: source.right, right: source.left};
endmodule
}>>|

export:
  Pair
  BundleSwap
  design
  verilog_reference
