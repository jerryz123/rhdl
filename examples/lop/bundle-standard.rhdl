#lang rhdl
// Builds the record-valued swap through the concise bundle extension.

bundle Pair(T):
  left: T
  right: T

circuit BundleSwap(width):
  input source: Pair(Bits(width))
  output result: Pair(Bits(width))

  result.left <== source.right
  result.right <== source.left

def design = elaborate(BundleSwap(8))

export:
  Pair
  BundleSwap
  design
