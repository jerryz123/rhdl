#lang rhdl
// Builds the reference adder directly through the public core Builder API.

def design = Design()
def builder = Builder(design)
def adder = builder.module("Adder8")
def a = builder.input(adder, "a", Bits(8))
def b = builder.input(adder, "b", Bits(8))
def sum = builder.output(adder, "sum", Bits(8))
def result = builder.add(adder, a, b)
builder.drive(sum, result)
def finished_adder = builder.finish(adder)
verify_design(design)

export:
  design
