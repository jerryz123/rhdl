#lang rhombus
// Builds the reference adder by explicitly importing the context-based elaboration kernel.

import:
  "../../rhdl/core/types.rhm" open
  "../../rhdl/frontend/kernel.rhm" open

fun Adder(width):
  fun implementation():
    def a = input("a", Bits(width))
    def b = input("b", Bits(width))
    def sum = output("sum", Bits(width))
    def result = hw_add(a, b)
    connect(sum, result)
  build_circuit("Adder", [width], implementation)

def design = run_elaboration(fun (): Adder(8))

export:
  Adder
  design
