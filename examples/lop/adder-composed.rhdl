#lang rhdl/base
// Builds the reference adder by composing the minimal language with combinational syntax.

import:
  lib("rhdl/frontend/layers/comb.rhm") open

circuit Adder(width):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

def design = elaborate(Adder(8))

export:
  Adder
  design
